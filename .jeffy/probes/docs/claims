expect docs battery: 45/45 checks passed :: bash .jeffy/probes/docs/run.sh 2>&1 | tail -n 1
expect 0 :: bash .jeffy/probes/docs/run.sh >/dev/null 2>&1; echo $?
expect missing-file-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc1); f="$s/docs/headless.md"; awk -v old='](../SECURITY.md)' -v new='](../SECURITY-GONE.md)' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'missing-file:headless.md>../SECURITY-GONE.md' && echo missing-file-detected || echo "a relative reference pointing at nothing passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect missing-anchor-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc2); f="$s/docs/usage.md"; awk -v old='](#high-hunt)' -v new='](#high-hunts)' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'missing-anchor:usage.md>#high-hunts' && echo missing-anchor-detected || echo "an anchor naming no heading passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect noprogress-exit-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc3); f="$s/docs/headless.md"; awk -v old='no progress, stopping"; exit 1; }' -v new='no progress, stopping"; exit 0; }' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL no-progress exit status' && echo noprogress-exit-detected || echo "the published driver reporting success on a dead round passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect accepted-pattern-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc4); f="$s/docs/headless.md"; awk -v old='"verdict":"accepted"' -v new='"verdict":"refused"' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL converged message' && echo accepted-pattern-detected || echo "the published driver never detecting convergence passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect undocumented-flag-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc5); f="$s/skills/jeffy/SKILL.md"; awk -v old='`--highs` takes no value' -v new='`--max-fake` takes no value and `--highs` takes no value' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL the published flag set is the accepted one' && echo undocumented-flag-detected || echo "a launcher flag no published page documents passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect dropped-flag-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc6); f="$s/docs/usage.md"; awk -v old=' [--max-context <4>]' -v new='' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL the published flag set is the accepted one' && echo dropped-flag-detected || echo "a flag dropped from the published synopsis passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect round-count-detected :: s=$(bash .jeffy/probes/docs/stage.sh cl-dc7); f="$s/docs/headless.md"; awk -v old='for r in $(seq 1 "$ROUNDS"); do' -v new='for r in 1; do' -f .jeffy/probes/docs/sub.awk "$f" > "$f.m" && mv "$f.m" "$f"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/docs/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL budget-spent rounds run' && echo round-count-detected || echo "a driver running one round of a three-round budget passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
