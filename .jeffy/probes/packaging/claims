expect link-rewrite-detected :: s=.jeffy/scratch/cl-pk2; rm -rf $s; mkdir -p $s; awk 'index($0,"{blob}")==0' hatch_build.py > $s/hatch_build.py; cp pyproject.toml $s/; python3 -m py_compile $s/hatch_build.py 2>/dev/null || { rm -rf $s; echo "mutation does not compile"; exit 0; }; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/packaging/run.sh 2>&1); rm -rf $s; printf '%s\n' "$out" | grep -q 'would ship unresolved.*link=docs/usage.md' && echo link-rewrite-detected || echo "dropping the link rewrite passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
