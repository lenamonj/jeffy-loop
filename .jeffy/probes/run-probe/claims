expect defaults-ok :: e=$(mktemp); bash skills/jeffy/hooks/lib/run-probe.sh bash -c 'exit 3' 2>"$e" >/dev/null; d=$(sed -n 's/.*under ceilings \(.*\)\./\1/p' "$e"); rm -f "$e"; if command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1; then w='4096MB / 600s'; else w='4096MB / 0s'; fi; [ "$d" = "$w" ] && echo defaults-ok || echo "defaults read '$d' want '$w'"
expect wall-ok :: if command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1; then JEFFY_PROBE_TIMEOUT_S=1 bash skills/jeffy/hooks/lib/run-probe.sh sleep 5 >/dev/null 2>&1; rc=$?; [ "$rc" = 124 ] && echo wall-ok || echo "wall ceiling did not bind, rc=$rc"; else bash skills/jeffy/hooks/lib/run-probe.sh true 2>&1 >/dev/null | grep -q 'wall ceiling unavailable' && echo wall-ok || echo 'no timeout tool and no degradation notice'; fi
expect 0 :: JEFFY_PROBE_TIMEOUT_S=10 bash skills/jeffy/hooks/lib/run-probe.sh sleep 5 >/dev/null 2>&1; echo $?
expect mem-ok :: if command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope --quiet true >/dev/null 2>&1; then JEFFY_PROBE_MEM_MB=64 bash skills/jeffy/hooks/lib/run-probe.sh dd if=/dev/zero of=/dev/null bs=320000000 count=1 >/dev/null 2>&1; rc=$?; [ "$rc" = 137 ] && echo mem-ok || echo "memory ceiling did not bind, rc=$rc"; else bash skills/jeffy/hooks/lib/run-probe.sh true 2>&1 >/dev/null | grep -q 'no user manager reachable' && echo mem-ok || echo 'no user scope and no degradation notice'; fi
expect 0 :: JEFFY_PROBE_MEM_MB=1024 bash skills/jeffy/hooks/lib/run-probe.sh dd if=/dev/zero of=/dev/null bs=320000000 count=1 >/dev/null 2>&1; echo $?
expect 2 :: JEFFY_PROBE_TIMEOUT_S=abc bash skills/jeffy/hooks/lib/run-probe.sh true >/dev/null 2>&1; echo $?
