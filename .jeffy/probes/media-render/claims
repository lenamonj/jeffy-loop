expect camera-drift-detected :: b=$(mktemp); f=media/how-it-works.html; cp "$f" "$b"; sed -i 's/var cs=1+0\.03\*pr(0,TOTAL);/var cs=1+0.031*pr(0,TOTAL);/' "$f"; out=$(bash .jeffy/probes/media-render/run.sh 2>&1); cp "$b" "$f"; rm -f "$b"; printf '%s' "$out" | grep -q ' camera: got ' && echo camera-drift-detected || echo "camera drift went unreported: $out"
expect theme-removal-detected :: b=$(mktemp); f=media/running-jeffy.html; cp "$f" "$b"; sed -i '/location.search.indexOf("theme=light")/d' "$f"; out=$(bash .jeffy/probes/media-render/run.sh 2>&1); cp "$b" "$f"; rm -f "$b"; printf '%s' "$out" | grep -q 'theme=light renders byte-identically' && echo theme-removal-detected || echo "theme removal went unreported: $out"
expect 0 :: bash .jeffy/probes/media-render/run.sh >/dev/null 2>&1; echo $?
