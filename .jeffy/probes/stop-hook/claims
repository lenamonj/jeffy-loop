expect pre-v1-detected :: d=$(mktemp -d); mkdir -p "$d/skills/jeffy"; cp -R skills/jeffy/hooks "$d/skills/jeffy/"; h="$d/skills/jeffy/hooks/stop-hook.sh"; git show 675d9a7:skills/jeffy/hooks/stop-hook.sh > "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh "$d" 2>&1); rm -rf "$d"; printf '%s' "$out" | grep -q 'grammar example' && echo pre-v1-detected || echo "the pre-V1 hook passed unnoticed: $out"
expect counter-stall-detected :: d=$(mktemp -d); mkdir -p "$d/skills/jeffy"; cp -R skills/jeffy/hooks "$d/skills/jeffy/"; h="$d/skills/jeffy/hooks/stop-hook.sh"; sed -i 's/^next=$((iter + 1))$/next=$iter/' "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh "$d" 2>&1); rm -rf "$d"; printf '%s' "$out" | grep -q 'the re-feed advances the counter' && echo counter-stall-detected || echo "a counter that never advances passed unnoticed: $out"
expect severity-floor-detected :: d=$(mktemp -d); mkdir -p "$d/skills/jeffy"; cp -R skills/jeffy/hooks "$d/skills/jeffy/"; h="$d/skills/jeffy/hooks/stop-hook.sh"; sed -i 's/(Low\[,)\]/(/' "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh "$d" 2>&1); rm -rf "$d"; printf '%s' "$out" | grep -q 'severity floor did not refuse an open Medium' && echo severity-floor-detected || echo "a severity floor reading every task as Low passed unnoticed: $out"
expect 0 :: bash .jeffy/probes/stop-hook/run.sh >/dev/null 2>&1; echo $?
expect temp-location-detected :: d=$(mktemp -d); mkdir -p "$d/skills/jeffy"; cp -R skills/jeffy/hooks "$d/skills/jeffy/"; h="$d/skills/jeffy/hooks/stop-hook.sh"; sed -i 's|mktemp "$root/.jeffy/scratch/jeffy-loop-state|mktemp "$root/.claude/jeffy-loop-state|' "$h"; bash -n "$h" 2>/dev/null || { rm -rf "$d"; echo "mutation does not parse"; exit 0; }; out=$(bash .jeffy/probes/stop-hook/run.sh "$d" 2>&1); rm -rf "$d"; printf '%s' "$out" | grep -q 'which JEFFY_LOOP_MEMORY_RE does not cover' && echo temp-location-detected || echo "staging the rewriter temp outside loop memory passed unnoticed: $out"
expect temp-sweep-detected :: d=$(mktemp -d); mkdir -p "$d/skills/jeffy"; cp -R skills/jeffy/hooks "$d/skills/jeffy/"; h="$d/skills/jeffy/hooks/stop-hook.sh"; sed -i 's|rm -f "$stale_tmp"|true|' "$h"; bash -n "$h" 2>/dev/null || { rm -rf "$d"; echo "mutation does not parse"; exit 0; }; out=$(bash .jeffy/probes/stop-hook/run.sh "$d" 2>&1); rm -rf "$d"; printf '%s' "$out" | grep -q 'leftover rewriter temp survived' && echo temp-sweep-detected || echo "disabling the leftover sweep passed unnoticed: $out"
