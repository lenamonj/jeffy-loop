expect pre-v1-detected :: h=skills/jeffy/hooks/stop-hook.sh; b=$(mktemp); cp "$h" "$b"; git show 675d9a7:"$h" > "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh 2>&1); cp "$b" "$h"; rm -f "$b"; printf '%s' "$out" | grep -q 'grammar example' && echo pre-v1-detected || echo "the pre-V1 hook passed unnoticed: $out"
expect counter-stall-detected :: h=skills/jeffy/hooks/stop-hook.sh; b=$(mktemp); cp "$h" "$b"; sed -i 's/^next=$((iter + 1))$/next=$iter/' "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh 2>&1); cp "$b" "$h"; rm -f "$b"; printf '%s' "$out" | grep -q 'the re-feed advances the counter' && echo counter-stall-detected || echo "a counter that never advances passed unnoticed: $out"
expect severity-floor-detected :: h=skills/jeffy/hooks/stop-hook.sh; b=$(mktemp); cp "$h" "$b"; sed -i 's/(Low\[,)\]/(/' "$h"; out=$(bash .jeffy/probes/stop-hook/run.sh 2>&1); cp "$b" "$h"; rm -f "$b"; printf '%s' "$out" | grep -q 'severity floor did not refuse an open Medium' && echo severity-floor-detected || echo "a severity floor reading every task as Low passed unnoticed: $out"
expect 0 :: bash .jeffy/probes/stop-hook/run.sh >/dev/null 2>&1; echo $?
