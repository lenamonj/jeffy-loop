expect lost-claims-file-detected :: s=$(bash .jeffy/probes/probes-meta/stage.sh cl-pm4); rm -f "$s/.jeffy/probes/quiet-verify/claims"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/probes-meta/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL known gap: the batteries carrying no claims file' && echo lost-claims-file-detected || echo "a battery losing the file that makes it re-executable passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect unnamed-battery-detected :: s=$(bash .jeffy/probes/probes-meta/stage.sh cl-pm5); cp -r "$s/.jeffy/probes/quiet-verify" "$s/.jeffy/probes/quiet-verify-copy"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/probes-meta/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL the batteries no inventory row names' && echo unnamed-battery-detected || echo "a battery no row names, so no sweep ever runs it, passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
