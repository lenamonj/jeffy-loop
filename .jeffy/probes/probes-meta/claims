expect dead-declared-path-detected :: s=$(bash .jeffy/probes/probes-meta/stage.sh cl-pm1); printf 'scripts/no-such-file.sh\n' >> "$s/.jeffy/probes/quiet-verify/paths"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/probes-meta/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL every path a battery declares exists' && echo dead-declared-path-detected || echo "a battery declaring a path that is not there passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
expect engine-owned-scope-detected :: s=$(bash .jeffy/probes/probes-meta/stage.sh cl-pm2); printf '.jeffy/metrics\n' >> "$s/.jeffy/probes/quiet-verify/paths"; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/probes-meta/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL every path a battery declares exists' && echo engine-owned-scope-detected || echo "a battery scoped to the directory the engine writes every turn passed unnoticed: $(printf '%s\n' "$out" | tail -n 1)"
