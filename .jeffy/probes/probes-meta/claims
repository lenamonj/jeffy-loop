expect dead-row-path-detected :: s=$(bash .jeffy/probes/probes-meta/stage.sh cl-pm7); python3 .jeffy/probes/probes-meta/mutate.py "$s/PLAN.md" 'Paths: skills/jeffy/hooks/lib/quiet-verify.sh.' 'Paths: skills/jeffy/hooks/lib/quiet-verifier.sh.' 1 >/dev/null; out=$(JEFFY_PROBE_ROOT="$PWD/$s" bash .jeffy/probes/probes-meta/run.sh 2>&1); rm -rf "$s"; printf '%s\n' "$out" | grep -q 'FAIL every path an inventory row claims exists in the tree' && echo dead-row-path-detected || echo "a row claiming a path that is not in the tree passed unnoticed, which is the gap this arm closes: $(printf '%s\n' "$out" | tail -n 1)"
