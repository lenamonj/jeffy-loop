+/* The two entry points that take an item pointer must confirm the item really
+ * is one of parent's children. Accepting a foreign item cross-links the two
+ * documents: detaching left parent's tail pointer aimed at the other tree,
+ * which the next append dereferenced after it had been freed, and replacing
+ * silently edited the other document while reporting success. */
+static void cjson_functions_taking_an_item_pointer_should_reject_a_foreign_item(void)
+{
+    cJSON *array = cJSON_Parse("[1,2]");
+    cJSON *other = cJSON_Parse("[7,8,9]");
+    cJSON *foreign = NULL;
+    cJSON *replacement = NULL;
+    char *printed = NULL;
+
+    TEST_ASSERT_NOT_NULL(array);
+    TEST_ASSERT_NOT_NULL(other);
+    foreign = other->child->next;
+    TEST_ASSERT_NOT_NULL(foreign);
+
+    TEST_ASSERT_NULL_MESSAGE(cJSON_DetachItemViaPointer(array, foreign),
+        "detaching an item that belongs to another parent must fail");
+
+    replacement = cJSON_CreateNumber(5);
+    TEST_ASSERT_NOT_NULL(replacement);
+    TEST_ASSERT_FALSE_MESSAGE(cJSON_ReplaceItemViaPointer(array, foreign, replacement),
+        "replacing an item that belongs to another parent must fail");
+    /* a refused replacement is not adopted, so the caller still owns it */
+    cJSON_Delete(replacement);
+
+    /* neither document may have been touched */
+    printed = cJSON_PrintUnformatted(array);
+    TEST_ASSERT_EQUAL_STRING("[1,2]", printed);
+    free(printed);
+    printed = cJSON_PrintUnformatted(other);
+    TEST_ASSERT_EQUAL_STRING("[7,8,9]", printed);
+    free(printed);
+
+    /* the tail pointer survived, so appending still works */
+    TEST_ASSERT_TRUE(cJSON_AddItemToArray(array, cJSON_CreateNumber(3)));
+    printed = cJSON_PrintUnformatted(array);
+    TEST_ASSERT_EQUAL_STRING("[1,2,3]", printed);
+    free(printed);
+
+    cJSON_Delete(array);
+    cJSON_Delete(other);
+}
+
+/* The member key belongs to the document, not to whatever spelling the caller
+ * happened to look the member up with, and it has to be copied before the old
+ * one is released because the caller may have passed that very buffer. */
+static void cjson_replace_item_in_object_should_keep_the_documents_key(void)
+{
+    cJSON *object = cJSON_Parse("{\"Aa\":1,\"b\":2}");
+    cJSON *self = NULL;
+    cJSON *rejected = NULL;
+    char *printed = NULL;
+
+    TEST_ASSERT_NOT_NULL(object);
+
+    /* the case insensitive lookup matches "Aa"; the key must not become "aA" */
+    TEST_ASSERT_TRUE(cJSON_ReplaceItemInObject(object, "aA", cJSON_CreateNumber(5)));
+    printed = cJSON_PrintUnformatted(object);
+    TEST_ASSERT_EQUAL_STRING("{\"Aa\":5,\"b\":2}", printed);
+    free(printed);
+
+    /* a miss changes nothing and reports failure; the refused replacement is
+     * not adopted, so the caller still owns it */
+    rejected = cJSON_CreateNumber(9);
+    TEST_ASSERT_NOT_NULL(rejected);
+    TEST_ASSERT_FALSE(cJSON_ReplaceItemInObjectCaseSensitive(object, "aA", rejected));
+    cJSON_Delete(rejected);
+
+    /* passing the item's own key buffer as the lookup string must be safe */
+    self = cJSON_GetObjectItem(object, "Aa");
+    TEST_ASSERT_NOT_NULL(self);
+    TEST_ASSERT_TRUE(cJSON_ReplaceItemInObject(object, self->string, self));
+    printed = cJSON_PrintUnformatted(object);
+    TEST_ASSERT_EQUAL_STRING("{\"Aa\":5,\"b\":2}", printed);
+    free(printed);
+
+    cJSON_Delete(object);
+}
