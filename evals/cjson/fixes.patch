+{
+    const char *invalid[] = {
+        "[01]", "[00]", "[-01]", "[1.]", "[.5]", "[+1]", "[-]",
+        "[1e]", "[e5]", "[--1]", "[1e+]", "[0x10]", "[1.2.3]"
+    };
+    const char *valid[] = {
+        "[0]", "[-0]", "[1]", "[-1]", "[1.5]", "[-1.5]", "[0.5]", "[1e5]",
+        "[1E5]", "[1e+5]", "[1e-5]", "[-1.5e-3]", "[0e0]", "[123456789]"
+    };
+    size_t i = 0;
+
+    for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+    {
+        cJSON *parsed = cJSON_Parse(invalid[i]);
+        TEST_ASSERT_NULL_MESSAGE(parsed, invalid[i]);
+        cJSON_Delete(parsed);
+    }
+
+    for (i = 0; i < sizeof(valid) / sizeof(valid[0]); i++)
+    {
+        cJSON *parsed = cJSON_Parse(valid[i]);
