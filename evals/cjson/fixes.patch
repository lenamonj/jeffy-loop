+    printed = cJSON_PrintUnformatted(array);
+    TEST_ASSERT_EQUAL_STRING("[1,9,2]", printed);
+    free(printed);
+
+    /* at the end and past it both append */
+    TEST_ASSERT_TRUE(cJSON_InsertItemInArray(array, 3, cJSON_CreateNumber(7)));
+    TEST_ASSERT_TRUE(cJSON_InsertItemInArray(array, 99, cJSON_CreateNumber(8)));
+    printed = cJSON_PrintUnformatted(array);
+    TEST_ASSERT_EQUAL_STRING("[1,9,2,7,8]", printed);
+    free(printed);
+
+    /* a negative index fails and leaves the item with the caller */
+    rejected = cJSON_CreateNumber(0);
+    TEST_ASSERT_FALSE(cJSON_InsertItemInArray(array, -1, rejected));
+    printed = cJSON_PrintUnformatted(array);
+    TEST_ASSERT_EQUAL_STRING("[1,9,2,7,8]", printed);
+    free(printed);
+    cJSON_Delete(rejected);
+
+    cJSON_Delete(array);
