+/* cJSON keeps the tail of every child list in the head's prev pointer, and
+ * add_item_to_array silently does nothing when that pointer is NULL. Sorting
+ * rebuilds the list, so it has to restore the tail or every later append is
+ * dropped, reported as success, and leaked. */
+static void sorting_should_keep_the_child_list_tail_pointer(void)
+{
+    cJSON *object = cJSON_Parse("{\"c\":3,\"a\":1,\"b\":2}");
+    cJSON *element = NULL;
+    cJSON *tail = NULL;
+    char *printed = NULL;
+
+    TEST_ASSERT_NOT_NULL(object);
+
+    cJSONUtils_SortObject(object);
+
+    for (element = object->child; element->next != NULL; element = element->next)
+    {
+        tail = element->next;
+    }
+    TEST_ASSERT_EQUAL_PTR_MESSAGE(tail, object->child->prev,
+        "the head's prev pointer must be the tail after sorting");
+
+    TEST_ASSERT_TRUE(cJSON_AddItemToObject(object, "z", cJSON_CreateNumber(26)));
+    printed = cJSON_PrintUnformatted(object);
+    TEST_ASSERT_EQUAL_STRING("{\"a\":1,\"b\":2,\"c\":3,\"z\":26}", printed);
+    free(printed);
+
+    cJSON_Delete(object);
+}
+
+/* The patch and merge-patch generators sort their inputs in place, so they
+ * corrupt the same invariant even though the caller never asked for a sort. */
+static void generating_patches_should_keep_the_child_list_tail_pointer(void)
+{
+    cJSON *from = cJSON_Parse("{\"c\":3,\"a\":1,\"b\":2}");
+    cJSON *to = cJSON_Parse("{\"c\":4,\"a\":1,\"b\":2}");
+    cJSON *patches = NULL;
+    char *printed = NULL;
+
+    TEST_ASSERT_NOT_NULL(from);
+    TEST_ASSERT_NOT_NULL(to);
+
+    patches = cJSONUtils_GeneratePatchesCaseSensitive(from, to);
+    TEST_ASSERT_NOT_NULL(patches);
+
+    TEST_ASSERT_NOT_NULL_MESSAGE(from->child->prev,
+        "generating patches must not clear the source's tail pointer");
+    TEST_ASSERT_TRUE(cJSON_AddItemToObject(from, "z", cJSON_CreateNumber(26)));
+    printed = cJSON_PrintUnformatted(from);
+    TEST_ASSERT_EQUAL_STRING("{\"a\":1,\"b\":2,\"c\":3,\"z\":26}", printed);
+    free(printed);
+
+    cJSON_Delete(patches);
+    cJSON_Delete(from);
+    cJSON_Delete(to);
+}
+
 int main(void)
 {
     UNITY_BEGIN();
 
     RUN_TEST(cjson_utils_functions_shouldnt_crash_with_null_pointers);
+    RUN_TEST(sorting_should_keep_the_child_list_tail_pointer);
+    RUN_TEST(generating_patches_should_keep_the_child_list_tail_pointer);
 
     return UNITY_END();
 }
