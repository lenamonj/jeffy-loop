+            "regular file": dotenv.main._is_file_or_fifo(regular),
+            "fifo": dotenv.main._is_file_or_fifo(fifo),
+            "directory": dotenv.main._is_file_or_fifo(tmp_path),
+            "missing": dotenv.main._is_file_or_fifo(tmp_path / "nope.env"),
