+def test_set_key_interrupted_write_reports_the_path_and_leaves_no_temporary(tmp_path):
+    """A write that fails inside the temporary file's own close.
+
+    `RLIMIT_FSIZE` is the deterministic stand-in for a full or quota-limited
+    filesystem: it fails at the same place, the buffered close that flushes the
+    rewritten contents. Nothing in `rewrite` mentions that step - there is no
+    syscall written for it - so it used to escape every cleanup arm, raising an
+    error naming nothing at all and leaving a partial `.tmp_` file behind in the
+    caller's directory. It runs in a child process because the limit and the
+    SIGXFSZ handler are process-global.
+    """
+    (tmp_path / ".env").write_text("SECRET=hunter2\nOTHER=v\nB='xxxxxxxxxxxxxxxx'\n")
+
+    result = _run_under(
+        {},
+        """
+        import json, os, resource, signal
+        from dotenv import set_key
+
+        signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
+        resource.setrlimit(resource.RLIMIT_FSIZE, (32, resource.RLIM_INFINITY))
+        try:
+            set_key(".env", "NEW", "value")
+            raised = None
+        except OSError as exc:
+            raised = {"errno": exc.errno, "filename": exc.filename}
+        resource.setrlimit(resource.RLIMIT_FSIZE, (resource.RLIM_INFINITY,) * 2)
+        print(json.dumps({
+            "raised": raised,
+            "leftovers": sorted(n for n in os.listdir(".") if n.startswith(".tmp_")),
+            "original": open(".env").read(),
+        }))
+        """,
+        tmp_path,
+    )
+
+    assert result.returncode == 0, result.stderr
+    observed = json.loads(result.stdout)
+    assert observed["raised"] == {"errno": errno.EFBIG, "filename": ".env"}
+    assert observed["leftovers"] == []
+    assert observed["original"] == "SECRET=hunter2\nOTHER=v\nB='xxxxxxxxxxxxxxxx'\n"
+
