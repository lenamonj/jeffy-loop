+def _run_under(env_extra, code, tmp_path):
+    """Run `code` in a child process with the given environment additions."""
+    return subprocess.run(
+        [sys.executable, "-c", textwrap.dedent(code)],
+        capture_output=True,
+        text=True,
+        cwd=tmp_path,
+        env={**os.environ, **env_extra},
