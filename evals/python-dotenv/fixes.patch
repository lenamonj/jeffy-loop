+def usable_as_environment_variable(key: str, value: str) -> bool:
+    """
+    Return True if `key`/`value` can be put in an environment, warn if it cannot.
+
+    The parser reads key shapes an environment will not hold. A single-quoted key
+    may contain anything but a quote, so `'a=b'` parses cleanly and then makes
+    `os.environ` and `execvpe` raise `ValueError`, and a NUL anywhere in a key or
+    value does the same. A pair that cannot be encoded in the filesystem encoding
+    is rejected too, which is why a valid UTF-8 `.env` holding an accented value
+    fails under `LC_ALL=C`. Skipping such a pair with a warning is what this
+    library already does with a line it cannot parse and with a key `dotenv list
+    --format shell` cannot emit; the alternative, letting the error escape, aborts
+    the load partway with the earlier keys already set.
+
+    This is the only gate in front of an environment, so both places that build
+    one - `DotEnv.set_as_environment_variables` and `cli.run_command` - call it.
+    `dotenv_values` and `get_key` do not: they return a mapping rather than
+    populate an environment, and reading these keys is documented behaviour.
+    """
+    if "=" in key:
+        reason = "its name contains '='"
+    elif "\0" in key:
+        reason = "its name contains a null byte"
+    elif "\0" in value:
+        reason = "its value contains a null byte"
+    else:
