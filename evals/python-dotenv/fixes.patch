+class _CountingEnviron(MutableMapping):
+    """An `os.environ` stand-in that counts whole traversals of itself.
+
+    Mutable because pytest writes `PYTEST_CURRENT_TEST` into the real
+    `os.environ` around every test, and a read-only stand-in breaks setup.
+    Only traversals are counted; single-key reads and writes are not.
+    """
+
+    def __init__(self, data):
+        self._data = dict(data)
+        self.traversals = 0
+
+    def keys(self):
+        self.traversals += 1
+        return self._data.keys()
+
+    def __iter__(self):
+        self.traversals += 1
+        return iter(self._data)
+
+    def __getitem__(self, key):
+        return self._data[key]
+
+    def __setitem__(self, key, value):
+        self._data[key] = value
+
+    def __delitem__(self, key):
+        del self._data[key]
+
+    def __len__(self):
+        return len(self._data)
+
+
+@pytest.mark.parametrize("override", [True, False])
+def test_the_environment_is_read_once_per_call_not_once_per_binding(
+    tmp_path, monkeypatch, override
+):
+    """Interpolation used to copy the whole environment for every binding.
+
+    That made resolution quadratic in the number of keys while parsing stayed
+    linear: a 20000-key file took 3.9s to interpolate against 0.16s to parse,
+    and `dotenv list` on it took 4s. Counted rather than timed, because a
+    timing assertion is flaky and does not say what regressed.
+    """
+    dotenv_path = tmp_path / ".env"
+    dotenv_path.write_text(
+        "A0=v\n" + "".join(f"A{i}=${{A{i - 1}}}{i}\n" for i in range(1, 50))
+    )
+    counting = _CountingEnviron({"SET_IN_ENV": "x"})
+    monkeypatch.setattr(os, "environ", counting)
+
+    values = DotEnv(
+        dotenv_path, interpolate=True, override=override, encoding="utf-8"
+    ).dict()
+
+    assert values["A49"] == "v" + "".join(str(i) for i in range(1, 50))
+    assert counting.traversals == 1
