+        # handler, which is what `os.fsencode` does. Asking it is what keeps
+        # this in step: encoding by hand with `sys.getfilesystemencoding()`
+        # drops the `surrogateescape` handler and would reject a lone
+        # surrogate that an environment accepts.
+        try:
+            os.fsencode(key)
+            os.fsencode(value)
+        except UnicodeEncodeError:
