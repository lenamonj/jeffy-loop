+def test_output_failure_is_not_reported_against_the_env_file(tmp_path):
+    """A reader that stops reading is not a fault of the `.env` file.
+
+    `dotenv list | head` is ordinary use, and the group's `except OSError`
+    reported the resulting `BrokenPipeError` as `Error accessing env file
+    <path>: Broken pipe.` - about a file it had just read without complaint.
+    Only errors that name the file are reported against it now; writing the
+    output names nothing.
+    """
+    env_file = tmp_path / ".env"
+    # Enough output that the child is still writing after the reader goes away:
+    # a pipe buffer holds 64 KiB on Linux and this is four times that. Long
+    # values rather than many keys, so the size comes from bytes written and
+    # not from a key count the run time would scale with.
+    value = "v" * 1000
+    env_file.write_text("".join(f"K{i:03d}={value}\n" for i in range(256)))
+
+    proc = subprocess.Popen(
+        ["dotenv", "--file", str(env_file), "list"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    assert proc.stdout is not None and proc.stderr is not None
+    with proc:
+        assert proc.stdout.readline() == f"K000={value}\n"
+        # Closing the read end is what makes the child's next write fail.
+        proc.stdout.close()
+        stderr = proc.stderr.read()
+
+    assert "Error accessing env file" not in stderr
+    assert str(env_file) not in stderr
+    assert "Error writing output: Broken pipe." in stderr
+    # The file really is fine, which is the whole point of not blaming it.
+    check_process(run_dotenv(["--file", str(env_file), "get", "K000"]), exit_code=0)
+
