+// toEqual compares a Set by membership, not by iteration order, so the
+// "patches can be reversed" check above cannot see an undo that restores the
+// right members in the wrong order. That is how #IMM-006 survived the suite.
+test("inverse patches restore a Set's iteration order", () => {
+	const base = new Set([1, 2, 3, 4, 5])
+	const [result, , inversePatches] = produceWithPatches(base, d => {
+		d.delete(1)
+		d.delete(3)
+		d.add(9)
+	})
+	expect([...result]).toEqual([2, 4, 5, 9])
+	expect([...applyPatches(result, inversePatches)]).toEqual([1, 2, 3, 4, 5])
+})
