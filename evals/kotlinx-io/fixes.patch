+/**
+ * Resolves the temporary directory from the environment, falling back to `/tmp`.
+ *
+ * `TMPDIR` is unset in a plain login shell, in a systemd unit and in most containers,
+ * so the fallback is the value POSIX prescribes rather than an empty path.
+ */
+public actual val SystemTemporaryDirectory: Path
+    get() = Path(
+        getenv("TMPDIR")?.toKString()?.takeIf { it.isNotEmpty() }
+            ?: getenv("TMP")?.toKString()?.takeIf { it.isNotEmpty() }
+            ?: "/tmp"
+    )
+
