+ * Use of this source code is governed by the Apache 2.0 license that can be found in the LICENCE file.
+ */
+
+package kotlinx.io.files
+
+import kotlinx.io.*
+import kotlin.test.*
+
+/**
+ * The argument and state validation [RawSource.readAtMostTo] and [RawSink.write]
+ * document, checked against this platform's file-backed implementations.
+ */
+class FileSourceSinkContractTest {
+    private val files: MutableList<Path> = arrayListOf()
+
+    @AfterTest
+    fun cleanup() {
+        files.forEach { SystemFileSystem.delete(it, false) }
+    }
+
+    private fun tempFile(): Path = Path(tempFileName()).also { files.add(it) }
+
+    private fun fileWithContent(): Path = tempFile().also { path ->
+        SystemFileSystem.sink(path).buffered().use { it.writeString("abcdef") }
+    }
+
+    @Test
+    fun readAtMostToRejectsNegativeByteCount() {
+        SystemFileSystem.source(fileWithContent()).use { source ->
+            assertFailsWith<IllegalArgumentException> { source.readAtMostTo(Buffer(), -1) }
+        }
+    }
+
+    @Test
+    fun readAtMostToRejectsUseAfterClose() {
+        val source = SystemFileSystem.source(fileWithContent())
+        source.close()
+        assertFailsWith<IllegalStateException> { source.readAtMostTo(Buffer(), 1) }
+    }
+
+    @Test
+    fun writeRejectsNegativeByteCount() {
+        SystemFileSystem.sink(tempFile()).use { sink ->
+            assertFailsWith<IllegalArgumentException> {
+                sink.write(Buffer().also { it.writeString("abc") }, -1)
+            }
+        }
+    }
+
+    @Test
+    fun writeRejectsByteCountAboveSourceSize() {
+        SystemFileSystem.sink(tempFile()).use { sink ->
+            assertFailsWith<IllegalArgumentException> {
+                sink.write(Buffer().also { it.writeString("abc") }, 4)
+            }
+        }
+    }
+
+    @Test
+    fun writeRejectsUseAfterClose() {
+        val sink = SystemFileSystem.sink(tempFile())
+        sink.close()
+        assertFailsWith<IllegalStateException> {
+            sink.write(Buffer().also { it.writeString("abc") }, 3)
+        }
+    }
+}
