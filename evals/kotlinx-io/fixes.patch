+/**
+ * Resolves the temporary directory, honouring an explicit `TMPDIR` override and otherwise
+ * delegating to `GetTempPathA`, which consults `TMP`, `TEMP`, `USERPROFILE` and the Windows
+ * directory in turn, so an environment that sets none of them still yields a real directory.
+ */
+public actual val SystemTemporaryDirectory: Path
+    get() = Path(
+        getenv("TMPDIR")?.toKString()?.takeIf { it.isNotEmpty() } ?: windowsTemporaryDirectory()
+    )
+
+private fun windowsTemporaryDirectory(): String = memScoped {
+    val buffer = allocArray<CHARVar>(MAX_PATH_LENGTH)
+    if (GetTempPathA(MAX_PATH_LENGTH.convert(), buffer) == 0u) {
+        throw IOException("GetTempPathA failed with error code: ${GetLastError()}")
+    }
+    buffer.toKString()
+}
