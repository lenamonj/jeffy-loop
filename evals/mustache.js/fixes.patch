 var chai = require('chai');
 var isRunningInNode = process !== undefined && process.versions.node !== undefined;
 
+// The repo's mustache.js is ESM source. Node >= 22.12 can `require()` it
+// natively (returning the module namespace, so the export lives on `default`);
+// older Node needs the `esm` shim. Feature-detect instead of version-sniffing,
+// and expose the result so cli-test.js knows whether spawned bin/mustache
+// processes need `--require esm`.
+function canRequireEsmSourceNatively () {
+  try {
+    return require('../mustache').default !== undefined;
+  } catch (err) {
+    return false;
+  }
+}
+
+usesEsmShim = false;
+
 if (isRunningInNode) {
   var nodejsMajorVersion = Number(process.versions.node.split('.')[0]);
   isLegacyNodeVersion = !(nodejsMajorVersion >= 10);
 
-  if (!isLegacyNodeVersion) {
-    // The `zuul` package we use to run tests in browsers via Saucelabs eagerly loads all
-    // packages it sees being used via `require()`. Because we don't want the `esm` package
-    // to be loaded when running browser tests, we refer to `require()` via `module.require()`
-    // because that avoid the mentioned eager loading
+  if (!isLegacyNodeVersion && !canRequireEsmSourceNatively()) {
+    usesEsmShim = true;
+    // Refer to `require()` via `module.require()` so bundlers that statically
+    // scan `require()` calls do not eagerly load the `esm` package when this
+    // file is bundled for a browser
     module.require = module.require('esm')(module);
   }
 }
 assert = chai.assert;
 chai.should();
 Mustache = require('../mustache');
