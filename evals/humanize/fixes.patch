+def test_byte_counts_beyond_float_range() -> None:
+    # float() answers a byte count past its range with OverflowError from an
+    # integer and with inf from a decimal string; both used to reach the output.
+    n = 10**320
+    assert humanize.naturalsize(n) == humanize.naturalsize(str(n))
+    assert humanize.naturalsize(n) == humanize.naturalsize("1e320")
+    assert "inf" not in humanize.naturalsize(n)
+    # 10**320 bytes is 10**290 QB, so the integer part carries 291 digits and
+    # opens with a 1; the trailing digits are the float mantissa's own, exactly
+    # as they are for any other value this side of float range.
+    mantissa = humanize.naturalsize(n).removesuffix(" QB").removesuffix(".0")
+    assert len(mantissa) == 291
+    assert mantissa.startswith("1")
+    assert humanize.naturalsize(-n) == "-" + humanize.naturalsize(n)
+    # Past the largest suffix no float mantissa is left, and saying so beats
+    # printing "inf QB".
+    with pytest.raises(ValueError, match="too large to express in QB"):
+        humanize.naturalsize(10**400)
+    with pytest.raises(ValueError, match="too large to express in Q:"):
+        humanize.naturalsize(10**400, gnu=True)
+
+
+@pytest.mark.parametrize(
+    "test_input, expected",
+    [
+        (math.nan, "NaN"),
+        (math.inf, "+Inf"),
+        (-math.inf, "-Inf"),
+        ("nan", "NaN"),
+        ("inf", "+Inf"),
+        ("-inf", "-Inf"),
+    ],
+)
+def test_naturalsize_not_finite(test_input: float | str, expected: str) -> None:
+    # Every humanize.number entry names a non-finite value; naturalsize used to
+    # raise on nan and print "inf QB" on an infinity.
+    assert humanize.naturalsize(test_input) == expected
+    assert humanize.naturalsize(test_input, binary=True) == expected
+    assert humanize.naturalsize(test_input, gnu=True) == expected
