+func TestMultiFilePrecedence(t *testing.T) {
+	// Load, Overload and Read take three different views of a key defined in
+	// more than one file, and each doc comment now states which. Nothing in
+	// the suite pinned any of them before, which is how Read's comment came to
+	// claim Load's semantics while doing the opposite.
+	dir := t.TempDir()
+	a := filepath.Join(dir, "a.env")
+	b := filepath.Join(dir, "b.env")
+	if err := os.WriteFile(a, []byte("SHARED=fromA\nONLY_A=1\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(b, []byte("SHARED=fromB\nONLY_B=2\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Read merges each file over the ones before it, so the last file wins.
+	envMap, err := Read(a, b)
+	if err != nil {
+		t.Fatalf("Read(a, b): %v", err)
+	}
+	if envMap["SHARED"] != "fromB" {
+		t.Errorf("Read(a, b) gave SHARED=%q, want fromB", envMap["SHARED"])
+	}
+	if envMap["ONLY_A"] != "1" || envMap["ONLY_B"] != "2" {
+		t.Errorf("Read(a, b) lost a key: %#v", envMap)
+	}
+
+	// Load never replaces anything already set, so the first file wins.
+	os.Unsetenv("SHARED")
+	t.Cleanup(func() { os.Unsetenv("SHARED") })
+	if err := Load(a, b); err != nil {
+		t.Fatalf("Load(a, b): %v", err)
+	}
+	if got := os.Getenv("SHARED"); got != "fromA" {
+		t.Errorf("Load(a, b) set SHARED=%q, want fromA", got)
+	}
+
+	// Overload replaces everything, so the last file wins.
+	os.Unsetenv("SHARED")
+	if err := Overload(a, b); err != nil {
+		t.Fatalf("Overload(a, b): %v", err)
+	}
+	if got := os.Getenv("SHARED"); got != "fromB" {
+		t.Errorf("Overload(a, b) set SHARED=%q, want fromB", got)
+	}
+
+	// Within a single file, all three keep the last definition.
+	single := filepath.Join(dir, "dup.env")
+	if err := os.WriteFile(single, []byte("DUP=first\nDUP=second\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	envMap, err = Read(single)
+	if err != nil {
+		t.Fatalf("Read(dup): %v", err)
+	}
+	if envMap["DUP"] != "second" {
+		t.Errorf("Read of a duplicated key gave %q, want second", envMap["DUP"])
+	}
+	os.Unsetenv("DUP")
+	t.Cleanup(func() { os.Unsetenv("DUP") })
+	if err := Load(single); err != nil {
+		t.Fatalf("Load(dup): %v", err)
+	}
+	if got := os.Getenv("DUP"); got != "second" {
+		t.Errorf("Load of a duplicated key set %q, want second", got)
+	}
+}
