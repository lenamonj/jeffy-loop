-	err := godotenv.Exec(envFilenames, cmd, cmdArgs, overload)
-	if err != nil {
-		log.Fatal(err)
+	if err := godotenv.Exec(envFilenames, cmd, cmdArgs, overload); err != nil {
+		// The command's own stdout and stderr are already wired through, so a
+		// command that ran and failed needs no message from us, only its exit
+		// status passed along. Anything else - a missing env file, a command
+		// that could not start - is ours to report.
+		var exitErr *exec.ExitError
