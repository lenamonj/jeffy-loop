+func TestEscapedQuoteAtEndOfValue(t *testing.T) {
+	// A quoted value whose last character before the terminator is an escaped
+	// quote used to lose it: the terminator had already been located, but the
+	// value was then cut by trimming quote runes off both ends, which ate the
+	// escaped one too and left its backslash behind. Every expected value here
+	// is what ruby dotenv 3.2.0 returns for the same input.
+	cases := map[string]string{
+		`A="he said \"hi\""`: `he said "hi"`,
+		`A="\""`:             `"`,
+		`A="a\"\""`:          `a""`,
+		`A='it\''`:           `it\'`,
+		`A='say \'hi\''`:     `say \'hi\'`,
+		`A="a\\\""`:          `a\"`,
+		// Unchanged neighbours, kept here so a future trim cannot creep back in
+		// without failing: an escaped quote in the middle, an escaped backslash
+		// at the end, and the plain forms.
+		`A="a\"b"`:  `a"b`,
+		`A="bar\\"`: `bar\`,
+		`A="plain"`: `plain`,
+		`A='plain'`: `plain`,
+		`A=""`:      ``,
+		`A=''`:      ``,
+	}
+	for input, want := range cases {
+		envMap, err := Unmarshal(input + "\n")
+		if err != nil {
+			t.Errorf("Unmarshal(%q): %v", input, err)
+			continue
+		}
+		if got := envMap["A"]; got != want {
+			t.Errorf("Unmarshal(%q) gave A=%q, want %q", input, got, want)
+		}
+	}
+
+	// The same defect broke the library's own round trip, which is the claim
+	// the README makes for Write: Marshal escaped these values correctly and
+	// the parser then ate the closing quote reading them back.
+	for _, v := range []string{`he said "hi"`, `"`, `a""`, `back\`, `plain`} {
+		marshalled, err := Marshal(map[string]string{"A": v})
+		if err != nil {
+			t.Errorf("Marshal(%q): %v", v, err)
+			continue
+		}
+		back, err := Unmarshal(marshalled)
+		if err != nil {
+			t.Errorf("Unmarshal(%q): %v", marshalled, err)
+			continue
+		}
+		if back["A"] != v {
+			t.Errorf("round trip of %q gave %q via %q", v, back["A"], marshalled)
+		}
+	}
+}
