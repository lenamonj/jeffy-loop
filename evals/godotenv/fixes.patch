+func TestPartialApplicationOnFailure(t *testing.T) {
+	// Loading several files is not atomic, and the doc comments on Load,
+	// Overload and Read now say so. The three ways a file can fail were found
+	// by provoking each step of the operation rather than by reading the code:
+	// the open, the parse, and the setenv the operating system refuses.
+	dir := t.TempDir()
+	good := filepath.Join(dir, "good.env")
+	badSyntax := filepath.Join(dir, "bad.env")
+	refused := filepath.Join(dir, "refused.env")
+	missing := filepath.Join(dir, "absent.env")
+	for path, body := range map[string]string{
+		good:      "PARTIAL_FIRST=one\n",
+		badSyntax: "PARTIAL_SECOND=two\nFOO BAR=x\n",
+		refused:   "PARTIAL_THIRD=three\n=orphan\n",
+	} {
+		if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	keys := []string{"PARTIAL_FIRST", "PARTIAL_SECOND", "PARTIAL_THIRD"}
+	clear := func() {
+		for _, k := range keys {
+			os.Unsetenv(k)
+		}
+	}
+	t.Cleanup(clear)
+
+	for _, loader := range []struct {
+		name string
+		load func(...string) error
+	}{{"Load", Load}, {"Overload", Overload}} {
+		clear()
+		if err := loader.load(good, missing); err == nil {
+			t.Fatalf("%s with a missing second file returned no error", loader.name)
+		} else if got := os.Getenv("PARTIAL_FIRST"); got != "one" {
+			t.Errorf("%s: an open failure undid the file before it: PARTIAL_FIRST=%q, want one", loader.name, got)
+		}
+
+		clear()
+		if err := loader.load(good, badSyntax); err == nil {
+			t.Fatalf("%s with an unparseable second file returned no error", loader.name)
+		} else {
+			if got := os.Getenv("PARTIAL_FIRST"); got != "one" {
+				t.Errorf("%s: a parse failure undid the file before it: PARTIAL_FIRST=%q, want one", loader.name, got)
+			}
+			if got, ok := os.LookupEnv("PARTIAL_SECOND"); ok {
+				t.Errorf("%s: a parse failure applied %q from the file it could not parse", loader.name, got)
+			}
+		}
+
+		// A refused variable is the one failure that reaches setenv at all, so
+		// it is the only one that can leave its own file partly applied. Which
+		// of that file's other keys made it through is map order and varies
+		// between runs, so only the deterministic half is asserted here.
+		clear()
+		if err := loader.load(good, refused); err == nil {
+			t.Fatalf("%s with a refused variable returned no error", loader.name)
+		} else if got := os.Getenv("PARTIAL_FIRST"); got != "one" {
+			t.Errorf("%s: a refused variable undid the file before it: PARTIAL_FIRST=%q, want one", loader.name, got)
+		}
+	}
+
+	// Read carries the same shape into its return value: what it merged before
+	// the failure comes back with the error rather than being discarded.
+	clear()
+	envMap, err := Read(good, missing)
+	if err == nil {
+		t.Fatal("Read with a missing second file returned no error")
+	}
+	if envMap["PARTIAL_FIRST"] != "one" {
+		t.Errorf("Read discarded what it had merged before the failure: %#v", envMap)
+	}
+}
