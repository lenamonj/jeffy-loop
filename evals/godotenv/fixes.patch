+	// The content still reads back, so the mode change did not cost the write.
+	back, err := Read(created)
+	if err != nil {
+		t.Fatalf("Read: %v", err)
+	}
+	if back["API_TOKEN"] != "s3cr3t" {
+		t.Errorf("Read of the written file gave %#v", back)
+	}
+}
