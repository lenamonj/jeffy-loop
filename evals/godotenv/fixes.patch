+func TestBOM(t *testing.T) {
+	// A Windows editor writes a UTF-8 byte order mark at the start of the file.
+	// Ruby dotenv drops it by reading env files as "rb:bom|utf-8" and node
+	// dotenv's line pattern treats U+FEFF as leading whitespace, so both parse
+	// a marked file. This parser used to reject one with a message naming a
+	// character the file does not contain.
+	const bom = "\uFEFF"
+
+	parsed := map[string]map[string]string{
+		bom + "A=1\n":            {"A": "1"},
+		bom + "# comment\nA=1\n": {"A": "1"},
+		bom + "export A=1\n":     {"A": "1"},
+		bom + "A=1\nB=2\n":       {"A": "1", "B": "2"},
+	}
+	for input, want := range parsed {
+		got, err := Unmarshal(input)
+		if err != nil {
+			t.Errorf("Unmarshal(%q): %v", input, err)
+			continue
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("Unmarshal(%q) gave %#v, want %#v", input, got, want)
+		}
+	}
+
+	// The mark on its own leaves an empty file, not an error.
+	if got, err := Unmarshal(bom); err != nil || len(got) != 0 {
+		t.Errorf("Unmarshal of the mark alone gave %#v, %v; want an empty map and no error", got, err)
+	}
+
+	// Only a leading mark is a byte order mark. One in the middle of the file
+	// is a stray character in a variable name and stays an error.
+	if got, err := Unmarshal("A=1\n" + bom + "B=2\n"); err == nil {
+		t.Errorf("Unmarshal with a mid-file mark gave %#v with nil error, want an error", got)
+	}
+
+	// The file path matters as much as the string path: writing the file is how
+	// a marked env file reaches the parser in practice.
+	dir := t.TempDir()
+	marked := filepath.Join(dir, "bom.env")
+	if err := os.WriteFile(marked, []byte(bom+"BOM_KEY=value\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	envMap, err := Read(marked)
+	if err != nil {
+		t.Fatalf("Read(%q): %v", marked, err)
+	}
+	if envMap["BOM_KEY"] != "value" {
+		t.Errorf("Read of a marked file gave %#v, want BOM_KEY=value", envMap)
+	}
+
+	os.Unsetenv("BOM_KEY")
+	t.Cleanup(func() { os.Unsetenv("BOM_KEY") })
+	if err := Load(marked); err != nil {
+		t.Fatalf("Load(%q): %v", marked, err)
+	}
+	if got := os.Getenv("BOM_KEY"); got != "value" {
+		t.Errorf("Load of a marked file set BOM_KEY=%q, want value", got)
+	}
+}
