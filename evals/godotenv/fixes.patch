+func TestWriteFileMode(t *testing.T) {
+	// An env file holds credentials, so Write creates one at 0600 rather than
+	// letting os.Create ask for 0666 and leaving the umask to decide - which
+	// left a new file at 0644, readable by every account on the machine.
+	if runtime.GOOS == "windows" {
+		t.Skip("Windows carries no POSIX permission bits to assert")
+	}
+
+	dir := t.TempDir()
+	created := filepath.Join(dir, "created.env")
+	if err := Write(map[string]string{"API_TOKEN": "s3cr3t"}, created); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	info, err := os.Stat(created)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := info.Mode().Perm(); got != 0o600 {
+		t.Errorf("Write created a file with mode %04o, want 0600", got)
+	}
+
+	// An existing file keeps its own mode: the mode argument applies only when
+	// the file is created, and a deployment that relaxed one on purpose should
+	// not have that quietly reverted.
+	existing := filepath.Join(dir, "existing.env")
+	if err := os.WriteFile(existing, []byte("OLD=1\n"), 0o640); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(existing, 0o640); err != nil {
+		t.Fatal(err)
+	}
+	if err := Write(map[string]string{"API_TOKEN": "s3cr3t"}, existing); err != nil {
+		t.Fatalf("Write over an existing file: %v", err)
+	}
+	info, err = os.Stat(existing)
