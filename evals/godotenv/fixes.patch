+			if code := exitErr.ExitCode(); code >= 0 {
+				os.Exit(code)
+			}
+			// Terminated by a signal, so there is no exit code to forward.
+			os.Exit(1)
+		}
+		fmt.Fprintln(os.Stderr, "godotenv:", err)
+		os.Exit(1)
 	}
 }
diff --git a/cmd/godotenv/cmd_test.go b/cmd/godotenv/cmd_test.go
new file mode 100644
index 0000000..597e5ab
--- /dev/null
+++ b/cmd/godotenv/cmd_test.go
@@ -0,0 +1,159 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+// buildCLI builds the command once per test binary and returns its path. The
+// CLI is only observable as a process - its whole contract is what it puts on
+// stdout and what exit status it leaves behind - so every assertion below runs
+// the real binary rather than calling into main.
+func buildCLI(t *testing.T) string {
+	t.Helper()
+	if runtime.GOOS == "windows" {
+		t.Skip("these cases invoke a POSIX shell as the child command")
+	}
+
+	bin := filepath.Join(t.TempDir(), "godotenv")
+	build := exec.Command("go", "build", "-o", bin, ".")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("go build: %v\n%s", err, out)
+	}
+	return bin
+}
+
+func runCLI(t *testing.T, bin, dir string, args ...string) (stdout, stderr string, code int) {
+	t.Helper()
+	cmd := exec.Command(bin, args...)
+	cmd.Dir = dir
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "PRESET=fromEnv"}
+
+	var outBuf, errBuf strings.Builder
+	cmd.Stdout = &outBuf
+	cmd.Stderr = &errBuf
+
+	if err := cmd.Run(); err != nil {
+		exitErr, ok := err.(*exec.ExitError)
+		if !ok {
+			t.Fatalf("running %v: %v", args, err)
+		}
+		code = exitErr.ExitCode()
+	}
+	return outBuf.String(), errBuf.String(), code
+}
+
+func envFile(t *testing.T, dir, name, body string) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// The command is a wrapper, so a script calling it has to be able to read the
+// wrapped command's exit status. It used to collapse every non-zero status to
+// 1 and print the failure with a log timestamp on top.
+func TestExitStatusIsPassedThrough(t *testing.T) {
+	bin := buildCLI(t)
+	dir := t.TempDir()
+	f := envFile(t, dir, "x.env", "A=1\n")
+
+	for _, want := range []int{0, 1, 7, 130} {
+		_, stderr, code := runCLI(t, bin, dir, "-f", f, "sh", "-c", "exit "+itoa(want))
+		if code != want {
+			t.Errorf("child exiting %d gave cli exit %d", want, code)
+		}
+		if stderr != "" {
+			t.Errorf("child exiting %d produced unexpected stderr %q", want, stderr)
+		}
+	}
+}
+
+// A failure that is ours rather than the child's is reported on stderr, named,
+// and without a timestamp.
+func TestOwnFailuresAreReported(t *testing.T) {
+	bin := buildCLI(t)
+	dir := t.TempDir()
+	f := envFile(t, dir, "x.env", "A=1\n")
+
+	_, stderr, code := runCLI(t, bin, dir, "-f", filepath.Join(dir, "absent.env"), "true")
+	if code != 1 {
+		t.Errorf("a missing env file gave cli exit %d, want 1", code)
+	}
+	if !strings.HasPrefix(stderr, "godotenv: ") {
+		t.Errorf("a missing env file printed %q, want a godotenv: prefix", stderr)
+	}
+
+	_, stderr, code = runCLI(t, bin, dir, "-f", f, "definitely-not-a-real-binary")
+	if code != 1 {
+		t.Errorf("a missing command gave cli exit %d, want 1", code)
+	}
+	if !strings.HasPrefix(stderr, "godotenv: ") {
+		t.Errorf("a missing command printed %q, want a godotenv: prefix", stderr)
+	}
+}
+
+// The env file reaches the child, and -o decides whether it replaces a
+// variable the child already had.
+func TestEnvReachesChild(t *testing.T) {
+	bin := buildCLI(t)
+	dir := t.TempDir()
+	f := envFile(t, dir, "x.env", "PRESET=fromFile\nFRESH=fromFile\n")
+
+	stdout, _, code := runCLI(t, bin, dir, "-f", f, "sh", "-c", `printf '%s,%s' "$PRESET" "$FRESH"`)
+	if code != 0 || stdout != "fromEnv,fromFile" {
+		t.Errorf("without -o got %q exit %d, want %q and 0", stdout, code, "fromEnv,fromFile")
+	}
+
+	stdout, _, code = runCLI(t, bin, dir, "-o", "-f", f, "sh", "-c", `printf '%s,%s' "$PRESET" "$FRESH"`)
+	if code != 0 || stdout != "fromFile,fromFile" {
+		t.Errorf("with -o got %q exit %d, want %q and 0", stdout, code, "fromFile,fromFile")
+	}
+}
+
+// With no -f the command falls back to .env in the working directory.
+func TestDefaultsToDotEnv(t *testing.T) {
+	bin := buildCLI(t)
+	dir := t.TempDir()
+	envFile(t, dir, ".env", "FRESH=fromDefault\n")
+
+	stdout, _, code := runCLI(t, bin, dir, "sh", "-c", `printf %s "$FRESH"`)
+	if code != 0 || stdout != "fromDefault" {
+		t.Errorf("default .env got %q exit %d, want %q and 0", stdout, code, "fromDefault")
+	}
+}
+
+// -h and a bare invocation both print usage and exit 0 without running anything.
+func TestUsage(t *testing.T) {
+	bin := buildCLI(t)
+	dir := t.TempDir()
+
+	for _, args := range [][]string{{}, {"-h"}} {
+		stdout, _, code := runCLI(t, bin, dir, args...)
+		if code != 0 {
+			t.Errorf("%v exited %d, want 0", args, code)
+		}
+		if !strings.Contains(stdout, "Run a process with an env setup from a .env file") {
+			t.Errorf("%v did not print usage, got %q", args, stdout)
+		}
+	}
+}
+
+// itoa keeps the test free of a strconv import for four small numbers.
+func itoa(n int) string {
+	if n == 0 {
+		return "0"
+	}
+	var digits []byte
+	for n > 0 {
+		digits = append([]byte{byte('0' + n%10)}, digits...)
+		n /= 10
+	}
+	return string(digits)
+}
