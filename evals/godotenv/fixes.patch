+++ b/autoload/autoload_test.go
@@ -0,0 +1,129 @@
+package autoload_test
+
+// autoload's whole contract is one init function, and an init only shows up in
+// a process that has already started, so nothing inside this test binary can
+// observe it: by the time a test runs, the import has long since happened and
+// the working directory is this package's own. Each case therefore builds a
+// small program that imports autoload for its side effect and runs it in a
+// directory this test controls. That is also why the test file imports nothing
+// from the package it covers.
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// buildProbe compiles a program importing autoload against this working copy,
+// through a replace directive pointing at the module root, and returns its path.
+func buildProbe(t *testing.T) string {
+	t.Helper()
+
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A replace directive takes the path verbatim, and CI runs this on Windows
+	// too, where Abs returns backslashes; the go command accepts forward
+	// slashes on every platform.
+	root = filepath.ToSlash(root)
+
+	build := t.TempDir()
+	main := `package main
+
+import (
+	"fmt"
+	"os"
+
+	_ "github.com/joho/godotenv/autoload"
+)
+
+func main() {
+	fmt.Printf("AUTOLOADED=%q\n", os.Getenv("AUTOLOADED"))
+}
+`
+	mod := "module autoloadprobe\n\ngo 1.22\n\nrequire github.com/joho/godotenv v0.0.0\n\nreplace github.com/joho/godotenv => " + root + "\n"
+
+	if err := os.WriteFile(filepath.Join(build, "main.go"), []byte(main), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(build, "go.mod"), []byte(mod), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	bin := filepath.Join(t.TempDir(), "autoloadprobe")
+	cmd := exec.Command("go", "build", "-o", bin, ".")
+	cmd.Dir = build
+	cmd.Env = append(os.Environ(), "GOFLAGS=-mod=mod")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("go build: %v\n%s", err, out)
+	}
+	return bin
+}
+
+// runProbe runs the program in dir with an environment carrying nothing of its
+// own, so an answer can only have come from the file autoload read.
+func runProbe(t *testing.T, bin, dir string) string {
+	t.Helper()
+	cmd := exec.Command(bin)
+	cmd.Dir = dir
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "HOME=" + os.Getenv("HOME")}
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("probe run in %s: %v\n%s", dir, err, out)
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func workdir(t *testing.T, dotenv string) string {
+	t.Helper()
+	dir := t.TempDir()
+	if dotenv != "" {
+		if err := os.WriteFile(filepath.Join(dir, ".env"), []byte(dotenv), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+// The file is read from the working directory, so the same binary must give
+// three different answers in three directories. Two files that differ prove the
+// value came from the file rather than from anything ambient, and the directory
+// with no .env proves a missing file is not fatal, which is the whole reason
+// autoload discards the error Load returns.
+func TestAutoloadReadsDotEnvFromWorkingDirectory(t *testing.T) {
+	bin := buildProbe(t)
+
+	for _, c := range []struct {
+		name, dotenv, want string
+	}{
+		{"a .env sets the variable", "AUTOLOADED=yes\n", `AUTOLOADED="yes"`},
+		{"a different .env sets a different value", "AUTOLOADED=different\n", `AUTOLOADED="different"`},
+		{"no .env leaves it unset and does not abort", "", `AUTOLOADED=""`},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			if got := runProbe(t, bin, workdir(t, c.dotenv)); got != c.want {
+				t.Errorf("probe printed %s, want %s", got, c.want)
+			}
+		})
+	}
+}
+
+// Load never replaces a variable that is already set, and autoload is Load, so
+// an ambient value has to survive a .env that disagrees with it.
+func TestAutoloadDoesNotOverrideTheEnvironment(t *testing.T) {
+	bin := buildProbe(t)
+
+	cmd := exec.Command(bin)
+	cmd.Dir = workdir(t, "AUTOLOADED=fromFile\n")
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "HOME=" + os.Getenv("HOME"), "AUTOLOADED=fromEnv"}
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("probe run: %v\n%s", err, out)
+	}
+	if got, want := strings.TrimSpace(string(out)), `AUTOLOADED="fromEnv"`; got != want {
+		t.Errorf("probe printed %s, want %s", got, want)
+	}
+}
