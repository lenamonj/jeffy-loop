+func TestGetMachineIDRecoversFromAnEmptyCache(t *testing.T) {
+	// Same failure seen from inside: the Once is spent and the cache is empty.
+	t.Setenv("XID_MACHINE_ID", "")
+	saved := machineID
+	machineID = nil
+	defer func() { machineID = saved }()
+
+	if got := getMachineID(); len(got) != rawMachineLen {
+		t.Fatalf("getMachineID() returned %d bytes, want %d", len(got), rawMachineLen)
+	}
