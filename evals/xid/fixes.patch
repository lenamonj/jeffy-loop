+func TestIDJSONUnmarshalingRejectsNonStringTokens(t *testing.T) {
+	// encoding/json hands the raw token to UnmarshalJSON, so a token of the
+	// right length that is not a string must still be rejected: stripping its
+	// first and last byte once turned a 22-digit number into a valid ID.
+	for _, doc := range []string{
+		`{"ID":1234567890123456789000}`,
+		`{"ID":-123456789012345678900}`,
+		`{"ID":1.23456789012345678e+3}`,
+		`{"ID":12345678901234567890}`,
+		`{"ID":true}`,
+		`{"ID":[1,2]}`,
+		`{"ID":{"a":1}}`,
+	} {
+		v := jsonType{}
+		if err := json.Unmarshal([]byte(doc), &v); err != ErrInvalidID {
+			t.Errorf("json.Unmarshal(%s) err=%v, want %v", doc, err, ErrInvalidID)
+		}
+	}
+}
