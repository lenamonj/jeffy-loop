+// containerPID mixes the cgroup cpuset path into pid so two processes holding
+// the same pid in different containers do not produce the same id. The root
+// cpuset carries no such information - every process outside a container reads
+// it, and on cgroup v2 so does every process inside one - so it is left alone:
+// mixing it in only made Pid() disagree with os.Getpid() everywhere. The
+// checksum is taken over the bytes as read, trailing newline included, so ids
+// minted inside a container are unchanged.
+func containerPID(pid int, cpuset []byte) int {
+	if len(bytes.TrimSpace(cpuset)) > 1 {
+		return pid ^ int(crc32.ChecksumIEEE(cpuset))
+	}
+	return pid
+}
