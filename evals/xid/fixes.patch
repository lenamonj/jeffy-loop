+func TestPidMatchesOSPidOutsideAContainer(t *testing.T) {
+	// Outside a container - no cpuset file at all, or the root cpuset - the pid
+	// part of a generated id is the process id, which is what the package doc
+	// and Pid() promise.
+	b, err := os.ReadFile("/proc/self/cpuset")
+	if err == nil && len(bytes.TrimSpace(b)) > 1 {
+		t.Skipf("running under cgroup path %q, where the pid is mixed by design", bytes.TrimSpace(b))
+	}
+	if got, want := New().Pid(), uint16(os.Getpid()); got != want {
+		t.Errorf("New().Pid() = %d, want %d", got, want)
+	}
+}
+
+func TestMachineIDPanicRepeatsItsMessage(t *testing.T) {
+	// sync.Once counts a panicking call as done, so the machine id stays
+	// unresolved after readMachineID panics. A caller that recovers that panic
+	// - an http handler with a recovery middleware, say - must keep getting the
+	// real failure from later calls rather than an index error on an empty id.
+	if os.Getenv("XID_TEST_RECOVERED_PANIC") == "1" {
+		func() {
+			defer func() { recover() }()
+			New()
+		}()
+		defer func() { fmt.Fprintf(os.Stderr, "second panic: %v\n", recover()) }()
+		New()
+		fmt.Fprintln(os.Stderr, "second panic: none")
+		return
+	}
+
+	cmd := exec.Command(os.Args[0], "-test.run=TestMachineIDPanicRepeatsItsMessage")
+	cmd.Env = append(os.Environ(), "XID_TEST_RECOVERED_PANIC=1", "XID_MACHINE_ID=not-a-number")
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("child run failed: %v\n%s", err, out)
+	}
+	if want := "second panic: XID_MACHINE_ID value is set to not a number"; !strings.Contains(string(out), want) {
+		t.Errorf("child output does not contain %q:\n%s", want, out)
+	}
+}
