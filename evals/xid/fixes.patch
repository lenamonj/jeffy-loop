+func TestContainerPID(t *testing.T) {
+	const pid = 1234
+	docker := "/docker/3b2e6ad0f0a7bd97f6bd1a4bd9e5f6ac4f0c1d2e\n"
+	kube := "/kubepods/besteffort/pod9c26dfa1/f3a8b2c1\n"
+
+	for _, tt := range []struct {
+		name   string
+		cpuset string
+		want   int
+	}{
+		// The root cpuset is what every process outside a container reads, and
+		// on cgroup v2 what every process inside one reads too, so it must not
+		// change the pid.
+		{"root", "/", pid},
+		{"root with newline", "/\n", pid},
+		{"empty", "", pid},
+		{"single byte", "x", pid},
+		{"docker", docker, pid ^ int(crc32.ChecksumIEEE([]byte(docker)))},
+		{"kubepods", kube, pid ^ int(crc32.ChecksumIEEE([]byte(kube)))},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := containerPID(pid, []byte(tt.cpuset)); got != tt.want {
+				t.Errorf("containerPID(%d, %q) = %d, want %d", pid, tt.cpuset, got, tt.want)
+			}
+		})
+	}
+
+	if containerPID(pid, []byte(docker)) == containerPID(pid, []byte(kube)) {
+		t.Error("two different cpuset paths produced the same pid")
+	}
+	if containerPID(pid, []byte(docker)) == pid {
+		t.Error("a container cpuset path left the pid unchanged")
+	}
+}
