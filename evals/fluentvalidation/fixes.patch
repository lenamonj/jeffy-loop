+
+namespace FluentValidation.Tests;
+
+using System;
+using System.Collections.Generic;
+
+/// <summary>
+/// Comparison helpers that return a difference rather than -1, 0 or 1. Both IComparable
+/// and IComparer only fix the sign of the result, so these are in contract, and they are
+/// what distinguishes a guard written against the sign from one written against the value.
+/// </summary>
+class SubtractingIntComparer : IComparer<int> {
+	public int Compare(int x, int y) => x - y;
+}
+
+readonly struct Money : IComparable<Money>, IComparable {
+	public int Amount { get; }
+
+	public Money(int amount) => Amount = amount;
+
+	public int CompareTo(Money other) => Amount - other.Amount;
+
+	public int CompareTo(object obj) => obj is Money other
+		? CompareTo(other)
+		: throw new ArgumentException("Can't compare", nameof(obj));
+
+	public override string ToString() => Amount.ToString();
+}
