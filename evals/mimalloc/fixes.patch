index cd915e3a..f5daca36 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -933,8 +933,15 @@ foreach(item IN LISTS mi_libraries)
 endforeach()
 
 include("cmake/JoinPaths.cmake")
-join_paths(mi_pc_includedir "\${prefix}" "${CMAKE_INSTALL_INCLUDEDIR}")
+# these must follow the directories we actually install to, not the standard ones:
+# with the default (versioned) layout the headers go to `mi_install_incdir` and the
+# static library and object file to `mi_install_objdir`, so a .pc file naming
+# ${CMAKE_INSTALL_INCLUDEDIR} hands out an include path with no mimalloc.h in it.
+# The shared library and its symlinks do land directly in ${CMAKE_INSTALL_LIBDIR},
+# so `libdir` keeps naming that and `objdir` is added for the static link.
+join_paths(mi_pc_includedir "\${prefix}" "${mi_install_incdir}")
 join_paths(mi_pc_libdir "\${prefix}" "${CMAKE_INSTALL_LIBDIR}")
+join_paths(mi_pc_objdir "\${prefix}" "${mi_install_objdir}")
 
 configure_file(mimalloc.pc.in mimalloc.pc @ONLY)
 install(FILES "${CMAKE_CURRENT_BINARY_DIR}/mimalloc.pc"
