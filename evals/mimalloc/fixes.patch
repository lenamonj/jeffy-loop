+// Options whose domain is boolean, so that an empty environment value spells "on".
+// Everything else - a count, a size, a rate, a delay - takes an empty value as the
+// invalid value it is, and warns. The set is exactly the options the library reads
+// through `mi_option_is_enabled`, which is what makes it checkable rather than a
+// judgement: `.jeffy/probes/options-api/empty-value.sh` sets each option to an empty
+// value in turn and reports any option outside this set whose value moves.
+static bool mi_option_is_boolean(mi_option_t option) {
+  switch (option) {
+    case mi_option_allow_large_os_pages:
+    case mi_option_allow_thp:
+    case mi_option_arena_is_numa_local:
+    case mi_option_destroy_on_exit:
+    case mi_option_disallow_arena_alloc:
+    case mi_option_disallow_os_alloc:
+    case mi_option_guarded_precise:
+    case mi_option_pagemap_commit:
+    case mi_option_purge_decommits:
+    case mi_option_reserve_huge_os_pages:
+    case mi_option_reserve_os_memory:
+    case mi_option_show_errors:
+    case mi_option_show_stats:
+    case mi_option_verbose:
+      return true;
+    default:
+      return false;
+  }
