@@ -212,6 +212,22 @@ mi_decl_export void mi_thread_set_in_threadpool(void) mi_attr_noexcept; // commu
 
 // -----------------------------------------------------------------
 // Return allocated block size (if the return value is not NULL)
+//
+// `block_size` is the size of the whole heap block the allocation was
+// served from. It is not the number of bytes available at the returned
+// pointer, and the two differ in two cases:
+//
+// - the aligned forms may place the returned pointer inside a larger
+//   block, so part of `block_size` lies *before* the pointer. For
+//   example `mi_umalloc_aligned(100, 512, &block_size)` can report 640
+//   while only 256 bytes are available at the pointer it returns.
+// - when built with padding (`MI_PADDING`, on by default in debug
+//   builds) `block_size` includes the padding bytes, which are reserved
+//   for overflow detection and must not be written.
+//
+// Use `mi_usable_size(p)` for the number of bytes that may be written at
+// `p`; `block_size` is for accounting, and `mi_ufree` reports the same
+// figure for a block that the allocating call did, so the two balance.
 // -----------------------------------------------------------------
 
 mi_decl_nodiscard mi_decl_export mi_decl_restrict void* mi_umalloc(size_t size, size_t* block_size)  mi_attr_noexcept mi_attr_malloc mi_attr_alloc_size(1);
