diff --git a/test/rules/std_RF06_function_name_test.py b/test/rules/std_RF06_function_name_test.py
new file mode 100644
index 000000000..ff397f0c9
--- /dev/null
+++ b/test/rules/std_RF06_function_name_test.py
@@ -0,0 +1,63 @@
+"""RF06 must be able to unquote a function name.
+
+The fix replaces the quoted identifier with a `naked_identifier`, but
+`FunctionNameSegment`'s base-name alternatives keyed on the raw lexer type
+`word`, so the linter's segment-level revalidation could not rematch its own
+fix and refused it with `Fixes for RF06 not applied, as it would result in an
+unparsable file`. `sqlfluff fix` then reported a fixable violation and left
+the file byte-identical.
+"""
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+
+_QUOTED = """CREATE FUNCTION `testfunction`(var1 int)
+RETURNS int
+DETERMINISTIC
+BEGIN
+RETURN (var1 + 1);
+END~
+"""
+
+_UNQUOTED = """CREATE FUNCTION testfunction(var1 int)
+RETURNS int
+DETERMINISTIC
+BEGIN
+RETURN (var1 + 1);
+END~
+"""
+
+
+def _linter(rules: str = "RF06") -> Linter:
+    return Linter(config=FluffConfig(overrides={"dialect": "mariadb", "rules": rules}))
+
+
+def test_rf06_unquotes_a_function_name() -> None:
+    """The fix is applied rather than refused as unparsable."""
+    fixed, _ = _linter().lint_string(_QUOTED, fix=True).fix_string()
+    assert fixed == _UNQUOTED
+
+
+def test_rf06_fixed_output_parses_clean() -> None:
+    """The fixed text has no parse violation and no unparsable segment."""
+    parsed = _linter().parse_string(_UNQUOTED)
+    assert parsed.violations == []
+    assert not list(parsed.tree.recursive_crawl("unparsable"))
+
+
+def test_rf06_fix_is_a_fixed_point() -> None:
+    """A second pass changes nothing."""
+    linter = _linter()
+    first, _ = linter.lint_string(_QUOTED, fix=True).fix_string()
+    second, _ = linter.lint_string(first, fix=True).fix_string()
+    assert second == first
+
+
+@pytest.mark.parametrize("sql", [_QUOTED, _UNQUOTED])
+def test_function_name_rematches_its_own_shape(sql: str) -> None:
+    """`function_name` still matches a whole re-parse of itself."""
+    tree = _linter("all").parse_string(sql).tree
+    names = list(tree.recursive_crawl("function_name"))
+    assert names
+    assert names[0].raw.strip("`") == "testfunction"
diff --git a/test/rules/std_ST07_LT02_combo_test.py b/test/rules/std_ST07_LT02_combo_test.py
new file mode 100644
index 000000000..e781b5f92
--- /dev/null
+++ b/test/rules/std_ST07_LT02_combo_test.py
@@ -0,0 +1,75 @@
+"""Regression test for the ST07 fix leaving the indent balance short.
+
+ST07 rewrites ``USING (col)`` into an ``ON`` condition. The USING form carries
+an indent between the keyword and its bracket while the matching dedent sits
+after the bracket, outside the run ST07 deletes, so the rewrite used to leave
+the file's indent balance one short from that join onwards. LT02 then indented
+everything after it one level too shallow, and a single ``fix`` pass reported
+success over a file that was still not compliant - a second pass fixed it.
+"""
+
+from sqlfluff.core import FluffConfig, Linter
+
+# Two USING joins: the rewrite of the first is what corrupted the second.
+_TWO_USING_JOINS = """SELECT cars.name, cars.manufacturer
+FROM cars SEMI JOIN region
+USING (region_id);
+
+SELECT cars.name, cars.manufacturer
+FROM cars ANTI JOIN region
+USING (region_id);
+"""
+
+_FIXED = """SELECT
+    cars.name,
+    cars.manufacturer
+FROM cars SEMI JOIN region
+    ON cars.region_id = region.region_id;
+
+SELECT
+    cars.name,
+    cars.manufacturer
+FROM cars ANTI JOIN region
+    ON cars.region_id = region.region_id;
+"""
+
+
+def _linter() -> Linter:
+    return Linter(
+        config=FluffConfig(overrides={"dialect": "duckdb", "rules": "all"})
+    )
+
+
+def test_rules_std_ST07_one_fix_pass_is_enough() -> None:
+    """One `fix` pass over consecutive USING joins must leave nothing behind."""
+    linter = _linter()
+    fixed, _ = linter.lint_string(_TWO_USING_JOINS, fix=True).fix_string()
+    assert fixed == _FIXED
+    # The point of the test: the output of a *single* pass is already clean.
+    assert linter.lint_string(fixed).check_tuples() == []
+
+
+def test_rules_std_ST07_fixture_one_fix_pass_is_enough() -> None:
+    """The same, over the shipped fixture that surfaced this."""
+    with open("test/fixtures/dialects/duckdb/anti_semi_join.sql") as f:
+        sql = f.read()
+    linter = _linter()
+    fixed, _ = linter.lint_string(sql, fix=True).fix_string()
+    assert linter.lint_string(fixed).check_tuples() == []
+
+
+def test_rules_std_ST07_fix_keeps_the_indent_balance() -> None:
+    """The rewritten tree carries the same indent metas as a fresh parse."""
+    linter = _linter()
+    fixed_tree = linter.lint_string(_TWO_USING_JOINS, fix=True).tree
+    fresh_tree = linter.parse_string(fixed_tree.raw).tree
+
+    def indents(tree):
+        return [
+            (seg.get_type(), getattr(seg, "indent_val", 0))
+            for seg in tree.raw_segments
+            if getattr(seg, "indent_val", 0)
+        ]
+
+    assert indents(fixed_tree) == indents(fresh_tree)
+    assert sum(v for _, v in indents(fixed_tree)) == 0
diff --git a/test/rules/std_ST07_asof_join_test.py b/test/rules/std_ST07_asof_join_test.py
new file mode 100644
index 000000000..4e8c4c291
--- /dev/null
+++ b/test/rules/std_ST07_asof_join_test.py
@@ -0,0 +1,55 @@
+"""ST07 must leave ASOF joins alone.
+
+An ASOF join's ``USING`` list is not a list of equalities: the last attribute
+in it is an inequality, which is what makes the join an ASOF join. Rewriting
+it into all-equality ``ON`` conditions changes which rows the query returns.
+ST07 used to do exactly that on the one-column form, and on the two-column
+form the linter's unparsable-fix guard refused the rewrite, so ``fix``
+reported fixable violations and changed nothing.
+"""
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+
+ASOF_CASES = [
+    "SELECT * FROM trades ASOF JOIN prices USING (symbol);\n",
+    'SELECT * FROM trades ASOF JOIN prices USING (symbol, "when");\n',
+    'SELECT * FROM trades AS t ASOF LEFT JOIN prices AS p USING (symbol, "when");\n',
+    "SELECT * FROM trades AS t ASOF SEMI JOIN prices AS p USING (symbol);\n",
+]
+
+_PLAIN_USING = "SELECT * FROM trades JOIN prices USING (symbol);\n"
+
+
+def _linter() -> Linter:
+    return Linter(config=FluffConfig(overrides={"dialect": "duckdb", "rules": "ST07"}))
+
+
+@pytest.mark.parametrize("sql", ASOF_CASES)
+def test_st07_ignores_asof_joins(sql: str) -> None:
+    """No violation, and `fix` leaves the text byte-identical."""
+    linter = _linter()
+    result = linter.lint_string(sql, fix=True)
+    assert [v.rule_code() for v in result.violations] == []
+    fixed, _ = result.fix_string()
+    assert fixed == sql
+
+
+def test_st07_still_rewrites_a_plain_using_join() -> None:
+    """The control: a non-ASOF USING join is still rewritten."""
+    fixed, _ = _linter().lint_string(_PLAIN_USING, fix=True).fix_string()
+    assert fixed == (
+        "SELECT * FROM trades JOIN prices ON trades.symbol = prices.symbol;\n"
+    )
+
+
+def test_st07_leaves_the_shipped_asof_fixture_alone() -> None:
+    """The whole fixture is clean, so no fix is refused as unparsable."""
+    with open("test/fixtures/dialects/duckdb/asof_join.sql") as f:
+        sql = f.read()
+    linter = _linter()
+    result = linter.lint_string(sql, fix=True)
+    assert [v.rule_code() for v in result.violations] == []
+    fixed, _ = result.fix_string()
+    assert fixed == sql
diff --git a/test/utils/testing/rules_test.py b/test/utils/testing/rules_test.py
new file mode 100644
index 000000000..0243256f8
--- /dev/null
+++ b/test/utils/testing/rules_test.py
@@ -0,0 +1,25 @@
+"""Tests for the rule-testing helpers in sqlfluff.utils.testing.rules."""
+
+import pytest
+
+from sqlfluff.utils.testing.rules import RuleTestCase, rules__test_helper
+
+
+def test__testing__rules_helper_rejects_unparsable_before_fixing():
+    """The helper must reject input that has no parse tree, not try to fix it.
+
+    `rules__test_helper` calls `LintedFile.fix_string()`, which asserts that
+    templating and parsing both succeeded. A test case whose SQL cannot be
+    parsed has to fail at the parse-error check with a message naming the parse
+    error, rather than reaching that assertion.
+    """
+    case = RuleTestCase(
+        rule="LT01",
+        fail_str="SELECT  a FROM tbl\nSELECT FROM WHERE (((\n",
+        configs={"core": {"dialect": "ansi"}},
+    )
+    with pytest.raises(BaseException) as excinfo:
+        rules__test_helper(case)
+    message = str(excinfo.value)
+    assert "Found the following parse errors in test case" in message
+    assert "Fixing a string requires successful templating" not in message
