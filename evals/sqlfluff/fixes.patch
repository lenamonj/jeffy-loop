diff --git a/test/core/parser/rust_parser_iteration_limit_test.py b/test/core/parser/rust_parser_iteration_limit_test.py
new file mode 100644
index 000000000..981975c2c
--- /dev/null
+++ b/test/core/parser/rust_parser_iteration_limit_test.py
@@ -0,0 +1,65 @@
+"""The Rust parser's iteration limit must report, not panic.
+
+The guard used to call ``panic!``, which crosses the PyO3 boundary as
+``pyo3_runtime.PanicException`` - a ``BaseException``, so an integrating
+caller's ``except Exception`` never caught it and ``sqlfluff lint`` ended in a
+raw traceback. Its sibling guard, ``max_parse_depth``, has always returned a
+normal parse error; this pins that the iteration guard now does too.
+"""
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+from sqlfluff.core.parser.rust_parser import _HAS_RUST_PARSER
+
+pytestmark = pytest.mark.skipif(
+    not _HAS_RUST_PARSER, reason="sqlfluffrs extension is not installed"
+)
+
+# Small enough that the limit trips in milliseconds rather than minutes.
+_TIGHT_LIMIT = 50
+_SQL = "SELECT a, b, c FROM tbl WHERE a = 1 AND b = 2\n"
+
+
+def _linter(limit: int) -> Linter:
+    return Linter(
+        config=FluffConfig(
+            overrides={
+                "dialect": "ansi",
+                "use_rust_parser": "true",
+                "rust_parser_max_iterations": limit,
+                "rust_parser_warn_threshold": limit,
+            }
+        )
+    )
+
+
+def test_rust_parser_iteration_limit_is_reported_not_raised() -> None:
+    """Exceeding the limit yields a PRS violation, not an exception."""
+    # BaseException rather than Exception: a PanicException is not an Exception,
+    # so `except Exception` here would pass while the defect was live.
+    try:
+        linted = _linter(_TIGHT_LIMIT).lint_string(_SQL)
+    except BaseException as err:  # pragma: no cover - the defect being pinned
+        pytest.fail(f"{type(err).__name__} escaped the parser: {err}")
+
+    codes = [v.rule_code() for v in linted.violations]
+    assert "PRS" in codes
+    assert any(
+        "exceeded maximum iteration limit" in str(v) for v in linted.violations
+    )
+
+
+def test_rust_parser_iteration_limit_reports_a_position() -> None:
+    """The reported violation carries a position, like any other parse error."""
+    linted = _linter(_TIGHT_LIMIT).lint_string(_SQL)
+    prs = [v for v in linted.violations if v.rule_code() == "PRS"]
+    assert prs
+    assert prs[0].line_no >= 1
+    assert prs[0].line_pos >= 1
+
+
+def test_rust_parser_under_the_limit_still_parses() -> None:
+    """A control: the same SQL parses clean when the limit is not tripped."""
+    linted = _linter(3_000_000).lint_string(_SQL)
+    assert [v.rule_code() for v in linted.violations if v.rule_code() == "PRS"] == []
