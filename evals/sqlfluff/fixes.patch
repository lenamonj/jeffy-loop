@@ -442,3 +444,28 @@ def test__templater_styles():
     t = PlaceholderTemplater(override_context=dict(param_style="pperccent"))
     with pytest.raises(ValueError, match=r"Unknown param_style"):
         t.process(in_str="SELECT 2+2", fname="test")
+
+
+@pytest.mark.parametrize(
+    "context,expected",
+    [
+        ({}, "No param_regex nor param_style was provided"),
+        ({"param_style": "not_a_style"}, 'Unknown param_style "not_a_style"'),
+        (
+            {"param_style": "colon", "param_regex": "__(?P<param_name>[\\w_]+)__"},
+            "Either param_style or param_regex must be provided, not both",
+        ),
+    ],
+)
+def test__templater_config_errors_are_user_errors(context, expected):
+    """A misconfigured placeholder templater is a user error, not a traceback.
+
+    All three of these are mistakes in a config file the project owner wrote,
+    so they must reach the CLI as ``SQLFluffUserError`` - which the CLI prints
+    as a single ``User Error:`` line - rather than as a bare ``ValueError``
+    escaping to a Python traceback. ``SQLFluffUserError`` subclasses
+    ``ValueError``, so callers catching the broader type still do.
+    """
+    templater = PlaceholderTemplater(override_context=dict(context))
+    with pytest.raises(SQLFluffUserError, match=regex.escape(expected)):
+        templater.process(in_str="SELECT 2+2", fname="test")
