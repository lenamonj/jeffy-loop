+
+Both cases below used to make LT01 emit a fix the linter then refused with
+``Fixes for LT01 not applied, as it would result in an unparsable file``: the
+file parsed clean, LT01 reported a fixable violation, and ``sqlfluff fix``
+changed nothing. The violations were spurious - the spacing was already
+correct - so the fix is that LT01 no longer reports them.
+"""
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+
+CASES = [
+    # A Flink property name: the dots and the hyphen are part of the name.
+    ("flink", "SET execution.runtime-mode = streaming;\n"),
+    ("flink", "SET execution.checkpointing.mode = EXACTLY_ONCE;\n"),
+    # A SOQL LAST_N_* literal: LAST_N_WEEKS:5 is one token to the reader.
+    ("soql", "SELECT Id FROM Account WHERE CreatedDate = LAST_N_WEEKS:5\n"),
+]
+
+
+def _linter(dialect: str) -> Linter:
+    return Linter(config=FluffConfig(overrides={"dialect": dialect, "rules": "LT01"}))
+
+
+@pytest.mark.parametrize("dialect,sql", CASES)
+def test_lt01_leaves_dialect_names_alone(dialect: str, sql: str) -> None:
+    """LT01 reports nothing, so there is no refused fix."""
+    assert _linter(dialect).lint_string(sql).check_tuples() == []
+
+
+@pytest.mark.parametrize("dialect,sql", CASES)
+def test_fix_is_a_noop_and_output_still_parses(dialect: str, sql: str) -> None:
+    """`fix` leaves the text alone and the result still parses clean."""
+    linter = _linter(dialect)
+    fixed, _ = linter.lint_string(sql, fix=True).fix_string()
+    assert fixed == sql
+    parsed = linter.parse_string(fixed)
+    assert not list(parsed.tree.recursive_crawl("unparsable"))
+
+
+def test_flink_property_name_keeps_its_parts_together() -> None:
+    """The hyphen is a dash inside the name, not a binary operator."""
+    linter = Linter(config=FluffConfig(overrides={"dialect": "flink"}))
+    tree = linter.parse_string("SET execution.runtime-mode = streaming;\n").tree
+    types = [seg.get_type() for seg in tree.raw_segments if seg.raw.strip()]
+    assert "dash" in types
+    assert "binary_operator" not in types
