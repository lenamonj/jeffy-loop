+@pytest.mark.parametrize(
+    "instr,expected_error",
+    [
+        # Arithmetic that raises. ZeroDivisionError is not a TemplateError, a
+        # TypeError or a ValueError, so before this was handled it escaped the
+        # templater and crashed the CLI with a traceback.
+        ("SELECT {{ 1/0 }} FROM t\n", "ZeroDivisionError"),
+        # The same, with the denominator arriving from the template rather than
+        # written as a literal zero.
+        ("SELECT {% set n = 0 %}{{ 10 / n }} FROM t\n", "ZeroDivisionError"),
+        # An unbounded recursive macro. RecursionError derives from
+        # RuntimeError and escaped the same way.
+        (
+            "SELECT {% macro m() %}{{ m() }}{% endmacro %}{{ m() }} FROM t\n",
+            "RecursionError",
+        ),
+    ],
+)
+def test__templater_jinja_error_runtime_failures_are_templater_errors(
+    instr, expected_error
+):
+    """Any exception raised while rendering is reported, never a traceback.
+
+    Rendering runs the template's own code, so it can raise anything. Whatever
+    it raises must reach the user as a TMP violation naming the failure.
+    """
+    lntr = Linter(
+        config=FluffConfig(
+            overrides={"dialect": "ansi", "templater": "jinja"},
+        )
+    )
+    result = lntr.lint_string(instr)
+    violations = [v for v in result.violations if v.rule_code() == "TMP"]
+    assert violations, f"No TMP violation raised for {instr!r}"
+    assert expected_error in violations[0].description
+
