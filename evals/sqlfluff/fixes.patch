 # ---------------------------
 
 
+# Keyed on the dialect name and the two raws that would meet if the whitespace
+# between them were removed. The answer depends on nothing else, and this runs
+# at every reflow point, so it is worth caching. Capped so that a long session
+# over many files cannot grow it without bound.
+_TOUCH_JOIN_CACHE_LIMIT = 4096
+_touch_join_safety: dict[tuple[str, str, str], bool] = {}
+
+
+def _touch_join_is_safe(
+    prev_block: Optional["ReflowBlock"],
+    next_block: Optional["ReflowBlock"],
+    dialect: Optional["Dialect"],
+) -> bool:
+    """Can the whitespace between these two blocks be removed safely?
+
+    A `touch` constraint removes whitespace, which concatenates the raw text on
+    either side of it. Where the two raws then lex as something other than
+    themselves the result no longer means what the user wrote: `--` and `##`
+    open comments, and `->`, `~~` and `||` are operators in several dialects.
+    Re-parsing the segment tree cannot catch this, because the tree still holds
+    two separate raws either side of the deleted whitespace - the change only
+    exists once the file is written out and lexed again. So ask the dialect's
+    lexer whether the joined text still lexes as those same two raws.
+
+    This is a check on the join itself, not on the whole file: it does not
+    detect a join whose consequence needs later text to appear (`/` and `*` lex
+    as two tokens, and only a `*/` further down the file would turn them into a
+    block comment).
+    """
+    if dialect is None:
+        # No dialect available - reflow is being driven from a bare config,
+        # which happens in unit tests. Keep the historical behaviour.
+        return True
+    prev_raw = prev_block.segments[-1].raw if prev_block else ""
+    next_raw = next_block.segments[0].raw if next_block else ""
+    if not prev_raw or not next_raw:
+        return True
+    key = (dialect.name, prev_raw, next_raw)
+    safe = _touch_join_safety.get(key)
+    if safe is None:
+        # Imported here: the lexer pulls in parser machinery that would
+        # otherwise make this module part of an import cycle.
+        from sqlfluff.core.parser.lexer import PyLexer
+
+        res = PyLexer.lex_match(prev_raw + next_raw, dialect.get_lexer_matchers())
+        safe = not res.forward_string and [elem.raw for elem in res.elements] == [
+            prev_raw,
+            next_raw,
+        ]
+        if len(_touch_join_safety) >= _TOUCH_JOIN_CACHE_LIMIT:
+            _touch_join_safety.clear()
+        _touch_join_safety[key] = safe
+    return safe
+
+
