+
+// The parent link and the trailing-slash fixup are built from the same decoded path
+// as the entries, so a directory whose own name carries a URI-significant character
+// breaks both. The parent of a top-level directory is the root, whatever the
+// directory is called.
+func TestFSDirIndexDirectoryNameWithSpecials(t *testing.T) {
+	t.Parallel()
+
+	for _, dir := range []string{"plain", "q?dir", "h#dir", "p%41dir", "sp ace"} {
+		t.Run(dir, func(t *testing.T) {
+			t.Parallel()
+
+			m := fstest.MapFS{dir + "/inner.txt": &fstest.MapFile{Data: []byte("inner")}}
+			h := (&FS{FS: m, GenerateIndexPages: true}).NewRequestHandler()
+
+			reqPath := "/" + url.PathEscape(dir) + "/"
+			status, entries, body := dirIndexEntries(t, h, reqPath)
+			if status != StatusOK {
+				t.Fatalf("GET %q: status=%d, want 200; body=%q", reqPath, status, body)
+			}
