diff --git a/accept_encoding_test.go b/accept_encoding_test.go
new file mode 100644
index 0000000..7d639a5
--- /dev/null
+++ b/accept_encoding_test.go
@@ -0,0 +1,151 @@
+package fasthttp
+
+import (
+	"strings"
+	"testing"
+)
+
+// Content codings are case-insensitive per RFC 7231 section 3.1.2.1, and the
+// field value is a list of whole codings rather than a string to search: gzip
+// inside x-gzip is not an offer of gzip, and a coding whose qvalue is zero is a
+// refusal rather than an offer.
+func TestHasAcceptEncodingCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		ae     string
+		coding string
+		want   bool
+		note   string
+	}{
+		// The filed defect: every coding in any casing.
+		{"gzip", "gzip", true, "canonical"},
+		{"GZIP", "gzip", true, "upper"},
+		{"Gzip", "gzip", true, "title"},
+		{"gZiP", "gzip", true, "alternating"},
+		{"DEFLATE", "deflate", true, "upper deflate"},
+		{"Br", "br", true, "title br"},
+		{"ZSTD", "zstd", true, "upper zstd"},
+		{"GZIP, DEFLATE, BR, ZSTD", "br", true, "upper list"},
+
+		// Whole-token matching. The first of these is the second defect found
+		// while fixing the first: gzip is genuinely offered but sits after a
+		// coding that contains it, and the old substring search missed it.
+		{"x-gzip, gzip", "gzip", true, "listed after a coding that contains it"},
+		{"x-gzip", "gzip", false, "only as part of another coding"},
+		{"gzip-ng", "gzip", false, "only as a prefix of another coding"},
+		{"gzip, deflate, sdhc", "gzi", false, "partial token, prefix"},
+		{"gzip, deflate, sdhc", "zip", false, "partial token, suffix"},
+		{"gzip, deflate, sdhc", "flate", false, "partial token, inner"},
+		{"gzip, deflate, sdhc", "deflate", true, "whole token, middle"},
+		{"gzip, deflate, sdhc", "sdhc", true, "whole token, last"},
+
+		// Optional whitespace around codings.
+		{"gzip,deflate", "deflate", true, "no space after comma"},
+		{"  gzip  ,  deflate  ", "gzip", true, "padded with spaces"},
+		{"\tgzip\t,\tdeflate", "gzip", true, "padded with tabs"},
+		{"gzip , deflate", "deflate", true, "space before comma"},
+
+		// Qvalues. Zero is a refusal; anything else is an offer.
+		{"gzip;q=0", "gzip", false, "explicitly refused"},
+		{"gzip;q=0.0", "gzip", false, "refused, one decimal"},
+		{"gzip;q=0.000", "gzip", false, "refused, three decimals"},
+		{"gzip;Q=0", "gzip", false, "refused, upper case parameter"},
+		{"gzip; q=0", "gzip", false, "refused, space before parameter"},
+		{"gzip;q=1", "gzip", true, "offered with a qvalue"},
+		{"gzip;q=1.0", "gzip", true, "offered, one decimal"},
+		{"gzip;q=0.5", "gzip", true, "offered at half weight"},
+		{"gzip;q=0.001", "gzip", true, "offered at the smallest non-zero weight"},
+		{"deflate;q=0, gzip", "gzip", true, "refusal of another coding does not refuse this one"},
+		{"deflate, gzip;q=0", "deflate", true, "sibling refusal leaves this one offered"},
+		{"deflate, gzip;q=0", "gzip", false, "refused at the end of the list"},
+
+		// Absent or empty.
+		{"", "gzip", false, "no header"},
+		{"gzip", "sdhc", false, "coding not offered"},
+		{"identity", "gzip", false, "only identity offered"},
+
+		// The wildcard is documented as not matching an unlisted coding.
+		{"*", "gzip", false, "wildcard is not treated as a match"},
+	}
+
+	for _, c := range cases {
+		t.Run(c.note, func(t *testing.T) {
+			var h RequestHeader
+			if c.ae != "" {
+				h.Set(HeaderAcceptEncoding, c.ae)
+			}
+			if got := h.HasAcceptEncoding(c.coding); got != c.want {
+				t.Errorf("Accept-Encoding %q, coding %q: got %v, want %v", c.ae, c.coding, got, c.want)
+			}
+			if got := h.HasAcceptEncodingBytes([]byte(c.coding)); got != c.want {
+				t.Errorf("bytes form: Accept-Encoding %q, coding %q: got %v, want %v", c.ae, c.coding, got, c.want)
+			}
+		})
+	}
+}
+
+// An empty coding must never match, whatever the header holds, so a caller that
+// passes a zero-length value does not get every response compressed.
+func TestHasAcceptEncodingEmptyCoding(t *testing.T) {
+	t.Parallel()
+
+	for _, ae := range []string{"", "gzip", "gzip, deflate", "*"} {
+		var h RequestHeader
+		h.Set(HeaderAcceptEncoding, ae)
+		if h.HasAcceptEncoding("") {
+			t.Errorf("Accept-Encoding %q matched an empty coding", ae)
+		}
+	}
+}
+
+// The server must actually compress for an upper-case offer, which is what the
+// finding was about: the accessor is only interesting through CompressHandler.
+func TestHasAcceptEncodingDrivesCompressHandler(t *testing.T) {
+	t.Parallel()
+
+	body := strings.Repeat("compress me. ", 200)
+	h := CompressHandler(func(ctx *RequestCtx) {
+		ctx.Response.Header.SetContentType("text/plain")
+		ctx.SetBodyString(body)
+	})
+
+	for _, tc := range []struct {
+		ae       string
+		wantCE   string
+		wantBody string
+	}{
+		{"gzip", "gzip", body},
+		{"GZIP", "gzip", body},
+		{"Gzip", "gzip", body},
+		{"x-gzip, gzip", "gzip", body},
+		{"DEFLATE", "deflate", body},
+		{"gzip;q=0", "", body},
+		{"", "", body},
+	} {
+		t.Run(tc.ae, func(t *testing.T) {
+			var ctx RequestCtx
+			ctx.Request.Header.SetMethod(MethodGet)
+			ctx.Request.SetRequestURI("/")
+			if tc.ae != "" {
+				ctx.Request.Header.Set(HeaderAcceptEncoding, tc.ae)
+			}
+			h(&ctx)
+
+			ce := string(ctx.Response.Header.ContentEncoding())
+			if ce != tc.wantCE {
+				t.Fatalf("Accept-Encoding %q: Content-Encoding=%q, want %q", tc.ae, ce, tc.wantCE)
+			}
+			got, err := ctx.Response.BodyUncompressed()
+			if err != nil {
+				t.Fatalf("Accept-Encoding %q: BodyUncompressed: %v", tc.ae, err)
+			}
+			if string(got) != tc.wantBody {
+				t.Errorf("Accept-Encoding %q: decoded %d bytes, want %d", tc.ae, len(got), len(tc.wantBody))
+			}
+			if tc.wantCE != "" && len(ctx.Response.Body()) >= len(body) {
+				t.Errorf("Accept-Encoding %q: body was not actually compressed (%d bytes)", tc.ae, len(ctx.Response.Body()))
+			}
+		})
+	}
+}
