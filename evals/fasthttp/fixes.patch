+
+// Media types and their parameter names are case-insensitive, RFC 7231 section
+// 3.1.1.1, so every spelling below must yield the same boundary. The boundary
+// value itself is a parameter value and stays byte-exact.
+func TestMultipartFormBoundaryCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	accepted := []struct{ ct, want, note string }{
+		{"multipart/form-data; boundary=foobar", "foobar", "canonical"},
+		{"multipart/form-data;boundary=foobar", "foobar", "no space"},
+		{"multipart/form-data; charset=utf-8; boundary=foobar", "foobar", "leading parameter"},
+		{"multipart/form-data; boundary=\"foobar\"", "foobar", "quoted"},
+		{"Multipart/Form-Data; boundary=foobar", "foobar", "mixed case type"},
+		{"multipart/form-data; BOUNDARY=foobar", "foobar", "upper case parameter name"},
+		{"MULTIPART/FORM-DATA; BOUNDARY=foobar", "foobar", "all upper"},
+		{"mUlTiPaRt/FoRm-DaTa; BoUnDaRy=foobar", "foobar", "alternating case"},
+		// The parameter value keeps its own case.
+		{"MULTIPART/FORM-DATA; BOUNDARY=FooBar", "FooBar", "value case preserved"},
+	}
+	for _, c := range accepted {
+		var req Request
+		req.Header.SetMethod(MethodPost)
+		req.Header.SetContentType(c.ct)
+		if got := string(req.Header.MultipartFormBoundary()); got != c.want {
+			t.Errorf("%s: MultipartFormBoundary(%q)=%q, want %q", c.note, c.ct, got, c.want)
+		}
+	}
+
+	// Folding must not reach past ASCII letters. Each of these differs from
+	// "multipart/form-data" or from "boundary" in a non-letter position, so a
+	// comparison that merely ORs in 0x20 must still reject them.
+	rejected := []struct{ ct, note string }{
+		{"multipart-form-data; boundary=foobar", "slash replaced by hyphen"},
+		{"multipart/form_data; boundary=foobar", "hyphen replaced by underscore"},
+		{"multipart/form-datax; boundary=foobar", "subtype has a trailing byte"},
+		{"text/plain; boundary=foobar", "different media type"},
+		{"multipart/form-data; boundar=foobar", "parameter name truncated"},
+		{"multipart/form-data; xboundary=foobar", "parameter name prefixed"},
+	}
+	for _, c := range rejected {
+		var req Request
+		req.Header.SetMethod(MethodPost)
+		req.Header.SetContentType(c.ct)
+		if got := req.Header.MultipartFormBoundary(); len(got) != 0 {
+			t.Errorf("%s: MultipartFormBoundary(%q)=%q, want empty", c.note, c.ct, got)
+		}
+	}
+}
+
+// The same spellings driven end to end, so the field is actually readable
+// rather than only the boundary being extracted.
+func TestMultipartFormBoundaryCaseInsensitiveEndToEnd(t *testing.T) {
+	t.Parallel()
+
+	body := "--foobar\r\nContent-Disposition: form-data; name=\"k\"\r\n\r\nv\r\n--foobar--\r\n"
+	for _, ct := range []string{
+		"multipart/form-data; boundary=foobar",
+		"Multipart/Form-Data; boundary=foobar",
+		"multipart/form-data; BOUNDARY=foobar",
+		"MULTIPART/FORM-DATA; BOUNDARY=foobar",
+		"mUlTiPaRt/FoRm-DaTa; BoUnDaRy=foobar",
+	} {
+		t.Run(ct, func(t *testing.T) {
+			raw := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\nContent-Type: %s\r\nContent-Length: %d\r\n\r\n%s",
+				ct, len(body), body)
+			var req Request
+			if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+				t.Fatalf("read: %v", err)
+			}
+			defer req.RemoveMultipartFormFiles()
+			f, err := req.MultipartForm()
+			if err != nil {
+				t.Fatalf("MultipartForm with Content-Type %q: %v", ct, err)
+			}
+			if got := f.Value["k"]; len(got) != 1 || got[0] != "v" {
+				t.Errorf("field k=%v, want [v]", got)
+			}
+		})
+	}
+}
+
+// application/x-www-form-urlencoded is a media type too, so PostArgs must find
+// the form whatever case the sender used.
+func TestPostArgsContentTypeCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	for _, ct := range []string{
+		"application/x-www-form-urlencoded",
+		"Application/X-WWW-Form-Urlencoded",
+		"APPLICATION/X-WWW-FORM-URLENCODED",
+		"application/x-www-form-urlencoded; charset=utf-8",
+	} {
+		t.Run(ct, func(t *testing.T) {
+			body := "k=v&n=2"
+			raw := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\nContent-Type: %s\r\nContent-Length: %d\r\n\r\n%s",
+				ct, len(body), body)
+			var req Request
+			if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+				t.Fatalf("read: %v", err)
+			}
+			if got := string(req.PostArgs().Peek("k")); got != "v" {
+				t.Errorf("PostArgs k=%q with Content-Type %q, want v", got, ct)
+			}
+			if got := string(req.PostArgs().Peek("n")); got != "2" {
+				t.Errorf("PostArgs n=%q, want 2", got)
+			}
+		})
+	}
+
+	// A different media type must still not be parsed as form args.
+	body := "k=v"
+	raw := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\nContent-Type: text/plain\r\nContent-Length: %d\r\n\r\n%s",
+		len(body), body)
+	var req Request
+	if err := req.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if got := req.PostArgs().Peek("k"); len(got) != 0 {
+		t.Errorf("text/plain body parsed as form args: k=%q", got)
+	}
+}
+
+// Content codings are case-insensitive, RFC 7231 section 3.1.2.1.
+func TestContentEncodingCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	payload := strings.Repeat("decompress me. ", 40)
+	codings := []struct {
+		name   string
+		encode func([]byte) []byte
+	}{
+		{"gzip", func(b []byte) []byte { return AppendGzipBytes(nil, b) }},
+		{"deflate", func(b []byte) []byte { return AppendDeflateBytes(nil, b) }},
+		{"br", func(b []byte) []byte { return AppendBrotliBytes(nil, b) }},
+		{"zstd", func(b []byte) []byte { return AppendZstdBytes(nil, b) }},
+	}
+	for _, c := range codings {
+		enc := c.encode([]byte(payload))
+		for _, spelling := range []string{c.name, strings.ToUpper(c.name), strings.Title(c.name)} { //nolint:staticcheck
+			t.Run(spelling, func(t *testing.T) {
+				var resp Response
+				resp.Header.SetContentEncoding(spelling)
+				resp.SetBodyRaw(enc)
+				got, err := resp.BodyUncompressed()
+				if err != nil {
+					t.Fatalf("Response.BodyUncompressed with Content-Encoding %q: %v", spelling, err)
+				}
+				if string(got) != payload {
+					t.Errorf("Response.BodyUncompressed returned %d bytes, want %d", len(got), len(payload))
+				}
+
+				var req Request
+				req.Header.SetContentEncoding(spelling)
+				req.SetBodyRaw(enc)
+				got, err = req.BodyUncompressed()
+				if err != nil {
+					t.Fatalf("Request.BodyUncompressed with Content-Encoding %q: %v", spelling, err)
+				}
+				if string(got) != payload {
+					t.Errorf("Request.BodyUncompressed returned %d bytes, want %d", len(got), len(payload))
+				}
+			})
+		}
+	}
+
+	// An unknown coding is still refused.
+	var resp Response
+	resp.Header.SetContentEncoding("exotic")
+	resp.SetBodyRaw([]byte("x"))
+	if _, err := resp.BodyUncompressed(); !errors.Is(err, ErrContentEncodingUnsupported) {
+		t.Errorf("unknown coding err=%v, want ErrContentEncodingUnsupported", err)
+	}
+}
+
+// A gzipped multipart request body must be gunzipped whatever case the sender
+// spelled the coding in; this is the pre-parse-skipping path in
+// MultipartFormWithLimit rather than the BodyUncompressed one above.
+func TestMultipartGzipContentEncodingCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	form := "--foobar\r\nContent-Disposition: form-data; name=\"k\"\r\n\r\nv\r\n--foobar--\r\n"
+	gz := AppendGzipBytes(nil, []byte(form))
+
+	for _, spelling := range []string{"gzip", "GZIP", "Gzip"} {
+		t.Run(spelling, func(t *testing.T) {
+			var req Request
+			req.Header.SetMultipartFormBoundary("foobar")
+			req.Header.SetContentEncoding(spelling)
+			req.SetBodyRaw(gz)
+			defer req.RemoveMultipartFormFiles()
+			f, err := req.MultipartForm()
+			if err != nil {
+				t.Fatalf("MultipartForm with Content-Encoding %q: %v", spelling, err)
+			}
+			if got := f.Value["k"]; len(got) != 1 || got[0] != "v" {
+				t.Errorf("field k=%v, want [v]", got)
+			}
+		})
+	}
+}
+
+// Range units are case-insensitive, RFC 7233 section 2.
+func TestParseByteRangeUnitCaseInsensitive(t *testing.T) {
+	t.Parallel()
+
+	for _, unit := range []string{"bytes", "BYTES", "Bytes", "bYtEs"} {
+		t.Run(unit, func(t *testing.T) {
+			start, end, err := ParseByteRange([]byte(unit+"=0-4"), 10)
+			if err != nil {
+				t.Fatalf("ParseByteRange(%q=0-4): %v", unit, err)
+			}
+			if start != 0 || end != 4 {
+				t.Errorf("ParseByteRange(%q=0-4)=(%d,%d), want (0,4)", unit, start, end)
+			}
+		})
+	}
+
+	// A different unit is still refused, and so is a near-miss that differs in a
+	// non-letter position.
+	for _, bad := range []string{"items=0-4", "byte=0-4", "bytesx=0-4", "byteS_=0-4"} {
+		if _, _, err := ParseByteRange([]byte(bad), 10); err == nil {
+			t.Errorf("ParseByteRange(%q) accepted, want an error", bad)
+		}
+	}
+}
diff --git a/multipart_limit_test.go b/multipart_limit_test.go
new file mode 100644
index 0000000..02bf832
--- /dev/null
+++ b/multipart_limit_test.go
@@ -0,0 +1,252 @@
+package fasthttp
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/valyala/fasthttp/fasthttputil"
+)
+
+func newMultipartBody(boundary string, fieldSize int) string {
+	return "--" + boundary + "\r\n" +
+		"Content-Disposition: form-data; name=\"f\"; filename=\"f.bin\"\r\n" +
+		"Content-Type: application/octet-stream\r\n\r\n" +
+		strings.Repeat("A", fieldSize) + "\r\n--" + boundary + "--\r\n"
+}
+
+// A multipart body over maxBodySize must not be pre-parsed before the handler
+// runs: pre-parsing buffers and spills the whole declared length, which is what
+// StreamRequestBody exists to avoid. Within the limit it must still be
+// pre-parsed, so the limit genuinely changes the outcome at both values.
+func TestMultipartLimitStreamingSkipsOverLimitPreParse(t *testing.T) {
+	t.Parallel()
+
+	const maxBody = 4096
+
+	for _, tc := range []struct {
+		name           string
+		fieldSize      int
+		wantPreParsed  bool
+		wantBodyStream bool
+	}{
+		{"within the limit is pre-parsed", 64, true, false},
+		{"over the limit is streamed", 64 * 1024, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := newMultipartBody("mplim", tc.fieldSize)
+
+			type observed struct {
+				preParsed  bool
+				bodyStream bool
+				drained    int64
+			}
+			seen := make(chan observed, 1)
+
+			ln := fasthttputil.NewInmemoryListener()
+			s := &Server{
+				StreamRequestBody:  true,
+				MaxRequestBodySize: maxBody,
+				Handler: func(ctx *RequestCtx) {
+					// Recorded before touching the body, since reading it would populate
+					// the form and destroy the distinction being measured.
+					o := observed{
+						preParsed:  ctx.Request.multipartForm != nil,
+						bodyStream: ctx.Request.IsBodyStream(),
+					}
+					if o.bodyStream {
+						// A streamed body must still be fully readable by the handler:
+						// skipping the pre-parse must not cost any bytes.
+						n, err := io.Copy(io.Discard, ctx.RequestBodyStream())
+						if err != nil {
+							t.Errorf("draining the streamed body: %v", err)
+						}
+						o.drained = n
+					}
+					seen <- o
+					ctx.SetBodyString("ok")
+				},
+			}
+			serveDone := make(chan error, 1)
+			go func() { serveDone <- s.Serve(ln) }()
+			defer func() {
+				_ = ln.Close()
+				<-serveDone
+			}()
+
+			c, err := ln.Dial()
+			if err != nil {
+				t.Fatalf("dial: %v", err)
+			}
+			defer c.Close() //nolint:errcheck
+			_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+			req := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\n"+
+				"Content-Type: multipart/form-data; boundary=mplim\r\nContent-Length: %d\r\n\r\n%s",
+				len(body), body)
+			if _, err := c.Write([]byte(req)); err != nil {
+				t.Fatalf("write: %v", err)
+			}
+
+			var got observed
+			select {
+			case got = <-seen:
+			case <-time.After(10 * time.Second):
+				t.Fatal("handler was not reached")
+			}
+			if got.preParsed != tc.wantPreParsed {
+				t.Errorf("body of %d bytes against MaxRequestBodySize %d: pre-parsed=%v, want %v",
+					len(body), maxBody, got.preParsed, tc.wantPreParsed)
+			}
+			if got.bodyStream != tc.wantBodyStream {
+				t.Errorf("body of %d bytes against MaxRequestBodySize %d: body stream=%v, want %v",
+					len(body), maxBody, got.bodyStream, tc.wantBodyStream)
+			}
+			if tc.wantBodyStream && got.drained != int64(len(body)) {
+				t.Errorf("streamed body delivered %d bytes to the handler, want %d",
+					got.drained, len(body))
+			}
+		})
+	}
+}
+
+// Without StreamRequestBody the same over-limit body must still be refused
+// outright, so the streaming change did not weaken the default path.
+func TestMultipartLimitNonStreamingRefusesOverLimit(t *testing.T) {
+	t.Parallel()
+
+	body := newMultipartBody("mplim", 64*1024)
+	var reached int32
+
+	ln := fasthttputil.NewInmemoryListener()
+	s := &Server{
+		MaxRequestBodySize: 4096,
+		Handler: func(ctx *RequestCtx) {
+			atomic.AddInt32(&reached, 1)
+			ctx.SetBodyString("ok")
+		},
+	}
+	serveDone := make(chan error, 1)
+	go func() { serveDone <- s.Serve(ln) }()
+	defer func() {
+		_ = ln.Close()
+		<-serveDone
+	}()
+
+	c, err := ln.Dial()
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	defer c.Close() //nolint:errcheck
+	_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+	req := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\n"+
+		"Content-Type: multipart/form-data; boundary=mplim\r\nContent-Length: %d\r\n\r\n%s",
+		len(body), body)
+	if _, err := c.Write([]byte(req)); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	var resp Response
+	if err := resp.Read(bufio.NewReader(c)); err != nil {
+		t.Fatalf("read response: %v", err)
+	}
+	if resp.StatusCode() == StatusOK {
+		t.Errorf("over-limit body accepted with 200, want a refusal")
+	}
+	if n := atomic.LoadInt32(&reached); n != 0 {
+		t.Errorf("handler ran %d times for an over-limit body, want 0", n)
+	}
+}
+
+// MultipartFormWithLimit's documented limit must bind on the server path, where
+// the form has already been pre-parsed while reading the request. This is the
+// method FormValue and FormFile recommend for untrusted multipart input, so a
+// limit that only applies to a fresh parse protects nothing.
+func TestMultipartLimitAppliesToPreParsedForm(t *testing.T) {
+	t.Parallel()
+
+	body := newMultipartBody("mplim", 8*1024)
+	bodyLen := len(body)
+
+	for _, tc := range []struct {
+		name    string
+		limit   int
+		wantErr bool
+	}{
+		{"no limit", 0, false},
+		{"limit above the body", bodyLen + 1, false},
+		{"limit at the body size", bodyLen, false},
+		{"limit one below the body size", bodyLen - 1, true},
+		{"limit far below the body size", 1, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			type observed struct {
+				preParsed bool
+				err       error
+				values    int
+			}
+			seen := make(chan observed, 1)
+
+			ln := fasthttputil.NewInmemoryListener()
+			s := &Server{
+				MaxRequestBodySize: 1 << 20, // large, so the server itself pre-parses
+				Handler: func(ctx *RequestCtx) {
+					pre := ctx.Request.multipartForm != nil
+					f, err := ctx.MultipartFormWithLimit(tc.limit)
+					n := 0
+					if f != nil {
+						n = len(f.File) + len(f.Value)
+					}
+					seen <- observed{preParsed: pre, err: err, values: n}
+					ctx.SetBodyString("ok")
+				},
+			}
+			serveDone := make(chan error, 1)
+			go func() { serveDone <- s.Serve(ln) }()
+			defer func() {
+				_ = ln.Close()
+				<-serveDone
+			}()
+
+			c, err := ln.Dial()
+			if err != nil {
+				t.Fatalf("dial: %v", err)
+			}
+			defer c.Close() //nolint:errcheck
+			_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+			req := fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\n"+
+				"Content-Type: multipart/form-data; boundary=mplim\r\nContent-Length: %d\r\n\r\n%s",
+				bodyLen, body)
+			if _, err := c.Write([]byte(req)); err != nil {
+				t.Fatalf("write: %v", err)
+			}
+
+			var got observed
+			select {
+			case got = <-seen:
+			case <-time.After(10 * time.Second):
+				t.Fatal("handler was not reached")
+			}
+			if !got.preParsed {
+				t.Fatalf("the form was not pre-parsed, so this case does not exercise the defect")
+			}
+			if tc.wantErr {
+				if !errors.Is(got.err, ErrBodyTooLarge) {
+					t.Errorf("MultipartFormWithLimit(%d) on a %d byte body: err=%v, want ErrBodyTooLarge",
+						tc.limit, bodyLen, got.err)
+				}
+			} else {
+				if got.err != nil {
+					t.Errorf("MultipartFormWithLimit(%d) on a %d byte body: err=%v, want nil",
+						tc.limit, bodyLen, got.err)
+				}
+				if got.values != 1 {
+					t.Errorf("MultipartFormWithLimit(%d): form holds %d entries, want 1", tc.limit, got.values)
+				}
+			}
+		})
+	}
+}
diff --git a/pprofhandler/pprof.go b/pprofhandler/pprof.go
index 397f522..e85144c 100644
--- a/pprofhandler/pprof.go
+++ b/pprofhandler/pprof.go
@@ -23,12 +23,17 @@ var (
 	profilePath = []byte("/debug/pprof/profile")
 	symbolPath  = []byte("/debug/pprof/symbol")
 	tracePath   = []byte("/debug/pprof/trace")
+	indexPath   = []byte("/debug/pprof/")
+	// The slashless form redirects to indexPath: the index's relative links
+	// resolve against the directory of the page URL, so serving the index at
+	// /debug/pprof would point every link at /debug/<name> instead of
+	// /debug/pprof/<name>. net/http's mux redirects it for the same reason.
+	indexPathSlashless = []byte("/debug/pprof")
 )
 
 // matchPprofPath checks whether path exactly matches a pprof endpoint.
-// It only accepts the exact path (e.g. /debug/pprof/heap) and rejects
-// paths with a trailing slash, matching the behaviour of net/http/pprof
-// which returns 404 for paths ending in /.
+// It accepts only the exact path, e.g. /debug/pprof/heap, so a trailing slash
+// or trailing garbage never reaches a profile handler.
 func matchPprofPath(path, endpoint []byte) bool {
 	return bytes.Equal(path, endpoint)
 }
@@ -37,15 +42,34 @@ func matchPprofPath(path, endpoint []byte) bool {
 //
 // See https://pkg.go.dev/net/http/pprof for details.
 //
-// Paths ending in a trailing slash (e.g. /debug/pprof/heap/) return 404,
-// matching the behaviour of net/http/pprof's DefaultServeMux which does
-// not register handlers for paths ending in /.
+// /debug/pprof/ serves the profile index; the slashless /debug/pprof redirects
+// there permanently, because the index's relative links resolve against the
+// page's directory and would otherwise point at /debug/<name> instead of
+// /debug/pprof/<name>. net/http's mux performs the same redirect. Every other
+// path ending in a slash returns 404, which is deliberately stricter than
+// net/http/pprof: that package registers /debug/pprof/ as a subtree pattern, so
+// its mux serves the index for anything underneath, including /debug/pprof/heap/
+// and names that do not exist. Matching exactly instead keeps a mistyped or
+// crafted path from reaching a profile handler it does not name.
 func PprofHandler(ctx *fasthttp.RequestCtx) {
 	path := ctx.Path()
 
-	// Reject paths ending in / — net/http/pprof returns 404 for these.
-	if len(path) > 1 && path[len(path)-1] == '/' {
-		ctx.SetStatusCode(404)
+	if bytes.Equal(path, indexPathSlashless) {
+		uri := string(indexPath)
+		if qs := ctx.URI().QueryString(); len(qs) > 0 {
+			uri += "?" + string(qs)
+		}
+		// A relative Location, like net/http's mux emits, so the redirect does
+		// not depend on the Host header the request arrived with.
+		ctx.Response.Header.Set(fasthttp.HeaderLocation, uri)
+		ctx.Response.SetStatusCode(fasthttp.StatusMovedPermanently)
+		return
+	}
+
+	// Reject paths ending in / apart from the index itself, which is the
+	// canonical entry point every pprof link uses.
+	if len(path) > 1 && path[len(path)-1] == '/' && !bytes.Equal(path, indexPath) {
+		ctx.SetStatusCode(fasthttp.StatusNotFound)
 		return
 	}
 
diff --git a/pprofhandler/pprof_index_test.go b/pprofhandler/pprof_index_test.go
new file mode 100644
index 0000000..97c4b24
--- /dev/null
+++ b/pprofhandler/pprof_index_test.go
@@ -0,0 +1,172 @@
+package pprofhandler
+
+import (
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+// TestPprofIndexLinksResolve walks the index the way a browser would, from both
+// documented entry points: follow any redirect, extract the heap link from the
+// served page, resolve it against the page's own URL, and require the resolved
+// URL to serve a heap profile. Before PPROF-2 the slashless entry point served
+// the index directly, so its relative heap link resolved to /debug/heap, which
+// this handler answers with the index again - every link looped forever.
+func TestPprofIndexLinksResolve(t *testing.T) {
+	serve := func(uri string) *fasthttp.RequestCtx {
+		var ctx fasthttp.RequestCtx
+		ctx.Request.SetRequestURI(uri)
+		PprofHandler(&ctx)
+		return &ctx
+	}
+
+	// The index template quotes hrefs with single quotes; accept both.
+	hrefRe := regexp.MustCompile(`href=['"]([^'"]+)['"]`)
+
+	for _, entry := range []string{"/debug/pprof", "/debug/pprof/"} {
+		t.Run(entry, func(t *testing.T) {
+			pageURL, err := url.Parse("http://example.com" + entry)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			// Follow redirects the way a browser would, bounded so a redirect
+			// loop fails rather than hangs.
+			ctx := serve(pageURL.RequestURI())
+			for hops := 0; ctx.Response.StatusCode() >= 300 && ctx.Response.StatusCode() < 400; hops++ {
+				if hops >= 3 {
+					t.Fatalf("more than 3 redirects from %q", entry)
+				}
+				loc, err := url.Parse(string(ctx.Response.Header.Peek("Location")))
+				if err != nil {
+					t.Fatal(err)
+				}
+				pageURL = pageURL.ResolveReference(loc)
+				ctx = serve(pageURL.RequestURI())
+			}
+			if got := ctx.Response.StatusCode(); got != fasthttp.StatusOK {
+				t.Fatalf("entry %q: final status=%d, want 200", entry, got)
+			}
+
+			// Extract the heap link from the page actually served.
+			var heapHref string
+			for _, m := range hrefRe.FindAllStringSubmatch(string(ctx.Response.Body()), -1) {
+				href, err := url.Parse(m[1])
+				if err != nil {
+					continue
+				}
+				if href.Path == "heap" || strings.HasSuffix(href.Path, "/heap") {
+					heapHref = m[1]
+					break
+				}
+			}
+			if heapHref == "" {
+				t.Fatalf("entry %q: no heap link on the served page", entry)
+			}
+
+			// Resolve it against the page URL the way a browser would and
+			// require the result to serve a heap profile, not the index again.
+			ref, err := url.Parse(heapHref)
+			if err != nil {
+				t.Fatal(err)
+			}
+			heapURL := pageURL.ResolveReference(ref)
+			heapCtx := serve(heapURL.RequestURI())
+			if got := heapCtx.Response.StatusCode(); got != fasthttp.StatusOK {
+				t.Fatalf("entry %q: heap link %q resolved to %q, status=%d, want 200", entry, heapHref, heapURL, got)
+			}
+			body := string(heapCtx.Response.Body())
+			if !strings.Contains(body, "heap profile:") {
+				snippet := body
+				if len(snippet) > 120 {
+					snippet = snippet[:120]
+				}
+				t.Fatalf("entry %q: heap link %q resolved to %q, which does not serve a heap profile: %q", entry, heapHref, heapURL, snippet)
+			}
+		})
+	}
+}
+
+// /debug/pprof/ is the canonical index URL: it is what net/http/pprof registers
+// (net/http/pprof/pprof.go registers the trailing-slash form with
+// http.HandleFunc) and what every pprof link points at. Rejecting it because it
+// ends in a slash made the documented entry point unreachable.
+func TestPprofHandlerIndexServesTrailingSlash(t *testing.T) {
+	serve := func(path string) *fasthttp.RequestCtx {
+		var ctx fasthttp.RequestCtx
+		ctx.Request.SetRequestURI(path)
+		PprofHandler(&ctx)
+		return &ctx
+	}
+
+	t.Run("index /debug/pprof/", func(t *testing.T) {
+		ctx := serve("/debug/pprof/")
+		if got := ctx.Response.StatusCode(); got != fasthttp.StatusOK {
+			t.Fatalf("status=%d, want 200", got)
+		}
+		body := string(ctx.Response.Body())
+		for _, name := range []string{"heap", "goroutine", "allocs", "threadcreate"} {
+			if !strings.Contains(body, name) {
+				t.Errorf("index does not name the %q profile", name)
+			}
+		}
+	})
+
+	// The slashless form redirects to the canonical index instead of serving
+	// it: the index's relative links resolve against the page's directory, so
+	// a page served at /debug/pprof would point every link at /debug/<name>.
+	// This changed with PPROF-2; the entry point stays reachable, one hop away.
+	t.Run("redirect /debug/pprof", func(t *testing.T) {
+		ctx := serve("/debug/pprof")
+		if got := ctx.Response.StatusCode(); got != fasthttp.StatusMovedPermanently {
+			t.Fatalf("status=%d, want 301", got)
+		}
+		if got := string(ctx.Response.Header.Peek("Location")); got != "/debug/pprof/" {
+			t.Fatalf("Location=%q, want /debug/pprof/", got)
+		}
+	})
+
+	// Every other trailing-slash path still returns 404, which is what keeps the
+	// exact-match property that bba7659 added against prefix matching.
+	for _, path := range []string{
+		"/debug/pprof/cmdline/",
+		"/debug/pprof/symbol/",
+		"/debug/pprof/profile/",
+		"/debug/pprof/trace/",
+		"/debug/pprof/heap/",
+		"/debug/pprof/goroutine/",
+		"/debug/pprof/heap//",
+		// ctx.Path() collapses the doubled slash to /debug/pprof/, so this one
+		// reaches net/http's Index, which then refuses it as an unknown profile
+		// because the unnormalized request URI is what it inspects. Still 404,
+		// just with a message rather than an empty body.
+		"/debug/pprof//",
+	} {
+		t.Run("rejected "+path, func(t *testing.T) {
+			ctx := serve(path)
+			if got := ctx.Response.StatusCode(); got != fasthttp.StatusNotFound {
+				t.Errorf("path %q: status=%d, want 404", path, got)
+			}
+			// Whatever the body says, a refused path must not serve profile data.
+			body := string(ctx.Response.Body())
+			for _, leak := range []string{"goroutine profile:", "heap profile:", "# runtime.MemStats"} {
+				if strings.Contains(body, leak) {
+					t.Errorf("path %q: 404 body carried profile data: %q", path, leak)
+				}
+			}
+		})
+	}
+
+	// The exact endpoints are unaffected.
+	for _, path := range []string{"/debug/pprof/cmdline", "/debug/pprof/symbol", "/debug/pprof/heap"} {
+		t.Run("exact "+path, func(t *testing.T) {
+			ctx := serve(path)
+			if got := ctx.Response.StatusCode(); got != fasthttp.StatusOK {
+				t.Errorf("path %q: status=%d, want 200", path, got)
+			}
+		})
+	}
+}
