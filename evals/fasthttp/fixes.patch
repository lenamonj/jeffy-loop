+
+		var h ResponseHeader
+		if got := h.PeekAll(HeaderSetCookie); len(got) != 0 {
+			t.Errorf("PeekAll on a cookieless response = %q, want empty", got)
+		}
+		if got := h.Peek(HeaderSetCookie); len(got) != 0 {
+			t.Errorf("Peek on a cookieless response = %q, want empty", got)
+		}
+	})
+
+	// Three cookies, so an off-by-one in the loop cannot pass.
+	t.Run("three cookies round trip through a parsed response", func(t *testing.T) {
+		t.Parallel()
+
+		raw := "HTTP/1.1 200 OK\r\n" +
+			"Content-Length: 0\r\n" +
+			"Set-Cookie: a=1; path=/x\r\n" +
+			"Set-Cookie: b=2; HttpOnly\r\n" +
+			"Set-Cookie: c=3\r\n" +
+			"\r\n"
+
+		var h ResponseHeader
+		if err := h.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+			t.Fatalf("parsing the response: %v", err)
+		}
+
+		wire := setCookieLines(t, &h)
+		var all []string
+		for _, v := range h.PeekAll(HeaderSetCookie) {
+			all = append(all, string(v))
+		}
+		if len(all) != 3 {
+			t.Errorf("PeekAll returned %d element(s) %q, want 3", len(all), all)
+		}
+		if !slices.Equal(all, wire) {
+			t.Errorf("PeekAll returned %q, want the wire's own lines %q", all, wire)
+		}
+	})
+}
