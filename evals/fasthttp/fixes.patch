new file mode 100644
index 0000000..787834b
--- /dev/null
+++ b/trailer_forbidden_test.go
@@ -0,0 +1,141 @@
+package fasthttp
+
+import (
+	"bufio"
+	"errors"
+	"strings"
+	"testing"
+)
+
+// The response control data of RFC 7231 section 7.1 and the conditionals of
+// section 5.2, both named forbidden in trailers by RFC 7230 section 4.1.2 and by
+// the SetTrailer doc comment. Location was already blocked before this set was
+// completed; it stays here so the whole category is covered by one list.
+var forbiddenTrailerCategories = []struct {
+	header string
+	why    string
+}{
+	{HeaderAge, "response control data, RFC 7231 7.1"},
+	{HeaderCacheControl, "response control data, and a cache poisoning vector"},
+	{HeaderExpires, "response control data, RFC 7231 7.1"},
+	{HeaderDate, "response control data, corrupts cache freshness arithmetic"},
+	{HeaderLocation, "response control data, redirect control"},
+	{HeaderRetryAfter, "response control data, RFC 7231 7.1"},
+	{HeaderVary, "response control data, a cache key input"},
+	{HeaderWarning, "response control data, RFC 7231 7.1"},
+	{HeaderPragma, "the HTTP/1.0 cache directive"},
+	{HeaderIfMatch, "conditional, RFC 7231 5.2"},
+	{HeaderIfNoneMatch, "conditional, RFC 7231 5.2"},
+	{HeaderIfModifiedSince, "conditional, RFC 7231 5.2"},
+	{HeaderIfUnmodifiedSince, "conditional, RFC 7231 5.2"},
+	{HeaderIfRange, "conditional, RFC 7231 5.2"},
+}
+
+// Every member of the categories the SetTrailer doc comment declares forbidden
+// must be rejected by name, in any casing, on both header types.
+func TestTrailerForbiddenCategoriesRejected(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range forbiddenTrailerCategories {
+		for _, form := range []string{tc.header, strings.ToLower(tc.header), strings.ToUpper(tc.header)} {
+			t.Run(form, func(t *testing.T) {
+				var req RequestHeader
+				if err := req.AddTrailer(form); !errors.Is(err, ErrBadTrailer) {
+					t.Errorf("RequestHeader.AddTrailer(%q) err=%v, want ErrBadTrailer (%s)", form, err, tc.why)
+				}
+				if got := string(req.Peek(HeaderTrailer)); got != "" {
+					t.Errorf("RequestHeader stored trailer %q for %q, want none", got, form)
+				}
+
+				var resp ResponseHeader
+				resp.noDefaultDate = true
+				if err := resp.AddTrailer(form); !errors.Is(err, ErrBadTrailer) {
+					t.Errorf("ResponseHeader.AddTrailer(%q) err=%v, want ErrBadTrailer (%s)", form, err, tc.why)
+				}
+				if got := string(resp.Peek(HeaderTrailer)); got != "" {
+					t.Errorf("ResponseHeader stored trailer %q for %q, want none", got, form)
+				}
+			})
+		}
+	}
+}
+
+// A chunked response carrying one of those fields in its trailer section must be
+// refused, not merged into the parsed header set. Before the fix these values
+// were readable through Peek on the response header, which is header injection
+// past the point where the headers were validated.
+func TestTrailerForbiddenCategoriesRefusedOnTheWire(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range forbiddenTrailerCategories {
+		t.Run(tc.header, func(t *testing.T) {
+			raw := "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" +
+				"5\r\nhello\r\n0\r\n" + tc.header + ": injected\r\n\r\n"
+			var resp Response
+			err := resp.Read(bufio.NewReader(strings.NewReader(raw)))
+			if err == nil {
+				t.Errorf("trailer %q accepted (%s); Peek(%q)=%q, header set now %q",
+					tc.header, tc.why, tc.header, resp.Header.Peek(tc.header), resp.Header.String())
+			}
+		})
+	}
+}
+
+// The same on the request side: a client sending one of these in a chunked
+// request body's trailer section must not have it merged into the request
+// headers a handler then reads.
+func TestTrailerForbiddenCategoriesRefusedOnRequests(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range forbiddenTrailerCategories {
+		t.Run(tc.header, func(t *testing.T) {
+			raw := "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n" +
+				"5\r\nhello\r\n0\r\n" + tc.header + ": injected\r\n\r\n"
+			var req Request
+			err := req.Read(bufio.NewReader(strings.NewReader(raw)))
+			if err == nil {
+				t.Errorf("trailer %q accepted (%s); Peek(%q)=%q",
+					tc.header, tc.why, tc.header, req.Header.Peek(tc.header))
+			}
+		})
+	}
+}
+
+// The blocklist must not grow into ordinary trailer names. These are the fields
+// a trailer legitimately carries, plus the request modifiers the doc comment
+// explicitly does not reject, and every one must still be accepted and stored.
+func TestTrailerAllowedNamesStillAccepted(t *testing.T) {
+	t.Parallel()
+
+	allowed := []string{
+		"X-Sum", "Foo", "X-Custom-Safe", "My-App-Trailer", "Debug-Info",
+		"Grpc-Status", "Grpc-Message", "Server-Timing", "X-Checksum-Sha256",
+		HeaderAccept, HeaderAcceptLanguage, HeaderUserAgent, HeaderReferer,
+		HeaderETag, HeaderLastModified, HeaderContentDisposition,
+		// The stored name is compared case-insensitively above, because the header key
+		// normalizer rewrites ETag to Etag and that is its documented behaviour.
+		// Names that merely share a first byte or a prefix with a blocked one.
+		"If", "Ifx", "Date-Received", "Age-Of-Data", "Var", "Warn", "Praise",
+		"Retry", "Cache", "Expire", "Vary-On",
+	}
+	for _, name := range allowed {
+		t.Run(name, func(t *testing.T) {
+			var req RequestHeader
+			if err := req.AddTrailer(name); err != nil {
+				t.Errorf("RequestHeader.AddTrailer(%q) err=%v, want nil", name, err)
+			}
+			if got := string(req.Peek(HeaderTrailer)); !strings.EqualFold(got, name) {
+				t.Errorf("RequestHeader trailer=%q, want %q", got, name)
+			}
+
+			var resp ResponseHeader
+			resp.noDefaultDate = true
+			if err := resp.AddTrailer(name); err != nil {
+				t.Errorf("ResponseHeader.AddTrailer(%q) err=%v, want nil", name, err)
+			}
+			if got := string(resp.Peek(HeaderTrailer)); !strings.EqualFold(got, name) {
+				t.Errorf("ResponseHeader trailer=%q, want %q", got, name)
+			}
+		})
+	}
+}
