diff --git a/fasthttpadaptor/request_proto_test.go b/fasthttpadaptor/request_proto_test.go
new file mode 100644
index 0000000..ab86da6
--- /dev/null
+++ b/fasthttpadaptor/request_proto_test.go
@@ -0,0 +1,121 @@
+package fasthttpadaptor
+
+import (
+	"bufio"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/valyala/fasthttp"
+)
+
+// ConvertRequest used to set ProtoMinor to 1 for every request, so the protocol it
+// reported contradicted itself for anything but HTTP/1.1: an HTTP/1.0 request arrived
+// as Proto "HTTP/1.0" with ProtoMinor 1, and ProtoAtLeast(1, 1) answered true. net/http
+// handlers branch on exactly that to decide whether chunked encoding and keep-alive are
+// available, so the wrapped handler framed responses for a version the client never
+// sent.
+func TestConvertRequestProtoVersion(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name string
+		// raw is parsed off the wire when set; otherwise setProto is applied directly,
+		// which is the only way to reach "HTTP/2" since a request line must spell a
+		// minor version.
+		raw         string
+		setProto    string
+		wantProto   string
+		wantMajor   int
+		wantMinor   int
+		wantAtLeast bool // ProtoAtLeast(1, 1)
+	}{
+		{
+			name:        "HTTP/1.1",
+			raw:         "GET / HTTP/1.1\r\nHost: h\r\n\r\n",
+			wantProto:   "HTTP/1.1",
+			wantMajor:   1,
+			wantMinor:   1,
+			wantAtLeast: true,
+		},
+		{
+			name:        "HTTP/1.0",
+			raw:         "GET / HTTP/1.0\r\nHost: h\r\n\r\n",
+			wantProto:   "HTTP/1.0",
+			wantMajor:   1,
+			wantMinor:   0,
+			wantAtLeast: false,
+		},
+		{
+			name:        "HTTP/2 without a minor version",
+			raw:         "GET / HTTP/1.1\r\nHost: h\r\n\r\n",
+			setProto:    "HTTP/2",
+			wantProto:   "HTTP/2",
+			wantMajor:   2,
+			wantMinor:   0,
+			wantAtLeast: true,
+		},
+		{
+			name:        "HTTP/2.0 spelled out",
+			raw:         "GET / HTTP/1.1\r\nHost: h\r\n\r\n",
+			setProto:    "HTTP/2.0",
+			wantProto:   "HTTP/2.0",
+			wantMajor:   2,
+			wantMinor:   0,
+			wantAtLeast: true,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			var ctx fasthttp.RequestCtx
+			var req fasthttp.Request
+			if err := req.Read(bufio.NewReader(strings.NewReader(tc.raw))); err != nil {
+				t.Fatalf("parsing the request: %v", err)
+			}
+			if tc.setProto != "" {
+				req.Header.SetProtocol(tc.setProto)
+			}
+			ctx.Init(&req, nil, nil)
+
+			var r http.Request
+			if err := ConvertRequest(&ctx, &r, true); err != nil {
+				t.Fatalf("ConvertRequest: %v", err)
+			}
+
+			if r.Proto != tc.wantProto {
+				t.Errorf("Proto = %q, want %q", r.Proto, tc.wantProto)
+			}
+			if r.ProtoMajor != tc.wantMajor {
+				t.Errorf("ProtoMajor = %d, want %d", r.ProtoMajor, tc.wantMajor)
+			}
+			if r.ProtoMinor != tc.wantMinor {
+				t.Errorf("ProtoMinor = %d, want %d (Proto is %q)", r.ProtoMinor, tc.wantMinor, r.Proto)
+			}
+			if got := r.ProtoAtLeast(1, 1); got != tc.wantAtLeast {
+				t.Errorf("ProtoAtLeast(1, 1) = %v, want %v for %s", got, tc.wantAtLeast, tc.wantProto)
+			}
+		})
+	}
+
+	// An unset protocol falls back to HTTP/1.1, which is what fasthttp's own
+	// Header.Protocol reports, so the adaptor must not invent a different version.
+	t.Run("unset protocol", func(t *testing.T) {
+		t.Parallel()
+
+		var ctx fasthttp.RequestCtx
+		var req fasthttp.Request
+		req.SetRequestURI("http://h/p")
+		ctx.Init(&req, nil, nil)
+
+		var r http.Request
+		if err := ConvertRequest(&ctx, &r, true); err != nil {
+			t.Fatalf("ConvertRequest: %v", err)
+		}
+		if r.Proto != "HTTP/1.1" || r.ProtoMajor != 1 || r.ProtoMinor != 1 {
+			t.Errorf("unset protocol gave %q %d.%d, want HTTP/1.1 1.1", r.Proto, r.ProtoMajor, r.ProtoMinor)
+		}
+	})
+}
