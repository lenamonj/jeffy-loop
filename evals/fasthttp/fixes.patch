+		c1.SetKey("sid")
+		c1.SetValue("abc")
+		c1.SetPath("/admin")
+		c1.SetHTTPOnly(true)
+		c1.SetSecure(true)
+		h.SetCookie(c1)
+
+		c2 := AcquireCookie()
+		defer ReleaseCookie(c2)
+		c2.SetKey("theme")
+		c2.SetValue("dark")
+		h.SetCookie(c2)
+
+		wire := setCookieLines(t, &h)
+		if len(wire) != 2 {
+			t.Fatalf("the serialized header holds %d Set-Cookie lines %q, want 2", len(wire), wire)
+		}
+
+		var all []string
+		for _, v := range h.PeekAll(HeaderSetCookie) {
+			all = append(all, string(v))
+		}
+		if len(all) != 2 {
+			t.Errorf("PeekAll returned %d element(s) %q, want one per cookie", len(all), all)
+		}
+		if !slices.Equal(all, wire) {
+			t.Errorf("PeekAll returned %q, want the wire's own lines %q", all, wire)
+		}
+		for _, v := range all {
+			if strings.Count(v, "=") > 0 && strings.Contains(v, "theme=dark") && strings.Contains(v, "sid=") {
+				t.Errorf("PeekAll element %q carries two cookies, so the second reads as an attribute of the first", v)
+			}
+		}
+
+		if got := string(h.Peek(HeaderSetCookie)); got != wire[0] {
+			t.Errorf("Peek returned %q, want the first Set-Cookie line %q", got, wire[0])
+		}
+	})
