-// normalizes compression level into [0..7], so it could be used as an index
-// in *PoolMap.
+// normalizes compression level into [CompressZstdBestSpeed..CompressZstdBestCompression],
+// so it is both a level zstd.NewWriter accepts and an index into *PoolMap.
+//
+// CompressZstdSpeedNotSet is normalized away rather than passed through: it
+// mirrors the upstream speedNotSet, which zstd.NewWriter rejects, and
+// acquireRealZstdWriter turns that rejection into a panic from a stackless
+// worker goroutine that no recover can reach.
 func normalizeZstdCompressLevel(level int) int {
-	if level < CompressZstdSpeedNotSet || level > CompressZstdBestCompression {
+	if level < CompressZstdBestSpeed || level > CompressZstdBestCompression {
 		level = CompressZstdDefault
 	}
 	return level
 }
+
+// zstdLevelFromFlate maps a flate compression level onto zstd's scale.
+//
+// CompressHandlerLevel and CompressHandlerBrotliLevel document their level as
+// one of the flate constants and hand that same value to zstd when a client asks
+// for zstd, but the two scales share no meaning: every flate level above
+// CompressZstdBestCompression falls outside zstd's range and would be replaced
+// by the default, and CompressNoCompression is zstd's unusable speedNotSet.
+// zstd has no uncompressed mode, so the flate levels that ask for the least work
+// map onto its fastest setting.
+func zstdLevelFromFlate(level int) int {
+	switch {
+	case level <= CompressBestSpeed:
+		return CompressZstdBestSpeed
+	case level >= CompressBestCompression:
+		return CompressZstdBestCompression
+	default:
+		return CompressZstdDefault
+	}
+}
diff --git a/zstd_test.go b/zstd_test.go
index dc0c45f..aa7bcff 100644
--- a/zstd_test.go
+++ b/zstd_test.go
@@ -1,12 +1,113 @@
 package fasthttp
 
 import (
+	"bufio"
 	"bytes"
 	"fmt"
 	"io"
 	"testing"
 )
 
+// createCompressibleBody returns a body whose compressed size actually varies
+// with the compression level. createFixedBody's repeating digits do not: every
+// level compresses them to the same handful of bytes, so a level that never
+// reaches the encoder looks identical to one that does.
+func createCompressibleBody(words int) []byte {
+	vocab := []string{
+		"alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta",
+		"handler", "request", "response", "buffer", "header", "connection", "stream", "pool",
+	}
+
+	var b []byte
+	x := 1
+	for range words {
+		x = x * 48271 % 2147483647
+		b = append(b, vocab[x%len(vocab)]...)
+		b = append(b, ' ')
+	}
+
+	return b
+}
+
+// CompressHandlerLevel documents its level on the flate scale and hands that
+// same value to zstd when the client asks for zstd. zstd's scale is a different
+// one whose zero value is not a usable encoder level, so every documented level
+// has to arrive at the encoder as something zstd accepts: CompressNoCompression
+// used to panic the process from a stackless worker goroutine, where the
+// server's per-connection recover cannot reach it, and CompressBestCompression
+// used to be replaced silently by the default.
+func TestCompressHandlerLevelZstd(t *testing.T) {
+	t.Parallel()
+
+	expectedBody := createCompressibleBody(4000)
+	sizes := make(map[int]int)
+
+	for _, level := range []int{
+		CompressNoCompression,
+		CompressBestSpeed,
+		CompressDefaultCompression,
+		CompressBestCompression,
+		CompressHuffmanOnly,
+	} {
+		h := CompressHandlerLevel(func(ctx *RequestCtx) {
+			ctx.Write(expectedBody) //nolint:errcheck
+		}, level)
+
+		var ctx RequestCtx
+		ctx.Request.Header.Set(HeaderAcceptEncoding, "zstd")
+		h(&ctx)
+
+		var resp Response
+		br := bufio.NewReader(bytes.NewBufferString(ctx.Response.String()))
+		if err := resp.Read(br); err != nil {
+			t.Fatalf("level %d: unexpected error: %v", level, err)
+		}
+		if ce := resp.Header.ContentEncoding(); string(ce) != "zstd" {
+			t.Fatalf("level %d: unexpected Content-Encoding: %q. Expecting %q", level, ce, "zstd")
+		}
+		body, err := resp.BodyUnzstd()
+		if err != nil {
+			t.Fatalf("level %d: unexpected error: %v", level, err)
+		}
+		if !bytes.Equal(body, expectedBody) {
+			t.Fatalf("level %d: unexpected body of %d bytes. Expecting %d", level, len(body), len(expectedBody))
+		}
+		sizes[level] = len(resp.Body())
+	}
+
+	// A level that is discarded on the way to the encoder leaves every response
+	// the same size, so the two ends of the scale have to differ.
+	if sizes[CompressBestSpeed] <= sizes[CompressBestCompression] {
+		t.Fatalf("zstd body is %d bytes at CompressBestSpeed and %d at CompressBestCompression; "+
+			"the level is not reaching the encoder", sizes[CompressBestSpeed], sizes[CompressBestCompression])
+	}
+}
+
+// Every int has to be a usable zstd level by the time it reaches zstd.NewWriter,
+// whose rejection acquireRealZstdWriter turns into a panic. CompressZstdSpeedNotSet
+// mirrors the upstream speedNotSet, which is exactly such a rejected value.
+func TestAppendZstdBytesLevelAcceptsEveryLevel(t *testing.T) {
+	t.Parallel()
+
+	expectedBody := createCompressibleBody(500)
+	for _, level := range []int{
+		CompressZstdSpeedNotSet,
+		CompressZstdBestSpeed,
+		CompressZstdDefault,
+		CompressZstdSpeedBetter,
+		CompressZstdBestCompression,
+		-100, -1, 5, 9, 1000,
+	} {
+		body, err := AppendUnzstdBytes(nil, AppendZstdBytesLevel(nil, expectedBody, level))
+		if err != nil {
+			t.Fatalf("level %d: unexpected error: %v", level, err)
+		}
+		if !bytes.Equal(body, expectedBody) {
+			t.Fatalf("level %d: unexpected body of %d bytes. Expecting %d", level, len(body), len(expectedBody))
+		}
+	}
+}
