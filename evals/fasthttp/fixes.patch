new file mode 100644
index 0000000..3c32933
--- /dev/null
+++ b/header_peekall_absent_test.go
@@ -0,0 +1,168 @@
+package fasthttp
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+)
+
+// PeekAll's special-cased keys used to append their value without testing its
+// length, so an absent Content-Length, Trailer or request Cookie came back as a
+// one-element slice holding "" - a value no header ever carried, and one that
+// makes the natural presence test len(PeekAll(k)) > 0 answer true for a header
+// that is not there. Every other branch of both switches already guarded, and so
+// does every arm of All(), which is the reference this pins against together
+// with the serialized bytes.
+//
+// The populated side is asserted in the same table so that a fix which simply
+// stops appending cannot pass.
+
+func peekAllStrings(bs [][]byte) []string {
+	out := make([]string, 0, len(bs))
+	for _, b := range bs {
+		out = append(out, string(b))
+	}
+	return out
+}
+
+// quoted renders with %q so a one-element slice holding "" is distinguishable
+// from an empty slice; fmt.Sprint prints both as "[]".
+func quoted(v []string) string { return fmt.Sprintf("%q", v) }
+
+func wireValues(t *testing.T, wireTo func(io.Writer) (int64, error), key string) []string {
+	t.Helper()
+	var buf bytes.Buffer
+	if _, err := wireTo(&buf); err != nil {
+		t.Fatalf("WriteTo: %v", err)
+	}
+	out := []string{}
+	for i, line := range strings.Split(buf.String(), "\r\n") {
+		if i == 0 || line == "" {
+			continue
+		}
+		name, value, found := strings.Cut(line, ":")
+		if found && name == key {
+			out = append(out, strings.TrimLeft(value, " "))
+		}
+	}
+	return out
+}
+
+func TestPeekAllAbsentSpecialHeaders(t *testing.T) {
+	t.Parallel()
+
+	t.Run("response", func(t *testing.T) {
+		t.Parallel()
+		keys := []string{HeaderContentLength, HeaderTrailer}
+
+		// Absent: PeekAll must be empty, and must agree with All() and the wire.
+		h := &ResponseHeader{}
+		h.SetStatusCode(200)
+		for _, k := range keys {
+			if got := peekAllStrings(h.PeekAll(k)); len(got) != 0 {
+				t.Errorf("PeekAll(%q) on a header carrying none = %s, want an empty slice", k, quoted(got))
+			}
+			if got, want := quoted(peekAllStrings(h.PeekAll(k))), quoted(wireValues(t, h.WriteTo, k)); got != want {
+				t.Errorf("PeekAll(%q) = %s, serialized bytes carry %s", k, got, want)
+			}
+		}
+		fromAll := map[string][]string{}
+		for k, v := range h.All() {
+			fromAll[string(k)] = append(fromAll[string(k)], string(v))
+		}
+		for _, k := range keys {
+			want := fromAll[k]
+			if want == nil {
+				want = []string{}
+			}
+			if got := quoted(peekAllStrings(h.PeekAll(k))); got != quoted(want) {
+				t.Errorf("PeekAll(%q) = %s, All() yields %s", k, got, quoted(want))
+			}
+		}
+
+		// Present: the same keys must still be reported, so a fix cannot pass by
+		// never appending at all.
+		h.SetContentLength(7)
+		h.SetTrailer("X-A, X-B")
+		for _, k := range keys {
+			got := peekAllStrings(h.PeekAll(k))
+			want := wireValues(t, h.WriteTo, k)
+			if len(got) == 0 {
+				t.Errorf("PeekAll(%q) = %s once set, want the value", k, quoted(got))
+			}
+			if quoted(got) != quoted(want) {
+				t.Errorf("PeekAll(%q) = %s, serialized bytes carry %s", k, quoted(got), quoted(want))
+			}
+		}
+	})
+
+	t.Run("request", func(t *testing.T) {
+		t.Parallel()
+		keys := []string{HeaderContentLength, HeaderCookie, HeaderTrailer}
+
+		h := &RequestHeader{}
+		h.SetMethod(MethodGet)
+		h.SetRequestURI("/x")
+		h.SetHost("example.com")
+		// Drive the cookie collection path, which is the branch that decides
+		// whether peekAll reads the parsed cookies or the raw header.
+		h.Cookie("nosuch")
+		for _, k := range keys {
+			if got := peekAllStrings(h.PeekAll(k)); len(got) != 0 {
+				t.Errorf("PeekAll(%q) on a header carrying none = %s, want an empty slice", k, quoted(got))
+			}
+			if got, want := quoted(peekAllStrings(h.PeekAll(k))), quoted(wireValues(t, h.WriteTo, k)); got != want {
+				t.Errorf("PeekAll(%q) = %s, serialized bytes carry %s", k, got, want)
+			}
+		}
+		fromAll := map[string][]string{}
+		for k, v := range h.All() {
+			fromAll[string(k)] = append(fromAll[string(k)], string(v))
+		}
+		for _, k := range keys {
+			want := fromAll[k]
+			if want == nil {
+				want = []string{}
+			}
+			if got := quoted(peekAllStrings(h.PeekAll(k))); got != quoted(want) {
+				t.Errorf("PeekAll(%q) = %s, All() yields %s", k, got, quoted(want))
+			}
+		}
+
+		h.SetContentLength(7)
+		h.SetCookie("c", "1")
+		h.SetTrailer("X-A")
+		h.Cookie("c")
+		for _, k := range keys {
+			got := peekAllStrings(h.PeekAll(k))
+			want := wireValues(t, h.WriteTo, k)
+			if len(got) == 0 {
+				t.Errorf("PeekAll(%q) = %s once set, want the value", k, quoted(got))
+			}
+			if quoted(got) != quoted(want) {
+				t.Errorf("PeekAll(%q) = %s, serialized bytes carry %s", k, quoted(got), quoted(want))
+			}
+		}
+	})
+
+	// A parsed request whose cookies are collected but whose Cookie header is
+	// empty: the collection is non-nil and zero-length, which is the shape the
+	// unguarded append turned into [""].
+	t.Run("parsed-empty-cookie-header", func(t *testing.T) {
+		t.Parallel()
+		raw := "GET /x HTTP/1.1\r\nHost: h\r\nCookie: \r\n\r\n"
+		h := &RequestHeader{}
+		if err := h.Read(bufio.NewReader(strings.NewReader(raw))); err != nil {
+			t.Fatalf("Read: %v", err)
+		}
+		h.Cookie("nosuch")
+		got := peekAllStrings(h.PeekAll(HeaderCookie))
+		want := wireValues(t, h.WriteTo, HeaderCookie)
+		if quoted(got) != quoted(want) {
+			t.Errorf("PeekAll(Cookie) = %s, serialized bytes carry %s", quoted(got), quoted(want))
+		}
+	})
+}
