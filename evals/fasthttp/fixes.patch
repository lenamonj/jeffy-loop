diff --git a/client_maxconnduration_test.go b/client_maxconnduration_test.go
new file mode 100644
index 0000000..8cd9773
--- /dev/null
+++ b/client_maxconnduration_test.go
@@ -0,0 +1,206 @@
+package fasthttp
+
+import (
+	"net"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/valyala/fasthttp/fasthttputil"
+)
+
+// countingListener records how many connections were accepted, which is the only way
+// to tell a reused connection from a fresh one from outside the client.
+type countingListener struct {
+	net.Listener
+	count atomic.Int32
+}
+
+func (l *countingListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err == nil {
+		l.count.Add(1)
+	}
+	return c, err
+}
+
+// MaxConnDuration does not discard an aged connection before using it. It sends one
+// final request over it with Connection: close added, then closes it client-side
+// regardless of the server's answer, so the next request needs a new connection.
+// TestHostClientMaxConnDuration already asserts that some request carries the close
+// token; this pins which one, and pins the connection count, so neither the timing of
+// the retirement nor the reuse of the fresh connection can drift unnoticed.
+func TestHostClientMaxConnDurationRetiresConnection(t *testing.T) {
+	t.Parallel()
+
+	const maxConnDuration = 50 * time.Millisecond
+
+	cases := []struct {
+		name       string
+		duration   time.Duration
+		sleep      time.Duration
+		wantConns  int32
+		wantTokens string
+	}{
+		{
+			name:       "unlimited keeps one connection",
+			duration:   0,
+			sleep:      2 * maxConnDuration,
+			wantConns:  1,
+			wantTokens: "/1=false /2=false /3=false",
+		},
+		{
+			name:       "expired connection carries one final request then retires",
+			duration:   maxConnDuration,
+			sleep:      2 * maxConnDuration,
+			wantConns:  2,
+			wantTokens: "/1=false /2=true /3=false",
+		},
+		{
+			name:       "no sleep leaves the connection inside its duration",
+			duration:   time.Hour,
+			sleep:      0,
+			wantConns:  1,
+			wantTokens: "/1=false /2=false /3=false",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			var mu sync.Mutex
+			var tokens []string
+
+			ln := &countingListener{Listener: fasthttputil.NewInmemoryListener()}
+			s := &Server{Handler: func(ctx *RequestCtx) {
+				mu.Lock()
+				tokens = append(tokens, string(ctx.Path())+"="+boolToString(ctx.Request.ConnectionClose()))
+				mu.Unlock()
+				ctx.SetBodyString("ok")
+			}}
+			serverStopCh := make(chan struct{})
+			go func() {
+				_ = s.Serve(ln)
+				close(serverStopCh)
+			}()
+
+			c := &HostClient{
+				Addr:            "maxconnduration.local",
+				Dial:            func(string) (net.Conn, error) { return ln.Listener.(*fasthttputil.InmemoryListener).Dial() },
+				MaxConnDuration: tc.duration,
+			}
+
+			for _, path := range []string{"/1", "/2", "/3"} {
+				statusCode, body, err := c.Get(nil, "http://maxconnduration.local"+path)
+				if err != nil {
+					t.Fatalf("GET %s: %v", path, err)
+				}
+				if statusCode != StatusOK || string(body) != "ok" {
+					t.Fatalf("GET %s: status=%d body=%q", path, statusCode, body)
+				}
+				if path == "/1" {
+					time.Sleep(tc.sleep)
+				}
+			}
+
+			conns := ln.count.Load()
+			mu.Lock()
+			got := strings.Join(tokens, " ")
+			mu.Unlock()
+
+			if err := ln.Close(); err != nil {
+				t.Fatalf("closing the listener: %v", err)
+			}
+			select {
+			case <-serverStopCh:
+			case <-time.After(time.Second):
+				t.Fatal("timeout waiting for the server to stop")
+			}
+
+			if got != tc.wantTokens {
+				t.Errorf("Connection: close tokens are %q, want %q", got, tc.wantTokens)
+			}
+			if conns != tc.wantConns {
+				t.Errorf("the client opened %d connections, want %d", conns, tc.wantConns)
+			}
+		})
+	}
+}
+
+// The retirement must be the client's own decision, not a favour from the peer. A
+// server that ignores the Connection: close it was sent and answers keep-alive must
+// still not get its connection reused, or MaxConnDuration would be unenforceable
+// against exactly the upstreams a client does not control.
+func TestHostClientMaxConnDurationIgnoresUncooperativeServer(t *testing.T) {
+	t.Parallel()
+
+	ln := &countingListener{Listener: fasthttputil.NewInmemoryListener()}
+	inmem := ln.Listener.(*fasthttputil.InmemoryListener)
+
+	var sawCloseToken atomic.Int32
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func(conn net.Conn) {
+				defer conn.Close()
+				buf := make([]byte, 4096)
+				for {
+					n, err := conn.Read(buf)
+					if n > 0 && strings.Contains(strings.ToLower(string(buf[:n])), "connection: close") {
+						sawCloseToken.Add(1)
+					}
+					if err != nil {
+						return
+					}
+					// Deliberately keep-alive: no Connection: close, whatever was asked.
+					if _, err := conn.Write([]byte("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")); err != nil {
+						return
+					}
+				}
+			}(conn)
+		}
+	}()
+
+	c := &HostClient{
+		Addr:            "uncooperative.local",
+		Dial:            func(string) (net.Conn, error) { return inmem.Dial() },
+		MaxConnDuration: 50 * time.Millisecond,
+	}
+
+	for _, path := range []string{"/1", "/2", "/3"} {
+		statusCode, body, err := c.Get(nil, "http://uncooperative.local"+path)
+		if err != nil {
+			t.Fatalf("GET %s: %v", path, err)
+		}
+		if statusCode != StatusOK || string(body) != "ok" {
+			t.Fatalf("GET %s: status=%d body=%q", path, statusCode, body)
+		}
+		if path == "/1" {
+			time.Sleep(100 * time.Millisecond)
+		}
+	}
+
+	conns := ln.count.Load()
+	tokens := sawCloseToken.Load()
+	_ = ln.Close()
+
+	if tokens != 1 {
+		t.Errorf("the server saw %d requests carrying Connection: close, want exactly 1", tokens)
+	}
+	if conns != 2 {
+		t.Errorf("the client opened %d connections, want 2: the aged one must be closed by the client even though the server answered keep-alive", conns)
+	}
+}
+
+func boolToString(b bool) string {
+	if b {
+		return "true"
+	}
+	return "false"
+}
