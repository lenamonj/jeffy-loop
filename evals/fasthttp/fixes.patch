@@ -0,0 +1,179 @@
+package fasthttp
+
+import (
+	"html"
+	"net/url"
+	"regexp"
+	"strings"
+	"testing"
+	"testing/fstest"
+)
+
+var dirIndexEntryRe = regexp.MustCompile(`<li><a href="([^"]*)" class="(?:dir|file)">([^<]*)</a>`)
+
+// dirIndexEntries returns the index generated for path as a display-name to href map,
+// with both sides HTML-unescaped so the assertions read against the filename itself.
+func dirIndexEntries(t *testing.T, h RequestHandler, path string) (int, map[string]string, string) {
+	t.Helper()
+
+	var ctx RequestCtx
+	var req Request
+	req.SetRequestURI(path)
+	ctx.Init(&req, nil, nil)
+	h(&ctx)
+
+	body := string(ctx.Response.Body())
+	entries := map[string]string{}
+	for _, e := range dirIndexEntryRe.FindAllStringSubmatch(body, -1) {
+		entries[html.UnescapeString(e[2])] = html.UnescapeString(e[1])
+	}
+	return ctx.Response.StatusCode(), entries, body
+}
+
+// fetch follows a generated href through the same handler.
+func dirIndexFetch(t *testing.T, h RequestHandler, href string) (int, string) {
+	t.Helper()
+
+	var ctx RequestCtx
+	var req Request
+	req.SetRequestURI(href)
+	ctx.Init(&req, nil, nil)
+	h(&ctx)
+	return ctx.Response.StatusCode(), string(ctx.Response.Body())
+}
+
+// A generated directory index has to link to the files it lists. Filenames are
+// arbitrary bytes on most filesystems and the served tree routinely holds uploaded
+// content, so a name carrying a character that means something in a URI - '?', '#',
+// '%' - must be percent-encoded into the href rather than parsed as a query, a
+// fragment or an existing escape. fstest.MapFS is used because Windows forbids most
+// of these names on disk, and no name contains a slash, which MapFS would read as a
+// nested directory rather than as one file.
+func TestFSDirIndexEncodesNames(t *testing.T) {
+	t.Parallel()
+
+	names := []string{
+		"plain.txt",
+		"with space.txt",
+		"amp&and.txt",
+		"question?mark.txt",
+		"hash#tag.txt",
+		"percent%41.txt",
+		"encoded%2fslash.txt",
+		"café.txt",
+	}
+
+	m := fstest.MapFS{}
+	for _, n := range names {
+		m[n] = &fstest.MapFile{Data: []byte("body-of-" + n)}
+	}
+	h := (&FS{FS: m, GenerateIndexPages: true}).NewRequestHandler()
+
+	status, entries, body := dirIndexEntries(t, h, "/")
+	if status != StatusOK {
+		t.Fatalf("index status=%d, want 200; body=%q", status, body)
+	}
+	if len(entries) != len(names) {
+		t.Fatalf("index lists %d entries, want %d; body=%q", len(entries), len(names), body)
+	}
+
+	for _, n := range names {
+		href, ok := entries[n]
+		if !ok {
+			t.Errorf("no entry whose display text is %q", n)
+			continue
+		}
+
+		// The href must name this file and no other.
+		decoded, err := url.PathUnescape(href)
+		if err != nil {
+			t.Errorf("name %q: href %q does not percent-decode: %v", n, href, err)
+			continue
+		}
+		if want := "/" + n; decoded != want {
+			t.Errorf("name %q: href %q decodes to %q, want %q", n, href, decoded, want)
+		}
+
+		// And following it must serve that file's own bytes.
+		st, got := dirIndexFetch(t, h, href)
+		if want := "body-of-" + n; got != want {
+			t.Errorf("following href %q for %q: status=%d body=%q, want %q", href, n, st, got, want)
+		}
+	}
+
+	if strings.Contains(body, "<script>") {
+		t.Errorf("a filename injected a literal <script> tag into the index")
+	}
+}
+
+// One URI value is reused for every entry, so a name that decodes to something
+// containing a slash used to be resolved against rather than appended to the base,
+// prefixing itself onto every href that followed it. The blast radius of one odd
+// filename must be that filename.
+func TestFSDirIndexOneNameDoesNotAffectOthers(t *testing.T) {
+	t.Parallel()
+
+	common := []string{"aaa.txt", "plain.txt", "zzz.txt"}
+
+	withoutFS := fstest.MapFS{}
+	withFS := fstest.MapFS{}
+	for _, n := range common {
+		withoutFS[n] = &fstest.MapFile{Data: []byte("body-of-" + n)}
+		withFS[n] = &fstest.MapFile{Data: []byte("body-of-" + n)}
+	}
+	// Sorts before every common name, so under the old code it poisoned all of them.
+	withFS["a%2e%2e%2fescape.txt"] = &fstest.MapFile{Data: []byte("escape")}
+
+	_, without, _ := dirIndexEntries(t, (&FS{FS: withoutFS, GenerateIndexPages: true}).NewRequestHandler(), "/")
+	_, with, withBody := dirIndexEntries(t, (&FS{FS: withFS, GenerateIndexPages: true}).NewRequestHandler(), "/")
+
+	for _, n := range common {
+		if without[n] != with[n] {
+			t.Errorf("entry %q has href %q with the odd filename present and %q without it; body=%q",
+				n, with[n], without[n], withBody)
