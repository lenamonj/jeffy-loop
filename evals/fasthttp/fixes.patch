+
+// setCookieLines returns the Set-Cookie header lines actually written to the wire,
+// which is the ground truth every accessor has to agree with.
+func setCookieLines(t *testing.T, h *ResponseHeader) []string {
+	t.Helper()
+
+	var buf bytes.Buffer
+	bw := bufio.NewWriter(&buf)
+	if _, err := h.WriteTo(bw); err != nil {
+		t.Fatalf("serializing the header: %v", err)
+	}
+	if err := bw.Flush(); err != nil {
+		t.Fatalf("flushing: %v", err)
+	}
+
+	var out []string
+	for line := range strings.SplitSeq(buf.String(), "\r\n") {
+		if after, ok := strings.CutPrefix(line, "Set-Cookie: "); ok {
+			out = append(out, after)
+		}
+	}
+	return out
+}
+
+// Peek and PeekAll answered Set-Cookie by serializing the whole cookie collection
+// into one value, so two cookies came back as "sid=...; theme=dark" - one element
+// whose content is not any header's value, and in which the second cookie reads as an
+// attribute of the first. A caller forwarding that into a Set-Cookie header, which is
+// what this accessor exists for, emits one cookie and silently drops the rest.
+// PeekAll must return one element per cookie and Peek the first of them, and both
+// must agree with the bytes on the wire.
+func TestResponseHeaderPeekSetCookie(t *testing.T) {
+	t.Parallel()
+
