+// A 1xx, 204 or 304 response carries no body, so RFC 7230 section 3.3.2 forbids
+// sending a Content-Length on one: a reader that honours a length it cannot
+// satisfy waits for bytes that never arrive. The parsed value stays readable
+// through ContentLength and Peek, because reporting what the peer sent is a
+// contract TestResponseReadWithoutBody and TestResponseHeaderReadSuccess pin;
+// only the serialised bytes hold it back.
+func TestResponseHeaderSkipsContentLengthOnBodylessStatus(t *testing.T) {
+	t.Parallel()
+
+	read := func(raw string) *ResponseHeader {
+		t.Helper()
+
+		h := &ResponseHeader{}
+		if err := h.Read(bufio.NewReader(bytes.NewBufferString(raw))); err != nil {
+			t.Fatalf("unexpected error reading %q: %v", raw, err)
+		}
+		return h
+	}
+
+	for _, statusLine := range []string{
+		"HTTP/1.1 100 Continue",
+		"HTTP/1.1 204 No Content",
+		"HTTP/1.1 304 Not Modified",
+	} {
+		h := read(statusLine + "\r\nContent-Length: 5\r\n\r\n")
+
+		if out := h.AppendBytes(nil); bytes.Contains(out, []byte(HeaderContentLength)) {
+			t.Fatalf("%q serialised a Content-Length: %q", statusLine, out)
+		}
+		if out := h.Header(); bytes.Contains(out, []byte(HeaderContentLength)) {
+			t.Fatalf("%q returned a Content-Length from Header(): %q", statusLine, out)
+		}
+
+		// The parsed value is still reported, unchanged.
+		if cl := h.ContentLength(); cl != 5 {
+			t.Fatalf("%q reports ContentLength %d. Expecting the parsed 5", statusLine, cl)
+		}
+	}
+
+	// A status that may carry a body still serialises its Content-Length.
+	ok := read("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n")
+	if cl := ok.ContentLength(); cl != 5 {
+		t.Fatalf("unexpected ContentLength %d for 200. Expecting 5", cl)
+	}
+	if out := ok.AppendBytes(nil); !bytes.Contains(out, []byte("Content-Length: 5")) {
+		t.Fatalf("200 response lost its Content-Length: %q", out)
+	}
+
+	// A 204 that fasthttp builds itself must not emit one either, even when a
+	// body was set before the status was changed.
+	var resp Response
+	resp.SetBodyString("hello")
+	resp.SetStatusCode(StatusNoContent)
+	if out := resp.Header.AppendBytes(nil); bytes.Contains(out, []byte(HeaderContentLength)) {
+		t.Fatalf("generated 204 serialised a Content-Length: %q", out)
+	}
+}
+
+// Set replaces a key, so a duplicate that arrived from the peer must not
+// survive into the serialized bytes. Asserting on the wire rather than on the
+// accessors is the point: a proxy sanitizing a header is what this protects.
+func TestHeaderSetReplacesEveryOccurrence(t *testing.T) {
+	t.Parallel()
+
+	rawReq := "GET / HTTP/1.1\r\nHost: a\r\nX-Fwd: one\r\nAuthorization: keep\r\n" +
+		"X-Fwd: two\r\nAuthorization: stale\r\nX-Keep: k\r\n\r\n"
+
+	var h RequestHeader
+	if err := h.Read(bufio.NewReader(strings.NewReader(rawReq))); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got := len(h.PeekAll("Authorization")); got != 2 {
+		t.Fatalf("expecting 2 parsed Authorization values, got %d", got)
+	}
+
+	h.Set("Authorization", "Bearer new")
+	h.Set("X-Fwd", "trusted")
+
+	s := h.String()
+	if n := strings.Count(s, "Authorization:"); n != 1 {
+		t.Fatalf("expecting 1 Authorization header in the serialized request, got %d:\n%s", n, s)
+	}
+	if n := strings.Count(s, "X-Fwd:"); n != 1 {
+		t.Fatalf("expecting 1 X-Fwd header in the serialized request, got %d:\n%s", n, s)
+	}
+	if !strings.Contains(s, "Authorization: Bearer new") || !strings.Contains(s, "X-Fwd: trusted") {
+		t.Fatalf("the surviving values are not the ones that were set:\n%s", s)
+	}
+	if !strings.Contains(s, "X-Keep: k") {
+		t.Fatalf("an unrelated header was dropped:\n%s", s)
+	}
+	if got := h.PeekAll("Authorization"); len(got) != 1 || string(got[0]) != "Bearer new" {
+		t.Fatalf("unexpected PeekAll after Set: %q", got)
+	}
+
+	var resp ResponseHeader
+	rawResp := "HTTP/1.1 200 OK\r\nX-Dup: a\r\nX-Other: o\r\nX-Dup: b\r\n\r\n"
+	if err := resp.Read(bufio.NewReader(strings.NewReader(rawResp))); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	resp.Set("X-Dup", "final")
+	rs := resp.String()
+	if n := strings.Count(rs, "X-Dup:"); n != 1 {
+		t.Fatalf("expecting 1 X-Dup header in the serialized response, got %d:\n%s", n, rs)
+	}
+	if !strings.Contains(rs, "X-Dup: final") || !strings.Contains(rs, "X-Other: o") {
+		t.Fatalf("unexpected serialized response:\n%s", rs)
+	}
+}
