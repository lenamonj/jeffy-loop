+	t.Run("a single cookie is unchanged", func(t *testing.T) {
+		t.Parallel()
+
+		var h ResponseHeader
+		c := AcquireCookie()
+		defer ReleaseCookie(c)
+		c.SetKey("foo")
+		c.SetValue("bar")
+		h.SetCookie(c)
+
+		wire := setCookieLines(t, &h)
+		if len(wire) != 1 || wire[0] != "foo=bar" {
+			t.Fatalf("wire Set-Cookie lines = %q, want [foo=bar]", wire)
+		}
+		if got := string(h.Peek(HeaderSetCookie)); got != "foo=bar" {
+			t.Errorf("Peek = %q, want foo=bar", got)
+		}
+		var all []string
+		for _, v := range h.PeekAll(HeaderSetCookie) {
+			all = append(all, string(v))
+		}
+		if len(all) != 1 || all[0] != "foo=bar" {
+			t.Errorf("PeekAll = %q, want [foo=bar]", all)
+		}
+	})
