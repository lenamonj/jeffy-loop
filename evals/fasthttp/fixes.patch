+// protoVersion reports the major and minor version named by an HTTP protocol string.
+// A request line always spells both, as in "HTTP/1.0", but SetProtocol also allows the
+// minorless "HTTP/2", so that form is accepted too. Anything unrecognized is reported
+// as HTTP/1.1, which is what this package assumed for every protocol before.
+//
+// The minor version matters: net/http handlers call ProtoAtLeast to decide whether
+// chunked encoding and keep-alive are available, so reporting 1 for an HTTP/1.0 client
+// makes the handler frame its response for a protocol the client never sent.
+func protoVersion(proto string) (major, minor int) {
+	if proto == "HTTP/2" {
+		return 2, 0
+	}
+	if len(proto) == len("HTTP/1.1") && strings.HasPrefix(proto, "HTTP/") &&
+		proto[6] == '.' &&
+		proto[5] >= '0' && proto[5] <= '9' &&
+		proto[7] >= '0' && proto[7] <= '9' {
+		return int(proto[5] - '0'), int(proto[7] - '0')
+	}
+	return 1, 1
+}
