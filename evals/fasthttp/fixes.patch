diff --git a/brotli_test.go b/brotli_test.go
index 794ab45..db57c35 100644
--- a/brotli_test.go
+++ b/brotli_test.go
@@ -175,3 +175,33 @@ func TestCompressHandlerBrotliLevel(t *testing.T) {
 		t.Fatalf("unexpected body %q. Expecting %q", body, expectedBody)
 	}
 }
+
+// CompressBrotliNoCompression is documented as compressing anyway, because
+// brotli's quality scale has no uncompressed setting and its lowest quality is
+// brotli.BestSpeed. This pins that documented behaviour, so that a change to
+// either constant's value fails here instead of leaving the doc comment wrong.
+func TestCompressBrotliNoCompressionStillCompresses(t *testing.T) {
+	t.Parallel()
+
+	expectedBody := createCompressibleBody(2000)
+
+	noCompression := AppendBrotliBytesLevel(nil, expectedBody, CompressBrotliNoCompression)
+	bestSpeed := AppendBrotliBytesLevel(nil, expectedBody, CompressBrotliBestSpeed)
+
+	if !bytes.Equal(noCompression, bestSpeed) {
+		t.Fatalf("CompressBrotliNoCompression produced %d bytes and CompressBrotliBestSpeed produced %d; "+
+			"the two constants are documented as the same level", len(noCompression), len(bestSpeed))
+	}
+	if len(noCompression) >= len(expectedBody) {
+		t.Fatalf("CompressBrotliNoCompression produced %d bytes for a %d byte body; "+
+			"it is documented as compressing", len(noCompression), len(expectedBody))
+	}
+
+	body, err := AppendUnbrotliBytes(nil, noCompression)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !bytes.Equal(body, expectedBody) {
+		t.Fatalf("unexpected body of %d bytes. Expecting %d", len(body), len(expectedBody))
+	}
+}
