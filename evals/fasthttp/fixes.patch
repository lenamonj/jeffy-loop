new file mode 100644
index 0000000..34185ff
--- /dev/null
+++ b/uri_update_test.go
@@ -0,0 +1,121 @@
+package fasthttp
+
+import (
+	"strings"
+	"testing"
+)
+
+// Update promises to replace part of the uri, never to empty it. Before this was
+// fixed, any control byte in newURI made Parse fail after it had already reset
+// the receiver, so the scheme, host and path were all discarded and Update
+// reported nothing; ctx.Redirect then emitted "Location: http:///".
+func TestURIUpdateKeepsReceiverOnBadInput(t *testing.T) {
+	t.Parallel()
+
+	const (
+		wantHost = "host.example"
+		wantPath = "/base/x"
+	)
+
+	bad := []struct{ target, note string }{
+		{"/a\r\nX: 1", "CRLF"},
+		{"/a\nb", "LF"},
+		{"/a\rb", "CR"},
+		{"/a\tb", "TAB"},
+		{"/a\x00b", "NUL"},
+		{"rel\tative", "control byte in a relative path"},
+		{"//other.example/\tx", "control byte in an absolute target"},
+		{"ht tp://other.example/x", "invalid scheme in an absolute target"},
+	}
+	for _, c := range bad {
+		t.Run(c.note, func(t *testing.T) {
+			var u URI
+			if err := u.Parse(nil, []byte("http://host.example/base/x?q=1")); err != nil {
+				t.Fatalf("setup: %v", err)
+			}
+			u.Update(c.target)
+
+			if got := string(u.Host()); got != wantHost {
+				t.Errorf("Update(%q) left host=%q, want %q (full uri %q)", c.target, got, wantHost, u.FullURI())
+			}
+			if got := string(u.Path()); got != wantPath {
+				t.Errorf("Update(%q) left path=%q, want %q", c.target, got, wantPath)
+			}
+			if got := string(u.Scheme()); got != "http" {
+				t.Errorf("Update(%q) left scheme=%q, want http", c.target, got)
+			}
+			if got := string(u.FullURI()); strings.HasPrefix(got, "http:///") {
+				t.Errorf("Update(%q) produced a host-less uri %q", c.target, got)
+			}
+		})
+	}
+}
+
+// The redirect a handler emits must name the real host even when the target it
+// was handed is unusable, and must never carry a raw control byte on the wire.
+func TestURIUpdateRedirectKeepsHost(t *testing.T) {
+	t.Parallel()
+
+	for _, target := range []string{"/a\r\nX-Evil: 1", "/a\nb", "/a\rb", "/a\tb", "/a\x00b"} {
+		ctx := &RequestCtx{}
+		ctx.Request.SetRequestURI("http://host.example/base/x?q=1")
+		ctx.Request.Header.SetHost("host.example")
+		ctx.Redirect(target, StatusFound)
+
+		loc := string(ctx.Response.Header.Peek("Location"))
+		if !strings.HasPrefix(loc, "http://host.example/") {
+			t.Errorf("Redirect(%q) set Location=%q, want it to name host.example", target, loc)
+		}
+		if strings.ContainsAny(loc, "\r\n\x00") {
+			t.Errorf("Redirect(%q) set Location=%q, which holds a raw control byte", target, loc)
+		}
+		if ctx.Response.StatusCode() != StatusFound {
+			t.Errorf("Redirect(%q) status=%d, want 302", target, ctx.Response.StatusCode())
+		}
+	}
+}
+
+// Everything that resolved before must still resolve identically. These are the
+// cases the iteration 1 audit recorded as working, including the percent-encoded
+// control bytes that are legal in a path and must stay encoded on output.
+func TestURIUpdateGoodInputUnchanged(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct{ base, target, want string }{
+		{"http://host.example/a/b?q=1", "/c", "http://host.example/c"},
+		{"http://host.example/a/b?q=1", "c", "http://host.example/a/c"},
+		{"http://host.example/a/b?q=1", "?z=2", "http://host.example/a/b?z=2"},
+		{"http://host.example/a/b", "http://other.example/x", "http://other.example/x"},
+		{"http://host.example/a/b", "//other.example/x", "http://other.example/x"},
+		{"http://host.example/a/b", "../d", "http://host.example/d"},
+		{"http://host.example/a/b", "/a b", "http://host.example/a%20b"},
+		{"http://host.example/a/b", "/a%0d%0ab", "http://host.example/a%0D%0Ab"},
+		{"https://host.example/a/b", "//other.example/x", "https://other.example/x"},
+		{"http://user:pass@host.example/a", "/b", "http://host.example/b"},
+	}
+	for _, c := range cases {
+		var u URI
+		if err := u.Parse(nil, []byte(c.base)); err != nil {
+			t.Fatalf("setup %q: %v", c.base, err)
+		}
+		u.Update(c.target)
+		if got := string(u.FullURI()); got != c.want {
+			t.Errorf("base %q Update(%q) = %q, want %q", c.base, c.target, got, c.want)
+		}
+	}
+}
+
+// An empty newURI is documented as a no-op and must not disturb the uri either.
+func TestURIUpdateEmptyIsNoOp(t *testing.T) {
+	t.Parallel()
+
+	var u URI
+	if err := u.Parse(nil, []byte("http://host.example/a/b?q=1")); err != nil {
+		t.Fatalf("setup: %v", err)
+	}
+	before := string(u.FullURI())
+	u.Update("")
+	if got := string(u.FullURI()); got != before {
+		t.Errorf("Update(\"\") changed the uri from %q to %q", before, got)
+	}
+}
