index 0000000..1567398
--- /dev/null
+++ b/requestctx_time_test.go
@@ -0,0 +1,104 @@
+package fasthttp
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+// Time() is documented as "RequestHandler call time", and Init and Init2 are the
+// documented way a custom Server prepares a ctx before calling the handler. Both
+// set connTime and neither set time, so Time() returned the zero value and any
+// handler measuring its own latency saw two millennia. The server's own serveConn
+// path assigns ctx.time per request just before dispatching, which is why this was
+// only ever visible outside it.
+func TestRequestCtxInitSetsTime(t *testing.T) {
+	t.Parallel()
+
+	var req Request
+	req.SetRequestURI("http://example.com/foo")
+
+	cases := []struct {
+		name string
+		init func(ctx *RequestCtx)
+	}{
+		{"Init", func(ctx *RequestCtx) { ctx.Init(&req, nil, nil) }},
+		{"Init with a remote address", func(ctx *RequestCtx) {
+			ctx.Init(&req, &net.TCPAddr{IP: net.IPv4(1, 2, 3, 4), Port: 8080}, nil)
+		}},
+		{"Init2", func(ctx *RequestCtx) {
+			ctx.Init2(&fakeAddrer{laddr: zeroTCPAddr, raddr: zeroTCPAddr}, defaultLogger, true)
+		}},
+		{"Init2 keeping the body buffer", func(ctx *RequestCtx) {
+			ctx.Init2(&fakeAddrer{laddr: zeroTCPAddr, raddr: zeroTCPAddr}, defaultLogger, false)
+		}},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			var ctx RequestCtx
+			before := time.Now()
+			tc.init(&ctx)
+			after := time.Now()
+
+			got := ctx.Time()
+			if got.IsZero() {
+				t.Fatalf("Time() is the zero time after %s, so a handler cannot tell when it was called", tc.name)
+			}
+			if got.Before(before) || got.After(after) {
+				t.Fatalf("Time() = %v, want within [%v, %v]", got, before, after)
+			}
+			if d := time.Since(got); d < 0 || d > time.Minute {
+				t.Fatalf("time.Since(Time()) = %v, want a small positive duration", d)
+			}
+			if ct := ctx.ConnTime(); ct.Before(before) || ct.After(after) {
+				t.Fatalf("ConnTime() = %v, want within [%v, %v]", ct, before, after)
+			}
+		})
+	}
+}
+
+// The per-request clock must stay per-request: serveConn advances ctx.time for
+// every request on a keep-alive connection while ConnTime stays put, and a fix
+// that set the handler call time once at connection setup would silently break
+// that. This pins the difference on a real connection serving two requests.
+func TestRequestCtxTimeAdvancesPerRequest(t *testing.T) {
+	t.Parallel()
+
+	type stamp struct {
+		call time.Time
+		conn time.Time
+	}
+
+	stamps := make(chan stamp, 2)
+	s := &Server{
+		Handler: func(ctx *RequestCtx) {
+			stamps <- stamp{call: ctx.Time(), conn: ctx.ConnTime()}
+			ctx.SetStatusCode(StatusOK)
+		},
+	}
+
+	rw := &readWriter{}
+	rw.r.WriteString("GET /first HTTP/1.1\r\nHost: example.com\r\n\r\n")
+	rw.r.WriteString("GET /second HTTP/1.1\r\nHost: example.com\r\n\r\n")
+
+	if err := s.ServeConn(rw); err != nil {
+		t.Fatalf("ServeConn: %v", err)
+	}
+
+	first, second := <-stamps, <-stamps
+	if first.call.IsZero() || second.call.IsZero() {
+		t.Fatalf("Time() is the zero time inside the handler: first=%v second=%v", first.call, second.call)
+	}
+	if second.call.Before(first.call) {
+		t.Fatalf("Time() went backwards between requests: first=%v second=%v", first.call, second.call)
+	}
+	if !first.conn.Equal(second.conn) {
+		t.Fatalf("ConnTime() changed between two requests on one connection: first=%v second=%v", first.conn, second.conn)
+	}
+	if first.call.Before(first.conn) {
+		t.Fatalf("Time() = %v is before ConnTime() = %v", first.call, first.conn)
+	}
+}
