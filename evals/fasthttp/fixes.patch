diff --git a/server_body_too_large_test.go b/server_body_too_large_test.go
new file mode 100644
index 0000000..6b11096
--- /dev/null
+++ b/server_body_too_large_test.go
@@ -0,0 +1,154 @@
+package fasthttp
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/valyala/fasthttp/fasthttputil"
+)
+
+// A body over the limit is a well formed request that is simply too big, so it
+// gets 413 rather than the generic 400 the default error handler gives every
+// other failure. A client that reads 400 is told its request was malformed and
+// has nothing to act on; 413 names the one thing it can change.
+func TestServerBodyTooLargeStatus(t *testing.T) {
+	t.Parallel()
+
+	const maxBody = 16
+
+	cases := []struct {
+		name       string
+		limit      int
+		perRequest int
+		body       string
+		chunked    bool
+		wantStatus int
+	}{
+		{"over the server limit", maxBody, 0, strings.Repeat("x", 64), false, StatusRequestEntityTooLarge},
+		{"one byte over the server limit", maxBody, 0, strings.Repeat("x", maxBody+1), false, StatusRequestEntityTooLarge},
+		{"exactly at the server limit", maxBody, 0, strings.Repeat("x", maxBody), false, StatusOK},
+		{"over a per-request limit", 1 << 20, 8, strings.Repeat("x", 64), false, StatusRequestEntityTooLarge},
+		{"within a per-request limit", 1 << 20, 128, strings.Repeat("x", 64), false, StatusOK},
+		{"over the limit, chunked", maxBody, 0, strings.Repeat("x", 64), true, StatusRequestEntityTooLarge},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var handlerRan int32
+			s := &Server{
+				MaxRequestBodySize: tc.limit,
+				Handler: func(ctx *RequestCtx) {
+					atomic.AddInt32(&handlerRan, 1)
+					ctx.SetBodyString("ok")
+				},
+				Logger: &testLogger{},
+			}
+			if tc.perRequest > 0 {
+				limit := tc.perRequest
+				s.HeaderReceived = func(*RequestHeader) RequestConfig {
+					return RequestConfig{MaxRequestBodySize: limit}
+				}
+			}
+
+			ln := fasthttputil.NewInmemoryListener()
+			serveDone := make(chan error, 1)
+			go func() { serveDone <- s.Serve(ln) }()
+			defer func() {
+				_ = ln.Close()
+				<-serveDone
+			}()
+
+			c, err := ln.Dial()
+			if err != nil {
+				t.Fatalf("dial: %v", err)
+			}
+			defer c.Close() //nolint:errcheck
+			_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+
+			var raw string
+			if tc.chunked {
+				raw = "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n" +
+					fmt.Sprintf("%x\r\n%s\r\n0\r\n\r\n", len(tc.body), tc.body)
+			} else {
+				raw = fmt.Sprintf("POST / HTTP/1.1\r\nHost: h\r\nContent-Length: %d\r\n\r\n%s",
+					len(tc.body), tc.body)
+			}
+			if _, err := c.Write([]byte(raw)); err != nil {
+				t.Fatalf("write: %v", err)
+			}
+
+			var resp Response
+			if err := resp.Read(bufio.NewReader(c)); err != nil {
+				t.Fatalf("read response: %v", err)
+			}
+			if got := resp.StatusCode(); got != tc.wantStatus {
+				t.Errorf("body of %d bytes against limit %d: status=%d body=%q, want %d",
+					len(tc.body), tc.limit, got, resp.Body(), tc.wantStatus)
+			}
+			if tc.wantStatus == StatusRequestEntityTooLarge {
+				if got := string(resp.Body()); got != "Too big request body" {
+					t.Errorf("body=%q, want %q", got, "Too big request body")
+				}
+				if n := atomic.LoadInt32(&handlerRan); n != 0 {
+					t.Errorf("handler ran %d times for a refused request, want 0", n)
+				}
+			}
+		})
+	}
+}
+
+// The new branch must not swallow the failures that genuinely are 400. These are
+// the three requests the pre-existing tests pin, driven here through the same
+// path so the mapping is shown to have stayed specific.
+func TestServerBodyTooLargeDoesNotBecomeCatchAll(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct{ name, raw string }{
+		{"backslash in absolute uri", "GET http://example.com\\\\admin HTTP/1.1\r\nHost: example.com\r\n\r\n"},
+		{"missing host on HTTP/1.1", "GET /foo HTTP/1.1\r\n\r\n"},
+		{"content length with transfer encoding", "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: nope\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"},
+		{"duplicate content length", "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := &Server{
+				MaxRequestBodySize: 16,
+				Handler:            func(ctx *RequestCtx) { ctx.SetBodyString("ok") },
+				Logger:             &testLogger{},
+			}
+			ln := fasthttputil.NewInmemoryListener()
+			serveDone := make(chan error, 1)
+			go func() { serveDone <- s.Serve(ln) }()
+			defer func() {
+				_ = ln.Close()
+				<-serveDone
+			}()
+
+			c, err := ln.Dial()
+			if err != nil {
+				t.Fatalf("dial: %v", err)
+			}
+			defer c.Close() //nolint:errcheck
+			_ = c.SetDeadline(time.Now().Add(10 * time.Second))
+			if _, err := c.Write([]byte(tc.raw)); err != nil {
+				t.Fatalf("write: %v", err)
+			}
+
+			var resp Response
+			if err := resp.Read(bufio.NewReader(c)); err != nil {
+				t.Fatalf("read response: %v", err)
+			}
+			if got := resp.StatusCode(); got != StatusBadRequest {
+				t.Errorf("status=%d body=%q, want 400", got, resp.Body())
+			}
+			if got := string(resp.Body()); got != "Error when parsing request" {
+				t.Errorf("body=%q, want %q", got, "Error when parsing request")
+			}
+		})
+	}
+}
