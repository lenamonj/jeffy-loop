+
+// Args.Set shares setArg with the header setters, so it must replace every
+// occurrence too.
+func TestArgsSetReplacesEveryOccurrence(t *testing.T) {
+	t.Parallel()
+
+	var a Args
+	a.Parse("k=1&j=3&k=2&k=4")
+	a.Set("k", "9")
+
+	if got := a.String(); got != "k=9&j=3" {
+		t.Fatalf("unexpected args %q. Expecting %q", got, "k=9&j=3")
+	}
+	if got := a.PeekMulti("k"); len(got) != 1 || string(got[0]) != "9" {
+		t.Fatalf("unexpected PeekMulti after Set: %q", got)
+	}
+	if got := string(a.Peek("j")); got != "3" {
+		t.Fatalf("an unrelated arg changed: %q", got)
+	}
+
+	// A key set when absent is still appended, and setting it again replaces it.
+	a.Set("new", "1")
+	a.Set("new", "2")
+	if got := a.String(); got != "k=9&j=3&new=2" {
+		t.Fatalf("unexpected args %q. Expecting %q", got, "k=9&j=3&new=2")
+	}
+}
