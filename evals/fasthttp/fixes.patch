+			if got := entries[".."]; got != "/" {
+				t.Errorf("GET %q: parent link is %q, want %q; body=%q", reqPath, got, "/", body)
+			}
+
+			href, ok := entries["inner.txt"]
+			if !ok {
+				t.Fatalf("GET %q: no entry for inner.txt; body=%q", reqPath, body)
+			}
+			if decoded, err := url.PathUnescape(href); err != nil {
+				t.Errorf("inner href %q does not percent-decode: %v", href, err)
+			} else if want := "/" + dir + "/inner.txt"; decoded != want {
+				t.Errorf("inner href %q decodes to %q, want %q", href, decoded, want)
+			}
+			if st, got := dirIndexFetch(t, h, href); got != "inner" {
+				t.Errorf("following inner href %q: status=%d body=%q, want %q", href, st, got, "inner")
+			}
+		})
+	}
+}
