index bec110e..2be4e3a 100644
--- a/uri_windows_test.go
+++ b/uri_windows_test.go
@@ -18,3 +18,55 @@ func TestURIPathNormalizeIssue86(t *testing.T) {
 
 	testURIPathNormalize(t, &u, "/..%5c..%5cfoo", "/foo")
 }
+
+// Windows treats '\' as a path separator, so a ".." delimited by one is a real
+// parent-directory jump. Path() promises a normalized path, so every mix of
+// separators has to resolve, and the result has to stay rooted: dropping the
+// leading '/' would hand callers a path that resolves against the process
+// working directory instead of against the root they meant to join it to.
+func TestURIPathNormalizeBackslashSeparators(t *testing.T) {
+	t.Parallel()
+
+	var u URI
+
+	cases := []struct{ requestURI, expectedPath string }{
+		// A ".." delimited by any mix of separators resolves.
+		{`/a\../b`, "/b"},
+		{`/a/..\b`, "/b"},
+		{`/a\..\b`, "/b"},
+		{`/a\..\../b`, "/b"},
+		{`/x/a\..\../b`, "/b"},
+		{`\..\b`, "/b"},
+		{`/sub\..\..\secret.txt`, "/secret.txt"},
+
+		// A trailing ".." leaves the root, keeping its trailing separator.
+		{`/a\..`, "/"},
+		{`/a\..\`, "/"},
+		{`/a\b\..`, `/a\`},
+
+		// Percent-encoded separators decode before resolution, so they cannot
+		// smuggle a segment past the walk.
+		{`/%5c..%5c../b`, "/b"},
+		{`/a%5c..%5c..%2fb`, "/b"},
+
+		// A "." segment is dropped whichever separator delimits it, and the
+		// separators around the survivors are left as they were.
+		{`/a\.\b`, `/a\b`},
+
+		// Segments that merely begin with dots are ordinary names.
+		{`/a\..bbb\c`, `/a\..bbb\c`},
+	}
+
+	for _, c := range cases {
+		testURIPathNormalize(t, &u, c.requestURI, c.expectedPath)
+
+		u.Parse(nil, []byte(c.requestURI)) //nolint:errcheck
+		path := u.Path()
+		if len(path) == 0 || path[0] != '/' {
+			t.Errorf("path %q for requestURI %q is not rooted", path, c.requestURI)
+		}
+		if hasDotDotPathSegment(path) {
+			t.Errorf("path %q for requestURI %q still holds a %q segment", path, c.requestURI, "..")
+		}
+	}
+}
diff --git a/uservalue_close_test.go b/uservalue_close_test.go
new file mode 100644
index 0000000..09347ab
--- /dev/null
+++ b/uservalue_close_test.go
@@ -0,0 +1,150 @@
+package fasthttp
+
+import (
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+// closeCounter is a user value that records how often it was closed, so a test can
+// tell "not closed" from "closed twice".
+type closeCounter struct {
+	closed atomic.Int32
+}
+
+func (c *closeCounter) Close() error {
+	c.closed.Add(1)
+	return nil
+}
+
+// A stored value leaves userData four ways, and only two of them call Close.
+// ResetUserValues and the automatic cleanup after the top RequestHandler returns
+// close an io.Closer; RemoveUserValue* and storing another value under the same key
+// do not, handing the value back to the caller. That asymmetry is deliberate - a
+// caller who removes a value to pass it elsewhere must not have it closed underneath
+// them - and it is now documented, so this pins every arm of it against a later
+// change that quietly makes Remove close, or makes Reset stop.
+func TestRemoveUserValueDoesNotClose(t *testing.T) {
+	t.Parallel()
+
+	t.Run("RequestCtx", func(t *testing.T) {
+		t.Parallel()
+
+		cases := []struct {
+			name       string
+			drop       func(ctx *RequestCtx, v *closeCounter)
+			wantClosed int32
+		}{
+			{"RemoveUserValue", func(ctx *RequestCtx, _ *closeCounter) {
+				ctx.RemoveUserValue("k")
+			}, 0},
+			{"RemoveUserValueBytes", func(ctx *RequestCtx, _ *closeCounter) {
+				ctx.RemoveUserValueBytes([]byte("k"))
+			}, 0},
+			{"overwritten by another value", func(ctx *RequestCtx, _ *closeCounter) {
+				ctx.SetUserValue("k", "replacement")
+			}, 0},
+			{"overwritten by nil", func(ctx *RequestCtx, _ *closeCounter) {
+				ctx.SetUserValue("k", nil)
+			}, 0},
+			{"ResetUserValues", func(ctx *RequestCtx, _ *closeCounter) {
+				ctx.ResetUserValues()
+			}, 1},
+		}
+
+		for _, tc := range cases {
+			t.Run(tc.name, func(t *testing.T) {
+				t.Parallel()
+
+				var ctx RequestCtx
+				ctx.Init(&Request{}, nil, nil)
+
+				v := &closeCounter{}
+				ctx.SetUserValue("k", v)
+				if got := ctx.UserValue("k"); got != v {
+					t.Fatalf("UserValue before the drop = %v, want the stored value", got)
+				}
+
+				tc.drop(&ctx, v)
+
+				if got := ctx.UserValue("k"); got == v {
+					t.Fatalf("value is still reachable under its key after %s", tc.name)
+				}
+				if got := v.closed.Load(); got != tc.wantClosed {
+					t.Fatalf("Close called %d times after %s, want %d", got, tc.name, tc.wantClosed)
+				}
+			})
+		}
+	})
+
+	t.Run("Request", func(t *testing.T) {
+		t.Parallel()
+
+		cases := []struct {
+			name       string
+			drop       func(req *Request)
+			wantClosed int32
+		}{
+			{"RemoveUserValue", func(req *Request) { req.RemoveUserValue("k") }, 0},
+			{"RemoveUserValueBytes", func(req *Request) { req.RemoveUserValueBytes([]byte("k")) }, 0},
+			{"overwritten by another value", func(req *Request) { req.SetUserValue("k", "replacement") }, 0},
+			{"ResetUserValues", func(req *Request) { req.ResetUserValues() }, 1},
+			{"Reset", func(req *Request) { req.Reset() }, 1},
+		}
+
+		for _, tc := range cases {
+			t.Run(tc.name, func(t *testing.T) {
+				t.Parallel()
+
+				var req Request
+				v := &closeCounter{}
+				req.SetUserValue("k", v)
+
+				tc.drop(&req)
+
+				if got := req.UserValue("k"); got == v {
+					t.Fatalf("value is still reachable under its key after %s", tc.name)
+				}
+				if got := v.closed.Load(); got != tc.wantClosed {
+					t.Fatalf("Close called %d times after %s, want %d", got, tc.name, tc.wantClosed)
+				}
+			})
+		}
+	})
+
+	// The half of the contract SetUserValue's doc has always promised: values left in
+	// place are closed exactly once when the server is done with the request. A
+	// removed value is not, and a removed value must not be closed later by that
+	// cleanup either, which is the double-free this arm rules out.
+	t.Run("automatic cleanup after the handler", func(t *testing.T) {
+		t.Parallel()
+
+		kept, removed := &closeCounter{}, &closeCounter{}
+		s := &Server{
+			Handler: func(ctx *RequestCtx) {
+				ctx.SetUserValue("kept", kept)
+				ctx.SetUserValue("removed", removed)
+				ctx.RemoveUserValue("removed")
+				if removed.closed.Load() != 0 {
+					t.Errorf("Close called inside the handler by RemoveUserValue")
+				}
+			},
+		}
+
+		rw := &readWriter{}
+		rw.r.WriteString("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+		if err := s.ServeConn(rw); err != nil {
+			t.Fatalf("ServeConn: %v", err)
+		}
+		if !strings.Contains(rw.w.String(), "200") {
+			t.Fatalf("handler did not answer 200: %q", rw.w.String())
+		}
+
+		if got := kept.closed.Load(); got != 1 {
+			t.Fatalf("a value left in the ctx was closed %d times after the handler returned, want 1", got)
+		}
+		if got := removed.closed.Load(); got != 0 {
+			t.Fatalf("a value removed inside the handler was closed %d times, want 0", got)
+		}
+	})
+}
