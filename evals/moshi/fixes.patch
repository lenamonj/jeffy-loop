+/**
+ * Whether this annotation class survives into the runtime, which a `@JsonQualifier` must: Moshi
+ * matches qualifiers reflectively when it looks an adapter up, so one the compiler drops is a
+ * lookup that fails at runtime with no adapter found for the qualified type.
+ *
+ * Kotlin and Java spell retention with two different annotations and default it two different
+ * ways - Kotlin to RUNTIME, Java to CLASS - so an annotation class declaring neither is judged by
+ * the language it was declared in.
+ */
+internal fun KSClassDeclaration.isRetainedAtRuntime(): Boolean {
+  findAnnotationWithType<Retention>()?.let {
+    return it.value == AnnotationRetention.RUNTIME
+  }
+  findAnnotationWithType<java.lang.annotation.Retention>()?.let {
+    return it.value == RetentionPolicy.RUNTIME
+  }
+  return isKotlinClass()
+}
