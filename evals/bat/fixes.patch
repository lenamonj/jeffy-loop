+    /// Applies `--sanitize=always` in loop-through mode, where the line would
+    /// otherwise be passed through raw. Sanitizing exists to make untrusted
+    /// content safe to display, and a preview pane reads piped output, so
+    /// skipping it here would defeat the flag in its main use case.
+    ///
+    /// `--strip-ansi` deliberately does not act here: it is a display-fidelity
+    /// option, and `strip_ansi_does_not_affect_simple_printer` pins that.
+    /// `Auto` means "unless the syntax is plain text", and loop-through mode
+    /// emits no escape sequences of its own, so it is that case by construction.
+    ///
+    /// Decoding mirrors `InteractivePrinter::print_line`: UTF-16 is not UTF-8,
+    /// so decoding it lossily would replace every byte of the file.
+    fn transform_untrusted(&self, line_number: usize, line_buffer: &[u8]) -> Option<String> {
+        if self.config.sanitize != StripAnsiMode::Always {
+            return None;
         }
+
+        let line = match self.content_type {
+            Some(ContentType::UTF_16LE) => UTF_16LE.decode_with_bom_removal(line_buffer).0,
+            Some(ContentType::UTF_16BE) => UTF_16BE.decode_with_bom_removal(line_buffer).0,
+            _ => {
+                let line = String::from_utf8_lossy(line_buffer);
+                // A leading UTF-8 BOM would otherwise be substituted as U+FEFF.
+                match line.strip_prefix('\u{feff}').filter(|_| line_number == 1) {
+                    Some(stripped) => stripped.to_string().into(),
+                    None => line,
+                }
+            }
+        };
+
+        Some(sanitize(&line))
     }
 }
 
