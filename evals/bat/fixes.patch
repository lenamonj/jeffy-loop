     ) -> Result<bool> {
+        // An unresolvable --language is a user error and must be reported even
+        // when nothing would have looked it up: without highlighting, syntax
+        // resolution never runs, so the typo would otherwise pass silently.
+        if let Some(language) = self.config.language {
