+
+// The completion sub-commands are built once, on the first execution, and every
+// later call to InitDefaultCompletionCmd returns early. Anything the built
+// sub-commands close over is therefore reused by a second execution that meant
+// something else, so the writer and the descriptions setting are resolved per
+// execution instead.
+func TestCompletionCmdResolvesWriterPerExecution(t *testing.T) {
+	rootCmd := &Command{Use: "root", Run: emptyRun}
+	rootCmd.AddCommand(&Command{Use: "child", Short: "a child", Run: emptyRun})
+	rootCmd.SetErr(new(bytes.Buffer))
+
+	first := new(bytes.Buffer)
+	rootCmd.SetOut(first)
+	rootCmd.SetArgs([]string{"completion", "bash"})
+	if err := rootCmd.Execute(); err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+	if first.Len() == 0 {
+		t.Fatal("The first execution wrote no script")
+	}
+
+	second := new(bytes.Buffer)
+	rootCmd.SetOut(second)
+	rootCmd.SetArgs([]string{"completion", "bash"})
+	if err := rootCmd.Execute(); err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+	if second.Len() == 0 {
+		t.Error("The second execution wrote nothing to the writer set for it")
+	}
+	if first.Len() != second.Len() {
+		t.Errorf("The two executions wrote %d and %d bytes; expected the same script twice",
+			first.Len(), second.Len())
+	}
+}
+
+func TestCompletionCmdNoDescriptionsIsPerShell(t *testing.T) {
+	// One shared variable behind all four shells meant --no-descriptions on one
+	// of them silently applied to the next shell asked in the same process.
+	rootCmd := &Command{Use: "root", Run: emptyRun}
+	rootCmd.AddCommand(&Command{Use: "child", Short: "a child", Run: emptyRun})
+	rootCmd.SetErr(new(bytes.Buffer))
+
+	buf := new(bytes.Buffer)
+	rootCmd.SetOut(buf)
+	rootCmd.SetArgs([]string{"completion", "bash", "--no-descriptions"})
+	if err := rootCmd.Execute(); err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+	buf.Reset()
+	rootCmd.SetArgs([]string{"completion", "zsh"})
+	if err := rootCmd.Execute(); err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+
+	refCmd := &Command{Use: "root", Run: emptyRun}
+	refCmd.AddCommand(&Command{Use: "child", Short: "a child", Run: emptyRun})
+	withDesc, noDesc := new(bytes.Buffer), new(bytes.Buffer)
+	if err := refCmd.GenZshCompletion(withDesc); err != nil {
+		t.Fatal(err)
+	}
+	if err := refCmd.GenZshCompletionNoDesc(noDesc); err != nil {
+		t.Fatal(err)
+	}
+
+	if got := buf.String(); got != withDesc.String() {
+		if got == noDesc.String() {
+			t.Error("zsh was generated without descriptions after bash was asked for none")
+		} else {
+			t.Errorf("zsh script matched neither reference form (%d bytes)", buf.Len())
+		}
+	}
+}
