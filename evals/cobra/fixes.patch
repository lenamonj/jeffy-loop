+func TestInheritedFlagsFollowReparenting(t *testing.T) {
+	// A command's lflags, iflags and parentsPflags are all derived from its
+	// parent chain and none is rebuilt from scratch, so every site that changes
+	// c.parent has to invalidate them. The three sites are AddCommand,
+	// RemoveCommand and ResetCommands; each detach path is driven here.
+	detachers := map[string]func(oldRoot, child *Command){
+		"ResetCommands": func(_, child *Command) { child.ResetCommands() },
+		"RemoveCommand": func(oldRoot, child *Command) { oldRoot.RemoveCommand(child) },
+		"AddCommandOnly": func(_, _ *Command) {
+			// re-parenting with no detach call at all: AddCommand is the only
+			// site that runs, and it has to invalidate on its own.
+		},
+	}
+
+	for name, detach := range detachers {
+		t.Run(name, func(t *testing.T) {
+			oldRoot := &Command{Use: "oldroot", Run: emptyRun}
+			oldRoot.PersistentFlags().String("from-old", "", "flag from the old parent")
+			newRoot := &Command{Use: "newroot", Run: emptyRun}
+			newRoot.PersistentFlags().String("from-new", "", "flag from the new parent")
+
+			child := &Command{Use: "child", Run: emptyRun}
+			oldRoot.AddCommand(child)
+
+			// Warm the caches the way help, completion and doc generation do.
+			if child.InheritedFlags().Lookup("from-old") == nil {
+				t.Fatal("expected from-old to be inherited while attached to oldroot")
+			}
+
+			detach(oldRoot, child)
+			newRoot.AddCommand(child)
+
+			inherited := child.InheritedFlags()
+			if inherited.Lookup("from-old") != nil {
+				t.Error("expected from-old to stop being inherited after re-parenting")
+			}
+			if inherited.Lookup("from-new") == nil {
+				t.Error("expected from-new to be inherited after re-parenting")
+			}
+		})
+	}
+}
