+func TestReparentingParseStateAcrossRebuild(t *testing.T) {
+	// This test is the enumeration the doc comment on dropParentsPflagsFromFlags
+	// defers to: which accessors survive the rebuild of c.flags and which do
+	// not. Every one is driven across a real parse, because a flag set with Set
+	// rather than Parse leaves no record to lose and would certify either answer.
+	root := &Command{Use: "root", Run: emptyRun}
+	root.PersistentFlags().String("from-old", "", "")
+	child := &Command{Use: "child", Run: emptyRun}
+	child.Flags().String("own", "", "")
+	root.AddCommand(child)
+	child.InheritedFlags() // force the merge, so the rebuild has something to drop
+
+	if err := child.Flags().Parse([]string{"--own", "v", "pos1", "--", "pos2"}); err != nil {
+		t.Fatal(err)
+	}
+	visited := func() []string {
+		var names []string
+		child.Flags().Visit(func(f *pflag.Flag) { names = append(names, f.Name) })
+		return names
+	}
+	if !child.Flags().Parsed() || !child.Flags().Changed("own") || len(child.Flags().Args()) != 2 ||
+		child.Flags().ArgsLenAtDash() != 1 || len(visited()) != 1 {
+		t.Fatal("setup: the parse did not populate the set-level record")
+	}
+
+	root.RemoveCommand(child)
+
+	if child.Flags().Lookup("from-old") != nil {
+		t.Fatal("setup: the rebuild did not run")
+	}
+	// Carried: both the flag's own Changed and the set's, which reads through to it.
+	if !child.Flags().Changed("own") {
+		t.Error("FlagSet.Changed was lost across the rebuild")
+	}
+	if own := child.Flags().Lookup("own"); !own.Changed || own.Value.String() != "v" {
+		t.Errorf("the flag lost its state: changed=%v value=%q", own.Changed, own.Value.String())
+	}
+	// Lost: the record the parse left on the set itself.
+	if child.Flags().Parsed() {
+		t.Error("Parsed survived the rebuild; the set-level parse record is not carried")
+	}
+	if got := child.Flags().Args(); len(got) != 0 {
+		t.Errorf("Args survived the rebuild as %v", got)
+	}
+	if got := child.Flags().ArgsLenAtDash(); got != -1 {
+		t.Errorf("ArgsLenAtDash survived the rebuild as %d", got)
+	}
+	if got := visited(); len(got) != 0 {
+		t.Errorf("Visit survived the rebuild as %v", got)
+	}
+}
