+// SOURCE_DATE_EPOCH exists to make output reproducible, so the date it names
+// must be read as UTC: the same epoch has to produce the same page on machines
+// in different time zones.
+func TestGenManSourceDateEpochIsReproducibleAcrossZones(t *testing.T) {
+	// 2001-09-09 01:46:40 UTC, which falls on a different calendar day in any
+	// zone more than about two hours west of Greenwich.
+	const epoch = "1000000000"
+
+	oldEpoch, hadEpoch := os.LookupEnv("SOURCE_DATE_EPOCH")
+	if err := os.Setenv("SOURCE_DATE_EPOCH", epoch); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if hadEpoch {
+			assertNoErr(t, os.Setenv("SOURCE_DATE_EPOCH", oldEpoch))
+		} else {
+			assertNoErr(t, os.Unsetenv("SOURCE_DATE_EPOCH"))
+		}
+	}()
+
+	render := func(name string, offsetSeconds int) string {
+		saved := time.Local
+		defer func() { time.Local = saved }()
+		time.Local = time.FixedZone(name, offsetSeconds)
+
+		buf := new(bytes.Buffer)
+		if err := GenMan(&cobra.Command{Use: "solo", Short: "s", Run: emptyRun}, nil, buf); err != nil {
+			t.Fatal(err)
+		}
+		return buf.String()
+	}
+
+	west := render("WEST", -11*60*60) // 2001-09-08 locally
+	east := render("EAST", +13*60*60) // 2001-09-09 locally
+
+	if west != east {
+		t.Errorf("the same SOURCE_DATE_EPOCH produced different pages in different zones:\n--- west ---\n%s\n--- east ---\n%s", west, east)
+	}
+	if !strings.Contains(west, "9-Sep-2001") {
+		t.Errorf("SOURCE_DATE_EPOCH was not rendered as the UTC date 9-Sep-2001:\n%s", west)
+	}
+}
