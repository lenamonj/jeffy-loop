+// Every field GenYaml emits must parse back to the exact value it was given,
+// whether or not the flag carries a shorthand and whatever the string's length.
+func TestGenYamlRoundTripsValuesExactly(t *testing.T) {
+	const longDefault = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	const longShort = "a short description that runs past sixty characters without any newline"
+	const longLong = "a long description that also runs past sixty characters without any newline in it"
+
+	newCmd := func(use string, withShorthand bool) *cobra.Command {
+		c := &cobra.Command{
+			Use:   use,
+			Short: longShort,
+			Long:  longLong,
+			Run:   func(*cobra.Command, []string) {},
+		}
+		if withShorthand {
+			c.Flags().StringP("opt", "o", longDefault, longShort)
+		} else {
+			c.Flags().String("opt", longDefault, longShort)
+		}
+		return c
+	}
+
+	for _, withShorthand := range []bool{true, false} {
+		name := fmt.Sprintf("shorthand=%v", withShorthand)
+		buf := new(bytes.Buffer)
+		if err := GenYaml(newCmd("cmd", withShorthand), buf); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+
+		var got cmdDoc
+		if err := yaml.Unmarshal(buf.Bytes(), &got); err != nil {
+			t.Fatalf("%s: unmarshal: %v\n%s", name, err, buf.String())
+		}
+
+		if got.Synopsis != longShort {
+			t.Errorf("%s: synopsis: got %q want %q", name, got.Synopsis, longShort)
+		}
+		if got.Description != longLong {
+			t.Errorf("%s: description: got %q want %q", name, got.Description, longLong)
+		}
+
+		var opt *cmdOption
+		for i := range got.Options {
+			if got.Options[i].Name == "opt" {
+				opt = &got.Options[i]
+			}
+		}
+		if opt == nil {
+			t.Fatalf("%s: flag 'opt' missing from generated options", name)
+		}
+		if opt.DefaultValue != longDefault {
+			t.Errorf("%s: default_value: got %d bytes %q want %d bytes %q",
+				name, len(opt.DefaultValue), opt.DefaultValue, len(longDefault), longDefault)
+		}
+		if opt.Usage != longShort {
+			t.Errorf("%s: usage: got %q want %q", name, opt.Usage, longShort)
+		}
+	}
+}
