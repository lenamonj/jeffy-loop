+// runShellCheck pipes a generated script through shellcheck. Callers pass any
+// further diagnostic codes the script deliberately triggers.
+func runShellCheck(s string, exclude ...string) error {
+	excluded := append([]string{
 		"SC2034", // PREFIX appears unused. Verify it or export it.
+	}, exclude...)
+	cmd := exec.Command("shellcheck", "-s", "bash", "-", "-e",
+		strings.Join(excluded, ","),
 	)
 	cmd.Stderr = os.Stderr
 	cmd.Stdout = os.Stdout
@@ -287,3 +292,76 @@ func TestBashCompletionNoActiveHelp(t *testing.T) {
 	activeHelpVar := activeHelpEnvVar(c.Name())
 	check(t, output, fmt.Sprintf("%s=0", activeHelpVar))
 }
+
+// Generating a completion script must not reorder the caller's command tree.
+// The generators are handed the caller's own slices, so sorting them in place
+// changes what the program prints afterwards: the Aliases: line of the help
+// output is built from the same slice the bash generator sorts.
+func TestGenerationDoesNotMutateCommandTree(t *testing.T) {
+	// Deliberately unsorted, so an in-place sort is visible.
+	const (
+		wantAliases    = "zeta, alpha, mid"
+		wantValidArgs  = "pod, node, cluster"
+		wantArgAliases = "pods, nodes, clusters"
+	)
+
+	newTree := func() (*Command, *Command) {
+		root := &Command{Use: "app", Run: emptyRun}
+		child := &Command{
+			Use:        "get",
+			Short:      "get things",
+			Aliases:    strings.Split(wantAliases, ", "),
+			ValidArgs:  strings.Split(wantValidArgs, ", "),
+			ArgAliases: strings.Split(wantArgAliases, ", "),
+			Run:        emptyRun,
+		}
+		root.AddCommand(child)
+		return root, child
+	}
+
+	generators := map[string]func(*Command, *bytes.Buffer) error{
+		"GenBashCompletion":   func(c *Command, w *bytes.Buffer) error { return c.GenBashCompletion(w) },
+		"GenBashCompletionV2": func(c *Command, w *bytes.Buffer) error { return c.GenBashCompletionV2(w, true) },
+		"GenZshCompletion":    func(c *Command, w *bytes.Buffer) error { return c.GenZshCompletion(w) },
+		"GenFishCompletion":   func(c *Command, w *bytes.Buffer) error { return c.GenFishCompletion(w, true) },
+		"GenPowerShellCompletion": func(c *Command, w *bytes.Buffer) error {
+			return c.GenPowerShellCompletion(w)
+		},
+	}
+
+	// The help text of an untouched tree is the reference every generator is
+	// held to; comparing whole help output rather than only the slices catches
+	// a mutation wherever it happens to surface.
+	refRoot, _ := newTree()
+	wantHelp, err := executeCommand(refRoot, "get", "--help")
+	if err != nil {
+		t.Fatalf("reference help failed: %v", err)
+	}
+
+	for name, generate := range generators {
+		t.Run(name, func(t *testing.T) {
+			root, child := newTree()
+			if err := generate(root, new(bytes.Buffer)); err != nil {
+				t.Fatalf("%s returned %v", name, err)
+			}
+
+			if got := strings.Join(child.Aliases, ", "); got != wantAliases {
+				t.Errorf("%s reordered Aliases: got %q, want %q", name, got, wantAliases)
+			}
+			if got := strings.Join(child.ValidArgs, ", "); got != wantValidArgs {
+				t.Errorf("%s reordered ValidArgs: got %q, want %q", name, got, wantValidArgs)
+			}
+			if got := strings.Join(child.ArgAliases, ", "); got != wantArgAliases {
+				t.Errorf("%s reordered ArgAliases: got %q, want %q", name, got, wantArgAliases)
+			}
+
+			gotHelp, err := executeCommand(root, "get", "--help")
+			if err != nil {
+				t.Fatalf("help after %s failed: %v", name, err)
+			}
+			if gotHelp != wantHelp {
+				t.Errorf("%s changed the help output.\ngot:\n%s\nwant:\n%s", name, gotHelp, wantHelp)
+			}
+		})
+	}
+}
