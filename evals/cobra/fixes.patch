+// autoGenTagDisabled reports whether the auto-generated tag should be left out
+// of cmd's documentation: either cmd disables it or some ancestor does. It
+// answers the question without writing to cmd, so generating documentation
+// never mutates the command tree the caller owns.
+func autoGenTagDisabled(cmd *cobra.Command) bool {
