 // ArbitraryArgs
 
 func TestArbitraryArgs(t *testing.T) {
@@ -539,3 +565,46 @@ func TestLegacyArgsSubcmdAcceptsArgs(t *testing.T) {
 		t.Fatalf("Unexpected error: %v", err)
 	}
 }
+
+// A nil Args is not ArbitraryArgs, and the user guide says so because this
+// test says so. Find applies legacyArgs on exactly the condition Args == nil,
+// so setting Args to any validator - ArbitraryArgs included - replaces that
+// behaviour rather than restating it. Every branch the guide enumerates is
+// driven here, and the last two subtests are the contrast itself: one tree,
+// two settings, two outcomes.
+func TestNilArgsIsNotArbitraryArgs(t *testing.T) {
+	withSub := func(args PositionalArgs) *Command {
+		rootCmd := &Command{Use: "root", Args: args, Run: emptyRun}
+		rootCmd.AddCommand(&Command{Use: "child", Run: emptyRun})
+		return rootCmd
+	}
+
+	t.Run("no subcommands accepts args", func(t *testing.T) {
+		if _, err := executeCommand(&Command{Use: "root", Args: nil, Run: emptyRun}, "somearg"); err != nil {
+			t.Errorf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("subcommand accepts args", func(t *testing.T) {
+		if _, err := executeCommand(withSub(nil), "child", "somearg"); err != nil {
+			t.Errorf("unexpected error: %v", err)
+		}
+	})
+
+	t.Run("nil on a root with subcommands rejects", func(t *testing.T) {
+		_, err := executeCommand(withSub(nil), "bogus")
+		if err == nil {
+			t.Fatal("expected an error, got nil: a nil Args would then mean ArbitraryArgs")
+		}
+		expected := `unknown command "bogus" for "root"`
+		if !strings.Contains(err.Error(), expected) {
+			t.Errorf("expected %q, got %q", expected, err.Error())
+		}
+	})
+
+	t.Run("ArbitraryArgs on the same root accepts", func(t *testing.T) {
+		if _, err := executeCommand(withSub(ArbitraryArgs), "bogus"); err != nil {
+			t.Errorf("unexpected error: %v", err)
+		}
+	})
+}
