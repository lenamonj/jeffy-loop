+
+	"github.com/spf13/cobra"
+)
+
+// autoGenTagGenerators is every generator that emits the auto-generated tag.
+// GenYaml is absent because the yaml documents carry no such tag.
+var autoGenTagGenerators = map[string]func(*cobra.Command, io.Writer) error{
+	"GenMarkdown": GenMarkdown,
+	"GenReST":     GenReST,
+	"GenMan": func(cmd *cobra.Command, w io.Writer) error {
+		return GenMan(cmd, nil, w)
+	},
+}
+
+// A parent's DisableAutoGenTag must reach the child's document without being
+// written into the child's own field: generating docs must not mutate the
+// command tree the caller owns, or the suppression outlives the setting that
+// caused it.
+func TestAutoGenTagInheritedWithoutMutation(t *testing.T) {
+	for name, gen := range autoGenTagGenerators {
+		t.Run(name, func(t *testing.T) {
+			root := &cobra.Command{Use: "root", Short: "root short", Run: emptyRun}
+			child := &cobra.Command{Use: "child", Short: "child short", Run: emptyRun}
+			root.AddCommand(child)
+
+			emits := func() bool {
+				buf := new(bytes.Buffer)
+				if err := gen(child, buf); err != nil {
+					t.Fatal(err)
+				}
+				return strings.Contains(buf.String(), "Auto generated by spf13/cobra")
+			}
+
+			if !emits() {
+				t.Fatal("the tag is missing although neither command disables it")
+			}
+
+			root.DisableAutoGenTag = true
+			if emits() {
+				t.Error("the parent's DisableAutoGenTag did not reach the child's document")
+			}
+			if child.DisableAutoGenTag {
+				t.Error("generating wrote the parent's DisableAutoGenTag into the child's own field")
+			}
+
+			root.DisableAutoGenTag = false
+			if !emits() {
+				t.Error("clearing the parent's DisableAutoGenTag did not restore the tag")
+			}
+		})
+	}
+}
+
+// The command's own flag still wins, and still suppresses the tag on its own.
+func TestAutoGenTagOwnFlag(t *testing.T) {
+	for name, gen := range autoGenTagGenerators {
+		t.Run(name, func(t *testing.T) {
+			c := &cobra.Command{Use: "solo", Short: "s", Run: emptyRun}
+			buf := new(bytes.Buffer)
+			if err := gen(c, buf); err != nil {
+				t.Fatal(err)
+			}
+			if !strings.Contains(buf.String(), "Auto generated by spf13/cobra") {
+				t.Fatal("the tag is missing although the command does not disable it")
+			}
+
+			c.DisableAutoGenTag = true
+			buf.Reset()
+			if err := gen(c, buf); err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(buf.String(), "Auto generated by spf13/cobra") {
+				t.Error("DisableAutoGenTag did not suppress the tag")
+			}
+		})
+	}
+}
+
+// Generating documentation must not reorder the caller's child commands.
+// Commands() returns the command's own slice rather than a copy, so a
+// generator that sorts what it returns rewrites the tree the caller owns.
+// The reordering is only observable while EnableCommandSorting is off, which
+// is the setting whose whole purpose is preserving the declared order.
+func TestGenerationDoesNotReorderChildren(t *testing.T) {
+	restore := cobra.EnableCommandSorting
+	cobra.EnableCommandSorting = false
+	defer func() { cobra.EnableCommandSorting = restore }()
+
+	// Declared out of alphabetical order, so an in-place sort is visible.
+	const want = "zebra apple mango"
+
+	generators := map[string]func(*cobra.Command, io.Writer) error{
+		"GenMarkdown": GenMarkdown,
+		"GenReST":     GenReST,
+		"GenYaml":     GenYaml,
+		"GenMan": func(cmd *cobra.Command, w io.Writer) error {
+			return GenMan(cmd, nil, w)
+		},
+	}
+
+	for name, generate := range generators {
+		t.Run(name, func(t *testing.T) {
+			root := &cobra.Command{Use: "root", Short: "root", Run: emptyRun}
+			for _, child := range strings.Fields(want) {
+				root.AddCommand(&cobra.Command{Use: child, Short: child, Run: emptyRun})
+			}
+
+			if err := generate(root, io.Discard); err != nil {
+				t.Fatalf("%s returned %v", name, err)
+			}
+
+			// Generation adds the default help command, so compare the
+			// relative order of the declared children rather than the whole
+			// slice: the contract is that generating reorders nothing, not
+			// that it adds nothing.
+			declared := strings.Fields(want)
+			var got []string
+			for _, c := range root.Commands() {
+				for _, d := range declared {
+					if c.Name() == d {
+						got = append(got, c.Name())
+						break
+					}
+				}
+			}
+			if strings.Join(got, " ") != want {
+				t.Errorf("%s reordered the children: got %q, want %q",
+					name, strings.Join(got, " "), want)
+			}
+		})
+	}
+}
