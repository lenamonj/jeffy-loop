+// invalidateParentFlagCaches drops everything c derived from its ancestors, so
+// that it is recomputed against the parent chain c has now, and recurses into
+// c's children, whose own ancestry changed with c's. Every site that assigns
+// c.parent calls it: the derived state is cumulative and none of it is rebuilt
+// from scratch on its own, so without this a re-parented command keeps
+// reporting - and accepting - the persistent flags of the parent it no longer
+// has.
+func (c *Command) invalidateParentFlagCaches() {
+	c.lflags = nil
+	c.iflags = nil
+	c.dropParentsPflagsFromFlags()
+	c.parentsPflags = nil
+
+	for _, child := range c.commands {
+		child.invalidateParentFlagCaches()
+	}
+}
+
+// dropParentsPflagsFromFlags rebuilds c.flags without the ancestors' persistent
+// flags that mergePersistentFlags copied into it. It is a rebuild rather than a
+// removal because pflag has no way to take a flag back out of a set; a flag is
+// the ancestors' when the pointer under its name is the one c.parentsPflags
+// holds, which is the same test LocalFlags uses to tell the two apart.
+//
+// The rebuilt set carries over every setting pflag lets a caller read back, and
+// carries the flags themselves by pointer, so anything recorded on a Flag
+// survives. What it cannot carry is the state pflag keeps on the set and offers
+// no way to put back: the record a parse leaves behind, and the interspersed
+// mode. That reaches only a command re-parented after it has been parsed.
+// TestReparentingParseStateAcrossRebuild is the enumeration of which side each
+// accessor falls on, and it is the copy of that list to trust, because it is
+// the one that gets re-run.
+func (c *Command) dropParentsPflagsFromFlags() {
+	if c.flags == nil || c.parentsPflags == nil {
+		return
+	}
+
+	inherited := false
+	c.flags.VisitAll(func(f *flag.Flag) {
+		if f == c.parentsPflags.Lookup(f.Name) {
+			inherited = true
+		}
+	})
+	if !inherited {
+		return
+	}
+
+	own := flag.NewFlagSet(c.flags.Name(), flag.ContinueOnError)
+	own.SetOutput(c.flags.Output())
+	own.SetNormalizeFunc(c.flags.GetNormalizeFunc())
+	own.SortFlags = c.flags.SortFlags
+	own.Usage = c.flags.Usage
+	own.ParseErrorsAllowlist = c.flags.ParseErrorsAllowlist
+	own.ParseErrorsWhitelist = c.flags.ParseErrorsWhitelist
+	c.flags.VisitAll(func(f *flag.Flag) {
+		if f != c.parentsPflags.Lookup(f.Name) {
+			own.AddFlag(f)
+		}
+	})
+	c.flags = own
+}
