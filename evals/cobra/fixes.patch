+// sortedChildren returns cmd's child commands ordered by name. Commands()
+// returns the command's own slice rather than a copy, so sorting what it
+// returns would reorder the command tree the caller owns; the copy is what
+// keeps generating documentation from rewriting the tree it documents.
+func sortedChildren(cmd *cobra.Command) []*cobra.Command {
+	children := append([]*cobra.Command(nil), cmd.Commands()...)
+	sort.Sort(byName(children))
