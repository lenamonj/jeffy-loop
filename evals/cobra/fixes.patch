+	after := used.SuggestionsFor("srever")
+	if strings.Join(before, ",") != strings.Join(after, ",") {
+		t.Errorf("SuggestionsFor depends on a prior Execute: fresh gave %v, used gave %v", before, after)
+	}
+
+	// The Execute path keeps its default of 2: "srever" is two edits from
+	// "server" and is nobody's prefix, so it is offered only at distance >= 2.
+	if !strings.Contains(output, "server") {
+		t.Errorf("Execute lost the default distance of 2, output was %q", output)
+	}
+	// And the accessor at the zero value offers nothing for that same typo.
+	if len(before) != 0 {
+		t.Errorf("SuggestionsFor at the zero value = %v, want none", before)
+	}
+}
