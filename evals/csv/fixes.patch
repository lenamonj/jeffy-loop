+
+declare(strict_types=1);
+
+namespace League\Csv;
+
+use LogicException;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+use function fclose;
+use function fopen;
+use function is_resource;
+
+final class StreamFilterTest extends TestCase
+{
+    /** @return resource */
+    private function stream()
+    {
+        $stream = fopen('php://temp', 'r+');
+        self::assertIsResource($stream);
+
+        return $stream;
+    }
+
+    #[Test]
+    public function it_accepts_a_member_of_a_registered_filter_family(): void
+    {
+        // stream_get_filters() lists families as `zlib.*` and `convert.iconv.*`,
+        // never their concrete members, so an exact-match check refuses them all.
+        $stream = $this->stream();
+
+        self::assertTrue(is_resource(StreamFilter::appendOnReadTo($stream, 'zlib.deflate')));
+        self::assertTrue(is_resource(StreamFilter::appendOnReadTo($stream, 'convert.iconv.UTF-8/ISO-8859-15')));
+
+        fclose($stream);
+    }
+
+    #[Test]
+    public function it_accepts_the_same_names_as_the_AbstractCsv_entry_points(): void
+    {
+        $reader = Reader::fromString("a,b\n");
+        $reader->appendStreamFilterOnRead('zlib.deflate');
+
+        $stream = $this->stream();
+
+        self::assertTrue(is_resource(StreamFilter::appendOnReadTo($stream, 'zlib.deflate')));
+
+        fclose($stream);
+    }
+
+    #[Test]
+    public function it_attaches_a_filter_that_refuses_an_explicit_null_params(): void
+    {
+        // The four entry points pass $params positionally; PHP's convert.base64 and
+        // convert.quoted-printable filters refuse an explicit null and accept the
+        // same call with the argument omitted.
+        $appendRead = $this->stream();
+        $prependRead = $this->stream();
+        $appendWrite = $this->stream();
+        $prependWrite = $this->stream();
+
+        self::assertTrue(is_resource(StreamFilter::appendOnReadTo($appendRead, 'convert.base64-encode')));
+        self::assertTrue(is_resource(StreamFilter::prependOnReadTo($prependRead, 'convert.base64-decode')));
+        self::assertTrue(is_resource(StreamFilter::appendOnWriteTo($appendWrite, 'convert.quoted-printable-encode')));
+        self::assertTrue(is_resource(StreamFilter::prependOnWriteTo($prependWrite, 'convert.quoted-printable-decode')));
+
+        fclose($appendRead);
+        fclose($prependRead);
+        fclose($appendWrite);
+        fclose($prependWrite);
+    }
+
+    #[Test]
+    public function it_still_refuses_a_name_no_family_covers(): void
+    {
+        $stream = $this->stream();
+
+        try {
+            $this->expectException(LogicException::class);
+            StreamFilter::appendOnReadTo($stream, 'no.such.filter');
+        } finally {
+            fclose($stream);
+        }
+    }
+
+    #[Test]
+    public function it_refuses_a_family_prefix_that_is_not_a_member(): void
+    {
+        $stream = $this->stream();
+
+        try {
+            $this->expectException(LogicException::class);
+            StreamFilter::appendOnReadTo($stream, 'zlibdeflate');
+        } finally {
+            fclose($stream);
+        }
+    }
+}
