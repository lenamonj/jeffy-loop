+    @Test fun builderSetOfTheStoredElementIsNoOperation() {
+        // PersistentCollection.Builder.build() returns the source instance while no operation has
+        // modified the builder. Writing back the element already stored modifies nothing, so it
+        // must not cost that promise; the hash map and hash set builders already return early on
+        // an identical value.
+        for (size in listOf(1, 2, 32, 33, 1024, 2000)) {
+            val list = List(size) { Any() }.toPersistentList()
+            for (index in listOf(0, size / 2, size - 1)) {
+                val builder = list.builder()
+                builder[index] = list[index]
+                assertTrue(
+                    list === builder.build(),
+                    "set(index, the stored element) must not modify the builder: size=$size index=$index"
+                )
+            }
+            // A real replacement still builds a new list, and the source is left alone.
+            val builder = list.builder()
+            val replacement = Any()
+            builder[0] = replacement
+            val built = builder.build()
+            assertTrue(list !== built, "a real replacement builds a new list: size=$size")
+            assertTrue(replacement === built[0], "a real replacement is stored: size=$size")
+            assertTrue(list[0] !== built[0], "the source list is unchanged: size=$size")
+        }
+    }
