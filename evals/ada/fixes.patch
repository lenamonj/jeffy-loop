--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,9 @@
+# The loop state files and probe scripts are committed so they survive between
+# runs, but they are not part of ada's source. git archive honours
+# export-ignore, and git archive is what produces the "Source code" assets
+# attached to a GitHub release, so these stay out of every published archive.
+/PLAN.md export-ignore
+/BACKLOG.md export-ignore
+/JOURNAL.md export-ignore
+/JOURNAL-archive.md export-ignore
+/.jeffy export-ignore
diff --git a/.github/workflows/adaparse-cli.yml b/.github/workflows/adaparse-cli.yml
new file mode 100644
index 00000000..e3caf3c0
--- /dev/null
+++ b/.github/workflows/adaparse-cli.yml
@@ -0,0 +1,88 @@
+name: adaparse CLI
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+    paths-ignore:
+      - '**.md'
+      - 'docs/**'
+  push:
+    branches:
+      - main
+    paths-ignore:
+      - '**.md'
+      - 'docs/**'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  # ADA_TOOLS defaults to OFF and no other workflow turns it on, so adaparse -
+  # the CLI documented in README.md and docs/cli.md - was never built or run by
+  # CI at all. This job builds it and drives it over real URLs.
+  #
+  # Both input paths are exercised because they are different code: adaparse
+  # reads stdin whenever stdin is not a tty, so under a CI shell it ignores its
+  # argv entirely. The argv path only runs behind a pty, which is what
+  # script(1) supplies here; a check that only piped URLs would leave every
+  # option that argv selects untested.
+  adaparse:
+    name: adaparse
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Configure
+        run: >
+          cmake -S . -B build -DADA_TOOLS=ON -DADA_TESTING=OFF
+          -DCMAKE_BUILD_TYPE=Release
+
+      - name: Build adaparse
+        run: cmake --build build -j4 --target adaparse
+
+      - name: Drive adaparse over URLs
+        run: |
+          adaparse=build/tools/cli/adaparse
+          fail=0
+          check() {
+            local name=$1 expected=$2 want=$3 snippet=$4
+            local out status
+            out=$(bash -c "$snippet" 2>&1) && status=0 || status=$?
+            out=${out//$'\r'/}
+            if [ "$out" = "$expected" ] && [ "$status" = "$want" ]; then
+              echo "ok   $name"
+            else
+              echo "FAIL $name"
+              echo "  got    [$out] status $status"
+              echo "  wanted [$expected] status $want"
+              fail=1
+            fi
+          }
+
+          # Piped: the bulk path docs/cli.md benchmarks against 100k-line files.
+          check 'piped -g host keeps the port and drops credentials' \
+            'example.com:8080' 0 \
+            "echo 'https://user:pass@example.com:8080/a/b?q=1#f' | $adaparse -g host"
+          check 'piped -g href normalizes case and dot segments' \
+            'https://example.com/b' 0 \
+            "echo 'https://EXAMPLE.com/a/../b' | $adaparse -g href"
+          check 'piped invalid URL is reported and does not end the stream' \
+            'Invalid URL: not a url' 0 \
+            "echo 'not a url' | $adaparse -g href"
+
+          # argv: reachable only behind a pty, hence script(1).
+          check 'argv -g host behind a pty' \
+            'example.com:8080' 0 \
+            "script -qec \"$adaparse -g host https://example.com:8080/a\" /dev/null"
+          check 'argv rejects an invalid URL with status 1' \
+            'Invalid URL: notaurl' 1 \
+            "script -qec \"$adaparse -g host notaurl\" /dev/null"
+          check 'argv -o writes the result to the named file' \
+            'https://example.com/a' 0 \
+            "script -qec \"$adaparse -g href -o cli-out.txt https://example.com/a\" /dev/null >/dev/null && cat cli-out.txt"
+
+          exit $fail
diff --git a/.github/workflows/avx512-compile.yml b/.github/workflows/avx512-compile.yml
new file mode 100644
index 00000000..3ccd2f87
--- /dev/null
+++ b/.github/workflows/avx512-compile.yml
@@ -0,0 +1,93 @@
+name: AVX-512 compile
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+    paths-ignore:
+      - '**.md'
+      - 'docs/**'
+  push:
+    branches:
+      - main
+    paths-ignore:
+      - '**.md'
+      - 'docs/**'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  # The AVX-512 kernels in include/ada/checkers-inl.h (IPv4) and
+  # include/ada/url_ip-inl.h (IPv6) are selected by __AVX512BW__/__AVX512VL__
+  # plus VBMI2, and no other job in this repository passes those flags: every
+  # other build uses the default -march, so both kernels are preprocessed away
+  # and a compile error inside them reaches main unseen.
+  #
+  # This job compiles src/ada.cpp under each flag combination that selects a
+  # kernel. It first asserts which kernels the flags actually select, because
+  # a combination that stopped reaching them would otherwise keep passing over
+  # code it no longer compiles. Compile only: GitHub's hosted runners are not
+  # guaranteed to have an AVX-512 CPU, so executing the kernels here would be
+  # a coin flip rather than a check.
+  avx512:
+    name: ${{ matrix.cxx }} ${{ matrix.target.name }}
+    runs-on: ubuntu-24.04
+    strategy:
+      fail-fast: false
+      matrix:
+        cxx: [g++, clang++]
+        target:
+          - name: bw+vl
+            flags: -mavx512bw -mavx512vl
+            ipv4: 'no'
+            ipv6: 'no'
+          - name: bw+vl+vbmi2
+            flags: -mavx512bw -mavx512vl -mavx512vbmi2
+            ipv4: 'yes'
+            ipv6: 'no'
+          - name: bw+vl+vbmi+vbmi2
+            flags: -mavx512bw -mavx512vl -mavx512vbmi -mavx512vbmi2
+            ipv4: 'yes'
+            ipv6: 'yes'
+          - name: x86-64-v4
+            flags: -march=x86-64-v4
+            ipv4: 'no'
+            ipv6: 'no'
+          - name: icelake-server
+            flags: -march=icelake-server
+            ipv4: 'yes'
+            ipv6: 'yes'
+          - name: sapphirerapids
+            flags: -march=sapphirerapids
+            ipv4: 'yes'
+            ipv6: 'yes'
+          - name: znver4
+            flags: -march=znver4
+            ipv4: 'yes'
+            ipv6: 'yes'
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Assert these flags select the expected kernels
+        run: |
+          printf '#include "ada/url_ip-inl.h"\n' > kernel-probe.cpp
+          ${{ matrix.cxx }} -std=c++20 -E -dM ${{ matrix.target.flags }} \
+            -I include kernel-probe.cpp > macros.txt
+          ipv4=no
+          ipv6=no
+          if grep -q '^#define ADA_AVX512 ' macros.txt &&
+             grep -q '^#define __AVX512VBMI2__ ' macros.txt; then ipv4=yes; fi
+          if grep -q '^#define ADA_AVX512_IPV6 ' macros.txt; then ipv6=yes; fi
+          echo "IPv4 kernel selected: $ipv4 (expected ${{ matrix.target.ipv4 }})"
+          echo "IPv6 kernel selected: $ipv6 (expected ${{ matrix.target.ipv6 }})"
+          test "$ipv4" = '${{ matrix.target.ipv4 }}'
+          test "$ipv6" = '${{ matrix.target.ipv6 }}'
+
+      - name: Compile src/ada.cpp
+        run: >
+          ${{ matrix.cxx }} -std=c++20 -O2 -c ${{ matrix.target.flags }}
+          -I include src/ada.cpp -o ada-avx512.o
