+def _pair_with_originals(
+    data: typing.Iterable, original_data: typing.Any
+) -> typing.Iterator[tuple[typing.Any, typing.Any]]:
+    """Pair each item with the raw input it came from, best-effort.
+
+    A ``pass_collection`` pre-load hook may change the item count or the shape:
+    filtering drops entries, and unwrapping an envelope leaves a mapping here
+    rather than a collection of items. So originals are paired positionally where
+    there is one and `None` where there is not. Iterating ``data`` rather than the
+    pair is what keeps a processor or a validator from being handed an item that
+    does not exist, and what keeps a mapping's keys from being mistaken for its
+    items. Any collection is paired, not only a registered `Sequence`: a set, a
+    `dict` view and an ORM queryset all reach `dump` as ``obj``.
+    """
+    originals = list(original_data) if is_collection(original_data) else []
+    for index, item in enumerate(data):
+        yield item, (originals[index] if index < len(originals) else None)
+
+
+def _lookup_value(dct: typing.Any, key: str) -> typing.Any:
+    """Read a value that `marshmallow.utils.set_value` wrote under ``key``.
+
+    Mirrors `set_value` and `_remove_value`: a dotted key is a path and only
+    mappings are traversed. Unlike `marshmallow.utils.get_value` this never falls
+    back to attribute access, so a field named after a `dict` method - ``items``,
+    ``keys``, ``values`` and the rest - reads as absent when it is absent, instead
+    of resolving to a bound method.
+    """
+    if not isinstance(dct, Mapping):
+        return missing
+    if "." in key:
+        head, rest = key.split(".", 1)
+        return _lookup_value(dct.get(head, missing), rest)
+    return dct.get(key, missing)
+
+
+def _remove_value(dct: dict[str, typing.Any], key: str) -> None:
+    """Remove a value that `marshmallow.utils.set_value` wrote under ``key``.
+
+    Mirrors `set_value`: a dotted key is a path, and a container left empty by the
+    removal goes with it, so the result matches what the mapping would hold had the
+    value never been written.
+    """
+    if "." in key:
+        head, rest = key.split(".", 1)
+        target = dct.get(head)
+        if isinstance(target, dict):
+            _remove_value(target, rest)
+            if not target:
+                del dct[head]
+    else:
+        dct.pop(key, None)
+
+
