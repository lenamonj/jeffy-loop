+        class D(Schema):
+            a = fields.Integer()
+
+            @post_dump(pass_original=True)
+            def tag(self, data, original, **kwargs):
+                return {**data, "orig": original}
+
+        assert D(many=True).dump([{"a": 1}, {"a": 2}]) == [
+            {"a": 1, "orig": {"a": 1}},
+            {"a": 2, "orig": {"a": 2}},
+        ]
+        assert D(many=True).dump(({"a": 1},)) == [{"a": 1, "orig": {"a": 1}}]
+
+    @pytest.mark.parametrize(
+        "field_name", [n for n in dir(dict) if not n.startswith("_")]
+    )
+    def test_absent_field_named_after_a_dict_method_is_not_validated(self, field_name):
+        """Looking the value back up must not fall back to attribute access: a field
+        named ``items`` or ``keys`` would otherwise resolve to a bound method of the
+        result mapping and be validated as though it had been supplied.
+        """
+        seen = []
+
+        schema_cls = type(
+            "S",
+            (Schema,),
+            {
+                field_name: fields.Raw(),
+                "check": validates(field_name)(
+                    lambda self, value, data_key: seen.append(value)
+                ),
+            },
+        )
+
+        assert schema_cls().load({}) == {}
+        assert seen == []
+
+    def test_field_named_after_a_dict_method_is_validated_when_supplied(self):
+        seen = []
+
+        class OrderSchema(Schema):
+            items = fields.List(fields.Str())
+
+            @validates("items")
+            def check_items(self, value, data_key):
+                seen.append(value)
+                if len(value) > 3:
+                    raise ValidationError("Too many items.")
+
+        assert OrderSchema().load({"items": ["a"]}) == {"items": ["a"]}
+        assert seen == [["a"]]
+        with pytest.raises(ValidationError):
+            OrderSchema().load({"items": ["a", "b", "c", "d"]})
+
+    def test_post_dump_pass_original_pairs_any_collection(self):
+        """``obj`` reaches ``dump`` as whatever the caller holds - a set, a dict view,
+        an ORM queryset - not only as a registered ``Sequence``.
+        """
+
+        class D(Schema):
+            a = fields.Integer()
+
+            @post_dump(pass_original=True)
+            def tag(self, data, original, **kwargs):
+                return {**data, "orig": original["a"]}
+
+        objs = [{"a": 1}, {"a": 2}]
+        expected = [{"a": 1, "orig": 1}, {"a": 2, "orig": 2}]
+
+        assert D(many=True).dump(objs) == expected
+        assert D(many=True).dump(tuple(objs)) == expected
+        assert D(many=True).dump({1: objs[0], 2: objs[1]}.values()) == expected
+
+        class QuerySet:
+            def __init__(self, items):
+                self._items = items
+
+            def __iter__(self):
+                return iter(self._items)
+
+        assert D(many=True).dump(QuerySet(objs)) == expected
