+// clusterStarts returns the byte offsets at which a grapheme cluster begins
+// in s, plus len(s), which is where the last cluster ends.
+func clusterStarts(s string) map[int]bool {
+	m := map[int]bool{len(s): true}
+	g := graphemes.FromString(s)
+	for g.Next() {
+		m[g.Start()] = true
+	}
+	return m
+}
+
+// TestWrapSplitsOnlyAtClusterBoundaries pins the contract that Wrap breaks
+// lines where StringWidth counts cells: between grapheme clusters, never
+// inside one. Wrap used to range over runes, so it split ZWJ sequences and
+// flag pairs and left a joiner dangling at the end of a line, and it
+// disagreed with StringWidth about how wide the same string was.
+func TestWrapSplitsOnlyAtClusterBoundaries(t *testing.T) {
+	family := "\U0001F468\u200D\U0001F469\u200D\U0001F466"
+	corpus := []string{
+		family + family,
+		"\U0001F1EF\U0001F1F5\U0001F1EF\U0001F1F5", // two regional-indicator flags
+		"e\u0301e\u0301e\u0301",                    // three combining clusters
+		"a\U0001F600b\U0001F600c",
+		"あいうえお",
+		"abcdefghij",
+	}
+	for _, s := range corpus {
+		starts := clusterStarts(s)
+		for w := 1; w <= 8; w++ {
+			got := Wrap(s, w)
+			// No input here contains a newline, so every newline in the
+			// output was inserted by Wrap.
+			off := 0
+			for i := 0; i < len(got); i++ {
+				if got[i] == '\n' {
+					if !starts[off] {
+						t.Errorf("Wrap(%q, %d) = %q broke at byte %d, which is inside a grapheme cluster", s, w, got, off)
+					}
+					continue
+				}
+				off++
+			}
+			if off != len(s) {
+				t.Errorf("Wrap(%q, %d) = %q kept %d bytes of a %d byte input", s, w, got, off, len(s))
+			}
+		}
+	}
+
+	// The two families are four cells wide, so at a budget of four they
+	// must not be split at all.
+	if got, want := StringWidth(family+family), 4; got != want {
+		t.Fatalf("StringWidth(two families) = %d, want %d", got, want)
+	}
+	if got, want := Wrap(family+family, 4), family+family; got != want {
+		t.Errorf("Wrap(two families, 4) = %q, want %q", got, want)
+	}
+}
+
+// TestWrapASCIIPathMatchesClusterPath is the differential that lets Wrap
+// keep an ASCII fast path at all: for every ASCII input the byte loop must
+// produce exactly what the grapheme walk produces, including for CRLF,
+// which is the one multi-rune cluster ASCII can form.
+func TestWrapASCIIPathMatchesClusterPath(t *testing.T) {
+	corpus := []string{
+		"", "a", "abc", "abcdefghij", "the quick brown fox",
+		"a\nb", "a\r\nb", "\r\n", "\n\n", "a\tb", "a\x7fb", "\x00\x01",
+		"line one\nline two\nline three", strings.Repeat("word ", 30),
+	}
+	c := NewCondition()
+	for _, s := range corpus {
+		for w := -1; w <= 12; w++ {
+			var ascii, clusters strings.Builder
+			c.wrapASCII(&ascii, s, w)
+			c.wrapClusters(&clusters, s, w)
+			if ascii.String() != clusters.String() {
+				t.Errorf("Wrap paths disagree on %q at w=%d: ascii %q, clusters %q",
+					s, w, ascii.String(), clusters.String())
+			}
+		}
+	}
+}
