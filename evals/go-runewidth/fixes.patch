+// TestREADMEExamples runs the README's usage examples exactly as they are
+// written there and asserts the values it states. The README claimed 12 for
+// the first example, which is the East Asian answer; the default condition
+// on any locale that is not CJK returns 11.
+//
+// The first example names a condition - a locale that is not CJK - so this
+// establishes it rather than inheriting whatever an earlier test left
+// behind. TestDefaultLUT leaves the package in East Asian mode, which is
+// RW-15; every global this touches is restored on the way out.
+func TestREADMEExamples(t *testing.T) {
+	const s = "\u3064\u306e\u3060\u2606HIRO"
+
+	savedGlobal, savedDefault := EastAsianWidth, DefaultCondition.EastAsianWidth
+	defer func() {
+		EastAsianWidth, DefaultCondition.EastAsianWidth = savedGlobal, savedDefault
+	}()
+	EastAsianWidth, DefaultCondition.EastAsianWidth = false, false
+
+	if got := StringWidth(s); got != 11 {
+		t.Errorf("README example one: StringWidth = %d, README says 11", got)
+	}
+
+	c := NewCondition()
+	c.EastAsianWidth = true
+	if got := c.StringWidth(s); got != 12 {
+		t.Errorf("README example two: c.StringWidth = %d, README says 12", got)
+	}
+
+	// The README also states what assigning to the package-level variable
+	// does not do, and a claim about the absence of an effect needs a
+	// check as much as one about its presence. Stated as before and after,
+	// which is what the claim says, rather than as a fixed number.
+	before := StringWidth(s)
+	EastAsianWidth = true
+	if after := StringWidth(s); after != before {
+		t.Errorf("assigning EastAsianWidth changed StringWidth from %d to %d; the README says it does not", before, after)
+	}
