+// TestWrapPreservesBytes pins that Wrap only ever inserts newlines. It used
+// to range over runes and re-encode with WriteRune, which turned every
+// undecodable byte into U+FFFD while StringWidth, Truncate, TruncateLeft
+// and TruncatePrefix all passed the same bytes through untouched.
+func TestWrapPreservesBytes(t *testing.T) {
+	for _, s := range []string{
+		"abc\xffdef", "\x80", "\xff\xff\xff", "\xed\xa0\x80", "\xc3",
+		"caf\xe9 latte", // Latin-1 e-acute, undecodable as UTF-8
+		"ok", "あ",
+	} {
+		for _, w := range []int{1, 2, 5} {
+			if got, want := strings.ReplaceAll(Wrap(s, w), "\n", ""), s; got != want {
+				t.Errorf("Wrap(%q, %d) stripped of newlines = %q, want %q", s, w, got, want)
+			}
+		}
+	}
+}
