+// TestTruncateAffixWiderThanBudget pins what Truncate and TruncatePrefix
+// document for a budget narrower than the caller's own affix: the affix
+// comes back whole, so the result is wider than w. Both are driven as the
+// enumeration behind that sentence, over a corpus at every width from 0 to
+// 12, because the claim generalises over every such case rather than over
+// the two examples the doc comments name.
+//
+// TruncateLeft is deliberately absent: its w counts cells to cut from the
+// front, not a budget the result must fit, so the contract does not apply
+// to it.
+func TestTruncateAffixWiderThanBudget(t *testing.T) {
+	c := &Condition{}
+
+	// The two examples the doc comments state.
+	if got := c.Truncate("abcdef", 0, "..."); got != "..." {
+		t.Errorf(`Truncate("abcdef", 0, "...") = %q, the doc comment says "..."`, got)
+	}
+	if got := c.TruncatePrefix("abcdef", 0, "..."); got != "..." {
+		t.Errorf(`TruncatePrefix("abcdef", 0, "...") = %q, the doc comment says "..."`, got)
+	}
+
+	inputs := []string{"", "a", "abcdef", "\u3064\u306e\u3060\u2606HIRO", "\u3042\u308a\u304c\u3068\u3046"}
+	affixes := []string{"", "-", "...", "\u2026", "ab", "\u3042\u3044"}
+
+	cases := 0
+	for _, in := range inputs {
+		for _, affix := range affixes {
+			aw := c.StringWidth(affix)
+			for w := 0; w <= 12; w++ {
+				// Truncate only reaches its tail when s does not already fit.
+				if aw > w && c.StringWidth(in) > w {
+					if got := c.Truncate(in, w, affix); got != affix {
+						t.Errorf("Truncate(%q, %d, %q) = %q, want the tail alone %q", in, w, affix, got, affix)
+					}
+					cases++
+				}
+				if aw >= w {
+					if got := c.TruncatePrefix(in, w, affix); got != affix {
+						t.Errorf("TruncatePrefix(%q, %d, %q) = %q, want the prefix alone %q", in, w, affix, got, affix)
+					}
+					cases++
+				}
+			}
+		}
+	}
+	if cases == 0 {
+		t.Fatal("the corpus produced no case where the affix does not fit; the enumeration proves nothing")
+	}
+
+	// The asymmetry the doc comments state: Truncate returns s untouched
+	// when s already fits, however wide the tail is, while TruncatePrefix
+	// tests its prefix first and so returns it even then.
+	if got := c.Truncate("a", 2, "\u3042\u3044"); got != "a" {
+		t.Errorf(`Truncate("a", 2, "\u3042\u3044") = %q, want "a": s already fits, so the tail is never used`, got)
+	}
+	if got := c.TruncatePrefix("a", 2, "\u3042\u3044"); got != "\u3042\u3044" {
+		t.Errorf(`TruncatePrefix("a", 2, "\u3042\u3044") = %q, want the prefix: the prefix test precedes the fits-already test`, got)
+	}
+
+	// And the consequence the doc comments name: the result is then wider
+	// than the budget, which is the surprise a caller has to know about.
+	if got := c.Truncate("abcdef", 0, "..."); c.StringWidth(got) <= 0 {
+		t.Errorf("Truncate returned %q of width %d; the doc comment says the width exceeds w", got, c.StringWidth(got))
+	}
+}
