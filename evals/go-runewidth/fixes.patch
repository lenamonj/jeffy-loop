+	// them, so a Condition built after the assignment honours it.
+	c := NewCondition()
+	if c.EastAsianWidth != EastAsianWidth || c.StrictEmojiNeutral != StrictEmojiNeutral || c.ZeroWidthJoiner != ZeroWidthJoiner {
+		t.Errorf("NewCondition() = {%v %v %v}, want the package variables {%v %v %v}",
+			c.EastAsianWidth, c.StrictEmojiNeutral, c.ZeroWidthJoiner,
+			EastAsianWidth, StrictEmojiNeutral, ZeroWidthJoiner)
+	}
+	want := 1
+	if c.EastAsianWidth {
+		want = 2
+	}
+	if got := c.RuneWidth(ambiguous); got != want {
+		t.Errorf("NewCondition().RuneWidth = %d, want %d: the Condition built after the assignment measures by the new value", got, want)
+	}
+}
