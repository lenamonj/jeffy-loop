+// TestWrapBudgetOverInvalidUTF8 pins that no wrapped line exceeds its
+// budget when a grapheme cluster carries content on either side of a line
+// break. The segmenter joins a break to a truncated multi-byte sequence
+// before it as well as after it, so "caf\xe9\n" segments as "c", "a",
+// "f\xe9\n"; writing such a cluster whole put four columns on a line
+// budgeted at three. Every check here is over invalid UTF-8, which is
+// exactly what the existing wrap tests did not cover.
+func TestWrapBudgetOverInvalidUTF8(t *testing.T) {
+	c := &Condition{EastAsianWidth: false, StrictEmojiNeutral: true}
+
+	var corpus []string
+	for b := 0x80; b <= 0xFF; b++ {
+		x := string([]byte{byte(b)})
+		corpus = append(corpus,
+			"caf"+x+"\n", "caf\n"+x, x+"\ncaf", "ab"+x+"de\nfg",
+			"\n"+x+"\n", x+"\n"+x, "caf"+x+"\r\ndef")
+	}
+
+	for _, s := range corpus {
+		for w := 2; w <= 6; w++ {
+			got := c.Wrap(s, w)
+			if stripped, want := strings.ReplaceAll(got, "\n", ""), strings.ReplaceAll(s, "\n", ""); stripped != want {
+				t.Fatalf("Wrap(%q, %d) = %q, newline-stripped %q, want %q", s, w, got, stripped, want)
+			}
+			for _, line := range strings.Split(got, "\n") {
+				if lw := c.StringWidth(line); lw > w {
+					t.Fatalf("Wrap(%q, %d) = %q: the line %q is %d columns, over a budget of %d", s, w, got, line, lw, w)
+				}
+			}
+		}
+	}
+
+	// The two cases the gate reproduced, as known answers.
+	if got, want := c.Wrap("caf\xe9\n", 3), "ca\nf\xe9\n"; got != want {
+		t.Errorf("Wrap(%q, 3) = %q, want %q", "caf\xe9\n", got, want)
+	}
+	if got, want := c.Wrap("r\xe9sum\xe9\n", 4), "r\xe9su\nm\xe9\n"; got != want {
+		t.Errorf("Wrap(%q, 4) = %q, want %q", "r\xe9sum\xe9\n", got, want)
+	}
+}
