+// TestFillSidesMatchTheirDocComments pins which side each fill pads, which
+// is what their doc comments now say and what they did not say before: both
+// carried the sentence "filled in left", so the documentation gave a caller
+// no way to tell the two apart and described FillRight wrongly.
+//
+// The per-case assertions are backed by the enumeration behind the claim,
+// over a corpus at every width, because the sentence generalises over all of
+// them rather than over the two examples the comments name.
+func TestFillSidesMatchTheirDocComments(t *testing.T) {
+	c := &Condition{}
+
+	// The examples both doc comments state.
+	if got, want := c.FillLeft("a", 6), "     a"; got != want {
+		t.Errorf("FillLeft(%q, 6) = %q, want %q: the spaces go before s", "a", got, want)
+	}
+	if got, want := c.FillRight("a", 6), "a     "; got != want {
+		t.Errorf("FillRight(%q, 6) = %q, want %q: the spaces go after s", "a", got, want)
+	}
+	// The no-op case they also state: wider than w rather than truncated.
+	for _, f := range []struct {
+		name string
+		fn   func(string, int) string
+	}{{"FillLeft", c.FillLeft}, {"FillRight", c.FillRight}} {
+		if got := f.fn("abcdef", 2); got != "abcdef" {
+			t.Errorf("%s(%q, 2) = %q, want the input unchanged", f.name, "abcdef", got)
+		}
+	}
+	// Padding is counted in cells, not bytes or runes.
+	if got, want := c.FillLeft("\u3042", 5), "   \u3042"; got != want {
+		t.Errorf("FillLeft(%q, 5) = %q, want %q: a wide rune occupies two of the five cells", "\u3042", got, want)
+	}
+
+	// The enumeration: for every input and width, FillLeft is padding then s
+	// and FillRight is s then padding, with the padding exactly the cells the
+	// input leaves short.
+	for _, in := range []string{"", "a", "abcdef", "\u3042\u3044", "\u00e9", "\xe0\xa0"} {
+		for w := -3; w <= 10; w++ {
+			pad := w - c.StringWidth(in)
+			if pad < 0 {
+				pad = 0
+			}
+			spaces := strings.Repeat(" ", pad)
+			if got, want := c.FillLeft(in, w), spaces+in; got != want {
+				t.Errorf("FillLeft(%q, %d) = %q, want %q", in, w, got, want)
+			}
+			if got, want := c.FillRight(in, w), in+spaces; got != want {
+				t.Errorf("FillRight(%q, %d) = %q, want %q", in, w, got, want)
+			}
+		}
+	}
+}
