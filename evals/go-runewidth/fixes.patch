+// TestWrapNewlineClusterResetsColumn pins that a line break resets the
+// column even when the segmenter hands the break back glued to whatever
+// follows it. uax29 returns "\n" joined to a following truncated
+// multi-byte sequence as a single cluster, so matching the whole cluster
+// against "\n" missed the break, the column never reset, and Wrap inserted
+// a line break the input never asked for.
+func TestWrapNewlineClusterResetsColumn(t *testing.T) {
+	// An explicit condition, not the package-level function: the byte that
+	// follows the newline decodes to U+FFFD, which is East Asian
+	// Ambiguous and so one cell here but two under the East Asian widths.
+	// TestDefaultLUT leaves the package in that mode (RW-15), so a test
+	// that read the ambient default would pass alone and fail in a full
+	// run.
+	c := &Condition{EastAsianWidth: false, StrictEmojiNeutral: true}
+
+	// "abcde" is exactly the budget, and what follows the newline is one
+	// cell, so nothing may be inserted.
+	if got, want := c.Wrap("abcde\n\xed", 5), "abcde\n\xed"; got != want {
+		t.Errorf("Wrap(%q, 5) = %q, want %q", "abcde\n\xed", got, want)
+	}
+
+	// Every lead byte that can begin a multi-byte sequence, truncated.
+	for b := 0xC2; b <= 0xF7; b++ {
+		s := "abcde\n" + string([]byte{byte(b)})
+		got := c.Wrap(s, 5)
+		if got != s {
+			t.Errorf("Wrap(%q, 5) = %q, want the input unchanged", s, got)
+		}
+		if strings.Contains(got, "\n\n") {
+			t.Errorf("Wrap(%q, 5) = %q inserted an empty line", s, got)
+		}
+	}
+
+	// The column resets to the width of whatever shares the cluster with
+	// the break, not to zero: the invalid byte already occupies one cell
+	// of the new line, so the break before z falls one character earlier
+	// than it would if the reset were to zero.
+	if got, want := c.Wrap("abcde\n\xedxyz", 3), "abc\nde\n\xedxy\nz"; got != want {
+		t.Errorf("Wrap(%q, 3) = %q, want %q", "abcde\n\xedxyz", got, want)
+	}
+}
