+    // so every Convert.To* path in the comparison cascade used to throw
+    // InvalidCastException when a boxed Half met a numeric of any other type. That
+    // is 22 pairings - eleven other numeric types, either operand position - and all
+    // of them crashed out of the library rather than returning a verdict. See SH-001.
+
+    public static TheoryData<object> OtherNumericOne() =>
+    [
+        1.0d, 1.0f, 1.0m, 1, 1u, 1L, 1UL, (short)1, (ushort)1, (byte)1, (sbyte)1
+    ];
+
+    [Theory]
+    [MemberData(nameof(OtherNumericOne))]
+    public void MixedWithAnotherNumericType_ComparesEqualWhenNumericallyEqual(object other)
+    {
+        object half = (Half)1;
+
+        half.ShouldBe(other);
+        other.ShouldBe(half);
+    }
+
+    [Theory]
+    [MemberData(nameof(OtherNumericOne))]
+    public void MixedWithAnotherNumericType_ComparesUnequalWhenNumericallyDifferent(object other)
+    {
+        object half = (Half)2;
+
+        Should.Throw<ShouldAssertException>(() => half.ShouldBe(other));
+        Should.Throw<ShouldAssertException>(() => other.ShouldBe(half));
+    }
+
+    [Fact]
+    public void MixedWithAnotherNumericType_HonoursFractionalValues()
+    {
+        object half = (Half)1.5f;
+
+        half.ShouldBe((object)1.5d);
+        half.ShouldBe((object)1.5f);
+        Should.Throw<ShouldAssertException>(() => half.ShouldBe((object)1));
+        Should.Throw<ShouldAssertException>(() => half.ShouldBe((object)1.6f));
+    }
+
+    [Fact]
+    public void MixedWithAnotherNumericType_HonoursNegativeValues()
+    {
+        object half = (Half)(-2);
+
+        half.ShouldBe((object)(-2));
+        Should.Throw<ShouldAssertException>(() => half.ShouldBe((object)2));
+    }
+
+    [Fact]
+    public void MixedWithAnotherNumericType_KeepsNaNAndInfinitySemantics()
+    {
+        ((object)Half.NaN).ShouldBe((object)double.NaN);
+        ((object)Half.PositiveInfinity).ShouldBe((object)double.PositiveInfinity);
+        Should.Throw<ShouldAssertException>(() => ((object)Half.PositiveInfinity).ShouldBe((object)1.0d));
+    }
+
+    [Fact]
+    public void MixedWithAnotherNumericType_WorksInsideCollections()
+    {
+        new object[] { (Half)1 }.ShouldBe(new object[] { 1.0f });
+        Should.Throw<ShouldAssertException>(() => new object[] { (Half)1 }.ShouldBe(new object[] { 2.0f }));
+    }
+
+    [Fact]
+    public void MixedWithAnotherNumericType_WorksForShouldNotBe()
+    {
+        object half = (Half)1;
+
+        half.ShouldNotBe((object)2);
+        Should.Throw<ShouldAssertException>(() => half.ShouldNotBe((object)1));
+    }
 }
 
