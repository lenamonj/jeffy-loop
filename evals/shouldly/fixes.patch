diff --git a/src/Shouldly/MessageGenerators/DictionaryMessageLookup.cs b/src/Shouldly/MessageGenerators/DictionaryMessageLookup.cs
new file mode 100644
index 00000000..5b7556cc
--- /dev/null
+++ b/src/Shouldly/MessageGenerators/DictionaryMessageLookup.cs
@@ -0,0 +1,81 @@
+namespace Shouldly.MessageGenerators;
+
+/// <summary>
+/// Looks a key up in the value the dictionary assertions were handed, for the sole purpose of
+/// formatting their failure message.
+/// </summary>
+/// <remarks>
+/// The dictionary assertions accept <see cref="IEnumerable{T}"/> of <see cref="KeyValuePair{TKey,TValue}"/>
+/// (see the comment in <c>ShouldBeDictionaryTestExtensions</c>), which is deliberately wider than the
+/// non-generic <see cref="IDictionary"/>: a <c>List&lt;KeyValuePair&lt;,&gt;&gt;</c>, an array of pairs and any
+/// LINQ projection over a dictionary all satisfy it without implementing <see cref="IDictionary"/>. The
+/// message generators used to cast to <see cref="IDictionary"/> outright, which turned every failure over
+/// one of those shapes into an <see cref="InvalidCastException"/> — and only on the failing path, so the
+/// assertion looked healthy right up to the moment it was supposed to report a problem. See SH-005.
+/// </remarks>
+static class DictionaryMessageLookup
+{
+    /// <summary>
+    /// Returns whether <paramref name="key"/> is present in <paramref name="actual"/>, and its value when it is.
+    /// </summary>
+    public static bool TryGetValue(object? actual, object key, out object? value)
+    {
+        // Fast path, and the one that preserves the dictionary's own key comparer: every BCL
+        // dictionary reaches this branch, so their messages are produced exactly as before.
+        if (actual is IDictionary dictionary)
+        {
+            if (dictionary.Contains(key))
+            {
+                value = dictionary[key];
+                return true;
+            }
+
+            value = null;
+            return false;
+        }
+
+        if (actual is IEnumerable sequence)
+        {
+            foreach (var entry in sequence)
+            {
+                if (entry == null)
+                    continue;
+
+                if (TryReadPair(entry, out var entryKey, out var entryValue) && Equals(entryKey, key))
+                {
+                    value = entryValue;
+                    return true;
+                }
+            }
+        }
+
+        value = null;
+        return false;
+    }
+
+    // The element is a boxed KeyValuePair<TKey, TValue> whose closed generic type is already
+    // constructed by the caller, so its Key and Value properties are read off that type directly —
+    // no MakeGenericType, and nothing that native AOT cannot resolve. The same shape is used by
+    // ReflectionShapeProvider for dictionary entries.
+    [UnconditionalSuppressMessage("Trimming", "IL2075",
+        Justification = "Targets KeyValuePair<TKey, TValue> — a BCL type whose public Key and Value properties are part of its stable contract and preserved by the trimmer.")]
+    private static bool TryReadPair(object entry, out object? key, out object? value)
+    {
+        var type = entry.GetType();
+        if (type.IsGenericType && type.GetGenericTypeDefinition() == typeof(KeyValuePair<,>))
+        {
+            var keyProperty = type.GetProperty(nameof(KeyValuePair<int, int>.Key));
+            var valueProperty = type.GetProperty(nameof(KeyValuePair<int, int>.Value));
+            if (keyProperty != null && valueProperty != null)
+            {
+                key = keyProperty.GetValue(entry);
+                value = valueProperty.GetValue(entry);
+                return true;
+            }
+        }
+
+        key = null;
+        value = null;
+        return false;
+    }
+}
