+/// Read sixteen bytes out of a sequence.
+///
+/// Both visitors need this. A format that has no dedicated byte string type
+/// encodes `serialize_bytes` as a sequence of integers, so a visitor that only
+/// implements `visit_bytes` cannot read back what this crate wrote.
+fn visit_seq_of_bytes<'de, T: UuidDeserialize, A: de::SeqAccess<'de>>(
+    mut seq: A,
+    expecting: &dyn de::Expected,
+) -> Result<T, A::Error> {
+    let mut bytes = Bytes::default();
+
+    for (index, byte) in bytes.iter_mut().enumerate() {
+        match seq.next_element()? {
+            Some(value) => *byte = value,
+            None => return Err(A::Error::invalid_length(index, expecting)),
+        }
+    }
+
+    T::from_bytes(bytes).map_err(de_error)
+}
