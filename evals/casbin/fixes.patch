+// validateGroupingChange checks the constraints against the grouping policy that
+// a pending change would produce, before any of it is written. Validating after
+// the change was applied left a rejected rule in the model, in the role links
+// and in the adapter, so the refusal was reported while the assignment it
+// refused stayed in force.
+//
+// The constraint engine reads the "g" ptype, so a change to any other grouping
+// type leaves the policy it validates untouched.
+func (e *Enforcer) validateGroupingChange(sec string, ptype string, removed [][]string, added [][]string) error {
+	if sec != "g" || len(e.model["c"]) == 0 {
+		return nil
+	}
+
+	gAssertion := e.model["g"]["g"]
+	if ptype != "g" || gAssertion == nil {
+		return e.model.ValidateConstraints()
+	}
+
+	drop := make(map[string]struct{}, len(removed))
+	for _, rule := range removed {
+		drop[strings.Join(rule, model.DefaultSep)] = struct{}{}
+	}
+
+	candidate := make([][]string, 0, len(gAssertion.Policy)+len(added))
+	for _, rule := range gAssertion.Policy {
+		if _, ok := drop[strings.Join(rule, model.DefaultSep)]; !ok {
+			candidate = append(candidate, rule)
+		}
+	}
+	candidate = append(candidate, added...)
+
+	return e.model.ValidateConstraintsWithPolicy(candidate)
 }
 
