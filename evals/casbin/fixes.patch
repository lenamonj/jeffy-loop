+// RemovePolicy used to set the whole stored string to "", so removing one rule
+// destroyed every other rule the adapter held and the next load failed outright.
+func Test_RemovePolicyKeepsTheOtherRules(t *testing.T) {
+	conf := `
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _ , _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`
+	a := NewAdapter("p, alice, data1, read\np, bob, data2, write\np, carol, data3, read\ng, alice, admin")
+
+	newEnforcer := func() *casbin.Enforcer {
+		t.Helper()
+		m := model.NewModel()
+		if err := m.LoadModelFromText(conf); err != nil {
+			t.Fatalf("load model: %v", err)
+		}
+		e, err := casbin.NewEnforcer(m, a)
+		if err != nil {
+			t.Fatalf("new enforcer: %v", err)
+		}
+		return e
+	}
+
+	e := newEnforcer()
+	if ok, err := e.RemovePolicy("alice", "data1", "read"); !ok || err != nil {
+		t.Fatalf("RemovePolicy: %v, %v", ok, err)
+	}
+
+	// What a restart sees.
+	reloaded := newEnforcer()
+	for _, c := range []struct {
+		sub, obj, act string
+		res           bool
+	}{
+		{"alice", "data1", "read", false},
+		{"bob", "data2", "write", true},
+		{"carol", "data3", "read", true},
+	} {
+		got, err := reloaded.Enforce(c.sub, c.obj, c.act)
+		if err != nil {
+			t.Fatalf("Enforce: %v", err)
+		}
+		if got != c.res {
+			t.Errorf("after reload: %s, %s, %s: %t, supposed to be %t (stored: %q)", c.sub, c.obj, c.act, got, c.res, a.Line)
+		}
+	}
+
+	// The grouping rule is untouched too.
+	if !strings.Contains(a.Line, "g, alice, admin") {
+		t.Errorf("the grouping rule was dropped: %q", a.Line)
+	}
+}
+
+// An empty policy is a state this adapter can reach - SavePolicy writes it for
+// an empty model, and RemovePolicy leaves it once the last rule is gone - so
+// loading it has to work rather than fail as a malformed line.
+func Test_EmptyPolicyLoads(t *testing.T) {
+	conf := `
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = r.sub == p.sub && r.obj == p.obj && r.act == p.act
+`
+	a := NewAdapter("p, alice, data1, read")
+	m := model.NewModel()
+	if err := m.LoadModelFromText(conf); err != nil {
+		t.Fatalf("load model: %v", err)
+	}
+	e, err := casbin.NewEnforcer(m, a)
+	if err != nil {
+		t.Fatalf("new enforcer: %v", err)
+	}
+	if ok, err := e.RemovePolicy("alice", "data1", "read"); !ok || err != nil {
+		t.Fatalf("RemovePolicy: %v, %v", ok, err)
+	}
+	if a.Line != "" {
+		t.Fatalf("the stored policy should be empty, got %q", a.Line)
+	}
+
+	m2 := model.NewModel()
+	if err := m2.LoadModelFromText(conf); err != nil {
+		t.Fatalf("load model: %v", err)
+	}
+	e2, err := casbin.NewEnforcer(m2, a)
+	if err != nil {
+		t.Fatalf("an emptied policy should still load: %v", err)
+	}
+	if got, err := e2.Enforce("alice", "data1", "read"); err != nil || got {
+		t.Errorf("alice, data1, read: %t, %v, supposed to be false", got, err)
+	}
+}
