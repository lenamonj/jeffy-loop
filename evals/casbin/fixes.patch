+// TestDefinedPtypeStillResolves is the guard on the fix above: the check that
+// rejects an undefined ptype must not reject a defined one, and the second
+// policy type is where a check written only against "p" would show.
+func TestDefinedPtypeStillResolves(t *testing.T) {
+	m, err := model.NewModelFromString(`
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+p2 = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e, err := NewEnforcer(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.AddNamedPolicy("p2", "alice", "data1", "read"); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, ptype := range []string{"p", "p2"} {
+		index, err := e.GetFieldIndex(ptype, "sub")
+		if err != nil || index != 0 {
+			t.Errorf("GetFieldIndex(%q, sub): got %d, %v, want 0 and no error", ptype, index, err)
+		}
+	}
+
+	testStringList(t, "GetAllNamedSubjects(p2)",
+		func() ([]string, error) { return e.GetAllNamedSubjects("p2") }, []string{"alice"})
+
+	e.SetFieldIndex("p2", "dom", 1)
+	index, err := e.GetFieldIndex("p2", "dom")
+	if err != nil || index != 1 {
+		t.Errorf("SetFieldIndex on a defined ptype: got %d, %v, want 1 and no error", index, err)
+	}
+}
