 }
+
+// The synced cache carries the same request keyed shape as the unsynced one,
+// so the same policy changes have to drop it.
+func TestSyncCacheInvalidatedByPolicyChange(t *testing.T) {
+	e, err := NewSyncedCachedEnforcer("examples/rbac_model.conf", "examples/rbac_policy.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	testSyncEnforceCache(t, e, "alice", "data2", "read", true)
+
+	if ok, err := e.RemovePolicy("data2_admin", "data2", "read"); !ok || err != nil {
+		t.Fatalf("RemovePolicy: %v, %v", ok, err)
+	}
+	testSyncEnforceCache(t, e, "alice", "data2", "read", false)
+
+	testSyncEnforceCache(t, e, "dave", "data3", "read", false)
+	if ok, err := e.AddPolicy("dave", "data3", "read"); !ok || err != nil {
+		t.Fatalf("AddPolicy: %v, %v", ok, err)
+	}
+	testSyncEnforceCache(t, e, "dave", "data3", "read", true)
+
+	testSyncEnforceCache(t, e, "alice", "data2", "write", true)
+	if ok, err := e.RemoveGroupingPolicy("alice", "data2_admin"); !ok || err != nil {
+		t.Fatalf("RemoveGroupingPolicy: %v, %v", ok, err)
+	}
+	testSyncEnforceCache(t, e, "alice", "data2", "write", false)
+}
diff --git a/enforcer_cached_test.go b/enforcer_cached_test.go
index b404b65..8a597a5 100644
--- a/enforcer_cached_test.go
+++ b/enforcer_cached_test.go
@@ -74,3 +74,38 @@ func TestCache(t *testing.T) {
 	testEnforceCache(t, e, "alice", "data2", "read", false)
 	testEnforceCache(t, e, "alice", "data2", "write", false)
 }
+
+// The decision cache is keyed by request, so a policy change that decides a
+// request other than the changed rule itself - a role's permission, a role
+// assignment, a newly granted rule - has to drop the cache too. Before the
+// policy changed callback existed, only the exact request tuple named by
+// RemovePolicy was dropped, so alice kept her revoked access.
+func TestCacheInvalidatedByPolicyChange(t *testing.T) {
+	e, err := NewCachedEnforcer("examples/rbac_model.conf", "examples/rbac_policy.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// alice reaches data2 through the data2_admin role.
+	testEnforceCache(t, e, "alice", "data2", "read", true)
+
+	// Revoking the role's permission revokes alice's access.
+	if ok, err := e.RemovePolicy("data2_admin", "data2", "read"); !ok || err != nil {
+		t.Fatalf("RemovePolicy: %v, %v", ok, err)
+	}
+	testEnforceCache(t, e, "alice", "data2", "read", false)
+
+	// Granting a rule after the denial was cached grants access.
+	testEnforceCache(t, e, "dave", "data3", "read", false)
+	if ok, err := e.AddPolicy("dave", "data3", "read"); !ok || err != nil {
+		t.Fatalf("AddPolicy: %v, %v", ok, err)
+	}
+	testEnforceCache(t, e, "dave", "data3", "read", true)
+
+	// Removing the role assignment revokes what the role granted.
+	testEnforceCache(t, e, "alice", "data2", "write", true)
+	if ok, err := e.RemoveGroupingPolicy("alice", "data2_admin"); !ok || err != nil {
+		t.Fatalf("RemoveGroupingPolicy: %v, %v", ok, err)
+	}
+	testEnforceCache(t, e, "alice", "data2", "write", false)
+}
