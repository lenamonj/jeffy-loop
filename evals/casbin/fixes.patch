+// TestMixedCaseNamesAreReadable pins CAS-12: a section or option carrying an
+// uppercase letter parsed without complaint and could then never be read back,
+// because the parser stored the name as written while get and Set lower-case the
+// whole key. Every reader is driven, not just String, because they share one
+// lookup and a fix that reached only the one under test would look complete.
+func TestMixedCaseNamesAreReadable(t *testing.T) {
+	c, err := NewConfigFromText(`
+[Section]
+MixedKey = value
+FlagKey = true
+CountKey = 42
+
+[lower]
+plain = ok
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Both spellings of the same key resolve, which is what "the lookup
+	// lower-cases the key" has always promised callers.
+	for _, key := range []string{"Section::MixedKey", "section::mixedkey", "SECTION::MIXEDKEY"} {
+		if v := c.String(key); v != "value" {
+			t.Errorf("String(%q): got %q, want %q", key, v, "value")
+		}
+	}
+
+	if v, err := c.Bool("Section::FlagKey"); err != nil || !v {
+		t.Errorf("Bool(Section::FlagKey): got %v, %v, want true and no error", v, err)
+	}
+	if v, err := c.Int("Section::CountKey"); err != nil || v != 42 {
+		t.Errorf("Int(Section::CountKey): got %v, %v, want 42 and no error", v, err)
+	}
+
+	// A name that was already lower-case still reads, so the fix cannot have
+	// been bought by changing where the lookup looks.
+	if v := c.String("lower::plain"); v != "ok" {
+		t.Errorf("String(lower::plain): got %q, want %q", v, "ok")
+	}
+
+	// Set writes through the same store, so a mixed-case key it writes reads
+	// back under either spelling too.
+	if err := c.Set("Section::WrittenKey", "written"); err != nil {
+		t.Fatal(err)
+	}
+	if v := c.String("section::writtenkey"); v != "written" {
+		t.Errorf("String after Set: got %q, want %q", v, "written")
+	}
+	if v := c.String("Section::WrittenKey"); v != "written" {
+		t.Errorf("String after Set, as written: got %q, want %q", v, "written")
+	}
+}
