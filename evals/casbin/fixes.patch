+// TestBaseAdapterSurvivesEveryEditPath drives every entry point that reaches an
+// optional adapter capability. An adapter that implements only persist.Adapter
+// must degrade to an in-memory edit, exactly as one answering "not implemented"
+// already does, rather than panic on an interface conversion.
+func TestBaseAdapterSurvivesEveryEditPath(t *testing.T) {
+	cases := []struct {
+		name string
+		call func(*Enforcer) error
+	}{
+		{"AddPolicies", func(e *Enforcer) error { _, err := e.AddPolicies([][]string{{"x", "d", "read"}}); return err }},
+		{"AddPoliciesEx", func(e *Enforcer) error { _, err := e.AddPoliciesEx([][]string{{"x", "d", "read"}}); return err }},
+		{"RemovePolicies", func(e *Enforcer) error {
+			_, err := e.RemovePolicies([][]string{{"alice", "data1", "read"}})
+			return err
+		}},
+		{"UpdatePolicy", func(e *Enforcer) error {
+			_, err := e.UpdatePolicy([]string{"alice", "data1", "read"}, []string{"alice", "data2", "read"})
+			return err
+		}},
+		{"UpdatePolicies", func(e *Enforcer) error {
+			_, err := e.UpdatePolicies([][]string{{"alice", "data1", "read"}}, [][]string{{"alice", "data2", "read"}})
+			return err
+		}},
+		{"UpdateFilteredPolicies", func(e *Enforcer) error {
+			_, err := e.UpdateFilteredPolicies([][]string{{"alice", "data2", "read"}}, 0, "alice")
+			return err
+		}},
+		{"AddGroupingPolicies", func(e *Enforcer) error {
+			_, err := e.AddGroupingPolicies([][]string{{"carol", "alice"}})
+			return err
+		}},
+		{"RemoveGroupingPolicies", func(e *Enforcer) error {
+			_, err := e.RemoveGroupingPolicies([][]string{{"bob", "alice"}})
+			return err
+		}},
+		{"UpdateGroupingPolicy", func(e *Enforcer) error {
+			_, err := e.UpdateGroupingPolicy([]string{"bob", "alice"}, []string{"bob", "root"})
+			return err
+		}},
+		{"SelfAddPolicies", func(e *Enforcer) error {
+			_, err := e.SelfAddPolicies("p", "p", [][]string{{"y", "d", "read"}})
+			return err
+		}},
+		{"SelfAddPoliciesEx", func(e *Enforcer) error {
+			_, err := e.SelfAddPoliciesEx("p", "p", [][]string{{"y", "d", "read"}})
+			return err
+		}},
+		{"SelfRemovePolicies", func(e *Enforcer) error {
+			_, err := e.SelfRemovePolicies("p", "p", [][]string{{"alice", "data1", "read"}})
+			return err
+		}},
+		{"SelfUpdatePolicy", func(e *Enforcer) error {
+			_, err := e.SelfUpdatePolicy("p", "p", []string{"alice", "data1", "read"}, []string{"alice", "data2", "read"})
+			return err
+		}},
+		{"SelfUpdatePolicies", func(e *Enforcer) error {
+			_, err := e.SelfUpdatePolicies("p", "p", [][]string{{"alice", "data1", "read"}}, [][]string{{"alice", "data2", "read"}})
+			return err
+		}},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if err := c.call(stringAdapterEnforcer(t)); err != nil {
+				t.Errorf("%s over a base adapter: %v", c.name, err)
+			}
+		})
+	}
+}
