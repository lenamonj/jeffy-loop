+// addRuleIfAbsent adds a rule unless the model already holds it. Model.AddPolicy
+// appends without checking, and at commit these operations are applied to the
+// model as it stands then, which may already hold a rule another writer added
+// while the transaction was open.
+func addRuleIfAbsent(m model.Model, sec string, ptype string, rule []string) error {
+	has, err := m.HasPolicy(sec, ptype, rule)
+	if err != nil {
+		return err
+	}
+	if has {
+		return nil
+	}
+
+	return m.AddPolicy(sec, ptype, rule)
