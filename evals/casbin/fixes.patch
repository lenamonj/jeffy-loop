+func TestUpdateFilteredPoliciesReplacesMatchingRules(t *testing.T) {
+	e, err := NewEnforcer("examples/basic_model.conf", "examples/basic_policy.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.ClearPolicy()
+	for _, rule := range [][]string{
+		{"alice", "secret", "read"},
+		{"alice", "public", "read"},
+		{"bob", "data2", "write"},
+	} {
+		if _, err := e.AddPolicy(rule); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// Replacing alice's rules has to take the old ones out, not merely add the
+	// new one beside them: a caller doing this is revoking access.
+	ok, err := e.UpdateFilteredPolicies([][]string{{"alice", "reports", "read"}}, 0, "alice")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ok {
+		t.Error("UpdateFilteredPolicies reported no change, but two rules matched the filter")
+	}
+	testGetPolicy(t, e, [][]string{{"alice", "reports", "read"}, {"bob", "data2", "write"}})
+
+	allowed, err := e.Enforce("alice", "secret", "read")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if allowed {
+		t.Error("alice still has secret/read: the update did not revoke the rule it replaced")
+	}
+
+	// Replacing with nothing is a removal, and it is reported as a change.
+	ok, err = e.UpdateFilteredPolicies(nil, 0, "bob")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ok {
+		t.Error("UpdateFilteredPolicies reported no change, but it removed bob's only rule")
+	}
+	testGetPolicy(t, e, [][]string{{"alice", "reports", "read"}})
+}
