+// without recovery would report only its first crash - and the enumeration is
+// the evidence here, not any single case.
+func TestUndefinedPtypeIsReportedNotFatal(t *testing.T) {
+	const undefined = "nosuch"
+
+	build := func(t *testing.T) *Enforcer {
+		t.Helper()
+		e, err := NewEnforcer("examples/rbac_model.conf", "examples/rbac_policy.csv")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return e
+	}
+
+	// Every entry point that reached an unchecked assertion lookup, whether
+	// through model.GetFieldIndex or through one of its own.
+	cases := []struct {
+		name string
+		call func(e *Enforcer) error
+	}{
+		{"GetAllNamedSubjects", func(e *Enforcer) error {
+			_, err := e.GetAllNamedSubjects(undefined)
+			return err
+		}},
+		{"GetAllNamedObjects", func(e *Enforcer) error {
+			_, err := e.GetAllNamedObjects(undefined)
+			return err
+		}},
+		{"GetAllNamedActions", func(e *Enforcer) error {
+			_, err := e.GetAllNamedActions(undefined)
+			return err
+		}},
+		{"GetFieldIndex", func(e *Enforcer) error {
+			_, err := e.GetFieldIndex(undefined, "sub")
+			return err
+		}},
+		{"GetFilteredNamedPolicyWithMatcher", func(e *Enforcer) error {
+			_, err := e.GetFilteredNamedPolicyWithMatcher(undefined, "true")
+			return err
+		}},
+		{"GetNamedImplicitPermissionsForUser", func(e *Enforcer) error {
+			_, err := e.GetNamedImplicitPermissionsForUser(undefined, "g", "alice")
+			return err
+		}},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("%s panicked on an undefined ptype: %v", c.name, r)
+				}
+			}()
+			if err := c.call(build(t)); err == nil {
+				t.Errorf("%s accepted an undefined ptype and reported no error", c.name)
+			}
+		})
+	}
+
+	// SetFieldIndex returns nothing, so it can only be required not to crash
+	// and not to disturb the ptypes the model does define.
+	t.Run("SetFieldIndex", func(t *testing.T) {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Errorf("SetFieldIndex panicked on an undefined ptype: %v", r)
+			}
+		}()
+		e := build(t)
+		e.SetFieldIndex(undefined, "sub", 3)
+		index, err := e.GetFieldIndex("p", "sub")
+		if err != nil || index != 0 {
+			t.Errorf("the defined ptype was disturbed: got index %d, err %v, want 0 and no error", index, err)
+		}
+	})
+}
