+// countingRoleManager answers every link query the same way and counts the
+// calls, so "the installed manager decided this request" is observable rather
+// than inferred - a decision that merely looks right can still have come from
+// the manager the enforcer was constructed with.
+type countingRoleManager struct {
+	rbac.RoleManager
+	answer bool
+	calls  int
+}
+
+func (r *countingRoleManager) HasLink(name1, name2 string, domain ...string) (bool, error) {
+	r.calls++
+	return r.answer, nil
+}
+
+const setRoleManagerModel = `
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`
+
+func TestSetRoleManagerDecidesTheNextRequest(t *testing.T) {
+	m, err := model.NewModelFromString(setRoleManagerModel)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	e, err := NewEnforcer(m)
+	if err != nil {
+		t.Fatalf("enforcer: %v", err)
+	}
+	if _, err := e.AddPolicy("admin", "data1", "read"); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+
+	// alice holds no role, so only a role manager saying otherwise can grant
+	// her admin's permission.
+	if allowed, err := e.Enforce("alice", "data1", "read"); err != nil || allowed {
+		t.Fatalf("before the swap alice should be denied: %v, %v", allowed, err)
+	}
+
+	rm := &countingRoleManager{RoleManager: defaultrolemanager.NewRoleManagerImpl(10), answer: true}
+	e.SetRoleManager(rm)
+
+	allowed, err := e.Enforce("alice", "data1", "read")
+	if err != nil {
+		t.Fatalf("Enforce: %v", err)
+	}
+	if !allowed {
+		t.Error("the request was not decided through the manager just installed")
+	}
+	if rm.calls == 0 {
+		t.Error("the installed role manager was never consulted")
+	}
+	if e.GetRoleManager() != rbac.RoleManager(rm) {
+		t.Error("GetRoleManager does not return the manager that was installed")
+	}
+}
+
+func TestSetNamedRoleManagerDecidesTheNextRequest(t *testing.T) {
+	m, err := model.NewModelFromString(setRoleManagerModel)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	e, err := NewEnforcer(m)
+	if err != nil {
+		t.Fatalf("enforcer: %v", err)
+	}
+	if _, err := e.AddPolicy("admin", "data1", "read"); err != nil {
+		t.Fatalf("seed: %v", err)
+	}
+
+	rm := &countingRoleManager{RoleManager: defaultrolemanager.NewRoleManagerImpl(10), answer: true}
+	e.SetNamedRoleManager("g", rm)
+
+	allowed, err := e.Enforce("alice", "data1", "read")
+	if err != nil {
+		t.Fatalf("Enforce: %v", err)
+	}
+	if !allowed || rm.calls == 0 {
+		t.Errorf("the named manager did not decide the request: allowed=%v, consulted %d times", allowed, rm.calls)
+	}
+}
+
+// The consequence the finding names: an operator installing a shallower role
+// manager to cut transitive inheritance must get the narrower answer, not the
+// previous manager's.
+func TestSetRoleManagerHonoursAStricterManager(t *testing.T) {
+	m, err := model.NewModelFromString(setRoleManagerModel)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	e, err := NewEnforcer(m)
+	if err != nil {
+		t.Fatalf("enforcer: %v", err)
+	}
+	for _, rule := range [][]string{{"superuser", "data9", "read"}} {
+		if _, err := e.AddPolicy(rule[0], rule[1], rule[2]); err != nil {
+			t.Fatalf("seed p: %v", err)
+		}
+	}
+	for _, rule := range [][]string{{"alice", "admin"}, {"admin", "superuser"}} {
+		if _, err := e.AddGroupingPolicy(rule[0], rule[1]); err != nil {
+			t.Fatalf("seed g: %v", err)
+		}
+	}
+
+	if allowed, err := e.Enforce("alice", "data9", "read"); err != nil || !allowed {
+		t.Fatalf("the default manager should resolve the two-level chain: %v, %v", allowed, err)
+	}
+
+	e.SetRoleManager(defaultrolemanager.NewRoleManagerImpl(1))
+
+	// Read before any rebuild. This is the interval the finding is about: the
+	// operator has asked for a narrower manager and has not yet rebuilt, and
+	// the answer must not come from the manager they replaced.
+	allowed, err := e.Enforce("alice", "data9", "read")
+	if err != nil {
+		t.Fatalf("Enforce: %v", err)
+	}
+	if allowed {
+		t.Error("the replaced role manager still resolved the chain after it was swapped out")
+	}
+
+	// After the rebuild the narrowing itself is what denies: the links are all
+	// present and depth 1 cannot walk two of them.
+	if err := e.BuildRoleLinks(); err != nil {
+		t.Fatalf("BuildRoleLinks: %v", err)
+	}
+	if allowed, err := e.Enforce("alice", "data9", "read"); err != nil || allowed {
+		t.Errorf("a depth-1 role manager resolved a two-level chain: %v, %v", allowed, err)
+	}
+	// One level still resolves, so the manager was narrowed rather than emptied.
+	if allowed, err := e.Enforce("admin", "data9", "read"); err != nil || !allowed {
+		t.Errorf("depth 1 should still resolve a one-level chain: %v, %v", allowed, err)
+	}
+	// The direct grant is untouched.
+	if allowed, err := e.Enforce("superuser", "data9", "read"); err != nil || !allowed {
+		t.Errorf("the direct rule should still decide: %v, %v", allowed, err)
+	}
+}
+
+// TestEnableAutoBuildRoleLinksGovernsTheLoadRebuild pins each half of what the
+// flag's comment now claims, at both of its values. CAS-24 was the comment
+// saying the flag controls the rebuild "when a role is added or deleted", which
+// is the one thing it does not control; a corrected comment needs an executing
+// check behind it or the next reader has only a different sentence to trust.
+func TestEnableAutoBuildRoleLinksGovernsTheLoadRebuild(t *testing.T) {
+	// The half the flag does govern: the rebuild that follows a load.
+	t.Run("load-rebuild-deferred-when-off", func(t *testing.T) {
+		e, err := NewEnforcer("examples/rbac_model.conf")
+		if err != nil {
+			t.Fatal(err)
+		}
+		e.EnableAutoBuildRoleLinks(false)
+		e.SetAdapter(fileadapter.NewAdapter("examples/rbac_policy.csv"))
+		if err := e.LoadPolicy(); err != nil {
+			t.Fatal(err)
+		}
+		if ok, _ := e.Enforce("alice", "data2", "read"); ok {
+			t.Error("the inherited decision resolved before BuildRoleLinks, with the flag off")
+		}
+		if err := e.BuildRoleLinks(); err != nil {
+			t.Fatal(err)
+		}
+		if ok, _ := e.Enforce("alice", "data2", "read"); !ok {
+			t.Error("the inherited decision did not resolve after BuildRoleLinks")
+		}
+	})
+
+	t.Run("load-rebuild-immediate-when-on", func(t *testing.T) {
+		e, err := NewEnforcer("examples/rbac_model.conf")
+		if err != nil {
+			t.Fatal(err)
+		}
+		e.EnableAutoBuildRoleLinks(true)
+		e.SetAdapter(fileadapter.NewAdapter("examples/rbac_policy.csv"))
+		if err := e.LoadPolicy(); err != nil {
+			t.Fatal(err)
+		}
+		if ok, _ := e.Enforce("alice", "data2", "read"); !ok {
+			t.Error("the inherited decision did not resolve at load, with the flag on")
+		}
+	})
+
+	// The half the flag does not govern, which is what the old comment claimed
+	// it did: an individual grouping edit maintains its own links either way.
+	for _, enabled := range []bool{true, false} {
+		name := "edit-takes-effect-when-off"
+		if enabled {
+			name = "edit-takes-effect-when-on"
+		}
+		t.Run(name, func(t *testing.T) {
+			e, err := NewEnforcer("examples/rbac_model.conf", "examples/rbac_policy.csv")
+			if err != nil {
+				t.Fatal(err)
+			}
+			e.EnableAutoBuildRoleLinks(enabled)
+
+			if _, err := e.AddGroupingPolicy("carol", "data2_admin"); err != nil {
+				t.Fatal(err)
+			}
+			if ok, _ := e.Enforce("carol", "data2", "read"); !ok {
+				t.Errorf("an added grant was not live at add time (flag %v)", enabled)
+			}
+
+			if _, err := e.RemoveGroupingPolicy("alice", "data2_admin"); err != nil {
+				t.Fatal(err)
+			}
+			if ok, _ := e.Enforce("alice", "data2", "read"); ok {
+				t.Errorf("a removed grant was still in force after the removal (flag %v)", enabled)
+			}
+		})
+	}
+}
