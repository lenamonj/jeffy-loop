+// TestExplainRefusesOversizedResponse tests that the endpoint cannot choose how
+// much memory the calling process allocates. The response is third-party
+// content arriving over the network, so it is read under a fixed limit and a
+// larger body is reported rather than buffered.
+func TestExplainRefusesOversizedResponse(t *testing.T) {
+	mockServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		chunk := strings.Repeat("A", 1024*1024)
+		_, _ = w.Write([]byte(`{"choices":[{"message":{"content":"`))
+		for i := 0; i < 8; i++ {
+			_, _ = w.Write([]byte(chunk))
+		}
+		_, _ = w.Write([]byte(`"}}]}`))
+	}))
+	defer mockServer.Close()
+
+	e, err := NewEnforcer("examples/basic_model.conf", "examples/basic_policy.csv")
+	if err != nil {
+		t.Fatalf("cannot build enforcer: %v", err)
+	}
+	e.SetAIConfig(AIConfig{Endpoint: mockServer.URL, APIKey: "k", Model: "m", Timeout: 30 * time.Second})
+
+	out, err := e.Explain("alice", "data1", "read")
+	if err == nil {
+		t.Fatalf("an 8MB response should be refused, got a %d byte explanation", len(out))
+	}
+	if !strings.Contains(err.Error(), "exceeds the") {
+		t.Errorf("the error should name the limit, got: %v", err)
+	}
+	if out != "" {
