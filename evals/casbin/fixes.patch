+// TestTheStoreDoesNotRetainTheCallerSlice is the class enumeration behind
+// CAS-11, built by provoking the failure at every entry point that hands the
+// model a rule the caller still owns rather than by reading the store: the
+// caller fills one buffer, passes it, mutates it, and the stored policy must not
+// have moved. A caller filling one buffer in a loop is legal and idiomatic Go,
+// and the rules it already added are what it silently rewrites.
+func TestTheStoreDoesNotRetainTheCallerSlice(t *testing.T) {
+	build := func(t *testing.T) *Enforcer {
+		t.Helper()
+		e, err := NewEnforcer("examples/rbac_model.conf", "examples/rbac_policy.csv")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return e
+	}
+
+	// Each case adds or updates through one entry point using buf, then the
+	// harness mutates buf and reads the section back.
+	cases := []struct {
+		name string
+		sec  string
+		call func(e *Enforcer, buf []string) error
+		want string
+	}{
+		{"AddPolicy", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddPolicy(buf)
+			return err
+		}, "[zoe data9 read]"},
+		{"AddNamedPolicy", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddNamedPolicy("p", buf)
+			return err
+		}, "[zoe data9 read]"},
+		{"AddPolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddPolicies([][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"AddPoliciesEx", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddPoliciesEx([][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"AddNamedPolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddNamedPolicies("p", [][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"AddNamedPoliciesEx", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.AddNamedPoliciesEx("p", [][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdatePolicy", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdatePolicy([]string{"alice", "data1", "read"}, buf)
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdateNamedPolicy", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateNamedPolicy("p", []string{"alice", "data1", "read"}, buf)
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdatePolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdatePolicies(
+				[][]string{{"alice", "data1", "read"}}, [][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdateNamedPolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateNamedPolicies("p",
+				[][]string{{"alice", "data1", "read"}}, [][]string{buf})
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdateFilteredPolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateFilteredPolicies([][]string{buf}, 0, "alice")
+			return err
+		}, "[zoe data9 read]"},
+		{"UpdateFilteredNamedPolicies", "p", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateFilteredNamedPolicies("p", [][]string{buf}, 0, "alice")
+			return err
+		}, "[zoe data9 read]"},
+		{"AddGroupingPolicy", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.AddGroupingPolicy(buf)
+			return err
+		}, "[zoe data9]"},
+		{"AddNamedGroupingPolicy", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.AddNamedGroupingPolicy("g", buf)
+			return err
+		}, "[zoe data9]"},
+		{"AddGroupingPolicies", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.AddGroupingPolicies([][]string{buf})
+			return err
+		}, "[zoe data9]"},
+		{"AddGroupingPoliciesEx", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.AddGroupingPoliciesEx([][]string{buf})
+			return err
+		}, "[zoe data9]"},
+		{"UpdateGroupingPolicy", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateGroupingPolicy([]string{"alice", "data2_admin"}, buf)
+			return err
+		}, "[zoe data9]"},
+		{"UpdateGroupingPolicies", "g", func(e *Enforcer, buf []string) error {
+			_, err := e.UpdateGroupingPolicies(
+				[][]string{{"alice", "data2_admin"}}, [][]string{buf})
+			return err
+		}, "[zoe data9]"},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			e := build(t)
+
+			buf := []string{"zoe", "data9", "read"}
+			if c.sec == "g" {
+				buf = []string{"zoe", "data9"}
+			}
+			if err := c.call(e, buf); err != nil {
+				t.Fatal(err)
+			}
+
+			// The caller reuses its buffer, which it still owns.
+			for i := range buf {
+				buf[i] = "MUTATED"
+			}
+
+			var stored [][]string
+			var err error
+			if c.sec == "g" {
+				stored, err = e.GetGroupingPolicy()
+			} else {
+				stored, err = e.GetPolicy()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, rule := range stored {
+				for _, field := range rule {
+					if field == "MUTATED" {
+						t.Fatalf("%s: the store retained the caller's slice: %v, want a rule reading %s",
+							c.name, stored, c.want)
+					}
+				}
+			}
+		})
+	}
+}
