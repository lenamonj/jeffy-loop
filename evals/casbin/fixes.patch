+// bumpModelVersion advances the version optimistic locking compares against.
+// It runs after every change made through the embedded Enforcer; a transaction
+// commit advances the version itself, from Commit, because its own apply path
+// replaces the model rather than going through this callback.
+func (te *TransactionalEnforcer) bumpModelVersion() error {
+	atomic.AddInt64(&te.modelVersion, 1)
+	return nil
 }
 
