+// TestFilteredUpdateAcrossEveryEntryPoint is the class enumeration behind
+// CAS-13, built by driving the filtered update through every public entry point
+// that offers one, in the two cases that separate a replacement from an insert:
+// a filter that matches nothing, which has nothing to replace, and a filter that
+// matches, which must leave the matched rules gone and the new ones in force.
+// Every enforcer here is built over the file adapter, which answers the
+// updatable call with "not implemented" - the state every adapter this module
+// ships is in, so it is the ordinary case rather than a corner.
+func TestFilteredUpdateAcrossEveryEntryPoint(t *testing.T) {
+	const conf = "examples/rbac_model.conf"
+	const policy = "examples/rbac_policy.csv"
+
+	// nothingMatches: the filter selects no rule, so the call must report no
+	// change and must not insert the rules it was asked to substitute.
+	nothing := []struct {
+		name string
+		call func(t *testing.T) (bool, [][]string)
+	}{
+		{"UpdateFilteredPolicies", func(t *testing.T) (bool, [][]string) {
+			e, err := NewEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredPolicies([][]string{{"zoe", "data9", "read"}}, 0, "nobody")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, err := e.GetPolicy()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return ok, p
+		}},
+		{"UpdateFilteredNamedPolicies", func(t *testing.T) (bool, [][]string) {
+			e, err := NewEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredNamedPolicies("p", [][]string{{"zoe", "data9", "read"}}, 0, "nobody")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, err := e.GetPolicy()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return ok, p
+		}},
+		{"SyncedEnforcer", func(t *testing.T) (bool, [][]string) {
+			e, err := NewSyncedEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredPolicies([][]string{{"zoe", "data9", "read"}}, 0, "nobody")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, err := e.GetPolicy()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return ok, p
+		}},
+		{"ContextEnforcer", func(t *testing.T) (bool, [][]string) {
+			e, err := NewContextEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredPoliciesCtx(context.Background(),
+				[][]string{{"zoe", "data9", "read"}}, 0, "nobody")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, err := e.GetPolicy()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return ok, p
+		}},
+		{"DistributedEnforcerSelf", func(t *testing.T) (bool, [][]string) {
+			d, err := NewDistributedEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := d.UpdateFilteredPoliciesSelf(d.shouldPersist, "p", "p",
+				[][]string{{"zoe", "data9", "read"}}, 0, "nobody")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, err := d.GetPolicy()
+			if err != nil {
+				t.Fatal(err)
+			}
+			return ok, p
+		}},
+	}
+
+	for _, c := range nothing {
+		t.Run("nothing-matches/"+c.name, func(t *testing.T) {
+			ok, policy := c.call(t)
+			for _, rule := range policy {
+				if rule[0] == "zoe" {
+					t.Errorf("a filter matching nothing inserted %v; the policy reads %v", rule, policy)
+				}
+			}
+			if ok {
+				t.Errorf("a filter matching nothing reported a change")
+			}
+		})
+	}
+
+	// matches: the filter selects alice's rule, which must be gone afterwards
+	// and must no longer enforce, with the replacement in force.
+	matches := []struct {
+		name string
+		call func(t *testing.T) (bool, [][]string, bool, bool)
+	}{
+		{"UpdateFilteredPolicies", func(t *testing.T) (bool, [][]string, bool, bool) {
+			e, err := NewEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredPolicies([][]string{{"alice", "data9", "read"}}, 0, "alice")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, _ := e.GetPolicy()
+			old, _ := e.Enforce("alice", "data1", "read")
+			fresh, _ := e.Enforce("alice", "data9", "read")
+			return ok, p, old, fresh
+		}},
+		{"ContextEnforcer", func(t *testing.T) (bool, [][]string, bool, bool) {
+			e, err := NewContextEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := e.UpdateFilteredPoliciesCtx(context.Background(),
+				[][]string{{"alice", "data9", "read"}}, 0, "alice")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, _ := e.GetPolicy()
+			old, _ := e.Enforce("alice", "data1", "read")
+			fresh, _ := e.Enforce("alice", "data9", "read")
+			return ok, p, old, fresh
+		}},
+		{"DistributedEnforcerSelf", func(t *testing.T) (bool, [][]string, bool, bool) {
+			d, err := NewDistributedEnforcer(conf, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ok, err := d.UpdateFilteredPoliciesSelf(d.shouldPersist, "p", "p",
+				[][]string{{"alice", "data9", "read"}}, 0, "alice")
+			if err != nil {
+				t.Fatal(err)
+			}
+			p, _ := d.GetPolicy()
+			old, _ := d.Enforce("alice", "data1", "read")
+			fresh, _ := d.Enforce("alice", "data9", "read")
+			return ok, p, old, fresh
+		}},
+	}
+
+	for _, c := range matches {
+		t.Run("matches/"+c.name, func(t *testing.T) {
+			ok, policy, old, fresh := c.call(t)
+			if !ok {
+				t.Errorf("a filter that matched reported no change")
+			}
+			for _, rule := range policy {
+				if rule[0] == "alice" && rule[1] == "data1" {
+					t.Errorf("the replaced rule is still stored: %v", policy)
+				}
+			}
+			if old {
+				t.Errorf("the replaced grant is still in force")
+			}
+			if !fresh {
+				t.Errorf("the replacement is not in force")
+			}
+		})
+	}
+}
