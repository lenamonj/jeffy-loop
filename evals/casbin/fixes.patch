+// stringAdapterEnforcer builds an enforcer over the string adapter, which
+// implements persist.Adapter and nothing more - the minimum the interface
+// requires, and the shape a third-party adapter is free to have.
+func stringAdapterEnforcer(t *testing.T) *Enforcer {
+	t.Helper()
+	m, err := model.NewModelFromString(`
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e, err := NewEnforcer(m, stringadapter.NewAdapter("p, alice, data1, read\ng, bob, alice"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return e
+}
