+// TestLRUCachePutOverwritesAnExistingKey pins CAS-8: Put on a key already in
+// the cache reuses that key's node for its links, so the new value has to be
+// written onto it. Re-linking alone left the cache answering with the value the
+// key was first stored with, and every later Put for that key was discarded
+// without a word. Both the plain and the synchronised cache are driven, because
+// the synchronised one delegates and would inherit the defect silently.
+func TestLRUCachePutOverwritesAnExistingKey(t *testing.T) {
+	caches := []struct {
+		name string
+		put  func(key, value interface{})
+		get  func(key interface{}) (interface{}, bool)
+	}{}
+
+	plain := NewLRUCache(3)
+	caches = append(caches, struct {
+		name string
+		put  func(key, value interface{})
+		get  func(key interface{}) (interface{}, bool)
+	}{"LRUCache", plain.Put, plain.Get})
+
+	synced := NewSyncLRUCache(3)
+	caches = append(caches, struct {
+		name string
+		put  func(key, value interface{})
+		get  func(key interface{}) (interface{}, bool)
+	}{"SyncLRUCache", synced.Put, synced.Get})
+
+	for _, c := range caches {
+		t.Run(c.name, func(t *testing.T) {
+			c.put("k", 1)
+			if v, ok := c.get("k"); !ok || v != 1 {
+				t.Fatalf("first Put: got %v, %v, want 1 and ok", v, ok)
+			}
+
+			c.put("k", 2)
+			if v, ok := c.get("k"); !ok || v != 2 {
+				t.Errorf("Put over an existing key: got %v, %v, want 2 and ok", v, ok)
+			}
+
+			// A third value, so the check cannot pass on a cache that simply
+			// stores the second write and ignores the rest.
+			c.put("k", 3)
+			if v, ok := c.get("k"); !ok || v != 3 {
+				t.Errorf("Put over an overwritten key: got %v, %v, want 3 and ok", v, ok)
+			}
+
+			// The overwrite must not have disturbed the other keys or the
+			// eviction order the cache exists to maintain.
+			c.put("a", "A")
+			c.put("b", "B")
+			if v, ok := c.get("k"); !ok || v != 3 {
+				t.Errorf("the overwritten key after two more Puts: got %v, %v, want 3 and ok", v, ok)
+			}
+			// Capacity is 3 and the cache holds k, a and b. Get promotes, and
+			// the read of k above was the most recent access, so the order
+			// most-recent-first is k, b, a and this Put evicts a.
+			c.put("c", "C")
+			if _, ok := c.get("a"); ok {
+				t.Error("the least recently used key survived an eviction")
+			}
+			for key, want := range map[interface{}]interface{}{"k": 3, "b": "B", "c": "C"} {
+				if v, ok := c.get(key); !ok || v != want {
+					t.Errorf("%v after eviction: got %v, %v, want %v and ok", key, v, ok, want)
+				}
+			}
+		})
+	}
+}
