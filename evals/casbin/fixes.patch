+			if err != nil {
+				t.Fatal(err)
+			}
+
+			// The type the interface used to document.
+			err = c.Set("wrongtype", true, time.Now().Add(time.Hour))
+			if err == nil {
+				t.Fatal("Set accepted a time.Time survival time and reported no error")
+			}
+			if !strings.Contains(err.Error(), "time.Duration") ||
+				!strings.Contains(err.Error(), "time.Time") {
+				t.Errorf("the error names neither the wanted nor the given type: %v", err)
+			}
+			if _, err := c.Get("wrongtype"); !errors.Is(err, ErrNoSuchKey) {
+				t.Errorf("a refused Set stored the key anyway: Get returned %v", err)
+			}
+
+			// A second wrong type, so the message reports its argument.
+			if err := c.Set("wrongint", true, 3600); err == nil ||
+				!strings.Contains(err.Error(), "int") {
+				t.Errorf("Set(int): got %v, want an error naming int", err)
+			}
+
+			// The refusal must not wedge the cache for the type it does want.
+			if err := c.Set("right", true, time.Hour); err != nil {
+				t.Fatalf("Set with a time.Duration after a refusal: %v", err)
+			}
+			v, err := c.Get("right")
+			if err != nil || !v {
+				t.Errorf("Get after a valid Set: got %v, %v, want true and no error", v, err)
+			}
+
+			// An omitted survival time is still the always-survive default.
+			if err := c.Set("none", true); err != nil {
+				t.Fatalf("Set with no survival time: %v", err)
+			}
+			if v, err := c.Get("none"); err != nil || !v {
+				t.Errorf("Get with no survival time: got %v, %v, want true and no error", v, err)
+			}
+		})
+	}
+}
