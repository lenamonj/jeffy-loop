+func TestConstraintsFollowRoleInheritance(t *testing.T) {
+	t.Run("sod through an intermediate role", func(t *testing.T) {
+		e := constraintEnforcer(t, "g = _, _", `c = sod("requester", "approver")`)
+		if _, err := e.AddGroupingPolicy("alice", "requester"); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.AddGroupingPolicy("team_lead", "approver"); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.AddGroupingPolicy("alice", "team_lead"); err == nil {
+			t.Error("alice reached approver through team_lead and the constraint did not fire")
+		}
+	})
+
+	t.Run("sodMax through an intermediate role", func(t *testing.T) {
+		e := constraintEnforcer(t, "g = _, _", `c = sodMax(["view", "edit", "approve"], 2)`)
+		for _, rule := range [][]string{{"alice", "view"}, {"alice", "edit"}, {"senior", "approve"}} {
+			if _, err := e.AddGroupingPolicy(rule); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if _, err := e.AddGroupingPolicy("alice", "senior"); err == nil {
+			t.Error("alice reached a third role from the set through senior and the constraint did not fire")
+		}
+	})
+
+	t.Run("roleMax counts inherited holders", func(t *testing.T) {
+		e := constraintEnforcer(t, "g = _, _", `c = roleMax("superadmin", 2)`)
+		for _, rule := range [][]string{{"alice", "superadmin"}, {"lead", "superadmin"}} {
