+// TestSetWatcherNilDetaches tests that clearing the watcher does not call back
+// into a nil one. Every broadcast guards on e.watcher being non-nil, so nil is
+// the state the rest of the file already expects.
+func TestSetWatcherNilDetaches(t *testing.T) {
+	e, err := NewEnforcer("examples/basic_model.conf", "examples/basic_policy.csv")
+	if err != nil {
+		t.Fatalf("cannot build enforcer: %v", err)
+	}
+
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("SetWatcher(nil) panicked: %v", r)
+			}
+		}()
+		if err := e.SetWatcher(nil); err != nil {
+			t.Fatalf("SetWatcher(nil) should detach without error, got: %v", err)
+		}
+	}()
+
+	// A later change must not broadcast to the watcher that is no longer there.
+	if _, err := e.AddPolicy("carol", "data3", "read"); err != nil {
+		t.Errorf("adding after detaching the watcher should work: %v", err)
+	}
+}
