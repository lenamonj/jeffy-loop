+// TestConstraintRefusalAppliesNothing drives every grouping entry point that
+// reaches the constraint engine and asserts that a refused change leaves the
+// policy exactly as it was.
+func TestConstraintRefusalAppliesNothing(t *testing.T) {
+	const modelText = `
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[constraint_definition]
+c = sod("role1", "role2")
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`
+	build := func(t *testing.T) *Enforcer {
+		t.Helper()
+		m, err := model.NewModelFromString(modelText)
+		if err != nil {
+			t.Fatal(err)
+		}
+		e, err := NewEnforcer(m)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.AddPolicy("role2", "data2", "write"); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := e.AddGroupingPolicy("alice", "role1"); err != nil {
+			t.Fatal(err)
+		}
+		return e
+	}
+
+	cases := []struct {
+		name string
+		call func(*Enforcer) error
+	}{
+		{"AddGroupingPolicy", func(e *Enforcer) error {
+			_, err := e.AddGroupingPolicy("alice", "role2")
+			return err
+		}},
+		{"AddGroupingPolicies", func(e *Enforcer) error {
+			_, err := e.AddGroupingPolicies([][]string{{"alice", "role2"}})
+			return err
+		}},
+		{"AddGroupingPoliciesEx", func(e *Enforcer) error {
+			_, err := e.AddGroupingPoliciesEx([][]string{{"alice", "role2"}})
+			return err
+		}},
+		{"AddRolesForUser", func(e *Enforcer) error {
+			_, err := e.AddRolesForUser("alice", []string{"role2"})
+			return err
+		}},
+		{"UpdateGroupingPolicy", func(e *Enforcer) error {
+			if _, err := e.AddGroupingPolicy("alice", "spare"); err != nil {
+				return err
+			}
+			_, err := e.UpdateGroupingPolicy([]string{"alice", "spare"}, []string{"alice", "role2"})
+			return err
+		}},
+		{"UpdateGroupingPolicies", func(e *Enforcer) error {
+			if _, err := e.AddGroupingPolicy("alice", "spare"); err != nil {
+				return err
+			}
+			_, err := e.UpdateGroupingPolicies(
