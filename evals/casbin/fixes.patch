+// software distributed under the License is distributed on an
+// "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+// KIND, either express or implied.  See the License for the
+// specific language governing permissions and limitations
+// under the License.
+
+package casbin
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/casbin/casbin/v3/model"
+	fileadapter "github.com/casbin/casbin/v3/persist/file-adapter"
+	"github.com/casbin/casbin/v3/util"
+)
+
+const distributedModelText = `
+[request_definition]
+r = sub, obj, act
+
+[policy_definition]
+p = sub, obj, act
+
+[role_definition]
+g = _, _
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = g(r.sub, p.sub) && r.obj == p.obj && r.act == p.act
+`
+
+func newDistributedForUpdate(t *testing.T, adapter interface{}) *DistributedEnforcer {
+	t.Helper()
+	m, err := model.NewModelFromString(distributedModelText)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	var e *DistributedEnforcer
+	if adapter == nil {
+		e, err = NewDistributedEnforcer(m)
+	} else {
+		e, err = NewDistributedEnforcer(m, adapter)
+	}
+	if err != nil {
+		t.Fatalf("distributed enforcer: %v", err)
+	}
+	for _, rule := range [][]string{
+		{"alice", "secret", "read"},
+		{"alice", "public", "read"},
+		{"bob", "data2", "write"},
+	} {
+		if _, err := e.AddPolicy(rule[0], rule[1], rule[2]); err != nil {
+			t.Fatalf("seed: %v", err)
+		}
+	}
+	return e
+}
+
+func assertRevoked(t *testing.T, e *DistributedEnforcer, changed bool, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("UpdateFilteredPoliciesSelf: %v", err)
+	}
+	if !changed {
+		t.Error("the update replaced rules but reported no change")
+	}
+	policy, err := e.GetPolicy()
+	if err != nil {
+		t.Fatalf("GetPolicy: %v", err)
+	}
+	if len(policy) != 2 {
+		t.Errorf("the rules the update was asked to replace are still present: %v", policy)
+	}
+	if allowed, err := e.Enforce("alice", "secret", "read"); err != nil || allowed {
+		t.Errorf("the revoked grant is still in force: %v, %v", allowed, err)
+	}
+	if allowed, err := e.Enforce("alice", "reports", "read"); err != nil || !allowed {
+		t.Errorf("the replacement grant did not take effect: %v, %v", allowed, err)
+	}
+	// A rule outside the filter is untouched.
+	if allowed, err := e.Enforce("bob", "data2", "write"); err != nil || !allowed {
+		t.Errorf("a rule outside the filter was removed: %v, %v", allowed, err)
+	}
+}
+
+// With no adapter consulted, the rules to replace can only come from the model.
+func TestUpdateFilteredPoliciesSelfWithoutPersistence(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		shouldPersist func() bool
+	}{
+		{"nil predicate", nil},
+		{"predicate returns false", func() bool { return false }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			e := newDistributedForUpdate(t, nil)
+			changed, err := e.UpdateFilteredPoliciesSelf(tc.shouldPersist, "p", "p",
+				[][]string{{"alice", "reports", "read"}}, 0, "alice")
+			assertRevoked(t, e, changed, err)
+		})
+	}
+}
+
+// The file adapter is an UpdatableAdapter that answers "not implemented", which
+// the non-distributed sibling tolerates and this one used to return verbatim
+// while applying nothing.
+func TestUpdateFilteredPoliciesSelfWithDecliningAdapter(t *testing.T) {
+	// An empty file, so the adapter contributes no rules of its own and the
+	// policy under test is exactly what this test seeded.
+	path := filepath.Join(t.TempDir(), "policy.csv")
+	if err := os.WriteFile(path, nil, 0o600); err != nil {
+		t.Fatalf("temp policy: %v", err)
+	}
+	e := newDistributedForUpdate(t, fileadapter.NewAdapter(path))
+	changed, err := e.UpdateFilteredPoliciesSelf(func() bool { return true }, "p", "p",
+		[][]string{{"alice", "reports", "read"}}, 0, "alice")
+	assertRevoked(t, e, changed, err)
+}
+
+// The distributed path and its non-distributed sibling must answer the same
+// request the same way; they diverged once because nothing compared them.
+func TestUpdateFilteredPoliciesSelfMatchesTheSibling(t *testing.T) {
+	d := newDistributedForUpdate(t, nil)
+	if _, err := d.UpdateFilteredPoliciesSelf(nil, "p", "p",
+		[][]string{{"alice", "reports", "read"}}, 0, "alice"); err != nil {
+		t.Fatalf("distributed: %v", err)
+	}
+
+	m, err := model.NewModelFromString(distributedModelText)
+	if err != nil {
+		t.Fatalf("model: %v", err)
+	}
+	p, err := NewEnforcer(m)
+	if err != nil {
+		t.Fatalf("enforcer: %v", err)
+	}
+	for _, rule := range [][]string{
+		{"alice", "secret", "read"},
+		{"alice", "public", "read"},
+		{"bob", "data2", "write"},
+	} {
+		if _, err := p.AddPolicy(rule[0], rule[1], rule[2]); err != nil {
+			t.Fatalf("seed: %v", err)
+		}
+	}
+	if _, err := p.UpdateFilteredPolicies([][]string{{"alice", "reports", "read"}}, 0, "alice"); err != nil {
+		t.Fatalf("plain: %v", err)
+	}
+
+	dp, err := d.GetPolicy()
+	if err != nil {
+		t.Fatalf("GetPolicy: %v", err)
+	}
+	pp, err := p.GetPolicy()
+	if err != nil {
+		t.Fatalf("GetPolicy: %v", err)
+	}
+	if !util.Set2DEquals(dp, pp) {
+		t.Errorf("distributed left %v where the plain enforcer left %v", dp, pp)
+	}
+}
