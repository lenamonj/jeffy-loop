+		{"LoadPolicy", func(e *Enforcer) error { return e.LoadPolicy() }},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			e := build()
+			var err error
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Fatalf("%s panicked instead of reporting: %v", c.name, r)
+					}
+				}()
+				err = c.call(e)
+			}()
+			if err == nil {
+				t.Fatalf("%s should report that there is no adapter", c.name)
+			}
+			if !strings.Contains(err.Error(), "no adapter set") {
+				t.Errorf("%s should name the missing adapter, got: %v", c.name, err)
+			}
+		})
+	}
+
+	// The write paths already guarded on the same nil and still do, which is
+	// what made the two above a gap rather than a design.
+	e := build()
+	if _, err := e.AddPolicy("alice", "data1", "read"); err != nil {
+		t.Errorf("AddPolicy without an adapter should keep the rule in memory: %v", err)
+	}
+	ok, err := e.Enforce("alice", "data1", "read")
+	if err != nil || !ok {
+		t.Errorf("the in-memory rule should still decide, got %v err %v", ok, err)
+	}
+}
