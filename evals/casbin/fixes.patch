+
+	// And revoking it in a transaction takes effect as well.
+	err = e.WithTransaction(context.Background(), func(tx *Transaction) error {
+		_, removeErr := tx.RemoveGroupingPolicy("alice", "data2_admin", "_", "_")
+		return removeErr
+	})
+	if err != nil {
+		t.Fatalf("WithTransaction: %v", err)
+	}
+	if ok, err := e.Enforce("alice", "data2", "read"); err != nil || ok {
+		t.Errorf("alice, data2, read: %t, %v, supposed to be false after the transaction revoked the role", ok, err)
+	}
+}
+
+// newConflictEnforcer builds a transactional enforcer holding two rules, which
+// is enough for a removal race and an update race.
+func newConflictEnforcer(t *testing.T) *TransactionalEnforcer {
+	t.Helper()
+	e, err := NewTransactionalEnforcer("examples/basic_model.conf", NewMockTransactionalAdapter())
+	if err != nil {
+		t.Fatalf("Failed to create transactional enforcer: %v", err)
+	}
+	for _, rule := range [][]string{{"alice", "secret", "read"}, {"bob", "data2", "write"}} {
+		if ok, err := e.AddPolicy(rule[0], rule[1], rule[2]); !ok || err != nil {
+			t.Fatalf("seed %v: %v, %v", rule, ok, err)
+		}
+	}
+	return e
+}
+
+// Optimistic locking has to see a change whichever API made it. Each case below
+// is run twice with the same sequence and the same intent, differing only in
+// whether the competing writer is another transaction or the ordinary API on
+// the same enforcer; both must reach the same verdict.
+func TestConflictDetectionSeesDirectWrites(t *testing.T) {
+	t.Run("removal, competing transaction", func(t *testing.T) {
+		e := newConflictEnforcer(t)
+		first, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		second, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		mustRemove(t, first, "alice", "secret", "read")
+		mustRemove(t, second, "alice", "secret", "read")
+		if err := first.Commit(); err != nil {
+			t.Fatalf("the first commit should succeed: %v", err)
+		}
+		assertConflict(t, second.Commit(), "policy has been removed by another transaction")
+	})
+
+	t.Run("removal, competing direct write", func(t *testing.T) {
+		e := newConflictEnforcer(t)
+		tx, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		mustRemove(t, tx, "alice", "secret", "read")
+		if ok, err := e.RemovePolicy("alice", "secret", "read"); !ok || err != nil {
+			t.Fatalf("direct RemovePolicy: %v, %v", ok, err)
+		}
+		assertConflict(t, tx.Commit(), "policy has been removed by another transaction")
+		if tx.IsCommitted() {
+			t.Error("a transaction that reported a conflict is marked committed")
+		}
+	})
+
+	t.Run("update, competing transaction", func(t *testing.T) {
+		e := newConflictEnforcer(t)
+		updater, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		remover, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		if ok, err := updater.UpdatePolicy(
+			[]string{"alice", "secret", "read"}, []string{"alice", "reports", "read"}); !ok || err != nil {
+			t.Fatalf("tx.UpdatePolicy: %v, %v", ok, err)
+		}
+		mustRemove(t, remover, "alice", "secret", "read")
+		if err := remover.Commit(); err != nil {
+			t.Fatalf("the removing commit should succeed: %v", err)
+		}
+		assertConflict(t, updater.Commit(), "policy to be updated no longer exists")
+	})
+
+	// The consequence this whole test exists for: without the version being
+	// advanced by the direct write, this commit succeeded and granted
+	// alice/reports/read, derived from a rule that had just been revoked.
+	t.Run("update, competing direct write", func(t *testing.T) {
+		e := newConflictEnforcer(t)
+		tx, err := e.BeginTransaction(context.Background())
+		if err != nil {
+			t.Fatalf("BeginTransaction: %v", err)
+		}
+		if ok, err := tx.UpdatePolicy(
+			[]string{"alice", "secret", "read"}, []string{"alice", "reports", "read"}); !ok || err != nil {
+			t.Fatalf("tx.UpdatePolicy: %v, %v", ok, err)
+		}
+		if ok, err := e.RemovePolicy("alice", "secret", "read"); !ok || err != nil {
+			t.Fatalf("direct RemovePolicy: %v, %v", ok, err)
+		}
+		assertConflict(t, tx.Commit(), "policy to be updated no longer exists")
+		if allowed, err := e.Enforce("alice", "reports", "read"); err != nil || allowed {
+			t.Errorf("the refused update granted alice/reports/read anyway: %v, %v", allowed, err)
+		}
+	})
+}
+
+// A direct write that does not collide with the transaction's own operations
+// must still commit, so the version bump does not turn every concurrent write
+// into a conflict.
+func TestConflictDetectionAllowsUnrelatedDirectWrites(t *testing.T) {
+	e := newConflictEnforcer(t)
+	tx, err := e.BeginTransaction(context.Background())
+	if err != nil {
+		t.Fatalf("BeginTransaction: %v", err)
+	}
+	if ok, err := tx.AddPolicy("zoe", "data9", "read"); !ok || err != nil {
+		t.Fatalf("tx.AddPolicy: %v, %v", ok, err)
+	}
+	if ok, err := e.AddPolicy("unrelated", "data5", "read"); !ok || err != nil {
+		t.Fatalf("direct AddPolicy: %v, %v", ok, err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatalf("an unrelated direct write must not block the commit: %v", err)
+	}
+	for _, rule := range [][]string{{"zoe", "data9", "read"}, {"unrelated", "data5", "read"}} {
+		allowed, err := e.Enforce(rule[0], rule[1], rule[2])
+		if err != nil || !allowed {
+			t.Errorf("%v should be in force after the commit: %v, %v", rule, allowed, err)
+		}
+	}
+}
+
+func mustRemove(t *testing.T, tx *Transaction, params ...interface{}) {
+	t.Helper()
+	if ok, err := tx.RemovePolicy(params...); !ok || err != nil {
+		t.Fatalf("tx.RemovePolicy%v: %v, %v", params, ok, err)
+	}
+}
+
+func assertConflict(t *testing.T, err error, reason string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("the commit should have reported a conflict naming %q", reason)
+	}
+	if !strings.Contains(err.Error(), reason) {
+		t.Errorf("conflict reason: %v, supposed to name %q", err, reason)
+	}
+}
