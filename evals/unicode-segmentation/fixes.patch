+/// Drives the chunked `GraphemeCursor` API forward and backward over every chunk
+/// size from 1 to 6 and asserts it agrees with the contiguous `graphemes()`
+/// iterator, which computes the same segmentation without chunking.
+///
+/// The cursor is where this crate's two most recent grapheme fixes landed - #172
+/// (GB11 across a chunk boundary) and #175 (GB12/GB13 when the RI count is
+/// already known) - and neither is reachable from the iterator tests above,
+/// because the iterator never splits its input.
+#[test]
+fn test_grapheme_cursor_chunked() {
+    use crate::testdata::{TEST_DIFF, TEST_SAME};
+    use unicode_segmentation::{GraphemeCursor, GraphemeIncomplete};
+
+    /// Byte ranges of `s` cut every `size` bytes, rounded up to char boundaries.
+    fn chunks(s: &str, size: usize) -> Vec<(usize, usize)> {
+        let mut out = vec![];
+        let mut i = 0;
+        while i < s.len() {
+            let mut j = (i + size).min(s.len());
+            while !s.is_char_boundary(j) {
+                j += 1;
+            }
+            out.push((i, j));
+            i = j;
+        }
+        if out.is_empty() {
+            out.push((0, 0));
+        }
+        out
+    }
+
+    fn chunk_of(cs: &[(usize, usize)], off: usize) -> usize {
+        cs.iter()
+            .position(|&(a, b)| off >= a && off < b)
+            .unwrap_or(cs.len() - 1)
+    }
+
+    /// Boundary offsets after 0, walking forward one chunk at a time.
+    fn cursor_forward(s: &str, size: usize, is_extended: bool) -> Vec<usize> {
+        let cs = chunks(s, size);
+        let mut cur = GraphemeCursor::new(0, s.len(), is_extended);
+        let mut out = vec![];
+        loop {
+            let mut ci = chunk_of(&cs, cur.cur_cursor());
+            let res = loop {
+                let (a, b) = cs[ci];
+                match cur.next_boundary(&s[a..b], a) {
+                    Ok(v) => break v,
+                    Err(GraphemeIncomplete::PreContext(n)) => {
+                        let (pa, _) = cs[chunk_of(&cs, n - 1)];
+                        cur.provide_context(&s[pa..n], pa);
+                    }
+                    Err(GraphemeIncomplete::NextChunk) => ci += 1,
+                    Err(e) => panic!(
+                        "next_boundary {e:?} at {} in {s:?} chunk size {size} extended {is_extended}",
+                        cur.cur_cursor()
+                    ),
+                }
+            };
+            match res {
+                Some(x) => out.push(x),
+                None => break,
+            }
+        }
+        out
+    }
+
+    /// Boundary offsets before `len`, walking backward one chunk at a time,
+    /// returned in ascending order.
+    fn cursor_backward(s: &str, size: usize, is_extended: bool) -> Vec<usize> {
+        let cs = chunks(s, size);
+        let mut cur = GraphemeCursor::new(s.len(), s.len(), is_extended);
+        let mut out = vec![];
+        loop {
+            let mut ci = chunk_of(&cs, cur.cur_cursor().saturating_sub(1));
+            let res = loop {
+                let (a, b) = cs[ci];
+                match cur.prev_boundary(&s[a..b], a) {
+                    Ok(v) => break v,
+                    Err(GraphemeIncomplete::PreContext(n)) => {
+                        let (pa, _) = cs[chunk_of(&cs, n - 1)];
+                        cur.provide_context(&s[pa..n], pa);
+                    }
+                    Err(GraphemeIncomplete::PrevChunk) => ci -= 1,
+                    Err(e) => panic!(
+                        "prev_boundary {e:?} at {} in {s:?} chunk size {size} extended {is_extended}",
+                        cur.cur_cursor()
+                    ),
+                }
+            };
+            match res {
+                Some(x) => out.push(x),
+                None => break,
+            }
+        }
+        out.reverse();
+        out
+    }
+
+    // Cases that need context across a chunk boundary: ZWJ before an
+    // Extended_Pictographic (GB11), runs of regional indicators (GB12/GB13),
+    // an InCB=Consonant conjunct (GB9c), Prepend (GB9b) and SpacingMark (GB9a).
+    const EXTRA: &[&str] = &[
+        "\u{1f468}\u{200d}\u{1f467}\u{200d}\u{1f466}",
+        "a\u{1f636}\u{200d}\u{1f32b}\u{fe0f}b",
+        "\u{1f1e6}\u{1f1eb}\u{1f1e6}\u{1f1fd}\u{1f1e6}\u{1f1f1}",
+        "a\u{1f1e6}\u{1f1eb}\u{1f1e6}",
+        "\u{915}\u{94d}\u{915}\u{94d}\u{915}",
+        "\u{600}\u{600}\u{20}",
+        "a\u{903}b\u{903}",
+        "\r\n\r\n",
+        "\u{1F938}\u{1F3FE}\u{1F3FE}",
+    ];
+
+    let corpus = TEST_SAME
+        .iter()
+        .map(|&(s, _)| s)
+        .chain(TEST_DIFF.iter().map(|&(s, _, _)| s))
+        .chain(EXTRA.iter().copied());
+
+    let mut walks = 0usize;
+    for s in corpus {
+        for &is_extended in &[true, false] {
+            // The iterator's own boundaries: cumulative ends walking forward,
+            // cumulative starts walking backward.
+            let mut acc = 0;
+            let ends: Vec<usize> = s
+                .graphemes(is_extended)
+                .map(|g| {
+                    acc += g.len();
+                    acc
+                })
+                .collect();
+            let mut acc = 0;
+            let starts: Vec<usize> = s
+                .graphemes(is_extended)
+                .map(|g| {
+                    let a = acc;
+                    acc += g.len();
+                    a
+                })
+                .collect();
+
+            for size in 1..=6 {
+                assert_eq!(
+                    cursor_forward(s, size, is_extended),
+                    ends,
+                    "forward cursor disagrees with graphemes({is_extended}) on {s:?} at chunk size {size}"
+                );
+                assert_eq!(
+                    cursor_backward(s, size, is_extended),
+                    starts,
+                    "backward cursor disagrees with graphemes({is_extended}) on {s:?} at chunk size {size}"
+                );
+                walks += 2;
+            }
+        }
+    }
+    assert!(walks > 0, "corpus was empty");
+}
