+/// Pins the three promises the sentence iterators document but `test_sentences`
+/// never drives: that `split_sentence_bounds` pieces concatenate back to the
+/// input, that `split_sentence_bound_indices` reports the prefix sums of those
+/// pieces alongside the pieces themselves, and that `unicode_sentences` is
+/// exactly those pieces filtered by the documented Alphabetic-or-Number
+/// predicate. Before this test the two indices and filtering iterators were
+/// reached only by their rustdoc examples.
+#[test]
+fn test_sentence_bound_indices_and_concatenation() {
+    use crate::testdata::TEST_SENTENCE;
+
+    for &(s, _) in TEST_SENTENCE.iter() {
+        let bounds: Vec<&str> = s.split_sentence_bounds().collect();
+
+        assert_eq!(
+            bounds.concat(),
+            s,
+            "split_sentence_bounds does not concatenate back to {s:?}"
+        );
+        assert!(
+            bounds.iter().all(|p| !p.is_empty()),
+            "split_sentence_bounds yielded an empty piece on {:?}",
+            s
+        );
+
+        // Offsets are the prefix sums of the piece lengths, and each indexed
+        // piece is the piece the bounds iterator reported at that position.
+        let mut acc = 0;
+        let expected: Vec<(usize, &str)> = bounds
+            .iter()
+            .map(|&p| {
+                let start = acc;
+                acc += p.len();
+                (start, p)
+            })
+            .collect();
+        let indices: Vec<(usize, &str)> = s.split_sentence_bound_indices().collect();
+        assert_eq!(
+            indices, expected,
+            "split_sentence_bound_indices disagrees with split_sentence_bounds on {s:?}"
+        );
+
+        // Each offset locates its own piece in the original string.
+        for &(i, piece) in &indices {
+            assert_eq!(
+                &s[i..i + piece.len()],
+                piece,
+                "offset {i} misplaces {piece:?} in {s:?}"
+            );
+        }
+
+        // unicode_sentences is the documented filter over the same pieces:
+        // keep a piece iff it holds an Alphabetic or a General_Category=Number
+        // character. std's own Unicode data supplies the predicate.
+        let expected_words: Vec<&str> = bounds
+            .iter()
+            .copied()
+            .filter(|p| p.chars().any(|c| c.is_alphabetic() || c.is_numeric()))
+            .collect();
+        let got: Vec<&str> = s.unicode_sentences().collect();
+        assert_eq!(
+            got, expected_words,
+            "unicode_sentences is not split_sentence_bounds filtered by Alphabetic-or-Number on {s:?}"
+        );
+    }
+}
