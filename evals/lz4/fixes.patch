+# Multithreaded compression (-T) for the CLI, matching programs/Makefile.
+# Only programs/ uses LZ4IO_MULTITHREAD; the library itself is single-threaded.
+# lz4conf.h already enables it on Windows, so this detects the pthread platforms.
+if(LZ4_PROGRAMS_BUILT)
+  set(THREADS_PREFER_PTHREAD_FLAG ON)
+  find_package(Threads)
+  if(Threads_FOUND)
+    message(STATUS "==> built with multithreading support")
+    foreach(cli_target IN LISTS LZ4_PROGRAMS_BUILT)
+      target_compile_definitions(${cli_target} PRIVATE LZ4IO_MULTITHREAD=1)
+      target_link_libraries(${cli_target} PRIVATE Threads::Threads)
+    endforeach()
+  else()
+    message(STATUS "==> no multithread support: built for single-thread mode only")
+  endif()
+endif()
