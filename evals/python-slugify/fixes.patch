+class TestCommandMain(unittest.TestCase):
+    """main() is what the installed `slugify` console script calls, so nothing below
+    reaches the library except through the same path a user on the command line takes."""
+
+    def run_main(self, *argv):
+        with captured_stdout() as out:
+            main(['slugify'] + list(argv))
+        return out.getvalue()
+
+    def test_prints_the_slug(self):
+        self.assertEqual(self.run_main('Hello World'), 'hello-world\n')
+
+    def test_joins_multiple_positional_arguments(self):
+        self.assertEqual(self.run_main('Hello', 'World'), 'hello-world\n')
+
+    def test_a_flag_reaches_the_printed_slug(self):
+        self.assertEqual(self.run_main('--separator', '_', 'Hello World'), 'hello_world\n')
+        self.assertEqual(self.run_main('--regex-pattern', r'[^-a-zA-Z0-9_]+', 'Hello_World Foo'),
+                         'hello_world-foo\n')
+
+    def test_reads_stdin(self):
+        with loaded_stdin('Hello From Stdin'):
+            self.assertEqual(self.run_main('--stdin'), 'hello-from-stdin\n')
+
+    def test_agrees_with_the_library_call(self):
+        argv = ['--max-length', '12', '--word-boundary', 'the quick brown fox']
+        self.assertEqual(self.run_main(*argv),
+                         slugify('the quick brown fox', max_length=12, word_boundary=True) + '\n')
+
+    def test_defaults_to_sys_argv(self):
+        """The installed console script calls main() with no argument, so sys.argv is
+        the path a user on the command line actually takes."""
+        backup, sys.argv = sys.argv, ['slugify', 'Hello World']
+        try:
+            with captured_stdout() as out:
+                main()
+        finally:
+            sys.argv = backup
+        self.assertEqual(out.getvalue(), 'hello-world\n')
+
+    def test_keyboard_interrupt_exits_minus_one(self):
+        import slugify.__main__ as cli
+
+        def interrupted(**kwargs):
+            raise KeyboardInterrupt
+
+        backup, cli.slugify = cli.slugify, interrupted
+        try:
+            with self.assertRaises(SystemExit) as err, captured_stdout():
+                main(['slugify', 'anything'])
+        finally:
+            cli.slugify = backup
+        self.assertEqual(err.exception.code, -1)
