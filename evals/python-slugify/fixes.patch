+def _decode_numeric_reference(match: re.Match[str], base: int) -> str:
+    """
+    Decode one numeric character reference, leaving an undecodable one as it was.
+    chr() rejects values above U+10FFFF and int() rejects digit strings past the
+    interpreter's conversion limit; neither may cost the references around it.
+    """
+    try:
+        return chr(int(match.group(1), base))
+    except (ValueError, OverflowError):
+        return match.group(0)
+
+
+def _replace_outside_replacement(text: str, old: str, new: str) -> str:
+    """
+    Replace old with new, skipping any match that lies inside an occurrence of new.
+    Used for a rule whose replacement contains its own pattern, so the second
+    replacement pass reaches text the slug form supplies without rewriting the
+    replacement text the first pass already wrote.
+    """
+    occupied = []
+    start = 0
+    while True:
+        index = text.find(new, start)
+        if index < 0:
+            break
+        occupied.append(index)
+        start = index + 1
+
+    pieces = []
+    position = 0
+    while True:
+        index = text.find(old, position)
+        if index < 0:
+            break
+        end = index + len(old)
+        # Every occurrence of new is the same length, so among those starting at or before
+        # this match the latest one reaches furthest: it is the only one that can contain
+        # the match, and a binary search for it keeps this pass off a quadratic scan.
+        nearest = bisect.bisect_right(occupied, index) - 1
+        if nearest >= 0 and end <= occupied[nearest] + len(new):
+            pieces.append(text[position:end])
+        else:
+            pieces.append(text[position:index])
+            pieces.append(new)
+        position = end
+    pieces.append(text[position:])
+    return ''.join(pieces)
+
