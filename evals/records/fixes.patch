diff --git a/tests/test_persistence.py b/tests/test_persistence.py
new file mode 100644
index 0000000..1f2406c
--- /dev/null
+++ b/tests/test_persistence.py
@@ -0,0 +1,82 @@
+"""Regression tests for SQLAlchemy 2.x semantics.
+
+The historical fixture used only in-memory sqlite, which cannot observe
+commit behavior across connections and masked silent data loss and pool
+leaks entirely. These tests use a file-backed database and a bounded pool
+so those defects fail loudly.
+"""
+import pytest
+
+import records
+from sqlalchemy.pool import QueuePool
+
+
+@pytest.fixture
+def file_db(tmp_path):
+    url = 'sqlite:///{}'.format(tmp_path / 'regress.db')
+    db = records.Database(url)
+    db.query('CREATE TABLE foo (a integer)')
+    yield url, db
+    db.close()
+
+
+def reopened_values(url):
+    db = records.Database(url)
+    try:
+        return sorted(row.a for row in db.query('SELECT a FROM foo').all())
+    finally:
+        db.close()
+
+
+def test_query_insert_persists_across_reopen(file_db):
+    url, db = file_db
+    db.query('INSERT INTO foo VALUES (1)')
+    db.close()
+    assert reopened_values(url) == [1]
+
+
+def test_bulk_query_persists_across_reopen(file_db):
+    url, db = file_db
+    db.bulk_query('INSERT INTO foo VALUES (:a)', [{'a': 1}, {'a': 2}])
+    db.close()
+    assert reopened_values(url) == [1, 2]
+
+
+def test_bulk_query_legacy_varargs_form(file_db):
+    url, db = file_db
+    db.bulk_query('INSERT INTO foo VALUES (:a)', {'a': 3}, {'a': 4})
+    db.close()
+    assert reopened_values(url) == [3, 4]
+
+
+def test_query_does_not_leak_pooled_connections():
+    db = records.Database(
+        'sqlite:///:memory:',
+        poolclass=QueuePool, pool_size=1, max_overflow=1, pool_timeout=2,
+    )
+    try:
+        for _ in range(5):
+            db.query('SELECT 1').all()
+    finally:
+        db.close()
+
+
+def test_transaction_exception_propagates_and_rolls_back(file_db):
+    url, db = file_db
+    with pytest.raises(RuntimeError):
+        with db.transaction() as conn:
+            conn.query('INSERT INTO foo VALUES (9)')
+            raise RuntimeError('boom')
+    db.close()
+    assert reopened_values(url) == []
+
+
+def test_explicit_transaction_rollback_discards_writes(file_db):
+    url, db = file_db
+    conn = db.get_connection()
+    tx = conn.transaction()
+    conn.query('INSERT INTO foo VALUES (7)')
+    tx.rollback()
+    conn.close()
+    db.close()
+    assert reopened_values(url) == []
