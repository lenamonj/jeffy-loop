diff --git a/src/Type/Types/MatchesIntegerBounds.php b/src/Type/Types/MatchesIntegerBounds.php
new file mode 100644
index 0000000..36b1139
--- /dev/null
+++ b/src/Type/Types/MatchesIntegerBounds.php
@@ -0,0 +1,38 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CuyZ\Valinor\Type\Types;
+
+use CuyZ\Valinor\Type\IntegerType;
+use CuyZ\Valinor\Type\Type;
+
+/**
+ * @internal
+ *
+ * The integer types form a lattice ordered by the interval each one accepts,
+ * and `matches` is subtype compatibility, so one integer type matches another
+ * exactly when its interval is contained in the other's. Deciding that from the
+ * bounds keeps the relation in one place: each type used to name the siblings
+ * it matched, which left every pair nobody thought of - `positive-int` against
+ * `non-negative-int`, one range against a wider one - silently denied.
+ */
+trait MatchesIntegerBounds
+{
+    public function matches(Type $other): bool
+    {
+        if ($other instanceof UnionType) {
+            return $other->isMatchedBy($this);
+        }
+
+        if ($other instanceof ArrayKeyType) {
+            return $other->isMatchedBy($this);
+        }
+
+        if ($other instanceof IntegerType) {
+            return $other->min() <= $this->min() && $other->max() >= $this->max();
+        }
+
+        return $other instanceof ScalarConcreteType || $other instanceof MixedType;
+    }
+}
