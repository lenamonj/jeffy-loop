+
+    /** Runs {@code op} on a printer over a throwaway target and returns the record count it ended with. */
+    private long countOf(final CSVFormat format, final PrinterOp op) throws IOException {
+        try (CSVPrinter printer = new CSVPrinter(new StringWriter(), format)) {
+            try {
+                op.run(printer);
+            } catch (final IOException | RuntimeException e) {
+                throw e;
+            } catch (final Exception e) {
+                throw new IllegalStateException(e);
+            }
+            return printer.getRecordCount();
+        }
+    }
+
+    /** A block of printer calls that may throw anything checked. */
+    private interface PrinterOp {
+        void run(CSVPrinter printer) throws Exception;
+    }
