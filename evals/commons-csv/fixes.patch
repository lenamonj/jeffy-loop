+        // The enumeration behind the getRecordCount Javadoc, driven route by route rather than read off the
+        // source. Everything here writes at least one line; only printRecord, printRecords and the header
+        // record the constructor writes add to the count.
+        assertEquals(1, countOf(CSVFormat.DEFAULT.builder().setHeader("h1", "h2").get(), printer -> { }),
+                "the constructor's header record is counted");
+        assertEquals(0, countOf(CSVFormat.DEFAULT.builder().setCommentMarker('#').setHeaderComments("hc").get(), printer -> { }),
+                "the constructor's header comments are not");
+        assertEquals(1, countOf(CSVFormat.DEFAULT, printer -> printer.printRecord("a", "b")), "printRecord(Object...)");
+        assertEquals(1, countOf(CSVFormat.DEFAULT, printer -> printer.printRecord(Arrays.asList("a", "b"))), "printRecord(Iterable)");
+        assertEquals(1, countOf(CSVFormat.DEFAULT, printer -> printer.printRecord(Stream.of("a", "b"))), "printRecord(Stream)");
+        assertEquals(2, countOf(CSVFormat.DEFAULT, printer -> printer.printRecords("a", "b")), "printRecords(Object...)");
+        assertEquals(2, countOf(CSVFormat.DEFAULT, printer -> printer.printRecords(Arrays.asList(new String[] { "a" }, new String[] { "b" }))),
+                "printRecords(Iterable)");
+        assertEquals(2, countOf(CSVFormat.DEFAULT, printer -> printer.printRecords(Stream.of(new String[] { "a" }, new String[] { "b" }))),
+                "printRecords(Stream)");
+        assertEquals(0, countOf(CSVFormat.DEFAULT, printer -> {
+            printer.print("a");
+            printer.print("b");
+            printer.println();
+        }), "a record assembled from print and println is not counted");
+        assertEquals(0, countOf(CSVFormat.DEFAULT, printer -> printer.println()), "println alone is not counted");
+        assertEquals(0, countOf(CSVFormat.DEFAULT.builder().setCommentMarker('#').get(), printer -> printer.printComment("c")),
