diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 000000000..5304d34b9
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,11 @@
+# Development bookkeeping written by the improvement loop. These files belong to
+# the working repository, not to a release: `git archive` is what produces the
+# Source code assets GitHub attaches to a tag, and shipping a plan, a backlog and
+# a journal inside a release archive is misleading documentation. Directory
+# patterns use the bare name; a trailing slash is documented as pointless in an
+# attributes file.
+PLAN.md export-ignore
+BACKLOG.md export-ignore
+JOURNAL.md export-ignore
+JOURNAL-archive.md export-ignore
+.jeffy export-ignore
