new file mode 100644
index 0000000..e57146a
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,14 @@
+# Paths that belong to the local improvement loop, not to the SystemPackage
+# source distribution. `export-ignore` keeps them out of `git archive`, which
+# is what `swift package archive-source` builds its zip from, so a consumer
+# fetching a source archive of this package does not receive them.
+#
+# This does not affect a SwiftPM dependency resolution, which clones the
+# repository and checks out a working copy; a consumer resolving this package
+# from git still sees these paths under .build/checkouts.
+PLAN.md            export-ignore
+BACKLOG.md         export-ignore
+JOURNAL.md         export-ignore
+JOURNAL-archive.md export-ignore
+.jeffy/            export-ignore
+.gitattributes     export-ignore
