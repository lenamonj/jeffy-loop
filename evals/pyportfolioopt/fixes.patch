+def test_is_positive_semidefinite_is_scale_invariant():
+    # B @ B.T is positive semidefinite by construction, and singular when B has
+    # fewer columns than rows - the shape of a covariance estimated from fewer
+    # observations than assets. The check nudged the diagonal by a fixed 1e-16,
+    # which eigenvalue round-off swamps once the matrix is large, so the same
+    # matrix was accepted at one magnitude and rejected at another.
+    rng = np.random.default_rng(0)
+    B = rng.normal(0, 1, (20, 12))
+    psd = B @ B.T
+    for scale in [1e-4, 1e-2, 1.0, 1e2, 1e4, 1e8]:
+        assert risk_models._is_positive_semidefinite(psd * scale), scale
+
+    # a genuinely indefinite matrix must still be rejected at every magnitude
+    indefinite = np.array([[0.03818144, 0.04182824], [0.04182824, 0.04149209]])
+    for scale in [1e-4, 1.0, 1e4]:
+        assert not risk_models._is_positive_semidefinite(indefinite * scale), scale
+
+
+def test_is_positive_semidefinite_rejects_non_finite():
+    # np.linalg.cholesky propagates NaN into its result rather than raising, so
+    # a matrix containing NaN used to be reported as positive semidefinite.
+    assert not risk_models._is_positive_semidefinite(
+        np.array([[1.0, np.nan], [np.nan, 1.0]])
+    )
+    assert not risk_models._is_positive_semidefinite(
+        np.array([[1.0, np.inf], [np.inf, 1.0]])
+    )
+    assert not risk_models._is_positive_semidefinite(np.full((3, 3), np.nan))
+
+
