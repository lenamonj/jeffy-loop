diff --git a/pypfopt/risk_models.py b/pypfopt/risk_models.py
index 171ce0d..8216977 100644
--- a/pypfopt/risk_models.py
+++ b/pypfopt/risk_models.py
@@ -459,6 +459,25 @@ class CovarianceShrinkage:
         else:
             self.X = returns_from_prices(prices, log_returns).dropna(how="all")
 
+        # Every shrinkage estimator on this class feeds self.X to numpy or
+        # sklearn through np.nan_to_num, which has no notion of a missing
+        # return: a NaN becomes a 0% return, so an asset that was not yet
+        # listed reads as an asset that did not move. Variances and
+        # covariances are diluted in proportion to how much data is missing.
+        # self.S, computed just below, uses pandas' pairwise deletion instead,
+        # so the two disagree on the same input. Say so rather than doing it
+        # silently; picking the estimator's NaN convention is the maintainer's
+        # call, not something to change underneath existing users.
+        n_missing = int(self.X.isnull().values.sum())
+        if n_missing:
+            warnings.warn(
+                "{} missing return(s) will be treated as 0% returns by the "
+                "shrinkage estimators, which understates the variance of any "
+                "asset with an incomplete history. self.S uses pairwise "
+                "deletion instead, so the two do not agree.".format(n_missing),
+                UserWarning,
+            )
+
         self.S = self.X.cov().values
         self.delta = None  # shrinkage constant
 
