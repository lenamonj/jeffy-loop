diff --git a/tests/test_chain_removed.py b/tests/test_chain_removed.py
new file mode 100644
index 0000000..3e52e46
--- /dev/null
+++ b/tests/test_chain_removed.py
@@ -0,0 +1,23 @@
+import pytest
+
+import typer
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda: typer.Typer(chain=True),
+        lambda: typer.Typer().callback(chain=True),
+        lambda: typer.Typer().add_typer(typer.Typer(), chain=True),
+    ],
+    ids=["Typer", "callback", "add_typer"],
+)
+def test_chain_is_rejected(call):
+    """`chain` was accepted and silently ignored; it must not come back quietly.
+
+    It was stored on `TyperInfo` and never passed to the group that would have
+    used it, so `app cmd1 cmd2` failed with `Got unexpected extra argument(s)`
+    whatever its value.
+    """
+    with pytest.raises(TypeError, match="chain"):
+        call()
