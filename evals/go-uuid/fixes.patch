+		"f47ac10b58cc037285670e02b2c3d4zz",
+		"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
+		"f47ac10bX58cc-0372-8567-0e02b2c3d479",
+		"urn:uuiZ:f47ac10b-58cc-0372-8567-0e02b2c3d479",
+	}
+	for _, s := range bad {
+		u, err := Parse(s)
+		if err == nil {
+			t.Errorf("Parse(%q) returned no error", s)
+			continue
+		}
+		if u != Nil {
+			t.Errorf("Parse(%q) = %v, want %v", s, u, Nil)
+		}
+		b, err := ParseBytes([]byte(s))
+		if err == nil {
+			t.Errorf("ParseBytes(%q) returned no error", s)
+			continue
+		}
+		if b != Nil {
+			t.Errorf("ParseBytes(%q) = %v, want %v", s, b, Nil)
+		}
+	}
