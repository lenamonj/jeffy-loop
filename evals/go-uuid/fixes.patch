+// describe: a NULL, an empty string and an empty byte slice each yield a null
+// UUID.  The destination is deliberately populated first, because database/sql
+// reuses one destination across the rows of a result set, and a NULL row that
+// leaves the previous row's UUID in place is a silently wrong read.
+func TestScanEmptyResetsDestination(t *testing.T) {
+	const populated = "f47ac10b-58cc-0372-8567-0e02b2c3d479"
+
+	empties := map[string]interface{}{
+		"nil":              nil,
+		"empty string":     "",
+		"empty byte slice": []byte{},
+		"nil byte slice":   []byte(nil),
+	}
+
+	for name, src := range empties {
+		t.Run(name, func(t *testing.T) {
+			uuid := MustParse(populated)
+			if err := uuid.Scan(src); err != nil {
+				t.Fatalf("Scan(%v) returned unexpected error %v", src, err)
+			}
+			if uuid != Nil {
+				t.Errorf("Scan(%v) left %v in the destination, want %v", src, uuid, Nil)
+			}
+		})
+	}
