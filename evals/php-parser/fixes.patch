diff --git a/lib/PhpParser/Internal/Columns.php b/lib/PhpParser/Internal/Columns.php
new file mode 100644
index 00000000..5594f936
--- /dev/null
+++ b/lib/PhpParser/Internal/Columns.php
@@ -0,0 +1,77 @@
+<?php declare(strict_types=1);
+
+namespace PhpParser\Internal;
+
+/**
+ * Converts file offsets into 1-based columns.
+ *
+ * A line ends at "\n", "\r\n" or a lone "\r", which is what PHP's own tokenizer counts when it
+ * assigns line numbers, and a line terminator belongs to the line it terminates. The search
+ * therefore starts strictly before $pos: a position that is itself a terminator gets the column
+ * it occupies at the end of its line, not column 0 at the start of the next one.
+ *
+ * @internal
+ */
+class Columns {
+    /**
+     * Converts a file offset into a column.
+     *
+     * @param string $code Source code that $pos indexes into
+     * @param int $pos 0-based position in $code, from 0 to its length. The length itself is
+     *                 allowed, because an end position may sit one past the last byte.
+     *
+     * @return int 1-based column (relative to start of line)
+     *
+     * @throws \RuntimeException if $pos falls outside $code on either side
+     */
+    public static function toColumn(string $code, int $pos): int {
+        if ($pos < 0 || $pos > strlen($code)) {
+            throw new \RuntimeException('Invalid position information');
+        }
+
+        $lineEndPos = self::lastLineTerminatorBefore($code, $pos);
+        if ($lineEndPos >= 0 && $code[$lineEndPos] === "\r"
+            && $lineEndPos + 1 === $pos && substr($code, $pos, 1) === "\n"
+        ) {
+            // $pos is the second byte of a "\r\n" pair, which is a single terminator ending a
+            // single line, so the line it belongs to starts before the "\r".
+            $lineEndPos = self::lastLineTerminatorBefore($code, $lineEndPos);
+        }
+
+        return $pos - $lineEndPos;
+    }
+
+    /**
+     * Largest stretch this copies to look for a "\r" in. Any ordinary line is far below it, and
+     * capping the copy is what keeps the search cheap on a source that is one very long line.
+     */
+    private const CR_SEARCH_LIMIT = 4096;
+
+    /**
+     * Returns the offset of the last "\n" or "\r" strictly before $pos, or -1 if there is none.
+     */
+    private static function lastLineTerminatorBefore(string $code, int $pos): int {
+        if ($pos <= 0) {
+            return -1;
+        }
+
+        $offset = $pos - 1 - strlen($code);
+        $lastLf = strrpos($code, "\n", $offset);
+
+        // A "\r" changes the answer only if it sits after the last "\n", so search that stretch
+        // rather than the whole prefix: most sources hold no "\r" at all, and a search for one
+        // runs back to the start of the file every time it is not there.
+        $from = $lastLf === false ? 0 : $lastLf + 1;
+        if ($from >= $pos) {
+            return $lastLf;
+        }
+        $span = $pos - $from;
+        if ($span <= self::CR_SEARCH_LIMIT) {
+            $lastCr = strrpos(substr($code, $from, $span), "\r");
+            return $lastCr === false ? ($lastLf === false ? -1 : $lastLf) : $from + $lastCr;
+        }
+
+        $lastCr = strrpos($code, "\r", $offset);
+        return max($lastLf === false ? -1 : $lastLf, $lastCr === false ? -1 : $lastCr);
+    }
+}
