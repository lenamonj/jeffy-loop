+     *    move to. The bytes stay where they are and only endLine is corrected, down onto the line
+     *    its own last byte terminates, so the reported position names a terminator because that is
+     *    all the range contains.
+     */
+    private function trimErrorRange(Error $error): void {
+        $attrs = $error->getAttributes();
+        if (!isset($attrs['startFilePos'], $attrs['endFilePos'], $attrs['startLine'], $attrs['endLine'])) {
+            return;
+        }
+
+        $start = $attrs['startFilePos'];
+        $end = $attrs['endFilePos'];
