+            // Out of range, or the past-the-end position the sentinel token reports at EOF.
+            return;
+        }
+
+        $newStart = $start;
+        while ($newStart <= $end && self::isLineTerminator($this->code[$newStart])) {
+            ++$newStart;
+        }
+        $newEnd = $end;
+        while ($newEnd > $newStart && self::isLineTerminator($this->code[$newEnd])) {
+            --$newEnd;
+        }
+        if ($newStart > $newEnd) {
+            // The range is nothing but line terminators, so there is no content byte to move to.
+            // The bytes stay where they are and only endLine is corrected below.
+            $newStart = $start;
+            $newEnd = $end;
+        }
