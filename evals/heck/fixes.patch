+/// Runs `body` against `f`, honouring the formatter's width, fill, alignment
+/// and precision when any of them is set.
+///
+/// Those parameters can only be applied to a finished string, so when one is
+/// present the conversion is written to a buffer and then padded. With none set,
+/// which is the ordinary case, the conversion streams straight into the
+/// formatter and nothing is allocated.
+fn pad_with<F>(f: &mut fmt::Formatter, body: F) -> fmt::Result
+where
+    F: Fn(&mut fmt::Formatter) -> fmt::Result,
+{
+    if f.width().is_none() && f.precision().is_none() {
+        return body(f);
+    }
+
+    struct Streamed<F>(F);
+
+    impl<F: Fn(&mut fmt::Formatter) -> fmt::Result> fmt::Display for Streamed<F> {
+        fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+            (self.0)(f)
+        }
+    }
+
+    f.pad(&alloc::format!("{}", Streamed(body)))
+}
