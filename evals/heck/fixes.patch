+/// Writes the titlecase form of `c`.
+///
+/// Titlecase is not uppercase. A character whose uppercase mapping expands to
+/// several characters titlecases to that mapping with everything after its
+/// first cased character lowercased, so `\u{df}` gives `Ss` rather than `SS`; the four Latin digraphs
+/// have a middle form of their own, so `\u{1f3}` gives `\u{1f2}` rather than
+/// `\u{1f1}`; and Georgian Mkhedruli has no titlecase at all, so those letters
+/// are written unchanged. A Greek character carrying an iota subscript keeps
+/// the subscript rather than raising it to a capital iota: most have a
+/// precomposed titlecase form, and the nine that do not take their uppercase
+/// expansion with the iota written as the combining mark `\u{345}`.
+fn titlecase(c: char, f: &mut fmt::Formatter) -> fmt::Result {
+    match c {
+        '\u{1c4}'..='\u{1c6}' => return write!(f, "\u{1c5}"),
+        '\u{1c7}'..='\u{1c9}' => return write!(f, "\u{1c8}"),
+        '\u{1ca}'..='\u{1cc}' => return write!(f, "\u{1cb}"),
+        '\u{1f1}'..='\u{1f3}' => return write!(f, "\u{1f2}"),
+        '\u{10d0}'..='\u{10ff}' => return write!(f, "{}", c),
+
+        // Greek with an iota subscript. Across U+1F80..U+1FAF the titlecase
+        // form is the same code point with bit 3 set, which maps the small
+        // letters onto their capital-plus-prosgegrammeni forms and leaves
+        // those forms alone.
+        '\u{1f80}'..='\u{1faf}' => {
+            if let Some(t) = char::from_u32(c as u32 | 8) {
+                return write!(f, "{}", t);
+            }
+        }
+        '\u{1fb3}' | '\u{1fbc}' => return write!(f, "\u{1fbc}"),
+        '\u{1fc3}' | '\u{1fcc}' => return write!(f, "\u{1fcc}"),
+        '\u{1ff3}' | '\u{1ffc}' => return write!(f, "\u{1ffc}"),
+
+        // The nine with no precomposed titlecase form uppercase to a sequence
+        // ending in a capital iota, where the titlecase keeps the subscript.
+        '\u{1fb2}' | '\u{1fb4}' | '\u{1fb7}' | '\u{1fc2}' | '\u{1fc4}' | '\u{1fc7}'
+        | '\u{1ff2}' | '\u{1ff4}' | '\u{1ff7}' => {
+            for u in c.to_uppercase() {
+                write!(f, "{}", if u == '\u{399}' { '\u{345}' } else { u })?;
+            }
+            return Ok(());
+        }
+        _ => {}
+    }
