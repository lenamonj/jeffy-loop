+    /// The wrappers are plain newtypes, so a caller must be able to derive the
+    /// ordinary traits on a type that holds one. Holding all eight in one
+    /// derived struct is what makes the derive reach every wrapper.
+    #[test]
+    fn wrappers_can_be_derived_through() {
+        #[derive(Debug, Clone, Copy)]
+        struct Holder<'a> {
+            kebab: AsKebabCase<&'a str>,
+            lower_camel: AsLowerCamelCase<&'a str>,
+            shouty_kebab: AsShoutyKebabCase<&'a str>,
+            shouty_snake: AsShoutySnakeCase<&'a str>,
+            snake: AsSnakeCase<&'a str>,
+            title: AsTitleCase<&'a str>,
+            train: AsTrainCase<&'a str>,
+            upper_camel: AsUpperCamelCase<&'a str>,
+        }
+
+        let h = Holder {
+            kebab: AsKebabCase("aB"),
+            lower_camel: AsLowerCamelCase("aB"),
+            shouty_kebab: AsShoutyKebabCase("aB"),
+            shouty_snake: AsShoutySnakeCase("aB"),
+            snake: AsSnakeCase("aB"),
+            title: AsTitleCase("aB"),
+            train: AsTrainCase("aB"),
+            upper_camel: AsUpperCamelCase("aB"),
+        };
+        let copied = h;
+
+        assert_eq!(alloc::format!("{}", copied.kebab), "a-b");
+        assert_eq!(alloc::format!("{}", copied.lower_camel), "aB");
+        assert_eq!(alloc::format!("{}", h.shouty_kebab), "A-B");
+        assert_eq!(alloc::format!("{}", h.shouty_snake), "A_B");
+        assert_eq!(alloc::format!("{}", h.snake), "a_b");
+        assert_eq!(alloc::format!("{}", h.title), "A B");
