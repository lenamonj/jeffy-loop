+        let owned = AsSnakeCase(String::from("aB"));
+        let cloned = owned.clone();
+        assert_eq!(alloc::format!("{}", cloned), "a_b");
+        assert!(alloc::format!("{:?}", cloned).contains("AsSnakeCase"));
