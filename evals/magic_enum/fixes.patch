+// AUTHORS  OR COPYRIGHT  HOLDERS  BE  LIABLE FOR  ANY  CLAIM,  DAMAGES OR  OTHER
+// LIABILITY, WHETHER IN AN ACTION OF  CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+// OUT OF OR IN CONNECTION WITH THE SOFTWARE  OR THE USE OR OTHER DEALINGS IN THE
+// SOFTWARE.
+
+#if defined(__clang__)
+#  pragma clang diagnostic push
+#elif defined(__GNUC__)
+#  pragma GCC diagnostic push
+#elif defined(_MSC_VER)
+#  pragma warning(push)
+#endif
+
+#define CATCH_CONFIG_MAIN
+#include <catch2/catch.hpp>
+
+#include <magic_enum/magic_enum_containers.hpp>
+
+#include <functional>
+#include <iterator>
+#include <stdexcept>
+#include <type_traits>
+
+enum class Color : int { red = -12, green = 7, blue = 15 };
+
+enum class Perm : unsigned { read = 1, write = 2, exec = 4 };
+
+template <>
+struct magic_enum::customize::enum_range<Perm> {
+  static constexpr bool is_flags = true;
+};
+
+// A member of a class template is only compiled when something names it, so a
+// member no test calls is a member no build checks. These explicit instantiations
+// compile every non-template member of each container, which is a compile-time
+// check with no runtime counterpart: several members once shipped with return
+// types nothing could convert to, a missing return statement and a delegating
+// constructor naming an overload that did not exist, and the suite stayed green
+// because nothing instantiated them. Keep these lines even if no test below uses
+// the member they cover.
+template class magic_enum::containers::array<Color, int>;
+template class magic_enum::containers::bitset<Color>;
+template class magic_enum::containers::set<Color>;
+template class magic_enum::containers::bitset<Perm>;
+template class magic_enum::containers::set<Perm>;
+
+TEST_CASE("containers_array_reverse_iteration") {
+  using arr_t = magic_enum::containers::array<Color, int>;
+
+  static_assert(std::is_same_v<decltype(std::declval<arr_t&>().rbegin()), arr_t::reverse_iterator>);
+  static_assert(std::is_same_v<decltype(std::declval<const arr_t&>().rbegin()), arr_t::const_reverse_iterator>);
+  static_assert(std::is_same_v<decltype(std::declval<const arr_t&>().crbegin()), arr_t::const_reverse_iterator>);
+  static_assert(std::is_same_v<decltype(std::declval<arr_t&>().rend()), arr_t::reverse_iterator>);
+  static_assert(std::is_same_v<decltype(std::declval<const arr_t&>().rend()), arr_t::const_reverse_iterator>);
+  static_assert(std::is_same_v<decltype(std::declval<const arr_t&>().crend()), arr_t::const_reverse_iterator>);
+
+  arr_t arr{{1, 2, 3}};
+  const arr_t& carr = arr;
+
+  int reversed = 0;
+  for (auto it = arr.rbegin(); it != arr.rend(); ++it) {
+    reversed = reversed * 10 + *it;
+  }
+  REQUIRE(reversed == 321);
+
+  int const_reversed = 0;
+  for (auto it = carr.crbegin(); it != carr.crend(); ++it) {
+    const_reversed = const_reversed * 10 + *it;
+  }
+  REQUIRE(const_reversed == 321);
+
+  REQUIRE(std::distance(arr.rbegin(), arr.rend()) == 3);
+  REQUIRE(arr.rend().base() == arr.begin());
+
+  *arr.rbegin() = 30;
+  REQUIRE(arr[Color::blue] == 30);
+}
+
+TEST_CASE("containers_set_list_assignment_replaces") {
+  magic_enum::containers::set<Color> s{Color::red, Color::green};
+  REQUIRE(s.size() == 2);
+
+  s = {Color::blue};
+  REQUIRE(s.size() == 1);
+  REQUIRE(s.contains(Color::blue));
+  REQUIRE_FALSE(s.contains(Color::red));
+
+  s = {};
+  REQUIRE(s.empty());
+}
+
+TEST_CASE("containers_set_reverse_iteration") {
+  magic_enum::containers::set<Color> s{Color::red, Color::blue};
+
+  std::string order;
+  for (auto it = s.rbegin(); it != s.rend(); ++it) {
+    order += magic_enum::enum_name(*it);
+    order += ',';
+  }
+  REQUIRE(order == "blue,red,");
+}
+
+TEST_CASE("containers_bitset_all_at_word_boundaries") {
+  // The base word type widens with the enumerator count, and the "leftover bits"
+  // branch is discarded when the count exactly fills a word - so a small enum
+  // never exercises the full-word path where all() does its work.
+  magic_enum::containers::bitset<Color> bs;
+  REQUIRE_FALSE(bs.all());
+  bs.set();
+  REQUIRE(bs.all());
+  REQUIRE(bs.count() == magic_enum::enum_count<Color>());
+  REQUIRE((~bs).count() == 0);
+}
+
+TEST_CASE("containers_bitset_raw_string_constructors") {
+  using bs_t = magic_enum::containers::bitset<Color>;
+  const auto raw = magic_enum::containers::raw_access;
+
+  REQUIRE(bs_t(raw, "101").to_string(raw) == "101");
+  REQUIRE(bs_t(raw, "101").to_string() == "red|blue");
+  REQUIRE(bs_t(raw, "111", 2).to_string() == "red|green");
+  REQUIRE(bs_t(raw, "bab", 3, 'a', 'b').to_string() == "red|blue");
+  REQUIRE(bs_t(raw, magic_enum::string_view{"XX010"}, 2).to_string() == "green");
+  REQUIRE(bs_t(raw, "101").to_ullong(raw) == 5);
+}
+
+TEST_CASE("containers_bitset_name_constructor_initializes_storage") {
+  // This constructor once had no member initializer, so the bits its names did
+  // not set were whatever the storage already held.
+  REQUIRE(magic_enum::containers::bitset<Color>{magic_enum::string_view{"green"}}.count() == 1);
+  REQUIRE(magic_enum::containers::bitset<Color>{magic_enum::string_view{"red|blue"}}.to_string(magic_enum::containers::raw_access) == "101");
+}
+
+TEST_CASE("containers_flags_construction_agrees_across_spellings") {
+  using flag_set_t = magic_enum::containers::set<Perm>;
+  const auto read_exec = static_cast<Perm>(5);
+
+  flag_set_t paren(read_exec);
+  flag_set_t braced{read_exec};
+  flag_set_t named{Perm::read, Perm::exec};
+  flag_set_t assigned;
+  assigned = {read_exec};
+
+  REQUIRE(paren.size() == 2);
+  REQUIRE(braced == paren);
+  REQUIRE(braced == named);
+  REQUIRE(braced == assigned);
+  REQUIRE(magic_enum::containers::bitset<Perm>{read_exec}.count() == 2);
+
+  // A plain enum is unaffected: a braced list still means one element each.
+  magic_enum::containers::set<Color> plain{Color::red, Color::blue};
+  REQUIRE(plain.size() == 2);
+}
+
+TEST_CASE("containers_flags_reject_unnamed_bits") {
+  // 8 names no enumerator; 9 is read plus an unnamed bit. Both containers must
+  // refuse rather than quietly drop the bit.
+  for (unsigned raw : {8u, 9u}) {
+    const auto bad = static_cast<Perm>(raw);
+    REQUIRE_THROWS_AS(magic_enum::containers::set<Perm>(bad), std::invalid_argument);
+    REQUIRE_THROWS_AS(magic_enum::containers::bitset<Perm>{bad}, std::invalid_argument);
+  }
+}
+
