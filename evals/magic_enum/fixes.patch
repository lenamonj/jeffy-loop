diff --git a/module/test_module.cpp b/module/test_module.cpp
new file mode 100644
index 0000000..2a2d73d
--- /dev/null
+++ b/module/test_module.cpp
@@ -0,0 +1,288 @@
+// Consumer of the C++20 module interface. It names every entity the export list
+// in magic_enum.cppm publishes, so a name dropped from that list fails this
+// build instead of rotting unnoticed, and it checks hand-computed answers so a
+// module that exports the names but reflects the wrong values fails too.
+
+// These includes are the requirement documented in the C++20 Module section of
+// doc/limitations.md, not incidental: the module does not make the standard
+// library's operators reachable, so a consumer that omits <optional> or
+// <string> cannot compare what magic_enum returns. They come before the import
+// because GCC reports redefinitions across the module's global module fragment
+// when a standard header is included after it.
+#include <cstdint>
+#include <cstdio>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <type_traits>
+
+import magic_enum;
+
+enum class Color : int { RED = -10, GREEN = 0, BLUE = 10 };
+enum Direction : int { LEFT = 1, RIGHT = 2 };
+enum class Perm : unsigned { read = 1, write = 2, exec = 4 };
+enum class Wide : int { LOW = -300, HIGH = 300 };
+enum class Mixed : unsigned { one = 1, two = 2, both = 3 };
+
+template <>
+struct magic_enum::customize::enum_range<Wide> {
+  static constexpr int min = -400;
+  static constexpr int max = 400;
+};
+
+static_assert(magic_enum::is_scoped_enum<Color>::value);
+static_assert(magic_enum::is_scoped_enum_v<Color>);
+static_assert(!magic_enum::is_scoped_enum_v<Direction>);
+static_assert(magic_enum::is_unscoped_enum<Direction>::value);
+static_assert(magic_enum::is_unscoped_enum_v<Direction>);
+static_assert(!magic_enum::is_unscoped_enum_v<Color>);
+static_assert(std::is_same_v<typename magic_enum::underlying_type<Color>::type, int>);
+static_assert(std::is_same_v<magic_enum::underlying_type_t<Perm>, unsigned>);
+static_assert(std::is_same_v<magic_enum::Enum<Color>, Color>);
+static_assert(std::is_same_v<magic_enum::char_type, char>);
+static_assert(std::is_same_v<magic_enum::string, std::string>);
+static_assert(std::is_same_v<magic_enum::string_view, std::string_view>);
+static_assert(std::is_same_v<magic_enum::optional<int>, std::optional<int>>);
+static_assert(magic_enum::enum_constant<Color::BLUE>::value == Color::BLUE);
+static_assert(magic_enum::is_magic_enum_supported);
+
+// Named only to keep the export list honest: these are index and comparator
+// policies a caller passes as a container template argument.
+using default_indexed = magic_enum::containers::default_indexing<Color>;
+using comparator_indexed = magic_enum::containers::comparator_indexing<>;
+using adl_defaults = magic_enum::customize::adl_info_holder<>;
+static_assert(adl_defaults::min == -128 && adl_defaults::max == 127 && !adl_defaults::is_flags);
+static_assert(std::is_same_v<decltype(magic_enum::customize::adl_info()), adl_defaults>);
+static_assert(std::is_same_v<magic_enum::containers::array<Color, int>::index_type, default_indexed>);
+
+static int failures = 0;
+
+#define CHECK(expr)                                                     \
+  do {                                                                  \
+    if (!(expr)) {                                                      \
+      std::printf("FAILED line %d: %s\n", __LINE__, #expr);             \
+      ++failures;                                                       \
+    }                                                                   \
+  } while (false)
+
+static void check_queries() {
+  CHECK(magic_enum::enum_type_name<Color>() == "Color");
+  CHECK(magic_enum::enum_count<Color>() == 3);
+  CHECK(magic_enum::enum_name(Color::GREEN) == "GREEN");
+  CHECK(magic_enum::enum_name<Color::BLUE>() == "BLUE");
+  CHECK(magic_enum::enum_names<Color>()[0] == "RED");
+  CHECK(magic_enum::enum_values<Color>()[2] == Color::BLUE);
+  CHECK(magic_enum::enum_value<Color>(1) == Color::GREEN);
+  CHECK(magic_enum::enum_entries<Color>()[1].first == Color::GREEN);
+  CHECK(magic_enum::enum_entries<Color>()[1].second == "GREEN");
+  CHECK(magic_enum::enum_integer(Color::BLUE) == 10);
+  CHECK(magic_enum::enum_index(Color::RED).value() == 0);
+  CHECK(magic_enum::enum_contains(Color::RED));
+  CHECK(!magic_enum::enum_contains<Color>(5));
+}
+
+static void check_cast() {
+  CHECK(magic_enum::enum_cast<Color>("BLUE").value() == Color::BLUE);
+  CHECK(magic_enum::enum_cast<Color>(0).value() == Color::GREEN);
+  CHECK(!magic_enum::enum_cast<Color>("PURPLE").has_value());
+  CHECK(!magic_enum::enum_cast<Color>(5).has_value());
+}
+
+static void check_customize() {
+  // Without the enum_range specialization above, both values sit outside the
+  // default -128..127 window and the count would be 0.
+  CHECK(magic_enum::enum_count<Wide>() == 2);
+  CHECK(magic_enum::enum_name(Wide::HIGH) == "HIGH");
+}
+
+static void check_utility() {
+  CHECK(magic_enum::enum_underlying(Color::BLUE) == 10);
+  CHECK(magic_enum::enum_reflected(Color::RED));
+  CHECK(magic_enum::enum_reflected<Color>(5));
+  CHECK(!magic_enum::enum_reflected<Color>(200));
+
+  CHECK(magic_enum::enum_next_value(Color::RED).value() == Color::GREEN);
+  CHECK(magic_enum::enum_next_value(Color::RED, 2).value() == Color::BLUE);
+  CHECK(!magic_enum::enum_next_value(Color::BLUE).has_value());
+  CHECK(magic_enum::enum_prev_value(Color::BLUE).value() == Color::GREEN);
+  CHECK(!magic_enum::enum_prev_value(Color::RED).has_value());
+  CHECK(magic_enum::enum_next_value_circular(Color::BLUE) == Color::RED);
+  CHECK(magic_enum::enum_prev_value_circular(Color::RED) == Color::BLUE);
+}
+
+static void check_customize_entities() {
+  CHECK(magic_enum::customize::enum_name(Color::RED) == magic_enum::customize::default_tag);
+  CHECK(magic_enum::customize::enum_type_name<Color>() == magic_enum::customize::default_tag);
+  CHECK(magic_enum::customize::invalid_tag != magic_enum::customize::default_tag);
+
+  const magic_enum::customize::customize_t named{"custom"};
+  CHECK(named.second == "custom");
+  CHECK(named != magic_enum::customize::default_tag);
+}
+
+static void check_case_insensitive() {
+  CHECK(magic_enum::enum_cast<Color>("red", magic_enum::case_insensitive).value() == Color::RED);
+  CHECK(!magic_enum::enum_cast<Color>("red").has_value());
+  CHECK(magic_enum::enum_contains<Color>("bLuE", magic_enum::case_insensitive));
+}
+
+static void check_subtype_tags() {
+  // Mixed::both is a combination, so the common reading counts it as an
+  // enumerator and the flags reading, which enumerates single bits, does not.
+  CHECK((magic_enum::enum_count<Mixed, magic_enum::as_common<>>()) == 3);
+  CHECK((magic_enum::enum_count<Mixed, magic_enum::as_flags<>>()) == 2);
+  CHECK(magic_enum::enum_name<magic_enum::as_common<>>(Mixed::both) == "both");
+  CHECK(magic_enum::enum_name<magic_enum::as_flags<>>(Mixed::both).empty());
+}
+
+static void check_switch_and_for_each() {
+  const auto doubled = magic_enum::enum_switch(
+      [](auto val) { return magic_enum::enum_integer(decltype(val)::value) * 2; }, Color::BLUE, 0);
+  CHECK(doubled == 20);
+
+  int sum = 0;
+  magic_enum::enum_for_each<Color>([&sum](auto val) { sum += magic_enum::enum_integer(decltype(val)::value); });
+  CHECK(sum == 0);
+}
+
+static void check_fuse() {
+  CHECK(magic_enum::enum_fuse(Color::RED, Color::BLUE).has_value());
+  CHECK(magic_enum::enum_fuse(Color::RED, Color::BLUE) != magic_enum::enum_fuse(Color::BLUE, Color::RED));
+  CHECK(magic_enum::enum_fuse(Color::RED, Color::BLUE) == magic_enum::enum_fuse(Color::RED, Color::BLUE));
+
+  // The result type is unique per argument pack, which is what stops two
+  // different fusions being compared by accident.
+  using cc = decltype(magic_enum::enum_fuse(Color::RED, Color::BLUE))::value_type;
+  using cd = decltype(magic_enum::enum_fuse(Color::RED, Direction::LEFT))::value_type;
+  static_assert(!std::is_same_v<cc, cd>);
+  static_assert(std::is_same_v<std::underlying_type_t<cc>, std::uintmax_t>);
+
+  switch (magic_enum::enum_fuse(Color::BLUE, Direction::RIGHT).value()) {
+    case magic_enum::enum_fuse(Color::RED, Direction::LEFT).value():
+      CHECK(false);
+      break;
+    case magic_enum::enum_fuse(Color::BLUE, Direction::RIGHT).value():
+      break;
+    default:
+      CHECK(false);
+      break;
+  }
+}
+
+static void check_flags() {
+  using namespace magic_enum::bitwise_operators;
+
+  const Perm rw = Perm::read | Perm::write;
+  CHECK(magic_enum::enum_integer(rw) == 3);
+  CHECK(magic_enum::enum_integer(rw & Perm::read) == 1);
+  CHECK(magic_enum::enum_integer(rw ^ Perm::read) == 2);
+  CHECK(magic_enum::enum_integer(~Perm::read) == ~1u);
+
+  Perm acc = Perm::read;
+  acc |= Perm::exec;
+  CHECK(magic_enum::enum_integer(acc) == 5);
+  acc &= rw;
+  CHECK(magic_enum::enum_integer(acc) == 1);
+  acc ^= Perm::write;
+  CHECK(magic_enum::enum_integer(acc) == 3);
+
+  CHECK(magic_enum::enum_flags_name(rw) == "read|write");
+  CHECK(magic_enum::enum_flags_contains(rw));
+  CHECK(!magic_enum::enum_flags_contains<Perm>(8u));
+  CHECK(magic_enum::enum_flags_cast<Perm>(5u).value() == (Perm::read | Perm::exec));
+  CHECK(magic_enum::enum_flags_cast<Perm>("read|exec").value() == (Perm::read | Perm::exec));
+
+  const Perm re = Perm::read | Perm::exec;
+  CHECK(magic_enum::enum_flags_test(re, Perm::read));
+  CHECK(!magic_enum::enum_flags_test(re, Perm::write));
+  CHECK(!magic_enum::enum_flags_test(re, static_cast<Perm>(0)));
+  CHECK(magic_enum::enum_flags_test_any(re, rw));
+  CHECK(!magic_enum::enum_flags_test_any(Perm::read, Perm::write));
+}
+
+static void check_containers_free() {
+  const auto from_array = magic_enum::containers::to_array<Color>({1, 2, 3});
+  CHECK(from_array[Color::RED] == 1);
+  CHECK(from_array[Color::BLUE] == 3);
+
+  auto made = magic_enum::containers::make_array<Color>(4, 5, 6);
+  CHECK(made[Color::GREEN] == 5);
+  CHECK(magic_enum::containers::get<0>(made) == 4);
+  CHECK(magic_enum::containers::get<Color::BLUE>(made) == 6);
+
+  // Names in value order are RED, GREEN, BLUE, so name order is BLUE, GREEN, RED.
+  CHECK(magic_enum::containers::name_less<Color>{}(Color::BLUE, Color::GREEN));
+  CHECK(!magic_enum::containers::name_less<Color>{}(Color::GREEN, Color::BLUE));
+  CHECK(magic_enum::containers::name_greater<Color>{}(Color::GREEN, Color::BLUE));
+  CHECK(magic_enum::containers::name_less_case_insensitive{}(Color::BLUE, Color::GREEN));
+  CHECK(magic_enum::containers::name_greater_case_insensitive{}(Color::GREEN, Color::BLUE));
+
+  magic_enum::containers::bitset<Color> bits;
+  bits.set(Color::RED);
+  bits.set(Color::BLUE);
+  CHECK(bits.to_string(magic_enum::containers::raw_access) == "101");
+}
+
+static void check_containers() {
+  magic_enum::containers::array<Color, int> arr{};
+  arr[Color::GREEN] = 7;
+  CHECK(arr.size() == 3);
+  CHECK(arr[Color::GREEN] == 7);
+  CHECK(arr[Color::RED] == 0);
+
+  magic_enum::containers::bitset<Color> bits;
+  bits.set(Color::RED);
+  bits.set(Color::BLUE);
+  CHECK(bits.count() == 2);
+  CHECK(bits.test(Color::RED));
+  CHECK(!bits.test(Color::GREEN));
+
+  magic_enum::containers::set<Color> items;
+  items.insert(Color::BLUE);
+  CHECK(items.size() == 1);
+  CHECK(items.count(Color::BLUE) == 1);
+  CHECK(items.count(Color::RED) == 0);
+}
+
+static void check_iostream() {
+  using namespace magic_enum::iostream_operators;
+
+  std::ostringstream out;
+  out << Color::BLUE;
+  CHECK(out.str() == "BLUE");
+
+  std::istringstream in{"GREEN"};
+  Color parsed{};
+  in >> parsed;
+  CHECK(!in.fail());
+  CHECK(parsed == Color::GREEN);
+
+  std::istringstream bad{"PURPLE"};
+  Color rejected{};
+  bad >> rejected;
+  CHECK(bad.fail());
+}
+
+int main() {
+  check_queries();
+  check_cast();
+  check_customize();
+  check_utility();
+  check_customize_entities();
+  check_case_insensitive();
+  check_subtype_tags();
+  check_switch_and_for_each();
+  check_fuse();
+  check_flags();
+  check_containers();
+  check_containers_free();
+  check_iostream();
+
+  if (failures == 0) {
+    std::printf("test_module: all checks passed\n");
+    return 0;
+  }
+  std::printf("test_module: %d check(s) failed\n", failures);
+  return 1;
+}
