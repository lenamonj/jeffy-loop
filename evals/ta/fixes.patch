+"""Every module-level delegate must equal the class method it wraps.
+
+These functions are half the documented public API - the README lists a
+`defs` column beside every indicator class - and none of them had a test, so a
+wrong keyword in a three-line pass-through would have reached users unnoticed.
+"""
+
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta import others as others_mod
+from ta import trend as trend_mod
+from ta import volume as volume_mod
+
+_ROWS = 120
+
+
+def _series():
+    index = np.arange(_ROWS, dtype=float)
+    close = pd.Series(100.0 + 8.0 * np.sin(index / 7.0) + 0.25 * index)
+    high = close + 1.0 + 0.5 * np.abs(np.sin(index / 3.0))
+    low = close - 1.0 - 0.5 * np.abs(np.cos(index / 5.0))
+    volume = pd.Series(1000.0 + 300.0 * np.sin(index / 11.0) + 4.0 * index)
+    return high, low, close, volume
+
+
+class TestModuleDelegates(unittest.TestCase):
+    _high: pd.Series
+    _low: pd.Series
+    _close: pd.Series
+    _volume: pd.Series
+
+    @classmethod
+    def setUpClass(cls):
+        cls._high, cls._low, cls._close, cls._volume = _series()
+
+    def test_each_delegate_equals_its_class_method(self):
+        close, high, low, volume = self._close, self._high, self._low, self._volume
+        pairs = [
+            (
+                others_mod.daily_return(close=close),
+                others_mod.DailyReturnIndicator(close=close).daily_return(),
+            ),
+            (
+                others_mod.daily_log_return(close=close),
+                others_mod.DailyLogReturnIndicator(close=close).daily_log_return(),
+            ),
+            (
+                others_mod.cumulative_return(close=close),
+                others_mod.CumulativeReturnIndicator(close=close).cumulative_return(),
+            ),
+            (
+                trend_mod.ema_indicator(close=close, window=12),
+                trend_mod.EMAIndicator(close=close, window=12).ema_indicator(),
+            ),
+            (
+                trend_mod.sma_indicator(close=close, window=12),
+                trend_mod.SMAIndicator(close=close, window=12).sma_indicator(),
+            ),
+            (
+                trend_mod.trix(close=close, window=15),
+                trend_mod.TRIXIndicator(close=close, window=15).trix(),
+            ),
+            (
+                trend_mod.mass_index(high=high, low=low, window_fast=9, window_slow=25),
+                trend_mod.MassIndex(
+                    high=high, low=low, window_fast=9, window_slow=25
+                ).mass_index(),
+            ),
+            (
+                trend_mod.dpo(close=close, window=20),
+                trend_mod.DPOIndicator(close=close, window=20).dpo(),
+            ),
+            (trend_mod.kst(close=close), trend_mod.KSTIndicator(close=close).kst()),
+            (
+                trend_mod.kst_sig(close=close),
+                trend_mod.KSTIndicator(close=close).kst_sig(),
+            ),
+            (
+                trend_mod.ichimoku_conversion_line(high=high, low=low),
+                trend_mod.IchimokuIndicator(
+                    high=high, low=low
+                ).ichimoku_conversion_line(),
+            ),
+            (
+                trend_mod.ichimoku_base_line(high=high, low=low),
+                trend_mod.IchimokuIndicator(high=high, low=low).ichimoku_base_line(),
+            ),
+            (
+                trend_mod.ichimoku_a(high=high, low=low),
+                trend_mod.IchimokuIndicator(high=high, low=low).ichimoku_a(),
+            ),
+            (
+                trend_mod.ichimoku_b(high=high, low=low),
+                trend_mod.IchimokuIndicator(high=high, low=low).ichimoku_b(),
+            ),
+            (
+                trend_mod.aroon_up(high=high, low=low, window=25),
+                trend_mod.AroonIndicator(high=high, low=low, window=25).aroon_up(),
+            ),
+            (
+                trend_mod.aroon_down(high=high, low=low, window=25),
+                trend_mod.AroonIndicator(high=high, low=low, window=25).aroon_down(),
+            ),
+            (
+                volume_mod.chaikin_money_flow(
+                    high=high, low=low, close=close, volume=volume
+                ),
+                volume_mod.ChaikinMoneyFlowIndicator(
+                    high=high, low=low, close=close, volume=volume
+                ).chaikin_money_flow(),
+            ),
+            (
+                volume_mod.negative_volume_index(close=close, volume=volume),
+                volume_mod.NegativeVolumeIndexIndicator(
+                    close=close, volume=volume
+                ).negative_volume_index(),
+            ),
+        ]
+        self.assertEqual(len(pairs), 18)
+        for index, (delegated, direct) in enumerate(pairs):
+            with self.subTest(delegate=index):
+                pd.testing.assert_series_equal(delegated, direct)
+
+
+class TestUnexercisedOptions(unittest.TestCase):
+    """Option and error paths that no test reached."""
+
+    def test_volume_price_trend_dropnans_shortens_the_result(self):
+        _, _, close, volume = _series()
+        kept = volume_mod.volume_price_trend(close=close, volume=volume)
+        dropped = volume_mod.volume_price_trend(
+            close=close, volume=volume, dropnans=True
+        )
+        self.assertEqual(len(kept), _ROWS)
+        self.assertEqual(len(dropped), _ROWS - 1)
+        self.assertFalse(dropped.isna().any())
+
+    def test_volume_price_trend_smoothing_factor_delays_the_first_value(self):
+        _, _, close, volume = _series()
+        smoothed = volume_mod.volume_price_trend(
+            close=close, volume=volume, smoothing_factor=5
+        )
+        self.assertEqual(smoothed.first_valid_index(), 5)
+
+    def test_adx_rejects_a_zero_window(self):
+        high, low, close, _ = _series()
+        with self.assertRaises(ValueError):
+            trend_mod.ADXIndicator(high=high, low=low, close=close, window=0)
+
+    def test_adx_directional_indicators_are_zero_without_true_range(self):
+        # A perfectly flat market gives a zero smoothed true range, which is
+        # the branch adx_pos and adx_neg take to avoid dividing by it. The
+        # branch yields a real 0.0, so it is asserted only where the indicator
+        # is defined; the warm-up rows ahead of the seed are NaN, and keeping
+        # the two apart is the whole point of the distinction.
+        window = 14
+        flat = pd.Series([50.0] * 60)
+        indicator = trend_mod.ADXIndicator(
+            high=flat, low=flat, close=flat, window=window, fillna=False
+        )
+        for name, series in (
+            ("adx_pos", indicator.adx_pos()),
+            ("adx_neg", indicator.adx_neg()),
+        ):
+            with self.subTest(accessor=name):
+                self.assertTrue(series.iloc[: window + 1].isna().all())
+                defined = series.iloc[window + 1 :]
+                self.assertFalse(defined.empty)
+                self.assertTrue((defined == 0.0).all())
