new file mode 100644
index 0000000..63c23ea
--- /dev/null
+++ b/test/unit/invariants.py
@@ -0,0 +1,311 @@
+"""Cross-cutting invariants that hold for every public indicator.
+
+The existing suite builds every fixture with ``pd.read_csv(...)``, which yields a
+default RangeIndex, and asserts only on ``.tail()``. Two whole classes of defect
+are invisible to it: indexing that only misbehaves on a non-RangeIndex frame, and
+warm-up rows fabricated from whole-series aggregates. These tests enumerate every
+public indicator function rather than sampling, so a new site cannot slip in.
+"""
+import inspect
+import unittest
+
+import numpy as np
+import pandas as pd
+
+import ta.momentum
+import ta.others
+import ta.trend
+import ta.volatility
+import ta.volume
+from ta.trend import ADXIndicator, adx, adx_neg, adx_pos
+from ta.volatility import AverageTrueRange, BollingerBands
+
+_N = 240
+_COLUMNS = {}
+
+
+def _synthetic_ohlcv(rows: int = _N, seed: int = 11) -> dict:
+    """Deterministic OHLCV, so the enumeration needs no data file."""
+    rng = np.random.default_rng(seed)
+    close = 100.0 * np.exp(np.cumsum(rng.normal(0.0, 0.012, rows)))
+    spread = np.abs(rng.normal(0.0, 0.006, rows)) * close
+    open_ = np.roll(close, 1)
+    open_[0] = close[0]
+    return {
+        "open": open_,
+        "high": close + spread,
+        "low": close - spread,
+        "close": close,
+        "volume": rng.uniform(1e5, 1e6, rows),
+    }
+
+
+def _public_indicators():
+    """Every module-level indicator function taking OHLCV series."""
+    found = []
+    for module in (ta.momentum, ta.others, ta.trend, ta.volatility, ta.volume):
+        for name, func in vars(module).items():
+            if name.startswith("_") or not inspect.isfunction(func):
+                continue
+            if func.__module__ != module.__name__:
+                continue
+            columns = [p for p in inspect.signature(func).parameters if p in _COLUMNS]
+            if columns:
+                found.append((f"{module.__name__}.{name}", func, columns))
+    return sorted(found)
+
+
+_COLUMNS.update(_synthetic_ohlcv())
+_INDICATORS = _public_indicators()
+
+
+def _call(func, columns, index, rows=_N):
+    kwargs = {c: pd.Series(_COLUMNS[c][:rows], index=index[:rows]) for c in columns}
+    return func(**kwargs)
+
+
+def _mismatch(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    return ~(
+        np.isclose(left, right, rtol=1e-12, atol=1e-12)
+        | (np.isnan(left) & np.isnan(right))
+    )
+
+
+class TestIndicatorsAreIndexAgnostic(unittest.TestCase):
+    """An indicator must depend on row order, never on the index labels.
+
+    Regression test for issue #354: PSARIndicator mixed ``self._psar[i]`` with
+    ``self._psar.iloc[i]``, so on a DatetimeIndex or a gapped integer index -
+    the latter being exactly what ``ta.utils.dropna`` leaves behind - the two
+    branches addressed different rows.
+    """
+
+    _indexes = {
+        "datetime": pd.date_range("2020-01-01", periods=_N, freq="B"),
+        # what ta.utils.dropna leaves: integer labels with gaps
+        "gapped_int": pd.Index([i * 3 + 7 for i in range(_N)]),
+        "reversed_int": pd.Index(list(range(_N - 1, -1, -1))),
+    }
+
+    def test_every_public_indicator(self):
+        self.assertGreater(len(_INDICATORS), 50)
+        baseline_index = pd.RangeIndex(_N)
+        failures = []
+        for name, func, columns in _INDICATORS:
+            expected = _call(func, columns, baseline_index)
+            for label, index in self._indexes.items():
+                got = _call(func, columns, index)
+                if len(got) != len(expected):
+                    failures.append(
+                        f"{name} [{label}]: length {len(got)} != {len(expected)}"
+                    )
+                    continue
+                bad = _mismatch(
+                    expected.to_numpy(dtype=float), got.to_numpy(dtype=float)
+                )
+                if bad.any():
+                    failures.append(
+                        f"{name} [{label}]: {int(bad.sum())} of {len(bad)} rows differ"
+                    )
+        self.assertEqual([], failures)
+
+
+class TestIndicatorsDoNotLookAhead(unittest.TestCase):
+    """Row k must not change when rows after k are appended.
+
+    Regression test for the ``fill_value=<whole-series aggregate>`` idiom: KST
+    substituted ``self._close.mean()`` for its missing warm-up history, so 30 of
+    its output rows were computed from prices that had not happened yet.
+    """
+
+    def test_every_public_indicator(self):
+        cut = 160
+        index = pd.RangeIndex(_N)
+        failures = []
+        for name, func, columns in _INDICATORS:
+            full = _call(func, columns, index).to_numpy(dtype=float)[:cut]
+            truncated = _call(func, columns, index, rows=cut).to_numpy(dtype=float)
+            bad = _mismatch(full, truncated)
+            if bad.any():
+                failures.append(
+                    f"{name}: {int(bad.sum())} of {cut} rows change when later "
+                    f"rows are appended, first at row {int(np.argmax(bad))}"
+                )
+        self.assertEqual([], failures)
+
+
+class TestADXWarmUpBoundary(unittest.TestCase):
+    """+DI and -DI must report their first defined bar, not a zero.
+
+    Regression test for issue #314: the smoothing loops started at index 1, so
+    the seed element of ``_trs``/``_dip``/``_din`` was never consumed and the bar
+    at ``window`` came back as 0.0 - indistinguishable from the zero padding.
+    """
+
+    _filename = "test/data/cs-adx.csv"
+
+    @classmethod
+    def setUpClass(cls):
+        cls._df = pd.read_csv(cls._filename, sep=",")
+        cls._params = {
+            "high": cls._df["High"],
+            "low": cls._df["Low"],
+            "close": cls._df["Close"],
+            "window": 14,
+            "fillna": False,
+        }
+
+    @classmethod
+    def tearDownClass(cls):
+        del cls._df
+
+    def test_adx_pos_head(self):
+        result = adx_pos(**self._params)
+        expected = self._df["+DI14"]
+        rows = expected.notna()
+        pd.testing.assert_series_equal(
+            expected[rows].head(20),
+            result[rows].head(20),
+            check_names=False,
+            rtol=1e-5,
+        )
+
+    def test_adx_neg_head(self):
+        result = adx_neg(**self._params)
+        expected = self._df["-DI14"]
+        rows = expected.notna()
+        pd.testing.assert_series_equal(
+            expected[rows].head(20),
+            result[rows].head(20),
+            check_names=False,
+            rtol=1e-5,
+        )
+
+    def test_adx_tail_unchanged(self):
+        pd.testing.assert_series_equal(
+            self._df["ADX"].tail(), adx(**self._params).tail(), check_names=False
+        )
+
+
+class TestWarmUpPreconditions(unittest.TestCase):
+    """Too-short input must be refused by name, not by a numpy IndexError."""
+
+    @staticmethod
+    def _frame(rows):
+        columns = _synthetic_ohlcv(rows)
+        return {k: pd.Series(v) for k, v in columns.items()}
+
+    def test_adx_construction_rejects_short_input(self):
+        for rows in (1, 10, 14):
+            data = self._frame(rows)
+            with self.assertRaises(ValueError) as ctx:
+                ADXIndicator(
+                    high=data["high"], low=data["low"], close=data["close"], window=14
+                )
+            self.assertIn("ADXIndicator requires at least 15 rows", str(ctx.exception))
+
+    def test_adx_series_rejects_input_shorter_than_two_windows(self):
+        data = self._frame(2 * 14 - 1)
+        indicator = ADXIndicator(
+            high=data["high"], low=data["low"], close=data["close"], window=14
+        )
+        with self.assertRaises(ValueError) as ctx:
+            indicator.adx()
+        self.assertIn("ADXIndicator requires at least 28 rows", str(ctx.exception))
+        # +DI / -DI need only window + 1 bars and stay available
+        self.assertEqual(2 * 14 - 1, len(indicator.adx_pos()))
+
+    def test_adx_accepts_exactly_two_windows(self):
+        data = self._frame(2 * 14)
+        indicator = ADXIndicator(
+            high=data["high"], low=data["low"], close=data["close"], window=14
+        )
+        self.assertEqual(2 * 14, len(indicator.adx()))
+
+    def test_average_true_range_rejects_short_input(self):
+        for rows in (1, 13):
+            data = self._frame(rows)
+            with self.assertRaises(ValueError) as ctx:
+                AverageTrueRange(
+                    high=data["high"], low=data["low"], close=data["close"], window=14
+                )
+            self.assertIn(
+                "AverageTrueRange requires at least 14 rows", str(ctx.exception)
+            )
+
+    def test_average_true_range_accepts_exactly_one_window(self):
+        data = self._frame(14)
+        indicator = AverageTrueRange(
+            high=data["high"], low=data["low"], close=data["close"], window=14
+        )
+        self.assertEqual(14, len(indicator.average_true_range()))
+
+
+class TestBollingerUsesPopulationDeviation(unittest.TestCase):
+    """ddof=0 is deliberate; pin it against StockCharts' published numbers.
+
+    Issue #307 reads the pandas default (ddof=1) as the standard. It is not: the
+    project's own reference file agrees with ddof=0 and disagrees with ddof=1.
+    """
+
+    _filename = "test/data/cs-bbands.csv"
+
+    @classmethod
+    def setUpClass(cls):
+        cls._df = pd.read_csv(cls._filename, sep=",")
+
+    @classmethod
+    def tearDownClass(cls):
+        del cls._df
+
+    def test_matches_population_deviation(self):
+        close = self._df["Close"]
+        expected = self._df["20-day Standard Deviation"]
+        rows = expected.notna()
+        self.assertGreater(int(rows.sum()), 10)
+        population = close.rolling(20, min_periods=20).std(ddof=0)
+        sample = close.rolling(20, min_periods=20).std(ddof=1)
+        self.assertLess(float((population[rows] - expected[rows]).abs().max()), 1e-5)
+        self.assertGreater(float((sample[rows] - expected[rows]).abs().max()), 1e-2)
+
+    def test_bands_match_reference(self):
+        indicator = BollingerBands(close=self._df["Close"], window=20, window_dev=2)
+        rows = self._df["HighBand"].notna()
+        self.assertLess(
+            float(
+                (indicator.bollinger_hband()[rows] - self._df["HighBand"][rows])
+                .abs()
+                .max()
+            ),
+            1e-5,
+        )
+        self.assertLess(
+            float(
+                (indicator.bollinger_lband()[rows] - self._df["LowBand"][rows])
+                .abs()
+                .max()
+            ),
+            1e-5,
+        )
+
+
+class TestPSARDownIndicator(unittest.TestCase):
+    """psar_down_indicator must be derived from the down series it reports on."""
+
+    def test_flags_every_down_reversal(self):
+        data = _synthetic_ohlcv(400, seed=3)
+        indicator = ta.trend.PSARIndicator(
+            high=pd.Series(data["high"]),
+            low=pd.Series(data["low"]),
+            close=pd.Series(data["close"]),
+        )
+        down = indicator.psar_down()
+        expected = (down.notnull() & down.shift(1).isnull()).astype(float)
+        self.assertGreater(float(expected.sum()), 0.0)
+        pd.testing.assert_series_equal(
+            expected, indicator.psar_down_indicator(), check_names=False
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
