+++ b/test/unit/vectorized.py
@@ -0,0 +1,102 @@
+"""The vectorized flag computes a subset, and the docstrings must say so.
+
+The flag read "if True, use only vectorized functions indicators", which is
+both ungrammatical and silent about the consequence: add_all_ta_features
+returns 86 features with it off and 68 with it on. The 68 it does return are
+identical either way, so the flag was correct and only underdescribed.
+
+Each wrapper's docstring now names a count, which makes it a claim this test
+can check against what the wrapper actually produces.
+"""
+
+import re
+import unittest
+from collections.abc import Callable
+
+import pandas as pd
+
+from ta import (
+    add_all_ta_features,
+    add_momentum_ta,
+    add_trend_ta,
+    add_volatility_ta,
+    add_volume_ta,
+)
+
+_ROWS = 200
+
+# wrapper, its price arguments, total features, features omitted when vectorized
+_WRAPPERS: list[tuple[Callable[..., pd.DataFrame], tuple[str, ...], int, int]] = [
+    (add_volume_ta, ("high", "low", "close", "volume"), 10, 2),
+    (add_volatility_ta, ("high", "low", "close"), 21, 2),
+    (add_trend_ta, ("high", "low", "close"), 34, 13),
+    (add_momentum_ta, ("high", "low", "close", "volume"), 18, 1),
+    (add_all_ta_features, ("open", "high", "low", "close", "volume"), 86, 18),
+]
+
+_COLUMN_OF = {
+    "open": "Open",
+    "high": "High",
+    "low": "Low",
+    "close": "Close",
+    "volume": "Volume",
+}
+
+
+def _frame() -> pd.DataFrame:
+    prices = [100.0 + (step % 17) * 0.5 + step * 0.1 for step in range(_ROWS)]
+    return pd.DataFrame(
+        {
+            "Open": [price - 0.5 for price in prices],
+            "High": [price + 1.0 for price in prices],
+            "Low": [price - 1.0 for price in prices],
+            "Close": prices,
+            "Volume": [1000.0 + step for step in range(_ROWS)],
+        },
+        dtype="float64",
+    )
+
+
+class TestVectorizedSubset(unittest.TestCase):
+    """What the flag omits is documented, counted, and otherwise identical."""
+
+    def test_each_wrapper_omits_the_number_its_docstring_states(self):
+        frame = _frame()
+        for wrapper, arguments, total, omitted in _WRAPPERS:
+            names = {name: _COLUMN_OF[name] for name in arguments}
+            with self.subTest(wrapper=wrapper.__name__):
+                full = wrapper(frame.copy(), **names, fillna=False, vectorized=False)
+                subset = wrapper(frame.copy(), **names, fillna=False, vectorized=True)
+                produced = full.shape[1] - frame.shape[1]
+                reduced = subset.shape[1] - frame.shape[1]
+                self.assertEqual(produced, total)
+                self.assertEqual(produced - reduced, omitted)
+
+                # the docstring states both numbers, so read them back from it
+                text = wrapper.__doc__ or ""
+                stated = re.search(
+                    r"omits (\d+) of the (\d+) features", text.replace("\n", " ")
+                )
+                if stated is None:
+                    self.fail(f"{wrapper.__name__} docstring states no count")
+                self.assertEqual(int(stated.group(1)), omitted)
+                self.assertEqual(int(stated.group(2)), total)
+
+    def test_the_shared_columns_are_identical(self):
