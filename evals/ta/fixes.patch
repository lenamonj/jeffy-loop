index 0000000..e6008b2
--- /dev/null
+++ b/test/unit/windows.py
@@ -0,0 +1,132 @@
+"""A lookback period below 1 must be reported, not absorbed.
+
+pandas hides both bad values. `rolling(0)` returns an all-NaN series, so a
+zero window left 21 of the windowed classes handing back nothing at all with no
+complaint. A negative period is worse: it reaches `shift`, which reads forward,
+so ROCIndicator(window=-5) returned finite numbers derived from bars that had
+not happened, and AverageTrueRange(window=-5) returned plausible ATR-shaped
+values a caller could not tell from real ones.
+
+Every period argument is checked here by driving the classes, not by listing
+the ones that were broken, so a new indicator inherits the requirement.
+"""
+
+import inspect
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta import momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin
+
+_MODULES = (momentum, others, trend, volatility, volume)
+_PRICE_PARAMETERS = frozenset({"open", "high", "low", "close", "volume"})
+
+# Arguments that count a number of past bars. Excluded deliberately, because
+# none of them is a period: window_dev is a standard-deviation count for the
+# Bollinger bands, multiplier scales the Keltner bands, offset is a shift whose
+# own default is 0, and step, max_step, constant and weight1..3 are float
+# coefficients.
+_PERIODS = frozenset(
+    {
+        "window",
+        "window1",
+        "window2",
+        "window3",
+        "window4",
+        "window_atr",
+        "window_fast",
+        "window_sign",
+        "window_slow",
+        "lbp",
+        "smooth_window",
+        "smooth1",
+        "smooth2",
+        "cycle",
+        "nsig",
+        "roc1",
+        "roc2",
+        "roc3",
+        "roc4",
+        "pow1",
+        "pow2",
+        "smoothing_factor",
+    }
+)
+
+_ROWS = 60
+
+
+def _prices() -> dict[str, pd.Series]:
+    index = np.arange(_ROWS, dtype=float)
+    close = pd.Series(100.0 + 8.0 * np.sin(index / 7.0) + 0.25 * index)
+    return {
+        "close": close,
+        "open": close - 0.5,
+        "high": close + 1.0,
+        "low": close - 1.0,
+        "volume": pd.Series(1000.0 + index),
+    }
+
+
+def _windowed_classes():
+    """Every class with at least one period argument, and those arguments."""
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ != module.__name__:
+                continue
+            parameters = inspect.signature(cls.__init__).parameters
+            periods = [name for name in parameters if name in _PERIODS]
+            if periods:
+                yield cls, parameters, periods
+
+
+class TestWindowValidation(unittest.TestCase):
+    """No indicator may absorb a period below 1."""
+
+    def test_every_period_argument_is_rejected_below_one(self):
+        prices = _prices()
+        checked = 0
+        for cls, parameters, periods in _windowed_classes():
+            base = {
+                name: prices[name] for name in parameters if name in _PRICE_PARAMETERS
+            }
+            for period in periods:
+                for bad in (0, -5):
+                    with self.subTest(indicator=cls.__name__, period=period, value=bad):
+                        with self.assertRaises(ValueError) as raised:
+                            cls(**base, **{period: bad})
+                        message = str(raised.exception)
+                        self.assertIn(period, message)
+                        self.assertIn(str(bad), message)
+                    checked += 1
+        # 67 period arguments across the 43 classes, each driven with 0 and -5.
+        self.assertEqual(checked, 134)
+
+    def test_a_valid_period_is_untouched(self):
+        prices = _prices()
+        for cls, parameters, _ in _windowed_classes():
+            base = {
+                name: prices[name] for name in parameters if name in _PRICE_PARAMETERS
+            }
+            with self.subTest(indicator=cls.__name__):
+                indicator = cls(**base)
+                for name, method in inspect.getmembers(indicator, inspect.ismethod):
+                    if not name.startswith("_"):
+                        self.assertEqual(len(method()), _ROWS)
+
+    def test_smoothing_factor_still_accepts_none(self):
+        # None is the documented way to ask for no smoothing, and it must stay
+        # distinct from 0, which the truthiness test used to conflate with it.
+        prices = _prices()
+        unsmoothed = volume.VolumePriceTrendIndicator(
+            close=prices["close"], volume=prices["volume"], smoothing_factor=None
+        ).volume_price_trend()
+        self.assertEqual(len(unsmoothed), _ROWS)
+        with self.assertRaises(ValueError):
+            volume.VolumePriceTrendIndicator(
+                close=prices["close"], volume=prices["volume"], smoothing_factor=0
+            )
