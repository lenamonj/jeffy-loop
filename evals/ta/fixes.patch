+"""A returned series must not be labelled as another indicator's.
+
+Five KeltnerChannel accessors carried names copied from elsewhere: the middle
+band was 'mavg' and the width and percentage bands were 'bbiwband' and
+'bbipband', all three Bollinger's, and the two band indicators were 'dcihband'
+and 'dcilband', Donchian's. Three of the five collided outright with the
+Bollinger accessors that own those names.
+
+add_all_ta_features never showed it, because the wrapper assigns its own column
+names, so only a caller using an accessor directly saw the wrong label - which
+is exactly why enumerating the accessors is the check, not reading the wrapper.
+"""
+
+import collections
+import inspect
+import unittest
+
+import pandas as pd
+
+from ta import momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin, dropna
+
+_MODULES = (momentum, others, trend, volatility, volume)
+_PRICE_PARAMETERS = frozenset({"open", "high", "low", "close", "volume"})
+_ROWS = 200
+
+
+def _prices() -> dict[str, pd.Series]:
+    frame = dropna(pd.read_csv("test/data/datas.csv", sep=",")).head(_ROWS)
+    return {
+        "open": frame["Open"],
+        "high": frame["High"],
+        "low": frame["Low"],
+        "close": frame["Close"],
+        "volume": frame["Volume_BTC"],
+    }
+
+
+def _accessor_names(prices):
+    """(class name, accessor name, the name of the series it returns)."""
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ != module.__name__:
+                continue
+            parameters = inspect.signature(cls.__init__).parameters
+            arguments = {
+                name: prices[name] for name in parameters if name in _PRICE_PARAMETERS
+            }
+            if not arguments:
+                continue
+            indicator = cls(**arguments)
+            for name, method in inspect.getmembers(indicator, inspect.ismethod):
+                if not name.startswith("_"):
+                    yield cls.__name__, name, method().name
+
+
+class TestSeriesNames(unittest.TestCase):
+    """Every accessor owns its series name."""
+
+    def test_no_two_accessors_share_a_series_name(self):
+        owners = collections.defaultdict(list)
+        for indicator, accessor, series_name in _accessor_names(_prices()):
+            owners[series_name].append(f"{indicator}.{accessor}")
+        shared = {name: who for name, who in owners.items() if len(who) > 1}
+        self.assertEqual(shared, {})
+        self.assertEqual(len(owners), 84)
+
+    def test_keltner_labels_its_own_bands(self):
+        # The concrete fix: five of these seven were Bollinger's or Donchian's.
+        names = {
+            accessor: series_name
+            for indicator, accessor, series_name in _accessor_names(_prices())
+            if indicator == "KeltnerChannel"
+        }
+        self.assertEqual(len(names), 7)
+        for accessor, series_name in names.items():
+            with self.subTest(accessor=accessor):
+                self.assertTrue(series_name.startswith("kc_"))
