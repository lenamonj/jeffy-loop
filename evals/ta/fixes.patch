index 0000000..0e5e4c6
--- /dev/null
+++ b/test/unit/defaults.py
@@ -0,0 +1,119 @@
+"""A delegate and its class must agree on what their parameters default to.
+
+The README presents the class and the module function as two ways to call one
+indicator, so a default that drifts between them makes the same documented
+indicator return two different series. Three had drifted: SMAIndicator required
+a window its delegate defaulted to 12, and the Donchian middle, width and
+percentage delegates defaulted to a 10-bar window while their class and their
+own hband and lband siblings used 20 - so composing those delegates produced a
+middle band that was not the midpoint of the channel around it.
+
+One mismatch is deliberately left and pinned below, because choosing a side
+changes published output with no correctness argument either way.
+"""
+
+import ast
+import inspect
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta import momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin
+
+_MODULES = (momentum, others, trend, volatility, volume)
+_PRICE_PARAMETERS = frozenset({"open", "high", "low", "close", "volume"})
+
+# No delegate may disagree with the class it wraps. The last exception was
+# EMAIndicator's window, 14 against its delegate's 12; the maintainer resolved
+# it by moving the class to 12, which is what SMAIndicator and both moving
+# average delegates already use. Empty is the contract: an entry here is a
+# published inconsistency, so adding one takes a decision, not a commit.
+_ACCEPTED_DRIFT: set[tuple[str, str, str]] = set()
+
+
+def _delegate_class(module, function_node):
+    """The indicator class a module-level delegate constructs, if any."""
+    for node in ast.walk(function_node):
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
+            candidate = getattr(module, node.func.id, None)
+            if inspect.isclass(candidate) and issubclass(candidate, IndicatorMixin):
+                return candidate
+    return None
+
+
+def _default(parameter) -> object:
+    if parameter.default is inspect.Parameter.empty:
+        return "REQUIRED"
+    return parameter.default
+
+
+def _drifted_defaults() -> set[tuple[str, str, str]]:
+    drift: set[tuple[str, str, str]] = set()
+    for module in _MODULES:
+        tree = ast.parse(inspect.getsource(module))
+        for node in tree.body:
+            if not isinstance(node, ast.FunctionDef):
+                continue
+            cls = _delegate_class(module, node)
+            if cls is None:
+                continue
+            delegate = inspect.signature(getattr(module, node.name))
+            constructor = inspect.signature(cls.__init__)
+            for name, parameter in delegate.parameters.items():
+                counterpart = constructor.parameters.get(name)
+                if counterpart is None:
+                    continue
+                if _default(parameter) != _default(counterpart):
+                    drift.add((node.name, cls.__name__, name))
+    return drift
+
+
+def _indicator_classes():
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ == module.__name__:
+                yield cls
+
+
+class TestDelegateDefaults(unittest.TestCase):
+    """Two documented ways to call one indicator must mean the same thing."""
+
+    def test_no_delegate_default_drifts_from_its_class(self):
+        self.assertEqual(_drifted_defaults(), _ACCEPTED_DRIFT)
+
+    def test_no_class_requires_a_non_price_parameter(self):
+        required = {}
+        for cls in _indicator_classes():
+            parameters = inspect.signature(cls.__init__).parameters
+            missing = [
+                name
+                for name, parameter in parameters.items()
+                if name != "self"
+                and name not in _PRICE_PARAMETERS
+                and parameter.default is inspect.Parameter.empty
+            ]
+            if missing:
+                required[cls.__name__] = missing
+        self.assertEqual(required, {})
+
+    def test_the_donchian_delegates_compose_into_one_channel(self):
+        # Each delegate is called with its own default window, which is the
+        # whole point: a user who omits the argument must still get bands that
+        # belong to the same channel.
+        index = np.arange(60, dtype=float)
+        close = pd.Series(100.0 + 8.0 * np.sin(index / 7.0) + 0.25 * index)
+        high, low = close + 1.0, close - 1.0
+        bands = {
+            name: getattr(volatility, f"donchian_channel_{name}")(
+                high=high, low=low, close=close
+            )
+            for name in ("hband", "lband", "mband")
+        }
+        midpoint = bands["lband"] + (bands["hband"] - bands["lband"]) / 2
+        pd.testing.assert_series_equal(
+            bands["mband"], midpoint, check_names=False, check_exact=False
+        )
