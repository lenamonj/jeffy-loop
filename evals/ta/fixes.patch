@@ -0,0 +1,243 @@
+"""Definition tests for indicators that shipped without any test.
+
+Each case checks the indicator against its formula expressed directly in
+pandas, or against a property the definition forces, rather than against a
+snapshot of the current output. Pinning current output would have frozen the
+lookahead bias these indicators carried until it was removed.
+"""
+
+import math
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta.momentum import AwesomeOscillatorIndicator, awesome_oscillator
+from ta.others import (
+    CumulativeReturnIndicator,
+    DailyLogReturnIndicator,
+    DailyReturnIndicator,
+)
+from ta.trend import (
+    AroonIndicator,
+    DPOIndicator,
+    EMAIndicator,
+    IchimokuIndicator,
+    KSTIndicator,
+    MassIndex,
+    SMAIndicator,
+    TRIXIndicator,
+)
+from ta.volume import (
+    ChaikinMoneyFlowIndicator,
+    NegativeVolumeIndexIndicator,
+    OnBalanceVolumeIndicator,
+)
+
+_ROWS = 120
+
+
+def _series():
+    """Deterministic OHLCV, long enough for the widest window (Ichimoku 52)."""
+    i = np.arange(_ROWS, dtype=float)
+    close = pd.Series(100.0 + 10.0 * np.sin(i / 7.0) + 0.3 * i)
+    high = close + 1.0 + 0.5 * np.abs(np.sin(i / 3.0))
+    low = close - 1.0 - 0.5 * np.abs(np.cos(i / 5.0))
+    volume = pd.Series(1000.0 + 300.0 * np.sin(i / 11.0) + 5.0 * i)
+    return high, low, close, volume
+
+
+def _ema(series, window):
+    return series.ewm(span=window, min_periods=window, adjust=False).mean()
+
+
+def _assert(actual, expected):
+    pd.testing.assert_series_equal(actual, expected, check_names=False)
+
+
+class TestMovingAverageDefinitions(unittest.TestCase):
+    def setUp(self):
+        self._high, self._low, self._close, self._volume = _series()
+
+    def test_sma_is_a_rolling_mean(self):
+        _assert(
+            SMAIndicator(close=self._close, window=12).sma_indicator(),
+            self._close.rolling(12).mean(),
+        )
+
+    def test_ema_is_an_unadjusted_span_ewm(self):
+        _assert(
+            EMAIndicator(close=self._close, window=12).ema_indicator(),
+            _ema(self._close, 12),
+        )
+
+    def test_trix_is_the_rate_of_change_of_a_triple_ema(self):
+        triple = _ema(_ema(_ema(self._close, 15), 15), 15)
+        expected = (triple - triple.shift(1)) / triple.shift(1) * 100
+        _assert(TRIXIndicator(close=self._close, window=15).trix(), expected)
+
+
+class TestOthersDefinitions(unittest.TestCase):
+    def setUp(self):
+        _, _, self._close, _ = _series()
+
+    def test_daily_return(self):
+        expected = (self._close / self._close.shift(1) - 1) * 100
+        _assert(DailyReturnIndicator(close=self._close).daily_return(), expected)
+
+    def test_daily_log_return(self):
+        expected = pd.Series(np.log(self._close)).diff() * 100
+        _assert(
+            DailyLogReturnIndicator(close=self._close).daily_log_return(),
+            expected,
+        )
+
+    def test_cumulative_return_is_measured_from_the_first_bar(self):
+        expected = (self._close / self._close.iloc[0] - 1) * 100
+        _assert(
+            CumulativeReturnIndicator(close=self._close).cumulative_return(),
+            expected,
+        )
+        self.assertEqual(
+            CumulativeReturnIndicator(close=self._close).cumulative_return().iloc[0],
+            0.0,
+        )
+
+
+class TestTrendDefinitions(unittest.TestCase):
+    def setUp(self):
+        self._high, self._low, self._close, self._volume = _series()
+
+    def test_awesome_oscillator_function_matches_the_class(self):
+        # The module-level delegate was reached by no test.
+        expected = AwesomeOscillatorIndicator(
+            high=self._high, low=self._low
+        ).awesome_oscillator()
+        _assert(awesome_oscillator(high=self._high, low=self._low), expected)
+
+    def test_awesome_oscillator_is_a_median_price_sma_spread(self):
+        median = 0.5 * (self._high + self._low)
+        expected = median.rolling(5).mean() - median.rolling(34).mean()
+        _assert(
+            AwesomeOscillatorIndicator(
+                high=self._high, low=self._low
+            ).awesome_oscillator(),
+            expected,
+        )
+
+    def test_mass_index_sums_the_ema_ratio_of_the_range(self):
+        amplitude = self._high - self._low
+        ema1 = _ema(amplitude, 9)
+        ema2 = _ema(ema1, 9)
+        expected = (ema1 / ema2).rolling(25, min_periods=25).sum()
+        _assert(MassIndex(high=self._high, low=self._low).mass_index(), expected)
+
+    def test_dpo_detrends_by_a_shifted_close(self):
+        window = 20
+        shift = int(0.5 * window + 1)
+        expected = self._close.shift(shift) - self._close.rolling(window).mean()
+        _assert(DPOIndicator(close=self._close, window=window).dpo(), expected)
+
+    def test_kst_is_the_weighted_sum_of_four_smoothed_rocs(self):
+        def smoothed_roc(roc_window, ma_window):
+            previous = self._close.shift(roc_window)
+            return ((self._close - previous) / previous).rolling(ma_window).mean()
+
+        expected = 100 * (
+            smoothed_roc(10, 10)
+            + 2 * smoothed_roc(15, 10)
+            + 3 * smoothed_roc(20, 10)
+            + 4 * smoothed_roc(30, 15)
+        )
+        _assert(KSTIndicator(close=self._close).kst(), expected)
+
+    def test_ichimoku_lines_are_midpoints_of_rolling_extremes(self):
+        indicator = IchimokuIndicator(high=self._high, low=self._low)
+        conversion = 0.5 * (self._high.rolling(9).max() + self._low.rolling(9).min())
+        base = 0.5 * (self._high.rolling(26).max() + self._low.rolling(26).min())
+        _assert(indicator.ichimoku_conversion_line(), conversion)
+        _assert(indicator.ichimoku_base_line(), base)
+        _assert(indicator.ichimoku_a(), 0.5 * (conversion + base))
+
+    def test_aroon_resolves_ties_to_the_most_recent_bar(self):
+        # Aroon measures how long ago the extreme happened. An extreme matched
+        # again today happened zero days ago, so both readings are 100.
+        high = pd.Series([10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 15.0])
+        low = pd.Series([10.0, 9.0, 8.0, 7.0, 6.0, 5.0, 5.0])
+        indicator = AroonIndicator(high=high, low=low, window=5)
+        self.assertEqual(indicator.aroon_up().iloc[-1], 100.0)
+        self.assertEqual(indicator.aroon_down().iloc[-1], 100.0)
+
+    def test_aroon_ages_an_extreme_that_is_not_matched_again(self):
+        # High at position 1 of a 6-bar window, so 4 of 5 days have passed.
+        high = pd.Series([10.0, 20.0, 13.0, 12.0, 11.0, 10.5, 10.2])
+        low = high - 5.0
+        indicator = AroonIndicator(high=high, low=low, window=5)
+        self.assertEqual(indicator.aroon_up().iloc[-1], 0.0)
+
+    def test_aroon_pins_a_monotonic_series_to_its_extremes(self):
+        rising = pd.Series(np.arange(60, dtype=float))
+        indicator = AroonIndicator(high=rising, low=rising, window=25)
+        aroon_up = indicator.aroon_up()
+        aroon_down = indicator.aroon_down()
+        # Every window's high is its newest bar and its low is its oldest.
+        self.assertTrue((aroon_up.dropna() == 100.0).all())
+        self.assertTrue((aroon_down.dropna() == 0.0).all())
+        _assert(indicator.aroon_indicator(), aroon_up - aroon_down)
+
+
+class TestVolumeDefinitions(unittest.TestCase):
+    def setUp(self):
+        self._high, self._low, self._close, self._volume = _series()
+
+    def test_chaikin_money_flow_is_money_flow_volume_over_volume(self):
+        multiplier = ((self._close - self._low) - (self._high - self._close)) / (
+            self._high - self._low
+        )
+        money_flow_volume = multiplier.fillna(0.0) * self._volume
+        expected = money_flow_volume.rolling(20).sum() / self._volume.rolling(20).sum()
+        _assert(
+            ChaikinMoneyFlowIndicator(
+                high=self._high, low=self._low, close=self._close, volume=self._volume
+            ).chaikin_money_flow(),
+            expected,
+        )
+
+    def test_obv_holds_across_an_unchanged_close(self):
+        # test/data/cs-obv.csv contains no flat bar, so the reference fixture
+        # never reached this branch; a two-way split added volume here.
+        close = pd.Series([10.0, 11.0, 11.0, 11.0, 10.0, 10.0, 12.0])
+        volume = pd.Series([100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0])
+        result = OnBalanceVolumeIndicator(
+            close=close, volume=volume
+        ).on_balance_volume()
+        # first bar contributes nothing, then +200, hold, hold, -500, hold, +700
+        expected = pd.Series([0.0, 200.0, 200.0, 200.0, -300.0, -300.0, 400.0])
+        _assert(result, expected)
+
+    def test_obv_direction_follows_the_close(self):
+        close = pd.Series([10.0, 12.0, 9.0])
+        volume = pd.Series([100.0, 250.0, 400.0])
+        result = OnBalanceVolumeIndicator(
+            close=close, volume=volume
+        ).on_balance_volume()
+        _assert(result, pd.Series([0.0, 250.0, -150.0]))
+
+    def test_nvi_holds_flat_while_volume_never_falls(self):
+        rising_volume = pd.Series(np.arange(1, 41, dtype=float) * 100.0)
+        close = pd.Series(np.linspace(50.0, 80.0, 40))
+        result = NegativeVolumeIndexIndicator(
+            close=close, volume=rising_volume
+        ).negative_volume_index()
+        self.assertTrue((result == 1000.0).all())
+
+    def test_nvi_compounds_price_change_while_volume_falls(self):
+        falling_volume = pd.Series(np.arange(40, 0, -1, dtype=float) * 100.0)
+        close = pd.Series(np.linspace(50.0, 80.0, 40))
+        result = NegativeVolumeIndexIndicator(
+            close=close, volume=falling_volume
+        ).negative_volume_index()
+        # Every bar decreases volume, so the factors telescope to close ratio.
+        expected_last = 1000.0 * close.iloc[-1] / close.iloc[0]
+        self.assertTrue(math.isclose(result.iloc[-1], expected_last, rel_tol=1e-12))
+        self.assertEqual(result.iloc[0], 1000.0)
