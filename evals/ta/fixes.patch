+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta.utils import _get_min_max, dropna
+
+
+class TestDropna(unittest.TestCase):
+    """dropna removes unusable numeric values, and nothing else."""
+
+    @staticmethod
+    def _frame(volume):
+        return pd.DataFrame({"Close": [10.0, 11.0, 12.0, 13.0], "Volume": volume})
+
+    def test_keeps_zero_volume_bars(self):
+        # A zero-volume bar is real data, not a missing one.
+        result = dropna(self._frame([100.0, 0.0, 300.0, 400.0]))
+        self.assertEqual(len(result), 4)
+        self.assertEqual(result.index.tolist(), [0, 1, 2, 3])
+
+    def test_drops_nan_rows(self):
+        result = dropna(self._frame([100.0, np.nan, 300.0, 400.0]))
+        self.assertEqual(result.index.tolist(), [0, 2, 3])
+
+    def test_drops_infinite_rows_in_both_directions(self):
+        result = dropna(self._frame([np.inf, 200.0, -np.inf, 400.0]))
+        self.assertEqual(result.index.tolist(), [1, 3])
+
+    def test_drops_the_missing_bar_placeholder(self):
+        result = dropna(self._frame([100.0, 1.7e308, 300.0, 400.0]))
+        self.assertEqual(result.index.tolist(), [0, 2, 3])
+
+    def test_leaves_non_numeric_columns_alone(self):
+        df = pd.DataFrame(
+            {"Close": [10.0, np.nan, 12.0], "Ticker": ["AAA", "BBB", "CCC"]}
+        )
+        result = dropna(df)
+        self.assertEqual(result["Ticker"].tolist(), ["AAA", "CCC"])
+
+
+class TestGetMinMax(unittest.TestCase):
+    """_get_min_max pairs two series elementwise and keeps their index."""
+
+    _index = pd.date_range("2020-01-01", periods=5, freq="D")
+    _left = pd.Series([1.0, 5.0, 3.0, 9.0, 2.0], index=_index)
+    _right = pd.Series([4.0, 2.0, 7.0, 1.0, 8.0], index=_index)
+
+    def test_max_keeps_the_caller_index(self):
+        result = _get_min_max(self._left, self._right, "max")
+        self.assertTrue(result.index.equals(self._index))
+        self.assertEqual(result.tolist(), [4.0, 5.0, 7.0, 9.0, 8.0])
+
+    def test_min_keeps_the_caller_index(self):
+        result = _get_min_max(self._left, self._right, "min")
+        self.assertTrue(result.index.equals(self._index))
+        self.assertEqual(result.tolist(), [1.0, 2.0, 3.0, 1.0, 2.0])
+
+    def test_nan_propagates(self):
+        left = self._left.copy()
+        left.iloc[0] = float("nan")
+        self.assertTrue(pd.isna(_get_min_max(left, self._right, "max").iloc[0]))
+
+    def test_unknown_function_is_rejected(self):
+        with self.assertRaises(ValueError):
+            _get_min_max(self._left, self._right, "average")
