@@ -0,0 +1,154 @@
+"""A docstring that names a fill value is making a testable claim.
+
+Four indicators promise a specific warm-up fill value in prose. One of them
+promised -50 while its code filled 0: the line had been copy-pasted from
+Williams %R, which runs from 0 to -100 and really does centre on -50, onto the
+Awesome Oscillator, which oscillates around zero. Nothing failed, because no
+test compared the prose against the code.
+
+Two claims are checked here. The static one - the named value equals the
+constant the code passes to `_check_fillna` - is the one that catches that
+copy-paste, and it reaches every documented indicator. The behavioural one
+proves the constant is really what a NaN bar receives.
+"""
+
+import ast
+import inspect
+import re
+import textwrap
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta import momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin
+
+_MODULES = (momentum, others, trend, volatility, volume)
+
+# Every indicator whose docstring names a fill value, so that documenting a new
+# one has to be a deliberate addition here rather than a silent escape.
+_DOCUMENTED = (
+    "AwesomeOscillatorIndicator",
+    "NegativeVolumeIndexIndicator",
+    "UltimateOscillator",
+    "WilliamsRIndicator",
+)
+
+_NAMED_FILL = re.compile(r"fill nan values with (-?[\d.]+)")
+
+_ROWS = 120
+_BLANK = 3
+
+
+def _named_fill_value(obj) -> float | None:
+    """The fill value an object's docstring promises, if it names one."""
+    match = _NAMED_FILL.search(inspect.getdoc(obj) or "")
+    return None if match is None else float(match.group(1))
+
+
+def _fill_constants(cls) -> set[float]:
+    """Every literal passed as `_check_fillna(value=...)` inside a class.
+
+    A non-literal - KAMA seeds its fill from `self._close` - is not a value a
+    docstring could name, so it is skipped rather than failing the parse.
+    """
+    constants: set[float] = set()
+    for node in ast.walk(ast.parse(textwrap.dedent(inspect.getsource(cls)))):
+        if not (
+            isinstance(node, ast.Call)
+            and getattr(node.func, "attr", "") == "_check_fillna"
+        ):
+            continue
+        for keyword in node.keywords:
+            if keyword.arg != "value":
+                continue
+            try:
+                constants.add(float(ast.literal_eval(keyword.value)))
+            except (ValueError, TypeError):
+                pass
+    return constants
+
+
+def _documented_indicators():
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ != module.__name__:
+                continue
+            named = _named_fill_value(cls)
+            if named is not None:
+                yield cls, named
+
+
+def _blanked_series():
+    """Prices whose opening bars are missing, as a feed leaves them.
+
+    This is the only shape that drives these indicators to NaN under
+    `fillna=True`: that flag sets `min_periods=0`, so a partial window still
+    computes and the fill never engages on complete data.
+    """
+    index = np.arange(_ROWS, dtype=float)
+    close = pd.Series(100.0 + 8.0 * np.sin(index / 7.0) + 0.25 * index)
+    high = close + 1.0
+    low = close - 1.0
+    volume_series = pd.Series(1000.0 + 300.0 * np.sin(index / 11.0) + 4.0 * index)
+    for series in (high, low, close, volume_series):
+        series[:_BLANK] = np.nan
+    return high, low, close, volume_series
+
+
+class TestDocumentedFillValues(unittest.TestCase):
+    """The prose and the code must name the same fill value."""
+
+    def test_each_named_value_matches_the_constant_the_code_uses(self):
+        checked = []
+        for cls, named in _documented_indicators():
+            with self.subTest(indicator=cls.__name__):
+                self.assertEqual(_fill_constants(cls), {named})
+            checked.append(cls.__name__)
+        self.assertEqual(sorted(checked), sorted(_DOCUMENTED))
+
+    def test_each_delegate_names_the_same_value_as_its_class(self):
+        pairs = (
+            (momentum.awesome_oscillator, momentum.AwesomeOscillatorIndicator),
+            (momentum.ultimate_oscillator, momentum.UltimateOscillator),
+            (momentum.williams_r, momentum.WilliamsRIndicator),
+            (volume.negative_volume_index, volume.NegativeVolumeIndexIndicator),
+        )
+        self.assertEqual(len(pairs), len(_DOCUMENTED))
+        for function, cls in pairs:
+            with self.subTest(delegate=function.__name__):
+                self.assertEqual(_named_fill_value(function), _named_fill_value(cls))
+
+    def test_a_missing_bar_receives_the_documented_value(self):
+        high, low, close, _ = _blanked_series()
+        # Negative Volume Index is absent on purpose: its 1000 is the seed its
+        # first row is built from, and no input drives it to NaN, so the fill
+        # it documents is unreachable and nothing behavioural can be asserted.
+        results = (
+            (
+                "awesome_oscillator",
+                momentum.AwesomeOscillatorIndicator(
+                    high=high, low=low, fillna=True
+                ).awesome_oscillator(),
+            ),
+            (
+                "ultimate_oscillator",
+                momentum.UltimateOscillator(
+                    high=high, low=low, close=close, fillna=True
+                ).ultimate_oscillator(),
+            ),
+            (
+                "williams_r",
+                momentum.WilliamsRIndicator(
+                    high=high, low=low, close=close, fillna=True
+                ).williams_r(),
+            ),
+        )
+        for name, series in results:
+            documented = _named_fill_value(getattr(momentum, name))
+            with self.subTest(indicator=name):
+                self.assertEqual(list(series.iloc[:_BLANK]), [documented] * _BLANK)
+                self.assertTrue(np.isfinite(series).all())
diff --git a/test/unit/empty_input.py b/test/unit/empty_input.py
new file mode 100644
index 0000000..bdab4af
--- /dev/null
+++ b/test/unit/empty_input.py
@@ -0,0 +1,102 @@
+"""An empty frame is reachable input, not a contrivance.
+
+`dropna` is the preprocessing step this library documents, and it returns an
+empty frame when every row is unusable - a feed that emitted nothing but the
+1.7e308 placeholder does exactly that. Forty of the 43 indicators already
+returned empty output for it; three raised an opaque pandas IndexError from
+inside their own recurrences, and `add_all_ta_features` inherited the crash.
+
+The class sweep here is reflective rather than a list of three regression
+cases, so an indicator added later cannot quietly reintroduce the shape.
+"""
+
+import inspect
+import unittest
+
+import pandas as pd
+
+from ta import add_all_ta_features, momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin
+
+_MODULES = (momentum, others, trend, volatility, volume)
+_SERIES_PARAMETERS = frozenset({"open", "high", "low", "close", "volume"})
+_COLUMNS = ("Open", "High", "Low", "Close", "Volume")
+
+
+def _indicator_classes():
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ == module.__name__:
+                yield cls
+
+
+def _frame(rows: int) -> pd.DataFrame:
+    prices = [100.0 + step for step in range(rows)]
+    return pd.DataFrame(
+        {
+            "Open": [price - 0.5 for price in prices],
+            "High": [price + 1.0 for price in prices],
+            "Low": [price - 1.0 for price in prices],
+            "Close": prices,
+            "Volume": [1000.0 + step for step in range(rows)],
+        },
+        dtype="float64",
+    )
+
+
+def _series_arguments(cls, frame: pd.DataFrame) -> dict[str, pd.Series | int]:
+    """The price columns a class asks for, plus a window when it demands one."""
+    signature = inspect.signature(cls.__init__)
+    arguments: dict[str, pd.Series | int] = {
+        name: frame[name.capitalize()]
+        for name in signature.parameters
+        if name in _SERIES_PARAMETERS
+    }
+    window = signature.parameters.get("window")
+    if window is not None and window.default is inspect.Parameter.empty:
+        arguments["window"] = 14
+    return arguments
+
+
+class TestEmptyInput(unittest.TestCase):
+    """No indicator may raise on a frame with no rows."""
+
+    def test_every_indicator_returns_empty_output(self):
+        empty = _frame(0)
+        checked = 0
+        for cls in _indicator_classes():
+            arguments = _series_arguments(cls, empty)
+            if not arguments:
+                continue
+            with self.subTest(indicator=cls.__name__):
+                indicator = cls(**arguments)
+                accessors = [
+                    method
+                    for name, method in inspect.getmembers(indicator, inspect.ismethod)
+                    if not name.startswith("_")
+                ]
+                self.assertTrue(accessors)
+                for accessor in accessors:
+                    self.assertTrue(accessor().empty)
+            checked += 1
+        self.assertEqual(checked, 43)
+
+    def test_add_all_ta_features_keeps_its_columns_on_an_empty_frame(self):
+        populated = add_all_ta_features(
+            _frame(60), *_COLUMNS, fillna=False, colprefix="", vectorized=False
+        )
+        empty = add_all_ta_features(
+            _frame(0), *_COLUMNS, fillna=False, colprefix="", vectorized=False
+        )
+        self.assertEqual(len(empty), 0)
+        self.assertEqual(list(empty.columns), list(populated.columns))
+
+    def test_a_single_row_still_works(self):
+        # The row count either side of the empty case, so a guard cannot be
+        # written as "shorter than two rows" and silently swallow real input.
+        one_row = add_all_ta_features(
+            _frame(1), *_COLUMNS, fillna=False, colprefix="", vectorized=False
+        )
+        self.assertEqual(len(one_row), 1)
diff --git a/test/unit/fillna.py b/test/unit/fillna.py
new file mode 100644
index 0000000..f8fb71c
--- /dev/null
+++ b/test/unit/fillna.py
@@ -0,0 +1,97 @@
+"""The fillna flag fills warm-up rows; it must not change the indicator.
+
+KAMA returned a constant under fillna=True. `min_periods=0` makes the row-0
+rolling sum of an all-NaN window evaluate to 0.0, which the efficiency ratio
+read as a flat market rather than as "not computable yet"; the recurrence then
+seeded a full window early, hit the NaN smoothing constants still sitting in
+the warm-up rows, propagated NaN through every later row, and `_check_fillna`'s
+forward fill spread the single seed across the whole series.
+
+Nothing caught it. The lines were covered, the fixture test exercises only
+fillna=False, and a sweep asserting the filled series has no NaN and no inf
+passes happily on a constant. The property that does catch it is here: a filled
+series must still vary, and KAMA's two paths must agree once both are defined.
+"""
+
+import inspect
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta import momentum, others, trend, volatility, volume
+from ta.utils import IndicatorMixin, dropna
+
+_MODULES = (momentum, others, trend, volatility, volume)
+_PRICE_PARAMETERS = frozenset({"open", "high", "low", "close", "volume"})
+_ROWS = 600
+
+
+def _prices() -> dict[str, pd.Series]:
+    frame = (
+        dropna(pd.read_csv("test/data/datas.csv", sep=","))
+        .head(_ROWS)
+        .reset_index(drop=True)
+    )
+    return {
+        "open": frame["Open"],
+        "high": frame["High"],
+        "low": frame["Low"],
+        "close": frame["Close"],
+        "volume": frame["Volume_BTC"],
+    }
+
+
+def _pairs(prices):
+    """Every accessor, computed both with and without fillna."""
+    for module in _MODULES:
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls is IndicatorMixin or not issubclass(cls, IndicatorMixin):
+                continue
+            if cls.__module__ != module.__name__:
+                continue
+            parameters = inspect.signature(cls.__init__).parameters
+            arguments = {
+                name: prices[name] for name in parameters if name in _PRICE_PARAMETERS
+            }
+            if not arguments:
+                continue
+            unfilled = cls(**{**arguments, "fillna": False})
+            filled = cls(**{**arguments, "fillna": True})
+            for name, method in inspect.getmembers(unfilled, inspect.ismethod):
+                if not name.startswith("_"):
+                    yield cls.__name__, name, method(), getattr(filled, name)()
+
+
+class TestFillnaDoesNotFlatten(unittest.TestCase):
+    """A filled series must carry the indicator, not a repeated seed."""
+
+    def test_no_filled_series_collapses_to_a_constant(self):
+        prices = _prices()
+        checked = 0
+        for indicator, accessor, unfilled, filled in _pairs(prices):
+            checked += 1
+            if unfilled.nunique() <= 1:
+                continue  # nothing to lose: the unfilled series is constant too
+            with self.subTest(indicator=indicator, accessor=accessor):
+                self.assertGreater(filled.nunique(), 1)
+        self.assertEqual(checked, 84)
+
+    def test_kama_agrees_with_itself_across_the_flag(self):
+        prices = _prices()
+        unfilled = momentum.KAMAIndicator(close=prices["close"], fillna=False).kama()
+        filled = momentum.KAMAIndicator(close=prices["close"], fillna=True).kama()
+        defined = ~unfilled.isna()
+        self.assertGreater(int(defined.sum()), 0)
+        pd.testing.assert_series_equal(unfilled[defined], filled[defined])
+        self.assertFalse(filled.isna().any())
+        self.assertGreater(filled.nunique(), 1)
+
+    def test_kama_recurrence_reaches_every_row(self):
+        # The defect left one non-NaN entry in the raw array, which the fill
+        # then hid, so assert the recurrence itself rather than its output.
+        prices = _prices()
+        indicator = momentum.KAMAIndicator(close=prices["close"], fillna=True)
+        raw = indicator._kama  # pylint: disable=protected-access
+        window = 10
+        self.assertEqual(int((~np.isnan(raw)).sum()), _ROWS - window + 1)
diff --git a/test/unit/gaps.py b/test/unit/gaps.py
new file mode 100644
index 0000000..2724139
--- /dev/null
+++ b/test/unit/gaps.py
@@ -0,0 +1,125 @@
+"""A missing bar must stay missing.
+
+Every comparison against NaN is False, so masking with `where` turns a gap into
+a real zero before pandas can count it as absent. `min_periods` then accepts a
+window that is actually short and the indicator reports a value computed from
+fewer bars than it claims, which looks like data rather than like a refusal.
+`clip` preserves the gap.
+
+MFI carried exactly that defect for two iterations: on 400 rows with four bars
+blanked it returned 13 NaN where it should have returned 43. Neither gate saw
+it. The suite passed because no test fed gapped input, and coverage stayed at
+100 per cent because the line executes either way - only its meaning changed.
+
+Gaps are in-envelope: the Operating envelope names them as ordinary output of a
+real market-data feed. These cases pin the contract for the three accessors
+that were rewritten from a per-window Python callback into a rolling
+aggregation, which is the rewrite that can silently drop the distinction.
+"""
+
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta.trend import WMAIndicator
+from ta.volatility import UlcerIndex
+from ta.volume import MFIIndicator
+
+_GAP = 200
+_ROWS = 400
+
+
+class TestGappedInput(unittest.TestCase):
+    """One blanked bar blanks exactly the windows that contain it."""
+
+    _df: pd.DataFrame
+
+    @classmethod
+    def setUpClass(cls):
+        frame = pd.read_csv("test/data/datas.csv", sep=",")
+        frame = frame[frame["High"] < 1e300].reset_index(drop=True)
+        cls._df = frame.tail(_ROWS).reset_index(drop=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        del cls._df
+
+    def _columns(self, blank):
+        """OHLCV columns, optionally with the bar at _GAP blanked."""
+        out = {}
+        for key, name in (
+            ("high", "High"),
+            ("low", "Low"),
+            ("close", "Close"),
+            ("volume", "Volume_BTC"),
+        ):
+            series = self._df[name].astype(float).copy()
+            if blank:
+                series.iloc[_GAP] = np.nan
+            out[key] = series
+        return out
+
+    def _cases(self, col):
+        """Accessor, window, and how many rows one gap can influence.
+
+        A gap blanks the `window` rows whose window contains it. MFI reaches
+        one row further, because its direction term compares each bar with the
+        one before, so a missing bar also leaves the next bar's direction
+        indeterminate and it contributes a real zero; the window covering that
+        bar therefore differs too. That is inherent to the definition and
+        predates the rewrite - the pre-vectorization code does the same.
+        """
+        return (
+            (
+                "money_flow_index",
+                14,
+                15,
+                lambda w: MFIIndicator(
+                    col["high"], col["low"], col["close"], col["volume"], window=w
+                ).money_flow_index(),
+            ),
+            (
+                "ulcer_index",
+                14,
+                14,
+                lambda w: UlcerIndex(col["close"], window=w).ulcer_index(),
+            ),
+            ("wma", 9, 9, lambda w: WMAIndicator(col["close"], window=w).wma()),
+        )
+
+    def test_a_gap_blanks_exactly_the_windows_containing_it(self):
+        gapped = self._columns(blank=True)
+        for name, window, _, build in self._cases(gapped):
+            with self.subTest(accessor=name):
+                result = build(window)
+                for row in range(_GAP, _GAP + window):
+                    self.assertTrue(
+                        pd.isna(result.iloc[row]),
+                        f"{name} row {row} should be NaN: its window holds the gap",
+                    )
+                # Once the gap has rolled out of the window the series resumes.
+                self.assertFalse(
+                    pd.isna(result.iloc[_GAP + window]),
+                    f"{name} row {_GAP + window} should be defined again",
+                )
+
+    def test_a_gap_does_not_disturb_rows_beyond_its_reach(self):
+        clean = self._columns(blank=False)
+        gapped = self._columns(blank=True)
+        for (name, window, influence, build_clean), (_, _, _, build_gapped) in zip(
+            self._cases(clean), self._cases(gapped)
+        ):
+            with self.subTest(accessor=name):
+                before = build_clean(window)
+                after = build_gapped(window)
+                for label, span in (
+                    ("before the gap", slice(0, _GAP)),
+                    ("beyond its reach", slice(_GAP + influence, None)),
+                ):
+                    pd.testing.assert_series_equal(
+                        before.iloc[span],
+                        after.iloc[span],
+                        check_names=False,
+                        obj=f"{name} {label}",
+                    )
diff --git a/test/unit/lookahead.py b/test/unit/lookahead.py
new file mode 100644
index 0000000..c45f384
--- /dev/null
+++ b/test/unit/lookahead.py
@@ -0,0 +1,73 @@
+import unittest
+
+import numpy as np
+import pandas as pd
+
+from ta.momentum import KAMAIndicator
+from ta.trend import (
+    DPOIndicator,
+    IchimokuIndicator,
+    KSTIndicator,
+    TRIXIndicator,
+    VortexIndicator,
+)
+
+
+class TestNoLookahead(unittest.TestCase):
+    """An indicator value must depend only on bars at or before its own.
+
+    Each case is computed twice on series that differ only in the final bar;
+    every earlier value must be identical. Warm-up rows used to be seeded from
+    whole-series statistics or a wrapping roll, both of which leaked the future
+    backwards.
+    """
+
+    _base: tuple[pd.Series, pd.Series, pd.Series]
+    _bumped: tuple[pd.Series, pd.Series, pd.Series]
+
+    _rows = 120
+
+    @classmethod
+    def setUpClass(cls):
+        rng = np.random.default_rng(0)
+        rows = cls._rows
+        close = pd.Series(100 + np.cumsum(rng.normal(0, 1, rows)))
+        cls._base = (close + 1.0, close - 1.0, close)
+        bumped = close.copy()
+        bumped.iloc[-1] += 500.0
+        cls._bumped = (bumped + 1.0, bumped - 1.0, bumped)
+
+    @staticmethod
+    def _cases():
+        return {
+            "trix": lambda h, low, c, f: TRIXIndicator(
+                close=c, window=15, fillna=f
+            ).trix(),
+            "kst": lambda h, low, c, f: KSTIndicator(close=c, fillna=f).kst(),
+            "kst_sig": lambda h, low, c, f: KSTIndicator(close=c, fillna=f).kst_sig(),
+            "dpo": lambda h, low, c, f: DPOIndicator(
+                close=c, window=20, fillna=f
+            ).dpo(),
+            "vortex_pos": lambda h, low, c, f: VortexIndicator(
+                high=h, low=low, close=c, window=14, fillna=f
+            ).vortex_indicator_pos(),
+            "ichimoku_a_visual": lambda h, low, c, f: IchimokuIndicator(
+                high=h, low=low, visual=True, fillna=f
+            ).ichimoku_a(),
+            "ichimoku_b_visual": lambda h, low, c, f: IchimokuIndicator(
+                high=h, low=low, visual=True, fillna=f
+            ).ichimoku_b(),
+            "kama": lambda h, low, c, f: KAMAIndicator(
+                close=c, window=10, fillna=f
+            ).kama(),
+        }
+
+    def test_no_earlier_value_depends_on_the_final_bar(self):
+        # Stop short of the final bar itself, which is legitimately affected.
+        cutoff = self._rows - 5
+        for name, build in self._cases().items():
+            for fillna in (False, True):
+                with self.subTest(indicator=name, fillna=fillna):
+                    before = build(*self._base, fillna).iloc[:cutoff]
+                    after = build(*self._bumped, fillna).iloc[:cutoff]
+                    pd.testing.assert_series_equal(before, after, check_names=False)
