+TEST_CASE("chars_format.hex_is_rejected") {
+  // fast_float parses decimal only. chars_format::hex used to be read nowhere,
+  // so a caller who asked for hexadecimal got a silent decimal parse of the
+  // same characters: "0x1p3" returned ec == std::errc(), ptr == first + 1 and
+  // 0.0. A request the library cannot honour has to be reported.
+  for (std::string const input : {"0x1p3", "1p3", "0X1P3", "1.5", "0"}) {
+    double d = -1.0;
+    auto const answer = fast_float::from_chars(
+        input.data(), input.data() + input.size(), d,
+        fast_float::chars_format::hex);
+    CHECK_MESSAGE(answer.ec == std::errc::invalid_argument,
+                  "chars_format::hex must be rejected for " << input);
+    CHECK_MESSAGE(answer.ptr == input.data(),
+                  "a rejected format leaves ptr at first for " << input);
+    CHECK_MESSAGE(d == -1.0, "a rejected format leaves the value alone");
+  }
+  // The bit is rejected wherever it appears, including combined with a format
+  // the library does implement, and for float as well as double.
+  {
+    std::string const input = "1.5";
+    float f = -1.0f;
+    auto const answer = fast_float::from_chars(
+        input.data(), input.data() + input.size(), f,
+        fast_float::chars_format(
+            uint64_t(fast_float::chars_format::general) |
+            uint64_t(fast_float::chars_format::hex)));
+    CHECK(answer.ec == std::errc::invalid_argument);
+    CHECK(answer.ptr == input.data());
+  }
+  // The integer entry point takes its base from parse_options, so the hex bit
+  // is equally meaningless there and is equally rejected.
+  {
+    std::string const input = "4f0cedc95a718c";
+    uint64_t i = 0;
+    fast_float::parse_options options(fast_float::chars_format::hex, '.', 16);
+    auto const answer = fast_float::from_chars_advanced(
+        input.data(), input.data() + input.size(), i, options);
+    CHECK(answer.ec == std::errc::invalid_argument);
+    CHECK(answer.ptr == input.data());
+  }
+  // and base 16 without the bit still works, so the rejection has not taken
+  // hexadecimal integer parsing with it
+  {
+    std::string const input = "4f0cedc95a718c";
+    uint64_t i = 0;
+    auto const answer = fast_float::from_chars(
+        input.data(), input.data() + input.size(), i, 16);
+    CHECK(answer.ec == std::errc());
+    CHECK(i == 22250738585072012ull);
+  }
+}
