+# MODULE.bazel carries the version bzlmod resolves this repository as, so it has
+# to move with every release. The pattern is anchored to the start of a line
+# because bazel_dep() lines carry a `version = "..."` of their own and those
+# belong to the dependency, not to this module.
+bazelfile = f"{maindir}{os.sep}MODULE.bazel"
