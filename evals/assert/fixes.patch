+<?php
+
+declare(strict_types=1);
+
+namespace Webmozart\Assert\Tests\StaticAnalysis;
+
+use Webmozart\Assert\Assert;
+
+final class InitializedWidget
+{
+    public mixed $property = null;
+
+    public function property(): mixed
+    {
+        return $this->property;
+    }
+}
+
+/**
+ * isInitialized carries `@psalm-assert object $value`, so it belongs in HasAssert::HAS_ASSERT,
+ * which is what makes the Psalm plugin restore the argument's own type over the declared
+ * `object` return type. Without that entry this check-type reports `$r = object`.
+ *
+ * @psalm-suppress RedundantCondition the argument is deliberately typed, so that the check-type
+ *                 below is about the plugin restoring that type rather than about narrowing
+ */
+function isInitializedPreservesTheArgumentType(InitializedWidget $widget): mixed
+{
+    $r = Assert::isInitialized($widget, 'property');
+    /** @psalm-check-type $r = InitializedWidget */
+
+    return $r->property();
+}
