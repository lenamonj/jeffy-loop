+        ] as [$method, $value]) {
+            try {
+                Assert::$method($value, $gen());
+                $this->fail($method.'() accepted a value matching none of the classes');
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('DateTime', $e->getMessage());
+            }
+        }
+
+        // The last element is the one that used to escape "Cannot rewind a generator".
+        try {
+            Assert::isNotInstanceOfAny(new ArrayObject(), $gen());
+            $this->fail('isNotInstanceOfAny() accepted a value matching one of the classes');
+        } catch (InvalidArgumentException $e) {
+            $this->assertStringContainsString('ArrayObject', $e->getMessage());
+        }
+
+        $this->assertInstanceOf(ArrayObject::class, Assert::isInstanceOfAny(new ArrayObject(), $gen()));
+        $this->assertInstanceOf(stdClass::class, Assert::isNotInstanceOfAny(new stdClass(), $gen()));
+    }
+
+    /**
+     * preg_match() also answers false when a valid pattern cannot be matched at all - the
+     * backtrack or JIT limits exhausted by a long subject, or a subject that is not valid UTF-8
+     * under a /u pattern - and raises no warning for any of them. Reported as a compile failure,
+     * those told the caller to fix the one argument that was not at fault.
+     */
+    public function testRunTimeMatchFailuresAreNotReportedAsInvalidPatterns(): void
+    {
+        $long = str_repeat('a', 100000);
+
+        $cases = [
+            'backtrack limit' => [$long.'b', '/(a+)+$/', 'Backtrack limit exhausted'],
+            'JIT stack limit' => [str_repeat('x', 200000), '/^(?:x)*$/', 'JIT stack limit exhausted'],
+            'malformed UTF-8 subject' => ["\xff\xfe", '/./u', 'Malformed UTF-8 characters'],
+        ];
+
+        $diagnostics = [];
+        set_error_handler(static function (int $severity, string $message) use (&$diagnostics): bool {
+            $diagnostics[] = $message;
+
+            return true;
+        });
+
+        try {
+            foreach ($cases as $label => [$subject, $pattern, $reason]) {
+                foreach (['regex', 'notRegex'] as $method) {
+                    $message = $this->messageOf(static fn () => Assert::$method($subject, $pattern));
+
+                    $this->assertStringContainsString('could not be matched against the value', $message, $label);
+                    $this->assertStringContainsString($reason, $message, $label);
+                    $this->assertStringNotContainsString('is not a valid regular expression', $message, $label);
+                    // The subject is what makes these fail, so it must not be rendered into the
+                    // message; the backtrack case would put 100000 characters into it.
+                    $this->assertLessThan(200, strlen($message), $label);
+                }
+            }
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame([], $diagnostics);
+
+        // A pattern that genuinely does not compile keeps the message it was given.
+        $this->assertStringContainsString(
+            'is not a valid regular expression',
+            $this->messageOf(static fn () => Assert::regex('abc', '/[/'))
+        );
+
+        // And a valid pattern over an ordinary subject is untouched.
+        $this->assertSame('abc', Assert::regex('abc', '/b/'));
+        $this->assertSame('abc', Assert::notRegex('abc', '/z/'));
+    }
+
+    /**
+     * preg_match() answers 0 for a subject that does not match and false for a pattern that does
+     * not compile, and both callers read that as a boolean. A pattern that failed to compile was
+     * therefore swallowed: notRegex() accepted every value it was given, and regex() reported
+     * that the value did not match, blaming the subject for the pattern's own defect.
+     */
+    public function testInvalidPatternsAreReportedAsSuch(): void
+    {
+        $diagnostics = [];
+        set_error_handler(static function (int $severity, string $message) use (&$diagnostics): bool {
+            $diagnostics[] = $message;
+
+            return true;
+        });
+
+        try {
+            foreach (['/[/', 'abc', '/x'] as $pattern) {
+                foreach (['regex', 'notRegex'] as $method) {
+                    try {
+                        Assert::$method('abc', $pattern);
+                        $this->fail(sprintf('%s() accepted the invalid pattern %s', $method, $pattern));
+                    } catch (InvalidArgumentException $e) {
+                        $this->assertStringContainsString('is not a valid regular expression', $e->getMessage());
+                        $this->assertStringContainsString($pattern, $e->getMessage());
+                    }
+                }
+            }
+
+            // A custom message describes the value, so it must not be used to describe a broken
+            // pattern - that is how the developer never learns which of the two is at fault.
+            try {
+                Assert::notRegex('abc', '/[/', 'the value is wrong');
+                $this->fail('notRegex() accepted an invalid pattern');
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('is not a valid regular expression', $e->getMessage());
+            }
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame([], $diagnostics);
+
+        // Valid patterns keep every verdict and every message they had.
+        $this->assertSame('abc', Assert::regex('abc', '/b/'));
+        $this->assertSame('abc', Assert::notRegex('abc', '/z/'));
+        $this->assertSame('The value "abc" does not match the expected pattern.', $this->messageOf(fn () => Assert::regex('abc', '/z/')));
+        $this->assertSame('The value "abc" matches the pattern "/b/" (at offset 1).', $this->messageOf(fn () => Assert::notRegex('abc', '/b/')));
+    }
+
+    /**
+     * Float NAN and INF reached PHP operations that emit a diagnostic - the string cast in
+     * valueToString, the integer cast in integerish, the bool cast empty() performs - so on PHP
+     * 8.5 an assertion raised an E_WARNING on its way to reporting failure. Wherever the host
+     * converts diagnostics to exceptions, which both dominant PHP frameworks do by default, that
+     * escaped as an ErrorException in place of the promised InvalidArgumentException.
+     * json_decode('{"x":1e999}') produces INF, so an untrusted payload reaches these paths.
+     */
+    public function testNonFiniteFloatsRaiseNoDiagnostic(): void
+    {
+        $diagnostics = [];
+        set_error_handler(static function (int $severity, string $message) use (&$diagnostics): bool {
+            $diagnostics[] = $message;
+
+            return true;
+        });
+
+        try {
+            // The integer cast in integerish(), including the finite float the int type cannot hold.
+            foreach ([NAN, INF, -INF, 9223372036854775808.0] as $value) {
+                try {
+                    Assert::integerish($value);
+                    $this->fail('integerish() accepted a value no integer can hold');
+                } catch (InvalidArgumentException $e) {
+                    $this->assertStringContainsString('Expected an integerish value', $e->getMessage());
+                }
+            }
+
+            // The bool cast empty() performs. NAN is a non-zero float, so it is never empty.
+            try {
+                Assert::isEmpty(NAN);
+                $this->fail('isEmpty() accepted NAN');
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('Expected an empty value', $e->getMessage());
+            }
+
+            $this->assertTrue(is_nan(Assert::notEmpty(NAN)));
+
+            // The string cast in valueToString(), reached through the message of any assertion
+            // that fails on one of these values.
+            $this->assertSame('Expected null. Got: NAN', $this->messageOf(fn () => Assert::null(NAN)));
+            $this->assertSame('Expected null. Got: INF', $this->messageOf(fn () => Assert::null(INF)));
+            $this->assertSame('Expected null. Got: -INF', $this->messageOf(fn () => Assert::null(-INF)));
+            $this->assertSame('Expected a non-negative integer. Got: NAN', $this->messageOf(fn () => Assert::natural(NAN)));
+            $this->assertSame('Expected a value identical to 1. Got: NAN', $this->messageOf(fn () => Assert::same(NAN, 1)));
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame([], $diagnostics);
+
+        // Finite values keep every verdict they had.
+        $this->assertSame(2.0, Assert::integerish(2.0));
+        $this->assertSame(9223372036854774784.0, Assert::integerish(9223372036854774784.0));
+        $this->assertSame(0.0, Assert::isEmpty(0.0));
+        $this->assertSame(1.5, Assert::notEmpty(1.5));
+    }
+
+    private function messageOf(callable $assertion): string
+    {
+        try {
+            $assertion();
+        } catch (InvalidArgumentException $e) {
+            return $e->getMessage();
+        }
+
+        return 'accepted';
+    }
+
+    /**
+     * isInitialized built a ReflectionProperty before it tested anything, so an object that
+     * simply lacks the property escaped a raw ReflectionException in place of the
+     * InvalidArgumentException every assertion promises: Assert::isInitialized(json_decode('{}'),
+     * 'name') threw "Property stdClass::$name does not exist" straight past a caller catching
+     * the documented type, where the sibling Assert::propertyExists() rejected the same pair.
+     */
+    public function testIsInitializedRejectsAnAbsentProperty(): void
+    {
+        $absent = [
+            'a decoded payload without the key' => json_decode('{}'),
+            'an object carrying other properties' => new class {
+                public mixed $other = 1;
+            },
+            'an internal class' => new ArrayObject(),
+        ];
+
+        foreach ($absent as $label => $object) {
+            try {
+                Assert::isInitialized($object, 'name');
+                $this->fail(sprintf('isInitialized() accepted %s', $label));
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('name', $e->getMessage());
+            }
+        }
+
+        // The custom message still reaches the caller on the path that used to escape.
+        try {
+            Assert::isInitialized(json_decode('{}'), 'name', 'no name on %s');
+            $this->fail('isInitialized() accepted an object without the property');
+        } catch (InvalidArgumentException $e) {
+            $this->assertSame('no name on name', $e->getMessage());
+        }
+
+        // Every verdict that was already right is unchanged.
+        $payload = json_decode('{"name":"x"}');
+        $this->assertSame($payload, Assert::isInitialized($payload, 'name'));
+
+        $declared = new class {
+            public mixed $set = 1;
+            public mixed $unset;
+            private string $hidden;
+        };
+
+        $this->assertSame($declared, Assert::isInitialized($declared, 'set'));
+
+        foreach (['unset', 'hidden'] as $property) {
+            try {
+                Assert::isInitialized($declared, $property);
+                $this->fail(sprintf('isInitialized() accepted the uninitialized property %s', $property));
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('to be initialized', $e->getMessage());
+            }
+        }
+    }
+
+    /**
+     * The ordering assertions used to hand their operands straight to PHP's relational
+     * operators, which produce a verdict for any pair at all by coercing until one exists: an
+     * object became 1, an array outranked every scalar, a non-numeric string outranked a number
+     * it never looked at. Assert::lessThan(json_decode('{"nested":1}'), 100) passed.
+     */
+    public function testOrderingAssertionsRejectIncomparableOperands(): void
+    {
+        $rejects = function (string $method, array $args, string $label): void {
+            try {
+                Assert::$method(...$args);
+                $this->fail(sprintf('%s() accepted %s against a numeric bound', $method, $label));
+            } catch (InvalidArgumentException $e) {
+                $this->assertStringContainsString('Expected a value', $e->getMessage());
+            }
+        };
+
+        $incomparable = [
+            'an object' => new stdClass(),
+            'an array' => [1, 2],
+            'a non-numeric string' => 'abc',
+            'a boolean' => false,
+            'null' => null,
+        ];
+
+        foreach ($incomparable as $label => $value) {
+            foreach (['greaterThan', 'greaterThanEq', 'lessThan', 'lessThanEq'] as $method) {
+                $rejects($method, [$value, 10], $label);
+            }
+            $rejects('range', [$value, 1, 10], $label);
+        }
+
+        // NAN is numeric and orders against nothing at all, itself included. Building its
+        // rejection message still coerces it to a string, which PHP 8.5 warns about; that
+        // warning is a separate defect and is swallowed here rather than pinned, so this test
+        // keeps passing when it is fixed.
+        set_error_handler(static fn (): bool => true);
+
+        try {
+            foreach (['greaterThan', 'greaterThanEq', 'lessThan', 'lessThanEq'] as $method) {
+                $rejects($method, [NAN, 10], 'NAN');
+            }
+            $rejects('range', [NAN, 1, 10], 'NAN');
+        } finally {
+            restore_error_handler();
+        }
+
+        // The rejection replaces a comparison PHP only guessed at, so it must not emit the
+        // diagnostic that guess used to print.
+        $diagnostics = [];
+        set_error_handler(static function (int $severity, string $message) use (&$diagnostics): bool {
+            $diagnostics[] = $message;
+
+            return true;
+        });
+
+        try {
+            foreach (['greaterThan', 'greaterThanEq', 'lessThan', 'lessThanEq'] as $method) {
+                try {
+                    Assert::$method(new stdClass(), 10);
+                } catch (InvalidArgumentException) {
+                }
+            }
+
+            try {
+                Assert::range(new stdClass(), 1, 10);
+            } catch (InvalidArgumentException) {
+            }
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertSame([], $diagnostics);
+
+        // Comparable pairs keep the verdicts they have always had.
+        $early = new DateTimeImmutable('2020-01-01');
+        $late = new DateTimeImmutable('2021-01-01');
+
+        $this->assertSame(5, Assert::lessThan(5, 10));
+        $this->assertSame('5', Assert::lessThan('5', 10));
+        $this->assertSame('abc', Assert::lessThan('abc', 'abd'));
+        $this->assertSame([1], Assert::lessThan([1], [1, 2]));
+        $this->assertSame($early, Assert::lessThan($early, $late));
+        $this->assertSame($late, Assert::greaterThan($late, $early));
+        $this->assertSame($early, Assert::range($early, $early, $late));
+        $this->assertTrue(Assert::greaterThan(true, false));
+        $this->assertSame(3, Assert::range(3, 3, 5));
+    }
+
+    /**
+     * notStatic used to report "Closure is not static." - isStatic's message - when the closure
+     * it rejected was static, telling the caller the opposite of the actual failure.
+     */
+    public function testStaticnessMessagesDescribeTheirOwnFailure(): void
+    {
+        $staticClosure = static function () {};
+        $boundClosure = function () { return $this; };
+
+        try {
+            Assert::notStatic($staticClosure);
+            $this->fail('notStatic() accepted a static closure');
+        } catch (InvalidArgumentException $e) {
+            $notStaticMessage = $e->getMessage();
+        }
+
+        try {
+            Assert::isStatic($boundClosure);
+            $this->fail('isStatic() accepted a bound closure');
+        } catch (InvalidArgumentException $e) {
+            $isStaticMessage = $e->getMessage();
+        }
+
+        $this->assertSame('Closure is static.', $notStaticMessage);
+        $this->assertSame('Closure is not static.', $isStaticMessage);
+        $this->assertNotSame($isStaticMessage, $notStaticMessage);
+    }
+
+    /**
+     * A custom message is applied as a sprintf() format string, so a literal percent sign in one
+     * used to raise a ValueError or an ArgumentCountError out of the assertion instead of the
+     * InvalidArgumentException every assertion promises. Drives every failing assertion path.
+     */
+    #[DataProvider('getTests')]
+    public function testCustomMessageWithLiteralPercent(string $method, array $args, bool $success, bool $multibyte = false): void
+    {
+        if (in_array($method, self::SKIP_CUSTOM_MESSAGE_TESTS)) {
+            $this->markTestSkipped("The method $method could have specific message handling instead of custom message.");
+        }
+
+        if ($args === []) {
+            $this->addToAssertionCount(1);
+
+            return;
+        }
+
+        if ($multibyte && !function_exists('mb_strlen')) {
+            $this->markTestSkipped('The function mb_strlen() is not available');
+        }
+
+        if (!$success) {
+            $this->expectException('\InvalidArgumentException');
+            $this->expectExceptionMessage('Custom 100% no');
+        }
+
+        $args['message'] = 'Custom 100% no';
+        $result = Assert::$method(...$args);
+
+        $this->assertSame($args[array_key_first($args)], $result);
+    }
