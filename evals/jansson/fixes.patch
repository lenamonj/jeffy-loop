diff --git a/CMakeLists.txt b/CMakeLists.txt
index c5d7a7b..6466cd8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -318,8 +318,20 @@ if(JANSSON_BUILD_SHARED_LIBS)
 
    if (SYMVER_WORKS)
       set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--default-symver")
+# An anonymous version node restricts the exported set without naming a version
+# of its own, so the symbols keep the default version --default-symver gives
+# them and the ABI is unchanged.
+      file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/jansson.sym" "{
+    global:
+          json_*;
+          jansson_*;
+    local:
+          *;
+};
+")
    else()
-# some linkers may only support --version-script
+# some linkers may only support --version-script, and there the script also
+# carries the version name the symbols would otherwise not have
       file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/jansson.sym" "JANSSON_${JANSSON_SOVERSION} {
     global:
           json_*;
@@ -328,8 +340,16 @@ if(JANSSON_BUILD_SHARED_LIBS)
           *;
 };
 ")
-      list(APPEND CMAKE_REQUIRED_LIBRARIES "-shared -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
-      check_c_source_compiles(
+   endif()
+
+# Either way the version script is what limits the exported set to the public
+# API, matching the autotools build's -export-symbols-regex '^json_|^jansson_'
+# in src/Makefile.am. Without it the shared library also exports every internal
+# symbol - dtoa, gethex, the hashtable_, jsonp_, strbuffer_ and utf8_ families -
+# where they can be interposed by, or interpose on, another library in the same
+# process.
+   list(APPEND CMAKE_REQUIRED_LIBRARIES "-shared -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
+   check_c_source_compiles(
    "
    int function (void)
    {
@@ -338,10 +358,9 @@ if(JANSSON_BUILD_SHARED_LIBS)
    "
    VSCRIPT_WORKS
    )
-      list(REMOVE_ITEM CMAKE_REQUIRED_LIBRARIES "-shared -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
-      if (VSCRIPT_WORKS)
-         set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
-      endif()
+   list(REMOVE_ITEM CMAKE_REQUIRED_LIBRARIES "-shared -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
+   if (VSCRIPT_WORKS)
+      set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--version-script,${CMAKE_CURRENT_BINARY_DIR}/jansson.sym")
    endif()
 
    set_target_properties(jansson PROPERTIES
@@ -508,7 +527,8 @@ if (NOT JANSSON_WITHOUT_TESTS)
          test_pack
          test_simple
          test_sprintf
-         test_unpack)
+         test_unpack
+         test_version)
 
    # Doing arithmetic on void pointers is not allowed by Microsofts compiler
    # such as secure_malloc and secure_free is doing, so exclude it for now.
@@ -577,6 +597,20 @@ if (NOT JANSSON_WITHOUT_TESTS)
        endforeach ()
    endforeach ()
 
+   # Symbol visibility of the shared library: the set it exports must be
+   # exactly what src/jansson.def promises, no more and no less. Nothing else
+   # in this test path grades that, which is how a shared build that also
+   # exported every internal symbol - dtoa, gethex, the hashtable_, jsonp_,
+   # strbuffer_ and utf8_ families - went unnoticed here while the autotools
+   # build hid them. The script exits 77 where "nm -D" is not the GNU one.
+   if (JANSSON_BUILD_SHARED_LIBS AND UNIX)
+      add_test(NAME check-exports
+               COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/test/suites/api/check-exports
+                       $<TARGET_FILE:jansson>
+                       ${CMAKE_CURRENT_SOURCE_DIR}/src/jansson.def)
+      set_tests_properties(check-exports PROPERTIES SKIP_RETURN_CODE 77)
+   endif ()
+
    if (JANSSON_COVERAGE)
       SETUP_TARGET_FOR_COVERAGE(coverage coverage ctest)
    endif ()
