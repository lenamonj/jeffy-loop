+            with settings_path.open(encoding="utf-8") as f:
+                obj = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(
+                f"Settings file is not valid JSON: {settings_path} ({e})"
+            ) from e
+        if not isinstance(obj, dict):
+            raise ValueError(
+                f"Settings file must hold a JSON object: {settings_path} "
+                f"holds {type(obj).__name__}"
+            )
+        return obj
