+class TestErrorTypePropagation:
+    """The README documents catching ``ProcessError`` / ``CLIJSONDecodeError``
+    around ``async for message in query(...)``. Transport failures reach the
+    consumer through Query's internal error frame, so that frame has to carry
+    the original exception object rather than only its text -- otherwise the
+    documented ``except ProcessError as e: e.exit_code`` never matches."""
+
+    @staticmethod
+    def _transport_raising(exc: Exception):
+        """A transport that answers the initialize request, then raises ``exc``
+        out of ``read_messages`` exactly as SubprocessCLITransport does when the
+        CLI exits non-zero or writes an undecodable line."""
+        transport = AsyncMock()
+        transport.is_ready = Mock(return_value=True)
+        state: dict = {"request_id": None, "seen": anyio.Event()}
+
+        async def write(data: str) -> None:
+            msg = json.loads(data)
+            if msg.get("type") == "control_request" and state["request_id"] is None:
+                state["request_id"] = msg["request_id"]
+                state["seen"].set()
+
+        async def read_messages():
+            await state["seen"].wait()
+            yield {
+                "type": "control_response",
+                "response": {
+                    "subtype": "success",
+                    "request_id": state["request_id"],
+                    "response": {},
+                },
+            }
+            raise exc
+
+        transport.write = write
+        transport.read_messages = read_messages
+        return transport
+
+    @pytest.mark.anyio
+    async def test_query_propagates_process_error_type(self) -> None:
+        transport = self._transport_raising(
+            ProcessError("Command failed with exit code 1", exit_code=1, stderr="")
+        )
+        with pytest.raises(ProcessError) as exc_info:
+            async for _ in query(prompt="hi", transport=transport):
+                pass  # pragma: no cover - the transport never yields a message
+        assert exc_info.value.exit_code == 1
+
+    @pytest.mark.anyio
+    async def test_query_propagates_json_decode_error_type(self) -> None:
+        transport = self._transport_raising(
+            CLIJSONDecodeError("{not json", ValueError("boom"))
+        )
+        with pytest.raises(CLIJSONDecodeError) as exc_info:
+            async for _ in query(prompt="hi", transport=transport):
+                pass  # pragma: no cover - the transport never yields a message
+        assert exc_info.value.line == "{not json"
