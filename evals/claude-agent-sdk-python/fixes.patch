+def test_mapping_annotations_reach_meta_like_the_model_form():
+    """A plain mapping passed as annotations must produce the same tools/list entry.
+
+    ``Tool.model_validate`` turns a mapping into a real ``ToolAnnotations``, so the
+    annotation fields survive either way; ``_meta`` has to follow the same rule or
+    the CLI silently keeps its default spill threshold for a tool that asked for a
+    different one.
+    """
+    import anyio
+
+    from claude_agent_sdk._internal.query import Query
+
+    async def handler(args: dict[str, Any]) -> dict[str, Any]:
+        return {"content": [{"type": "text", "text": "ok"}]}
+
+    as_model = tool(
+        "as_model", "", {}, annotations=ToolAnnotations(maxResultSizeChars=500_000)
+    )(handler)
+    as_mapping = tool(
+        "as_mapping", "", {}, annotations={"maxResultSizeChars": 500_000}
+    )(handler)
+    mapping_without_hint = tool(
+        "mapping_without_hint", "", {}, annotations={"readOnlyHint": True}
+    )(handler)
+
+    server_config = create_sdk_mcp_server(
+        name="mapping-annotations-test",
+        tools=[as_model, as_mapping, mapping_without_hint],
+    )
+
+    async def _run():
+        query_instance = Query.__new__(Query)
+        query_instance.sdk_mcp_servers = {
+            "mapping-annotations-test": server_config["instance"]
+        }
+        return await query_instance._handle_sdk_mcp_request(
+            "mapping-annotations-test",
+            {"jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {}},
+        )
+
+    tools_by_name = {t["name"]: t for t in anyio.run(_run)["result"]["tools"]}
+
+    assert tools_by_name["as_mapping"].get("_meta") == tools_by_name["as_model"].get(
+        "_meta"
+    ), "a mapping annotation must produce the same _meta as the ToolAnnotations form"
+    assert (
+        tools_by_name["as_mapping"]["_meta"]["anthropic/maxResultSizeChars"] == 500_000
+    )
+    assert tools_by_name["as_mapping"]["annotations"]["maxResultSizeChars"] == 500_000
+    # A mapping without the hint must not invent one.
+    assert "anthropic/maxResultSizeChars" not in tools_by_name[
+        "mapping_without_hint"
+    ].get("_meta", {})
+
+
