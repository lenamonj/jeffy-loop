+// The commit_files and delete_files tool implementations, kept separate from
+// the MCP server bootstrap in github-file-ops-server.ts so they can be
+// imported and driven directly. Everything they touch - repository
+// coordinates, the local checkout, the token, and the HTTP client - arrives as
+// an explicit config rather than through module-level environment reads.
+import { readFile, stat } from "fs/promises";
+import { constants } from "fs";
+import nodeFetch from "node-fetch";
+import { GITHUB_API_URL } from "../github/api/config";
+import { isBinaryContent } from "./binary-detection";
+import {
+  resolveRepoRelativePath,
+  validatePathWithinRepo,
+} from "./path-validation";
+import { updateGitReference } from "./update-git-reference";
+import { failed, ok, type ToolResult } from "./tool-result";
+
+type GitHubRef = { object: { sha: string } };
+type GitHubCommit = { tree: { sha: string } };
+type GitHubTree = { sha: string };
+type GitHubNewCommit = {
+  sha: string;
+  message: string;
+  author: { name: string; date: string };
+};
+
+/** The subset of node-fetch's surface these operations use. */
+export type FileOpsFetch = (
+  url: string,
+  init?: {
+    method?: string;
+    headers?: Record<string, string>;
+    body?: string;
+  },
+) => Promise<{
+  ok: boolean;
+  status: number;
+  json: () => Promise<unknown>;
+  text: () => Promise<string>;
+}>;
+
+export type FileOpsConfig = {
+  owner: string;
+  repo: string;
+  /** Branch the commit lands on; created from baseBranch if it does not exist. */
+  branch: string;
+  baseBranch: string;
+  /** Root of the local checkout, used to resolve and validate file paths. */
+  repoDir: string;
+  githubToken: string;
+  /** Injectable for tests; defaults to node-fetch. */
+  fetchFn?: FileOpsFetch;
+};
+
+const json = (githubToken: string) => ({
+  Accept: "application/vnd.github+json",
+  Authorization: `Bearer ${githubToken}`,
+  "X-GitHub-Api-Version": "2022-11-28",
+});
+
+const jsonWrite = (githubToken: string) => ({
+  ...json(githubToken),
+  "Content-Type": "application/json",
+});
+
+/** Resolve the branch head, creating the branch from baseBranch when absent. */
+async function getOrCreateBranchRef(config: FileOpsConfig): Promise<string> {
+  const { owner, repo, branch, baseBranch, githubToken } = config;
+  const doFetch = config.fetchFn ?? (nodeFetch as unknown as FileOpsFetch);
+  const base = `${GITHUB_API_URL}/repos/${owner}/${repo}`;
+
+  const refResponse = await doFetch(`${base}/git/refs/heads/${branch}`, {
+    headers: json(githubToken),
+  });
+  if (refResponse.ok) {
+    return ((await refResponse.json()) as GitHubRef).object.sha;
+  }
+  if (refResponse.status !== 404) {
+    throw new Error(`Failed to get branch reference: ${refResponse.status}`);
+  }
+
+  let baseSha: string;
+  const baseRefResponse = await doFetch(
+    `${base}/git/refs/heads/${baseBranch}`,
+    {
+      headers: json(githubToken),
+    },
+  );
+  if (baseRefResponse.ok) {
+    baseSha = ((await baseRefResponse.json()) as GitHubRef).object.sha;
+  } else {
+    // Base branch is gone; fall back to the repository's default branch.
+    const repoResponse = await doFetch(base, { headers: json(githubToken) });
+    if (!repoResponse.ok) {
+      throw new Error(`Failed to get repository info: ${repoResponse.status}`);
+    }
+    const defaultBranch = (
+      (await repoResponse.json()) as { default_branch: string }
+    ).default_branch;
+    const defaultRefResponse = await doFetch(
+      `${base}/git/refs/heads/${defaultBranch}`,
+      { headers: json(githubToken) },
+    );
+    if (!defaultRefResponse.ok) {
+      throw new Error(
+        `Failed to get default branch reference: ${defaultRefResponse.status}`,
+      );
+    }
+    baseSha = ((await defaultRefResponse.json()) as GitHubRef).object.sha;
+  }
+
+  const createRefResponse = await doFetch(`${base}/git/refs`, {
+    method: "POST",
+    headers: jsonWrite(githubToken),
+    body: JSON.stringify({ ref: `refs/heads/${branch}`, sha: baseSha }),
+  });
+  if (!createRefResponse.ok) {
+    throw new Error(
+      `Failed to create branch: ${createRefResponse.status} - ${await createRefResponse.text()}`,
+    );
+  }
+
+  console.log(`Successfully created branch ${branch}`);
+  return baseSha;
+}
+
+/**
+ * Git file mode for a local path. Uses stat, which follows symlinks, so a link
+ * is reported as whatever it points at - the tree entry records the effective
+ * content, which is what commit_files uploads.
+ */
+async function getFileMode(filePath: string): Promise<string> {
+  try {
+    const fileStat = await stat(filePath);
+    if (fileStat.isDirectory()) return "040000";
+    if (fileStat.isFile() && fileStat.mode & constants.S_IXUSR) return "100755";
+    return "100644";
+  } catch (error) {
+    console.warn(
+      `Could not determine file mode for ${filePath}, using default: ${error}`,
+    );
+    return "100644";
+  }
+}
+
+/** Fetch the base commit's tree sha. */
+async function getBaseTreeSha(
+  config: FileOpsConfig,
+  baseSha: string,
+): Promise<string> {
+  const doFetch = config.fetchFn ?? (nodeFetch as unknown as FileOpsFetch);
+  const response = await doFetch(
+    `${GITHUB_API_URL}/repos/${config.owner}/${config.repo}/git/commits/${baseSha}`,
+    { headers: json(config.githubToken) },
+  );
+  if (!response.ok) {
+    throw new Error(`Failed to get base commit: ${response.status}`);
+  }
+  return ((await response.json()) as GitHubCommit).tree.sha;
+}
+
+/** Create a tree, then a commit on it, then move the branch ref. */
+async function commitTree(
+  config: FileOpsConfig,
+  baseSha: string,
+  baseTreeSha: string,
+  tree: unknown[],
+  message: string,
+): Promise<{ commit: GitHubNewCommit; treeSha: string }> {
+  const { owner, repo, branch, githubToken } = config;
+  const doFetch = config.fetchFn ?? (nodeFetch as unknown as FileOpsFetch);
+  const base = `${GITHUB_API_URL}/repos/${owner}/${repo}`;
+
+  const treeResponse = await doFetch(`${base}/git/trees`, {
+    method: "POST",
+    headers: jsonWrite(githubToken),
+    body: JSON.stringify({ base_tree: baseTreeSha, tree }),
+  });
+  if (!treeResponse.ok) {
+    throw new Error(
+      `Failed to create tree: ${treeResponse.status} - ${await treeResponse.text()}`,
+    );
+  }
+  const treeData = (await treeResponse.json()) as GitHubTree;
+
+  const commitResponse = await doFetch(`${base}/git/commits`, {
+    method: "POST",
+    headers: jsonWrite(githubToken),
+    body: JSON.stringify({ message, tree: treeData.sha, parents: [baseSha] }),
+  });
+  if (!commitResponse.ok) {
+    throw new Error(
+      `Failed to create commit: ${commitResponse.status} - ${await commitResponse.text()}`,
+    );
+  }
+  const commit = (await commitResponse.json()) as GitHubNewCommit;
+
+  await updateGitReference({
+    owner,
+    repo,
+    branch,
+    sha: commit.sha,
+    githubToken,
+    ...(config.fetchFn ? { fetchFn: config.fetchFn as never } : {}),
+  });
+
+  return { commit, treeSha: treeData.sha };
+}
+
+/**
+ * Commit one or more local files to the branch in a single commit. Text files
+ * are inlined in the tree; anything that does not survive a UTF-8 decode is
+ * uploaded as a base64 blob first, because inlining would corrupt it.
+ */
+export async function commitFiles(
+  { files, message }: { files: string[]; message: string },
+  config: FileOpsConfig,
+): Promise<ToolResult> {
+  const doFetch = config.fetchFn ?? (nodeFetch as unknown as FileOpsFetch);
+  try {
+    const validatedFiles = await Promise.all(
+      files.map(async (filePath) => ({
+        fullPath: await validatePathWithinRepo(filePath, config.repoDir),
+        // The tree entry uses the normalized original path, not the
+        // symlink-resolved one.
+        relativePath: resolveRepoRelativePath(filePath, config.repoDir),
+      })),
+    );
+
+    const baseSha = await getOrCreateBranchRef(config);
+    const baseTreeSha = await getBaseTreeSha(config, baseSha);
+
+    const tree = await Promise.all(
+      validatedFiles.map(async ({ fullPath, relativePath }) => {
+        const mode = await getFileMode(fullPath);
+        const content = await readFile(fullPath);
+
+        if (!isBinaryContent(content)) {
+          return {
+            path: relativePath,
+            mode,
+            type: "blob",
+            content: content.toString("utf-8"),
+          };
+        }
+
+        const blobResponse = await doFetch(
+          `${GITHUB_API_URL}/repos/${config.owner}/${config.repo}/git/blobs`,
+          {
+            method: "POST",
+            headers: jsonWrite(config.githubToken),
+            body: JSON.stringify({
+              content: content.toString("base64"),
+              encoding: "base64",
+            }),
+          },
+        );
+        if (!blobResponse.ok) {
+          throw new Error(
+            `Failed to create blob for ${relativePath}: ${blobResponse.status} - ${await blobResponse.text()}`,
+          );
+        }
+        const { sha } = (await blobResponse.json()) as { sha: string };
+        return { path: relativePath, mode, type: "blob", sha };
+      }),
+    );
+
+    const { commit, treeSha } = await commitTree(
+      config,
+      baseSha,
+      baseTreeSha,
+      tree,
+      message,
+    );
+
+    return ok({
+      commit: {
+        sha: commit.sha,
+        message: commit.message,
+        author: commit.author.name,
+        date: commit.author.date,
+      },
+      files: validatedFiles.map(({ relativePath }) => ({ path: relativePath })),
+      tree: { sha: treeSha },
+    });
+  } catch (error) {
+    return failed(error);
+  }
+}
+
+/**
+ * Delete one or more paths from the branch in a single commit. The paths need
+ * not exist in the local checkout - they are resolved as repository-relative
+ * tree paths and rejected if they escape the repository root.
+ */
+export async function deleteFiles(
+  { paths, message }: { paths: string[]; message: string },
+  config: FileOpsConfig,
+): Promise<ToolResult> {
+  try {
+    const processedPaths = paths.map((filePath) =>
+      resolveRepoRelativePath(filePath, config.repoDir),
+    );
+
+    const baseSha = await getOrCreateBranchRef(config);
+    const baseTreeSha = await getBaseTreeSha(config, baseSha);
+
+    const tree = processedPaths.map((path) => ({
+      path,
+      mode: "100644",
+      type: "blob" as const,
+      sha: null,
+    }));
+
+    const { commit, treeSha } = await commitTree(
+      config,
+      baseSha,
+      baseTreeSha,
+      tree,
+      message,
+    );
+
+    return ok({
+      commit: {
+        sha: commit.sha,
+        message: commit.message,
+        author: commit.author.name,
+        date: commit.author.date,
+      },
+      deletedFiles: processedPaths.map((path) => ({ path })),
+      tree: { sha: treeSha },
+    });
+  } catch (error) {
+    return failed(error);
+  }
+}
