diff --git a/test/parse-tools-agreement.test.ts b/test/parse-tools-agreement.test.ts
new file mode 100644
index 0000000..bf89b7e
--- /dev/null
+++ b/test/parse-tools-agreement.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, test } from "bun:test";
+import { parseAllowedTools } from "../src/modes/agent/parse-tools";
+import { parseSdkOptions } from "../base-action/src/parse-sdk-options";
+
+// parseAllowedTools decides which GitHub MCP servers get installed, and
+// parseSdkOptions builds the tool list the SDK is actually given. When the two
+// read the same claude_args differently, a tool can be granted with no server
+// installed, or a server installed for a tool that was never granted (#1357).
+// They now share one tokenizer; this is the gated check that they still agree.
+
+const sdkAllowedTools = (claudeArgs: string): string[] => {
+  const value = parseSdkOptions({ claudeArgs }).sdkOptions.allowedTools;
+  if (!value) return [];
+  return (Array.isArray(value) ? value : [value]).flatMap((v) =>
+    String(v).split(","),
+  );
+};
+
+describe("parseAllowedTools agrees with parseSdkOptions", () => {
+  // Each shell metacharacter the tokenizer escapes past shell-quote. The
+  // expected list is asserted on both sides: two parsers that agree on the
+  // wrong answer agree just as well as two that agree on the right one.
+  const metacharacterCases: [string, string[]][] = [
+    ["--allowedTools Bash(gh:*)", ["Bash(gh:*)"]],
+    ["--allowedTools Read(path/**)", ["Read(path/**)"]],
+    ["--allowedTools Bash(a;b)", ["Bash(a;b)"]],
+    ["--allowedTools Bash(a|b)", ["Bash(a|b)"]],
+    ["--allowedTools Bash(a&b)", ["Bash(a&b)"]],
+    ["--allowedTools Bash(a<b)", ["Bash(a<b)"]],
+    ["--allowedTools Bash(a>b)", ["Bash(a>b)"]],
+  ];
+
+  test.each(metacharacterCases)(
+    "keeps %p whole in both parsers",
+    (claudeArgs, expected) => {
+      expect(parseAllowedTools(claudeArgs)).toEqual(expected);
+      expect(sdkAllowedTools(claudeArgs)).toEqual(expected);
+    },
+  );
+
+  test("quoting the value is a no-op for both", () => {
+    expect(parseAllowedTools('--allowedTools "Bash(gh:*)"')).toEqual([
+      "Bash(gh:*)",
+    ]);
+    expect(sdkAllowedTools('--allowedTools "Bash(gh:*)"')).toEqual([
+      "Bash(gh:*)",
+    ]);
+  });
+
+  test.each([
+    "--allowedTools Read",
+    "--allowedTools Read,Grep",
+    '--allowedTools "Read" "Grep"',
+    "--allowed-tools Read",
+    "--allowedTools mcp__github__get_commit",
+    "--allowedTools mcp__github__*",
+    "--allowedTools Read --model sonnet",
+    "# --allowedTools Read\n--allowedTools Grep",
+  ])("agrees on %p", (claudeArgs) => {
+    expect([...parseAllowedTools(claudeArgs)].sort()).toEqual(
+      [...sdkAllowedTools(claudeArgs)].sort(),
+    );
+  });
+});
