@@ -0,0 +1,332 @@
+import { describe, expect, test, beforeEach, afterEach } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "fs";
+import { join } from "path";
+import { tmpdir } from "os";
+import {
+  classifyComments,
+  readBufferedComments,
+  replayBufferedComments,
+  type ReplayConfig,
+} from "../src/entrypoints/replay-buffered-comments";
+
+// This replay posts inline comments to a user's pull request and decides which
+// of them post, and until the logic was split out of the entrypoint nothing
+// could drive it: the module ran its whole pipeline at import. The stub below
+// records every request, so what reaches the pull request is asserted rather
+// than inferred.
+
+type Recorded = { url: string; method: string; body: unknown };
+
+function stub(responses: { status: number; body: unknown }[]) {
+  const calls: Recorded[] = [];
+  const queue = [...responses];
+  const fetchFn = (async (
+    url: unknown,
+    init: { method?: string; body?: string },
+  ) => {
+    calls.push({
+      url: String(url),
+      method: init?.method ?? "GET",
+      body: init?.body ? JSON.parse(init.body) : undefined,
+    });
+    const next = queue.shift();
+    if (!next) throw new Error(`unstubbed request: ${String(url)}`);
+    return new Response(JSON.stringify(next.body), {
+      status: next.status,
+      headers: { "content-type": "application/json" },
+    });
+  }) as unknown as typeof fetch;
+  return { fetchFn, calls };
+}
+
+const prHead = { status: 200, body: { head: { sha: "headsha" } } };
+const created = { status: 201, body: { id: 1, html_url: "u" } };
+
+const entry = (overrides: Record<string, unknown> = {}) => ({
+  ts: "2026-08-14T00:00:00Z",
+  path: "src/a.ts",
+  line: 3,
+  body: "a real review comment",
+  ...overrides,
+});
+
+describe("replayBufferedComments", () => {
+  let dir: string;
+  let bufferPath: string;
+  let base: Omit<ReplayConfig, "fetchFn">;
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), "replay-buffered-"));
+    bufferPath = join(dir, "buffer.jsonl");
+    base = {
+      bufferPath,
+      githubToken: "t",
+      owner: "o",
+      repo: "r",
+      prNumber: "1",
+    };
+  });
+
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  const write = (rows: Record<string, unknown>[]) =>
+    writeFileSync(
+      bufferPath,
+      rows.map((r) => JSON.stringify(r)).join("\n") + "\n",
+    );
+
+  test("a missing buffer file posts nothing", async () => {
+    const { fetchFn, calls } = stub([]);
+    const result = await replayBufferedComments({ ...base, fetchFn });
+    expect(result.reason).toBe("no-buffer");
+    expect(calls).toHaveLength(0);
+  });
+
+  test("an incomplete configuration posts nothing", async () => {
+    write([entry()]);
+    const { fetchFn, calls } = stub([prHead, created]);
+    const result = await replayBufferedComments({
+      ...base,
+      prNumber: undefined,
+      fetchFn,
+    });
+    expect(result.reason).toBe("incomplete-config");
+    expect(result.buffered).toBe(1);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("without an API key every candidate posts and confirmed=false never does", async () => {
+    write([
+      entry({ body: "first real comment", line: 3 }),
+      entry({ body: "never post me", line: 4, confirmed: false }),
+      entry({ body: "second real comment", line: 5, startLine: 2 }),
+    ]);
+    const { fetchFn, calls } = stub([prHead, created, created]);
+
+    const result = await replayBufferedComments({ ...base, fetchFn });
+
+    expect(result).toEqual({
+      reason: "posted",
+      buffered: 3,
+      neverPost: 1,
+      filtered: 0,
+      posted: 2,
+    });
+    expect(calls.map((c) => c.method)).toEqual(["GET", "POST", "POST"]);
+    expect(calls[0]!.url).toContain("/repos/o/r/pulls/1");
+    const bodies = calls.slice(1).map((c) => c.body as Record<string, unknown>);
+    expect(bodies.map((b) => b.body)).toEqual([
+      "first real comment",
+      "second real comment",
+    ]);
+    expect(bodies[0]).toMatchObject({
+      commit_id: "headsha",
+      side: "RIGHT",
+      line: 3,
+    });
+    expect(bodies[1]).toMatchObject({
+      start_line: 2,
+      start_side: "RIGHT",
+      line: 5,
+    });
+  });
+
+  test("an explicit commit id and side are honoured", async () => {
+    write([entry({ commit_id: "pinnedsha", side: "LEFT" })]);
+    const { fetchFn, calls } = stub([prHead, created]);
+
+    await replayBufferedComments({ ...base, fetchFn });
+
+    expect(calls[1]!.body).toMatchObject({
+      commit_id: "pinnedsha",
+      side: "LEFT",
+    });
+  });
+
+  test("a buffer of only confirmed=false comments makes no request", async () => {
+    write([entry({ confirmed: false }), entry({ confirmed: false })]);
+    const { fetchFn, calls } = stub([prHead, created]);
+
+    const result = await replayBufferedComments({ ...base, fetchFn });
+
+    expect(result).toMatchObject({
+      reason: "nothing-to-post",
+      neverPost: 2,
+      posted: 0,
+    });
+    expect(calls).toHaveLength(0);
+  });
+
+  test("classification drops the comments it judges test/probe", async () => {
+    write([
+      entry({ body: "real feedback about the loop", line: 3 }),
+      entry({ body: "Test comment, checking if this works", line: 4 }),
+    ]);
+    const { fetchFn, calls } = stub([
+      {
+        status: 200,
+        body: { content: [{ type: "text", text: "[true, false]" }] },
+      },
+      prHead,
+      created,
+    ]);
+
+    const result = await replayBufferedComments({
+      ...base,
+      anthropicApiKey: "sk-ant-key",
+      fetchFn,
+    });
+
+    expect(result).toMatchObject({ filtered: 1, posted: 1 });
+    expect(calls[0]!.url).toContain("api.anthropic.com");
+    const posted = calls.at(-1)!.body as Record<string, unknown>;
+    expect(posted.body).toBe("real feedback about the loop");
+  });
+
+  test("a classification response of the wrong shape posts everything", async () => {
+    write([entry({ body: "one" }), entry({ body: "two" })]);
+    const { fetchFn } = stub([
+      { status: 200, body: { content: [{ type: "text", text: "[true]" }] } },
+      prHead,
+      created,
+      created,
+    ]);
+
+    const result = await replayBufferedComments({
+      ...base,
+      anthropicApiKey: "sk-ant-key",
+      fetchFn,
+    });
+
+    expect(result).toMatchObject({ filtered: 0, posted: 2 });
+  });
+
+  test("a failing classification request posts everything", async () => {
+    write([entry()]);
+    const { fetchFn } = stub([
+      { status: 500, body: { error: "boom" } },
+      prHead,
+      created,
+    ]);
+
+    const result = await replayBufferedComments({
+      ...base,
+      anthropicApiKey: "sk-ant-key",
+      fetchFn,
+    });
+
+    expect(result).toMatchObject({ posted: 1 });
+  });
+
+  test("classification judging everything a probe posts nothing", async () => {
+    write([entry({ body: "Testing if this works" })]);
+    const { fetchFn, calls } = stub([
+      { status: 200, body: { content: [{ type: "text", text: "[false]" }] } },
+    ]);
+
+    const result = await replayBufferedComments({
+      ...base,
+      anthropicApiKey: "sk-ant-key",
+      fetchFn,
+    });
+
+    expect(result).toMatchObject({
+      reason: "nothing-to-post",
+      filtered: 1,
+      posted: 0,
+    });
+    expect(calls).toHaveLength(1);
+  });
+
+  test("a comment the API rejects does not stop the rest", async () => {
+    write([entry({ body: "one", line: 3 }), entry({ body: "two", line: 4 })]);
+    const { fetchFn } = stub([
+      prHead,
+      { status: 422, body: { message: "Validation Failed" } },
+      created,
+    ]);
+
+    const result = await replayBufferedComments({ ...base, fetchFn });
+
+    expect(result).toMatchObject({ posted: 1 });
+  });
+
+  test("a corrupt buffer line is an error, not a partial post", async () => {
+    writeFileSync(bufferPath, "not json at all\n");
+    const { fetchFn, calls } = stub([prHead, created]);
+
+    await expect(
+      replayBufferedComments({ ...base, fetchFn }),
+    ).rejects.toThrow();
+    expect(calls).toHaveLength(0);
+  });
+});
+
+describe("readBufferedComments", () => {
+  test("a missing file is an empty buffer", () => {
+    expect(readBufferedComments("/nonexistent/buffer.jsonl")).toEqual([]);
+  });
+
+  test("blank lines are skipped", () => {
+    const dir = mkdtempSync(join(tmpdir(), "replay-read-"));
+    const path = join(dir, "buffer.jsonl");
+    writeFileSync(path, `${JSON.stringify(entry())}\n\n`);
+    expect(readBufferedComments(path)).toHaveLength(1);
+    rmSync(dir, { recursive: true, force: true });
+  });
+});
+
+describe("classifyComments", () => {
+  test("no API key means no classification", async () => {
+    expect(await classifyComments(["a"], {})).toBeNull();
+  });
+
+  test("the verdicts are returned in order", async () => {
+    const { fetchFn, calls } = stub([
+      {
+        status: 200,
+        body: { content: [{ type: "text", text: "[false, true]" }] },
+      },
+    ]);
+    expect(
+      await classifyComments(["a", "b"], {
+        anthropicApiKey: "sk-ant-key",
+        fetchFn,
+      }),
+    ).toEqual([false, true]);
+    const body = calls[0]!.body as { messages: { content: string }[] };
+    expect(body.messages[0]!.content).toContain('1. "a"');
+    expect(body.messages[0]!.content).toContain('2. "b"');
+  });
+
+  test("prose around the array is tolerated", async () => {
+    const { fetchFn } = stub([
+      {
+        status: 200,
+        body: {
+          content: [{ type: "text", text: "Here you go:\n[true]\nDone." }],
+        },
+      },
+    ]);
+    expect(
+      await classifyComments(["a"], {
+        anthropicApiKey: "sk-ant-key",
+        fetchFn,
+      }),
+    ).toEqual([true]);
+  });
+
+  test("a response with no array at all yields null", async () => {
+    const { fetchFn } = stub([
+      { status: 200, body: { content: [{ type: "text", text: "no idea" }] } },
+    ]);
+    expect(
+      await classifyComments(["a"], {
+        anthropicApiKey: "sk-ant-key",
+        fetchFn,
+      }),
+    ).toBeNull();
+  });
+});
