+import { describe, expect, test, beforeEach, afterEach } from "bun:test";
+import { mkdtempSync, readFileSync, rmSync } from "fs";
+import { join } from "path";
+import { tmpdir } from "os";
+import {
+  downloadJobLog,
+  getCiStatus,
+  getWorkflowRunDetails,
+  type ActionsConfig,
+} from "../src/mcp/github-actions";
+
+// The three CI tools summarise workflow runs, extract failed steps and write
+// job logs to disk, and until the handlers were split out of the server
+// bootstrap nothing could drive them: importing the server exited without its
+// environment and hung with it. The stub below records every request so both
+// the requests issued and the summaries computed from the responses can be
+// asserted directly.
+
+type Recorded = { url: string; method: string };
+
+function stubGitHub(
+  responses: { status: number; body: unknown; contentType?: string }[],
+) {
+  const calls: Recorded[] = [];
+  const queue = [...responses];
+
+  const fetchFn = (async (
+    url: unknown,
+    init: { method?: string; body?: string },
+  ) => {
+    calls.push({ url: String(url), method: init?.method ?? "GET" });
+
+    const next = queue.shift();
+    if (!next) {
+      throw new Error(`unstubbed request: ${init?.method} ${String(url)}`);
+    }
+    const contentType = next.contentType ?? "application/json";
+    const body =
+      contentType === "application/json"
+        ? JSON.stringify(next.body)
+        : String(next.body);
+    return new Response(body, {
+      status: next.status,
+      headers: { "content-type": contentType },
+    });
+  }) as unknown as typeof fetch;
+
+  return { fetchFn, calls };
+}
+
+const prHead = { status: 200, body: { head: { sha: "headsha" } } };
+
+const run = (
+  id: number,
+  status: string,
+  conclusion: string | null,
+  name = `run-${id}`,
+) => ({
+  id,
+  name,
+  status,
+  conclusion,
+  html_url: `https://github.com/o/r/actions/runs/${id}`,
+  created_at: "2026-08-14T00:00:00Z",
+});
+
+const payloadOf = (result: { content: { text: string }[] }) =>
+  JSON.parse(result.content[0]!.text);
+
+describe("CI tool handlers", () => {
+  let dir: string;
+  let base: Omit<ActionsConfig, "fetchFn">;
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), "ci-tools-"));
+    base = {
+      owner: "o",
+      repo: "r",
+      prNumber: "7",
+      githubToken: "t",
+      runnerTemp: dir,
+    };
+  });
+
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  describe("get_ci_status", () => {
+    test("counts passed, failed and pending runs from the head sha", async () => {
+      const { fetchFn, calls } = stubGitHub([
+        prHead,
+        {
+          status: 200,
+          body: {
+            total_count: 4,
+            workflow_runs: [
+              run(1, "completed", "success"),
+              run(2, "completed", "failure"),
+              run(3, "in_progress", null),
+              run(4, "queued", null),
+            ],
+          },
+        },
+      ]);
+
+      const result = await getCiStatus({}, { ...base, fetchFn });
+
+      expect(calls[0]!.url).toContain("/repos/o/r/pulls/7");
+      expect(calls[1]!.url).toContain("/repos/o/r/actions/runs");
+      expect(calls[1]!.url).toContain("head_sha=headsha");
