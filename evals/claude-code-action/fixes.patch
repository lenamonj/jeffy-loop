diff --git a/test/github-file-ops.test.ts b/test/github-file-ops.test.ts
new file mode 100644
index 0000000..1b466d2
--- /dev/null
+++ b/test/github-file-ops.test.ts
@@ -0,0 +1,322 @@
+import { describe, expect, test, beforeEach, afterEach } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync, mkdirSync, symlinkSync } from "fs";
+import { join } from "path";
+import { tmpdir } from "os";
+import {
+  commitFiles,
+  deleteFiles,
+  type FileOpsConfig,
+  type FileOpsFetch,
+} from "../src/mcp/github-file-ops";
+
+// These two operations write to and delete from a user's repository, and until
+// the handlers were split out of the server bootstrap nothing could drive them:
+// importing the server exited or hung. The stub below records every request so
+// the tree the operations build can be asserted directly.
+
+type Recorded = { url: string; method: string; body: unknown };
+
+function stubGitHub(
+  overrides: Record<string, () => { status: number; body: unknown }> = {},
+) {
+  const calls: Recorded[] = [];
+  const respond = (status: number, body: unknown) => ({
+    ok: status >= 200 && status < 300,
+    status,
+    json: async () => body,
+    text: async () => JSON.stringify(body),
+  });
+
+  const fetchFn: FileOpsFetch = async (url, init) => {
+    const method = init?.method ?? "GET";
+    calls.push({
+      url,
+      method,
+      body: init?.body ? JSON.parse(init.body) : undefined,
+    });
+
+    for (const [pattern, make] of Object.entries(overrides)) {
+      if (url.includes(pattern)) {
+        const { status, body } = make();
+        return respond(status, body);
+      }
+    }
+
+    if (url.includes("/git/refs/heads/") && method === "GET") {
+      return respond(200, { object: { sha: "basesha" } });
+    }
+    if (url.includes("/git/commits/") && method === "GET") {
+      return respond(200, { tree: { sha: "basetree" } });
+    }
+    if (url.includes("/git/blobs")) {
+      return respond(201, { sha: "blobsha" });
+    }
+    if (url.includes("/git/trees")) {
+      return respond(201, { sha: "newtree" });
+    }
+    if (url.includes("/git/commits")) {
+      return respond(201, {
+        sha: "newcommit",
+        message: "m",
+        author: { name: "claude", date: "2026-08-14T00:00:00Z" },
+      });
+    }
+    if (url.includes("/git/refs/heads/") && method === "PATCH") {
+      return respond(200, {});
+    }
+    throw new Error(`unstubbed request: ${method} ${url}`);
+  };
+
+  return { fetchFn, calls };
+}
+
+const treeOf = (calls: Recorded[]) =>
+  (calls.find((c) => c.url.includes("/git/trees"))?.body as { tree: unknown[] })
+    .tree;
+
+describe("file ops handlers", () => {
+  let repoDir: string;
+  let config: Omit<FileOpsConfig, "fetchFn">;
+
+  beforeEach(() => {
+    repoDir = mkdtempSync(join(tmpdir(), "file-ops-"));
+    mkdirSync(join(repoDir, "src"), { recursive: true });
+    config = {
+      owner: "o",
+      repo: "r",
+      branch: "claude/x",
+      baseBranch: "main",
+      repoDir,
+      githubToken: "t",
+    };
+  });
+
+  afterEach(() => {
+    rmSync(repoDir, { recursive: true, force: true });
+  });
+
+  describe("commitFiles", () => {
+    test("inlines a text file in the tree", async () => {
+      writeFileSync(join(repoDir, "src", "a.ts"), "hello\n");
+      const { fetchFn, calls } = stubGitHub();
+
+      const result = await commitFiles(
+        { files: ["src/a.ts"], message: "add a" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBeUndefined();
+      expect(treeOf(calls)).toEqual([
+        {
+          path: "src/a.ts",
+          mode: "100644",
+          type: "blob",
+          content: "hello\n",
+        },
+      ]);
+      expect(calls.some((c) => c.url.includes("/git/blobs"))).toBe(false);
+    });
+
+    test("uploads a binary file as a base64 blob instead of inlining it", async () => {
+      writeFileSync(
+        join(repoDir, "img.png"),
+        Buffer.from([0x89, 0x50, 0x00, 0xff]),
+      );
+      const { fetchFn, calls } = stubGitHub();
+
+      await commitFiles(
+        { files: ["img.png"], message: "add img" },
+        { ...config, fetchFn },
+      );
+
+      const blob = calls.find((c) => c.url.includes("/git/blobs"));
+      expect(blob?.body).toEqual({
+        content: Buffer.from([0x89, 0x50, 0x00, 0xff]).toString("base64"),
+        encoding: "base64",
+      });
+      expect(treeOf(calls)).toEqual([
+        { path: "img.png", mode: "100644", type: "blob", sha: "blobsha" },
+      ]);
+    });
+
+    test("records the executable bit in the tree mode", async () => {
+      const p = join(repoDir, "run.sh");
+      writeFileSync(p, "#!/bin/sh\n", { mode: 0o755 });
+      const { fetchFn, calls } = stubGitHub();
+
+      await commitFiles(
+        { files: ["run.sh"], message: "add" },
+        { ...config, fetchFn },
+      );
+
+      expect((treeOf(calls)[0] as { mode: string }).mode).toBe("100755");
+    });
+
+    // getFileMode uses stat, not lstat, so a symlink is recorded as whatever it
+    // points at rather than as git's 120000 link mode. That is the right choice
+    // here because commit_files uploads the effective content, and pinning it
+    // stops the unreachable 120000 branch being reintroduced.
+    test("records a symlink as its target's mode, not as a git link", async () => {
+      const target = join(repoDir, "target.sh");
+      writeFileSync(target, "#!/bin/sh\n", { mode: 0o755 });
+      symlinkSync(target, join(repoDir, "link.sh"));
+      const { fetchFn, calls } = stubGitHub();
+
+      await commitFiles(
+        { files: ["link.sh"], message: "add" },
+        { ...config, fetchFn },
+      );
+
+      const entry = treeOf(calls)[0] as { path: string; mode: string };
+      expect(entry.mode).toBe("100755");
+      expect(entry.mode).not.toBe("120000");
+      expect(entry.path).toBe("link.sh");
+    });
+
+    test("commits several files in one tree and points the branch at the new commit", async () => {
+      writeFileSync(join(repoDir, "a.txt"), "a");
+      writeFileSync(join(repoDir, "b.txt"), "b");
+      const { fetchFn, calls } = stubGitHub();
+
+      await commitFiles(
+        { files: ["a.txt", "b.txt"], message: "two" },
+        { ...config, fetchFn },
+      );
+
+      expect(treeOf(calls)).toHaveLength(2);
+      const commit = calls.find(
+        (c) => c.method === "POST" && c.url.endsWith("/git/commits"),
+      );
+      expect(commit?.body).toEqual({
+        message: "two",
+        tree: "newtree",
+        parents: ["basesha"],
+      });
+      const patch = calls.find((c) => c.method === "PATCH");
+      expect(patch?.url).toContain("/git/refs/heads/claude/x");
+      expect(patch?.body).toEqual({ sha: "newcommit", force: false });
+    });
+
+    test("creates the branch from the base branch when it does not exist", async () => {
+      writeFileSync(join(repoDir, "a.txt"), "a");
+      let headLookups = 0;
+      const { fetchFn, calls } = stubGitHub({
+        "/git/refs/heads/": () => {
+          headLookups++;
+          // First lookup is the target branch (absent), second is the base.
+          return headLookups === 1
+            ? { status: 404, body: {} }
+            : { status: 200, body: { object: { sha: "mainsha" } } };
+        },
+      });
+
+      await commitFiles(
+        { files: ["a.txt"], message: "m" },
+        { ...config, fetchFn },
+      );
+
+      const create = calls.find(
+        (c) => c.method === "POST" && c.url.endsWith("/git/refs"),
+      );
+      expect(create?.body).toEqual({
+        ref: "refs/heads/claude/x",
+        sha: "mainsha",
+      });
+    });
+
+    test("returns an error result rather than throwing when the tree call fails", async () => {
+      writeFileSync(join(repoDir, "a.txt"), "a");
+      const { fetchFn } = stubGitHub({
+        "/git/trees": () => ({ status: 422, body: { message: "bad tree" } }),
+      });
+
+      const result = await commitFiles(
+        { files: ["a.txt"], message: "m" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBe(true);
+      expect(result.error).toContain("Failed to create tree: 422");
+    });
+
+    test("refuses a path outside the repository root", async () => {
+      const { fetchFn, calls } = stubGitHub();
+
+      const result = await commitFiles(
+        { files: ["../escape.txt"], message: "m" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBe(true);
+      expect(result.error).toMatch(/resolves outside the repository root/);
+      expect(calls).toHaveLength(0);
+    });
+  });
+
+  describe("deleteFiles", () => {
+    test("builds a null-sha tree entry per path", async () => {
+      const { fetchFn, calls } = stubGitHub();
+
+      const result = await deleteFiles(
+        { paths: ["src/old.ts", "docs/gone.md"], message: "remove" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBeUndefined();
+      expect(treeOf(calls)).toEqual([
+        { path: "src/old.ts", mode: "100644", type: "blob", sha: null },
+        { path: "docs/gone.md", mode: "100644", type: "blob", sha: null },
+      ]);
+    });
+
+    test("deletes a path that does not exist in the local checkout", async () => {
+      const { fetchFn, calls } = stubGitHub();
+
+      const result = await deleteFiles(
+        { paths: ["only/in/remote.txt"], message: "remove" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBeUndefined();
+      expect((treeOf(calls)[0] as { path: string }).path).toBe(
+        "only/in/remote.txt",
+      );
+    });
+
+    test("normalizes an absolute path inside the repository", async () => {
+      const { fetchFn, calls } = stubGitHub();
+
+      await deleteFiles(
+        { paths: [join(repoDir, "src", "old.ts")], message: "remove" },
+        { ...config, fetchFn },
+      );
+
+      expect((treeOf(calls)[0] as { path: string }).path).toBe("src/old.ts");
+    });
+
+    test("refuses a sibling directory that merely shares the root's prefix", async () => {
+      const { fetchFn, calls } = stubGitHub();
+
+      const result = await deleteFiles(
+        { paths: [`${repoDir}-extra/secret.txt`], message: "remove" },
+        { ...config, fetchFn },
+      );
+
+      expect(result.isError).toBe(true);
