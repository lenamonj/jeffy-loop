diff --git a/test/github-inline-comment.test.ts b/test/github-inline-comment.test.ts
new file mode 100644
index 0000000..cf1a883
--- /dev/null
+++ b/test/github-inline-comment.test.ts
@@ -0,0 +1,308 @@
+import { describe, expect, test, beforeEach, afterEach } from "bun:test";
+import { existsSync, mkdtempSync, readFileSync, rmSync } from "fs";
+import { join } from "path";
+import { tmpdir } from "os";
+import {
+  createInlineComment,
+  type InlineCommentConfig,
+} from "../src/mcp/github-inline-comment";
+
+// create_inline_comment either buffers a call for post-session classification
+// or posts it to the PR, and until the handler was split out of the server
+// bootstrap nothing could drive either path: importing the server exited
+// without its environment and hung with it. The stub below records every
+// request so the endpoint, the buffering decision and the line parameters can
+// be asserted directly.
+
+type Recorded = { url: string; method: string; body: unknown };
+
+function stubGitHub(responses: { status: number; body: unknown }[]) {
+  const calls: Recorded[] = [];
+  const queue = [...responses];
+
+  const fetchFn = (async (
+    url: unknown,
+    init: { method?: string; body?: string },
+  ) => {
+    calls.push({
+      url: String(url),
+      method: init?.method ?? "GET",
+      body: init?.body ? JSON.parse(init.body) : undefined,
+    });
+
+    const next = queue.shift();
+    if (!next) {
+      throw new Error(`unstubbed request: ${init?.method} ${String(url)}`);
+    }
+    return new Response(JSON.stringify(next.body), {
+      status: next.status,
+      headers: { "content-type": "application/json" },
+    });
+  }) as unknown as typeof fetch;
+
+  return { fetchFn, calls };
+}
+
+const prHead = {
+  status: 200,
+  body: { head: { sha: "headsha" } },
+};
+
+const created = {
+  status: 201,
+  body: {
+    id: 99,
+    html_url: "https://github.com/o/r/pull/1#discussion_r99",
+    path: "src/index.ts",
+    line: 12,
+  },
+};
+
+const posting = () => stubGitHub([prHead, created]);
+
+const payloadOf = (result: { content: { text: string }[] }) =>
+  JSON.parse(result.content[0]!.text);
+
+const bufferLines = (path: string) =>
+  existsSync(path)
+    ? readFileSync(path, "utf8")
+        .split("\n")
+        .filter((l) => l.trim() !== "")
+    : [];
+
+describe("create_inline_comment handler", () => {
+  let dir: string;
+  let bufferPath: string;
+  let base: Omit<InlineCommentConfig, "fetchFn">;
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), "inline-comment-"));
+    bufferPath = join(dir, "buffer.jsonl");
+    base = {
+      owner: "o",
+      repo: "r",
+      prNumber: "1",
+      githubToken: "t",
+      classifyEnabled: true,
+      bufferPath,
+    };
+  });
+
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  test("buffers an unconfirmed call instead of posting it", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "src/index.ts", body: "looks wrong", line: 12 },
+      { ...base, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(payloadOf(result).buffered).toBe(true);
+
+    const buffered = bufferLines(bufferPath).map((l) => JSON.parse(l));
+    expect(buffered).toHaveLength(1);
+    expect(buffered[0].path).toBe("src/index.ts");
+    expect(buffered[0].line).toBe(12);
+    expect(buffered[0].body).toBe("looks wrong");
+  });
+
+  test("confirmed=false buffers as well", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b", line: 3, confirmed: false },
+      { ...base, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(payloadOf(result).buffered).toBe(true);
+    expect(bufferLines(bufferPath)).toHaveLength(1);
+  });
+
+  test("classifyEnabled=false posts an unconfirmed call immediately", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b", line: 3 },
+      { ...base, classifyEnabled: false, fetchFn },
+    );
+
+    expect(calls).toHaveLength(2);
+    expect(bufferLines(bufferPath)).toHaveLength(0);
+    expect(payloadOf(result).comment_id).toBe(99);
+  });
+
+  test("confirmed=true posts a single-line comment on the PR head sha", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "src/index.ts", body: "nit", line: 12, confirmed: true },
+      { ...base, fetchFn },
+    );
+
+    expect(calls).toHaveLength(2);
+    expect(calls[0]!.method).toBe("GET");
+    expect(calls[0]!.url).toContain("/repos/o/r/pulls/1");
+    expect(calls[1]!.method).toBe("POST");
+    expect(calls[1]!.url).toContain("/repos/o/r/pulls/1/comments");
+    // owner, repo and pull_number are consumed into the URL above, so the
+    // JSON body carries only the comment parameters.
+    expect(calls[1]!.body).toEqual({
+      body: "nit",
+      path: "src/index.ts",
+      side: "RIGHT",
+      commit_id: "headsha",
+      line: 12,
+    });
+    expect(payloadOf(result).message).toContain("at line 12");
+  });
+
+  test("a start line turns it into a multi-line comment", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      {
+        path: "a.ts",
+        body: "b",
+        startLine: 4,
+        line: 9,
+        confirmed: true,
+      },
+      { ...base, fetchFn },
+    );
+
+    expect(calls[1]!.body).toMatchObject({
+      start_line: 4,
+      start_side: "RIGHT",
+      line: 9,
+    });
+    expect(payloadOf(result).message).toContain("from line 4 to 9");
+  });
+
+  test("side and commit_id override the defaults", async () => {
+    const { fetchFn, calls } = posting();
+
+    await createInlineComment(
+      {
+        path: "a.ts",
+        body: "b",
+        startLine: 4,
+        line: 9,
+        side: "LEFT",
+        commit_id: "pinnedsha",
+        confirmed: true,
+      },
+      { ...base, fetchFn },
+    );
+
+    expect(calls[1]!.body).toMatchObject({
+      side: "LEFT",
+      start_side: "LEFT",
+      commit_id: "pinnedsha",
+    });
+  });
+
+  test("sanitizes the body on both the buffered and the posted path", async () => {
+    const hidden = "![hidden instructions](https://example.com/x.png)";
+    const clean = "![](https://example.com/x.png)";
+
+    const buffered = posting();
+    await createInlineComment(
+      { path: "a.ts", body: hidden, line: 1 },
+      { ...base, fetchFn: buffered.fetchFn },
+    );
+    expect(JSON.parse(bufferLines(bufferPath)[0]!).body).toBe(clean);
+
+    const posted = posting();
+    await createInlineComment(
+      { path: "a.ts", body: hidden, line: 1, confirmed: true },
+      { ...base, fetchFn: posted.fetchFn },
+    );
+    expect((posted.calls[1]!.body as { body: string }).body).toBe(clean);
+  });
+
+  test("posting a previously buffered comment drops the buffered copy", async () => {
+    const first = posting();
+    await createInlineComment(
+      { path: "src/index.ts", body: "looks wrong", line: 12 },
+      { ...base, fetchFn: first.fetchFn },
+    );
+    expect(bufferLines(bufferPath)).toHaveLength(1);
+
+    const second = posting();
+    await createInlineComment(
+      { path: "src/index.ts", body: "looks wrong", line: 12, confirmed: true },
+      { ...base, fetchFn: second.fetchFn },
+    );
+
+    expect(second.calls).toHaveLength(2);
+    expect(bufferLines(bufferPath)).toHaveLength(0);
+  });
+
+  test("rejects a call with neither line nor startLine, buffering nothing", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b" },
+      { ...base, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(bufferLines(bufferPath)).toHaveLength(0);
+    expect(result.isError).toBe(true);
+    expect(result.error).toContain("must be provided");
+  });
+
+  test("returns an error result without a token, issuing no request", async () => {
+    const { fetchFn, calls } = posting();
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b", line: 1, confirmed: true },
+      { ...base, githubToken: undefined, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(result.isError).toBe(true);
+    expect(result.error).toBe("GITHUB_TOKEN environment variable is required");
+  });
+
+  test("explains a validation failure from the API", async () => {
+    const { fetchFn } = stubGitHub([
+      prHead,
+      { status: 422, body: { message: "Validation Failed" } },
+    ]);
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b", line: 9999, confirmed: true },
+      { ...base, fetchFn },
+    );
+
+    expect(result.isError).toBe(true);
+    expect(result.content[0]!.text).toContain(
+      "Error creating inline comment: Validation Failed",
+    );
+    expect(result.content[0]!.text).toContain(
+      "line number doesn't exist in the diff",
+    );
+  });
+
+  test("explains a missing PR from the API", async () => {
+    const { fetchFn } = stubGitHub([
+      { status: 404, body: { message: "Not Found" } },
+    ]);
+
+    const result = await createInlineComment(
+      { path: "a.ts", body: "b", line: 1, confirmed: true },
+      { ...base, fetchFn },
+    );
+
+    expect(result.isError).toBe(true);
+    expect(result.content[0]!.text).toContain(
+      "PR number, repository, or file path is incorrect",
+    );
+  });
+});
