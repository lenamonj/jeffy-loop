@@ -0,0 +1,60 @@
+// The update_claude_comment tool implementation, kept separate from the MCP
+// server bootstrap in github-comment-server.ts so it can be imported and
+// driven directly. Repository coordinates, the comment id, the token, the
+// event name and the HTTP client all arrive as an explicit config rather than
+// through module-level environment reads.
+import { Octokit } from "@octokit/rest";
+import { GITHUB_API_URL } from "../github/api/config";
+import { updateClaudeComment } from "../github/operations/comments/update-claude-comment";
+import { sanitizeContent } from "../github/utils/sanitizer";
+import { failed, ok, type ToolResult } from "./tool-result";
+
+export type CommentConfig = {
+  owner: string;
+  repo: string;
+  /**
+   * The tracking comment to update. Optional because the launcher omits
+   * CLAUDE_COMMENT_ID when the action created no tracking comment, so a
+   * missing id stays a tool-time error rather than a startup failure.
+   */
+  commentId?: string;
+  githubToken?: string;
+  /** Selects the review-comment API when it is pull_request_review_comment. */
+  eventName?: string;
+  /** Injectable for tests; defaults to the fetch Octokit would use. */
+  fetchFn?: typeof fetch;
+};
+
+export async function updateClaudeCommentTool(
+  { body }: { body: string },
+  config: CommentConfig,
+): Promise<ToolResult> {
+  try {
+    const { owner, repo, commentId, githubToken, eventName, fetchFn } = config;
+
+    if (!githubToken) {
+      throw new Error("GITHUB_TOKEN environment variable is required");
+    }
+    if (!commentId) {
+      throw new Error("CLAUDE_COMMENT_ID environment variable is required");
+    }
+
+    const octokit = new Octokit({
+      auth: githubToken,
+      baseUrl: GITHUB_API_URL,
+      ...(fetchFn && { request: { fetch: fetchFn } }),
+    });
+
+    const result = await updateClaudeComment(octokit, {
+      owner,
+      repo,
+      commentId: parseInt(commentId, 10),
+      body: sanitizeContent(body),
+      isPullRequestReviewComment: eventName === "pull_request_review_comment",
+    });
+
+    return ok(result);
+  } catch (error) {
+    return failed(error);
+  }
+}
