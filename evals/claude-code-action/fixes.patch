+import { readFileSync } from "node:fs";
+import { describe, expect, test, afterEach } from "bun:test";
+import { collectActionInputsPresence } from "../src/entrypoints/collect-inputs";
+
+// Parse action.yml's `inputs:` block into name -> declared default. An input
+// with no `default:` line resolves to "" in GitHub Actions.
+function declaredInputDefaults(): Record<string, string> {
+  const yml = readFileSync(
+    new URL("../action.yml", import.meta.url),
+    "utf8",
+  ).replace(/\r\n/g, "\n");
+  const section = yml.slice(
+    yml.indexOf("\ninputs:"),
+    yml.indexOf("\noutputs:"),
+  );
+  const defaults: Record<string, string> = {};
+  for (const block of section.split(/\n(?=  [a-z_]+:\n)/).slice(1)) {
+    const name = block.match(/^ {2}([a-z_]+):/)?.[1];
+    if (!name) continue;
+    defaults[name] = block.match(/^ {4}default: "([^"]*)"/m)?.[1] ?? "";
+  }
+  return defaults;
+}
+
+const ORIGINAL_ALL_INPUTS = process.env.ALL_INPUTS;
+
+afterEach(() => {
+  if (ORIGINAL_ALL_INPUTS === undefined) {
+    delete process.env.ALL_INPUTS;
+  } else {
+    process.env.ALL_INPUTS = ORIGINAL_ALL_INPUTS;
+  }
+});
+
+describe("collectActionInputsPresence", () => {
+  test("reports nothing set for a workflow that overrides nothing", () => {
+    const defaults = declaredInputDefaults();
+    process.env.ALL_INPUTS = JSON.stringify(defaults);
+
+    const reported = JSON.parse(collectActionInputsPresence());
+
+    expect(Object.keys(reported).sort()).toEqual(Object.keys(defaults).sort());
+    expect(
+      Object.entries(reported)
+        .filter(([, isSet]) => isSet)
+        .map(([name]) => name),
+    ).toEqual([]);
+  });
+
+  test("reports exactly the inputs whose value differs from the default", () => {
+    const defaults = declaredInputDefaults();
+    process.env.ALL_INPUTS = JSON.stringify({
+      ...defaults,
+      prompt: "do the thing",
+      use_commit_signing: "true",
+    });
+
+    const reported = JSON.parse(collectActionInputsPresence());
+
+    expect(
+      Object.entries(reported)
+        .filter(([, isSet]) => isSet)
+        .map(([name]) => name)
+        .sort(),
+    ).toEqual(["prompt", "use_commit_signing"]);
+  });
+
+  test("an input missing from ALL_INPUTS is not reported as set", () => {
+    process.env.ALL_INPUTS = JSON.stringify({});
+
+    const reported = JSON.parse(collectActionInputsPresence());
+
+    expect(Object.values(reported).some(Boolean)).toBe(false);
+  });
+
+  test("returns an empty object when ALL_INPUTS is absent or unparseable", () => {
+    delete process.env.ALL_INPUTS;
+    expect(collectActionInputsPresence()).toBe("{}");
+
+    process.env.ALL_INPUTS = "{not json";
+    expect(collectActionInputsPresence()).toBe("{}");
+  });
+});
