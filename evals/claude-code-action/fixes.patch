diff --git a/test/prepare-error-propagation.test.ts b/test/prepare-error-propagation.test.ts
new file mode 100644
index 0000000..b52550b
--- /dev/null
+++ b/test/prepare-error-propagation.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, test, beforeAll, afterAll } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "fs";
+import { join, resolve } from "path";
+import { tmpdir } from "os";
+
+// The prepare-path helpers run inside run.ts's try block, whose finally updates
+// the tracking comment and writes the step summary. process.exit() in one of
+// their catch blocks kills the process before that finally can run, so the
+// user's comment stays on "Claude Code is working…" and the failure appears
+// nowhere but the workflow log.
+//
+// A stubbed process.exit cannot show this: stubbing it is exactly what stops
+// the process from dying. Each case therefore runs in a real subprocess, where
+// an exit really is an exit, and asserts the caller's finally still ran.
+
+const repoRoot = resolve(import.meta.dir, "..");
+
+const CASES: { name: string; imports: string; setup?: string; call: string }[] =
+  [
+    {
+      name: "setupBranch",
+      imports: `import { setupBranch } from ${JSON.stringify(`${repoRoot}/src/github/operations/branch`)};`,
+      setup: `
+const octokits = {
+  rest: {
+    repos: { get: async () => ({ data: { default_branch: "main" } }) },
+    git: { getRef: async () => { throw new Error("getRef failed"); } },
+  },
+};
+const githubData = { contextData: { title: "Add feature", labels: { nodes: [] } } };
+const context = {
+  repository: { owner: "o", repo: "r" },
+  entityNumber: 7,
+  isPR: false,
+  inputs: { branchPrefix: "claude/" },
+};`,
+      call: `await setupBranch(octokits, githubData, context);`,
+    },
+    {
+      name: "createPrompt",
+      // An undefined commentId makes commentId.toString() throw inside the try,
+      // which is all this case needs to reach the catch block.
+      imports: `import { createPrompt } from ${JSON.stringify(`${repoRoot}/src/create-prompt`)};`,
+      call: `await createPrompt(undefined, "main", "claude/issue-7", {}, {});`,
+    },
+    {
+      name: "prepareMcpConfig",
+      // A context with no inputs makes the useCommitSigning read throw inside the try.
+      imports: `import { prepareMcpConfig } from ${JSON.stringify(`${repoRoot}/src/mcp/install-mcp-server`)};`,
+      call: `await prepareMcpConfig({
+  githubToken: "t",
+  owner: "o",
+  repo: "r",
+  branch: "b",
+  baseBranch: "main",
+  allowedTools: [],
+  mode: "tag",
+  context: {},
+});`,
+    },
+  ];
+
+let scriptDir: string;
+
+beforeAll(() => {
+  scriptDir = mkdtempSync(join(tmpdir(), "prepare-error-propagation-"));
+});
+
+afterAll(() => {
+  rmSync(scriptDir, { recursive: true, force: true });
+});
+
+describe("prepare-path helpers reject instead of exiting the process", () => {
+  for (const { name, imports, setup, call } of CASES) {
+    test(`${name} lets its caller's finally run`, () => {
+      const scriptPath = join(scriptDir, `${name}.ts`);
+      writeFileSync(
+        scriptPath,
+        [
+          imports,
+          setup ?? "",
+          `try { ${call} } catch { console.log("CAUGHT"); } finally { console.log("FINALLY_RAN"); }`,
+          "",
+        ].join("\n"),
+      );
+
+      const result = Bun.spawnSync(["bun", "run", scriptPath], {
+        cwd: scriptDir,
+        stdout: "pipe",
+        stderr: "pipe",
+      });
+      const stdout = result.stdout.toString();
+
+      expect(stdout).toContain("CAUGHT");
+      expect(stdout).toContain("FINALLY_RAN");
+      expect(result.exitCode).toBe(0);
+    });
+  }
+});
