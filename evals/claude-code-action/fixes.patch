 import { realpath } from "fs/promises";
-import { resolve, sep } from "path";
+import { relative, resolve, sep } from "path";
+
+/**
+ * Resolves a caller-supplied path to a repository-relative path, rejecting
+ * anything that lands outside the repository root.
+ *
+ * Pure path arithmetic, no filesystem access: this is for building git tree
+ * entries, where the path may name a file that exists only in the remote tree
+ * and not in the local checkout. Use validatePathWithinRepo instead when the
+ * file has to be read from disk, which additionally resolves symlinks.
+ *
+ * @param filePath - Absolute, or relative to the repository root
+ * @param repoRoot - The repository root directory
+ * @returns The path relative to repoRoot, with `.` and `..` segments resolved
+ * @throws Error if the path resolves to, or outside of, the repository root
+ */
+export function resolveRepoRelativePath(
+  filePath: string,
+  repoRoot: string,
+): string {
+  const resolvedRoot = resolve(repoRoot);
+  const resolvedPath = resolve(resolvedRoot, filePath);
+
+  // startsWith(resolvedRoot) alone is not containment: a sibling directory
+  // whose name merely extends the root's (".../repo" and ".../repo-extra")
+  // passes it, and the path then gets rewritten into an unrelated in-repo path.
+  if (!resolvedPath.startsWith(resolvedRoot + sep)) {
+    throw new Error(`Path '${filePath}' resolves outside the repository root`);
+  }
+
+  return relative(resolvedRoot, resolvedPath);
+}
 
