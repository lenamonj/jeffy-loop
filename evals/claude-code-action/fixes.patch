diff --git a/src/mcp/github-actions.ts b/src/mcp/github-actions.ts
new file mode 100644
index 0000000..7fef9af
--- /dev/null
+++ b/src/mcp/github-actions.ts
@@ -0,0 +1,181 @@
+// The CI tool implementations (get_ci_status, get_workflow_run_details,
+// download_job_log), kept separate from the MCP server bootstrap in
+// github-actions-server.ts so they can be imported and driven directly.
+// Repository coordinates, the PR number, the token, the directory logs are
+// written to and the HTTP client all arrive as an explicit config rather than
+// through module-level environment reads.
+import { mkdir, writeFile } from "fs/promises";
+import { Octokit } from "@octokit/rest";
+import { GITHUB_API_URL } from "../github/api/config";
+import {
+  listWorkflowJobs,
+  listWorkflowRuns,
+} from "./github-actions-pagination";
+import { failed, ok, type ToolResult } from "./tool-result";
+
+export type ActionsConfig = {
+  owner: string;
+  repo: string;
+  prNumber: string;
+  githubToken: string;
+  /** Directory the job logs are written under; RUNNER_TEMP on a runner. */
+  runnerTemp: string;
+  /** Injectable for tests; defaults to the fetch Octokit would use. */
+  fetchFn?: typeof fetch;
+};
+
+function clientFor(config: ActionsConfig): Octokit {
+  return new Octokit({
+    auth: config.githubToken,
+    baseUrl: GITHUB_API_URL,
+    ...(config.fetchFn && { request: { fetch: config.fetchFn } }),
+  });
+}
+
+/** The workflow-run states the GitHub API accepts as a filter. */
+export const CI_STATUS_FILTERS = [
+  "completed",
+  "action_required",
+  "cancelled",
+  "failure",
+  "neutral",
+  "skipped",
+  "stale",
+  "success",
+  "timed_out",
+  "in_progress",
+  "queued",
+  "requested",
+  "waiting",
+  "pending",
+] as const;
+
+export type CiStatusArgs = {
+  status?: (typeof CI_STATUS_FILTERS)[number];
+};
+
+export async function getCiStatus(
+  { status }: CiStatusArgs,
+  config: ActionsConfig,
+): Promise<ToolResult> {
+  try {
+    const client = clientFor(config);
+
+    // Get the PR to find the head SHA
+    const { data: prData } = await client.pulls.get({
+      owner: config.owner,
+      repo: config.repo,
+      pull_number: parseInt(config.prNumber, 10),
+    });
+    const headSha = prData.head.sha;
+
+    const runs = await listWorkflowRuns(client, {
+      owner: config.owner,
+      repo: config.repo,
+      head_sha: headSha,
+      ...(status && { status }),
+    });
+
+    // Process runs to create summary
+    const summary = {
+      total_runs: runs.length,
+      failed: 0,
+      passed: 0,
+      pending: 0,
+    };
+
+    const processedRuns = runs.map((run: any) => {
+      // Update summary counts
+      if (run.status === "completed") {
+        if (run.conclusion === "success") {
+          summary.passed++;
+        } else if (run.conclusion === "failure") {
+          summary.failed++;
+        }
+      } else {
+        summary.pending++;
+      }
+
+      return {
+        id: run.id,
+        name: run.name,
+        status: run.status,
+        conclusion: run.conclusion,
+        html_url: run.html_url,
+        created_at: run.created_at,
+      };
+    });
+
+    return ok({ summary, runs: processedRuns });
+  } catch (error) {
+    return failed(error);
+  }
+}
+
+export async function getWorkflowRunDetails(
+  { run_id }: { run_id: number },
+  config: ActionsConfig,
+): Promise<ToolResult> {
+  try {
+    const client = clientFor(config);
+
+    // Get jobs for this workflow run
+    const jobs = await listWorkflowJobs(client, {
+      owner: config.owner,
+      repo: config.repo,
+      run_id,
+    });
+
+    const processedJobs = jobs.map((job: any) => {
+      // Extract failed steps
+      const failedSteps = (job.steps || [])
+        .filter((step: any) => step.conclusion === "failure")
+        .map((step: any) => ({
+          name: step.name,
+          number: step.number,
+        }));
+
+      return {
+        id: job.id,
+        name: job.name,
+        conclusion: job.conclusion,
+        html_url: job.html_url,
+        failed_steps: failedSteps,
+      };
+    });
+
+    return ok({ jobs: processedJobs });
+  } catch (error) {
+    return failed(error);
+  }
+}
+
+export async function downloadJobLog(
+  { job_id }: { job_id: number },
+  config: ActionsConfig,
+): Promise<ToolResult> {
+  try {
+    const client = clientFor(config);
+
+    const response = await client.actions.downloadJobLogsForWorkflowRun({
+      owner: config.owner,
+      repo: config.repo,
+      job_id,
+    });
+
+    const logsText = response.data as unknown as string;
+
+    const logsDir = `${config.runnerTemp}/github-ci-logs`;
+    await mkdir(logsDir, { recursive: true });
+
+    const logPath = `${logsDir}/job-${job_id}.log`;
+    await writeFile(logPath, logsText, "utf-8");
+
+    return ok({
+      path: logPath,
+      size_bytes: Buffer.byteLength(logsText, "utf-8"),
+    });
+  } catch (error) {
+    return failed(error);
+  }
+}
