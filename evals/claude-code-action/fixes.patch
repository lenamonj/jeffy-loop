+++ b/test/github-comment.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, test } from "bun:test";
+import {
+  updateClaudeCommentTool,
+  type CommentConfig,
+} from "../src/mcp/github-comment";
+
+// update_claude_comment is the tool the action uses to report progress back to
+// the user, and until the handler was split out of the server bootstrap
+// nothing could drive it: importing the server exited without its environment
+// and hung with it. The stub below records every request so the endpoint the
+// handler chooses and the body it sends can be asserted directly.
+
+type Recorded = { url: string; method: string; body: unknown };
+
+function stubGitHub(responses: { status: number; body: unknown }[]) {
+  const calls: Recorded[] = [];
+  const queue = [...responses];
+
+  const fetchFn = (async (
+    url: unknown,
+    init: { method?: string; body?: string },
+  ) => {
+    calls.push({
+      url: String(url),
+      method: init?.method ?? "GET",
+      body: init?.body ? JSON.parse(init.body) : undefined,
+    });
+
+    const next = queue.shift();
+    if (!next) {
+      throw new Error(`unstubbed request: ${init?.method} ${String(url)}`);
+    }
+    return new Response(JSON.stringify(next.body), {
+      status: next.status,
+      headers: { "content-type": "application/json" },
+    });
+  }) as unknown as typeof fetch;
+
+  return { fetchFn, calls };
+}
+
+const updated = {
+  status: 200,
+  body: {
+    id: 42,
+    html_url: "https://github.com/o/r/issues/1#issuecomment-42",
+    updated_at: "2026-08-14T00:00:00Z",
+  },
+};
+
+const baseConfig: CommentConfig = {
+  owner: "o",
+  repo: "r",
+  commentId: "42",
+  githubToken: "t",
+};
+
+const payloadOf = (result: { content: { text: string }[] }) =>
+  JSON.parse(result.content[0]!.text);
+
+describe("update_claude_comment handler", () => {
+  test("updates an issue comment and returns the API result", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    const result = await updateClaudeCommentTool(
+      { body: "working on it" },
+      { ...baseConfig, fetchFn },
+    );
+
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.method).toBe("PATCH");
+    expect(calls[0]!.url).toContain("/repos/o/r/issues/comments/42");
+    expect(calls[0]!.body).toEqual({ body: "working on it" });
+    expect(result.isError).toBeUndefined();
+    expect(payloadOf(result)).toEqual({
+      id: 42,
+      html_url: "https://github.com/o/r/issues/1#issuecomment-42",
+      updated_at: "2026-08-14T00:00:00Z",
+    });
+  });
+
+  test("uses the review-comment endpoint for pull_request_review_comment", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    await updateClaudeCommentTool(
+      { body: "b" },
+      {
+        ...baseConfig,
+        eventName: "pull_request_review_comment",
+        fetchFn,
+      },
+    );
+
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.url).toContain("/repos/o/r/pulls/comments/42");
+    expect(calls[0]!.url).not.toContain("/issues/");
+  });
+
+  test("any other event name keeps the issue-comment endpoint", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    await updateClaudeCommentTool(
+      { body: "b" },
+      { ...baseConfig, eventName: "issue_comment", fetchFn },
+    );
+
+    expect(calls[0]!.url).toContain("/repos/o/r/issues/comments/42");
+  });
+
+  test("falls back to the issue endpoint when the review comment is gone", async () => {
+    const { fetchFn, calls } = stubGitHub([
+      { status: 404, body: { message: "Not Found" } },
+      updated,
+    ]);
+
+    const result = await updateClaudeCommentTool(
+      { body: "b" },
+      {
+        ...baseConfig,
+        eventName: "pull_request_review_comment",
+        fetchFn,
+      },
+    );
+
+    expect(calls).toHaveLength(2);
+    expect(calls[0]!.url).toContain("/repos/o/r/pulls/comments/42");
+    expect(calls[1]!.url).toContain("/repos/o/r/issues/comments/42");
+    expect(result.isError).toBeUndefined();
+    expect(payloadOf(result).id).toBe(42);
+  });
+
+  test("sanitizes the body before sending it", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    await updateClaudeCommentTool(
+      { body: "![hidden instructions](https://example.com/x.png)" },
+      { ...baseConfig, fetchFn },
+    );
+
+    expect(calls[0]!.body).toEqual({
+      body: "![](https://example.com/x.png)",
+    });
+  });
+
+  test("reads the comment id as a number", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    await updateClaudeCommentTool(
+      { body: "b" },
+      { ...baseConfig, commentId: "007", fetchFn },
+    );
+
+    expect(calls[0]!.url).toContain("/issues/comments/7");
+  });
+
+  test("returns an error result without a token, issuing no request", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    const result = await updateClaudeCommentTool(
+      { body: "b" },
+      { ...baseConfig, githubToken: undefined, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(result.isError).toBe(true);
+    expect(result.error).toBe("GITHUB_TOKEN environment variable is required");
+    expect(result.content[0]!.text).toBe(
+      "Error: GITHUB_TOKEN environment variable is required",
+    );
+  });
+
+  test("returns an error result without a comment id, issuing no request", async () => {
+    const { fetchFn, calls } = stubGitHub([updated]);
+
+    const result = await updateClaudeCommentTool(
+      { body: "b" },
+      { ...baseConfig, commentId: undefined, fetchFn },
+    );
+
+    expect(calls).toHaveLength(0);
+    expect(result.isError).toBe(true);
+    expect(result.error).toBe(
+      "CLAUDE_COMMENT_ID environment variable is required",
+    );
+  });
+
+  test("returns an API failure as an error result rather than throwing", async () => {
+    const { fetchFn } = stubGitHub([
+      { status: 500, body: { message: "Internal Server Error" } },
+    ]);
+
+    const result = await updateClaudeCommentTool(
+      { body: "b" },
+      { ...baseConfig, fetchFn },
+    );
+
+    expect(result.isError).toBe(true);
+    expect(result.error).toContain("Internal Server Error");
+  });
+});
