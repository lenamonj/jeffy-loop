new file mode 100644
index 0000000..ab0ccf0
--- /dev/null
+++ b/src/entrypoints/replay-buffered-comments.ts
@@ -0,0 +1,290 @@
+/**
+ * The post-session replay of buffered inline comments, kept separate from the
+ * entrypoint in post-buffered-inline-comments.ts so it can be imported and
+ * driven directly. The buffer path, the repository coordinates, the tokens and
+ * the HTTP client all arrive as an explicit config rather than through
+ * module-level environment reads.
+ *
+ * Comments are buffered by the inline comment MCP tool when they are issued
+ * without confirmed=true. Here each is classified as real review feedback or a
+ * test/probe call, and only the real ones are posted. Calls with
+ * confirmed=false are never posted. If the Anthropic API is unavailable
+ * (Bedrock/Vertex users without a direct key), classification is skipped and
+ * everything with confirmed !== false posts, which is the behaviour that
+ * predates classification.
+ */
+import { readFileSync } from "fs";
+import { Octokit } from "@octokit/rest";
+import { GITHUB_API_URL } from "../github/api/config";
+
+export type BufferedComment = {
+  ts: string;
+  path: string;
+  line?: number;
+  startLine?: number;
+  side?: "LEFT" | "RIGHT";
+  commit_id?: string;
+  body: string;
+  confirmed?: boolean;
+};
+
+export type ReplayConfig = {
+  bufferPath: string;
+  githubToken?: string;
+  owner?: string;
+  repo?: string;
+  prNumber?: string;
+  /** Absent means classification is skipped and every candidate posts. */
+  anthropicApiKey?: string;
+  /** Injectable for tests; defaults to the fetch the clients would use. */
+  fetchFn?: typeof fetch;
+};
+
+export type ReplayResult = {
+  reason: "no-buffer" | "incomplete-config" | "nothing-to-post" | "posted";
+  buffered: number;
+  neverPost: number;
+  filtered: number;
+  posted: number;
+};
+
+const CLASSIFICATION_PROMPT = `You are classifying PR inline comments as either REAL code review feedback or TEST/PROBE calls.
+
+A TEST/PROBE call is when an automated agent is checking whether a commenting tool works. These typically:
+- Start with phrases like "Test comment", "Testing if", "Can I", "Does this work", "Checking if"
+- Have generic/placeholder content not specific to any code
+- Exist to verify tool functionality, not to provide review feedback
+
+A REAL review comment:
+- Discusses specific code, logic, bugs, or style
+- Provides actionable feedback for the PR author
+- References concrete aspects of the change
+
+For each numbered comment body below, respond with ONLY a JSON array of booleans where true = REAL review comment, false = test/probe. No other text.
+
+Comments:
+`;
+
+/**
+ * Reads the buffer file. A missing file is an empty buffer; a malformed line
+ * is an error, because a partially readable buffer would post a partial set.
+ */
+export function readBufferedComments(bufferPath: string): BufferedComment[] {
+  let raw: string;
+  try {
+    raw = readFileSync(bufferPath, "utf8");
+  } catch {
+    return [];
+  }
+  return raw
+    .split("\n")
+    .filter(Boolean)
+    .map((line) => JSON.parse(line));
+}
+
+/**
+ * Classifies each body as real review feedback (true) or a test/probe (false).
+ * Returns null when classification could not be performed at all, which the
+ * caller reads as "post every candidate".
+ */
+export async function classifyComments(
+  bodies: string[],
+  config: Pick<ReplayConfig, "anthropicApiKey" | "fetchFn">,
+): Promise<boolean[] | null> {
+  const apiKey = config.anthropicApiKey;
+  if (!apiKey) {
+    console.log(
+      "ANTHROPIC_API_KEY not set — skipping classification, posting all unconfirmed comments",
+    );
+    return null;
+  }
+
+  const prompt =
+    CLASSIFICATION_PROMPT +
+    bodies.map((b, i) => `${i + 1}. ${JSON.stringify(b)}`).join("\n");
+
+  try {
+    const doFetch = config.fetchFn ?? fetch;
+    const res = await doFetch("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        "x-api-key": apiKey,
+        "anthropic-version": "2023-06-01",
+      },
+      body: JSON.stringify({
+        model: "claude-haiku-4-5",
+        max_tokens: 1024,
+        messages: [{ role: "user", content: prompt }],
+      }),
+    });
+
+    if (!res.ok) {
+      console.log(
+        `Classification API returned ${res.status} — posting all unconfirmed comments`,
+      );
+      return null;
+    }
+
+    const data = (await res.json()) as {
+      content: { type: string; text: string }[];
+    };
+    const text = data.content.find((c) => c.type === "text")?.text ?? "";
+    const match = text.match(/\[[\s\S]*\]/);
+    if (!match) {
+      console.log(
+        "Could not parse classification response — posting all unconfirmed comments",
+      );
+      return null;
+    }
+    const parsed = JSON.parse(match[0]);
+    if (
+      !Array.isArray(parsed) ||
+      parsed.length !== bodies.length ||
+      !parsed.every((v) => typeof v === "boolean")
+    ) {
+      console.log(
+        "Classification response shape mismatch — posting all unconfirmed comments",
+      );
+      return null;
+    }
+    return parsed;
+  } catch (e) {
+    console.log(
+      `Classification failed (${e instanceof Error ? e.message : String(e)}) — posting all unconfirmed comments`,
+    );
+    return null;
+  }
+}
+
+async function postComment(
+  octokit: Octokit,
+  owner: string,
+  repo: string,
+  pull_number: number,
+  headSha: string,
+  c: BufferedComment,
+): Promise<boolean> {
+  const params: Parameters<typeof octokit.pulls.createReviewComment>[0] = {
+    owner,
+    repo,
+    pull_number,
+    body: c.body,
+    path: c.path,
+    side: c.side || "RIGHT",
+    commit_id: c.commit_id || headSha,
+  };
+  if (c.startLine) {
+    params.start_line = c.startLine;
+    params.start_side = c.side || "RIGHT";
+    params.line = c.line;
+  } else {
+    params.line = c.line;
+  }
+  try {
+    await octokit.pulls.createReviewComment(params);
+    return true;
+  } catch (e) {
+    console.log(
+      `  failed ${c.path}:${c.line}: ${e instanceof Error ? e.message : String(e)}`,
+    );
+    return false;
+  }
+}
+
+export async function replayBufferedComments(
+  config: ReplayConfig,
+): Promise<ReplayResult> {
+  const empty = { buffered: 0, neverPost: 0, filtered: 0, posted: 0 };
+  const comments = readBufferedComments(config.bufferPath);
+
+  if (comments.length === 0) {
+    console.log("No buffered inline comments");
+    return { reason: "no-buffer", ...empty };
+  }
+
+  console.log(`Found ${comments.length} buffered inline comment(s)`);
+
+  const { githubToken, owner, repo, prNumber } = config;
+  if (!githubToken || !owner || !repo || !prNumber) {
+    console.log(
+      "::warning::Missing GITHUB_TOKEN/REPO_OWNER/REPO_NAME/PR_NUMBER — cannot post buffered comments",
+    );
+    return { reason: "incomplete-config", ...empty, buffered: comments.length };
+  }
+
+  // Partition: confirmed=false are never posted; the rest are candidates
+  const neverPost = comments.filter((c) => c.confirmed === false);
+  const candidates = comments.filter((c) => c.confirmed !== false);
+
+  if (neverPost.length > 0) {
+    console.log(`  ${neverPost.length} with confirmed=false — not posting`);
+  }
+
+  if (candidates.length === 0) {
+    return {
+      reason: "nothing-to-post",
+      ...empty,
+      buffered: comments.length,
+      neverPost: neverPost.length,
+    };
+  }
+
+  const verdicts = await classifyComments(
+    candidates.map((c) => c.body),
+    config,
+  );
+  const toPost =
+    verdicts === null
+      ? candidates
+      : candidates.filter((_, i) => verdicts[i] === true);
+  const filtered =
+    verdicts === null ? [] : candidates.filter((_, i) => verdicts[i] === false);
+
+  if (filtered.length > 0) {
+    console.log(
+      `::warning::${filtered.length} buffered comment(s) classified as test/probe — NOT posted:`,
+    );
+    for (const c of filtered) {
+      console.log(`  [${c.path}:${c.line}] ${c.body.slice(0, 120)}`);
+    }
+  }
+
+  if (toPost.length === 0) {
+    console.log("No real comments to post");
+    return {
+      reason: "nothing-to-post",
+      ...empty,
+      buffered: comments.length,
+      neverPost: neverPost.length,
+      filtered: filtered.length,
+    };
+  }
+
+  const octokit = new Octokit({
+    auth: githubToken,
+    baseUrl: GITHUB_API_URL,
+    ...(config.fetchFn && { request: { fetch: config.fetchFn } }),
+  });
+  const pull_number = parseInt(prNumber, 10);
+  const pr = await octokit.pulls.get({ owner, repo, pull_number });
+  const headSha = pr.data.head.sha;
+
+  console.log(`Posting ${toPost.length} classified-as-real comment(s)`);
+  let posted = 0;
+  for (const c of toPost) {
+    if (await postComment(octokit, owner, repo, pull_number, headSha, c)) {
+      console.log(`  posted ${c.path}:${c.line}`);
+      posted++;
+    }
+  }
+  console.log(`Posted ${posted}/${toPost.length}`);
+
+  return {
+    reason: "posted",
+    buffered: comments.length,
+    neverPost: neverPost.length,
+    filtered: filtered.length,
+    posted,
+  };
+}
