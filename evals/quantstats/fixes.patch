+    @pytest.mark.parametrize("name", ENTRY_POINTS)
+    def test_periods_moves_the_result_when_rf_is_non_zero(self, name, long_returns):
+        """The argument is only legitimate because it scales rf. If it stopped
+        doing that it would be inert again, which is what QS-25 removed."""
+        fn = getattr(qs.stats, name)
