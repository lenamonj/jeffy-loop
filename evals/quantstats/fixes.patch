+def _as_single_series(returns, title=None):
+    """
+    Reduce a returns object to the one series a single-series plot can draw.
+
+    Several plots here document DataFrame input while the core routine they call
+    takes one series: a box plot of return quantiles, a drawdown ranking and an
+    equity curve each describe a single strategy. This is the one place that
+    reconciles the two. A Series passes through untouched. A one-column frame is
+    unwrapped, because it already describes one strategy and must behave exactly
+    like the equivalent Series. A frame holding several strategies is reduced to
+    its equal-weighted mean, and the title records the aggregation so the chart
+    is not read as one strategy.
+
+    Parameters
+    ----------
+    returns : pandas.Series or pandas.DataFrame
+        Returns data as supplied by the caller
+    title : str or None, optional
+        Caller-supplied plot title, annotated only when strategies are merged
+
+    Returns
+    -------
+    tuple
+        (pandas.Series to plot, title to use)
+    """
+    if not isinstance(returns, _pd.DataFrame):
+        return returns, title
+    if len(returns.columns) == 1:
+        return returns[returns.columns[0]], title
+    merged = returns.mean(axis=1)
+    return merged, (
+        f"{title} (daily equal-weighted*)" if title else "Daily equal-weighted*"
+    )
