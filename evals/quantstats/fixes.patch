+def _canonical(value):
+    """Comparable numeric form for the result shapes these entry points return:
+    float, Series, DataFrame, dict, or MonteCarloResult."""
+    if isinstance(value, (pd.Series, pd.DataFrame)):
+        return np.asarray(value, dtype=float).ravel()
+    if isinstance(value, dict):
+        return np.array([float(value[k]) for k in sorted(value)])
+    if hasattr(value, "stats"):
+        return _canonical(value.stats)
+    return np.array([float(value)])
