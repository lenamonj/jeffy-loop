+    def test_no_call_site_resamples_on_a_caller_supplied_frequency(self):
+        """Class enumeration: every .resample in the package must be the shim
+        itself or a hardcoded modern alias, or the next function taking a
+        frequency from the caller reopens this defect."""
+        literal_ok = {"W-MON", "ME", "QE", "YE", "D", "W"}
+        root = Path(qs.__file__).parent
