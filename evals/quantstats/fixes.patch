+class TestTimezoneAwareInput:
+    """QS-8: returns and benchmark that both carry a timezone must report, and
+    report the same numbers as the equivalent naive data."""
+
+    @pytest.fixture
+    def aware(self):
+        idx = pd.date_range("2020-01-01", periods=400, freq="B", tz="US/Eastern")
+        rng = np.random.default_rng(41)
+        return (
+            pd.Series(rng.normal(0.0005, 0.012, len(idx)), index=idx, name="Strategy"),
+            pd.Series(rng.normal(0.0004, 0.010, len(idx)), index=idx, name="Benchmark"),
+        )
+
+    @staticmethod
+    def _naive(series):
+        # the zone is dropped, the local timestamp kept, so the trading date holds
+        return series.tz_localize(None)
+
+    def test_metrics_accepts_a_tz_aware_benchmark(self, aware):
+        returns, benchmark = aware
+        out = qs.reports.metrics(returns, benchmark, display=False)
+        assert out.shape[1] == 2
+
+    def test_metrics_matches_the_naive_equivalent(self, aware):
+        returns, benchmark = aware
+        from_aware = qs.reports.metrics(returns, benchmark, display=False)
+        from_naive = qs.reports.metrics(
+            self._naive(returns), self._naive(benchmark), display=False
+        )
+        pd.testing.assert_frame_equal(from_aware, from_naive)
+
+    def test_benchmark_column_holds_real_numbers(self, aware):
+        """A fix that stops the crash but misaligns the indexes would leave the
+        benchmark column filled with the "-" placeholder."""
+        returns, benchmark = aware
+        out = qs.reports.metrics(returns, benchmark, display=False)
+        benchmark_column = out.iloc[:, 0]
+        placeholders = (benchmark_column.astype(str) == "-").sum()
+        assert placeholders < len(benchmark_column) / 2
+
+    def test_html_accepts_tz_aware_inputs(self, aware, tmp_path):
+        returns, benchmark = aware
+        output = tmp_path / "tz.html"
+        qs.reports.html(returns, benchmark, output=str(output))
+        assert output.exists()
