+
+    @pytest.mark.parametrize("name", ENTRY_POINTS)
+    def test_all_entry_points_agree_on_one_observation(self, name):
+        """The defect was disagreement between siblings on identical input."""
+        reference = qs.stats.probabilistic_sharpe_ratio(self._series(1))
+        got = getattr(qs.stats, name)(self._series(1))
+        assert np.isnan(got) and np.isnan(reference)
