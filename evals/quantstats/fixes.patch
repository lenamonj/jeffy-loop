+        assert "2019" not in [str(year) for year in qs.stats.monthly_returns(aware).index]
+
+    @pytest.mark.parametrize("zone", ["Asia/Tokyo", "US/Eastern"])
+    def test_aggregate_returns_matches_too(self, zone):
