+class TestRiskFreeRateIsHonoured:
+    """QS-18: utils._prepare_returns read its caller's frame name and skipped the
+    excess-return conversion for cagr and gain_to_pain_ratio, so both documented
+    an rf parameter and ignored it, while reports passed rf straight into them.
+    Removing them from that list also required forwarding the period count,
+    because _prepare_returns only deannualizes rf when it is given one."""
+
+    @pytest.fixture
+    def long_returns(self):
+        idx = pd.date_range("2021-01-01", periods=756, freq="B")
+        vals = np.random.default_rng(2026).normal(0.0006, 0.011, 756)
+        return pd.Series(vals, index=idx, name="Strategy")
+
+    @staticmethod
+    def _excess(returns, rf, periods=252):
+        """rf deannualized the way to_excess_returns does it."""
+        return returns - ((1 + rf) ** (1.0 / periods) - 1.0)
+
+    @pytest.mark.parametrize("rf", [0.02, 0.05])
+    def test_cagr_honours_rf(self, long_returns, rf):
+        base = qs.stats.cagr(long_returns)
+        with_rf = qs.stats.cagr(long_returns, rf=rf)
+        assert with_rf != base
+        assert with_rf < base
+        # known answer: identical to running cagr on the deannualized excess series
+        assert np.isclose(with_rf, qs.stats.cagr(self._excess(long_returns, rf)), rtol=1e-12)
+
+    @pytest.mark.parametrize("rf", [0.02, 0.05])
+    def test_gain_to_pain_ratio_honours_rf(self, long_returns, rf):
+        base = qs.stats.gain_to_pain_ratio(long_returns)
+        with_rf = qs.stats.gain_to_pain_ratio(long_returns, rf=rf)
+        assert with_rf != base
+        assert np.isclose(
+            with_rf, qs.stats.gain_to_pain_ratio(self._excess(long_returns, rf)), rtol=1e-12
+        )
+
+    def test_rf_is_deannualized_not_deducted_whole(self, long_returns):
+        """The failure mode when the skip list was removed without forwarding
+        periods: the whole annual rate came off every observation and cagr
+        collapsed to -1."""
+        assert qs.stats.cagr(long_returns, rf=0.05) > 0.15
+        assert qs.stats.gain_to_pain_ratio(long_returns, rf=0.05) > 0.15
+
+    def test_gain_to_pain_ratio_periods_parameter_moves_the_result(self, long_returns):
+        daily = qs.stats.gain_to_pain_ratio(long_returns, rf=0.05, periods=252)
+        weekly = qs.stats.gain_to_pain_ratio(long_returns, rf=0.05, periods=52)
+        assert daily != weekly
+
+    def test_default_rf_path_is_unchanged(self, long_returns):
+        """rf=0 must not move: the excess branch is gated on rf > 0."""
+        v = long_returns.to_numpy()
+        years = len(v) / 252
+        assert np.isclose(qs.stats.cagr(long_returns),
+                          (np.prod(1 + v)) ** (1 / years) - 1, rtol=1e-9)
+        assert np.isclose(qs.stats.gain_to_pain_ratio(long_returns),
+                          v.sum() / abs(v[v < 0].sum()), rtol=1e-9)
+
+    def test_rolling_volatility_does_not_feed_its_window_to_rf(self, long_returns):
+        """rolling_volatility passed rolling_period into the rf slot; it was
