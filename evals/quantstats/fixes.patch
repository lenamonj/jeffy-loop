+"""
+Regression tests for defects found by audit.
+
+Each test pins one reported bug and is written to fail against the unfixed code.
+"""
+
+import matplotlib
+
+matplotlib.use("Agg")
+
+import matplotlib.pyplot as plt
+
+import ast
+import contextlib
+import inspect
+import io
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+import quantstats as qs
+from quantstats import utils
+
+
+@pytest.fixture
+def returns():
+    """Daily returns with a seed unique to this module, so no other test primes
+    any value-keyed state with the same data."""
+    idx = pd.date_range("2021-03-01", periods=400, freq="B")
+    values = np.random.default_rng(20260728).normal(0.0006, 0.011, len(idx))
+    return pd.Series(values, index=idx, name="Strategy")
+
+
+@pytest.fixture
+def benchmark():
+    idx = pd.date_range("2021-03-01", periods=400, freq="B")
+    values = np.random.default_rng(20260729).normal(0.0004, 0.009, len(idx))
+    return pd.Series(values, index=idx, name="Benchmark")
+
+
+class TestPrepareReturnsContainerType:
+    """QS-1: _prepare_returns must return the container type it was given.
+
+    A Series and a one-column DataFrame holding identical values produce the same
+    pandas value hash, so any value-keyed reuse must still distinguish them.
+    """
+
+    def test_series_and_single_column_frame_keep_their_own_type(self, returns):
+        prepared_frame = utils._prepare_returns(returns.to_frame())
+        prepared_series = utils._prepare_returns(returns)
+        assert isinstance(prepared_frame, pd.DataFrame)
+        assert isinstance(prepared_series, pd.Series)
+
+    def test_series_and_single_column_frame_hold_the_same_values(self, returns):
+        prepared_frame = utils._prepare_returns(returns.to_frame())
+        prepared_series = utils._prepare_returns(returns)
+        pd.testing.assert_series_equal(
+            prepared_frame[returns.name], prepared_series, check_names=False
+        )
+
+    def test_repeated_calls_agree(self, returns):
+        pd.testing.assert_series_equal(
+            utils._prepare_returns(returns), utils._prepare_returns(returns)
+        )
+
+
+class TestSingleColumnDataFrame:
+    """QS-2: a one-column DataFrame is a documented input shape and must behave
+    like the equivalent Series."""
+
+    def test_metrics_accepts_a_single_column_frame(self, returns):
+        out = qs.reports.metrics(returns.to_frame(), display=False)
+        assert isinstance(out, pd.DataFrame)
+        assert out.shape[1] == 1
+
+    def test_metrics_matches_the_equivalent_series(self, returns):
+        from_frame = qs.reports.metrics(returns.to_frame(), display=False)
+        from_series = qs.reports.metrics(returns, display=False)
+        pd.testing.assert_frame_equal(
+            from_frame, from_series, check_names=False, check_like=False
+        )
+
+    def test_metrics_accepts_a_single_column_frame_with_benchmark(
+        self, returns, benchmark
+    ):
+        out = qs.reports.metrics(returns.to_frame(), benchmark, display=False)
+        assert out.shape[1] == 2
+
+    @pytest.mark.parametrize(
+        "entry_point",
+        ["metrics", "basic", "plots", "html", "snapshot"],
+    )
+    def test_every_entry_point_accepts_a_single_column_frame(
+        self, returns, benchmark, tmp_path, entry_point
+    ):
+        """Class check for QS-2: the one-column DataFrame shape reached each of
+        these entry points through a different code path, and each had its own
+        way of failing."""
+        one = returns.to_frame()
+        if entry_point == "metrics":
+            qs.reports.metrics(one, benchmark, display=False)
+        elif entry_point == "basic":
+            qs.reports.basic(one, benchmark, display=False)
+        elif entry_point == "plots":
+            qs.reports.plots(one, show=False)
+        elif entry_point == "html":
+            qs.reports.html(one, output=str(tmp_path / "report.html"))
+        elif entry_point == "snapshot":
+            qs.plots.snapshot(one, show=False)
+
+
+def _fingerprint(obj):
+    """Everything about a pandas object a caller would notice being changed."""
+    return (
+        obj.values.tobytes(),
+        str(getattr(obj.index, "tz", None)),
+        # Rendered, not raw bytes: a string index is backed by a StringArray,
+        # which has no tobytes, and NaT compares unequal to itself while its
+        # rendering does not. Carries the dtype so a converted index is caught.
+        str(obj.index.dtype),
+        tuple(obj.index.astype(str)),
+        str(getattr(obj, "name", None)),
+        tuple(obj.columns) if isinstance(obj, pd.DataFrame) else None,
+    )
+
+
+class TestCallerDataIsNotMutated:
+    """QS-4: reading a report or drawing a plot must leave the caller's own
+    objects untouched. Both known offenders wrote through to the argument: one
+    stripped the timezone from the index, the other renamed the series."""
+
+    @pytest.fixture
+    def tz_returns(self):
+        idx = pd.date_range("2020-01-01", periods=300, freq="B", tz="America/New_York")
+        values = np.random.default_rng(31).normal(0.0005, 0.012, len(idx))
+        return pd.Series(values, index=idx, name="MyStrategy")
+
+    def test_metrics_without_date_matching_leaves_the_index_alone(self, tz_returns):
+        before = _fingerprint(tz_returns)
+        qs.reports.metrics(tz_returns, match_dates=False, display=False)
+        assert _fingerprint(tz_returns) == before
+
+    def test_snapshot_leaves_the_series_name_alone(self, returns):
+        # a name snapshot() would not have chosen itself, so the check can fail
+        series = returns.rename("MyStrategy")
+        before = _fingerprint(series)
+        fig = qs.plots.snapshot(series, show=False)
+        plt.close(fig)
+        assert _fingerprint(series) == before
+
+    @pytest.mark.parametrize(
+        "call",
+        [
+            "metrics",
+            "metrics_match_dates_off",
+            "plots",
+            "snapshot",
+            "monthly_returns",
+            "make_portfolio",
+        ],
+    )
+    def test_entry_points_leave_their_arguments_alone(self, returns, call):
+        """Class check: every one of these takes the caller's object and must
+        treat it as read-only."""
+        returns = returns.rename("MyStrategy")
+        before = _fingerprint(returns)
+        if call == "metrics":
+            qs.reports.metrics(returns, display=False)
+        elif call == "metrics_match_dates_off":
+            qs.reports.metrics(returns, match_dates=False, display=False)
+        elif call == "plots":
+            qs.reports.plots(returns, show=False)
+        elif call == "snapshot":
+            qs.plots.snapshot(returns, show=False)
+        elif call == "monthly_returns":
+            qs.stats.monthly_returns(returns)
+        elif call == "make_portfolio":
+            qs.utils.make_portfolio(returns, 1e5)
+        plt.close("all")
+        assert _fingerprint(returns) == before
+
