+class TestAnnualisedRiskFreeRateIsDeannualised:
+    """QS-22: _prepare_returns hands rf to to_excess_returns, which leaves it
+    annualized when nperiods is None, so a caller that omitted it deducted a
+    whole year of risk-free return from every observation. rar and to_returns
+    omitted it; rolling_sharpe and rolling_sortino passed the rolling window
+    instead of the periods-per-year, making the deduction depend on the window."""
+
+    @pytest.fixture
+    def long_returns(self):
+        idx = pd.date_range("2021-01-01", periods=756, freq="B")
+        vals = np.random.default_rng(2026).normal(0.0006, 0.011, 756)
+        return pd.Series(vals, index=idx, name="Strategy")
+
+    @staticmethod
+    def _daily_rf(rf, periods=252):
+        return (1 + rf) ** (1.0 / periods) - 1.0
+
+    @pytest.mark.parametrize("rf", [0.01, 0.05])
+    def test_rar_stays_in_a_sane_band(self, long_returns, rf):
+        """It returned -0.899874 at rf=1 percent and exactly -1.0 at 5 percent."""
+        base = qs.stats.rar(long_returns)
+        got = qs.stats.rar(long_returns, rf=rf)
+        assert got < base
+        assert got > base - 2 * rf
+        excess = long_returns - self._daily_rf(rf)
+        assert np.isclose(got, qs.stats.cagr(excess) / qs.stats.exposure(excess), rtol=1e-9)
+
+    def test_to_returns_deducts_a_deannualised_rate(self, long_returns):
+        prices = (1 + long_returns).cumprod() * 100
+        plain = qs.utils.to_returns(prices)
+        with_rf = qs.utils.to_returns(prices, rf=0.05)
+        shift = float((plain - with_rf).dropna().mean())
+        assert np.isclose(shift, self._daily_rf(0.05), rtol=1e-9)
+
+    @pytest.mark.parametrize("rolling_period", [30, 60, 126, 252])
+    def test_rolling_ratios_deduct_rf_independently_of_the_window(
+        self, long_returns, rolling_period
+    ):
+        """The tell for the old defect: the rf deduction scaled with the window,
+        so a 30-day window removed eight times what a 252-day window removed."""
+        excess = long_returns - self._daily_rf(0.05)
+        for fn in (qs.stats.rolling_sharpe, qs.stats.rolling_sortino):
+            got = fn(long_returns, rf=0.05, rolling_period=rolling_period).dropna()
+            ref = fn(excess, rf=0.0, rolling_period=rolling_period).dropna()
+            assert np.allclose(got.to_numpy(), ref.to_numpy(), equal_nan=True)
+
+    @pytest.mark.parametrize(
+        "name", ["sharpe", "sortino", "omega", "cagr", "gain_to_pain_ratio", "rar"]
+    )
+    def test_every_rf_taking_function_moves_sanely(self, long_returns, name):
+        """Class check: rf must lower the figure without collapsing it."""
+        fn = getattr(qs.stats, name)
+        base = float(fn(long_returns))
+        got = float(fn(long_returns, rf=0.05))
+        assert np.isfinite(got)
+        assert got < base
+        assert got > base - 2.0
+
+    def test_rf_zero_is_untouched_by_the_fallback(self, long_returns):
+        """The fallback is gated on rf > 0, so nothing moves at the default."""
+        prices = (1 + long_returns).cumprod() * 100
+        assert qs.stats.rar(long_returns, rf=0.0) == qs.stats.rar(long_returns)
+        pd.testing.assert_series_equal(
+            qs.utils.to_returns(prices, rf=0.0), qs.utils.to_returns(prices)
+        )
+
+    def test_no_call_site_hands_rf_a_window_instead_of_a_year(self):
+        """Enumeration: every _prepare_returns call that passes rf passes either
+        a periods-per-year name or nothing, never a rolling window."""
+        import ast
+        import quantstats.stats as stats_mod
+        import quantstats.utils as utils_mod
+
+        offenders = []
+        for mod in (stats_mod, utils_mod):
+            with open(mod.__file__, encoding="utf-8") as fh:
+                tree = ast.parse(fh.read())
+            for node in ast.walk(tree):
+                if not isinstance(node, ast.Call):
+                    continue
+                fname = getattr(node.func, "attr", getattr(node.func, "id", ""))
+                if fname != "_prepare_returns" or len(node.args) < 3:
+                    continue
+                third = node.args[2]
+                if isinstance(third, ast.Name) and "rolling" in third.id:
+                    offenders.append(f"{mod.__name__}:{node.lineno} passes {third.id}")
+        assert not offenders, offenders
+
