+class TestPlotsNamespaceIsOnlyPlots:
+    """QS-17: quantstats/plots.py re-exports _plotting.wrappers with "import *",
+    the package's only star re-export, so before __all__ existed every bare
+    import in that module - typing.Any, TYPE_CHECKING, warnings,
+    _compat.safe_resample, the __future__ annotations flag and the local Returns
+    alias - arrived as public plotting API."""
+
+    @staticmethod
+    def _wrappers_source():
+        from quantstats._plotting import wrappers
+
+        with open(wrappers.__file__, encoding="utf-8") as fh:
+            return wrappers, fh.read()
+
+    def test_public_namespace_is_exactly_the_plot_entry_points(self):
+        import ast
+
+        wrappers, source = self._wrappers_source()
+        defined = {
+            node.name
+            for node in ast.parse(source).body
+            if isinstance(node, ast.FunctionDef) and not node.name.startswith("_")
+        }
+        public = {name for name in dir(qs.plots) if not name.startswith("_")}
+        assert public == defined
+        # __all__ tracks the file, so a new wrapper that forgets it fails here.
+        assert set(wrappers.__all__) == defined
+
+    def test_no_name_bound_by_an_import_line_is_public(self):
+        """The enumeration named in the finding: every name the import lines of
+        wrappers.py and plots.py bind, none of which may reach the namespace."""
+        import ast
+
+        _, source = self._wrappers_source()
+        sources = [source]
+        with open(qs.plots.__file__, encoding="utf-8") as fh:
+            sources.append(fh.read())
+
+        bound = set()
+        for src in sources:
+            for node in ast.walk(ast.parse(src)):
+                if isinstance(node, (ast.Import, ast.ImportFrom)):
+                    for alias in node.names:
+                        if alias.name != "*":
+                            bound.add(alias.asname or alias.name.split(".")[0])
+
+        public = {name for name in dir(qs.plots) if not name.startswith("_")}
+        assert bound, "enumeration found no import lines, so it proves nothing"
+        assert bound & public == set()
