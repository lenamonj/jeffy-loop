+        )
+
+    @pytest.mark.parametrize("zone", ["Asia/Tokyo", "Europe/London", "US/Eastern"])
+    def test_reports_match_the_wall_clock_naive_equivalent(self, zone):
+        aware, naive = self._pair(zone)
+        pd.testing.assert_frame_equal(
+            qs.reports.metrics(aware, display=False),
+            qs.reports.metrics(naive, display=False),
+        )
+
+    @pytest.mark.parametrize("zone", ["Asia/Tokyo", "Europe/London"])
+    def test_no_year_appears_before_the_data_starts(self, zone):
+        """A series whose first bar is 2020-01-01 in its own market must not
+        report a 2019 row; UTC conversion moved eastern bars back a day."""
