+    def test_value_matches_the_probabilistic_sharpe_definition(self, long_returns):
+        """Known answer for the rf=0 path: the statistic is the normal CDF of
+        the per-observation ratio over its standard error. kurt is the pandas
+        excess kurtosis, so the adjustment term is kurt/4; it read (kurt-3)/4
+        here until QS-28 corrected the double subtraction in the package."""
+        from scipy.stats import norm
+
+        sr = qs.stats.sharpe(long_returns, annualize=False)
+        skew = qs.stats.skew(long_returns, prepare_returns=False)
+        kurt = qs.stats.kurtosis(long_returns, prepare_returns=False)
+        n = len(long_returns)
+        sigma = np.sqrt(
+            (1 + (0.5 * sr**2) - (skew * sr) + ((kurt / 4) * sr**2)) / (n - 1)
+        )
+        expected = norm.cdf(sr / sigma)
+        assert np.isclose(
+            qs.stats.probabilistic_sharpe_ratio(long_returns), expected, rtol=1e-12
+        )
