+    ENTRY_POINTS = [
+        "probabilistic_ratio",
+        "probabilistic_sharpe_ratio",
+        "probabilistic_sortino_ratio",
+        "probabilistic_adjusted_sortino_ratio",
+    ]
+
+    @staticmethod
+    def _series(n):
+        idx = pd.date_range("2020-01-01", periods=n, freq="D")
+        vals = np.random.default_rng(404).normal(0.001, 0.01, n)
+        return pd.Series(vals, index=idx, name="R")
+
+    @pytest.mark.parametrize("name", ENTRY_POINTS)
+    def test_one_observation_returns_nan_rather_than_raising(self, name):
+        got = getattr(qs.stats, name)(self._series(1))
