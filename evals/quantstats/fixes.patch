+        v = long_returns.to_numpy()
+        got = qs.stats.rolling_volatility(long_returns, rolling_period=60)
+        assert np.isclose(got.dropna().iloc[-1], v[-60:].std(ddof=1) * np.sqrt(252), rtol=1e-9)
