+class TestTreynorRatioIsAnnualised:
+    """QS-20: treynor_ratio documented periods as annualization but forwarded it
+    only to greeks, which spends it on alpha while treynor reads beta, so the
+    argument was inert. It returned the whole-period compounded return less an
+    annual rf over beta, which grows with the length of the sample."""
+
+    @staticmethod
+    def _pair(n, seed=5):
+        idx = pd.date_range("2019-01-01", periods=n, freq="B")
+        rng = np.random.default_rng(seed)
+        bench = pd.Series(rng.normal(0.0004, 0.009, n), index=idx, name="B")
+        rets = pd.Series(
+            1.2 * bench.to_numpy() + rng.normal(0.0002, 0.005, n), index=idx, name="S"
+        )
+        return rets, bench
+
+    def test_periods_changes_the_result(self):
+        rets, bench = self._pair(1008)
+        values = {p: qs.stats.treynor_ratio(rets, bench, periods=p) for p in (252, 52, 12)}
+        assert len({round(v, 12) for v in values.values()}) == 3, values
+
+    @pytest.mark.parametrize("periods", [252, 52])
+    @pytest.mark.parametrize("rf", [0.0, 0.03])
+    def test_equals_annualised_return_over_beta(self, periods, rf):
+        """Known answer: the textbook definition, not the whole-period return."""
+        rets, bench = self._pair(1008)
+        beta = float(qs.stats.greeks(rets, bench)["beta"])
+        expected = (qs.stats.cagr(rets, periods=periods) - rf) / beta
+        got = qs.stats.treynor_ratio(rets, bench, periods=periods, rf=rf)
+        assert np.isclose(got, expected, rtol=1e-12)
+
+    def test_does_not_grow_with_the_length_of_the_sample(self):
+        """One realization, increasing prefixes of it. An annualized figure stays
+        the size of a yearly return; the whole-period form this replaced ran
+        -0.0022, 0.2323, 0.8123, 6.5909 over these same four prefixes."""
+        rets, bench = self._pair(2016)
+        for n in (252, 504, 1008, 2016):
+            rr, bb = rets.iloc[:n], bench.iloc[:n]
+            beta = float(qs.stats.greeks(rr, bb)["beta"])
+            got = float(qs.stats.treynor_ratio(rr, bb))
+            assert abs(got) < 1.0, (n, got)
+            assert np.isclose(got, qs.stats.cagr(rr) / beta, rtol=1e-12)
+
+    def test_beta_is_not_rescaled_by_periods(self):
+        """periods must not reach beta, which is a covariance ratio."""
+        rets, bench = self._pair(1008)
+        betas = {p: float(qs.stats.greeks(rets, bench, periods=p)["beta"]) for p in (252, 52, 12)}
+        assert len({round(v, 12) for v in betas.values()}) == 1, betas
+
+    def test_rf_is_deducted_as_an_annual_rate(self):
+        rets, bench = self._pair(1008)
+        beta = float(qs.stats.greeks(rets, bench)["beta"])
+        base = qs.stats.treynor_ratio(rets, bench)
+        with_rf = qs.stats.treynor_ratio(rets, bench, rf=0.03)
+        assert np.isclose(base - with_rf, 0.03 / beta, rtol=1e-9)
+
+    def test_docstring_states_the_convention_the_code_implements(self):
+        doc = qs.stats.treynor_ratio.__doc__
+        assert "annualized return" in doc
+        assert "used to annualize the return" in doc
+
