+def _growth_optimal_fraction(returns: _np.ndarray) -> float:
+    """
+    Solve for the growth-optimal fraction of capital for one return series.
+
+    Maximises E[log(1 + f * r)] over f, i.e. finds the root of
+    E[r / (1 + f * r)] = 0. The objective is strictly concave in f on
+    (-1/max(r), 1/|min(r)|), so the root is unique and bracketed by 0.
+    """
+    r = _np.asarray(returns, dtype=float)
+    r = r[_np.isfinite(r)]
+    if len(r) == 0:
+        return _np.nan
+
+    mean = r.mean()
+    if mean == 0:
+        return 0.0
+
+    def slope(f):
+        return _np.mean(r / (1.0 + f * r))
+
+    if mean > 0:
+        if r.min() >= 0:
+            return _np.inf  # no downside: growth is unbounded in leverage
+        lo, hi = 0.0, 1.0 / abs(r.min())
+    else:
+        if r.max() <= 0:
+            return -_np.inf  # no upside: the optimal position is an unbounded short
+        lo, hi = -1.0 / r.max(), 0.0
+
+    # Step just inside the open interval so the objective stays finite.
+    eps = (hi - lo) * 1e-12
+    return _brentq(slope, lo + eps, hi - eps, xtol=1e-14)
+
