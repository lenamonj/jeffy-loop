+    _prepare_returns boundary, which gives periods a real job - deannualizing
+    rf - so it is back in the signature and must now move the result whenever
+    rf is non-zero, and only then."""
+
+    ENTRY_POINTS = [
+        "probabilistic_ratio",
+        "probabilistic_sharpe_ratio",
+        "probabilistic_sortino_ratio",
+        "probabilistic_adjusted_sortino_ratio",
