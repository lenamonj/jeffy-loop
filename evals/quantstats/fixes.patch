+class TestMakeIndexRebalances:
+    """QS-19: utils.make_index never used the value of its rebalance argument.
+    The function held no .resample( call and both branches summed weight times
+    return every day, so rebalance=None, "1ME" and "1QE" returned one identical
+    daily-rebalanced series and the documented buy-and-hold case was wrong."""
+
+    @pytest.fixture
+    def members(self):
+        idx = pd.date_range("2019-01-01", periods=1260, freq="B")
+        rng = np.random.default_rng(7)
+        return pd.DataFrame(
+            {"A": rng.normal(0.0009, 0.013, 1260), "B": rng.normal(0.0001, 0.006, 1260)},
+            index=idx,
+        )
+
+    WEIGHTS = {"A": 0.5, "B": 0.5}
+
+    def test_never_rebalancing_is_buy_and_hold(self, members):
+        """Known answer: the value of one unit split at the target weights and
+        left alone, so the members' weights drift with their performance."""
+        wealth = (1 + members).cumprod()
+        value = (wealth * pd.Series(self.WEIGHTS)).sum(axis=1)
+        expected = value / value.shift(1).fillna(1.0) - 1.0
+        got = qs.utils.make_index(self.WEIGHTS, returns=members, rebalance=None)
+        assert np.allclose(got.to_numpy(), expected.to_numpy(), equal_nan=True)
+
+    def test_daily_rebalancing_is_the_weighted_sum(self, members):
+        """The old behaviour is still reachable, but only when asked for."""
+        expected = (members * pd.Series(self.WEIGHTS)).sum(axis=1)
+        got = qs.utils.make_index(self.WEIGHTS, returns=members, rebalance="1D")
+        assert np.allclose(got.to_numpy(), expected.to_numpy(), equal_nan=True)
+
+    def test_each_interval_gives_a_different_index(self, members):
+        totals = {
+            str(rb): float(
+                np.prod(1 + qs.utils.make_index(self.WEIGHTS, returns=members, rebalance=rb).to_numpy()) - 1
+            )
+            for rb in (None, "1D", "1ME", "1QE")
+        }
+        assert len({round(v, 10) for v in totals.values()}) == 4, totals
+
+    @pytest.mark.parametrize("rebalance", [None, "1D", "1ME", "1QE"])
+    def test_a_single_member_reproduces_that_member(self, members, rebalance):
+        """Invariant a wrong weighting scheme breaks: 100 percent of one asset
+        is that asset, whatever the rebalance interval."""
+        got = qs.utils.make_index({"A": 1.0, "B": 0.0}, returns=members, rebalance=rebalance)
+        assert np.allclose(got.to_numpy(), members["A"].to_numpy(), equal_nan=True)
+
+    def test_uninvested_weight_is_held_as_cash(self, members):
+        """Weights need not sum to 1; the remainder must not be booked as loss."""
+        half = qs.utils.make_index({"A": 0.25, "B": 0.25}, returns=members, rebalance="1ME")
+        assert np.isclose(
+            half.iloc[0], 0.25 * members["A"].iloc[0] + 0.25 * members["B"].iloc[0]
+        )
+
+    def test_legacy_frequency_alias_is_accepted(self, members):
+        monthly = qs.utils.make_index(self.WEIGHTS, returns=members, rebalance="1ME")
+        legacy = qs.utils.make_index(self.WEIGHTS, returns=members, rebalance="M")
+        assert np.allclose(legacy.to_numpy(), monthly.to_numpy(), equal_nan=True)
+
+    def test_index_length_is_preserved(self, members):
+        for rb in (None, "1ME", "1QE"):
+            got = qs.utils.make_index(self.WEIGHTS, returns=members, rebalance=rb)
+            assert len(got) == len(members)
