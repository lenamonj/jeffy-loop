+class TestProbabilisticRatioUsesKurtosisConsistently:
+    """QS-28: the standard error computed ((kurtosis_no - 3) / 4) * base**2
+    while stats.kurtosis returns the pandas value, which is Fisher excess
+    kurtosis and already g4 - 3. Subtracting 3 twice removes a flat
+    0.75 * base**2 from the variance, which biases every result and turns the
+    variance negative once the per-observation ratio passes 2 in absolute
+    value, where the square root produced nan instead of a probability."""
+
+    @pytest.fixture
+    def long_returns(self):
+        idx = pd.date_range("2022-01-03", periods=504, freq="B")
+        vals = np.random.default_rng(20260801).normal(0.0005, 0.010, len(idx))
+        return pd.Series(vals, index=idx, name="R")
+
+    @staticmethod
+    def _reference(series, base_ratio):
+        """Canonical Bailey and Lopez de Prado standard error, written from the
+        definition with RAW kurtosis, independent of the implementation."""
+        from scipy.stats import norm
+
+        g3 = series.skew()
+        g4 = series.kurtosis() + 3.0
+        n = len(series)
+        variance = (1 - g3 * base_ratio + ((g4 - 1) / 4) * base_ratio**2) / (n - 1)
+        return norm.cdf(base_ratio / np.sqrt(variance))
+
+    def test_sharpe_base_matches_the_canonical_standard_error(self, long_returns):
+        sr = qs.stats.sharpe(long_returns, annualize=False)
+        assert np.isclose(
+            qs.stats.probabilistic_sharpe_ratio(long_returns),
+            self._reference(long_returns, sr),
+            rtol=1e-12,
+        )
+
+    def test_adjustment_term_vanishes_on_a_normal_sample(self):
+        """The excess-kurtosis term is what the double subtraction broke: on a
+        normal sample it must be about zero, not about -0.75."""
+        sample = pd.Series(np.random.default_rng(5).normal(0.001, 0.01, 200_000))
+        term = qs.stats.kurtosis(sample, prepare_returns=False) / 4
+        assert abs(term) < 1e-2
+
+    @pytest.mark.parametrize("target_ratio", [2.5, 3.0, 5.0, -2.5, -5.0])
+    def test_a_large_per_observation_ratio_still_returns_a_probability(
+        self, target_ratio
+    ):
+        """Above |SR| = 2 the old variance numerator 1 - 0.25 * SR**2 went
+        negative on near-normal data and the result was nan."""
+        rng = np.random.default_rng(77)
+        raw = rng.normal(0.0, 1.0, 400)
+        scaled = (raw - raw.mean()) / raw.std(ddof=1)
+        series = pd.Series(
+            scaled * 0.01 + target_ratio * 0.01,
+            index=pd.date_range("2022-01-03", periods=400, freq="B"),
+        )
+        got = qs.stats.probabilistic_sharpe_ratio(series)
+        assert np.isfinite(got)
+        assert 0.0 <= got <= 1.0
+
+    def test_the_old_form_would_have_gone_negative_there(self):
+        """Pins the mechanism rather than the symptom, so the test states why
+        |SR| = 2 is the threshold."""
+        for sr in [2.5, 3.0, 5.0]:
+            old_numerator = 1 + 0.5 * sr**2 - 0.0 * sr + ((0.0 - 3) / 4) * sr**2
+            new_numerator = 1 + 0.5 * sr**2 - 0.0 * sr + (0.0 / 4) * sr**2
+            assert old_numerator < 0
+            assert new_numerator > 0
+
+    @pytest.mark.parametrize("base", ["sharpe", "sortino", "adjusted_sortino"])
+    def test_every_base_uses_the_same_corrected_standard_error(
+        self, base, long_returns
+    ):
+        ratio = {
+            "sharpe": qs.stats.sharpe,
+            "sortino": qs.stats.sortino,
+            "adjusted_sortino": qs.stats.adjusted_sortino,
+        }[base](long_returns, annualize=False)
+        assert np.isclose(
+            qs.stats.probabilistic_ratio(long_returns, base=base),
+            self._reference(long_returns, ratio),
+            rtol=1e-12,
+        )
+
+    def test_rf_invariant_from_qs27_is_preserved(self, long_returns):
+        """The earlier fix must survive this one."""
+        for rf, periods in [(0.05, 252), (0.02, 12)]:
+            excess = qs.utils.to_excess_returns(long_returns, rf, periods)
+            assert np.isclose(
+                qs.stats.probabilistic_sharpe_ratio(long_returns, rf, periods),
+                qs.stats.probabilistic_sharpe_ratio(excess, 0.0),
+                rtol=1e-12,
+            )
