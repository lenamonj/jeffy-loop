+    def test_rf_is_deannualized_geometrically(self, long_returns):
+        """Pins the conversion itself: the daily charge is the geometric
+        deannualization of the annual rate, not the annual rate whole and not a
+        simple division."""
+        rf, periods = 0.05, 252
+        daily = (1 + rf) ** (1 / periods) - 1
+        assert np.isclose(
+            qs.stats.probabilistic_sharpe_ratio(long_returns, rf, periods),
