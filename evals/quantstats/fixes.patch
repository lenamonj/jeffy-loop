+    @staticmethod
+    def _pair(zone):
+        idx = pd.date_range("2020-01-01", periods=400, freq="B", tz=zone)
+        values = np.random.default_rng(53).normal(0.0005, 0.012, len(idx))
+        aware = pd.Series(values, index=idx, name="Strategy")
+        return aware, aware.tz_localize(None)
