+class TestReportOutputSurvivesANarrowConsoleEncoding:
+    """QS-23: reports.metrics/basic/full died with UnicodeEncodeError on a
+    cp1252 console. Three metric labels carried U+FE6A and U+221A, and every
+    print in reports.py went straight to stdout, so a caller-supplied CJK or
+    Greek strategy_title crashed the report too."""
+
+    @staticmethod
+    def _cp1252_stdout():
+        """A text stream with the encoding a stock Windows console reports."""
+        return io.TextIOWrapper(io.BytesIO(), encoding="cp1252", newline="")
+
+    def test_no_source_line_is_unencodable_in_cp1252(self):
+        """Enumeration for the label half of the class: every source line in the
+        package must survive the narrowest encoding its console may report."""
+        root = Path(qs.__file__).parent
+        offenders = []
+        for path in sorted(root.rglob("*.py")):
+            for lineno, line in enumerate(
+                path.read_text(encoding="utf-8").splitlines(), 1
+            ):
+                try:
+                    line.encode("cp1252")
+                except UnicodeEncodeError:
+                    offenders.append(f"{path.name}:{lineno}")
+        assert offenders == []
+
+    def test_every_console_write_goes_through_the_one_boundary(self):
+        """Enumeration for the caller-text half: reports.py must hold no bare
+        print() outside the _print helper, or the next label or title added
+        reopens the class."""
+        source = Path(qs.reports.__file__).read_text(encoding="utf-8")
+        tree = ast.parse(source)
+        helper = next(
+            n
+            for n in ast.walk(tree)
+            if isinstance(n, ast.FunctionDef) and n.name == "_print"
+        )
+        bare = [
+            n.func.lineno
+            for n in ast.walk(tree)
+            if isinstance(n, ast.Call)
+            and isinstance(n.func, ast.Name)
+            and n.func.id == "print"
+            and not (helper.lineno <= n.func.lineno <= helper.end_lineno)
+        ]
+        assert bare == []
+
