+class TestMontecarloDistributions:
+    """QS-15: montecarlo_sharpe and montecarlo_cagr must report genuine
+    sampling distributions. Shuffling preserves the statistics they simulate,
+    so the old outputs were a point mass (cagr, std ~1e-15) and a
+    leave-one-out artifact (sharpe, std ~18x below sampling uncertainty)."""
+
+    @pytest.fixture
+    def long_returns(self):
+        idx = pd.date_range("2023-01-02", periods=252, freq="B")
+        vals = np.random.default_rng(11).normal(0.0005, 0.01, 252)
+        return pd.Series(vals, index=idx, name="R")
+
+    def test_montecarlo_cagr_has_genuine_spread(self, long_returns):
+        dist = qs.stats.montecarlo_cagr(long_returns, sims=200, seed=5)
+        assert dist["std"] > 1e-9
+        assert dist["percentile_95"] - dist["percentile_5"] > 1e-6
+
+    def test_montecarlo_sharpe_spread_matches_sampling_uncertainty(self, long_returns):
+        dist = qs.stats.montecarlo_sharpe(long_returns, sims=500, seed=5)
+        vals = long_returns.values
+        sr_daily = vals.mean() / vals.std(ddof=1)
+        se_annual = np.sqrt((1 + 0.5 * sr_daily**2) / len(vals)) * np.sqrt(252)
+        assert 0.5 * se_annual < dist["std"] < 2.0 * se_annual
+        assert abs(dist["mean"] - qs.stats.sharpe(long_returns)) < 2 * dist["std"]
+
+    def test_seeded_reproducibility(self, long_returns):
+        a = qs.stats.montecarlo_sharpe(long_returns, sims=50, seed=9)
+        b = qs.stats.montecarlo_sharpe(long_returns, sims=50, seed=9)
+        assert a == b
+        c = qs.stats.montecarlo_cagr(long_returns, sims=50, seed=9)
+        d = qs.stats.montecarlo_cagr(long_returns, sims=50, seed=9)
+        assert c == d
+
+    def test_montecarlo_core_still_permutation(self, long_returns):
+        mc = qs.stats.montecarlo(long_returns, sims=20, seed=3)
+        terminals = mc.data.iloc[-1].values
+        original = (1 + long_returns).prod() - 1
+        assert np.allclose(terminals, original, rtol=1e-9)
