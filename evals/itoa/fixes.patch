+/// The sign byte's room, enumerated rather than asserted. The signed `write`
+/// puts the digits at the tail of the buffer and the sign in the byte before
+/// them, which is in bounds only while no magnitude of the type reaches
+/// `MAX_STR_LEN` digits. `MIN` is the tightest case and it is exactly one digit
+/// short, so the sign gets exactly one byte and never less. The unsigned types
+/// are the other half of the same statement: their widest value fills the
+/// buffer completely, because they have no sign to leave room for.
+#[test]
+fn test_sign_byte_room() {
+    use itoa::Integer as _;
+
+    macro_rules! signed {
+        ($($t:ident)*) => {$({
+            let digits = $t::MIN.unsigned_abs().to_string().len();
+            // clippy::int_plus_one: `digits < MAX_STR_LEN` is the same bound
+            // as `digits <= MAX_STR_LEN - 1`, and it cannot underflow.
+            assert!(
+                digits < $t::MAX_STR_LEN,
+                "{}: |MIN| has {} digits and MAX_STR_LEN is {}, leaving the sign no byte",
+                stringify!($t), digits, $t::MAX_STR_LEN,
+            );
+            assert_eq!(
+                digits, $t::MAX_STR_LEN - 1,
+                "{}: MIN should be the tightest case, one digit short of the buffer",
+                stringify!($t),
+            );
+            let mut buffer = itoa::Buffer::new();
+            assert_eq!(buffer.format($t::MIN).len(), $t::MAX_STR_LEN);
+        })*};
+    }
+
+    macro_rules! unsigned {
+        ($($t:ident)*) => {$({
+            let digits = $t::MAX.to_string().len();
+            assert_eq!(
+                digits, $t::MAX_STR_LEN,
+                "{}: MAX should fill the buffer exactly", stringify!($t),
+            );
+            let mut buffer = itoa::Buffer::new();
+            assert_eq!(buffer.format($t::MAX).len(), $t::MAX_STR_LEN);
+        })*};
+    }
+
+    signed!(i8 i16 i32 i64 i128 isize);
+    unsigned!(u8 u16 u32 u64 u128 usize);
 }
