+// The cases above are hand-written known answers. The tests below compare
+// against the standard library's own rendering instead, which is the
+// independent reference this crate exists to reproduce faster, and they cover
+// the widths and value classes a fixed list cannot reach.
+//
+// Miri runs this suite in CI and is orders of magnitude slower than a native
+// run, so the exhaustive sweeps shrink to a stride under it rather than being
+// skipped: the same code paths are still exercised, just at fewer points.
+const fn stride() -> usize {
+    if cfg!(miri) {
+        1021 // prime, so the sampled residues do not align with any decade
+    } else {
+        1
+    }
+}
+
+#[test]
+fn test_exhaustive_16_bit() {
+    let mut buffer = itoa::Buffer::new();
+    for v in (u16::MIN..=u16::MAX).step_by(stride()) {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+    for v in (i16::MIN..=i16::MAX).step_by(stride()) {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+}
+
+#[test]
+fn test_exhaustive_8_bit() {
+    let mut buffer = itoa::Buffer::new();
+    for v in u8::MIN..=u8::MAX {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+    for v in i8::MIN..=i8::MAX {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+}
+
+/// Every entry of the two-digit lookup table, and both halves of the
+/// four-digit path. Values from 100 to 9999 send every pair from 00 to 99
+/// through divmod100 as a remainder, and every value from 1000 up sends a pair
+/// through as a quotient as well.
+#[test]
+fn test_every_decimal_pair() {
+    let mut buffer = itoa::Buffer::new();
+    for v in (0..=9999u32).step_by(stride()) {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+    for v in (-9999..=0i32).step_by(stride()) {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+}
+
+/// Every decade boundary of every width, on both sides of zero. This is where
+/// the digit-count branches switch and where the sign offset moves.
+#[test]
+fn test_decade_boundaries() {
+    let mut buffer = itoa::Buffer::new();
+    for e in 0..39u32 {
+        let Some(p) = 10u128.checked_pow(e) else {
+            break;
+        };
+        for delta in -2i128..=2 {
+            let Some(c) = (p as i128).checked_add(delta) else {
+                continue;
+            };
+            if c >= 0 {
+                let u = c as u128;
+                assert_eq!(buffer.format(u), u.to_string());
+                if u <= u64::MAX as u128 {
+                    assert_eq!(buffer.format(u as u64), (u as u64).to_string());
+                }
+                if u <= u32::MAX as u128 {
+                    assert_eq!(buffer.format(u as u32), (u as u32).to_string());
+                }
+                if u <= usize::MAX as u128 {
+                    assert_eq!(buffer.format(u as usize), (u as usize).to_string());
+                }
+            }
+            assert_eq!(buffer.format(c), c.to_string());
+            let n = c.wrapping_neg();
+            assert_eq!(buffer.format(n), n.to_string());
+            if c >= i64::MIN as i128 && c <= i64::MAX as i128 {
+                assert_eq!(buffer.format(c as i64), (c as i64).to_string());
+            }
+            if c >= i32::MIN as i128 && c <= i32::MAX as i128 {
+                assert_eq!(buffer.format(c as i32), (c as i32).to_string());
+            }
+            if c >= isize::MIN as i128 && c <= isize::MAX as i128 {
+                assert_eq!(buffer.format(c as isize), (c as isize).to_string());
+            }
+        }
+    }
+}
+
+/// The 128-bit formatter divides by 1e16 twice using a reciprocal multiply, so
+/// its constants are exercised only near those two boundaries and at the top
+/// of the range.
+#[test]
+fn test_u128_division_boundaries() {
+    let mut buffer = itoa::Buffer::new();
+    let span = if cfg!(miri) { 8 } else { 2000 };
+    for base in [
+        10u128.pow(16),
+        10u128.pow(32),
+        u128::MAX,
+        i128::MAX as u128,
+    ] {
+        for d in 0..span {
+            let hi = base.wrapping_add(d);
+            let lo = base.wrapping_sub(d);
+            assert_eq!(buffer.format(hi), hi.to_string());
+            assert_eq!(buffer.format(lo), lo.to_string());
+        }
+    }
+    // Exact multiples of 1e16 leave a zero remainder, which the 16-digit
+    // encoder has to zero-pad rather than shorten.
+    for m in 1..=34u128 {
+        let v = m * 10u128.pow(16);
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+    for k in 0..128u32 {
+        let v = 1u128 << k;
+        assert_eq!(buffer.format(v), v.to_string());
+        assert_eq!(buffer.format(v - 1), (v - 1).to_string());
+    }
+}
+
+/// usize and isize forward to the primitive of the host's pointer width. A
+/// forwarding impl wired to a narrower type truncates, and truncation stays
+/// invisible until a value exceeds that narrower type.
+#[test]
+fn test_pointer_sized_forwarding() {
+    let mut buffer = itoa::Buffer::new();
+    assert_eq!(buffer.format(usize::MAX), usize::MAX.to_string());
+    assert_eq!(buffer.format(usize::MIN), usize::MIN.to_string());
+    assert_eq!(buffer.format(isize::MAX), isize::MAX.to_string());
+    assert_eq!(buffer.format(isize::MIN), isize::MIN.to_string());
+
+    let mut v: usize = 1;
+    loop {
+        assert_eq!(buffer.format(v), v.to_string());
+        assert_eq!(buffer.format(v as isize), (v as isize).to_string());
+        match v.checked_mul(10) {
+            Some(next) => v = next,
+            None => break,
+        }
+    }
+}
+
+/// A buffer is reused across calls and the returned string is a slice into it,
+/// so a short value written after a long one must not carry the long one's
+/// tail.
+#[test]
+fn test_buffer_reuse_leaves_no_tail() {
+    let mut buffer = itoa::Buffer::new();
+    assert_eq!(buffer.format(u128::MAX), u128::MAX.to_string());
+    for v in [0u128, 7, 42, 999, 1000, 1, 10, 10000000000000000] {
+        assert_eq!(buffer.format(v), v.to_string());
+    }
+    assert_eq!(buffer.format(i128::MIN), i128::MIN.to_string());
+    assert_eq!(buffer.format(0u8), "0");
+    assert_eq!(buffer.format(-1i8), "-1");
 }
 
