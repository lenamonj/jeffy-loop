diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9669946a5..20e4a294a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -234,5 +234,36 @@ if(JSON_Install)
         FILES "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}.pc"
         DESTINATION ${NLOHMANN_JSON_PKGCONFIG_INSTALL_DIR}
     )
+    # CPack's source package would otherwise carry the whole working tree,
+    # because the default CPACK_SOURCE_IGNORE_FILES excludes only VCS metadata.
+    # An in-source build directory alone takes the archive from a few megabytes
+    # to several hundred. The VCS defaults are repeated here because setting the
+    # variable replaces them rather than adding to them. Patterns that could
+    # match a distributed path - docs/mkdocs/docs/integration/build2 is the one
+    # that bites - are anchored at the project root.
+    set(CPACK_SOURCE_IGNORE_FILES
+        "/CVS/" "/\\.svn/" "/\\.bzr/" "/\\.hg/" "/\\.git/" "\\.swp$" "\\.#" "/#"
+        "^${PROJECT_SOURCE_DIR}/build.*/"
+        "^${PROJECT_SOURCE_DIR}/cmake-build-.*/"
+        "^${PROJECT_SOURCE_DIR}/out/"
+        "^${PROJECT_SOURCE_DIR}/\\.build/"
+        "^${PROJECT_SOURCE_DIR}/\\.cache/"
+        "^${PROJECT_SOURCE_DIR}/\\.idea/"
+        "^${PROJECT_SOURCE_DIR}/\\.vs/"
+        "^${PROJECT_SOURCE_DIR}/\\.vscode/"
+        "/venv/"
+        "^${PROJECT_SOURCE_DIR}/docs/mkdocs/site/"
+        "^${PROJECT_SOURCE_DIR}/docs/docset/.*\\.docset/"
+        "^${PROJECT_SOURCE_DIR}/tests/corpus_"
+        # working records kept in the tree but not part of the distribution;
+        # these patterns simply match nothing in a checkout without them
+        "^${PROJECT_SOURCE_DIR}/\\.jeffy/"
+        "^${PROJECT_SOURCE_DIR}/\\.claude/"
+        "^${PROJECT_SOURCE_DIR}/PLAN\\.md$"
+        "^${PROJECT_SOURCE_DIR}/BACKLOG\\.md$"
+        "^${PROJECT_SOURCE_DIR}/JOURNAL\\.md$"
+        "^${PROJECT_SOURCE_DIR}/JOURNAL-archive\\.md$"
+        "\\.dSYM/" "\\.o$" "\\.gcda$" "\\.gcno$" "\\.DS_Store$"
+    )
     include(CPack)
 endif()
