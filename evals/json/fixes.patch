diff --git a/include/nlohmann/detail/json_pointer.hpp b/include/nlohmann/detail/json_pointer.hpp
index 576ba62cc..4cc080db1 100644
--- a/include/nlohmann/detail/json_pointer.hpp
+++ b/include/nlohmann/detail/json_pointer.hpp
@@ -260,7 +260,11 @@ class json_pointer
         }
 
         // error condition (cf. RFC 6901, Sect. 4)
-        if (JSON_HEDLEY_UNLIKELY(s.size() > 1 && !(s[0] >= '1' && s[0] <= '9')))
+        // A token whose first character cannot begin an array index is not a
+        // number at all; a token that begins like one but does not convert is
+        // an unresolved reference and reaches out_of_range.404 below. The only
+        // single-character token that may begin with '0' is "0" itself.
+        if (JSON_HEDLEY_UNLIKELY(s.empty() || !((s[0] >= '1' && s[0] <= '9') || (s.size() == 1 && s[0] == '0'))))
         {
             JSON_THROW(detail::parse_error::create(109, 0, detail::concat("array index '", s, "' is not a number"), nullptr));
         }
