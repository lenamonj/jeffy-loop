diff --git a/Tests/HTTPTypesFoundationTests/ProbeFoundationBridgeTests.swift b/Tests/HTTPTypesFoundationTests/ProbeFoundationBridgeTests.swift
new file mode 100644
index 0000000..ac55844
--- /dev/null
+++ b/Tests/HTTPTypesFoundationTests/ProbeFoundationBridgeTests.swift
@@ -0,0 +1,201 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the Swift open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0
+//
+// See LICENSE.txt for license information
+// See CONTRIBUTORS.txt for the list of Swift project authors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+import HTTPTypesFoundation
+import Testing
+
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+/// Known-answer checks for the Foundation bridge: the ISO Latin 1 field encoding, the URLRequest and
+/// HTTPURLResponse conversions in both directions, the WebSocket translation, and the URLSession
+/// conveniences' conversion failure path.
+///
+/// This file imports only `HTTPTypesFoundation`, never `HTTPTypes`, so it also pins that the module
+/// re-exports the core types: if the `@_exported import HTTPTypes` were dropped, this file would not
+/// compile.
+@Suite struct ProbeFoundationBridge {
+    private static let url = URL(string: "https://example.com/p")!
+
+    // MARK: - ISO Latin 1 bridging
+
+    /// Field values cross into Foundation's `[String: String]` header dictionaries as ISO Latin 1,
+    /// so a byte in 0x80-0xFF has to become the scalar of the same value, not its UTF-8 decoding,
+    /// and the trip back has to restore the byte.
+    @Test func isoLatin1BridgingRoundTripsHighBytes() throws {
+        let request = HTTPRequest(
+            method: .get,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [HTTPField.Name("X-Probe")!: "caf\u{E9}"]
+        )
+        let urlRequest = try #require(URLRequest(httpRequest: request))
+
+        // "café" as an HTTP field value is the two UTF-8 bytes 0xC3 0xA9, which read as ISO Latin 1
+        // are U+00C3 U+00A9.
+        #expect(urlRequest.value(forHTTPHeaderField: "X-Probe") == "caf\u{C3}\u{A9}")
+
+        let back = try #require(urlRequest.httpRequest)
+        #expect(back.headerFields[HTTPField.Name("X-Probe")!] == "caf\u{E9}", "the round trip restores the bytes")
+
+        // A pure ASCII value is untouched in both directions.
+        let ascii = HTTPRequest(
+            method: .get,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [HTTPField.Name("X-Probe")!: "plain"]
+        )
+        let asciiRequest = try #require(URLRequest(httpRequest: ascii))
+        #expect(asciiRequest.value(forHTTPHeaderField: "X-Probe") == "plain")
+        #expect(try #require(asciiRequest.httpRequest).headerFields[HTTPField.Name("X-Probe")!] == "plain")
+    }
+
+    // MARK: - URLRequest bridge
+
+    /// Repeated fields collapse into one Foundation header, joined with the comma everywhere except
+    /// "Cookie", which joins with "; ". Both separators are checked in the same request.
+    @Test func repeatedFieldsJoinWithTheRightSeparator() throws {
+        let request = HTTPRequest(
+            method: .post,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [
+                .acceptEncoding: "gzip",
+                .acceptEncoding: "br",
+                .cookie: "a=1",
+                .cookie: "b=2",
+                .accept: "*/*",
+            ]
+        )
+        let urlRequest = try #require(URLRequest(httpRequest: request))
+        #expect(urlRequest.httpMethod == "POST")
+        #expect(urlRequest.url == Self.url)
+        #expect(urlRequest.value(forHTTPHeaderField: "Accept-Encoding") == "gzip, br")
+        #expect(urlRequest.value(forHTTPHeaderField: "Cookie") == "a=1; b=2")
+        #expect(urlRequest.value(forHTTPHeaderField: "Accept") == "*/*")
+    }
+
+    /// The conversion answers nil rather than trapping or guessing when the request has no URL to
+    /// build, and when the URLRequest's URL has no scheme.
+    @Test func unconvertibleRequestsAnswerNil() {
+        // A plain CONNECT has no URL: the path is an authority, not a path.
+        let connect = HTTPRequest(
+            method: .connect,
+            scheme: "https",
+            authority: "example.com:443",
+            path: "example.com:443"
+        )
+        #expect(connect.url == nil)
+        #expect(URLRequest(httpRequest: connect) == nil)
+
+        // OPTIONS * likewise.
+        let asterisk = HTTPRequest(method: .options, scheme: "https", authority: "example.com", path: "*")
+        #expect(URLRequest(httpRequest: asterisk) == nil)
+
+        // And in the other direction, a URL with no scheme.
+        #expect(URLRequest(url: URL(string: "/relative")!).httpRequest == nil)
+
+        // A method Foundation reports that is not a token.
+        var badMethod = URLRequest(url: Self.url)
+        badMethod.httpMethod = "BAD METHOD"
+        #expect(badMethod.httpRequest == nil)
+    }
+
+    /// An extended-CONNECT WebSocket request is translated to the legacy ws/wss form on the way out
+    /// and back to extended CONNECT on the way in, for both schemes.
+    @Test func webSocketTranslationIsSymmetric() throws {
+        for (scheme, legacy) in [("https", "wss"), ("http", "ws")] {
+            var request = HTTPRequest(method: .connect, scheme: scheme, authority: "example.com", path: "/socket")
+            request.extendedConnectProtocol = "websocket"
+
+            let urlRequest = try #require(URLRequest(httpRequest: request))
+            #expect(urlRequest.httpMethod == "GET")
+            #expect(urlRequest.url?.scheme == legacy)
+
+            let back = try #require(urlRequest.httpRequest)
+            #expect(back.method == .connect)
+            #expect(back.scheme == scheme)
+            #expect(back.extendedConnectProtocol == "websocket")
+            #expect(back.path == "/socket")
+        }
+
+        // A scheme of the same length that is not ws or wss is left alone, since the translation
+        // switches on the length before it compares.
+        let plain = try #require(URLRequest(url: URL(string: "abc://example.com/p")!).httpRequest)
+        #expect(plain.method == .get)
+        #expect(plain.extendedConnectProtocol == nil)
+    }
+
+    // MARK: - HTTPURLResponse bridge
+
+    @Test func responseBridgeRoundTrips() throws {
+        let response = HTTPResponse(
+            status: .init(code: 201, reasonPhrase: "Created"),
+            headerFields: [.contentType: "text/plain", .server: "probe"]
+        )
+        let urlResponse = try #require(HTTPURLResponse(httpResponse: response, url: Self.url))
+        #expect(urlResponse.statusCode == 201)
+        #expect(urlResponse.url == Self.url)
+
+        let back = try #require(urlResponse.httpResponse)
+        #expect(back.status.code == 201)
+        #expect(back.headerFields[.contentType] == "text/plain")
+        #expect(back.headerFields[.server] == "probe")
+        #expect(back == response, "the reason phrase is outside equality, so the codes matching is enough")
+    }
+
+    /// The status code is the one thing the response bridge validates, and 0...999 is the range
+    /// `HTTPResponse.Status` accepts. Both sides of both ends are checked.
+    @Test func responseBridgeRejectsOutOfRangeStatuses() throws {
+        for code in [0, 999] {
+            let urlResponse = try #require(
+                HTTPURLResponse(url: Self.url, statusCode: code, httpVersion: "HTTP/1.1", headerFields: nil)
+            )
+            #expect(urlResponse.httpResponse?.status.code == code)
+        }
+        for code in [-1, 1000] {
+            let urlResponse = try #require(
+                HTTPURLResponse(url: Self.url, statusCode: code, httpVersion: "HTTP/1.1", headerFields: nil)
+            )
+            #expect(urlResponse.httpResponse == nil, "\(code) is outside the status range")
+        }
+    }
+
+    // MARK: - URLSession conveniences
+
+    /// The conveniences all funnel through the same conversion, and a request that cannot become a
+    /// URLRequest has to surface as a thrown error rather than a trap or a network call. No network
+    /// is involved: the conversion fails before any request is issued.
+    @Test func urlSessionConveniencesThrowOnAnUnconvertibleRequest() async {
+        let unconvertible = HTTPRequest(
+            method: .connect,
+            scheme: "https",
+            authority: "example.com:443",
+            path: "example.com:443"
+        )
+        #expect(URLRequest(httpRequest: unconvertible) == nil, "the conversion this test relies on does fail")
+
+        await #expect(throws: (any Error).self) {
+            _ = try await URLSession.shared.data(for: unconvertible)
+        }
+        await #expect(throws: (any Error).self) {
+            _ = try await URLSession.shared.upload(for: unconvertible, from: Data())
+        }
+    }
+}
