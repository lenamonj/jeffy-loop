index 0000000..80b1d57
--- /dev/null
+++ b/Tests/HTTPTypesTests/ProbeParsedAndErrorCodeTests.swift
@@ -0,0 +1,178 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the Swift open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0
+//
+// See LICENSE.txt for license information
+// See CONTRIBUTORS.txt for the list of Swift project authors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+import HTTPTypes
+import Testing
+
+/// Known-answer checks for the decoder-facing `init(parsed:)` entry points. These are the type's
+/// validation boundary against a field list decoded from the wire, so each rule it enforces is
+/// driven from both sides: a list that satisfies it and a list that breaks exactly that rule.
+@Suite struct ProbeHTTPParsedFields {
+    private func field(_ name: String, _ value: String) -> HTTPField {
+        HTTPField(name: HTTPField.Name(parsed: name)!, value: value)
+    }
+
+    private var requestFields: [HTTPField] {
+        [
+            self.field(":method", "GET"),
+            self.field(":scheme", "https"),
+            self.field(":authority", "example.com"),
+            self.field(":path", "/p"),
+            self.field("accept", "*/*"),
+        ]
+    }
+
+    private var responseFields: [HTTPField] {
+        [self.field(":status", "200"), self.field("content-type", "text/plain")]
+    }
+
+    @Test func aWellFormedRequestParses() throws {
+        let request = try HTTPRequest(parsed: self.requestFields)
+        #expect(request.method == .get)
+        #expect(request.scheme == "https")
+        #expect(request.authority == "example.com")
+        #expect(request.path == "/p")
+        #expect(request.headerFields.count == 1, "pseudo fields do not land in the header fields")
+        #expect(request.headerFields[.accept] == "*/*")
+        #expect(request.extendedConnectProtocol == nil)
+
+        var extended = self.requestFields
+        extended.insert(self.field(":protocol", "websocket"), at: 4)
+        #expect(try HTTPRequest(parsed: extended).extendedConnectProtocol == "websocket")
+    }
+
+    @Test func requestRulesAreEnforced() {
+        // No :method.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: self.requestFields.filter { $0.name.rawName != ":method" })
+        }
+        // A :method that is not a token.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: [self.field(":method", "GET NOW"), self.field(":path", "/")])
+        }
+        // A response pseudo field in a request.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: self.requestFields + [self.field(":status", "200")])
+        }
+        // A pseudo field after a regular field.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: [self.field("accept", "*/*"), self.field(":method", "GET")])
+        }
+        // The same pseudo field twice.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: self.requestFields + [self.field(":method", "POST")])
+        }
+        // A pseudo name that is not one of the six.
+        #expect(throws: (any Error).self) {
+            try HTTPRequest(parsed: self.requestFields + [self.field(":nonsense", "x")])
+        }
+    }
+
+    @Test func responseRulesAreEnforced() throws {
+        let response = try HTTPResponse(parsed: self.responseFields)
+        #expect(response.status == .ok)
+        #expect(response.headerFields[.contentType] == "text/plain")
+
+        // No :status.
+        #expect(throws: (any Error).self) {
+            try HTTPResponse(parsed: [self.field("content-type", "text/plain")])
+        }
+        // A :status that is not three digits.
+        for bad in ["20", "2000", "abc", "20a", ""] {
+            #expect(throws: (any Error).self) {
+                try HTTPResponse(parsed: [self.field(":status", bad)])
+            }
+        }
+        // A request pseudo field in a response.
+        #expect(throws: (any Error).self) {
+            try HTTPResponse(parsed: [self.field(":status", "200"), self.field(":method", "GET")])
+        }
+        // Three digits is enough, whatever the code means.
+        #expect(try HTTPResponse(parsed: [self.field(":status", "000")]).status.code == 0)
+        #expect(try HTTPResponse(parsed: [self.field(":status", "999")]).status.code == 999)
+    }
+
+    @Test func trailerFieldsRejectEveryPseudoField() throws {
+        let trailers = try HTTPFields(parsedTrailerFields: [self.field("x-checksum", "abc")])
+        #expect(trailers.count == 1)
+
+        for pseudo in [":method", ":scheme", ":authority", ":path", ":protocol", ":status"] {
+            #expect(throws: (any Error).self) {
+                try HTTPFields(parsedTrailerFields: [self.field(pseudo, "x")])
+            }
+        }
+    }
+
+    /// Fields that must not disagree with themselves: repeating one with the same value is legal,
+    /// repeating it with a different value is a request smuggling shape and is rejected.
+    @Test func repeatedSingletonFieldsMustAgree() {
+        for name in ["content-length", "content-disposition", "location"] {
+            let agreeing = [self.field(":status", "200"), self.field(name, "1"), self.field(name, "1")]
+            #expect(throws: Never.self) { try HTTPResponse(parsed: agreeing) }
+
+            let disagreeing = [self.field(":status", "200"), self.field(name, "1"), self.field(name, "2")]
+            #expect(throws: (any Error).self, "\(name) may not disagree with itself") {
+                try HTTPResponse(parsed: disagreeing)
+            }
+        }
+    }
+}
+
+/// Known-answer checks for the HTTP/2 and HTTP/3 error code types. The whole registry is checked
+/// structurally by `.jeffy/probes/error-codes/check-error-codes.py`; these pin the behaviour of the
+/// values and of `description`, including for codes that are not registered.
+@Suite struct ProbeErrorCodes {
+    @Test func http2CodesCarryTheirRegisteredValues() {
+        let expected: [(HTTP2ErrorCode, UInt32, String)] = [
+            (.noError, 0x00, "NO_ERROR (0x0)"),
+            (.protocolError, 0x01, "PROTOCOL_ERROR (0x1)"),
+            (.cancel, 0x08, "CANCEL (0x8)"),
+            (.connectError, 0x0a, "CONNECT_ERROR (0xa)"),
+            (.http11Required, 0x0d, "HTTP_1_1_REQUIRED (0xd)"),
+        ]
+        for (code, rawValue, description) in expected {
+            #expect(code.rawValue == rawValue)
+            #expect(code.description == description)
+            #expect(HTTP2ErrorCode(rawValue: rawValue) == code)
+        }
+
+        // Unregistered codes are legal and render as bare hex.
+        #expect(HTTP2ErrorCode(rawValue: 0x0e).description == "0xe")
+        #expect(HTTP2ErrorCode(rawValue: 0xFFFF_FFFF).description == "0xffffffff")
+        #expect(HTTP2ErrorCode(rawValue: 0x08) != HTTP2ErrorCode(rawValue: 0x09))
+        #expect(HTTP2ErrorCode(rawValue: 0x08).hashValue == HTTP2ErrorCode.cancel.hashValue)
+    }
+
+    @Test func http3CodesCarryTheirRegisteredValues() {
+        let expected: [(HTTP3ErrorCode, UInt64, String)] = [
+            (.noError, 0x0100, "H3_NO_ERROR (0x100)"),
+            (.requestCancelled, 0x010c, "H3_REQUEST_CANCELLED (0x10c)"),
+            (.versionFallback, 0x0110, "H3_VERSION_FALLBACK (0x110)"),
+            (.qpackDecompressionFailed, 0x0200, "QPACK_DECOMPRESSION_FAILED (0x200)"),
+            (.qpackDecoderStreamError, 0x0202, "QPACK_DECODER_STREAM_ERROR (0x202)"),
+        ]
+        for (code, rawValue, description) in expected {
+            #expect(code.rawValue == rawValue)
+            #expect(code.description == description)
+            #expect(HTTP3ErrorCode(rawValue: rawValue) == code)
+        }
+
+        #expect(HTTP3ErrorCode(rawValue: 0x21).description == "0x21")
+        // The largest value a QUIC variable-length integer can carry is accepted.
+        #expect(HTTP3ErrorCode(rawValue: 0x3fff_ffff_ffff_ffff).rawValue == 0x3fff_ffff_ffff_ffff)
+        #expect(HTTP3ErrorCode(rawValue: 0x0100) != HTTP3ErrorCode(rawValue: 0x0101))
+        #expect(HTTP3ErrorCode(rawValue: 0x0100).hashValue == HTTP3ErrorCode.noError.hashValue)
+    }
+}
