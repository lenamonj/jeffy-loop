+
+import HTTPTypes
+import Testing
+
+#if canImport(FoundationEssentials)
+import FoundationEssentials
+#else
+import Foundation
+#endif
+
+/// Known-answer checks for the URL bridge that `HTTPTypesURLTests` does not cover: the `url`
+/// setter, the three pseudo fields the getter requires, and the round trip between them.
+@Suite struct ProbeHTTPRequestURL {
+    /// The getter synthesizes a URL only when all three of scheme, authority and path are present.
+    /// Each is removed in turn, and the getter has to answer nil for each.
+    @Test func theGetterNeedsAllThreeComponents() {
+        let complete = HTTPRequest(method: .get, scheme: "https", authority: "example.com", path: "/p")
+        #expect(complete.url?.absoluteString == "https://example.com/p")
+
+        var noScheme = complete
+        noScheme.scheme = nil
+        #expect(noScheme.url == nil)
+
+        var noAuthority = complete
+        noAuthority.authority = nil
+        #expect(noAuthority.url == nil)
+
+        var noPath = complete
+        noPath.path = nil
+        #expect(noPath.url == nil)
+    }
+
+    /// The setter writes all three pseudo fields, and setting nil clears all three at once.
+    @Test func theSetterWritesAndClearsAllThreeComponents() {
+        var request = HTTPRequest(method: .get, scheme: "https", authority: "example.com", path: "/p")
+
+        request.url = URL(string: "http://other.example:8080/a/b?c=d")!
+        #expect(request.scheme == "http")
+        #expect(request.authority == "other.example:8080")
+        #expect(request.path == "/a/b?c=d")
+        #expect(request.method == .get, "the method is not part of the URL")
+
+        request.url = URL(string: "https://third.example")!
+        #expect(request.scheme == "https")
+        #expect(request.authority == "third.example")
+        #expect(request.path == "/", "an empty path becomes the origin-form slash")
+
+        request.url = nil
+        #expect(request.scheme == nil)
+        #expect(request.authority == nil)
+        #expect(request.path == nil)
+        #expect(request.url == nil)
+        #expect(request.method == .get, "clearing the URL leaves the method alone")
+    }
+
+    /// A URL that survives the round trip has to come back byte-identical, and the initializer and
+    /// the setter have to agree on how they decompose it.
+    @Test func initializerAndSetterAgreeAndRoundTrip() {
+        let urls = [
+            "https://example.com/",
+            "https://example.com/a/b",
+            "https://example.com/a?b=c",
+            "https://example.com:8443/p",
+            "https://[::1]:443/p",
+        ]
+        for string in urls {
+            let url = URL(string: string)!
+
+            let constructed = HTTPRequest(method: .post, url: url)
+            var assigned = HTTPRequest(method: .post, scheme: nil, authority: nil, path: nil)
+            assigned.url = url
+
+            #expect(constructed.scheme == assigned.scheme, "\(string)")
+            #expect(constructed.authority == assigned.authority, "\(string)")
+            #expect(constructed.path == assigned.path, "\(string)")
+            #expect(constructed.url?.absoluteString == string, "\(string) did not round trip")
+        }
+    }
+}
diff --git a/Tests/HTTPTypesTests/ProbeParsedAndErrorCodeTests.swift b/Tests/HTTPTypesTests/ProbeParsedAndErrorCodeTests.swift
