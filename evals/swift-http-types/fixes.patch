+        let values = ["1", "2", "3"]
+        var generator = SystemRandomNumberGenerator()
+
+        for _ in 0..<500 {
+            var pairs = [(HTTPField.Name, String)]()
+            for _ in 0..<Int.random(in: 2...6, using: &generator) {
+                pairs.append((names.randomElement(using: &generator)!, values.randomElement(using: &generator)!))
+            }
+            let fields1 = self.makeFields(pairs)
+            let fields2 = self.makeFields(pairs.shuffled(using: &generator))
+            if fields1 == fields2 {
+                #expect(fields1.hashValue == fields2.hashValue)
+            }
         }
     }
 
+    @Test func hashDistinguishesOrderWithinOneName() {
+        // Reordering fields that share a name is a different value, so `==` is false there and the
+        // hash is free to differ; this pins that the reordering really is a different value.
+        let fields1: HTTPFields = [.acceptEncoding: "br", .acceptEncoding: "gzip"]
+        let fields2: HTTPFields = [.acceptEncoding: "gzip", .acceptEncoding: "br"]
+        #expect(fields1 != fields2)
+    }
+
     @Test func sendable() {
         func isSendable(_ value: some Sendable) -> Bool { true }
         func isSendable(_ value: Any) -> Bool { false }
diff --git a/Tests/HTTPTypesTests/ProbeHTTPFieldNameTests.swift b/Tests/HTTPTypesTests/ProbeHTTPFieldNameTests.swift
new file mode 100644
index 0000000..452b983
--- /dev/null
+++ b/Tests/HTTPTypesTests/ProbeHTTPFieldNameTests.swift
@@ -0,0 +1,162 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the Swift open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0
+//
+// See LICENSE.txt for license information
+// See CONTRIBUTORS.txt for the list of Swift project authors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+import HTTPTypes
+import Testing
+
+/// Known-answer checks for field names: the RFC 9110 token character set, canonicalisation, the
+/// case-insensitive-but-case-preserving contract, and Codable. The expectations come from the
+/// grammar in RFC 9110 section 5.6.2, not from what the implementation returns.
+@Suite struct ProbeHTTPFieldName {
+    /// tchar = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." / "^" / "_" / "`" / "|" /
+    /// "~" / DIGIT / ALPHA. Every one of those is accepted; the characters just outside each range
+    /// are rejected.
+    @Test func tokenCharacterSetMatchesTheGrammar() {
+        let symbols = ["!", "#", "$", "%", "&", "'", "*", "+", "-", ".", "^", "_", "`", "|", "~"]
+        for symbol in symbols {
+            #expect(HTTPField.Name("a\(symbol)b") != nil, "\(symbol) is a tchar")
+        }
+        for boundary in ["0", "9", "a", "z", "A", "Z"] {
+            #expect(HTTPField.Name("x\(boundary)") != nil, "\(boundary) is a tchar")
+        }
+
+        // Just outside the ranges, and the separators RFC 9110 excludes.
+        let rejected = [
+            "/", ":", "(", ")", "<", ">", "@", ",", ";", "\\", "\"", "[", "]", "?", "=", "{", "}", " ", "\t",
+        ]
+        for character in rejected {
+            #expect(HTTPField.Name("a\(character)b") == nil, "\(character.debugDescription) is not a tchar")
+        }
+        #expect(HTTPField.Name("a\u{0}b") == nil)
+        #expect(HTTPField.Name("caf\u{E9}") == nil, "non-ASCII is not a token")
+
+        // Empty is not a token: `1*tchar`.
+        #expect(HTTPField.Name("") == nil)
+    }
+
+    /// The name is case-insensitive for comparison and case-preserving for rendering.
+    @Test func namesAreCaseInsensitiveAndCasePreserving() {
+        let mixed = HTTPField.Name("Content-Type")!
+        let upper = HTTPField.Name("CONTENT-TYPE")!
+        let lower = HTTPField.Name("content-type")!
+
+        #expect(mixed == upper)
+        #expect(mixed == lower)
+        #expect(mixed.hashValue == upper.hashValue)
+        #expect(mixed.hashValue == lower.hashValue)
+
+        #expect(mixed.rawName == "Content-Type")
+        #expect(upper.rawName == "CONTENT-TYPE")
+        #expect(mixed.canonicalName == "content-type")
+        #expect(upper.canonicalName == "content-type")
+        #expect(mixed.description == "Content-Type", "description renders the preserved case")
+
+        #expect(mixed != HTTPField.Name("Content-Types")!)
+    }
+
+    /// A field stored under one spelling is found under any other spelling of the same name.
+    @Test func lookupIgnoresCase() {
+        var fields = HTTPFields()
+        fields.append(HTTPField(name: HTTPField.Name("X-Probe")!, value: "1"))
+
+        #expect(fields[HTTPField.Name("x-probe")!] == "1")
+        #expect(fields[HTTPField.Name("X-PROBE")!] == "1")
+        #expect(fields.contains(HTTPField.Name("x-PrObE")!))
+        #expect(fields[HTTPField.Name("x-probe2")!] == nil)
+    }
+
+    /// `init(parsed:)` is the decoder-facing entry point: it admits the pseudo header names, which
+    /// carry a leading ":" that the ordinary initializer rejects.
+    @Test func parsedAdmitsPseudoNamesThatTheOrdinaryInitializerRejects() {
+        for pseudo in [":method", ":scheme", ":authority", ":path", ":protocol", ":status"] {
+            #expect(HTTPField.Name(parsed: pseudo) != nil, "\(pseudo) is a pseudo header name")
+            #expect(HTTPField.Name(pseudo) == nil, "\(pseudo) is not a plain field name")
+        }
+        #expect(HTTPField.Name(parsed: "accept") != nil)
+        #expect(HTTPField.Name(parsed: ":") == nil, "a bare colon has no token after it")
+        #expect(HTTPField.Name(parsed: ":not a token") == nil)
+        #expect(HTTPField.Name(parsed: "not a token") == nil)
+    }
+
+    /// `init(parsed:)` canonicalizes exactly as `init(_:)` does. Its documented input is decoder
+    /// output, which is lowercased, but a name that is not has to compare, hash and look up as the
+    /// lowercased spelling: `canonicalName` is what all three read, and storing an uppercased name
+    /// there once produced a field no name-keyed lookup could reach.
+    @Test func parsedCanonicalizesNamesThatAreNotLowercased() throws {
+        for (given, canonical) in [
+            ("Content-Type", "content-type"),
+            ("X-PROBE", "x-probe"),
+            (":Method", ":method"),
+        ] {
+            let name = try #require(HTTPField.Name(parsed: given))
+            #expect(name.canonicalName == canonical)
+            #expect(name.rawName == given, "the spelling as given is preserved")
+            #expect(name == HTTPField.Name(parsed: canonical)!)
+            #expect(name.hashValue == HTTPField.Name(parsed: canonical)!.hashValue)
+        }
+
+        // A field carrying such a name is reachable through the constant that addresses it.
+        var fields = HTTPFields()
+        fields.append(HTTPField(name: HTTPField.Name(parsed: "Content-Type")!, value: "text/plain"))
+        #expect(fields[.contentType] == "text/plain")
+
+        // Already-lowercased names are stored as they arrive, and invalid tokens are still nil.
+        #expect(HTTPField.Name(parsed: "content-type")!.canonicalName == "content-type")
+        #expect(HTTPField.Name(parsed: "Not A Token") == nil)
+    }
+
+    /// Codable carries the preserved spelling, and rejects names that are not tokens.
+    @Test func codableRoundTripsAndRejectsInvalidNames() throws {
+        for spelling in ["Content-Type", "content-type", "X-Probe"] {
+            let name = HTTPField.Name(spelling)!
+            let decoded = try JSONDecoder().decode(
+                HTTPField.Name.self,
+                from: try JSONEncoder().encode(name)
+            )
+            #expect(decoded.rawName == spelling, "the encoded form carries the preserved case")
+            #expect(decoded == name)
+        }
+
+        for invalid in ["\"bad name\"", "\"\"", "\"a:b\"", "\":Method\""] {
+            #expect(throws: DecodingError.self) {
+                try JSONDecoder().decode(HTTPField.Name.self, from: Data(invalid.utf8))
+            }
+        }
+
+        // A lowercase pseudo name decodes, since that is what a decoder emits.
+        let pseudo = try JSONDecoder().decode(HTTPField.Name.self, from: Data("\":method\"".utf8))
+        #expect(pseudo.rawName == ":method")
+    }
+
+    /// Spot-check that the well-known constants behave as their spelling says. The whole table is
+    /// checked structurally by `.jeffy/probes/httpfield-name/check-constants.py`; this pins that the
+    /// values those literals build actually compare and look up as expected.
+    @Test func wellKnownConstantsMatchTheirSpelling() {
+        let samples: [(HTTPField.Name, String)] = [
+            (.accept, "Accept"),
+            (.acceptEncoding, "Accept-Encoding"),
+            (.contentType, "Content-Type"),
+            (.cookie, "Cookie"),
+            (.userAgent, "User-Agent"),
+            (.secWebSocketKey, "Sec-WebSocket-Key"),
+        ]
+        for (name, spelling) in samples {
+            #expect(name.rawName == spelling)
+            #expect(name.canonicalName == spelling.lowercased())
+            #expect(name == HTTPField.Name(spelling)!)
+            #expect(name == HTTPField.Name(spelling.uppercased())!)
+        }
+    }
+}
diff --git a/Tests/HTTPTypesTests/ProbeHTTPFieldValueTests.swift b/Tests/HTTPTypesTests/ProbeHTTPFieldValueTests.swift
new file mode 100644
index 0000000..e26aeb4
--- /dev/null
+++ b/Tests/HTTPTypesTests/ProbeHTTPFieldValueTests.swift
@@ -0,0 +1,210 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the Swift open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0
+//
+// See LICENSE.txt for license information
+// See CONTRIBUTORS.txt for the list of Swift project authors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+import HTTPTypes
+import Testing
+
+/// Known-answer checks for the field value byte classification, legalization and ISO Latin 1
+/// transcoding. Every expectation here is a value computed by hand from RFC 9110's field-value
+/// grammar, never a restatement of what the implementation happens to return.
+@Suite struct ProbeHTTPFieldValue {
+    private static let name = HTTPField.Name("probe")!
+
+    private func value(_ bytes: [UInt8]) -> String {
+        HTTPField(name: Self.name, value: bytes).value
+    }
+
+    private func lenientValue(_ bytes: [UInt8]) -> [UInt8] {
+        HTTPField(name: Self.name, lenientValue: bytes).withUnsafeBytesOfValue { Array($0) }
+    }
+
+    /// RFC 9110 field-value: `*( field-content )`, where the interior admits VCHAR (0x21-0x7E),
+    /// obs-text (0x80-0xFF), SP and HTAB, and neither the first nor the last byte may be SP or
+    /// HTAB. Each byte below is classified from that grammar, both sides of every boundary.
+    @Test func isValidClassifiesEveryByteBoundary() {
+        let interiorLegal: [UInt8] = [0x09, 0x20, 0x21, 0x7E, 0x80, 0xFF]
+        let interiorIllegal: [UInt8] = [0x00, 0x01, 0x08, 0x0A, 0x0D, 0x1F, 0x7F]
+
+        for byte in interiorLegal {
+            #expect(HTTPField.isValidValue([0x61, byte, 0x62]), "0x\(String(byte, radix: 16)) is legal inside a value")
+        }
+        for byte in interiorIllegal {
+            #expect(
+                !HTTPField.isValidValue([0x61, byte, 0x62]),
+                "0x\(String(byte, radix: 16)) is illegal inside a value"
+            )
+        }
+
+        // Empty is legal; a lone SP or HTAB is not, because it is both first and last.
+        #expect(HTTPField.isValidValue([UInt8]()))
+        #expect(!HTTPField.isValidValue([0x20]))
+        #expect(!HTTPField.isValidValue([0x09]))
+
+        // Edge positions reject what the interior accepts.
+        #expect(!HTTPField.isValidValue([0x20, 0x61]))
+        #expect(!HTTPField.isValidValue([0x09, 0x61]))
+        #expect(!HTTPField.isValidValue([0x61, 0x20]))
+        #expect(!HTTPField.isValidValue([0x61, 0x09]))
+        #expect(HTTPField.isValidValue([0x61, 0x20, 0x62]))
+    }
+
+    /// The `String` and `Collection<UInt8>` overloads answer the same question about the same bytes.
+    @Test func isValidAgreesAcrossOverloads() {
+        let samples = ["", "a", " a", "a ", "a b", "a\tb", "a\nb", "a\u{0}b", "a\u{7F}b", "caf\u{E9}"]
+        for sample in samples {
+            #expect(
+                HTTPField.isValidValue(sample) == HTTPField.isValidValue(Array(sample.utf8)),
+                "overloads disagree on \(sample.debugDescription)"
+            )
+        }
+    }
+
+    /// Legalization: illegal interior bytes become SP, and leading and trailing SP or HTAB runs are
+    /// dropped. Each expected string is written out by hand.
+    @Test func legalizeProducesHandComputedValues() {
+        let cases: [([UInt8], String)] = [
+            ([0x61, 0x00, 0x62], "a b"),
+            ([0x61, 0x0A, 0x62], "a b"),
+            ([0x61, 0x0D, 0x0A, 0x62], "a  b"),
+            ([0x61, 0x7F, 0x62], "a b"),
+            ([0x61, 0x1F, 0x62], "a b"),
+            ([0x20, 0x09, 0x61, 0x09, 0x20], "a"),
+            ([0x00, 0x61], "a"),
+            ([0x61, 0x00], "a"),
+            ([0x00, 0x00], ""),
+            ([0x20], ""),
+            ([], ""),
+            ([0x61, 0x20, 0x62], "a b"),
+            ([0x61, 0x09, 0x62], "a\tb"),
+        ]
+        for (bytes, expected) in cases {
+            #expect(self.value(bytes) == expected, "legalize(\(bytes)) should be \(expected.debugDescription)")
+        }
+    }
+
+    /// A value that is already legal is stored unchanged, so legalization is idempotent.
+    @Test func legalizeIsIdempotent() {
+        let samples: [[UInt8]] = [
+            [], [0x61], [0x61, 0x20, 0x62], [0x61, 0x09, 0x62], [0x80, 0xFF], [0x61, 0x00, 0x62],
+        ]
+        for bytes in samples {
+            let once = self.value(bytes)
+            let twice = HTTPField(name: Self.name, value: once).value
+            #expect(once == twice, "legalize is not idempotent on \(bytes)")
+        }
+    }
+
+    /// The lenient initializer differs from the strict one exactly on the bytes it is documented to
+    /// keep: it replaces only NUL, LF and CR, and it does not trim the edges.
+    @Test func lenientKeepsWhatLegalizeDrops() {
+        #expect(self.lenientValue([0x61, 0x00, 0x62]) == [0x61, 0x20, 0x62])
+        #expect(self.lenientValue([0x61, 0x0A, 0x62]) == [0x61, 0x20, 0x62])
+        #expect(self.lenientValue([0x61, 0x0D, 0x62]) == [0x61, 0x20, 0x62])
+
+        // Kept by lenient, replaced or trimmed by legalize: this is the pair that separates them.
+        #expect(self.lenientValue([0x61, 0x7F, 0x62]) == [0x61, 0x7F, 0x62])
+        #expect(self.value([0x61, 0x7F, 0x62]) == "a b")
+        #expect(self.lenientValue([0x20, 0x61, 0x20]) == [0x20, 0x61, 0x20])
+        #expect(self.value([0x20, 0x61, 0x20]) == "a")
+        #expect(self.lenientValue([]) == [])
+    }
+
+    /// Values that are not UTF-8 keep their bytes, and the `value` view decodes them lossily rather
+    /// than losing them: the bytes are what round-trips.
+    @Test func nonUTF8BytesSurviveTheValueView() {
+        let latin1: [UInt8] = [0x63, 0x61, 0x66, 0xE9]  // "caf" + 0xE9, not valid UTF-8
+        let field = HTTPField(name: Self.name, value: latin1)
+        field.withUnsafeBytesOfValue { #expect(Array($0) == latin1) }
+        #expect(field.value != "caf\u{E9}", "0xE9 alone is not the UTF-8 encoding of U+00E9")
+
+        let utf8: [UInt8] = Array("caf\u{E9}".utf8)  // 0xC3 0xA9
+        #expect(utf8 == [0x63, 0x61, 0x66, 0xC3, 0xA9])
+        let utf8Field = HTTPField(name: Self.name, value: utf8)
+        #expect(utf8Field.value == "caf\u{E9}")
+        #expect(utf8Field != field, "different bytes are different values")
+    }
+
+    /// A value built from a String and the same value built from that String's bytes compare equal
+    /// and hash equal, across both storage representations.
+    @Test func stringAndByteStorageAgree() {
+        for sample in ["", "a", "a b", "caf\u{E9}", "\u{1F600}"] {
+            let fromString = HTTPField(name: Self.name, value: sample)
+            let fromBytes = HTTPField(name: Self.name, value: Array(sample.utf8))
+            #expect(fromString == fromBytes, "storage disagrees for \(sample.debugDescription)")
+            #expect(fromString.hashValue == fromBytes.hashValue)
+        }
+
+        // Non-UTF-8 bytes stay in byte storage and still compare by bytes.
+        let a = HTTPField(name: Self.name, value: [0xE9] as [UInt8])
+        let b = HTTPField(name: Self.name, value: [0xE9] as [UInt8])
+        #expect(a == b)
+        #expect(a.hashValue == b.hashValue)
+        #expect(a != HTTPField(name: Self.name, value: [0xEA] as [UInt8]))
+    }
+
+    /// Codable carries the value through ISO Latin 1, so a byte in 0x80-0xFF has to come back as
+    /// the same byte rather than as its UTF-8 encoding.
+    @Test func codableRoundTripPreservesHighBytes() throws {
+        let bytes: [UInt8] = [0x63, 0x61, 0x66, 0xE9]
+        let field = HTTPField(name: Self.name, value: bytes)
+        let encoded = try JSONEncoder().encode(field)
+        let decoded = try JSONDecoder().decode(HTTPField.self, from: encoded)
+        decoded.withUnsafeBytesOfValue { #expect(Array($0) == bytes) }
+        #expect(decoded == field)
+
+        for sample in ["", "a b", "caf\u{E9}"] {
+            let original = HTTPField(name: Self.name, value: sample)
+            let roundTripped = try JSONDecoder().decode(
+                HTTPField.self,
+                from: try JSONEncoder().encode(original)
+            )
+            #expect(roundTripped == original, "round trip changed \(sample.debugDescription)")
+        }
+    }
+
+    /// `description` is documented as the field's wire-ish rendering, and it renders the preserved
+    /// case of the name rather than the canonical one.
+    @Test func descriptionRendersRawNameAndLegalizedValue() {
+        let mixed = HTTPField(name: HTTPField.Name("Content-Type")!, value: "text/plain")
+        #expect(mixed.description == "Content-Type: text/plain")
+        #expect(HTTPField(name: Self.name, value: "a\u{0}b").description == "probe: a b")
+        #expect(HTTPField(name: Self.name, value: "").description == "probe: ")
+    }
+
+    /// The indexing strategy is a documented parameter of the field, so it has to change something:
+    /// it separates two otherwise identical fields and survives a Codable round trip.
+    @Test func indexingStrategyChangesTheValue() throws {
+        var automatic = HTTPField(name: Self.name, value: "x")
+        #expect(automatic.indexingStrategy == .automatic)
+
+        for strategy in [HTTPField.DynamicTableIndexingStrategy.prefer, .avoid, .disallow] {
+            var other = HTTPField(name: Self.name, value: "x")
+            other.indexingStrategy = strategy
+            #expect(other != automatic, "\(strategy) should not equal .automatic")
+            let roundTripped = try JSONDecoder().decode(
+                HTTPField.self,
+                from: try JSONEncoder().encode(other)
+            )
+            #expect(roundTripped.indexingStrategy == strategy)
+            #expect(roundTripped == other)
+        }
+
+        automatic.indexingStrategy = .prefer
+        var alsoPrefer = HTTPField(name: Self.name, value: "x")
+        alsoPrefer.indexingStrategy = .prefer
+        #expect(automatic == alsoPrefer)
+        #expect(automatic.hashValue == alsoPrefer.hashValue)
+    }
+}
diff --git a/Tests/HTTPTypesTests/ProbeHTTPFieldsTests.swift b/Tests/HTTPTypesTests/ProbeHTTPFieldsTests.swift
new file mode 100644
index 0000000..703bed0
--- /dev/null
+++ b/Tests/HTTPTypesTests/ProbeHTTPFieldsTests.swift
@@ -0,0 +1,394 @@
+//===----------------------------------------------------------------------===//
+//
+// This source file is part of the Swift open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0
+//
+// See LICENSE.txt for license information
+// See CONTRIBUTORS.txt for the list of Swift project authors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+//===----------------------------------------------------------------------===//
+
+import Foundation
+@_spi(HTTPTypesBenchmarking) import HTTPTypes
+import Testing
+
+/// Known-answer and invariant checks for the field collection: name-keyed access, the collection
+/// conformances, equality against an independent reference implementation, the hash contract, and
+/// the literal, debug and Codable conformances.
+@Suite struct ProbeHTTPFields {
+    private static let names = ["a", "b", "c", "d"].map { HTTPField.Name($0)! }
+
+    private func fields(_ pairs: [(String, String)]) -> HTTPFields {
+        var fields = HTTPFields()
+        for (name, value) in pairs {
+            fields.append(HTTPField(name: HTTPField.Name(name)!, value: value))
+        }
+        return fields
+    }
+
+    private func rendered(_ fields: HTTPFields) -> String {
+        fields.map { "\($0.name.canonicalName)=\($0.value)" }.joined(separator: ",")
+    }
+
+    /// The documented meaning of `==`: for every name, the same fields in the same order, with
+    /// fields of different names free to interleave differently. This reference implements that
+    /// sentence directly, by grouping, and has nothing in common with the optimised comparison.
+    private func referenceEqual(_ lhs: [HTTPField], _ rhs: [HTTPField]) -> Bool {
+        if lhs.count != rhs.count { return false }
+        var left = [String: [HTTPField]]()
+        var right = [String: [HTTPField]]()
+        for field in lhs { left[field.name.canonicalName, default: []].append(field) }
+        for field in rhs { right[field.name.canonicalName, default: []].append(field) }
+        if Set(left.keys) != Set(right.keys) { return false }
+        for (name, leftGroup) in left {
+            guard let rightGroup = right[name], leftGroup.count == rightGroup.count else { return false }
+            for index in leftGroup.indices where leftGroup[index] != rightGroup[index] { return false }
+        }
+        return true
+    }
+
+    private static let strategies: [HTTPField.DynamicTableIndexingStrategy] = [
+        .automatic, .prefer, .avoid, .disallow,
+    ]
+
+    /// The generator varies every stored property of `HTTPField`, not only the two the documented
+    /// meaning of `==` discusses. A differential whose generator holds a property constant agrees
+    /// with its reference on that axis for the wrong reason, however much volume it runs: both
+    /// sides are blind to the same thing. The byte-storage draws are two distinct raw values whose
+    /// lossy `value` String view is the same replacement character, so a comparison reading that
+    /// view instead of the stored bytes cannot tell them apart either.
+    private func randomFields(
+        count: Int,
+        names: [HTTPField.Name],
+        using generator: inout SystemRandomNumberGenerator
+    ) -> [HTTPField] {
+        (0..<count).map { _ in
+            let name = names.randomElement(using: &generator)!
+            var field: HTTPField
+            switch Int.random(in: 0..<6, using: &generator) {
+            case 0:
+                field = HTTPField(name: name, value: [0xFE] as [UInt8])
+            case 1:
+                field = HTTPField(name: name, value: [0xFF] as [UInt8])
+            default:
+                field = HTTPField(name: name, value: ["1", "2", "3"].randomElement(using: &generator)!)
+            }
+            field.indexingStrategy = Self.strategies.randomElement(using: &generator)!
+            return field
+        }
+    }
+
+    // MARK: - Name-keyed access
+
+    /// Reading a name joins its fields, with the comma separator everywhere except "Cookie", which
+    /// RFC 6265 joins with "; ".
+    @Test func readingANameJoinsItsFields() {
+        let fields = self.fields([("a", "1"), ("b", "x"), ("a", "2"), ("a", "3")])
+        #expect(fields[HTTPField.Name("a")!] == "1, 2, 3")
+        #expect(fields[HTTPField.Name("b")!] == "x")
+        #expect(fields[HTTPField.Name("c")!] == nil)
+        #expect(fields[values: HTTPField.Name("a")!] == ["1", "2", "3"])
+        #expect(fields[values: HTTPField.Name("c")!] == [])
+
+        var cookies = HTTPFields()
+        cookies[.cookie] = "a=1; b=2; c=3"
+        #expect(cookies[fields: .cookie].count == 3, "a Cookie value is split into one field per pair")
+        #expect(cookies[values: .cookie] == ["a=1", "b=2", "c=3"])
+        #expect(cookies[.cookie] == "a=1; b=2; c=3", "and joined back with the same separator")
+    }
+
+    /// Writing a name overwrites its fields in place while new ones last, appends the surplus, and
+    /// deletes the leftovers. Each expected rendering is written out by hand.
+    @Test func writingANameRewritesOnlyThatName() {
+        var shrink = self.fields([("a", "1"), ("b", "x"), ("a", "2"), ("a", "3")])
+        shrink[values: HTTPField.Name("a")!] = ["z"]
+        #expect(self.rendered(shrink) == "a=z,b=x")
+
+        var grow = self.fields([("a", "1"), ("b", "x")])
+        grow[values: HTTPField.Name("a")!] = ["p", "q", "r"]
+        #expect(self.rendered(grow) == "a=p,b=x,a=q,a=r")
+
+        var same = self.fields([("a", "1"), ("b", "x"), ("a", "2")])
+        same[values: HTTPField.Name("a")!] = ["p", "q"]
+        #expect(self.rendered(same) == "a=p,b=x,a=q")
+
+        var deleted = self.fields([("a", "1"), ("b", "x"), ("a", "2")])
+        deleted[HTTPField.Name("a")!] = nil
+        #expect(self.rendered(deleted) == "b=x")
+
+        var added = self.fields([("b", "x")])
+        added[HTTPField.Name("a")!] = "1"
+        #expect(self.rendered(added) == "b=x,a=1")
+
+        var emptied = self.fields([("a", "1")])
+        emptied[values: HTTPField.Name("a")!] = []
+        #expect(self.rendered(emptied) == "")
+        #expect(emptied.isEmpty)
+    }
+
+    /// `contains` answers for the canonical name, so any spelling finds it, and it is false once the
+    /// last field of that name is gone.
+    @Test func containsFollowsTheCanonicalName() {
+        var fields = self.fields([("a", "1"), ("b", "x")])
+        #expect(fields.contains(HTTPField.Name("A")!))
+        #expect(!fields.contains(HTTPField.Name("c")!))
+        fields[HTTPField.Name("A")!] = nil
+        #expect(!fields.contains(HTTPField.Name("a")!))
+    }
+
+    // MARK: - Collection conformances
+
+    /// The collection conformances index the storage order, which is the order fields were added.
+    @Test func collectionWalksStorageOrder() {
+        let fields = self.fields([("a", "1"), ("b", "x"), ("a", "2")])
+        #expect(fields.count == 3)
+        #expect(fields.startIndex == 0)
+        #expect(fields.endIndex == 3)
+        #expect(fields[0].value == "1")
+        #expect(fields[1].value == "x")
+        #expect(fields[2].value == "2")
+        #expect(Array(fields).count == 3)
+        #expect(HTTPFields().isEmpty)
+        #expect(!fields.isEmpty)
+    }
+
+    /// `replaceSubrange` is what every RangeReplaceableCollection mutation funnels through, so it is
+    /// exercised at the front, in the middle, at the end, and with an empty replacement.
+    @Test func replaceSubrangeAtEveryPosition() {
+        let base: [(String, String)] = [("a", "1"), ("b", "x"), ("c", "2")]
+
+        var front = self.fields(base)
+        front.replaceSubrange(0..<1, with: [HTTPField(name: HTTPField.Name("d")!, value: "9")])
+        #expect(self.rendered(front) == "d=9,b=x,c=2")
+
+        var middle = self.fields(base)
+        middle.replaceSubrange(1..<2, with: [HTTPField(name: HTTPField.Name("d")!, value: "9")])
+        #expect(self.rendered(middle) == "a=1,d=9,c=2")
+
+        var end = self.fields(base)
+        end.replaceSubrange(3..<3, with: [HTTPField(name: HTTPField.Name("d")!, value: "9")])
+        #expect(self.rendered(end) == "a=1,b=x,c=2,d=9")
+
+        var removal = self.fields(base)
+        removal.replaceSubrange(1..<2, with: [HTTPField]())
+        #expect(self.rendered(removal) == "a=1,c=2")
+
+        var growth = self.fields(base)
+        growth.replaceSubrange(
+            1..<2,
+            with: [
+                HTTPField(name: HTTPField.Name("d")!, value: "9"),
+                HTTPField(name: HTTPField.Name("e")!, value: "8"),
+            ]
+        )
+        #expect(self.rendered(growth) == "a=1,d=9,e=8,c=2")
+
+        var inserted = self.fields(base)
+        inserted.insert(HTTPField(name: HTTPField.Name("d")!, value: "9"), at: 0)
+        #expect(self.rendered(inserted) == "d=9,a=1,b=x,c=2")
+
+        var removedAt = self.fields(base)
+        removedAt.remove(at: 2)
+        #expect(self.rendered(removedAt) == "a=1,b=x")
+    }
+
+    /// The MutableCollection setter replaces one element and leaves the rest alone.
+    @Test func mutableCollectionSetterReplacesOneElement() {
+        var fields = self.fields([("a", "1"), ("b", "x")])
+        fields[1] = HTTPField(name: HTTPField.Name("c")!, value: "9")
+        #expect(self.rendered(fields) == "a=1,c=9")
+
+        // Assigning an equal element is a no-op rather than a rewrite.
+        let before = fields
+        fields[0] = HTTPField(name: HTTPField.Name("a")!, value: "1")
+        #expect(fields == before)
+    }
+
+    // MARK: - Equality
+
+    /// `==` is compared against the reference implementation of its own documented sentence, over
+    /// short lists where the lock-step walk runs.
+    @Test func equalityAgreesWithTheReferenceOnShortLists() {
+        var generator = SystemRandomNumberGenerator()
+        for _ in 0..<2000 {
+            let lhs = self.randomFields(
+                count: Int.random(in: 0...8, using: &generator),
+                names: Self.names,
+                using: &generator
+            )
+            var rhs = lhs
+            if Bool.random(using: &generator) { rhs.shuffle(using: &generator) }
+            if Bool.random(using: &generator), !rhs.isEmpty {
+                rhs[Int.random(in: 0..<rhs.count, using: &generator)] = HTTPField(
+                    name: Self.names.randomElement(using: &generator)!,
+                    value: "9"
+                )
+            }
+            var left = HTTPFields()
+            left.append(contentsOf: lhs)
+            var right = HTTPFields()
+            right.append(contentsOf: rhs)
+            #expect((left == right) == self.referenceEqual(lhs, rhs))
+            #expect((left == right) == (right == left), "equality has to be symmetric")
+        }
+    }
+
+    /// Long, heavily reordered lists take the by-name-index fallback instead of the lock-step walk.
+    /// Both paths have to answer what the reference answers, and each other.
+    @Test func equalityAgreesWithTheReferenceOnLongLists() {
+        var generator = SystemRandomNumberGenerator()
+        let names = (0..<40).map { HTTPField.Name("h\($0)")! }
+        for _ in 0..<200 {
+            let lhs = self.randomFields(
+                count: Int.random(in: 100...160, using: &generator),
+                names: names,
+                using: &generator
+            )
+            var rhs = lhs
+            rhs.shuffle(using: &generator)
+            if Bool.random(using: &generator) {
+                rhs[Int.random(in: 0..<rhs.count, using: &generator)] = HTTPField(
+                    name: names.randomElement(using: &generator)!,
+                    value: "9"
+                )
+            }
+            var left = HTTPFields()
+            left.append(contentsOf: lhs)
+            var right = HTTPFields()
+            right.append(contentsOf: rhs)
+            let expected = self.referenceEqual(lhs, rhs)
+            #expect((left == right) == expected)
+            #expect(HTTPFields.isEqualByNameIndex(left, right) == expected, "the fallback path disagrees")
+        }
+    }
+
+    /// Order within one name is part of the value; order across names is not.
+    @Test func equalityKnownAnswers() {
+        #expect(self.fields([("a", "1"), ("b", "x")]) == self.fields([("b", "x"), ("a", "1")]))
+        #expect(self.fields([("a", "1"), ("a", "2")]) != self.fields([("a", "2"), ("a", "1")]))
+        #expect(self.fields([("a", "1")]) != self.fields([("a", "1"), ("a", "1")]))
+        #expect(self.fields([("a", "1")]) != self.fields([("A", "2")]))
+        #expect(self.fields([("a", "1")]) == self.fields([("A", "1")]), "names compare canonically")
+        #expect(HTTPFields() == HTTPFields())
+        #expect(
+            self.fields([("a", "1"), ("b", "x"), ("a", "2")]) == self.fields([("a", "1"), ("a", "2"), ("b", "x")])
+        )
+    }
+
+    /// Every branch of `==` rests on one definition of field identity: the whole `HTTPField` value,
+    /// which is what `isEqualByNameIndex` compares and what `hash(into:)` combines. The lock-step
+    /// branch once compared only `name` and the lossy `value` String view, so it answered true for
+    /// fields every other branch called different, and `==` disagreed with itself and with the hash.
+    @Test func equalityComparesWholeFields() {
+        func indexed(_ strategy: HTTPField.DynamicTableIndexingStrategy) -> HTTPField {
+            var field = HTTPField(name: .accept, value: "1")
+            field.indexingStrategy = strategy
+            return field
+        }
+        let other = HTTPField(name: .acceptEncoding, value: "x")
+        let pairs: [(HTTPField, HTTPField)] = [
+            (indexed(.automatic), indexed(.disallow)),
+            // Distinct raw bytes whose lossy UTF-8 `value` view is the same replacement character.
+            (
+                HTTPField(name: .accept, value: [0xFE] as [UInt8]),
+                HTTPField(name: .accept, value: [0xFF] as [UInt8])
+            ),
+        ]
+
+        for (left, right) in pairs {
+            #expect(left != right, "the two fields differ as fields")
+
+            // Lock-step branch: the differing fields sit at the same index on both sides.
+            var lockStepLeft = HTTPFields()
+            lockStepLeft.append(left)
+            var lockStepRight = HTTPFields()
+            lockStepRight.append(right)
+            #expect(lockStepLeft != lockStepRight)
+            #expect(!HTTPFields.isEqualByNameIndex(lockStepLeft, lockStepRight))
+            #expect(!self.referenceEqual(Array(lockStepLeft), Array(lockStepRight)))
+
+            // Pending branch: a differently-named field is interleaved on one side only, which is
+            // the same pair of values reaching `==` by another route.
+            var interleavedLeft = HTTPFields()
+            interleavedLeft.append(contentsOf: [left, other])
+            var interleavedRight = HTTPFields()
+            interleavedRight.append(contentsOf: [other, right])
+            #expect(interleavedLeft != interleavedRight, "== must not disagree with itself on interleaving")
+
+            var set: Set<HTTPFields> = [lockStepLeft]
+            set.insert(lockStepRight)
+            #expect(set.count == 2)
+        }
+    }
+
+    // MARK: - Hashing
+
+    /// The Hashable contract: equal values hash equally. Reordering across names produces an equal
+    /// value, so it has to produce an equal hash.
+    @Test func hashHoldsUnderReordering() {
+        var generator = SystemRandomNumberGenerator()
+        var equalPairs = 0
+        for _ in 0..<1000 {
+            let lhs = self.randomFields(
+                count: Int.random(in: 2...6, using: &generator),
+                names: Self.names,
+                using: &generator
+            )
+            var left = HTTPFields()
+            left.append(contentsOf: lhs)
+            var right = HTTPFields()
+            right.append(contentsOf: lhs.shuffled(using: &generator))
+            if left == right {
+                equalPairs += 1
+                #expect(left.hashValue == right.hashValue)
+            }
+        }
+        #expect(equalPairs > 0, "the run produced no equal reordered pair, so it checked nothing")
+    }
+
+    /// Hashed collections must collapse equal values and separate unequal ones.
+    @Test func hashedCollectionsBehave() {
+        let a = self.fields([("a", "1"), ("b", "x"), ("a", "2")])
+        let b = self.fields([("a", "1"), ("a", "2"), ("b", "x")])
+        let c = self.fields([("a", "2"), ("a", "1"), ("b", "x")])
+
+        #expect(a == b)
+        #expect(a != c)
+
+        var set: Set<HTTPFields> = [a]
+        set.insert(b)
+        #expect(set.count == 1)
+        set.insert(c)
+        #expect(set.count == 2)
+        #expect(set.contains(b))
+    }
+
+    // MARK: - Literal, debug and Codable
+
+    @Test func literalDebugAndCodable() throws {
+        let literal: HTTPFields = [.accept: "1", .acceptEncoding: "x"]
+        #expect(self.rendered(literal) == "accept=1,accept-encoding=x")
+        let emptyLiteral: HTTPFields = [:]
+        #expect(emptyLiteral.isEmpty)
+
+        #expect(literal.debugDescription.contains("Accept: 1"))
+        #expect(literal.debugDescription.contains("Accept-Encoding: x"))
+
+        let fields = self.fields([("a", "1"), ("b", "x"), ("a", "2")])
+        let decoded = try JSONDecoder().decode(
+            HTTPFields.self,
+            from: try JSONEncoder().encode(fields)
+        )
+        #expect(decoded == fields)
+        #expect(self.rendered(decoded) == self.rendered(fields), "storage order survives the round trip")
+
+        // A pseudo header field is not a header field, and decoding one is rejected.
+        #expect(throws: DecodingError.self) {
+            try JSONDecoder().decode(HTTPFields.self, from: Data(#"[{"name":":method","value":"GET"}]"#.utf8))
+        }
+    }
+}
