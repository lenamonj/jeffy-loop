+import Foundation
+import HTTPTypes
+import Testing
+
+/// Known-answer checks for `HTTPRequest`: the method token, the pseudo header accessors, the
+/// copy-on-write storage behind them, and the value conformances.
+@Suite struct ProbeHTTPRequest {
+    private func request() -> HTTPRequest {
+        HTTPRequest(method: .get, scheme: "https", authority: "example.com", path: "/p")
+    }
+
+    /// A method is an RFC 9110 token, so the same character set that governs field names governs it.
+    @Test func methodAcceptsTokensAndRejectsTheRest() {
+        for valid in ["GET", "POST", "PATCH", "M-SEARCH", "a", "x!#$%&'*+-.^_`|~"] {
+            #expect(HTTPRequest.Method(valid)?.rawValue == valid)
+            #expect(HTTPRequest.Method(rawValue: valid)?.rawValue == valid)
+        }
+        for invalid in ["", "GET ", " GET", "GE T", "GET/1", "GET:", "caf\u{E9}"] {
+            #expect(HTTPRequest.Method(invalid) == nil, "\(invalid.debugDescription) is not a token")
+        }
+        #expect(HTTPRequest.Method("GET")!.description == "GET")
+        #expect(HTTPRequest.Method("get") != HTTPRequest.Method("GET"), "methods are case sensitive")
+    }
+
+    /// Each pseudo header accessor reads and writes exactly its own field, and the optional ones
+    /// remove the field when set to nil. Every accessor is exercised at two values plus nil.
+    @Test func pseudoAccessorsReadAndWriteTheirOwnField() {
+        var request = self.request()
+
+        request.method = .post
+        #expect(request.method == .post)
+        #expect(request.pseudoHeaderFields.method.value == "POST")
+        #expect(request.scheme == "https", "changing the method left the scheme alone")
+
+        for value in ["http", "wss"] {
+            request.scheme = value
+            #expect(request.scheme == value)
+            #expect(request.pseudoHeaderFields.scheme?.value == value)
+        }
+        request.scheme = nil
+        #expect(request.scheme == nil)
+        #expect(request.pseudoHeaderFields.scheme == nil)
+
+        for value in ["example.com", "example.com:8443"] {
+            request.authority = value
+            #expect(request.authority == value)
+        }
+        request.authority = nil
+        #expect(request.authority == nil)
+
+        for value in ["/", "/a/b?c=d"] {
+            request.path = value
+            #expect(request.path == value)
+        }
+        request.path = nil
+        #expect(request.path == nil)
+
+        #expect(request.extendedConnectProtocol == nil)
+        for value in ["websocket", "connect-udp"] {
+            request.extendedConnectProtocol = value
+            #expect(request.extendedConnectProtocol == value)
+        }
+        request.extendedConnectProtocol = nil
+        #expect(request.extendedConnectProtocol == nil)
+
+        // Pseudo header values are legalized like any other field value.
+        request.authority = "exam\u{0}ple.com"
+        #expect(request.authority == "exam ple.com")
+    }
+
+    /// The pseudo header fields sit behind a reference-counted box, so a copy that is mutated must
+    /// not reach back into the value it was copied from.
+    @Test func pseudoHeaderFieldsAreCopyOnWrite() {
+        let original = self.request()
+
+        var copy = original
+        copy.scheme = "http"
+        copy.authority = "other.example"
+        copy.path = "/changed"
+        copy.method = .put
+        copy.extendedConnectProtocol = "websocket"
+
+        #expect(original.scheme == "https")
+        #expect(original.authority == "example.com")
+        #expect(original.path == "/p")
+        #expect(original.method == .get)
+        #expect(original.extendedConnectProtocol == nil)
+
+        #expect(copy.scheme == "http")
+        #expect(copy != original)
+
+        // The same through the underlying field type.
+        var viaFields = original
+        viaFields.pseudoHeaderFields.scheme = HTTPField(name: viaFields.pseudoHeaderFields.scheme!.name, value: "ftp")
+        #expect(original.scheme == "https")
+        #expect(viaFields.scheme == "ftp")
+    }
+
+    /// Equality and hashing cover the pseudo header fields and the header fields together.
+    @Test func requestEqualityCoversBothHalves() {
+        let base = self.request()
+        #expect(base == self.request())
+        #expect(base.hashValue == self.request().hashValue)
+
+        var differentPath = self.request()
+        differentPath.path = "/other"
+        #expect(differentPath != base)
+
+        var withHeaders = self.request()
+        withHeaders.headerFields[.accept] = "*/*"
+        #expect(withHeaders != base)
+
+        var sameHeadersOtherOrder = HTTPRequest(
+            method: .get,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [.accept: "*/*", .acceptEncoding: "gzip"]
+        )
+        let interleaved = HTTPRequest(
+            method: .get,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [.acceptEncoding: "gzip", .accept: "*/*"]
+        )
+        #expect(sameHeadersOtherOrder == interleaved)
+        #expect(sameHeadersOtherOrder.hashValue == interleaved.hashValue)
+        sameHeadersOtherOrder.method = .head
+        #expect(sameHeadersOtherOrder != interleaved)
+    }
+
+    @Test func requestDebugAndCodable() throws {
+        let request = HTTPRequest(
+            method: .get,
+            scheme: "https",
+            authority: "example.com",
+            path: "/p",
+            headerFields: [.accept: "*/*"]
+        )
+        #expect(request.debugDescription == "(GET) https://example.com/p")
+
+        var noScheme = request
+        noScheme.scheme = nil
+        #expect(noScheme.debugDescription == "(GET) example.com/p")
+
+        let decoded = try JSONDecoder().decode(
+            HTTPRequest.self,
+            from: try JSONEncoder().encode(request)
+        )
+        #expect(decoded == request)
+        #expect(decoded.headerFields[.accept] == "*/*")
+        #expect(decoded.extendedConnectProtocol == nil)
+
+        var extended = request
+        extended.method = .connect
+        extended.extendedConnectProtocol = "websocket"
+        let decodedExtended = try JSONDecoder().decode(
+            HTTPRequest.self,
+            from: try JSONEncoder().encode(extended)
+        )
+        #expect(decodedExtended == extended)
+        #expect(decodedExtended.extendedConnectProtocol == "websocket")
+    }
+}
+
+/// Known-answer checks for `HTTPResponse`: the status code, its kind classification, reason-phrase
+/// legalization, and the value conformances.
+@Suite struct ProbeHTTPResponse {
+    /// `kind` partitions the code space at every hundred boundary, and everything outside
+    /// 100...599 is invalid. Both sides of each boundary are checked.
+    @Test func kindPartitionsAtEveryBoundary() {
+        let expected: [(Int, String)] = [
+            (0, "invalid"), (99, "invalid"),
+            (100, "informational"), (199, "informational"),
+            (200, "successful"), (299, "successful"),
+            (300, "redirection"), (399, "redirection"),
+            (400, "clientError"), (499, "clientError"),
+            (500, "serverError"), (599, "serverError"),
+            (600, "invalid"), (999, "invalid"),
+        ]
+        for (code, kind) in expected {
+            #expect("\(HTTPResponse.Status(code: code).kind)" == kind, "\(code) should be \(kind)")
+        }
+    }
+
+    /// The reason phrase admits the same bytes a field value admits, minus the edge rule, and
+    /// anything else - including scalars past ISO Latin 1 - becomes a space.
+    @Test func reasonPhraseIsLegalized() {
+        let cases: [(String, String)] = [
+            ("OK", "OK"),
+            ("", ""),
+            ("Not Found", "Not Found"),
+            (" leading and trailing ", " leading and trailing "),
+            ("a\u{0}b", "a b"),
+            ("a\nb", "a b"),
+            ("a\u{7F}b", "a b"),
+            ("caf\u{E9}", "caf\u{E9}"),
+            ("tab\tseparated", "tab\tseparated"),
+            ("emoji \u{1F600}", "emoji  "),
+            ("\u{4F60}\u{597D}", "  "),
+            ("\u{FF}", "\u{FF}"),
+            ("\u{100}", " "),
+        ]
+        for (input, expected) in cases {
+            #expect(
+                HTTPResponse.Status(code: 200, reasonPhrase: input).reasonPhrase == expected,
+                "reason phrase \(input.debugDescription)"
+            )
+        }
+        #expect(HTTPResponse.Status(code: 404, reasonPhrase: "Not Found").description == "404 Not Found")
+
+        // Legalization must not depend on what else is in the phrase. The same scalar has to get
+        // the same treatment whether or not another byte forces the slower path.
+        for scalar in ["\u{1F600}", "\u{4F60}", "\u{100}"] {
+            let alone = HTTPResponse.Status(code: 200, reasonPhrase: "a\(scalar)b").reasonPhrase
+            let forced = HTTPResponse.Status(code: 200, reasonPhrase: "a\u{0}\(scalar)b").reasonPhrase
+            #expect(alone == "a b", "\(scalar.debugDescription) alone")
+            #expect(forced == "a  b", "\(scalar.debugDescription) beside a control byte")
+        }
+
+        // Everything a legalized phrase holds is representable in ISO Latin 1, which is the
+        // encoding the type documents for serializing it.
+        for input in ["emoji \u{1F600}", "\u{4F60}\u{597D}", "caf\u{E9}", "a\u{0}b", ""] {
+            let legalized = HTTPResponse.Status(code: 200, reasonPhrase: input).reasonPhrase
+            #expect(legalized.unicodeScalars.allSatisfy { $0.value <= 0xFF }, "\(input.debugDescription)")
+        }
+    }
+
+    /// Whatever the initializer produces has to decode again, and a payload carrying a scalar the
+    /// initializer would have replaced is rejected rather than smuggled past it.
+    @Test func codableAgreesWithLegalization() throws {
+        for input in ["OK", "caf\u{E9}", "emoji \u{1F600}", "\u{4F60}\u{597D}", "a\u{0}b", ""] {
+            let response = HTTPResponse(status: .init(code: 200, reasonPhrase: input))
+            let decoded = try JSONDecoder().decode(
+                HTTPResponse.self,
+                from: try JSONEncoder().encode(response)
+            )
+            #expect(decoded.status.reasonPhrase == response.status.reasonPhrase, "\(input.debugDescription)")
+        }
+
+        // The shape is the encoder's own, copied from a real encoding, so the decode fails on the
+        // reason phrase rather than on a key it could not find.
+        let valid = #"{"headerFields":[],"reasonPhrase":"OK","pseudoHeaderFields":[{"name":":status","value":"200"}]}"#
+        #expect(throws: Never.self) {
+            try JSONDecoder().decode(HTTPResponse.self, from: Data(valid.utf8))
+        }
+
+        let smuggled = valid.replacingOccurrences(of: #""OK""#, with: #""emoji \#u{1F600}""#)
+        #expect(smuggled != valid, "the substitution has to have happened")
+        #expect(throws: (any Error).self) {
+            try JSONDecoder().decode(HTTPResponse.self, from: Data(smuggled.utf8))
+        }
+    }
+
+    /// Two statuses with the same code are the same status whatever their reason phrases say, which
+    /// is what lets a response compare equal across HTTP versions that drop the phrase.
+    @Test func statusComparesByCodeAlone() {
+        let ok = HTTPResponse.Status(code: 200, reasonPhrase: "OK")
+        let fine = HTTPResponse.Status(code: 200, reasonPhrase: "Fine")
+        #expect(ok == fine)
+        #expect(ok.hashValue == fine.hashValue)
+        #expect(ok != HTTPResponse.Status(code: 201))
+
+        let literal: HTTPResponse.Status = 204
+        #expect(literal.code == 204)
+        #expect(literal.reasonPhrase == "")
+        #expect(literal == HTTPResponse.Status(code: 204, reasonPhrase: "No Content"))
+    }
+
+    /// The status is stored in the ":status" pseudo header field as exactly three digits, so codes
+    /// below 100 keep their leading zeros and survive a round trip.
+    @Test func statusRoundTripsThroughThePseudoField() throws {
+        for code in [0, 7, 99, 100, 200, 404, 599, 999] {
+            var response = HTTPResponse(status: .init(code: code, reasonPhrase: "phrase"))
+            #expect(response.status.code == code)
+            #expect(response.pseudoHeaderFields.status.value.count == 3, "the field value is always three digits")
+
+            response.status = .init(code: 302, reasonPhrase: "Found")
+            #expect(response.status.code == 302)
+            #expect(response.status.reasonPhrase == "Found")
+            #expect(response.pseudoHeaderFields.status.value == "302")
+        }
+    }
+
+    @Test func responseEqualityDebugAndCodable() throws {
+        let response = HTTPResponse(status: .ok, headerFields: [.contentType: "text/plain"])
+        #expect(response == HTTPResponse(status: 200, headerFields: [.contentType: "text/plain"]))
+        #expect(response != HTTPResponse(status: .created, headerFields: [.contentType: "text/plain"]))
+        #expect(response != HTTPResponse(status: .ok))
+        #expect(response.debugDescription == "200 OK", "the response renders as its status")
+        #expect(HTTPResponse(status: .init(code: 200)).debugDescription == "200 ")
+
+        let decoded = try JSONDecoder().decode(
+            HTTPResponse.self,
+            from: try JSONEncoder().encode(response)
+        )
+        #expect(decoded == response)
+        #expect(decoded.headerFields[.contentType] == "text/plain")
+
+        // The reason phrase rides the encoding even though it is outside equality.
+        let phrased = HTTPResponse(status: .init(code: 404, reasonPhrase: "Not Found"))
+        let decodedPhrase = try JSONDecoder().decode(
+            HTTPResponse.self,
+            from: try JSONEncoder().encode(phrased)
+        )
+        #expect(decodedPhrase.status.reasonPhrase == "Not Found")
+    }
+
+    /// Copy-on-write for the response's pseudo header storage, the same box `HTTPRequest` uses.
+    @Test func responsePseudoHeaderFieldsAreCopyOnWrite() {
+        let original = HTTPResponse(status: .ok)
+        var copy = original
+        copy.status = .notFound
+        #expect(original.status == .ok)
+        #expect(copy.status == .notFound)
+    }
+}
