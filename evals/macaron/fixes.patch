+@pytest.mark.parametrize("enabled", [True, False])
+def test_jfrog_maven_honours_enabled_argument(enabled: bool) -> None:
+    """Test that ``JFrogMavenRegistry`` keeps the ``enabled`` value it was constructed with."""
+    assert JFrogMavenRegistry(enabled=enabled).enabled is enabled
+
+
+@pytest.mark.parametrize("enabled", [True, False])
+def test_npm_honours_enabled_argument(enabled: bool) -> None:
+    """Test that ``NPMRegistry`` keeps the ``enabled`` value it was constructed with."""
+    assert NPMRegistry(enabled=enabled).enabled is enabled
+
+
+@pytest.mark.parametrize("enabled", [True, False])
+def test_pypi_honours_enabled_argument(enabled: bool) -> None:
+    """Test that ``PyPIRegistry`` keeps the ``enabled`` value it was constructed with."""
+    assert PyPIRegistry(enabled=enabled).enabled is enabled
+
+
+def test_maven_central_defaults_to_enabled() -> None:
+    """Test that a registry taking no ``enabled`` argument keeps the base class default."""
+    assert MavenCentralRegistry().enabled is True
+
+
+def test_jfrog_maven_stays_disabled_without_config() -> None:
+    """Test that the JFrog registry stays disabled when its .ini section is absent.
+
+    The shipped ``defaults.ini`` comments out ``[package_registry.jfrog.maven]``, so
+    ``load_defaults`` returns before enabling the registry. A registry left enabled here
+    has an empty hostname and makes the provenance finder attempt a request against an
+    invalid URL instead of taking its "not enabled" path.
+    """
+    jfrog_maven = JFrogMavenRegistry()
+    jfrog_maven.load_defaults()
+    assert jfrog_maven.hostname == ""
+    assert jfrog_maven.enabled is False
+
+
+def test_jfrog_maven_enabled_by_config(tmp_path: Path) -> None:
+    """Test that the JFrog registry is enabled once its .ini section configures it."""
