+# Copyright (c) 2026 - 2026, Oracle and/or its affiliates. All rights reserved.
+# Licensed under the Universal Permissive License v 1.0 as shown at https://oss.oracle.com/licenses/upl/.
+
+"""This module tests the archive extraction used by the provenance verifier."""
+
+import io
+import tarfile
+import zipfile
+from pathlib import Path
+
+import pytest
+
+from macaron.provenance.provenance_verifier import _extract_archive
+
+
+def _write_symlink_escape_archive(archive_path: Path, link_target: Path) -> None:
+    """Write a tar whose member names hold no leading slash and no parent reference.
+
+    The archive plants a symlink to ``link_target`` and then writes a file through it, which
+    is how an archive escapes its destination without a name a prefix check can reject.
+    """
+    with tarfile.open(archive_path, "w:gz") as tar:
+        link = tarfile.TarInfo("pkg/escape")
+        link.type = tarfile.SYMTYPE
+        link.linkname = str(link_target)
+        tar.addfile(link)
+        payload = b"pwned\n"
+        member = tarfile.TarInfo("pkg/escape/payload.txt")
+        member.size = len(payload)
+        tar.addfile(member, io.BytesIO(payload))
+
+
+def test_extract_archive_blocks_symlink_escape(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """A symlink member must not let an archive write outside the destination directory.
+
+    The extraction filter is pinned to ``fully_trusted``, which is the tarfile default on every
+    interpreter below Python 3.14 and therefore on interpreters ``requires-python >=3.11.14``
+    admits. Extraction must be safe because of what this module asks for, not because of what
+    the running interpreter happens to default to.
+    """
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    destination = tmp_path / "destination"
+    destination.mkdir()
+    archive = tmp_path / "escape.tar.gz"
+    _write_symlink_escape_archive(archive, outside)
+
+    monkeypatch.setattr(tarfile.TarFile, "extraction_filter", staticmethod(tarfile.fully_trusted_filter))
+
+    _extract_archive(file_path=str(archive), temp_path=str(destination))
+
+    assert not (outside / "payload.txt").exists()
+
+
+def test_extract_archive_extracts_ordinary_tar(tmp_path: Path) -> None:
+    """An archive with ordinary members is still extracted, so the guard above is not a blanket refusal."""
+    destination = tmp_path / "destination"
+    destination.mkdir()
+    archive = tmp_path / "plain.tar.gz"
+    with tarfile.open(archive, "w:gz") as tar:
+        payload = b"contents\n"
+        member = tarfile.TarInfo("pkg/file.txt")
+        member.size = len(payload)
+        tar.addfile(member, io.BytesIO(payload))
+
+    assert _extract_archive(file_path=str(archive), temp_path=str(destination))
+    assert (destination / "pkg" / "file.txt").read_bytes() == b"contents\n"
+
+
+def test_extract_archive_extracts_ordinary_zip(tmp_path: Path) -> None:
+    """The zip branch still extracts ordinary members."""
+    destination = tmp_path / "destination"
+    destination.mkdir()
+    archive = tmp_path / "plain.zip"
+    with zipfile.ZipFile(archive, "w") as zip_file:
+        zip_file.writestr("pkg/file.txt", "contents\n")
+
+    assert _extract_archive(file_path=str(archive), temp_path=str(destination))
+    assert (destination / "pkg" / "file.txt").read_text(encoding="utf-8") == "contents\n"
