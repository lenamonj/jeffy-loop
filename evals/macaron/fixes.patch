+def test_pick_specific_version_selects_the_earliest_acceptable_minor(
+    monkeypatch: pytest.MonkeyPatch, inferred_constraints: list[str], expected_minor: int
+) -> None:
+    """Test which interpreter version the constraints resolve to.
+
+    The patch component comes from python.org, so it is supplied here instead: what is
+    being graded is which minor version the function asks for, not what the lookup returns.
+    The floor is 3.8, so constraints admitting anything older still resolve to 3.8.
+    """
+    asked: list[tuple[int, int]] = []
+
+    def fake_latest_patch(major: int, minor: int) -> str:
