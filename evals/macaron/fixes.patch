+def test_find_highest_git_tag_aliases_are_stable(tags: set[str], expected: str) -> None:
+    """Test that tags parsing to one version resolve to the same tag every time.
+
+    The search advances only on a strict greater-than, so before the tags were sorted the
+    answer was whichever alias the set happened to yield first, and set iteration order over
+    strings varies with the interpreter's hash seed.
+    """
+    assert find_highest_git_tag(tags) == expected
