+@pytest.fixture(name="fresh_db_manager")
+def fresh_db_manager_() -> Iterator[None]:
+    """Clear the memoized database manager around a test, disposing its engine first.
+
+    ``get_db_manager`` is decorated with ``cache_return``, so without this a test that
+    points ``global_config.output_path`` somewhere new still receives the manager an
+    earlier test built.
+
+    Clearing the memo alone drops the manager while its sqlite connection is still open,
+    leaving the garbage collector to finalize it at an arbitrary later point; under the
+    project's ``filterwarnings = error`` the resulting ``ResourceWarning`` surfaces as a
+    ``PytestUnraisableExceptionWarning`` against whichever test is running then, so the
+    module exits 1 while reporting every test as passed. ``tests/database`` disposes its
+    own manager the same way.
+    """
+    get_db_manager.clear()
+    yield
+    # Only dispose what was actually built: reading the memo directly avoids constructing
+    # a manager here, which would create a database file for a test that never wanted one.
+    manager = getattr(get_db_manager, "return_value", None)
+    if manager is not None:
+        manager.engine.dispose()
+    get_db_manager.clear()
+
