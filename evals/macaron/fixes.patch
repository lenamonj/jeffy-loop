+                "    <artifactId>root</artifactId>",
+                "    <version>1.0</version>",
+                f"    {relative_elem}",
+                "  </parent>",
+                "  <artifactId>mod</artifactId>",
+                "</project>",
+            ]
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    return module_pom
+
+
+@pytest.mark.parametrize(
+    ("relative_path", "expected"),
+    [
+        # relativePath naming the parent POM file itself, which is Maven's own default spelling.
+        ("../pom.xml", "pom.xml"),
+        # relativePath naming the directory that holds it.
+        ("../", "pom.xml"),
+        ("..", "pom.xml"),
+        # relativePath absent, so Maven's default applies.
+        (None, "pom.xml"),
+        # Neither form resolves to a file that exists.
+        ("../nope.xml", None),
+        ("../nope/", None),
+    ],
+)
+def test_detect_parent_pom_relative_path_forms(
+    tmp_path: Path, relative_path: str | None, expected: str | None
+) -> None:
+    """Test that relativePath resolves whether it names the parent POM file or its directory."""
+    repo_root = tmp_path.joinpath("repo")
+    module_pom = _write_reactor(repo_root, relative_path)
+
+    assert detect_parent_pom(module_pom, repo_root) == expected
+    assert find_nearest_modules_pom(module_pom, repo_root) == expected
+
+
+def test_detect_parent_pom_named_parent_file(tmp_path: Path) -> None:
+    """Test a relativePath naming a parent POM that is not called pom.xml."""
+    repo_root = tmp_path.joinpath("repo")
+    module_pom = _write_reactor(repo_root, "../parent/custom-parent.xml")
+    parent_dir = repo_root.joinpath("parent")
+    parent_dir.mkdir(parents=True)
+    parent_dir.joinpath("custom-parent.xml").write_text(
+        "<project>\n  <modules><module>mod</module></modules>\n</project>\n", encoding="utf-8"
+    )
+
+    assert detect_parent_pom(module_pom, repo_root) == os.path.join("parent", "custom-parent.xml")
+
+
+def test_detect_parent_pom_outside_repo_root(tmp_path: Path) -> None:
+    """Test that a parent POM outside repo_root is refused."""
+    repo_root = tmp_path.joinpath("repo")
+    module_pom = _write_reactor(repo_root, "../pom.xml")
+
+    # The module directory is the repo root here, so the parent resolves outside it.
+    assert detect_parent_pom(module_pom, module_pom.parent) is None
