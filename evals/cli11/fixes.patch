diff --git a/tests/NumericTypeTest.cpp b/tests/NumericTypeTest.cpp
index d0c5249..e7be391 100644
--- a/tests/NumericTypeTest.cpp
+++ b/tests/NumericTypeTest.cpp
@@ -191,6 +191,54 @@ TEST_CASE_METHOD(TApp, "intConversions", "[optiontype]") {
     CHECK(val == test_data.second);
 }
 
+TEST_CASE_METHOD(TApp, "intConversionsPrefixWithNoDigits", "[optiontype]") {
+
+    // A base prefix with no digits after it must be rejected, the way 0x with no
+    // digits already is. strtoll consumes nothing there and leaves its end
+    // pointer at the start of the digit region, which for these inputs is also
+    // one-past-the-end, so an end-of-input check on its own reports a successful
+    // conversion to zero.
+    std::int64_t val{-1};
+    app.add_option("--val", val);
+
+    for(const char *prefix_only : {"0b", "0B", "0o", "0O", "0x", "0X"}) {
+        args = {"--val", prefix_only};
+        CHECK_THROWS_AS(run(), CLI::ParseError);
+    }
+
+    // The same prefixes with digits still convert, including with separators.
+    args = {"--val", "0b1011"};
+    run();
+    CHECK(val == 11);
+
+    args = {"--val", "0o17"};
+    run();
+    CHECK(val == 15);
+
+    args = {"--val", "0x1f"};
+    run();
+    CHECK(val == 31);
+}
+
+TEST_CASE_METHOD(TApp, "uintConversionsPrefixWithNoDigits", "[optiontype]") {
+
+    std::uint64_t val{99};
+    app.add_option("--val", val);
+
+    for(const char *prefix_only : {"0b", "0B", "0o", "0O", "0x", "0X"}) {
+        args = {"--val", prefix_only};
+        CHECK_THROWS_AS(run(), CLI::ParseError);
+    }
+
+    args = {"--val", "0b1011"};
+    run();
+    CHECK(val == 11U);
+
+    args = {"--val", "0o17"};
+    run();
+    CHECK(val == 15U);
+}
