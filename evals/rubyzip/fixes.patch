+      assert_equal(1327, zf.find_entry('file1.txt').get_input_stream(&:read).bytesize)
+    end
+  end
+
+  # A failed extraction must leave the destination as it found it: writing
+  # straight to it truncates whatever was there before the first byte is read.
+  def test_failed_extraction_leaves_an_existing_file_intact
