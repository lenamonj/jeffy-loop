+    end
+  end
+
+  # The half of the boundary that is not an error at all: a destination that
+  # exists but is not a directory never reaches the write, because containment
+  # resolves it first and refuses. Both rdocs say so; this pins it.
+  def test_destination_that_is_a_file_is_refused_without_raising
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('a.txt')
+      zos.write('body')
+    end
