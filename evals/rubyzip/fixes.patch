+      assert_equal('NOT OURS', ::File.read(taken))
+    end
+  end
+
+  # Extraction over an existing file replaces it rather than rewriting it, so
+  # the file that was there is unlinked and another name for it keeps the
+  # contents it had. The rdoc on `Entry#extract` says so; this pins it.
+  def test_extraction_over_an_existing_file_replaces_it
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('a.txt')
+      zos.write('NEW')
+    end
