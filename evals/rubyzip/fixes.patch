@@ -22,6 +23,337 @@ class ZipFileExtractTest < Minitest::Test
     ::Zip.reset!
   end
 
+  # Writes a one-entry archive whose stored name is exactly +name+, including
+  # names the writer itself would refuse. The entry is written under a
+  # placeholder of the same byte length and the name bytes are replaced in
+  # place, at the offsets the APPNOTE fixes, so the recorded lengths stay true.
+  def archive_named(name)
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('x' * name.bytesize)
+      zos.write('body')
+    end
+    bytes = buffer.string.b
+    [[bytes.index("PK\x03\x04".b), 26, 30], [bytes.index("PK\x01\x02".b), 28, 46]].each do |record, len_at, name_at|
+      length = bytes[record + len_at, 2].unpack1('v')
+      bytes[record + name_at, length] = name.b
+    end
+    bytes
+  end
+
+  def test_extract_name_the_filesystem_rejects_raises_a_zip_error
+    [
+      ['null byte in the name', "ev\0il.txt"],
+      ['name too long for a component', 'n' * 304],
+      ['parent already exists as a file', 'blocker/inner.txt']
+    ].each do |label, name|
+      ::Dir.mktmpdir do |dir|
+        ::FileUtils.touch(::File.join(dir, 'blocker'))
+
+        error = assert_raises(::Zip::ExtractionError, label) do
+          ::Zip::File.open_buffer(::StringIO.new(archive_named(name))) do |zf|
+            zf.each { |entry| entry.extract(entry.name, destination_directory: dir) }
+          end
+        end
+
+        assert_includes error.message, name, label
+      end
+    end
+  end
+
+  # An entry the central directory declares, whose local header is not where it
+  # says it is, must fail loudly: reading it as an empty payload extracts a
+  # zero-byte file over a name the archive said had content.
+  def archive_with_first_local_offset(offset)
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('a.txt')
+      zos.write('body of a.txt')
+    end
+    bytes = buffer.string.b
+    at = bytes.index([0x02014b50].pack('V')) + 42
+    bytes[at, 4] = [offset].pack('V')
+    bytes
+  end
+
+  def test_entry_whose_local_header_is_missing_raises_rather_than_reading_empty
+    ::Dir.mktmpdir do |dir|
+      error = assert_raises(::Zip::Error) do
+        ::Zip::File.open_buffer(::StringIO.new(archive_with_first_local_offset(0xFFFFFF00))) do |zf|
+          zf.each { |entry| entry.extract(entry.name, destination_directory: dir) }
+        end
+      end
+
+      assert_match(/no local header for entry 'a.txt'/, error.message)
+    end
+  end
+
+  def test_entry_whose_local_header_is_missing_raises_from_get_input_stream
+    ::Zip.validate_entry_sizes = false
