+      ::File.link(dest, link)
+      before = ::File.stat(dest).ino
+
+      ::Zip::File.open_buffer(::StringIO.new(buffer.string.dup)) do |zf|
+        zf.each { |entry| entry.extract(entry.name, destination_directory: dir) { true } }
+      end
