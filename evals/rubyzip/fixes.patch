+
+  # A local header truncated inside its name read nil and normalised it, so a
+  # NoMethodError reached a caller who had written `rescue Zip::Error`. The
+  # parse now fails as an archive fault, and the sequential reader passes that
+  # fault on rather than ending the read: the bytes at the position are a local
+  # entry signature, so the archive declared an entry it cannot deliver.
+  def truncated_local_header
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('a.txt')
+      zos.write('body')
+    end
+    buffer.string.b[0, 30]
+  end
+
+  def test_local_header_truncated_inside_its_name_is_an_archive_fault
+    error = assert_raises(::Zip::Error) do
+      ::Zip::Entry.new('x').read_local_entry(::StringIO.new(truncated_local_header))
+    end
+
+    assert_match(/Truncated local zip entry header/, error.message)
+  end
+
+  def test_truncated_local_header_is_raised_by_the_sequential_reader
+    error = assert_raises(::Zip::Error) do
+      ::Zip::InputStream.open(::StringIO.new(truncated_local_header)) do |is|
+        is.read while is.get_next_entry
+      end
+    end
+
+    assert_match(/local entry header at offset 0 could not be read/, error.message)
+  end
+
+  # An unreadable header partway through an archive is the same fault, and the
+  # entries read before it are not a reason to swallow it: a caller rejecting
+  # malformed archives with `rescue Zip::Error` must not receive a truncated
+  # entry list as if the archive had simply ended.
+  def test_unreadable_local_header_mid_archive_is_raised_after_the_entries_read
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('one.txt')
+      zos.write('one')
+      zos.put_next_entry('two.txt')
+      zos.write('two')
+    end
+    bytes = buffer.string.b
+    second = bytes.index("PK\x03\x04".b, 1)
+    bytes[second + 26, 2] = [0xFFF0].pack('v') # name longer than the archive
+
+    names = []
+    error = assert_raises(::Zip::Error) do
+      ::Zip::InputStream.open(::StringIO.new(bytes)) do |is|
+        while (entry = is.get_next_entry)
+          names << entry.name
+          is.read
+        end
+      end
+    end
+
+    assert_equal(['one.txt'], names)
+    assert_match(/local entry header at offset #{second} could not be read/, error.message)
+  end
 end
