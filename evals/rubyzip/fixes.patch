+  # A two-entry archive whose first central directory record declares an AES
+  # vendor version rubyzip does not support, so reading that record fails and
+  # the read stops with fewer entries than the directory declares.
+  def archive_with_an_unreadable_cdir_record
+    fmt = 'VCCvvvvvVVVvvvvvVV'
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |os|
+      os.put_next_entry('a.txt')
+      os.write('aaaa')
+      os.put_next_entry('b.txt')
+      os.write('bbbb')
+    end
+    bytes = buffer.string.dup
+
+    first = bytes.index([0x02014b50].pack('V'))
+    header = bytes[first, 46].unpack(fmt)
+    name = bytes[first + 46, header[11]]
+    aes = [0x9901, 7, 9, 'AE', 1, 8].pack('vvva2Cv')
+    header[12] = aes.bytesize
+    patched = bytes[0...first] + header.pack(fmt) + name + aes +
+              bytes[(first + 46 + header[11])..]
+
+    eocd = patched.rindex([0x06054b50].pack('V'))
+    fields = patched[eocd, 22].unpack('VvvvvVVv')
+    fields[5] = eocd - first
+    fields[6] = first
+    patched[0...eocd] + fields.pack('VvvvvVVv') + patched[(eocd + 22)..]
+  end
