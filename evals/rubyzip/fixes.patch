+      assert_raises(::Zip::Error) do
+        ::Zip::File.open_buffer(::StringIO.new(archive_with_first_local_offset(0xFFFFFF00))) do |zf|
+          zf.entries.first.get_input_stream(&:read)
+        end
+      end
+    end
+  end
+
+  # A local header parsing at the offset does not make it this entry's header:
+  # reading it anyway hands back another entry's bytes under this entry's name.
+  def test_entry_pointed_at_another_entrys_local_header_raises
+    buffer = ::StringIO.new
+    ::Zip::OutputStream.write_buffer(buffer) do |zos|
+      zos.put_next_entry('a.txt')
+      zos.write('AAAA-payload-a')
+      zos.put_next_entry('b.txt')
+      zos.write('BB-payload-b')
+    end
+    bytes = buffer.string.b
+    second = bytes.index([0x04034b50].pack('V'), 4)
+    at = bytes.index([0x02014b50].pack('V')) + 42
+    bytes[at, 4] = [second].pack('V')
+
+    error = assert_raises(::Zip::Error) do
+      ::Zip::File.open_buffer(::StringIO.new(bytes)) { |zf| zf.find_entry('a.txt').get_input_stream(&:read) }
+    end
+
