diff --git a/test/extra_field_test.rb b/test/extra_field_test.rb
index a8d245e..73645ba 100644
--- a/test/extra_field_test.rb
+++ b/test/extra_field_test.rb
@@ -172,4 +172,92 @@ class ZipExtraFieldTest < Minitest::Test
     refute(extra.member?(:zip64))
     assert_equal(1, extra.keys.size)
   end
+
+  # A header ID with its length word truncated away is not a well-formed field,
+  # whatever the ID names. It must be kept as unknown data rather than parsed
+  # as that type, and it must never escape as anything but a Zip::Error.
+  def test_truncated_length_word_is_not_parsed_as_its_header_id
+    ::Zip::ExtraField::ID_MAP.each do |id, klass|
+      [id, "#{id}\x00"].each do |truncated|
+        extra = ::Zip::ExtraField.new(truncated.dup.force_encoding('BINARY'))
+
+        refute(extra.member?(klass.name), "#{klass.name} parsed from a truncated length word")
+        assert_equal(truncated, extra[:unknown].to_c_dir_bin)
+      end
+    end
+  end
+
+  def test_truncated_length_word_after_a_valid_field
+    valid = "UT#{[5].pack('v')}#{[0b001, 1_700_000_000].pack('Cl<')}".b
+
+    ::Zip::ExtraField::ID_MAP.each_key do |id|
+      extra = ::Zip::ExtraField.new(valid + id)
+
+      assert(extra.member?(:universaltime), 'the valid field before the trailer was lost')
+      assert_equal(1_700_000_000, extra[:universaltime].mtime.to_i)
+      assert_equal(id, extra[:unknown].to_c_dir_bin)
+    end
+  end
+
+  # A field parsed from its central-directory form leaves the values that form
+  # does not carry unset. Packing an unset value used to raise TypeError out of
+  # any later write of the entry, which is not a Zip::Error and not catchable
+  # by a caller that rescues one.
+  def test_rewrite_archive_carrying_a_zero_length_unix_field
+    empty_length = [0].pack('v')
+
+    { 'UX' => :oldunix, 'Ux' => :iunix }.each do |id, name|
+      extra = "#{id}#{empty_length}".b
+      io = StringIO.new(archive_with_extra(extra))
+
+      ::Zip::File.open_buffer(io) do |zf|
+        assert(zf.entries.first.extra.member?(name))
+        zf.rename('a.txt', 'b.txt')
+      end
+
+      io.rewind
+      ::Zip::File.open_buffer(io) do |zf|
+        assert_equal(['b.txt'], zf.entries.map(&:name))
+        assert_equal('hello', zf.read('b.txt'))
+      end
+    end
+  end
+
+  # An entry whose extra field re-serialises to more bytes than the archive
+  # holds makes the rewritten local header longer than the original. Rewriting
+  # a buffer used to write that longer header over the entry data it had not
+  # copied out yet, so the archive came back holding shifted bytes.
+  def test_rewrite_buffer_when_the_local_header_grows
+    extra = "UT#{[0].pack('v')}".b
+    io = StringIO.new(archive_with_extra(extra))
+
+    ::Zip::File.open_buffer(io) { |zf| zf.rename('a.txt', 'b.txt') }
+
+    io.rewind
+    ::Zip::File.open_buffer(io) do |zf|
+      assert_equal(['b.txt'], zf.entries.map(&:name))
+      assert_equal('hello', zf.read('b.txt'))
+    end
+  end
+
+  private
+
+  # A one-entry stored archive whose entry carries `extra` in both its local
+  # header and its central directory record.
+  def archive_with_extra(extra)
+    name = 'a.txt'
+    data = 'hello'
+    crc = Zlib.crc32(data)
+    dos_time = 0x63d6 # 12:30:44
+    dos_date = 0x58cf # 2024-06-15
+    local = "PK\x03\x04".b +
+            [20, 0, 0, dos_time, dos_date, crc, data.bytesize, data.bytesize,
+             name.bytesize, extra.bytesize].pack('vvvvvVVVvv') + name + extra
+    body = local + data
+    cdir = "PK\x01\x02".b +
+           [20, 0, 20, 0, 0, dos_time, dos_date, crc, data.bytesize, data.bytesize,
+            name.bytesize, extra.bytesize, 0, 0, 0, 0, 0].pack('CCvvvvvVVVvvvvvVV') + name + extra
+    eocd = "PK\x05\x06".b + [0, 0, 1, 1, cdir.bytesize, body.bytesize, 0].pack('vvvvVVv')
+    body + cdir + eocd
+  end
 end
