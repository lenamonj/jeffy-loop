+      ::Kernel.srand(20_260_902)
+      taken = ::File.join(dir, ".rubyzip-#{::Process.pid}-#{rand(1 << 32).to_s(36)}")
+      ::File.write(taken, 'NOT OURS')
+
+      ::Kernel.srand(20_260_902)
+      assert_raises(::Zip::Error) do
+        ::Zip::File.open_buffer(::StringIO.new(buffer.string.dup)) do |zf|
+          zf.each { |entry| entry.extract(entry.name, destination_directory: dir) }
+        end
+      end
