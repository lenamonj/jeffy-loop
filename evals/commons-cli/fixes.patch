+    /**
+     * A Builder is a Supplier, so it may be reused. Handing the produced CommandLine the builder's
+     * own lists made every instance from one builder alias a single state, and made a later
+     * addition to the builder change an instance it had already produced.
+     */
+    @Test
+    void testBuilderReuseDoesNotAliasEarlierInstance() {
+        final CommandLine.Builder builder = CommandLine.builder();
+        builder.addOption(Option.builder("x").get()).addArg("one");
+        final CommandLine first = builder.get();
+        assertEquals(1, first.getOptions().length);
+        assertArrayEquals(new String[] {"one"}, first.getArgs());
+
+        builder.addOption(Option.builder("y").get()).addArg("two");
+        final CommandLine second = builder.get();
+
+        assertEquals(1, first.getOptions().length, "the earlier instance gained an option");
+        assertArrayEquals(new String[] {"one"}, first.getArgs(), "the earlier instance gained an argument");
+        assertEquals(2, second.getOptions().length);
+        assertArrayEquals(new String[] {"one", "two"}, second.getArgs());
+        assertNotSame(first.getArgList(), second.getArgList(), "two instances share one argument list");
+    }
+
+    /**
+     * The list copies {@code Builder.get()} makes are shallow, which is the boundary of the non-aliasing
+     * contract above: the instances hold the caller's own {@link Option} objects, so editing one of those
+     * options through its public setters is seen by every instance already holding it. The Javadoc once
+     * claimed two instances from one builder do not share state at all.
+     */
+    @Test
+    void testBuilderInstancesShareTheOptionObjectsAdded() {
+        final Option option = Option.builder("x").longOpt("xray").hasArg().get();
+        final CommandLine.Builder builder = CommandLine.builder();
+        builder.addOption(option);
+        final CommandLine first = builder.get();
+        final CommandLine second = builder.get();
+        assertTrue(first.hasOption("xray"));
+        assertTrue(second.hasOption("xray"));
+        assertSame(first.getOptions()[0], second.getOptions()[0], "the option object is not shared");
+
+        option.setLongOpt("zulu");
+
+        assertFalse(first.hasOption("xray"), "the earlier instance kept its own copy of the option");
+        assertFalse(second.hasOption("xray"), "the later instance kept its own copy of the option");
+        assertTrue(first.hasOption("zulu"));
+        assertTrue(second.hasOption("zulu"));
+    }
+
 }
