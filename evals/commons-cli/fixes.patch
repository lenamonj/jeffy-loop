+     * describes them. The Javadoc once promised {@code startPos+width} for a window holding no
+     * whitespace, where the chop is one short of the window.
+     */
+    @Test
+    void testIndexOfWrapDocumentedPositions() {
+        // a break character inside the window is the wrap point
+        assertEquals(5, TextHelpAppendable.indexOfWrap("alpha\nbetagamma", 10, 0));
+        assertEquals(5, TextHelpAppendable.indexOfWrap("alpha\tbetagamma", 10, 0));
+        // a window reaching the end of the text wraps at the end
+        assertEquals(14, TextHelpAppendable.indexOfWrap("alphabetagamma", 20, 0));
+        // otherwise the last whitespace after startPos and at or before startPos+width
+        assertEquals(5, TextHelpAppendable.indexOfWrap("alpha betagamma", 8, 0));
+        // no whitespace in the window: chopped one short of startPos+width
+        for (int width = 2; width <= 6; width++) {
+            assertEquals(width - 1, TextHelpAppendable.indexOfWrap("alphabetagamma", width, 0), "width " + width);
+            assertEquals(3 + width - 1, TextHelpAppendable.indexOfWrap("alphabetagamma", width, 3), "width " + width + " at 3");
+        }
+        // a width of 1 cannot chop one short without standing still, so it advances by one instead
+        assertEquals(1, TextHelpAppendable.indexOfWrap("alphabetagamma", 1, 0));
+        assertEquals(4, TextHelpAppendable.indexOfWrap("alphabetagamma", 1, 3));
+    }
+
+    /**
+     * The wrap position must always advance past the position it was given, or a caller looping on
+     * it never terminates.
+     */
+    @Test
+    void testIndexOfWrapAlwaysAdvances() {
+        final String text = "alphabetagammadelta";
+        for (int width = 1; width <= 6; width++) {
+            for (int startPos = 0; startPos < text.length() - 1; startPos++) {
+                assertEquals(true, TextHelpAppendable.indexOfWrap(text, width, startPos) > startPos,
+                        "width " + width + " startPos " + startPos);
+            }
+        }
+    }
+
 }
