+		name      string
+		arguments []Argument
+		expected  string
+	}{
+		{
+			name:      "any arguments",
+			arguments: AnyArguments,
+			expected:  "prog child [options] [arguments...]",
+		},
+		{
+			name:      "unnamed and required",
+			arguments: []Argument{&StringArgs{Min: 1, Max: -1}},
+			expected:  "prog child [options] arguments [arguments...]",
