+// A short flag group carries at most one value, and it belongs to the group's
+// last member. A value-taking flag anywhere else used to be dropped in silence.
+func TestParseShortOptionGroupValuePlacement(t *testing.T) {
+	newCmd := func() *Command {
+		cmd := buildMinimalTestCommand()
+		cmd.UseShortOptionHandling = true
+		cmd.Flags = []Flag{
+			&StringFlag{Name: "one", Aliases: []string{"o"}},
+			&BoolFlag{Name: "brief", Aliases: []string{"b"}},
+			&BoolFlag{Name: "check", Aliases: []string{"c"}},
+		}
+		return cmd
+	}
+
+	t.Run("value flag last takes the next argument", func(t *testing.T) {
+		cmd := newCmd()
+		require.NoError(t, cmd.Run(buildTestContext(t), []string{"foo", "-bo", "val"}))
+		assert.Equal(t, "val", cmd.String("one"))
+		assert.True(t, cmd.Bool("brief"))
+	})
+
+	t.Run("value flag not last is an error, not a silent drop", func(t *testing.T) {
+		cmd := newCmd()
+		err := cmd.Run(buildTestContext(t), []string{"foo", "-ob", "val"})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "only the last flag in the group")
+		assert.Empty(t, cmd.String("one"))
+	})
+
+	t.Run("equals value goes to the last member", func(t *testing.T) {
+		cmd := newCmd()
+		require.NoError(t, cmd.Run(buildTestContext(t), []string{"foo", "-bco=val"}))
+		assert.Equal(t, "val", cmd.String("one"))
+		assert.True(t, cmd.Bool("brief"))
+		assert.True(t, cmd.Bool("check"))
+	})
+
+	t.Run("an unknown member is reported as undefined", func(t *testing.T) {
+		cmd := newCmd()
+		err := cmd.Run(buildTestContext(t), []string{"foo", "-bzc"})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "flag provided but not defined: -bzc")
+	})
+
+	t.Run("a group that fails does not half-apply", func(t *testing.T) {
+		cmd := newCmd()
+		err := cmd.Run(buildTestContext(t), []string{"foo", "-bzc"})
+		require.Error(t, err)
+		assert.False(t, cmd.Bool("brief"))
+	})
+}
