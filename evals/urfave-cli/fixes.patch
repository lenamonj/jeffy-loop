+func Test_HelpFlag_ArgumentsNamedInUsage(t *testing.T) {
+	// A root command and a subcommand carrying the identical Arguments
+	// declaration must render those arguments the same way: by the usage each
+	// one reports, not by a generic placeholder on one and names on the other.
+	args := func() []Argument {
+		return []Argument{
+			&StringArg{Name: "SOURCE", Required: true},
+			&StringArg{Name: "DEST"},
+		}
+	}
+
+	for _, testCase := range []struct {
+		name     string
+		argv     []string
+		expected string
+	}{
+		{
+			name:     "root",
+			argv:     []string{"prog", "--help"},
+			expected: "prog [global options] [command [command options]] SOURCE [DEST]",
+		},
+		{
+			name:     "command",
+			argv:     []string{"prog", "child", "--help"},
+			expected: "prog child [options] SOURCE [DEST]",
+		},
+		{
+			name:     "subcommand with children",
+			argv:     []string{"prog", "parent", "--help"},
+			expected: "prog parent [command [command options]] SOURCE [DEST]",
+		},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			output := new(bytes.Buffer)
+			cmd := &Command{
+				Name:      "prog",
+				Arguments: args(),
+				Commands: []*Command{
+					{Name: "child", Arguments: args()},
+					{
+						Name:      "parent",
+						Arguments: args(),
+						Commands:  []*Command{{Name: "leaf"}},
+					},
+				},
+				Writer: output,
+			}
+
+			_ = cmd.Run(buildTestContext(t), testCase.argv)
+			assert.Contains(t, output.String(), testCase.expected)
+		})
+	}
+}
+
+func Test_HelpFlag_UnnamedArgumentsUsage(t *testing.T) {
+	// AnyArguments carries no name, so it renders the generic placeholder
+	// rather than formatting an empty name into the usage forms.
