+def test_cli_reports_a_bad_filter_range_without_a_traceback() -> None:
+    # The installed console script calls cli, not main, so a mistyped range
+    # has to come back as one line rather than as a stack trace.
+    with pytest.raises(SystemExit) as exc_info:
+        cli("-f", "10", "5", "a1")
+    assert str(exc_info.value) == "Error in --filter: low >= high"
+
+
+def test_cli_exits_quietly_on_keyboard_interrupt(mocker: MockerFixture) -> None:
+    mocker.patch("natsort.__main__.main", side_effect=KeyboardInterrupt)
