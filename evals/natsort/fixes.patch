index 0000000..90da67d
--- /dev/null
+++ b/tests/test_compat_locale.py
@@ -0,0 +1,70 @@
+"""\
+Test the locale compatibility layer.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+from typing import TYPE_CHECKING
+
+import pytest
+
+import natsort.compat.locale
+from natsort.compat.locale import get_strxfrm, null_string_locale_max
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+
+@pytest.fixture
+def icu_locale_module() -> Iterator[types.ModuleType]:
+    """
+    Load natsort/compat/locale.py with a stub "icu" module in place.
+
+    The PyICU half of that module is unreachable through a normal import
+    on a machine without PyICU, and importing natsort at all builds a real
+    collator at module scope. Loading the source file directly with a stub
+    in sys.modules is what lets the PyICU constants be checked anywhere.
+    """
+    saved = sys.modules.get("icu")
+    sys.modules["icu"] = types.ModuleType("icu")
+    spec = importlib.util.spec_from_file_location(
+        "_icu_locale",
+        natsort.compat.locale.__file__,
+    )
+    assert spec is not None
+    assert spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    try:
+        spec.loader.exec_module(module)
+        yield module
+    finally:
+        if saved is None:
+            del sys.modules["icu"]
+        else:
+            sys.modules["icu"] = saved
+
+
+def test_icu_null_string_locale_max_is_the_maximum_byte_string(
+    icu_locale_module: types.ModuleType,
+) -> None:
+    # The PyICU branch prepends this sentinel to numbers under
+    # ns.NUMAFTER | ns.LOCALE, so it has to sort after every sort key
+    # PyICU can return. It once held b"x7f" (three ASCII characters)
+    # rather than the maximum byte, which put numbers ahead of any
+    # string whose sort key began above byte 0x78.
+    assert icu_locale_module.null_string_locale_max > b"\xff" * 49
+    assert icu_locale_module.null_string_locale == b""
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a", "Z", "ä", "漢字", "Ω", "я", "~~~~~~", "￿"],
+)
+@pytest.mark.usefixtures("with_locale_en_us")
+def test_null_string_locale_max_sorts_after_any_transformed_input(
+    value: str,
+) -> None:
+    assert get_strxfrm()(value) < null_string_locale_max  # type: ignore[operator]
