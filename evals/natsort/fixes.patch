+def _coerce_to_path_like(v: Any) -> str | PurePath:  # noqa: ANN401
+    """
+    Return *v* unchanged when it is already path-like, else its `str` form.
+
+    Every `os_sort_keygen` branch collates path components, so anything that
+    is not already a path or a string has to become one first. Keeping that
+    rule in one place is what makes the three branches agree: they once did
+    not, and the same input sorted differently depending on whether PyICU
+    happened to be installed.
+    """
+    if isinstance(v, (str, PurePath)):
+        return v
+    return str(v)
