+
+
+@pytest.mark.parametrize("value", [None, 10, 1.5, True, ("a",), 4.3, float("nan")])
+def test_os_sort_keygen_coerces_non_string_input_to_str(value: object) -> None:
+    # os_sorted documents that it coerces every input to str before
+    # collating. The Windows and PyICU branches did that through
+    # _split_apply; the PyICU-absent branch did not, so the same input
+    # sorted differently depending on whether PyICU was installed.
+    key = natsort.os_sort_keygen()
+    assert key(value) == key(str(value))
+
+
+def test_os_sorted_orders_non_strings_as_their_str_form() -> None:
+    assert natsort.os_sorted([None, "a"]) == ["a", None]
+    assert natsort.os_sorted(["None", "a"]) == ["a", "None"]
+
+
+def test_os_sort_keygen_applies_its_key_before_coercing() -> None:
+    key = natsort.os_sort_keygen(key=lambda x: x[0])
+    assert key((10, "z")) == natsort.os_sort_keygen()("10")
