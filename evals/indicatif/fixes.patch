+    #[test]
+    fn max_ring_buf_holds_the_maximum_of_its_window() {
+        use crate::iter::MaxRingBuf;
+
+        // Rising input: the maximum is always the newest value.
+        let mut buf = MaxRingBuf::<4>::default();
+        for v in [3_u64, 7, 11, 15] {
+            buf.update(v);
+        }
+        assert_eq!(buf.max(), 15);
+
+        // Falling input: the maximum stays until the entry holding it is
+        // overwritten, then drops to the largest value still in the window.
+        let mut buf = MaxRingBuf::<4>::default();
+        for v in [100_u64, 40, 30, 20] {
+            buf.update(v);
+        }
+        assert_eq!(buf.max(), 100, "the peak is still inside the window");
+        buf.update(10);
+        assert_eq!(buf.max(), 40, "the peak was evicted; 40 is the new maximum");
+
+        // A repeated maximum survives one eviction of its duplicate.
+        let mut buf = MaxRingBuf::<4>::default();
+        for v in [50_u64, 50, 1, 1] {
+            buf.update(v);
+        }
+        assert_eq!(buf.max(), 50);
+        buf.update(0);
+        assert_eq!(buf.max(), 50, "the second 50 still holds the maximum");
+
+        // The window is exactly HISTORY wide, so a value HISTORY updates old
+        // is gone and one HISTORY-1 old is not.
+        let mut buf = MaxRingBuf::<4>::default();
+        buf.update(u64::MAX);
+        for _ in 0..3 {
+            buf.update(1);
+        }
+        assert_eq!(buf.max(), u64::MAX);
+        buf.update(1);
+        assert_eq!(buf.max(), 1);
+    }
+
+    #[test]
+    fn seek_max_holds_the_high_water_mark_only_after_a_seek() {
+        use crate::iter::SeekMax;
+
+        // With no seek recorded, sequential reads report the running total and
+        // nothing is remembered: this is the fast path for a plain stream.
+        let mut sm = SeekMax::<5, 10>::default();
+        assert_eq!(sm.update_seq(0, 10), 10);
+        assert_eq!(sm.update_seq(10, 5), 15);
+        assert_eq!(sm.update_seq(15, 0), 15);
+
+        // After a seek, the reported position is the high-water mark, so a
+        // backwards seek does not make the bar jump backwards.
+        let mut sm = SeekMax::<5, 10>::default();
+        assert_eq!(sm.update_seek(500), 500);
+        assert_eq!(sm.update_seek(100), 500, "a backward seek holds the peak");
+        assert_eq!(sm.update_seek(700), 700, "a forward seek raises it");
+
+        // Enough consecutive sequential operations drop the history again, and
+        // the position becomes the running total rather than the peak. RESET is
+        // 5 here, so the fifth sequential update after a seek clears it.
+        let mut sm = SeekMax::<5, 10>::default();
+        assert_eq!(sm.update_seek(900), 900);
+        let reported: Vec<u64> = (0..5_u64).map(|pos| sm.update_seq(pos, 1)).collect();
+        assert_eq!(
+            reported,
+            vec![900, 900, 900, 900, 5],
+            "history is dropped on the fifth sequential update"
+        );
+    }
