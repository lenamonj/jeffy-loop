+/// The sequential iterator a [`ProgressProducer`] hands to rayon for one split
+/// chunk.
+///
+/// Deliberately not [`ProgressBarIter`]: that type finishes the progress bar
+/// when its inner iterator runs out, which is right for a sequential wrap and
+/// wrong here, because for a producer "runs out" means the end of one split
+/// chunk rather than the end of the work. Finishing there set the position to
+/// the bar's full length partway through, and every later chunk then
+/// incremented on top of it, so a bar chained with a producer-driven combinator
+/// such as `zip` or `rev` reported both a position past its own length and
+/// `is_finished` while the work was still running.
+struct ProgressProducerIter<T> {
+    base: T,
+    progress: ProgressBar,
+}
+
+impl<T: Iterator> Iterator for ProgressProducerIter<T> {
+    type Item = T::Item;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let item = self.base.next();
+        if item.is_some() {
+            self.progress.inc(1);
+        }
+        item
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.base.size_hint()
+    }
+}
+
+impl<T: DoubleEndedIterator> DoubleEndedIterator for ProgressProducerIter<T> {
+    fn next_back(&mut self) -> Option<Self::Item> {
+        let item = self.base.next_back();
+        if item.is_some() {
+            self.progress.inc(1);
+        }
+        item
+    }
+}
+
+impl<T: ExactSizeIterator> ExactSizeIterator for ProgressProducerIter<T> {
+    fn len(&self) -> usize {
+        self.base.len()
+    }
+}
+
 impl<T, P: Producer<Item = T>> Producer for ProgressProducer<P> {
     type Item = T;
-    type IntoIter = ProgressBarIter<P::IntoIter>;
+    type IntoIter = ProgressProducerIter<P::IntoIter>;
 
