+// MARK: - Instrument identity tests
+
+struct TestMetricsIdentityTests {
+    @Test func repeatedDimensionNamesAreCarried() throws {
+        let metrics = TestMetrics()
+        let counter = Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "b")], factory: metrics)
+        counter.increment(by: 3)
+
+        #expect(try metrics.expectCounter("requests", [("tag", "a"), ("tag", "b")]).values == [3])
+        #expect(metrics.counters(label: "requests").count == 1)
+    }
+
+    @Test func repeatedDimensionNamesAreDistinguishedByValue() throws {
+        let metrics = TestMetrics()
+        Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "b")], factory: metrics).increment(by: 1)
+        Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "c")], factory: metrics).increment(by: 2)
+
+        #expect(metrics.counters(label: "requests").count == 2)
+        #expect(try metrics.expectCounter("requests", [("tag", "a"), ("tag", "b")]).values == [1])
+        #expect(try metrics.expectCounter("requests", [("tag", "a"), ("tag", "c")]).values == [2])
+    }
+
+    @Test func repeatedDimensionNamesCountedByMultiplicity() throws {
+        let metrics = TestMetrics()
+        Counter(label: "requests", dimensions: [("tag", "a")], factory: metrics).increment(by: 1)
+        Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "a")], factory: metrics).increment(by: 2)
+
+        #expect(metrics.counters(label: "requests").count == 2)
+    }
+
+    @Test func dimensionOrderDoesNotChangeIdentity() throws {
+        let metrics = TestMetrics()
+        Counter(label: "requests", dimensions: [("method", "GET"), ("status", "200")], factory: metrics)
+            .increment(by: 1)
+        Counter(label: "requests", dimensions: [("status", "200"), ("method", "GET")], factory: metrics)
+            .increment(by: 1)
+
+        #expect(metrics.counters(label: "requests").count == 1)
+        #expect(try metrics.expectCounter("requests", [("status", "200"), ("method", "GET")]).values == [1, 1])
+    }
+
+    @Test func repeatedDimensionNamesOnEveryInstrumentKind() throws {
+        let metrics = TestMetrics()
+        let dimensions = [("tag", "a"), ("tag", "b")]
+
+        Counter(label: "c", dimensions: dimensions, factory: metrics).increment()
+        Meter(label: "m", dimensions: dimensions, factory: metrics).set(4)
+        Recorder(label: "r", dimensions: dimensions, factory: metrics).record(5)
+        Timer(label: "t", dimensions: dimensions, factory: metrics).recordNanoseconds(6)
+
+        #expect(try metrics.expectCounter("c", dimensions).values == [1])
+        #expect(try metrics.expectMeter("m", dimensions).values == [4])
+        #expect(try metrics.expectRecorder("r", dimensions).values == [5])
+        #expect(try metrics.expectTimer("t", dimensions).values == [6])
+    }
+
+    @Test func repeatedDimensionNamesSurviveDestroyAndReset() throws {
+        let metrics = TestMetrics()
+        let counter = Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "b")], factory: metrics)
+        counter.increment()
+        #expect(metrics.counters(label: "requests").count == 1)
+
+        counter.destroy()
+        #expect(metrics.counters(label: "requests").isEmpty)
+
+        Counter(label: "requests", dimensions: [("tag", "a"), ("tag", "b")], factory: metrics).increment()
+        metrics.reset()
