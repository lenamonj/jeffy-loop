diff --git a/Sources/Metrics/Metrics.swift b/Sources/Metrics/Metrics.swift
index c2514f0..03da4e2 100644
--- a/Sources/Metrics/Metrics.swift
+++ b/Sources/Metrics/Metrics.swift
@@ -77,10 +77,18 @@ extension Timer {
     
     /// Record the time interval (with nanosecond precision) between the passed `since` dispatch time and `end` dispatch time.
     ///
+    /// An `end` that precedes `since` records a zero duration rather than failing. `DispatchTime`
+    /// carries an unsigned uptime, so such a pair has no duration to express, and the alternatives -
+    /// trapping on the subtraction, or dropping the observation - would either take the process down
+    /// or lose the data point without a trace.
+    ///
     /// - parameters:
     ///   - since: Start of the interval as `DispatchTime`.
     ///   - end: End of the interval, defaulting to `.now()`.
     public func recordInterval(since: DispatchTime, end: DispatchTime = .now()) {
+        guard end.uptimeNanoseconds >= since.uptimeNanoseconds else {
+            return self.recordNanoseconds(0)
+        }
         self.recordNanoseconds(end.uptimeNanoseconds - since.uptimeNanoseconds)
     }
 
