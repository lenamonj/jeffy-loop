+/// A sink that refuses every write, standing in for the closed pipe a user
+/// creates with `myprog completions <shell> | head -1`.
+struct RefusesWrites;
+
+impl std::io::Write for RefusesWrites {
+    fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::other("simulated broken pipe"))
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
