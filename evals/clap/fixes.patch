+#[test]
+fn get_arg_conflicts_with_is_symmetric() {
+    // `conflicts_with` is enforced in both directions by the parser, so the
+    // reflection API has to report it in both directions too - a generator that
+    // reads it one way emits an exclusion list that lets through a combination
+    // the command then refuses.
+    let mut cmd = Command::new("prog")
+        .arg(arg!(--a <A>).conflicts_with("b"))
+        .arg(arg!(--b <B>));
+    cmd.build();
+
+    let ids = |id: &str| -> Vec<String> {
+        let arg = cmd.get_arguments().find(|a| a.get_id() == id).unwrap().clone();
+        cmd.get_arg_conflicts_with(&arg)
+            .iter()
+            .map(|a| a.get_id().to_string())
+            .collect()
+    };
+    assert_eq!(ids("a"), ["b"], "the declared direction");
+    assert_eq!(ids("b"), ["a"], "the undeclared direction");
+
+    // The parser refuses the pair in either order, which is the behaviour the
+    // two answers above have to match.
+    for argv in [
+        vec!["prog", "--a", "1", "--b", "2"],
+        vec!["prog", "--b", "2", "--a", "1"],
+    ] {
+        let err = Command::new("prog")
+            .arg(arg!(--a <A>).conflicts_with("b"))
+            .arg(arg!(--b <B>))
+            .try_get_matches_from(argv.clone())
+            .unwrap_err();
+        assert_eq!(err.kind(), ErrorKind::ArgumentConflict, "{argv:?}");
+    }
+
+    // An argument in the same command that declares no conflict is reported by
+    // neither, so the reverse scan does not simply return every other argument.
+    let mut cmd = Command::new("prog")
+        .arg(arg!(--a <A>).conflicts_with("b"))
+        .arg(arg!(--b <B>))
+        .arg(arg!(--c <C>));
+    cmd.build();
+    let c = cmd.get_arguments().find(|a| a.get_id() == "c").unwrap().clone();
+    assert!(cmd.get_arg_conflicts_with(&c).is_empty());
+
+    // Declaring the conflict from both sides must not report it twice.
+    let mut cmd = Command::new("prog")
+        .arg(arg!(--a <A>).conflicts_with("b"))
+        .arg(arg!(--b <B>).conflicts_with("a"));
+    cmd.build();
+    let a = cmd.get_arguments().find(|x| x.get_id() == "a").unwrap().clone();
+    let names: Vec<String> = cmd
+        .get_arg_conflicts_with(&a)
+        .iter()
+        .map(|x| x.get_id().to_string())
+        .collect();
+    assert_eq!(names, ["b"], "a mutual declaration is one conflict");
+}
+
+#[test]
+fn get_arg_conflicts_with_group_is_symmetric() {
+    // A conflict declared against a group unrolls to its members in the
+    // declared direction; each member has to name the declaring argument back.
+    let mut cmd = Command::new("prog")
+        .arg(arg!(--flag).conflicts_with("gr"))
+        .group(ArgGroup::new("gr").arg("some").arg("other"))
+        .arg(arg!(--some))
+        .arg(arg!(--other));
+    cmd.build();
+
+    let ids = |id: &str| -> Vec<String> {
+        let arg = cmd.get_arguments().find(|a| a.get_id() == id).unwrap().clone();
+        cmd.get_arg_conflicts_with(&arg)
+            .iter()
+            .map(|a| a.get_id().to_string())
+            .collect()
+    };
+    assert_eq!(ids("flag"), ["some", "other"]);
+    assert_eq!(ids("some"), ["flag"]);
+    assert_eq!(ids("other"), ["flag"]);
+}
