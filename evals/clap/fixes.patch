+#[test]
+fn try_generate_reports_a_write_failure_for_every_shell() {
+    // `Generator::generate` is infallible and every shipped shell defines it as
+    // `try_generate(..).expect(..)`, so `try_generate` is the only route that can
+    // report a closed pipe. Driven with and without subcommands, because that is
+    // the condition that selects fish's subcommand-helper path.
+    use clap_complete::aot::{Generator as _, Shell};
+
+    let built = |with_subcommand: bool| {
+        let mut cmd = clap::Command::new("prog").arg(clap::Arg::new("o").long("o"));
+        if with_subcommand {
+            cmd = cmd.subcommand(clap::Command::new("build"));
+        }
+        cmd.set_bin_name("prog");
+        cmd.build();
+        cmd
+    };
+
+    for shell in [
+        Shell::Bash,
+        Shell::Elvish,
+        Shell::Fish,
+        Shell::PowerShell,
+        Shell::Zsh,
+    ] {
+        for with_subcommand in [false, true] {
+            let err = shell
+                .try_generate(&built(with_subcommand), &mut RefusesWrites)
+                .expect_err(&format!(
+                    "{shell:?} with_subcommand={with_subcommand} did not report the write failure"
+                ));
+            assert_eq!(
+                err.kind(),
+                std::io::ErrorKind::Other,
+                "{shell:?} with_subcommand={with_subcommand}"
+            );
+        }
+    }
+}
