+            .lines()
+            .map(str::trim)
+            .find(|l| l.contains(&format!("{flag}=[")))
+            .unwrap_or_else(|| panic!("no line for {flag} in:\n{script}"))
+            .to_owned()
+    };
+    assert_eq!(line("--a"), "'(--b)--a=[]: :_default' \\");
