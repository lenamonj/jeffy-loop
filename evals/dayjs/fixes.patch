+  // positive controls first: an emptiness result is worthless from a scanner that finds nothing
+  expect(undecomposed('de')).toEqual(['e'])
+  expect(undecomposed('Do')).toEqual(['o'])
+  expect(undecomposed('MMMM')).toEqual([])
+  expect(undecomposed('YYYY')).toEqual([])
+  expect(nonCoreTokens('D [de] MMMM')).toEqual([])
+  expect(nonCoreTokens('D de MMMM')).toEqual(['de'])
+  // a CJK literal is not an ASCII run and must never be flagged
+  expect(nonCoreTokens('YYYY年M月D日')).toEqual([])
+})
+
