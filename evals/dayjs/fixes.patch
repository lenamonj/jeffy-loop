+    .toBe(moment(MONTH_DATES[0]).locale('en').format('MMMM'))
+})
+
+comparable.forEach((name) => {
+  it(`month names match moment for ${name}`, () => {
+    expect(monthDiffs(name)).toEqual(KNOWN_MONTH_NAME_DIFFERENCES[name] || [])
+  })
+
+  it(`weekday names match moment for ${name}`, () => {
+    expect(dayDiffs(name)).toEqual(KNOWN_WEEKDAY_NAME_DIFFERENCES[name] || [])
+  })
+})
+
+it('allowlists name only locales that are still comparable', () => {
+  Object.keys(KNOWN_MONTH_NAME_DIFFERENCES).forEach((name) => {
+    expect(comparable).toContain(name)
+  })
+  Object.keys(KNOWN_WEEKDAY_NAME_DIFFERENCES).forEach((name) => {
+    expect(comparable).toContain(name)
+  })
+})
+
+// F24. A month name that is inflected differently inside a date than standing alone needs
+// dayjs's function form carrying `.f` and `.s`, which `be`, `hr`, `lt`, `pl`, `ru` and `uk`
+// already use. These five collapsed both contexts into one flat array, so one of the two was
+// always ungrammatical. The date context is what a flat array got wrong, so it is asserted here
+// across every month; the standalone context is covered by the comparison above.
+const CONTEXT_INFLECTED = ['ca', 'cs', 'el', 'hr', 'hy-am', 'oc-lnc', 'tg']
+
+CONTEXT_INFLECTED.forEach((name) => {
+  // The date context is each locale's own LL, not a bare 'D MMMM'. cs is why: its LL separates
+  // D from MMMM with a period, and on the bare space form moment returns the nominative and so
+  // renders the ungrammatical '15 leden'. LL is also what a caller actually formats with.
+  it(`date-context month names match moment for ${name}`, () => {
+    MONTH_DATES.forEach((d) => {
+      expect(dayjs(d).locale(name).format('LL')).toBe(moment(d).locale(name).format('LL'))
+    })
+  })
+
+  it(`${name} declares both month arms`, () => {
+    const { months } = dayjs.Ls[name]
+    expect(typeof months).toBe('function')
+    expect(months.f).toHaveLength(12)
+    expect(months.s).toHaveLength(12)
+    // the two arms must really differ, or the function form is pointless here
+    expect(months.f).not.toEqual(months.s)
+  })
+})
+
+// The class enumeration for F24, done shape-independently: rather than looking for locales
+// whose moment counterpart happens to model two arms as { format, standalone }, compare every
+// locale's rendered LL against moment's. That search is what found `hr`, which already had the
+// function form but whose own 'D. MMMM YYYY' never matched its regex, and `el`, whose two forms
+// moment models as a months() function that an object-shaped search cannot see.
+const KNOWN_LL_DIFFERENCES = [
+  // moment converts digits in a postformat hook; dayjs gates preparse/postformat behind the
+  // opt-in preParsePostFormat plugin, so Latin digits in core output are correct by design.
+  'ar', 'ar-sa', 'bn', 'bn-bd', 'bo', 'fa', 'gu', 'hi', 'km', 'kn', 'ku', 'mr', 'my', 'ne',
+  'pa-in', 'ta',
+  'eo' // Declined: article and case are a pattern choice, no language source says it is wrong
+]
+
+it('no locale renders a date-context month name moment disagrees with', () => {
+  const differing = comparable.filter(name => MONTH_DATES
+    .some(d => dayjs(d).locale(name).format('LL') !== moment(d).locale(name).format('LL')))
+  expect(differing.sort()).toEqual(KNOWN_LL_DIFFERENCES.slice().sort())
+})
+
+// F28. az's whole formats block was byte-identical to ru's, Russian 'г.' and all, so every
+// long-form Azerbaijani date carried a Cyrillic year abbreviation. A formats block shared
+// verbatim between two locales is only safe when they are variants of the same language, so the
+// class is enumerated by grouping identical blocks and allowing only same-language pairs.
+const SHARED_FORMAT_BLOCKS = [
+  ['ar', 'ar-ly'], // Arabic variants
+  ['pt', 'pt-br'], // Portuguese variants
+  ['sd', 'ur'], // both Arabic-script, share the Arabic comma
+  ['zh', 'zh-cn'], // Chinese variants
+  ['zh-hk', 'zh-tw'] // Chinese variants
+]
+
+it('no formats block carrying language-specific text is shared across languages', () => {
+  const blocks = {}
+  localeNames.forEach((name) => {
+    const l = dayjs.Ls[name]
+    if (!l || !l.formats) return
+    const key = JSON.stringify(l.formats)
+    // only blocks carrying non-ASCII literal text can smuggle one language into another
+    const carriesLanguageText = key.split('').some(ch => ch.charCodeAt(0) > 127)
+    if (!carriesLanguageText) return
+    blocks[key] = (blocks[key] || []).concat(name)
+  })
+  const shared = Object.keys(blocks)
+    .map(k => blocks[k])
+    .filter(names => names.length > 1)
+    .map(names => names.slice().sort())
+    .sort((a, b) => (a[0] < b[0] ? -1 : 1))
+  expect(shared).toEqual(SHARED_FORMAT_BLOCKS)
+})
+
+it('az carries no Cyrillic year abbreviation', () => {
+  // F28, asserted directly so a revert cannot pass by coincidence
+  const { formats } = dayjs.Ls.az
+  Object.keys(formats).forEach((k) => {
+    expect(formats[k]).not.toMatch(/[Ѐ-ӿ]/)
+  })
+  expect(dayjs('2019-01-15T14:30:45').locale('az').format('LL')).toBe('15 yanvar 2019')
+  expect(dayjs('2019-01-15T14:30:45').locale('az').format('LT')).toBe('14:30')
+})
+
+// F25. A bundled locale's format patterns must use only tokens core `format` implements.
+// gom-latn's LLLL contained `Do`, which advancedFormat supplies. With that plugin absent the
+// pattern rendered a literal `o` after the day number, and with it present the result depended
+// on extend order, because localizedFormat expands its L tokens only after a wrapper above it
+// has already made its own substitution pass.
+const CORE_TOKENS = ['YYYY', 'YY', 'MMMM', 'MMM', 'MM', 'M', 'DD', 'D', 'dddd', 'ddd', 'dd', 'd',
+  'HH', 'H', 'hh', 'h', 'mm', 'm', 'ss', 's', 'SSS', 'ZZ', 'Z', 'a', 'A']
+
+// the longest core token starting at `at`, or undefined. Hoisted out of the loops below so no
+// function is created inside one.
+const tokenAt = (run, at) => CORE_TOKENS.find(t => run.startsWith(t, at))
+
+// return the parts of an ASCII letter run that are not core tokens
+const undecomposed = (run) => {
+  const left = []
+  let i = 0
+  while (i < run.length) {
+    const tok = tokenAt(run, i)
+    if (tok) {
+      i += tok.length
+    } else {
+      let j = i
+      while (j < run.length && !tokenAt(run, j)) j += 1
+      left.push(run.slice(i, j))
+      i = j
+    }
+  }
+  return left
+}
+
+// scan a pattern outside its bracketed literal segments
+const nonCoreTokens = (pattern) => {
+  const hits = []
+  let i = 0
+  let plain = ''
+  const flush = () => {
+    (plain.match(/[A-Za-z]+/g) || []).forEach((run) => {
+      if (undecomposed(run).length) hits.push(run)
+    })
+    plain = ''
+  }
+  while (i < pattern.length) {
+    if (pattern[i] === '[') {
+      flush()
+      const end = pattern.indexOf(']', i)
+      i = end === -1 ? pattern.length : end + 1
+    } else {
+      plain += pattern[i]
+      i += 1
+    }
+  }
+  flush()
+  return hits
+}
+
