+    // The watched entry was never invalidated, so this parse must be a hit, not a rebuild.
+    ordinalCalls = 0
+    expect(dayjs('5', 'Do', 'f45-watched').date()).toBe(5)
+    expect(ordinalCalls).toBe(hitCost)
+  })
+})
+
+describe('rejects what it cannot parse', () => {
+  // F43. A negative corpus, kept deliberately alongside the positive enumerations above. Those
+  // ask whether correct input still parses; only this asks whether incorrect input still fails,
+  // and that is the question a loosened failure path escapes. F41 made the Do handler's digit
+  // scrape optional so a non-ASCII digit system would stop throwing, but left no failure path
+  // for text that neither the digits nor the locale's ordinal table resolve, so the day fell
+  // through to parseFormattedInput's `day || ...` default and became the 1st, or today when the
+  // format names no year or month. A 12870-parse snapshot of valid round trips passed over it.
+  const LOCALE_DIR = path.join(__dirname, '../../src/locale')
+  const LOCALES = fs.readdirSync(LOCALE_DIR)
+    .filter(f => f.endsWith('.js'))
+    .map(f => f.replace('.js', ''))
+  LOCALES.forEach((name) => {
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(path.join(LOCALE_DIR, `${name}.js`))
+  })
+  const NEGATIVE = [
+    ['zzz April 2019', 'Do MMMM YYYY'],
+    ['garbage', 'Do'],
+    ['Monday, April 15 2019', 'Do MMMM YYYY'],
+    ['xx', 'Do'],
+    ['-- April 2019', 'Do MMMM YYYY'],
+    ['April 2019', 'Do MMMM YYYY']
+  ]
+
+  it('rejects an unresolvable ordinal in every locale', () => {
+    dayjs.extend(advancedFormat)
+    const accepted = []
+    let checks = 0
+    LOCALES.forEach((name) => {
+      NEGATIVE.forEach(([input, format]) => {
+        checks += 1
+        const parsed = dayjs(input, format, name)
+        if (parsed.isValid()) accepted.push(`${name} | ${format} | ${input} -> ${parsed.format('YYYY-MM-DD')}`)
+      })
+    })
+    expect(accepted).toEqual([])
+    expect(checks).toBe(858)
+  })
+
+  it('still accepts the ordinals each locale actually renders', () => {
+    // The other half of the pair. Rejecting everything would satisfy the test above, so the
+    // positive side is asserted here rather than left to the enumerations in another describe.
+    dayjs.extend(advancedFormat)
+    const rejected = []
+    let checks = 0
+    LOCALES.forEach((name) => {
+      [1, 3, 11, 22].forEach((day) => {
+        const expected = `2019-04-${day < 10 ? `0${day}` : day}`
+        const rendered = dayjs(expected).locale(name).format('Do MMMM YYYY')
+        const parsed = dayjs(rendered, 'Do MMMM YYYY', name)
+        checks += 1
+        if (!parsed.isValid() || parsed.format('YYYY-MM-DD') !== expected) {
+          rejected.push(`${name} "${rendered}"`)
+        }
+      })
+    })
+    expect(rejected).toEqual([])
+    expect(checks).toBe(572)
+  })
+})
+
+describe('a full name given to a shorter name token', () => {
+  // F44. Deriving a short name by slicing makes it a prefix of the name it came from, and
+  // matchNames orders its alternatives longest first, so without the full names alongside them
+  // the shorter token captured only the prefix and stranded the rest of the word for the next
+  // matcher. It regressed the default locale, where all three short arrays are derived, while
+  // every locale supplying its own arrays kept working through the trailing matchWord.
+  const LOCALE_DIR = path.join(__dirname, '../../src/locale')
+  const LOCALES = fs.readdirSync(LOCALE_DIR)
+    .filter(f => f.endsWith('.js'))
+    .map(f => f.replace('.js', ''))
+  LOCALES.forEach((name) => {
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(path.join(LOCALE_DIR, `${name}.js`))
+  })
+
+  const parseFullName = (name, token) => {
+    const full = dayjs('2019-04-15').locale(name).format('dddd')
+    const month = dayjs('2019-04-15').locale(name).format('MMMM')
+    return dayjs(`${full} 15 ${month} 2019`, `${token} D MMMM YYYY`, name)
+  }
+
+  it('accepts a full weekday name against dddd in every locale', () => {
+    const failures = LOCALES.filter((name) => {
+      const parsed = parseFullName(name, 'dddd')
+      return !parsed.isValid() || parsed.format('YYYY-MM-DD') !== '2019-04-15'
+    })
+    expect(failures).toEqual([])
+    expect(LOCALES.length).toBe(143)
+  })
+
+  it('accepts a full weekday name against dd and ddd wherever the arrays are derived', () => {
+    // en and rw are the only locales defining neither weekdaysMin nor weekdaysShort, so they are
+    // the ones whose alternations are built by slicing and the ones this regressed. Asserting the
+    // derived set rather than a fixed pair means a locale that stops shipping a short array is
+    // covered too.
+    const derived = LOCALES
+      .filter(name => !dayjs.Ls[name].weekdaysMin && !dayjs.Ls[name].weekdaysShort)
+    expect(derived.sort()).toEqual(['en', 'rw'])
+    const failures = []
+    derived.forEach((name) => {
+      ['dd', 'ddd'].forEach((token) => {
+        const parsed = parseFullName(name, token)
+        if (!parsed.isValid() || parsed.format('YYYY-MM-DD') !== '2019-04-15') failures.push(`${name} ${token}`)
+      })
+    })
+    expect(failures).toEqual([])
+  })
+
+  it('explains every locale that still rejects one, rather than listing them', () => {
+    // A locale shipping its own short array can have a short name that is itself a prefix of the
+    // full name - de writes Mo for Montag - and there the alternation captures the prefix and
+    // strands the rest. That predates this run and is unchanged by it: measured against the
+    // pre-run source, no locale is newly failing and rw joins en in being fixed. It is asserted
+    // as a reason rather than an allowlist, so a failure with any other cause is caught.
+    const unexplained = [];
+    ['dd', 'ddd'].forEach((token) => {
+      const key = token === 'dd' ? 'weekdaysMin' : 'weekdaysShort'
+      LOCALES.forEach((name) => {
+        const parsed = parseFullName(name, token)
+        if (parsed.isValid() && parsed.format('YYYY-MM-DD') === '2019-04-15') return
+        const locale = dayjs.Ls[name]
+        const short = locale[key]
+        const full = dayjs('2019-04-15').locale(name).format('dddd')
+        const shortList = short && (short.indexOf ? short : short.s.concat(short.f))
+        // Cause one: some alternative in the locale's own short array is a proper prefix of the
+        // full name, so the alternation captures that prefix and strands the rest. It need not
+        // be the same weekday's abbreviation - tr fails on Pazartesi because Paz, its Sunday,
+        // is a prefix of it - which is why this asks the array rather than the one entry.
+        const prefixCapture = !!shortList && shortList
+          .filter(Boolean)
+          .some(s => full.indexOf(s) === 0 && s !== full)
+        // Cause two: the full name carries a space or a hyphen, which matchWord cannot cross,
+        // so the trailing alternative captures only its first word. cy writes Dydd Llun.
+        const uncrossable = /[\s-]/.test(full)
+        if (!prefixCapture && !uncrossable) {
+          unexplained.push(`${name} ${token} short=${JSON.stringify(shortList)} full=${full}`)
+        }
+      })
+    })
+    expect(unexplained).toEqual([])
+  })
+
+  it('still accepts each token\'s own width, and strict still rejects a wrong weekday', () => {
+    // en is the locale whose three short arrays are all derived, so it is where the alternation
+    // now carries both forms and where the abbreviated forms could plausibly have been lost.
+    expect(dayjs('Mon, April 15 2019', 'ddd, MMMM D YYYY').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('Mo, April 15 2019', 'dd, MMMM D YYYY').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('Monday, April 15 2019', 'dddd, MMMM D YYYY').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('15 Jan 2019', 'D MMM YYYY').format('YYYY-MM-DD')).toBe('2019-01-15')
+    expect(dayjs('15 January 2019', 'D MMM YYYY').format('YYYY-MM-DD')).toBe('2019-01-15')
+    // Strict reformats and compares, so the wrong weekday and the wrong width both still fail.
+    expect(dayjs('Friday, April 15 2019', 'dddd, MMMM D YYYY', true).isValid()).toBe(false)
+    expect(dayjs('Monday, April 15 2019', 'dddd, MMMM D YYYY', true).isValid()).toBe(true)
+    expect(dayjs('Monday, April 15 2019', 'ddd, MMMM D YYYY', true).isValid()).toBe(false)
+  })
+})
