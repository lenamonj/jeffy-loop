+// utc supplies `YYYY-MM-DDTHH:mm:ss[Z]` as the default format in UTC mode, but only when it
+// receives no format string. advancedFormat, buddhistEra and localizedFormat each wrap `format`
+// too, and each used to substitute core's FORMAT_DEFAULT for a missing argument before
+// delegating, so whichever of them was extended after utc filled one in and masked utc's
+// default: `.utc().format()` then rendered the `Z` token as `+00:00` instead of a literal Z.
+// The sweep in interaction.test.js pins the two orders against each other; this pins the value,
+// since two orders agreeing on the wrong string would satisfy that check.
+describe('the UTC default format survives whichever order format-wrapping plugins load in', () => {
+  const ISO = '2016-05-03T22:15:01Z'
+  const expected = moment.utc(ISO).format()
+
+  const build = (plugins) => {
+    jest.resetModules()
+    const d = require('../../src').default // eslint-disable-line global-require
+    plugins.forEach((p) => {
+      d.extend(require(`../../src/plugin/${p}`).default) // eslint-disable-line global-require, import/no-dynamic-require
+    })
+    return d
+  }
+
+  const wrappers = ['advancedFormat', 'buddhistEra', 'localizedFormat']
+
+  it('matches moment with utc alone', () => {
+    expect(build(['utc'])(ISO).utc().format()).toBe(expected)
+    expect(expected).toBe('2016-05-03T22:15:01Z')
+  })
+
+  wrappers.forEach((plugin) => {
+    it(`matches moment with utc then ${plugin}`, () => {
+      expect(build(['utc', plugin])(ISO).utc().format()).toBe(expected)
+    })
+    it(`matches moment with ${plugin} then utc`, () => {
+      expect(build([plugin, 'utc'])(ISO).utc().format()).toBe(expected)
+    })
+  })
+})
diff --git a/test/types.test.js b/test/types.test.js
new file mode 100644
index 0000000..fe19fea
--- /dev/null
+++ b/test/types.test.js
@@ -0,0 +1,248 @@
+import fs from 'fs'
+import path from 'path'
+import { execFileSync } from 'child_process'
+
+// The 40 shipped declaration files are gated here in two independent ways, because neither
+// catches what the other does. The compiler checks that they are valid TypeScript; it cannot
+// know whether they describe the library, since nothing type-checked imports the JavaScript.
+// So the rest of this file compares each declaration against the runtime by execution: for
+// every plugin, what the .d.ts names against what extending the plugin actually installs, in
+// both directions.
+
+const ROOT = path.join(__dirname, '..')
+const TYPES = path.join(__dirname, '../types')
+const SRC_PLUGIN = path.join(__dirname, '../src/plugin')
+
+// Prototype members a plugin installs on purpose without declaring them. These are internal
+// helpers rather than public API, the same category as core's `parse` and `init`: `fromToBase`
+// is the shared implementation `from`, `to`, `fromNow` and `toNow` delegate to.
+const INTERNAL_MEMBERS = ['fromToBase']
+const INTERNAL_CORE_MEMBERS = ['parse', 'init']
+
+// Declaration gaps still open, each tracked in BACKLOG.md. This map may only shrink: a new
+// entry is a regression, and closing the task removes its entry. It is empty, so every member
+// every plugin installs is now declared, and any plugin that adds one without declaring it
+// fails here.
+const KNOWN_DECLARATION_GAPS = {}
+
+// members declared inside an `interface Dayjs {` or `class Dayjs {` block
+const membersOf = (text, header) => {
+  const lines = text.split(/\r?\n/)
+  const start = lines.findIndex(l => l.trim().replace(/\s+/g, ' ') === `${header} {`)
+  if (start === -1) return []
+  let depth = 0
+  let end = lines.length
+  for (let i = start; i < lines.length; i += 1) {
+    depth += (lines[i].match(/\{/g) || []).length - (lines[i].match(/\}/g) || []).length
+    if (depth === 0 && i > start) { end = i; break }
+  }
+  return [...new Set(lines.slice(start + 1, end)
+    .map(l => (l.match(/^\s*([A-Za-z_$][\w$]*)\s*\??\s*[(<]/) || [])[1])
+    .filter(Boolean)
+    .filter(m => m !== 'constructor'))]
+}
+
+// statics declared on the dayjs namespace, either `export function x(` or `const x:`
+const staticsOf = text => [...new Set(text.split(/\r?\n/)
+  .map((l) => {
+    const fn = l.match(/^\s*export function\s+([A-Za-z_$][\w$]*)/)
+    if (fn) return fn[1]
+    const c = l.match(/^\s+(?:export\s+)?const\s+([A-Za-z_$][\w$]*)\s*:/)
+    return c ? c[1] : null
+  })
+  .filter(Boolean))]
+
+const declarationFiles = fs.readdirSync(path.join(TYPES, 'plugin'))
+  .filter(f => f.endsWith('.d.ts'))
+  .map(f => f.replace('.d.ts', ''))
+  .sort()
+
+const pluginDirs = fs.readdirSync(SRC_PLUGIN)
+  .filter(d => fs.existsSync(path.join(SRC_PLUGIN, d, 'index.js')))
+  .sort()
+
+// Extend a fresh dayjs with one plugin and report what that added, so the comparison is against
+// the plugin's own contribution rather than everything the prototype happens to carry.
+const install = (name) => {
+  jest.resetModules()
+  const d = require('../src').default // eslint-disable-line global-require
+  const protoBefore = Object.getOwnPropertyNames(Object.getPrototypeOf(d()))
+  const staticBefore = Object.keys(d)
+  d.extend(require(`../src/plugin/${name}`).default) // eslint-disable-line global-require, import/no-dynamic-require
+  const instance = d()
+  return {
+    dayjs: d,
+    instance,
+    addedMembers: Object.getOwnPropertyNames(Object.getPrototypeOf(instance))
+      .filter(m => protoBefore.indexOf(m) === -1),
+    addedStatics: Object.keys(d).filter(m => staticBefore.indexOf(m) === -1)
+  }
+}
+
+// Every .d.ts under types/, used to prove the compile gate really read them. A tsconfig whose
+// `include` matched nothing would exit 0 too, and would certify an empty file set as clean.
+const allDeclarations = dir => fs.readdirSync(dir, { withFileTypes: true })
+  .reduce((acc, e) => {
+    const full = path.join(dir, e.name)
+    if (e.isDirectory()) return acc.concat(allDeclarations(full))
+    return e.name.endsWith('.d.ts') ? acc.concat(full) : acc
+  }, [])
+
+it('the shipped declarations compile under strict TypeScript', () => {
+  const tsc = require.resolve('typescript/bin/tsc')
+  const args = ['--noEmit', '--listFiles', '-p', path.join(ROOT, 'tsconfig.json')]
+  let status = 0
+  let output = ''
+  try {
+    output = execFileSync(process.execPath, [tsc].concat(args), { encoding: 'utf8' })
+  } catch (e) {
+    ({ status } = e)
+    output = `${e.stdout || ''}${e.stderr || ''}`
+  }
+  const lines = output.split(/\r?\n/).map(l => l.trim()).filter(Boolean)
+
+  expect(lines.filter(l => l.indexOf('error TS') !== -1)).toEqual([])
+  expect(status).toBe(0)
+
+  // and it compiled the declarations themselves, not an empty file set
+  const checked = lines.map(l => path.resolve(l))
+  const shipped = allDeclarations(TYPES)
+  expect(shipped.length).toBeGreaterThan(30)
+  expect(shipped.filter(f => checked.indexOf(path.resolve(f)) === -1)).toEqual([])
+}, 120000)
+
+// The compile gate above proves the declarations are valid TypeScript, and the fixtures in
+// test/types/ prove the declared parameter and return types describe a usable API - every
+// annotated binding there checks a return type and every `@ts-expect-error` must really be an
+// error. None of that executes, so a declared `valueOf(): number` could still be wrong about the
+// runtime. These calls are the same ones the fixtures type-assert, run for real, so the pair
+// together says the declared kind and the actual kind agree. The correspondence is by
+// construction - the same call list appears in both places - not machine-derived.
+const RETURN_KINDS = [
+  ['format()', d => d().format(), 'string'],
+  ['format(template)', d => d().format('YYYY-MM-DD'), 'string'],
+  ['toISOString()', d => d().toISOString(), 'string'],
+  ['toJSON()', d => d().toJSON(), 'string'],
+  ['toString()', d => d().toString(), 'string'],
+  ['valueOf()', d => d().valueOf(), 'number'],
+  ['unix()', d => d().unix(), 'number'],
+  ['year()', d => d().year(), 'number'],
+  ['daysInMonth()', d => d().daysInMonth(), 'number'],
+  ['diff()', d => d().diff(), 'number'],
+  ['diff(date, unit)', d => d().diff('2018-06-05', 'month'), 'number'],
+  ['diff(date, unit, float)', d => d().diff('2018-06-05', 'month', true), 'number'],
+  ['get(unit)', d => d().get('year'), 'number'],
+  ['isValid()', d => d().isValid(), 'boolean'],
+  ['isBefore(other)', d => d().isBefore(d()), 'boolean'],
+  ['isAfter(other, unit)', d => d().isAfter(d(), 'day'), 'boolean'],
+  ['isSame(other, unit)', d => d().isSame(d(), 'month'), 'boolean'],
+  ['locale()', d => d().locale(), 'string'],
+  ['dayjs.locale()', d => d.locale(), 'string'],
+  ['dayjs.isDayjs(x)', d => d.isDayjs(d()), 'boolean']
+]
+
+const OBJECT_RETURNS = [
+  ['clone()', d => d().clone()],
+  ['add(n, unit)', d => d().add(7, 'day')],
+  ['subtract(n, unit)', d => d().subtract(7, 'year')],
+  ['startOf(unit)', d => d().startOf('year')],
+  ['endOf(unit)', d => d().endOf('month')],
+  ['set(unit, n)', d => d().set('year', 2020)],
+  ['year(n)', d => d().year(2020)],
+  ['locale(name)', d => d().locale('en')]
+]
+
+it('every plugin declaration is signature-checked by a fixture', () => {
+  const fixtureDir = path.join(__dirname, 'types')
+  const fixtures = fs.readdirSync(fixtureDir)
+    .filter(f => f.endsWith('.ts'))
+    .map(f => fs.readFileSync(path.join(fixtureDir, f), 'utf8'))
+    .join('\n')
+  // positive control: the matcher really finds imports in these files
+  expect(fixtures).toContain("from 'dayjs/plugin/utc'")
+  const unchecked = declarationFiles.filter(name => fixtures.indexOf(`from 'dayjs/plugin/${name}'`) === -1)
+  // a new plugin must gain a fixture, or its declared signatures go unexercised
+  expect(unchecked).toEqual([])
+})
+
+it('declared return kinds match the runtime for core', () => {
+  jest.resetModules()
+  const d = require('../src').default // eslint-disable-line global-require
+  const wrong = RETURN_KINDS
+    .map(([label, call, expected]) => [label, typeof call(d), expected])
+    .filter(([, actual, expected]) => actual !== expected)
+  expect(wrong).toEqual([])
+
+  // the methods the declarations type as returning Dayjs really return a Dayjs, not a clone-like
+  // object or the receiver's primitive
+  const notDayjs = OBJECT_RETURNS
+    .map(([label, call]) => [label, d.isDayjs(call(d))])
+    .filter(([, isIt]) => !isIt)
+  expect(notDayjs).toEqual([])
+
+  expect(d().toDate()).toBeInstanceOf(Date)
+  expect(Array.isArray(RETURN_KINDS)).toBe(true)
+  expect(RETURN_KINDS.length).toBeGreaterThan(15)
+})
+
+it('every plugin has a declaration and every declaration has a plugin', () => {
+  expect(declarationFiles).toEqual(pluginDirs)
+  expect(pluginDirs.length).toBeGreaterThan(0)
+})
+
+it('every member a plugin declaration names exists once that plugin is extended', () => {
+  const missing = {}
+  declarationFiles.forEach((name) => {
+    const text = fs.readFileSync(path.join(TYPES, 'plugin', `${name}.d.ts`), 'utf8')
+    const { dayjs, instance } = install(name)
+    const gaps = membersOf(text, 'interface Dayjs').filter(m => typeof instance[m] !== 'function')
+    // statics are not all callable: core declares `Ls`, the locale registry, as an object
+    const staticGaps = staticsOf(text).filter(m => typeof dayjs[m] === 'undefined')
+    if (gaps.length || staticGaps.length) missing[name] = gaps.concat(staticGaps)
+  })
+  // a declaration naming a method the plugin does not provide lets a type-checked call crash
+  expect(missing).toEqual({})
+})
+
+it('every member a plugin installs is declared, or listed as an open gap', () => {
+  const gaps = {}
+  declarationFiles.forEach((name) => {
+    const text = fs.readFileSync(path.join(TYPES, 'plugin', `${name}.d.ts`), 'utf8')
+    const declared = membersOf(text, 'interface Dayjs')
+    const declaredStatics = staticsOf(text)
+    const { addedMembers, addedStatics } = install(name)
+    const undeclared = addedMembers
+      .filter(m => declared.indexOf(m) === -1)
+      .filter(m => INTERNAL_MEMBERS.indexOf(m) === -1)
+      .concat(addedStatics.filter(m => declaredStatics.indexOf(m) === -1))
+    if (undeclared.length) gaps[name] = undeclared
+  })
+  // this map may only shrink; a new key is a plugin shipping a method TypeScript cannot call
+  expect(gaps).toEqual(KNOWN_DECLARATION_GAPS)
+})
+
+it('the core declaration agrees with the core runtime in both directions', () => {
+  const text = fs.readFileSync(path.join(TYPES, 'index.d.ts'), 'utf8')
+  jest.resetModules()
+  const d = require('../src').default // eslint-disable-line global-require
+  const instance = d()
+
+  const declared = membersOf(text, 'class Dayjs')
+  expect(declared.length).toBeGreaterThan(20)
+  expect(declared.filter(m => typeof instance[m] !== 'function')).toEqual([])
+
+  const declaredStatics = staticsOf(text)
+  expect(declaredStatics.filter(m => typeof d[m] === 'undefined')).toEqual([])
+  // and `Ls` really is the object the declaration says it is, not merely defined
+  expect(declaredStatics).toContain('Ls')
+  expect(typeof d.Ls).toBe('object')
+
+  // the reverse direction. `parse` and `init` are internal lifecycle hooks that utc,
+  // objectSupport, customParseFormat and others wrap; declaring them would widen the API.
+  const runtime = Object.getOwnPropertyNames(Object.getPrototypeOf(instance))
+    .filter(m => m !== 'constructor' && m[0] !== '$' && typeof instance[m] === 'function')
+  expect(runtime.filter(m => declared.indexOf(m) === -1).sort())
+    .toEqual(INTERNAL_CORE_MEMBERS.slice().sort())
+  expect(Object.keys(d).filter(m => typeof d[m] === 'function' && declaredStatics.indexOf(m) === -1))
+    .toEqual([])
+})
diff --git a/test/types/core.type-test.ts b/test/types/core.type-test.ts
new file mode 100644
index 0000000..58df3aa
--- /dev/null
+++ b/test/types/core.type-test.ts
@@ -0,0 +1,113 @@
+// Signature agreement between types/index.d.ts and the real API.
+//
+// test/types.test.js already checks that every declared member exists at runtime and that every
+// installed member is declared. That is member existence only. Nothing checked whether the
+// declared parameter and return types describe what the functions actually accept and return,
+// because nothing type-checked ever imported dayjs. These fixtures do, and they assert in both
+// directions: valid calls must compile, and each `@ts-expect-error` line must NOT compile, which
+// tsc reports as an error when the code under it turns out to be legal after all. That second
+// direction is what stops the file from passing merely because everything is typed `any`.
+
+import dayjs, { Dayjs, ConfigType, OpUnitType, ManipulateType, QUnitType } from 'dayjs'
+
+// assigning to an explicitly annotated variable is what actually checks the return type; a bare
+// call would compile no matter what the declaration says
+const d: Dayjs = dayjs()
+
+// --- constructor overloads ---
+const fromString: Dayjs = dayjs('2019-01-25')
+const fromNumber: Dayjs = dayjs(1548381600000)
+const fromDate: Dayjs = dayjs(new Date())
+const fromDayjs: Dayjs = dayjs(d)
+const fromNull: Dayjs = dayjs(null)
+const fromUndefined: Dayjs = dayjs(undefined)
+const fromUnix: Dayjs = dayjs.unix(1548381600)
+const cloned: Dayjs = d.clone()
+
+// @ts-expect-error a plain object is not a ConfigType without the objectSupport plugin loaded
+dayjs({ notAConfig: true })
+
+// --- formatting returns string, not Dayjs ---
+const formatted: string = d.format()
+const formattedWith: string = d.format('YYYY-MM-DD')
+const asString: string = d.toString()
+const asISO: string = d.toISOString()
+const asJSON: string = d.toJSON()
+
+// @ts-expect-error format returns a string, so it cannot satisfy Dayjs
+const formatIsNotDayjs: Dayjs = d.format()
+// @ts-expect-error the template is a string, not a number
+d.format(20190125)
+
+// --- manipulation returns Dayjs, and the unit is a constrained literal ---
+const added: Dayjs = d.add(7, 'day')
+const subtracted: Dayjs = d.subtract(7, 'year')
+const addedNoUnit: Dayjs = d.add(1)
+const started: Dayjs = d.startOf('year')
+const ended: Dayjs = d.endOf('month')
+
+// @ts-expect-error the value is a number, not a string
+d.add('7', 'day')
+// @ts-expect-error 'fortnight' is not a ManipulateType
+d.add(1, 'fortnight')
+// @ts-expect-error 'fortnight' is not an OpUnitType
+d.startOf('fortnight')
+
+// --- comparison returns boolean ---
+const before: boolean = d.isBefore(dayjs())
+const after: boolean = d.isAfter(dayjs(), 'day')
+const same: boolean = d.isSame(dayjs(), 'month')
+const valid: boolean = d.isValid()
+const isDayjsValue: boolean = dayjs.isDayjs(d)
+
+// @ts-expect-error isBefore returns a boolean, not a Dayjs
+const compareIsNotDayjs: Dayjs = d.isBefore(dayjs())
+
+// --- numeric accessors ---
+const ms: number = d.valueOf()
+const seconds: number = d.unix()
+const year: number = d.year()
+const daysInMonth: number = d.daysInMonth()
+const diffDefault: number = d.diff()
+const diffUnit: number = d.diff('2018-06-05', 'month')
+const diffFloat: number = d.diff('2018-06-05', 'month', true)
+const asDate: Date = d.toDate()
+
+// @ts-expect-error diff returns a number, not a string
+const diffIsNotString: string = d.diff()
+// @ts-expect-error the float flag is a boolean, not a string
+d.diff('2018-06-05', 'month', 'yes')
+
+// --- get and set ---
+const gotYear: number = d.get('year')
+const setYear: Dayjs = d.set('year', 2020)
+const yearSetter: Dayjs = d.year(2020)
+
+// @ts-expect-error set returns a new Dayjs, not a number
+const setIsNotNumber: number = d.set('year', 2020)
+
+// --- locale and statics ---
+const localeName: string = dayjs.locale()
+const localeSet: string = dayjs.locale('en')
+const withLocale: Dayjs = d.locale('en')
+
+// --- the exported type aliases really constrain what they claim to ---
+const unitOp: OpUnitType = 'month'
+const unitManipulate: ManipulateType = 'day'
+const unitQ: QUnitType = 'quarter'
+const cfg: ConfigType = '2019-01-25'
+
+// @ts-expect-error 'quarter' is a QUnitType, not a ManipulateType, without quarterOfYear
+const badManipulate: ManipulateType = 'quarter'
+
+// reference every binding so noUnusedLocals could be enabled later without churn
+export default [
+  d, fromString, fromNumber, fromDate, fromDayjs, fromNull, fromUndefined, fromUnix, cloned,
+  formatted, formattedWith, asString, asISO, asJSON, formatIsNotDayjs,
+  added, subtracted, addedNoUnit, started, ended,
+  before, after, same, valid, isDayjsValue, compareIsNotDayjs,
+  ms, seconds, year, daysInMonth, diffDefault, diffUnit, diffFloat, asDate, diffIsNotString,
+  gotYear, setYear, yearSetter, setIsNotNumber,
+  localeName, localeSet, withLocale,
+  unitOp, unitManipulate, unitQ, cfg, badManipulate
+]
diff --git a/test/types/plugin-rest.type-test.ts b/test/types/plugin-rest.type-test.ts
new file mode 100644
index 0000000..fbd5b87
--- /dev/null
+++ b/test/types/plugin-rest.type-test.ts
@@ -0,0 +1,116 @@
+// The remaining plugin declarations, so signature agreement covers all 37 rather than the
+// structurally interesting subset in plugin.type-test.ts. Most of these are simple predicates or
+// getter/setter pairs; the pairs still matter because their return type switches on arity, which
+// is exactly the shape member-existence checking cannot see.
+
+import dayjs, { Dayjs } from 'dayjs'
+import isMoment from 'dayjs/plugin/isMoment'
+import isSameOrAfter from 'dayjs/plugin/isSameOrAfter'
+import isSameOrBefore from 'dayjs/plugin/isSameOrBefore'
+import isToday from 'dayjs/plugin/isToday'
+import isTomorrow from 'dayjs/plugin/isTomorrow'
+import isYesterday from 'dayjs/plugin/isYesterday'
+import isoWeek from 'dayjs/plugin/isoWeek'
+import isoWeeksInYear from 'dayjs/plugin/isoWeeksInYear'
+import weekYear from 'dayjs/plugin/weekYear'
+import weekday from 'dayjs/plugin/weekday'
+import pluralGetSet from 'dayjs/plugin/pluralGetSet'
+import updateLocale from 'dayjs/plugin/updateLocale'
+import bigIntSupport from 'dayjs/plugin/bigIntSupport'
+import isLeapYear from 'dayjs/plugin/isLeapYear'
+// these install no new members - they add format tokens or change existing behaviour - so the
+// only signature they expose is PluginFunc itself, which dayjs.extend checks below
+import advancedFormat from 'dayjs/plugin/advancedFormat'
+import localizedFormat from 'dayjs/plugin/localizedFormat'
+import buddhistEra from 'dayjs/plugin/buddhistEra'
+import negativeYear from 'dayjs/plugin/negativeYear'
+import devHelper from 'dayjs/plugin/devHelper'
+import badMutable from 'dayjs/plugin/badMutable'
+import preParsePostFormat from 'dayjs/plugin/preParsePostFormat'
+
+dayjs.extend(isMoment)
+dayjs.extend(isSameOrAfter)
+dayjs.extend(isSameOrBefore)
+dayjs.extend(isToday)
+dayjs.extend(isTomorrow)
+dayjs.extend(isYesterday)
+dayjs.extend(isoWeek)
+dayjs.extend(isoWeeksInYear)
+dayjs.extend(weekYear)
+dayjs.extend(weekday)
+dayjs.extend(pluralGetSet)
+dayjs.extend(updateLocale)
+dayjs.extend(bigIntSupport)
+dayjs.extend(isLeapYear)
+dayjs.extend(advancedFormat)
+dayjs.extend(localizedFormat)
+dayjs.extend(buddhistEra)
+dayjs.extend(negativeYear)
+dayjs.extend(devHelper)
+dayjs.extend(badMutable)
+dayjs.extend(preParsePostFormat)
+
+const d: Dayjs = dayjs()
+
+// --- predicates all return boolean ---
+const moment: boolean = dayjs.isMoment(d)
+const sameOrAfter: boolean = d.isSameOrAfter(dayjs())
+const sameOrAfterUnit: boolean = d.isSameOrAfter(dayjs(), 'day')
+const sameOrBefore: boolean = d.isSameOrBefore(dayjs(), 'month')
+const today: boolean = d.isToday()
+const tomorrow: boolean = d.isTomorrow()
+const yesterday: boolean = d.isYesterday()
+const leapYear: boolean = d.isLeapYear()
+
+// @ts-expect-error isToday takes no argument
+d.isToday('2019-01-25')
+// @ts-expect-error isToday returns a boolean, not a Dayjs
+const todayIsNotDayjs: Dayjs = d.isToday()
+
+// --- iso week family: getters return number, setters return Dayjs ---
+const isoWeekNumber: number = d.isoWeek()
+const isoWeekSet: Dayjs = d.isoWeek(2)
+const isoWeekYearNumber: number = d.isoWeekYear()
+const isoWeekdayNumber: number = d.isoWeekday()
+const isoWeekdaySet: Dayjs = d.isoWeekday(1)
+const isoWeeks: number = d.isoWeeksInYear()
+const weekYearNumber: number = d.weekYear()
+const weekdayNumber: number = d.weekday()
+const weekdaySet: Dayjs = d.weekday(1)
+
+// @ts-expect-error the no-argument overload returns a number, not a Dayjs
+const isoWeekGetIsNotDayjs: Dayjs = d.isoWeek()
+// @ts-expect-error the setter overload returns a Dayjs, not a number
+const isoWeekSetIsNotNumber: number = d.isoWeek(2)
+
+// --- pluralGetSet: every alias is a getter/setter pair ---
+const years: number = d.years()
+const yearsSet: Dayjs = d.years(2020)
+const months: number = d.months()
+const monthsSet: Dayjs = d.months(2)
+const dates: number = d.dates()
+const days: number = d.days()
+const hours: number = d.hours()
+const minutes: number = d.minutes()
+const seconds: number = d.seconds()
+const milliseconds: number = d.milliseconds()
+
+// @ts-expect-error the getter overload returns a number, not a Dayjs
+const yearsGetIsNotDayjs: Dayjs = d.years()
+
+// --- updateLocale and bigIntSupport statics ---
+const updated: Record<string, unknown> = dayjs.updateLocale('en', { weekStart: 1 })
+const fromBigInt: Dayjs = dayjs.unix(BigInt(1548381600))
+
+// @ts-expect-error updateLocale needs the locale name as a string
+dayjs.updateLocale(42, { weekStart: 1 })
+
+export default [
+  moment, sameOrAfter, sameOrAfterUnit, sameOrBefore, today, tomorrow, yesterday, leapYear,
+  todayIsNotDayjs,
+  isoWeekNumber, isoWeekSet, isoWeekYearNumber, isoWeekdayNumber, isoWeekdaySet, isoWeeks,
+  weekYearNumber, weekdayNumber, weekdaySet, isoWeekGetIsNotDayjs, isoWeekSetIsNotNumber,
+  years, yearsSet, months, monthsSet, dates, days, hours, minutes, seconds, milliseconds,
+  yearsGetIsNotDayjs,
+  updated, fromBigInt
+]
diff --git a/test/types/plugin.type-test.ts b/test/types/plugin.type-test.ts
new file mode 100644
index 0000000..71dbcc0
--- /dev/null
+++ b/test/types/plugin.type-test.ts
@@ -0,0 +1,172 @@
+// Signature agreement for the plugin declarations. Same contract as core.type-test.ts: every
+// annotated binding checks a declared return type, and every `@ts-expect-error` must really be
+// an error. Plugins are covered here where their signatures carry actual structure - unions,
+// optional trailing flags, overloads that switch return type on arity - since those are where a
+// declaration can be wrong in a way member-existence checking cannot see.
+
+import dayjs, { Dayjs } from 'dayjs'
+import utc from 'dayjs/plugin/utc'
+import timezone from 'dayjs/plugin/timezone'
+import duration, { Duration } from 'dayjs/plugin/duration'
+import relativeTime from 'dayjs/plugin/relativeTime'
+import customParseFormat from 'dayjs/plugin/customParseFormat'
+import isBetween from 'dayjs/plugin/isBetween'
+import minMax from 'dayjs/plugin/minMax'
+import weekOfYear from 'dayjs/plugin/weekOfYear'
+import quarterOfYear from 'dayjs/plugin/quarterOfYear'
+import isLeapYear from 'dayjs/plugin/isLeapYear'
+import dayOfYear from 'dayjs/plugin/dayOfYear'
+import toArray from 'dayjs/plugin/toArray'
+import toObject from 'dayjs/plugin/toObject'
+import calendar from 'dayjs/plugin/calendar'
+import localeData from 'dayjs/plugin/localeData'
+import objectSupport from 'dayjs/plugin/objectSupport'
+import arraySupport from 'dayjs/plugin/arraySupport'
+
+dayjs.extend(utc)
+dayjs.extend(timezone)
+dayjs.extend(duration)
+dayjs.extend(relativeTime)
+dayjs.extend(customParseFormat)
+dayjs.extend(isBetween)
+dayjs.extend(minMax)
+dayjs.extend(weekOfYear)
+dayjs.extend(quarterOfYear)
+dayjs.extend(isLeapYear)
+dayjs.extend(dayOfYear)
+dayjs.extend(toArray)
+dayjs.extend(toObject)
+dayjs.extend(calendar)
+dayjs.extend(localeData)
+dayjs.extend(objectSupport)
+dayjs.extend(arraySupport)
+
+const d: Dayjs = dayjs()
+
+// --- utc ---
+const utcNow: Dayjs = dayjs.utc()
+const utcFrom: Dayjs = dayjs.utc('2019-01-25')
+const toUtc: Dayjs = d.utc()
+const toUtcKeep: Dayjs = d.utc(true)
+const toLocal: Dayjs = d.local()
+const isUtc: boolean = d.isUTC()
+const offset: number = d.utcOffset()
+const offsetSet: Dayjs = d.utcOffset(120)
+
+// @ts-expect-error isUTC returns a boolean, not a Dayjs
+const isUtcIsNotDayjs: Dayjs = d.isUTC()
+
+// --- timezone ---
+const inZone: Dayjs = d.tz('America/New_York')
+const inZoneKeep: Dayjs = d.tz('America/New_York', true)
+const tzFrom: Dayjs = dayjs.tz('2019-01-25', 'America/New_York')
+const guessed: string = dayjs.tz.guess()
+dayjs.tz.setDefault('America/New_York')
+
+// @ts-expect-error guess returns the zone name as a string, not a Dayjs
+const guessIsNotDayjs: Dayjs = dayjs.tz.guess()
+
+// --- duration ---
+const dur: Duration = dayjs.duration(1, 'day')
+const durFromMs: Duration = dayjs.duration(1000)
+const durFromISO: Duration = dayjs.duration('P1Y2M3DT4H5M6S')
+const durFromObject: Duration = dayjs.duration({ days: 2, hours: 3 })
+const durHours: number = dur.asHours()
+const durHumanized: string = dur.humanize()
+const durHumanizedSuffix: string = dur.humanize(true)
+const durAdded: Duration = dur.add(1, 'day')
+const durISO: string = dur.toISOString()
+
+// @ts-expect-error asHours returns a number, not a string
+const asHoursIsNotString: string = dur.asHours()
+
+// --- relativeTime ---
+const fromNow: string = d.fromNow()
+const fromNowNoSuffix: string = d.fromNow(true)
+const fromOther: string = d.from(dayjs())
+const toOther: string = d.to(dayjs(), true)
+const toNow: string = d.toNow()
+
+// @ts-expect-error fromNow returns a formatted string, not a Dayjs
+const fromNowIsNotDayjs: Dayjs = d.fromNow()
+
+// --- customParseFormat ---
+const parsed: Dayjs = dayjs('25/01/2019', 'DD/MM/YYYY')
+const parsedStrict: Dayjs = dayjs('25/01/2019', 'DD/MM/YYYY', true)
+const parsedLocale: Dayjs = dayjs('25/01/2019', 'DD/MM/YYYY', 'en', true)
+const parsedFormats: Dayjs = dayjs('25/01/2019', ['DD/MM/YYYY', 'YYYY-MM-DD'])
+
+// --- isBetween: the inclusivity argument is a four-member union, not any string ---
+const between: boolean = d.isBetween(dayjs(), dayjs())
+const betweenUnit: boolean = d.isBetween(dayjs(), dayjs(), 'day')
+const betweenInclusive: boolean = d.isBetween(dayjs(), dayjs(), 'day', '[]')
+const betweenHalfOpen: boolean = d.isBetween(dayjs(), dayjs(), null, '[)')
+
+// @ts-expect-error '<>' is not one of '()' '[]' '[)' '(]'
+d.isBetween(dayjs(), dayjs(), 'day', '<>')
+
+// --- minMax: nullability tracks whether the argument is provably non-empty ---
+const maxOfArgs: Dayjs = dayjs.max(dayjs(), dayjs())
+const minOfArgs: Dayjs = dayjs.min(dayjs(), dayjs())
+// a literal array matches the non-empty tuple overload `[Dayjs, ...Dayjs[]]`, so it is not
+// nullable - this is the TS 3.0 syntax that the old pinned compiler could not even parse
+const maxOfLiteral: Dayjs = dayjs.max([dayjs(), dayjs()])
+// a value merely typed Dayjs[] might be empty, so that overload does return null
+const maybeEmpty: Dayjs[] = [dayjs(), dayjs()]
+const maxOfMaybeEmpty: Dayjs | null = dayjs.max(maybeEmpty)
+
+// @ts-expect-error a Dayjs[] may be empty, so the result is nullable and not a bare Dayjs
+const maxMaybeIsNotDayjs: Dayjs = dayjs.max(maybeEmpty)
+
+// --- getter/setter pairs switch return type on arity ---
+const weekNumber: number = d.week()
+const weekSet: Dayjs = d.week(2)
+const quarterNumber: number = d.quarter()
+const quarterSet: Dayjs = d.quarter(2)
+const dayOfYearNumber: number = d.dayOfYear()
+const dayOfYearSet: Dayjs = d.dayOfYear(100)
+const leap: boolean = d.isLeapYear()
+
+// @ts-expect-error the no-argument overload returns a number, not a Dayjs
+const weekGetIsNotDayjs: Dayjs = d.week()
+// @ts-expect-error the setter overload returns a Dayjs, not a number
+const weekSetIsNotNumber: number = d.week(2)
+
+// --- toArray / toObject shapes ---
+const arr: number[] = d.toArray()
+const obj: { years: number, months: number, date: number, hours: number,
+  minutes: number, seconds: number, milliseconds: number } = d.toObject()
+
+// --- calendar ---
+const cal: string = d.calendar()
+const calRef: string = d.calendar(dayjs())
+const calFormats: string = d.calendar(null, { sameDay: '[Today at] h:mm A' })
+
+// --- localeData ---
+const months: string[] = dayjs.months()
+const weekdays: string[] = dayjs.weekdays()
+const ld = d.localeData()
+const ldMonths: string[] = ld.months()
+const firstDayOfWeek: number = ld.firstDayOfWeek()
+
+// --- objectSupport and arraySupport widen the constructor and the manipulators ---
+const fromObject: Dayjs = dayjs({ year: 2019, month: 0, day: 25 })
+const fromArray: Dayjs = dayjs([2019, 0, 25])
+const setObject: Dayjs = d.set({ year: 2020 })
+const addObject: Dayjs = d.add({ days: 2 })
+
+export default [
+  utcNow, utcFrom, toUtc, toUtcKeep, toLocal, isUtc, offset, offsetSet, isUtcIsNotDayjs,
+  inZone, inZoneKeep, tzFrom, guessed, guessIsNotDayjs,
+  dur, durFromMs, durFromISO, durFromObject, durHours, durHumanized, durHumanizedSuffix,
+  durAdded, durISO, asHoursIsNotString,
+  fromNow, fromNowNoSuffix, fromOther, toOther, toNow, fromNowIsNotDayjs,
+  parsed, parsedStrict, parsedLocale, parsedFormats,
+  between, betweenUnit, betweenInclusive, betweenHalfOpen,
+  maxOfArgs, minOfArgs, maxOfLiteral, maybeEmpty, maxOfMaybeEmpty, maxMaybeIsNotDayjs,
+  weekNumber, weekSet, quarterNumber, quarterSet, dayOfYearNumber, dayOfYearSet, leap,
+  weekGetIsNotDayjs, weekSetIsNotNumber,
+  arr, obj, cal, calRef, calFormats,
+  months, weekdays, ldMonths, firstDayOfWeek,
+  fromObject, fromArray, setObject, addObject
+]
diff --git a/tsconfig.json b/tsconfig.json
new file mode 100644
index 0000000..60a6d34
--- /dev/null
+++ b/tsconfig.json
@@ -0,0 +1,18 @@
+{
+  "//": "Type-checks the declarations shipped in types/. It compiles nothing: the library itself is JavaScript built by build/index.js. Run it with `npm run type-check`. `paths` maps the 'dayjs' specifier the plugin declarations import to the source declaration, because the root index.d.ts they resolve to once published is a build artifact copied from types/ by build/index.js. `types: []` keeps the check hermetic by not auto-including every @types package in node_modules. skipLibCheck is deliberately off: every file being checked here is a .d.ts, so turning it on would make this gate check nothing.",
+  "compilerOptions": {
+    "noEmit": true,
+    "strict": true,
+    "target": "es2020",
+    "module": "node16",
+    "moduleResolution": "node16",
+    "forceConsistentCasingInFileNames": true,
+    "types": [],
+    "paths": {
+      "dayjs": ["./types/index.d.ts"],
+      "dayjs/plugin/*": ["./types/plugin/*"],
+      "dayjs/locale/*": ["./types/locale/*"]
+    }
+  },
+  "include": ["types/**/*.d.ts", "test/types/**/*.ts"]
+}
