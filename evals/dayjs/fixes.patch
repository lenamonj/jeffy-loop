+  (eifelerRegelAppliesToNumber(leadingToken(string)) ? 'a ' : 'an ') + string
+
+const processPastTime = string =>
+  (eifelerRegelAppliesToNumber(leadingToken(string)) ? 'viru ' : 'virun ') + string
+
