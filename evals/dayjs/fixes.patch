diff --git a/test/plugin/interaction.test.js b/test/plugin/interaction.test.js
new file mode 100644
index 0000000..9f27585
--- /dev/null
+++ b/test/plugin/interaction.test.js
@@ -0,0 +1,189 @@
+import fs from 'fs'
+import path from 'path'
+
+// Extend order must not change behaviour. Which plugins are installed is the contract; the
+// sequence they were installed in is not, because a consumer's import order is arbitrary and
+// bundlers reorder it freely. Order can only matter where two plugins wrap the same core
+// method, so this enumerates exactly those collisions from the source rather than from a list
+// somebody has to remember to update, and runs each colliding pair in both orders.
+//
+// This is the check that would have caught F2 (quarterOfYear vs objectSupport on `add`) and
+// F11 (preParsePostFormat vs relativeTime on `fromToBase`): each test file fixes one order at
+// module scope, and the suite happened to pick the safe one.
+
+const SRC_PLUGIN = path.join(__dirname, '../../src/plugin')
+
+const pluginNames = fs.readdirSync(SRC_PLUGIN)
+  .filter(p => fs.existsSync(path.join(SRC_PLUGIN, p, 'index.js')))
+  .sort()
+
+// Plugins that cannot stand alone. timezone is built on utc and reads dayjs.utc directly.
+const REQUIRES = { timezone: ['utc'] }
+
+// Every prototype method a plugin ASSIGNS, not merely every one it wraps. Searching for the
+// `const old = proto.x` wrapper form alone misses the plain replacement `proto.x = ...`, which
+// is the more dangerous shape precisely because it discards whatever a previously extended
+// plugin installed. badMutable replaces `set` that way and captures nothing, so a wrapper-only
+// search never lists `set` as contested at all. A class is only as wide as the search that
+// enumerated it, so this matches the assignment.
+const assignedMethods = (name) => {
+  const text = fs.readFileSync(path.join(SRC_PLUGIN, name, 'index.js'), 'utf8')
+  const found = new Set()
+  // `[\w$]`, not `\w`: dayjs's internals are `$`-prefixed (`$g`, `$set`, `$utils`) and `\w` does
+  // not match `$`, so a plain `\w+` silently skips every one of them
+  const re = /(?:proto|\w+\.prototype)\.([\w$]+)\s*=[^=]/g
+  let m = re.exec(text)
+  while (m) { found.add(m[1]); m = re.exec(text) }
+  return [...found]
+}
+
+// null-prototype: plugins assign `valueOf` and `toString`, which on a plain object literal
+// resolve to the inherited Object.prototype functions rather than to undefined
+const byMethod = Object.create(null)
+pluginNames.forEach((name) => {
+  assignedMethods(name).forEach((method) => {
+    byMethod[method] = (byMethod[method] || []).concat(name)
+  })
+})
+
+// only methods more than one plugin wraps can be order-sensitive
+const collisions = Object.keys(byMethod)
+  .filter(m => byMethod[m].length > 1)
+  .sort()
+
+const pairs = []
+collisions.forEach((method) => {
+  const list = byMethod[method]
+  for (let i = 0; i < list.length; i += 1) {
+    for (let j = i + 1; j < list.length; j += 1) {
+      pairs.push({ method, a: list[i], b: list[j] })
+    }
+  }
+})
+
+const withDeps = (plugins) => {
+  const out = []
+  plugins.forEach((p) => {
+    (REQUIRES[p] || []).forEach((dep) => { if (out.indexOf(dep) === -1) out.push(dep) })
+    if (out.indexOf(p) === -1) out.push(p)
+  })
+  return out
+}
+
+const load = (plugins) => {
+  jest.resetModules()
+  const d = require('../../src').default // eslint-disable-line global-require
+  withDeps(plugins).forEach((p) => {
+    d.extend(require(`../../src/plugin/${p}`).default) // eslint-disable-line global-require, import/no-dynamic-require
+  })
+  return d
+}
+
+// Each probe returns its value or its error text, so an order-dependent throw is compared the
+// same way an order-dependent value is. A pair that throws in both orders identically is not a
+// finding here; a pair that differs between orders is.
+const attempt = (fn) => {
+  try {
+    return String(fn())
+  } catch (e) {
+    return `ERR: ${e.message}`
+  }
+}
+
+const ISO = '2019-06-15T12:34:56.789Z'
+
+// The generic calls below would not have caught F2. That defect was quarterOfYear's `add`
+// wrapper coercing its argument with Number() before delegating, which turns objectSupport's
+// `add({months: 1})` into NaN but leaves `add(1, 'month')` untouched. So the battery has to
+// drive each plugin's own accepted input shapes, not just the core ones every plugin shares.
+// A probe for an absent plugin throws, and its error text is compared across the two orders
+// exactly like a value, so those entries still assert something rather than being skipped.
+const probe = d => [
+  // core shapes, shared by every plugin
+  attempt(() => d(ISO).format()),
+  attempt(() => d(ISO).format('YYYY-MM-DD HH:mm:ss.SSS')),
+  attempt(() => d('2019-01-31').add(1, 'month').format('YYYY-MM-DD')),
+  attempt(() => d('2019-03-31').subtract(1, 'month').format('YYYY-MM-DD')),
+  attempt(() => d(ISO).startOf('month').format()),
+  attempt(() => d(ISO).startOf('year').format()),
+  attempt(() => d(ISO).startOf('day').format()),
+  attempt(() => d(ISO).endOf('month').format()),
+  attempt(() => d(ISO).diff(d('2018-01-01'), 'day')),
+  attempt(() => d(ISO).diff(d('2018-01-01'), 'month')),
+  attempt(() => d(ISO).valueOf()),
+  attempt(() => d(ISO).set('month', 2).format('YYYY-MM-DD')),
+  attempt(() => d(ISO).isSame(d(ISO))),
+  attempt(() => d('2019-06-15').isBefore(d('2019-06-16'))),
+  // objectSupport: the argument shape F2 turned into NaN
+  attempt(() => d(ISO).add({ months: 1 }).format('YYYY-MM-DD')),
+  attempt(() => d(ISO).subtract({ days: 3 }).format('YYYY-MM-DD')),
+  attempt(() => d(ISO).set({ month: 2 }).format('YYYY-MM-DD')),
+  attempt(() => d({ year: 2019, month: 5, day: 15 }).format('YYYY-MM-DD')),
+  // duration: the other non-numeric argument `add` and `subtract` accept
+  attempt(() => d(ISO).add(d.duration(1, 'day')).format('YYYY-MM-DD')),
+  attempt(() => d(ISO).subtract(d.duration(2, 'hours')).format()),
+  // quarterOfYear, isoWeek: units core does not know
+  attempt(() => d(ISO).add(1, 'quarter').format('YYYY-MM-DD')),
+  attempt(() => d(ISO).startOf('quarter').format()),
+  attempt(() => d(ISO).endOf('quarter').format()),
+  attempt(() => d(ISO).startOf('isoWeek').format()),
+  // arraySupport, bigIntSupport, negativeYear, customParseFormat: constructor shapes
+  attempt(() => d([2019, 5, 15]).format('YYYY-MM-DD')),
+  attempt(() => d('15/06/2019', 'DD/MM/YYYY').format('YYYY-MM-DD')),
+  attempt(() => d('-000001-06-15').format('YYYY-MM-DD')),
+  // utc and timezone
+  attempt(() => d(ISO).utc().format()),
+  attempt(() => d(ISO).utcOffset()),
+  // token sets other plugins install
+  attempt(() => d(ISO).format('Do Q')),
+  attempt(() => d(ISO).format('LLLL')),
+  attempt(() => d(ISO).format('BBBB'))
+]
+
+let warn
+beforeAll(() => {
+  // devHelper writes advisory warnings on every parse; they are not the subject here
+  ({ warn } = console)
+  console.warn = () => {}
+})
+afterAll(() => { console.warn = warn })
+
+it('enumerates the collisions this sweep is meant to cover', () => {
+  expect(pluginNames.length).toBe(37)
+  // a new plugin touching a method another plugin touches must widen this sweep, so the shape
+  // of the enumeration is asserted rather than merely computed
+  expect(collisions).toContain('set')
+  expect(collisions).toContain('format')
+  expect(collisions).toContain('parse')
+  expect(pairs.length).toBeGreaterThanOrEqual(52)
+})
+
+// Pairs whose behaviour still depends on extend order, each tracked in BACKLOG.md. This map may
+// only shrink: a new key is a regression, and closing the task removes its entry. It is checked
+// in both directions, so a pair listed here that has been fixed also fails until its entry goes.
+// It is empty: every contested pair now behaves identically in both extend orders. Any pair that
+// becomes order-dependent fails outright rather than being absorbed here.
+const KNOWN_ORDER_DEPENDENT = {}
+
+const keyOf = (a, b) => [a, b].sort().join('+')
+
+describe('extend order does not change behaviour', () => {
+  pairs.forEach(({ method, a, b }) => {
+    it(`${a} + ${b} (both touch ${method})`, () => {
+      const first = probe(load([a, b]))
+      const second = probe(load([b, a]))
+      if (KNOWN_ORDER_DEPENDENT[keyOf(a, b)]) {
+        // asserted to still differ, so fixing it fails here until the entry is removed
+        expect(first).not.toEqual(second)
+      } else {
+        expect(first).toEqual(second)
+      }
+    })
+  })
+})
+
+it('every known order-dependent pair is a real pair this sweep covers', () => {
+  const covered = pairs.map(p => keyOf(p.a, p.b))
+  // a stale allowlist entry naming a pair that no longer exists would silently excuse nothing
+  expect(Object.keys(KNOWN_ORDER_DEPENDENT).filter(k => covered.indexOf(k) === -1)).toEqual([])
+})
