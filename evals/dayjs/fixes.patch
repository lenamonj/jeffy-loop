+
+it('be uses the Belarusian standalone form for February', () => {
+  // F27. The standalone arm had a Russian style adjectival form where Belarusian, moment and
+  // CLDR all have the short one, and the short format arm carried a stray period on December
+  // that its own sibling arm and all 11 other entries do not have.
+  expect(KNOWN_MONTH_NAME_DIFFERENCES.be).toBeUndefined()
