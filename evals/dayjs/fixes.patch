diff --git a/test/build.test.js b/test/build.test.js
new file mode 100644
index 0000000..7364523
--- /dev/null
+++ b/test/build.test.js
@@ -0,0 +1,114 @@
+import fs from 'fs'
+import os from 'os'
+import path from 'path'
+import { execFileSync } from 'child_process'
+
+// The published contract for every UMD bundle is that the bundle *is* its default export:
+// `require('dayjs/locale/de')` returns the locale object, not a namespace wrapping it. Rollup
+// decides that per entry by auto-detecting the entry's exports, so a single stray named export
+// silently changes the shape of that one artifact while its source still looks like all its
+// siblings. That is what shipped for `ku`: `require('dayjs/locale/ku')` was
+// `{default, englishToArabicNumbersMap}`, so `dayjs.locale(require('dayjs/locale/ku'))` found no
+// `name`, returned the previously active locale and switched nothing.
+//
+// build/rollup.config.js now pins `output.exports: 'default'`, which makes rollup fail the build
+// on a stray named export instead of reshaping the artifact. This is the same guarantee checked
+// at the source, so it fails in `npm test` rather than only in a release build.
+
+const SRC = path.join(__dirname, '../src')
+
+const localeEntries = fs.readdirSync(path.join(SRC, 'locale'))
+  .filter(f => f.endsWith('.js'))
+  .map(f => path.join(SRC, 'locale', f))
+
+const pluginEntries = fs.readdirSync(path.join(SRC, 'plugin'))
+  .map(p => path.join(SRC, 'plugin', p, 'index.js'))
+  .filter(f => fs.existsSync(f))
+
+// exactly the entries build/index.js feeds to rollup
+const entries = [path.join(SRC, 'index.js')].concat(localeEntries, pluginEntries)
+
+const rel = f => path.relative(SRC, f).replace(/\\/g, '/')
+const linesOf = f => fs.readFileSync(f, 'utf8').split(/\r?\n/)
+
+const namedExportsIn = f => linesOf(f)
+  .map(l => (l.match(/^export\s+(?:const|let|var|function|class)\s+([A-Za-z_$][\w$]*)/) || [])[1])
+  .filter(Boolean)
+
+const hasDefaultExport = f => linesOf(f).some(l => /^export default\s/.test(l))
+
+// A build that fails must fail loudly. .github/workflows/release.yml runs
+// `npm run build && npm run babel` and publishes immediately after, with nothing in between
+// that inspects the artifacts, so a script which logs its error and exits 0 ships whatever
+// happened to be on disk. Both scripts did exactly that. Each is run here in a directory where
+// its inputs cannot resolve, which is the cheapest way to reach the failure path for real
+// rather than mocking it.
+const runInEmptyDir = (script, env) => {
+  const cwd = fs.mkdtempSync(path.join(os.tmpdir(), 'dayjs-build-'))
+  const result = { status: 0, output: '', cwd }
+  try {
+    execFileSync(process.execPath, [path.join(__dirname, '..', 'build', script)], {
+      cwd,
+      env: Object.assign({}, process.env, { PWD: cwd }, env),
+      encoding: 'utf8',
+      stdio: 'pipe'
+    })
+  } catch (e) {
+    result.status = e.status
+    result.output = `${e.stdout || ''}${e.stderr || ''}`
+  } finally {
+    fs.rmSync(cwd, { recursive: true, force: true })
+  }
+  return result
+}
+
+it('build/index.js exits non-zero when the build fails', () => {
+  const { status, output } = runInEmptyDir('index.js')
+  // the real failure, not an incidental one such as a missing interpreter
+  expect(output).toContain('Could not resolve entry module')
+  expect(status).not.toBe(0)
+}, 120000)
+
+it('build/esm.js exits non-zero when the build fails', () => {
+  const { status, output } = runInEmptyDir('esm.js')
+  expect(output).toContain('ENOENT')
+  expect(status).not.toBe(0)
+}, 120000)
+
+// build/esm.js used to derive every path from process.env.PWD, which POSIX shells set and
+// neither cmd.exe nor PowerShell does, so on Windows path.join got undefined and the script
+// threw before doing any work. Pointing PWD somewhere other than the cwd shows which one it
+// actually follows, which an unset-PWD check alone would not.
+it('build/esm.js resolves paths from the process cwd, not the PWD variable', () => {
+  const decoy = fs.mkdtempSync(path.join(os.tmpdir(), 'dayjs-decoy-'))
+  try {
+    const { status, output, cwd } = runInEmptyDir('esm.js', { PWD: decoy })
+    expect(status).not.toBe(0)
+    expect(output).toContain(path.join(cwd, 'esm', 'locale'))
+    expect(output).not.toContain(decoy)
+  } finally {
+    fs.rmSync(decoy, { recursive: true, force: true })
+  }
+}, 120000)
+
+it('build/index.js feeds rollup the entries this file checks', () => {
+  expect(localeEntries.length).toBe(143)
+  expect(pluginEntries.length).toBe(37)
+  expect(entries.length).toBe(181)
+})
+
+it('every bundled entry has a default export', () => {
+  // positive control: proves the export matcher reads these files, so the named-export
+  // assertion below is a real check rather than a regex that silently matches nothing
+  expect(entries.filter(f => !hasDefaultExport(f)).map(rel)).toEqual([])
+})
+
+it('no bundled entry has a named export', () => {
+  const offenders = {}
+  entries.forEach((f) => {
+    const named = namedExportsIn(f)
+    if (named.length) offenders[rel(f)] = named
+  })
+  // a named export here silently turns that one bundle into a namespace object
+  expect(offenders).toEqual({})
+})
