+// This asks the question the class is actually about, which punctuation is irrelevant to: does
+// dayjs start a name with a capital where moment does not?
+const startsUpper = (s) => {
+  if (!s) return false
+  const c = s.charAt(0)
+  // True only in a script that has case at all. In Arabic, Hebrew, CJK or Devanagari the upper
+  // and lower forms are the same character, so those locales can never be flagged by accident.
+  return c.toLocaleLowerCase() !== c && c.toLocaleUpperCase() === c
