+// Eifeler Regel: the word before a number keeps or loses its '-n' ending
+// depending on the number's leading sound, e.g. 'an 10 Deeg' but 'a 5 Deeg'.
+// The rule is decided by a single digit, so multi-digit numbers recurse.
+const eifelerRegelAppliesToNumber = (input) => {
+  const n = parseInt(input, 10)
+  if (n < 0) return true // a negative number always takes the short form
+  if (n < 10) return n >= 4 && n <= 7
+  if (n < 100) {
+    const lastDigit = n % 10
+    return eifelerRegelAppliesToNumber(lastDigit === 0 ? n / 10 : lastDigit)
+  }
+  if (n < 10000) { // 3 or 4 digits: decided by the leading digit
+    let head = n
+    while (head >= 10) head /= 10
+    return eifelerRegelAppliesToNumber(head)
+  }
+  if (n >= 10000) return eifelerRegelAppliesToNumber(n / 1000)
+  // parseInt found no number, as in 'enger Minutt'; NaN fails every test above
+  return false
+}
+
