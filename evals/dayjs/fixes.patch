diff --git a/test/plugin/customParseFormat-meridiem.test.js b/test/plugin/customParseFormat-meridiem.test.js
new file mode 100644
index 0000000..208c4d6
--- /dev/null
+++ b/test/plugin/customParseFormat-meridiem.test.js
@@ -0,0 +1,118 @@
+import fs from 'fs'
+import path from 'path'
+import moment from 'moment'
+import dayjs from '../../src'
+import customParseFormat from '../../src/plugin/customParseFormat'
+
+dayjs.extend(customParseFormat)
+
+// F34. Parsing the A or a token back used to infer AM/PM from the index of a probe hour rather
+// than from which arm of the locale's meridiem matched, so a time formatted by dayjs and parsed
+// straight back came out 12 hours off for every locale that defines one. English was unaffected
+// because it takes the branch for locales with no meridiem at all, which is why a suite with
+// full line coverage never saw it.
+
+const localeDir = path.join(__dirname, '../../src/locale')
+const localeNames = fs.readdirSync(localeDir)
+  .filter(f => f.endsWith('.js'))
+  .map(f => f.replace('.js', ''))
+
+localeNames.forEach((name) => {
+  // eslint-disable-next-line import/no-dynamic-require, global-require
+  require(path.join(localeDir, `${name}.js`))
+})
+
+const withMeridiem = localeNames.filter(name => typeof dayjs.Ls[name].meridiem === 'function')
+
+// Hours spanning both sides of noon plus the two boundaries that the old index-based scan got
+// wrong: 0, which it never probed, and 12, where `i > 12` is false.
+const HOURS = [0, 6, 11, 12, 13, 18, 23]
+const PATTERN = 'YYYY-MM-DD h:mm A'
+const at = hour => `2019-04-15T${String(hour).padStart(2, '0')}:30:00`
+
+describe('customParseFormat round-trips the meridiem', () => {
+  it('covers a meaningful number of locales', () => {
+    // An empty or tiny set would make every assertion below vacuous.
+    expect(withMeridiem.length).toBeGreaterThan(30)
+    expect(withMeridiem).toContain('hi')
+    expect(withMeridiem).toContain('ja')
+    expect(withMeridiem).toContain('ar')
+  })
+
+  it('preserves the hour for every locale that defines a meridiem', () => {
+    const failures = []
+    withMeridiem.forEach((name) => {
+      HOURS.forEach((hour) => {
+        const rendered = dayjs(at(hour)).locale(name).format(PATTERN)
+        const parsed = dayjs(rendered, PATTERN, name)
+        if (!parsed.isValid() || parsed.hour() !== hour) {
+          failures.push(`${name} ${hour} -> ${parsed.isValid() ? parsed.hour() : 'invalid'} from ${rendered}`)
+        }
+      })
+    })
+    expect(failures).toEqual([])
+  })
+
+  it('preserves the hour for English, which takes the no-meridiem branch', () => {
+    HOURS.forEach((hour) => {
+      const rendered = dayjs(at(hour)).format(PATTERN)
+      expect(`en ${hour} ${dayjs(rendered, PATTERN).hour()}`).toBe(`en ${hour} ${hour}`)
+    })
+  })
+
+  it('reads the afternoon term at noon, where the old index scan read morning', () => {
+    // The two-arm case. `ar` turns over at noon, so its afternoon term first appears at hour 12
+    // and the old `i > 12` test rejected it there.
+    const noon = dayjs(at(12)).locale('ar').format(PATTERN)
+    expect(dayjs(noon, PATTERN, 'ar').hour()).toBe(12)
+    const midnight = dayjs(at(0)).locale('ar').format(PATTERN)
+    expect(dayjs(midnight, PATTERN, 'ar').hour()).toBe(0)
+  })
+
+  it('reads a midday term that starts before noon', () => {
+    // The multi-arm case. hi's midday term covers 10:00 to 16:59, so it first matched at i=10
+    // and every afternoon hour parsed as morning.
+    expect(dayjs(dayjs(at(13)).locale('hi').format(PATTERN), PATTERN, 'hi').hour()).toBe(13)
+    expect(dayjs(dayjs(at(11)).locale('hi').format(PATTERN), PATTERN, 'hi').hour()).toBe(11)
+  })
+
+  it('reads a meridiem of more than one word', () => {
+    // matchWord stops at whitespace, so si's two-word terms arrive truncated to the first word
+    // and have to be matched as a prefix of the candidate rather than by equality.
+    expect(dayjs.Ls.si.meridiem(15, 0, false)).toContain(' ')
+    expect(dayjs(dayjs(at(15)).locale('si').format(PATTERN), PATTERN, 'si').hour()).toBe(15)
+    expect(dayjs(dayjs(at(9)).locale('si').format(PATTERN), PATTERN, 'si').hour()).toBe(9)
+  })
+
+  it('agrees with moment on the parsed hour', () => {
+    // An independent reference. Restricted to locales moment renders with Latin digits: moment
+    // converts numerals through `postformat` for hi, bn, ar and km, which dayjs gates behind the
+    // opt-in preParsePostFormat plugin, so for those two the two libraries are not parsing the
+    // same string at all and the comparison would measure the digit system, not the meridiem.
+    const REFERENCE = ['ja', 'ko', 'zh-cn', 'el', 'ru', 'si', 'ml']
+    REFERENCE.forEach((name) => {
+      // eslint-disable-next-line import/no-dynamic-require, global-require
+      require(`moment/locale/${name}`)
+      expect(`${name} ${moment.localeData(name).postformat('12')}`).toBe(`${name} 12`)
+      HOURS.forEach((hour) => {
+        const rendered = moment(at(hour)).locale(name).format(PATTERN)
+        const parsed = dayjs(rendered, PATTERN, name)
+        const parsedByMoment = moment(rendered, PATTERN, name)
+        expect(`${name} ${hour} ${parsed.hour()}`).toBe(`${name} ${hour} ${parsedByMoment.hour()}`)
+      })
+    })
+  })
+
+  it('leaves the hour alone when the word matches neither candidate', () => {
+    // An unrecognised meridiem must not silently shift the hour in either direction.
+    expect(dayjs('2019-04-15 9:30 ZZZ', PATTERN, 'hi').hour()).toBe(9)
+    expect(dayjs('2019-04-15 12:30 ZZZ', PATTERN, 'hi').hour()).toBe(12)
+  })
+
+  it('still corrects a 12 to 0 for a plain AM', () => {
+    expect(dayjs('2019-04-15 12:30 AM', PATTERN).hour()).toBe(0)
+    expect(dayjs('2019-04-15 12:30 PM', PATTERN).hour()).toBe(12)
+    expect(dayjs('2019-04-15 12:30 am', 'YYYY-MM-DD h:mm a').hour()).toBe(0)
+    expect(dayjs('2019-04-15 12:30 pm', 'YYYY-MM-DD h:mm a').hour()).toBe(12)
+  })
+})
