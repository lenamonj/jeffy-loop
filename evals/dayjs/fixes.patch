diff --git a/test/locale/meridiem.test.js b/test/locale/meridiem.test.js
new file mode 100644
index 0000000..4b8a10b
--- /dev/null
+++ b/test/locale/meridiem.test.js
@@ -0,0 +1,283 @@
+import fs from 'fs'
+import path from 'path'
+import moment from 'moment'
+import { u } from '../../src/plugin/localizedFormat/utils'
+import dayjs from '../../src'
+import localizedFormat from '../../src/plugin/localizedFormat'
+
+dayjs.extend(localizedFormat)
+
+// The meridiem dimension, enumerated in both directions.
+//
+// An earlier sweep asked only whether every locale that defines `meridiem` behaves correctly.
+// It called all 20 of them and found nothing, because it never asked the converse: whether
+// every locale whose own `formats` patterns contain the A or a token actually defines one.
+// Fifteen did not, so core fell back to English and rendered AM or PM inside a native-script
+// date. This file asks both questions.
+
+const localeDir = path.join(__dirname, '../../src/locale')
+const localeNames = fs.readdirSync(localeDir)
+  .filter(f => f.endsWith('.js'))
+  .map(f => f.replace('.js', ''))
+
+localeNames.forEach((name) => {
+  // eslint-disable-next-line import/no-dynamic-require, global-require
+  require(path.join(localeDir, `${name}.js`))
+})
+
+const HOURS = Array.from({ length: 24 }, (_, h) => h)
+const FORMAT_KEYS = ['LT', 'LTS', 'L', 'LL', 'LLL', 'LLLL']
+
+const at = hour => `2019-04-15T${String(hour).padStart(2, '0')}:30:45`
+
+// A locale's patterns are expanded through localizedFormat's own `u`, because an L token may
+// resolve to a pattern that carries the meridiem token, and bracketed literals are stripped
+// because core's REGEX_FORMAT does not read a token inside brackets.
+const stripBrackets = s => s.replace(/\[[^\]]*]/g, '')
+const usesMeridiemToken = (name) => {
+  const { formats = {} } = dayjs.Ls[name]
+  return FORMAT_KEYS.some((k) => {
+    const raw = formats[k]
+    return raw !== undefined && /[Aa]/.test(stripBrackets(u(raw, formats)))
+  })
+}
+
+const definesMeridiem = name => typeof dayjs.Ls[name].meridiem === 'function'
+
+// Locales whose patterns carry the meridiem token and which deliberately define none, because
+// English AM/PM is what the reference gives for them. This list may only shrink: adding a
+// locale means a native-script date is rendering an English meridiem again.
+const MERIDIEM_NOT_REQUIRED = [
+  'bi', 'en', 'en-au', 'en-ca', 'en-nz', 'es-do', 'es-pr', 'es-us', 'yo'
+]
+
+// Locales moment does not ship, so no differential is possible. Asserted exactly, so a locale
+// cannot drop out of the comparison unnoticed.
+const NOT_IN_MOMENT = ['ar-iq', 'zh']
+
+// Locales that define `meridiem` and disagree with moment. Shrink-only, and every entry must
+// still really differ.
+const KNOWN_MERIDIEM_DIFFERENCES = {
+  'ar-kw': 'moment ships no Arabic meridiem here and falls back to English AM/PM',
+  'ar-ma': 'moment ships no Arabic meridiem here and falls back to English AM/PM',
+  'ar-tn': 'moment ships no Arabic meridiem here and falls back to English AM/PM',
+  ku: 'dayjs uses the abbreviations پ.ن and د.ن where moment spells the words out',
+  'zh-cn': 'dayjs distinguishes 中午 at noon, a real distinction Chinese makes and moment does not',
+  'zh-hk': 'dayjs distinguishes 中午 from 11:00, where moment stays on 上午',
+  'zh-tw': 'dayjs distinguishes 中午 at noon, a real distinction Chinese makes and moment does not'
+}
+
+// The locales this fix gave a meridiem, each ported from moment's own output. Listed rather
+// than derived so the differential below is pinned to a known set.
+const PORTED = [
+  'bn', 'bo', 'el', 'gom-latn', 'gu', 'hi', 'kn', 'ml',
+  'mr', 'ne', 'pa-in', 'si', 'ss', 'te'
+]
+
+const differsFromMoment = (name) => {
+  // eslint-disable-next-line import/no-dynamic-require, global-require
+  require(`moment/locale/${name}`)
+  return HOURS.some((h) => {
+    const d = dayjs(at(h)).locale(name)
+    const m = moment(at(h)).locale(name)
+    return d.format('A') !== m.format('A') || d.format('a') !== m.format('a')
+  })
+}
+
+describe('meridiem token scanner', () => {
+  it('finds the token it is looking for, and does not find a bracketed one', () => {
+    // A scan that finds nothing passes every emptiness assertion below it, so the scanner is
+    // validated on known positives and a known negative before its output is trusted.
+    expect(usesMeridiemToken('hi')).toBe(true)
+    expect(usesMeridiemToken('en-au')).toBe(true)
+    expect(usesMeridiemToken('ja')).toBe(false)
+    expect(/[Aa]/.test(stripBrackets(u('h:mm A', {})))).toBe(true)
+    expect(/[Aa]/.test(stripBrackets(u('h:mm [a]', {})))).toBe(false)
+    // The L tokens really are expanded, which is what makes LLL reachable through LT.
+    expect(/[Aa]/.test(stripBrackets(u('LT', { LT: 'h:mm A' })))).toBe(true)
+    expect(localeNames.filter(usesMeridiemToken).length).toBeGreaterThan(20)
+  })
+})
+
+describe('every locale needing a meridiem defines one', () => {
+  it('has no unlisted locale falling back to the English meridiem', () => {
+    const falling = localeNames
+      .filter(name => usesMeridiemToken(name) && !definesMeridiem(name))
+      .filter(name => MERIDIEM_NOT_REQUIRED.indexOf(name) === -1)
+    expect(falling).toEqual([])
+  })
+
+  it('keeps the allowlist exact in the other direction', () => {
+    MERIDIEM_NOT_REQUIRED.forEach((name) => {
+      expect(localeNames.indexOf(name)).toBeGreaterThan(-1)
+      expect(usesMeridiemToken(name)).toBe(true)
+      expect(definesMeridiem(name)).toBe(false)
+    })
+  })
+
+  it('renders AM and PM for the allowlisted locales, which is what the reference gives', () => {
+    MERIDIEM_NOT_REQUIRED.forEach((name) => {
+      expect(dayjs(at(9)).locale(name).format('A')).toBe('AM')
+      expect(dayjs(at(15)).locale(name).format('A')).toBe('PM')
+      expect(dayjs(at(9)).locale(name).format('a')).toBe('am')
+      expect(dayjs(at(15)).locale(name).format('a')).toBe('pm')
+    })
+  })
+})
+
+describe('meridiem output against moment', () => {
+  const comparable = localeNames
+    .filter(definesMeridiem)
+    .filter(name => NOT_IN_MOMENT.indexOf(name) === -1)
+
+  it('lists exactly the locales moment does not ship', () => {
+    const missing = localeNames.filter(definesMeridiem).filter((name) => {
+      try {
+        // eslint-disable-next-line import/no-dynamic-require, global-require
+        require(`moment/locale/${name}`)
+        return false
+      } catch (e) {
+        return true
+      }
+    })
+    expect(missing.sort()).toEqual(NOT_IN_MOMENT.slice().sort())
+  })
+
+  it('has no unlisted difference', () => {
+    const unlisted = comparable
+      .filter(differsFromMoment)
+      .filter(name => KNOWN_MERIDIEM_DIFFERENCES[name] === undefined)
+    expect(unlisted).toEqual([])
+  })
+
+  it('keeps every listed difference real', () => {
+    Object.keys(KNOWN_MERIDIEM_DIFFERENCES).forEach((name) => {
+      expect(comparable.indexOf(name)).toBeGreaterThan(-1)
+      expect(differsFromMoment(name)).toBe(true)
+    })
+  })
+
+  it('matches moment exactly for every ported locale, at every hour, in both cases', () => {
+    PORTED.forEach((name) => {
+      expect(KNOWN_MERIDIEM_DIFFERENCES[name]).toBeUndefined()
+      // eslint-disable-next-line import/no-dynamic-require, global-require
+      require(`moment/locale/${name}`)
+      HOURS.forEach((h) => {
+        const d = dayjs(at(h)).locale(name)
+        const m = moment(at(h)).locale(name)
+        expect(`${name} ${h} A ${d.format('A')}`).toBe(`${name} ${h} A ${m.format('A')}`)
+        expect(`${name} ${h} a ${d.format('a')}`).toBe(`${name} ${h} a ${m.format('a')}`)
+      })
+    })
+  })
+
+  it('renders the native meridiem inside the locale long date, not AM or PM', () => {
+    // Asserted on the rendered token rather than by searching the whole date string for `am`,
+    // which a Latin-script meridiem legitimately contains: gom-latn's own word is `donparam`.
+    PORTED.forEach((name) => {
+      const upper = dayjs(at(14)).locale(name).format('A')
+      const lower = dayjs(at(14)).locale(name).format('a')
+      expect(`${name} ${upper}`).not.toBe(`${name} PM`)
+      expect(`${name} ${lower}`).not.toBe(`${name} pm`)
+      expect(dayjs(at(9)).locale(name).format('A')).not.toBe('AM')
+      expect(dayjs(at(9)).locale(name).format('a')).not.toBe('am')
+      // Not compared to moment's whole LLL string: moment converts digits through `postformat`
+      // for bn, hi, mr and others, which dayjs gates behind the opt-in preParsePostFormat
+      // plugin, so the two dates legitimately differ in their numerals. The per-hour A and a
+      // differential above is what pins the meridiem itself.
+      // si is the one ported locale whose own patterns use the lowercase `a` token, so which
+      // form the long date must carry is read from the pattern rather than assumed.
+      const { formats } = dayjs.Ls[name]
+      const expanded = stripBrackets(u(formats.LLL, formats))
+      expect(dayjs(at(14)).locale(name).format('LLL'))
+        .toContain(expanded.indexOf('A') > -1 ? upper : lower)
+    })
+  })
+
+  it('distinguishes the two cases where the language does', () => {
+    // el and si are the two ported locales whose upper and lower forms are different strings
+    // rather than the same one, so `isLowercase` is a live parameter and not decoration.
+    expect(dayjs(at(9)).locale('el').format('A')).toBe('ΠΜ')
+    expect(dayjs(at(9)).locale('el').format('a')).toBe('πμ')
+    expect(dayjs(at(15)).locale('el').format('A')).toBe('ΜΜ')
+    expect(dayjs(at(15)).locale('el').format('a')).toBe('μμ')
+    expect(dayjs(at(9)).locale('si').format('A')).toBe('පෙර වරු')
+    expect(dayjs(at(9)).locale('si').format('a')).toBe('පෙ.ව.')
+    expect(dayjs(at(15)).locale('si').format('A')).toBe('පස් වරු')
+    expect(dayjs(at(15)).locale('si').format('a')).toBe('ප.ව.')
+  })
+})
+
+describe('the meridiem boundary is noon', () => {
+  // F33. Nine locales wrote the boundary as `hour > 12`, so the whole hour from 12:00 to 12:59
+  // rendered as the morning term. The defect is invisible to any probe that samples 9 and 15,
+  // which is how it survived alongside a meridiem sweep that called all 20 definers.
+  const NOON_LOCALES = [
+    'ar', 'ar-dz', 'ar-iq', 'ar-kw', 'ar-ly', 'ar-ma', 'ar-sa', 'ar-tn', 'km'
+  ]
+
+  it('has no locale whose meridiem turns over after noon', () => {
+    const sources = localeNames.map(name => ({
+      name,
+      src: fs.readFileSync(path.join(localeDir, `${name}.js`), 'utf8')
+    }))
+    // The scanner is validated on a known positive before its emptiness is trusted.
+    expect(sources.filter(s => s.src.indexOf('hour <') > -1).length).toBeGreaterThan(5)
+    expect(sources.filter(s => s.src.indexOf('hour > 12') > -1).map(s => s.name)).toEqual([])
+  })
+
+  it('renders the afternoon term from 12:00 onward, and the morning term before it', () => {
+    NOON_LOCALES.forEach((name) => {
+      const morning = dayjs(at(11)).locale(name).format('A')
+      const noon = dayjs('2019-04-15T12:00:00').locale(name).format('A')
+      const halfPast = dayjs(at(12)).locale(name).format('A')
+      const afternoon = dayjs(at(15)).locale(name).format('A')
+      expect(`${name} 11h ${morning}`).not.toBe(`${name} 11h ${afternoon}`)
+      expect(`${name} 12h ${noon}`).toBe(`${name} 12h ${afternoon}`)
+      expect(`${name} 12:30 ${halfPast}`).toBe(`${name} 12:30 ${afternoon}`)
+    })
+  })
+
+  it('agrees with moment across the boundary for every one moment ships', () => {
+    NOON_LOCALES.filter(name => NOT_IN_MOMENT.indexOf(name) === -1).forEach((name) => {
+      // eslint-disable-next-line import/no-dynamic-require, global-require
+      require(`moment/locale/${name}`)
+      const isEnglishInMoment = KNOWN_MERIDIEM_DIFFERENCES[name] !== undefined
+      HOURS.forEach((h) => {
+        const d = dayjs(at(h)).locale(name).format('A')
+        const m = moment(at(h)).locale(name).format('A')
+        // ar-kw, ar-ma and ar-tn are the three moment ships with no Arabic meridiem at all, so
+        // it renders AM/PM for them and only the boundary itself can be compared.
+        if (isEnglishInMoment) {
+          expect(`${name} ${h} ${d === dayjs(at(15)).locale(name).format('A')}`)
+            .toBe(`${name} ${h} ${m === 'PM'}`)
+        } else {
+          expect(`${name} ${h} ${d}`).toBe(`${name} ${h} ${m}`)
+        }
+      })
+    })
+  })
+
+  it('keeps ar-iq, which moment does not ship, in step with ar', () => {
+    HOURS.forEach((h) => {
+      expect(`ar-iq ${h} ${dayjs(at(h)).locale('ar-iq').format('A')}`)
