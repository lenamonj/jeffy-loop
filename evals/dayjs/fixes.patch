+  expect(tlh.relativeTime.dd(123, false, 'dd')).toBe('wa’vatlh cha’maH wej jaj')
+  expect(tlh.relativeTime.dd(100, false, 'dd')).toBe('wa’vatlh jaj')
+})
+
+const MR_KEYS = ['s', 'm', 'mm', 'h', 'hh', 'd', 'dd', 'M', 'MM', 'y', 'yy']
+
