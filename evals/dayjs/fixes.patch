+  const FORMAT_KEYS = ['LT', 'LTS', 'L', 'LL', 'LLL', 'LLLL', 'l', 'll', 'lll', 'llll']
+  const offenders = []
+  localeNames.forEach((name) => {
+    const { formats } = dayjs.Ls[name]
+    if (!formats) return
+    FORMAT_KEYS.forEach((key) => {
+      if (typeof formats[key] !== 'string') return
+      const hits = nonCoreTokens(u(formats[key], formats))
+      if (hits.length) offenders.push(`${name}.${key}: ${hits.join(',')}`)
+    })
+  })
+  expect(offenders).toEqual([])
+})
+
+it('gom-latn LLLL renders the same in both extend orders', () => {
+  // the defect was invisible with advancedFormat absent and order dependent with it present,
+  // so both arms are asserted rather than only the one the suite happens to load
+  const build = (order) => {
+    jest.resetModules()
+    // eslint-disable-next-line global-require
+    const d = require('../../src').default
+    // eslint-disable-next-line global-require
+    const lf = require('../../src/plugin/localizedFormat').default
+    // eslint-disable-next-line global-require
+    const af = require('../../src/plugin/advancedFormat').default
+    if (order === 'localizedFirst') { d.extend(lf); d.extend(af) } else { d.extend(af); d.extend(lf) }
