+  m: ['eng Minutt', 'enger Minutt'],
+  h: ['eng Stonn', 'enger Stonn'],
+  d: ['een Dag', 'engem Dag'],
+  M: ['ee Mount', 'engem Mount'],
+  y: ['ee Joer', 'engem Joer']
