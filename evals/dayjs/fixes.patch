+  require('moment/locale/lb')
+  const md = moment.localeData('lb')
+
+  // One string per branch of the recursion, since the threshold buckets only
+  // ever reach single digits and two-digit multiples of ten: a negative number,
+  // single digits either side of the 4-7 window, two digits ending in zero and
+  // not, three digits, five digits, a leading word that is not a number, and a
+  // string with no space at all, where moment's substr(0, -1) yields ''.
+  const CRAFTED = ['-5 Deeg', '3 Deeg', '5 Deeg', '10 Deeg', '40 Deeg',
