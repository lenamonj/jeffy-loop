+    // assignment instead, so postformat reaches relative time in either order.
+    let wrapped
+    Object.defineProperty(dayjsClass.prototype, 'fromToBase', {
+      configurable: true,
+      get: () => wrapped,
+      set(value) {
+        wrapped = withPostformat(value)
+      }
+    })
   }
 }
