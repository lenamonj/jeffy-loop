+})
+
+it('the two case-plus-punctuation sites stay fixed', () => {
+  // Both were contradicted by moment and by Intl.DateTimeFormat, which gives lowercase
+  // abbreviations for Occitan and for Brazilian Portuguese alike.
+  expect(dayjs('2019-09-01').locale('oc-lnc').format('ddd')).toBe('dg.')
+  expect(dayjs('2019-09-07').locale('oc-lnc').format('ddd')).toBe('ds.')
+  expect(dayjs('2019-09-01').locale('pt-br').format('dd')).toBe('do')
+  expect(dayjs('2019-09-07').locale('pt-br').format('dd')).toBe('sá')
+  // Each file's three weekday arrays now agree with each other on case.
+  expect(KNOWN_SHORT_NAME_DIFFERENCES.ddd).not.toContain('oc-lnc')
+  expect(KNOWN_SHORT_NAME_DIFFERENCES.dd).not.toContain('pt-br')
+})
+
+it('catalan and occitan elide the preposition before a vowel', () => {
+  // d'abril, not de abril. This is why a static format string cannot carry the preposition and
+  // the function form is required rather than merely tidier.
+  expect(dayjs('2019-04-15').locale('ca').format('D MMMM')).toBe("15 d'abril")
+  expect(dayjs('2019-04-15').locale('ca').format('MMMM')).toBe('abril')
+  expect(dayjs('2019-04-15').locale('oc-lnc').format('D MMMM')).toBe("15 d'abril")
+  expect(dayjs('2019-04-15').locale('oc-lnc').format('MMMM')).toBe('abril')
+})
+
+it('czech inflects inside a date and not standing alone', () => {
+  // cs is the one locale here whose LL separates D from MMMM with a period, so its regex has to
+  // match that shape; the default one used by the others does not.
+  expect(dayjs('2019-01-15').locale('cs').format('LL')).toBe('15. ledna 2019')
+  expect(dayjs('2019-01-15').locale('cs').format('MMMM')).toBe('leden')
+})
+
+it('si uses Gregorian month names, not the traditional lunar ones', () => {
+  // F23. si rendered all 12 Gregorian months with poya (lunar) month names, so every Sinhala
+  // date named a different month than the date denoted. Both moment and Intl.DateTimeFormat
+  // give the Gregorian names.
+  expect(KNOWN_MONTH_NAME_DIFFERENCES.si).toBeUndefined()
+  MONTH_DATES.forEach((d) => {
+    expect(dayjs(d).locale('si').format('MMMM')).toBe(moment(d).locale('si').format('MMMM'))
+    expect(dayjs(d).locale('si').format('MMM')).toBe(moment(d).locale('si').format('MMM'))
+  })
+  expect(dayjs('2019-01-15').locale('si').format('MMMM')).not.toBe('දුරුතු')
+})
diff --git a/test/locale/ordinal.test.js b/test/locale/ordinal.test.js
new file mode 100644
index 0000000..9621c44
--- /dev/null
+++ b/test/locale/ordinal.test.js
@@ -0,0 +1,265 @@
+import fs from 'fs'
+import path from 'path'
+import moment from 'moment'
+import dayjs from '../../src'
+import advancedFormat from '../../src/plugin/advancedFormat'
+import weekOfYear from '../../src/plugin/weekOfYear'
+import localeData from '../../src/plugin/localeData'
+
+dayjs.extend(advancedFormat)
+dayjs.extend(weekOfYear)
+dayjs.extend(localeData)
+
+const localeDir = '../../src/locale'
+
+// Locales whose format('Do') renders a bare, unmarked number. This list may only shrink:
+// adding a locale is a regression, removing one closes a gap. Every open gap is now closed,
+// so what remains is exactly the set recorded under Declined in BACKLOG.md - the 10 locales
+// moment ships with no `ordinal` key at all, whose native digits come from postformat rather
+// than from a marker, and the 28 where moment renders `Do` bare too.
+const KNOWN_BARE_ORDINAL = [
+  'ar', 'ar-dz', 'ar-iq', 'ar-kw', 'ar-ly', 'ar-ma', 'ar-sa', 'ar-tn',
+  'bi', 'bm', 'bn', 'bo', 'dv',
+  'gu', 'he',
+  'hi', 'ht', 'hy-am', 'jv', 'ku',
+  'ml', 'mr', 'ms-my', 'my',
+  'pa-in', 'rn', 'ro', 'rw', 'sd', 'ss', 'sw',
+  'tl-ph', 'tzm', 'tzm-latn',
+  'ur', 'uz', 'uz-latn', 'vi'
+]
+
+// Languages that mark the ordinal with a trailing period. The marker carries no
+// letter core format could read as a token, so it needs no bracket escaping.
+const PERIOD_ORDINAL = ['bs', 'eu', 'fo', 'is', 'lb', 'lv', 'me', 'se', 'sq', 'tlh', 'tzl']
+
+// Locales whose marker is moment's own rule for that language. Several vary the marker by
+// digit and five vary it by the `period` argument, so no single shared table describes them.
+const MOMENT_RULE_ORDINAL = ['be', 'cv', 'kk', 'ky', 'mk', 'mn', 'ru', 'tg', 'ug-cn', 'uk']
+
+// Romance and constructed-language markers. None of 'er', 'e', 're' or the masculine ordinal
+// indicator is a letter core format reads as a token, so none of these is bracketed; `eo`'s 'a'
+// is the one that collides and it lives in BRACKET_ORDINAL instead.
+const ROMANCE_ORDINAL = ['fr-ca', 'fr-ch', 'it-ch', 'mi', 'mt', 'gom-latn']
+
+// dayjs reaches `ordinal` from two call sites: Do passes no period, wo passes 'W'. These give a
+// different marker for each, so `period` is a live parameter and not decoration. The paired
+// number is one at which the two arms genuinely differ, which is not the same for every locale:
+// fr-ca and fr-ch diverge only at 1 ('er' against 're') and agree on 'e' everywhere above it.
+const PERIOD_SENSITIVE = [
+  ['be', 7], ['mn', 7], ['ru', 7], ['ug-cn', 7], ['uk', 7],
+  ['fr-ca', 1], ['fr-ch', 1], ['gom-latn', 7]
+]
+
+// Locales in other scripts whose marker holds no letter core format reads as a token, so none
+// is bracketed. `ka` and `yo` put the marker before the number rather than after it.
+const OTHER_SCRIPT_ORDINAL = ['az', 'el', 'ka', 'lo', 'si', 'te', 'tet', 'yo']
+
+// moment gives these four a postformat hook that rewrites Latin digits into the locale's own
+// numerals, so moment's rendered format('Do') is NOT a valid oracle for dayjs, which gates
+// preparse/postformat behind the opt-in preParsePostFormat plugin. moment's ordinal() is.
+const POSTFORMAT_DIGIT_ORDINAL = ['fa', 'km', 'kn', 'ta']
+
+// These ignore `period` entirely, which makes moment's bare ordinal(n) a valid oracle for them.
+// It is NOT valid for PERIOD_SENSITIVE: moment returns the raw number there.
+const PERIOD_BLIND = [
+  'cv', 'kk', 'ky', 'mk', 'tg', 'it-ch', 'mi', 'mt',
+  'az', 'el', 'fa', 'ka', 'km', 'kn', 'lo', 'si', 'ta', 'te', 'yo'
+]
+
+// The one value where dayjs deliberately departs from moment. moment's az table carries no
+// entry for 40, so its lookup yields `40 + undefined` and the ordinal is NaN; week 40 reaches
+// ordinal through `wo`. dayjs supplies the suffix. Excluded from the sweep below and then
+// asserted explicitly, so the divergence is pinned rather than silently skipped.
+const MOMENT_ORDINAL_GAPS = { az: [40] }
+
+// Locales whose marker contains a letter core format reads as a token, so the locale must wrap it
+// in dayjs's format-escape brackets. `en`, `en-gb`, `en-au`, `nl`, `sv` and the English variants
+// already did. Every marker here holds a `d`, an `s` or an `a`. `eo`'s marker is bare 'a', the
+// meridiem token, so unescaped it renders '1a' as '1pm' - a corruption that adds no digit and
+// so slips past the no-token-bleed check below; only the equality against moment catches it.
+const BRACKET_ORDINAL = ['af', 'br', 'cy', 'eo', 'fy', 'ga', 'gd', 'nl-be', 'tet']
+
+// days chosen to exercise the 1/2/3/other suffix rules and the 11-vs-21 teens rule
+const DAYS = [1, 2, 3, 4, 11, 21]
+
+const renderDo = (name, day) =>
+  dayjs(`2019-06-${String(day).padStart(2, '0')}`).locale(name).format('Do')
+
+const loadBoth = (name) => {
+  // eslint-disable-next-line import/no-dynamic-require, global-require
+  require(path.join(__dirname, localeDir, `${name}.js`))
+  // eslint-disable-next-line import/no-dynamic-require, global-require
+  require(`moment/locale/${name}`)
+}
+
+afterAll(() => {
+  moment.locale('en')
+  dayjs.locale('en')
+})
+
+it('only the known locales render an unmarked ordinal', () => {
+  const bare = fs.readdirSync(path.join(__dirname, localeDir))
+    .filter(file => file.endsWith('.js'))
+    .map(file => file.replace('.js', ''))
+    .filter((name) => {
+      // eslint-disable-next-line import/no-dynamic-require, global-require
+      require(path.join(__dirname, localeDir, `${name}.js`))
+      return DAYS.every(day => renderDo(name, day) === String(day))
+    })
+    .sort()
+  expect(bare).toEqual(KNOWN_BARE_ORDINAL.slice().sort())
+})
+
+it('the English variants use English ordinal suffixes', () => {
+  const expected = ['1st', '2nd', '3rd', '4th', '11th', '21st']
+  const ENGLISH_VARIANTS = ['en-ca', 'en-ie', 'en-il', 'en-sg', 'x-pseudo']
+  ENGLISH_VARIANTS.forEach((name) => {
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(path.join(__dirname, localeDir, `${name}.js`))
+    expect(DAYS.map(day => renderDo(name, day))).toEqual(expected)
+  })
+  // en itself already did this and must be unchanged
+  expect(DAYS.map(day => renderDo('en', day))).toEqual(expected)
+})
+
+it('the period-ordinal languages render a trailing period', () => {
+  const expected = ['1.', '2.', '3.', '4.', '11.', '21.']
+  PERIOD_ORDINAL.forEach((name) => {
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(path.join(__dirname, localeDir, `${name}.js`))
+    expect(DAYS.map(day => renderDo(name, day))).toEqual(expected)
+  })
+  // id already used this form and must be unchanged
+  expect(DAYS.map(day => renderDo('id', day))).toEqual(expected)
+})
+
+it('the moment-rule locales render Do exactly as moment does', () => {
+  MOMENT_RULE_ORDINAL.concat(ROMANCE_ORDINAL, OTHER_SCRIPT_ORDINAL).forEach((name) => {
+    loadBoth(name)
+    DAYS.forEach((day) => {
+      // a non-zero time on purpose: an unescaped marker only corrupts when the token it
+      // collides with has a value, so asserting at second zero would hide that failure
+      const date = `2019-06-${String(day).padStart(2, '0')}T14:30:45`
+      const rendered = dayjs(date).locale(name).format('Do')
+      expect(rendered).toBe(moment(date).locale(name).format('Do'))
+      expect(rendered).not.toBe(String(day))
+    })
+  })
+})
+
+it('the period argument selects the week marker, as it does in moment', () => {
+  PERIOD_SENSITIVE.forEach(([name, n]) => {
+    loadBoth(name)
+    // the same number must render differently for the two period values dayjs can pass,
+    // or the parameter is inert and the locale is only pretending to implement it
+    expect(String(dayjs.Ls[name].ordinal(n, 'W'))).not.toBe(String(dayjs.Ls[name].ordinal(n)))
+    // dayjs's Do passes no period, so its day form must be moment's 'D' arm. For be, mn, ru,
+    // ug-cn and uk moment's default arm returns the raw number; for gom-latn it does too, and
+    // for fr-ca and fr-ch the default arm falls through into the masculine one.
+    expect(dayjs.Ls[name].ordinal(n)).toBe(moment.localeData(name).ordinal(n, 'D'))
+    expect(dayjs.Ls[name].ordinal(n, 'W')).toBe(moment.localeData(name).ordinal(n, 'W'))
+    // and end to end through the wo token, which is what actually passes 'W'
+    const date = '2019-01-08'
+    expect(dayjs(date).locale(name).format('wo')).toBe(moment(date).locale(name).format('wo'))
+  })
+  // be alone varies its week marker by last digit, with a teens exception; both arms must run
+  const beArms = [2, 3, 12, 13, 22, 7]
+  expect(beArms.map(n => dayjs.Ls.be.ordinal(n, 'W')))
+    .toEqual(beArms.map(n => moment.localeData('be').ordinal(n, 'W')))
+})
+
+it('the period-blind locales match moment across the whole range their rule covers', () => {
+  // Two things are pinned here that a date cannot reach. moment's kk/ky/tg lookup ends in a
+  // third fallback that is dead because the last-digit lookup always resolves, and dropping it
+  // is only safe if that holds for every n. And mk's rule has arms for 0 and for a multiple of
+  // 100, neither of which Do (1-31) or wo (1-53) can produce.
+  const ns = Array.from({ length: 121 }, (_, i) => i)
+  PERIOD_BLIND.forEach((name) => {
+    loadBoth(name)
+    const skip = MOMENT_ORDINAL_GAPS[name] || []
+    const probe = ns.filter(n => skip.indexOf(n) === -1)
+    expect(probe.map(n => dayjs.Ls[name].ordinal(n)))
+      .toEqual(probe.map(n => moment.localeData(name).ordinal(n)))
+  })
+  // moment really is broken at az 40, and dayjs really does return a suffix there. If moment
+  // ever fixes this, the first assertion fails and the divergence can be dropped.
+  expect(String(moment.localeData('az').ordinal(40))).toBe('NaN')
+  // the suffix chosen is the one moment's own table gives 60 and 90, the vowel-harmony group
+  expect(dayjs.Ls.az.ordinal(40)).toBe(String(moment.localeData('az').ordinal(60)).replace('60', '40'))
+  expect(dayjs.Ls.az.ordinal(40)).toBe(String(moment.localeData('az').ordinal(90)).replace('90', '40'))
+})
+
+it('moment converts these digits through postformat, which dayjs does not', () => {
+  // dayjs gates preparse/postformat behind the opt-in preParsePostFormat plugin, so core
+  // output keeps Latin digits and moment's rendered Do is the wrong oracle for these four.
+  // moment's ordinal() is the marker itself, and that is what dayjs must match.
+  POSTFORMAT_DIGIT_ORDINAL.forEach((name) => {
+    loadBoth(name)
+    DAYS.forEach((day) => {
+      const date = `2019-06-${String(day).padStart(2, '0')}T14:30:45`
+      const rendered = dayjs(date).locale(name).format('Do')
+      expect(rendered).toBe(moment.localeData(name).ordinal(day))
+      // and the distinction is real rather than theoretical: moment's own Do differs here
+      expect(rendered).not.toBe(moment(date).locale(name).format('Do'))
+    })
+  })
+})
+
+it('the bracket-escaped locales render Do as moment does, with no token bleed', () => {
+  BRACKET_ORDINAL.forEach((name) => {
+    loadBoth(name)
+    DAYS.forEach((day) => {
+      const date = `2019-06-${String(day).padStart(2, '0')}T14:30:45`
+      const rendered = dayjs(date).locale(name).format('Do')
+      expect(rendered).toBe(moment(date).locale(name).format('Do'))
+      // this batch's acceptance condition. An unescaped marker splices in the hour, minute,
+      // second or weekday number, so no digit other than the day itself may survive
+      expect(rendered.replace(String(day), '')).not.toMatch(/\d/)
+    })
+  })
+  // af, fy and nl-be copy nl's existing line rather than transcribing moment, so their rendered
+  // output must be identical to nl's, which is unchanged
+  loadBoth('nl')
+  const nl = DAYS.map(day => renderDo('nl', day))
+  expect(nl).toEqual(['1ste', '2de', '3de', '4de', '11de', '21ste']);
+  ['af', 'fy', 'nl-be'].forEach((name) => {
+    expect(DAYS.map(day => renderDo(name, day))).toEqual(nl)
+  })
+})
+
+it('the bracket-escaped locales match moment across the range their rule covers', () => {
+  // cy's rule has an above-20 arm with exceptions at 40, 50, 60, 80 and 100 that Do (1-31) and
+  // wo (1-53) cannot both reach, and ga and gd split on 1 / last-digit-2 / other. localeData is
+  // the boundary that strips the escape brackets, so it is what makes the two sides comparable.
+  const ns = Array.from({ length: 121 }, (_, i) => i)
+  BRACKET_ORDINAL.forEach((name) => {
+    loadBoth(name)
+    const subject = dayjs().locale(name)
+    expect(ns.map(n => subject.localeData().ordinal(n)))
+      .toEqual(ns.map(n => moment.localeData(name).ordinal(n)))
+  })
+})
+
+it('an ordinal marker is escaped so core format cannot reinterpret it', () => {
+  // advancedFormat substitutes Do and hands the result to core format, so an
+  // unescaped 's' in a suffix is read as the seconds token: '1st' -> '145t'.
+  dayjs.locale({ name: 'ordinal-raw', ordinal: n => `${n}st` }, null, true)
+  dayjs.locale({ name: 'ordinal-esc', ordinal: n => `[${n}st]` }, null, true)
+  const at = dayjs('2019-06-01T14:30:45')
+  expect(at.locale('ordinal-raw').format('Do')).toBe('145t')
+  expect(at.locale('ordinal-esc').format('Do')).toBe('1st')
+  // 'd' is the weekday token, and 2019-06-01 is a Saturday, so an unescaped 'de' suffix
+  // renders '1de' as '16e'. This is the collision the F10-4 locales all had to avoid.
+  dayjs.locale({ name: 'ordinal-raw-d', ordinal: n => `${n}de` }, null, true)
+  dayjs.locale({ name: 'ordinal-esc-d', ordinal: n => `[${n}de]` }, null, true)
+  expect(at.locale('ordinal-raw-d').format('Do')).toBe('16e')
+  expect(at.locale('ordinal-esc-d').format('Do')).toBe('1de')
+  // 'a' is the lowercase meridiem token, so an unescaped 'a' suffix renders '1a' as '1pm'.
+  // This one adds no digit, so the no-token-bleed check above cannot see it and only the
+  // equality against moment can. `eo` is the locale that carries this marker.
+  dayjs.locale({ name: 'ordinal-raw-a', ordinal: n => `${n}a` }, null, true)
+  dayjs.locale({ name: 'ordinal-esc-a', ordinal: n => `[${n}a]` }, null, true)
+  expect(at.locale('ordinal-raw-a').format('Do')).toBe('1pm')
+  expect(at.locale('ordinal-esc-a').format('Do')).toBe('1a')
+  expect(at.locale('ordinal-raw-a').format('Do').replace('1', '')).not.toMatch(/\d/)
+})
diff --git a/test/locale/relativeTime.test.js b/test/locale/relativeTime.test.js
new file mode 100644
index 0000000..d42d491
--- /dev/null
+++ b/test/locale/relativeTime.test.js
@@ -0,0 +1,252 @@
+import fs from 'fs'
+import path from 'path'
+import moment from 'moment'
+import dayjs from '../../src'
+import relativeTime from '../../src/plugin/relativeTime'
+
+dayjs.extend(relativeTime)
+
+const localeDir = '../../src/locale'
+
+// Locales shipping no relativeTime, which fall back to hardcoded English. The
+// gap is closed: every bundled locale now defines it, so this list is empty and
+// must stay empty. Any entry appearing here is a regression.
+const KNOWN_MISSING_RELATIVE_TIME = []
+
+it('every bundled locale defines relativeTime, except the known-open set', () => {
+  const missing = fs.readdirSync(path.join(__dirname, localeDir))
+    .filter(file => file.endsWith('.js'))
+    .filter((file) => {
+      // eslint-disable-next-line import/no-dynamic-require, global-require
+      const content = require(path.join(__dirname, localeDir, file)).default
+      return !content.relativeTime
+    })
+    .map(file => file.replace('.js', ''))
+    .sort()
+  expect(missing).toEqual(KNOWN_MISSING_RELATIVE_TIME.slice().sort())
+})
+
+// durations chosen to land in each dayjs relativeTime threshold bucket
+const CASES = [
+  [1, 'minute'], [10, 'minute'], [40, 'minute'],
+  [1, 'hour'], [5, 'hour'], [20, 'hour'],
+  [1, 'day'], [5, 'day'], [20, 'day'],
+  [1, 'month'], [5, 'month'], [9, 'month'],
+  [1, 'year'], [5, 'year'], [20, 'year']
+]
+
+// Locales whose relativeTime output is plain text, so the relativeTime plugin
+// alone reproduces moment. `mr` is verified separately: its numerals need the
+// preParsePostFormat plugin, which this file deliberately does not load here.
+const PORTED = ['bs', 'me', 'cv', 'tzl', 'gom-latn', 'ar-ly', 'lb', 'tlh']
+
+PORTED.forEach((name) => {
+  it(`relativeTime for ${name} matches moment in every bucket`, () => {
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(`../../src/locale/${name}`)
+    // eslint-disable-next-line import/no-dynamic-require, global-require
+    require(`moment/locale/${name}`)
+    const base = dayjs('2019-06-15T12:00:00')
+    const mbase = moment('2019-06-15T12:00:00')
+    CASES.forEach(([n, unit]) => {
+      [false, true].forEach((withoutSuffix) => {
+        // past direction
+        expect(base.locale(name).from(base.add(n, unit), withoutSuffix))
+          .toBe(mbase.locale(name).from(mbase.clone().add(n, unit), withoutSuffix))
+        // future direction: several of these locales inflect differently for it
+        expect(base.locale(name).to(base.add(n, unit), withoutSuffix))
+          .toBe(mbase.locale(name).to(mbase.clone().add(n, unit), withoutSuffix))
+      })
+    })
+  })
+})
+
+it('ported plural formatters handle the singular and small-plural cases', () => {
+  // dayjs's thresholds shift a count of 1 down to the singular key, so the plural
+  // formatters never see 1 through from(). They are called directly here so the ported
+  // grammar stays faithful to moment's and every branch is exercised.
+  // eslint-disable-next-line global-require
+  const bs = require('../../src/locale/bs').default
+  const bsCases = [['mm', 1], ['mm', 3], ['mm', 9], ['hh', 1], ['hh', 3], ['hh', 9],
+    ['dd', 1], ['dd', 9], ['MM', 1], ['MM', 3], ['MM', 9], ['yy', 1], ['yy', 3], ['yy', 9]]
+  bsCases.forEach(([key, n]) => {
+    const out = bs.relativeTime[key](n, false, key)
+    expect(out.startsWith(`${n} `)).toBe(true)
+    expect(out.length).toBeGreaterThan(String(n).length + 1)
+  })
+  // the two singular keys switch on withoutSuffix and must differ between the modes
+  expect(bs.relativeTime.m(1, true, 'm')).not.toBe(bs.relativeTime.m(1, false, 'm'))
+  expect(bs.relativeTime.h(1, true, 'h')).not.toBe(bs.relativeTime.h(1, false, 'h'))
+
+  // eslint-disable-next-line global-require
+  const me = require('../../src/locale/me').default
+  const meCases = [['mm', 1], ['mm', 3], ['mm', 9], ['hh', 1], ['hh', 9],
+    ['dd', 3], ['MM', 1], ['yy', 1], ['yy', 3], ['yy', 9]]
+  meCases.forEach(([key, n]) => {
+    expect(me.relativeTime[key](n, false, key).startsWith(`${n} `)).toBe(true)
+  })
+  expect(me.relativeTime.m(1, true, 'm')).not.toBe(me.relativeTime.m(1, false, 'm'))
+
+  // cv picks its future affix from the tail of the rendered output, so the three
+  // branches must produce three different suffixes for hour, year and everything else
+  // eslint-disable-next-line global-require
+  const cv = require('../../src/locale/cv').default
+  const {
+    future, h, y, d
+  } = cv.relativeTime
+  const suffix = (base, out) => out.slice(base.length)
+  expect(future(h).startsWith(h)).toBe(true)
+  expect(suffix(h, future(h))).not.toBe(suffix(d, future(d)))
+  expect(suffix(y, future(y))).not.toBe(suffix(d, future(d)))
+  expect(suffix(h, future(h))).not.toBe(suffix(y, future(y)))
+})
+
+it('ar-ly covers all six Arabic plural categories the way moment does', () => {
+  // eslint-disable-next-line global-require
+  const arLy = require('../../src/locale/ar-ly').default
+  // eslint-disable-next-line global-require
+  require('moment/locale/ar-ly')
+  const md = moment.localeData('ar-ly')
+
+  // one representative of each pluralForm category: zero, one, dual,
+  // the 3-10 form, the 11+ form, and the 100+ remainder form
+  const CATEGORIES = [0, 1, 2, 5, 20, 101]
+
+  // Plural keys carry a real count. moment substitutes 1 for a falsy count and
+  // dayjs's ported formatters do the same, so both sides see the same number.
+  const PLURAL_KEYS = ['s', 'mm', 'hh', 'dd', 'MM', 'yy']
+  PLURAL_KEYS.forEach((key) => {
+    CATEGORIES.forEach((n) => {
+      [false, true].forEach((withoutSuffix) => {
+        expect(arLy.relativeTime[key](n, withoutSuffix, key, false))
+          .toBe(md.relativeTime(n || 1, withoutSuffix, key, false))
+      })
+    })
+  })
+
+  // dayjs calls the singular keys with the preceding threshold's count rather
+  // than 1 - m gets seconds, h gets minutes, d gets hours, M gets days, y gets
+  // months - so they must ignore it and render what moment renders for 1.
+  const SINGULAR_COUNTS = {
+    m: 60, h: 60, d: 24, M: 30, y: 12
+  }
+  Object.keys(SINGULAR_COUNTS).forEach((key) => {
+    expect(arLy.relativeTime[key](SINGULAR_COUNTS[key], false, key, false))
+      .toBe(md.relativeTime(1, false, key, false))
+  })
+
+  // the dual is the only category that inflects with the suffix
+  expect(arLy.relativeTime.mm(2, true, 'mm')).not.toBe(arLy.relativeTime.mm(2, false, 'mm'))
+  expect(arLy.relativeTime.mm(5, true, 'mm')).toBe(arLy.relativeTime.mm(5, false, 'mm'))
