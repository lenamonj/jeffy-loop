diff --git a/test/plugin/timezone.test.js b/test/plugin/timezone.test.js
index d83a03f..c7a3b7a 100644
--- a/test/plugin/timezone.test.js
+++ b/test/plugin/timezone.test.js
@@ -352,3 +352,51 @@ describe('UTC timezone', () => {
     expect(dayjs2.format()).toBe(moment2.format())
   })
 })
+
+describe('Result does not depend on the machine the code runs on', () => {
+  // These fixtures fail before the fix under TZ=America/Whitehorse and
+  // TZ=Europe/London, two host zones whose own DST transition falls inside the
+  // offset shift that dayjs.tz performs. npm test runs the whole suite under
+  // Whitehorse and London, so this describe block is what pins that down.
+  const inputs = [
+    ['2012-03-11 02:00:00', NY, '2012-03-11T03:00:00-04:00', 1331449200000],
+    ['2012-03-11 02:59:59', NY, '2012-03-11T03:59:59-04:00', 1331452799000],
+    ['2012-10-28 00:30:00', NY, '2012-10-28T00:30:00-04:00', 1351398600000],
+    ['2012-11-04 02:00:00', NY, '2012-11-04T02:00:00-05:00', 1352012400000]
+  ]
+
+  it('dayjs.tz resolves to the documented instant', () => {
+    inputs.forEach(([input, zone, expected, ts]) => {
+      const d = dayjs.tz(input, zone)
+      expect(d.format()).toBe(expected)
+      expect(d.valueOf()).toBe(ts)
+      expect(d.valueOf()).toBe(moment.tz(input, zone).valueOf())
+    })
+  })
+
+  it('dayjs.tz keeps format() and valueOf() describing the same instant', () => {
+    inputs.forEach(([input, zone]) => {
+      const d = dayjs.tz(input, zone)
+      expect(new Date(d.format()).valueOf()).toBe(d.valueOf())
+    })
+  })
+})
+
+describe('Ambiguous and skipped local times resolve deterministically', () => {
+  it('does not depend on the current date', () => {
+    const inputs = [
+      ['2021-11-07 01:30:00', NY],
+      ['2021-03-14 02:30:00', NY],
+      ['2021-04-04 02:30:00', 'Pacific/Auckland'],
+      ['2021-10-31 01:30:00', 'Europe/London']
+    ]
+    inputs.forEach(([input, zone]) => {
+      MockDate.set(new Date('2021-01-15T12:00:00.000Z'))
+      const winter = dayjs.tz(input, zone).valueOf()
+      MockDate.set(new Date('2021-07-15T12:00:00.000Z'))
+      const summer = dayjs.tz(input, zone).valueOf()
+      MockDate.set(new Date())
+      expect(winter).toBe(summer)
+    })
+  })
+})
