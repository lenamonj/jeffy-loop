+
+describe('parser reuse', () => {
+  // F42. The compiled parser is cached per locale and format string, because rebuilding the
+  // locale-derived matchers on every parse made a Do format 3.2x slower. The risk a cache adds
+  // is staleness, and dayjs.updateLocale is the public API that creates it: it mutates a locale
+  // object in place, so the object a cached parser was built from is the same object afterwards.
+  // What makes a stale entry detectable is that it reassigns the property it changes, so every
+  // value the parser derives from is compared by reference before a cached parser is reused.
+  const FULL = 'Jan_Feb_Mar_Apr_May_Jun_Jul_Aug_Sep_Oct_Nov_Dec'.split('_')
+  // Two properties matter here and both were arrived at by watching the test fail to discriminate.
+  // The names must share no prefix with the originals, because non-strict parsing tolerates
+  // trailing text and a merely shortened name would still match the original as a prefix. And
+  // they must contain a space, because `matchNames` keeps `matchWord` as its last alternative:
+  // for an ordinary one-word name a stale matcher is invisible, since the generic pattern still
+  // captures it and the handler resolves it against live locale data. A space is what `matchWord`
+  // structurally cannot cross, so only a matcher rebuilt from the new names can capture these.
+  const RENAMED = 'Alpha One_Bravo Two_Charlie Three_Delta Four_Echo Five_Foxtrot Six_Golf Seven_Hotel Eight_India Nine_Juliet Ten_Kilo Eleven_Lima Twelve'.split('_')
+  const register = () => {
+    dayjs.extend(updateLocale)
+    // isLocal, so registering this throwaway locale does not switch the global one.
+    dayjs.locale({
+      name: 'f42-cache',
+      months: FULL.slice(),
+      monthsShort: FULL.slice(),
+      weekdays: 'Sun_Mon_Tue_Wed_Thu_Fri_Sat'.split('_'),
+      ordinal: n => `${n}`,
+      formats: {
+        LT: 'h:mm A', LTS: 'h:mm:ss A', L: 'MM/DD/YYYY', LL: 'MMMM D, YYYY', LLL: 'MMMM D, YYYY h:mm A', LLLL: 'dddd, MMMM D, YYYY h:mm A'
+      }
+    }, null, true)
+  }
+
+  it('reflects an updateLocale change on the very next parse', () => {
+    register()
+    const format = 'D MMMM YYYY'
+    // Build and cache a parser for this locale and format.
+    expect(dayjs('15 Apr 2019', format, 'f42-cache').format('YYYY-MM-DD')).toBe('2019-04-15')
+    // Change the very data that parser was built from.
+    dayjs.updateLocale('f42-cache', { months: RENAMED.slice(), monthsShort: RENAMED.slice() })
+    // The next call must parse with the new names and must no longer accept the old ones.
+    expect(dayjs('15 Delta Four 2019', format, 'f42-cache').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('15 Apr 2019', format, 'f42-cache').isValid()).toBe(false)
+    // Put it back and confirm the invalidation works in both directions rather than once.
+    dayjs.updateLocale('f42-cache', { months: FULL.slice(), monthsShort: FULL.slice() })
+    expect(dayjs('15 Apr 2019', format, 'f42-cache').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('15 Delta Four 2019', format, 'f42-cache').isValid()).toBe(false)
+  })
+
+  it('never serves one locale\'s matchers to another', () => {
+    // Interleaving locales and formats through the cache must not cross-contaminate them.
+    const bad = []
+    for (let i = 0; i < 50; i += 1) {
+      if (dayjs('15 April 2019', 'D MMMM YYYY', 'en').format('YYYY-MM-DD') !== '2019-04-15') bad.push(`en ${i}`)
+      if (dayjs('15 апреля 2019', 'D MMMM YYYY', 'ru').format('YYYY-MM-DD') !== '2019-04-15') bad.push(`ru ${i}`)
+      if (dayjs('15 квітня 2019', 'D MMMM YYYY', 'uk').format('YYYY-MM-DD') !== '2019-04-15') bad.push(`uk ${i}`)
+    }
+    expect(bad).toEqual([])
+  })
+
+  it('stays correct after the cache is driven past its cap', () => {
+    // The store is bounded, so parsing must keep working once entries start being evicted.
+    for (let i = 0; i < 400; i += 1) {
+      dayjs(`2019-04-15${' '.repeat(i % 5)}`, `YYYY-MM-DD${'[ ]'.repeat(i % 5)}`)
+    }
+    expect(dayjs('15 April 2019', 'D MMMM YYYY', 'en').format('YYYY-MM-DD')).toBe('2019-04-15')
+    expect(dayjs('15 апреля 2019', 'D MMMM YYYY', 'ru').format('YYYY-MM-DD')).toBe('2019-04-15')
+  })
+
+  it('does not evict a still-valid entry when another key is stored over', () => {
+    // F45. The cap counter must count entries, not stores: a store that overwrites an existing
+    // key - a locale changed under it, so its parser was rebuilt - adds no entry, and counting
+    // it cleared the whole cache well before the 200-entry cap intends, evicting entries that
+    // were still good. The instrument is a counting `ordinal`, which separates a rebuild from a
+    // hit exactly with no timing involved: building a Do matcher calls it 31 times and the
+    // handler's own scan calls it again, so a rebuild costs strictly more calls than a hit.
+    dayjs.extend(updateLocale)
+    let ordinalCalls = 0
+    const months = 'Jan_Feb_Mar_Apr_May_Jun_Jul_Aug_Sep_Oct_Nov_Dec'.split('_')
+    const weekdays = 'Sun_Mon_Tue_Wed_Thu_Fri_Sat'.split('_')
+    // isLocal, so registering these throwaway locales does not switch the global one.
+    dayjs.locale({
+      name: 'f45-watched',
+      months: months.slice(),
+      monthsShort: months.slice(),
+      weekdays: weekdays.slice(),
+      ordinal: (n) => { ordinalCalls += 1; return `${n}` }
+    }, null, true)
+    dayjs.locale({
+      name: 'f45-churn',
+      months: months.slice(),
+      monthsShort: months.slice(),
+      weekdays: weekdays.slice(),
+      ordinal: n => `${n}`
+    }, null, true)
+
+    // Warm the watched entry, then measure what a hit costs.
+    ordinalCalls = 0
+    expect(dayjs('5', 'Do', 'f45-watched').date()).toBe(5)
+    const buildCost = ordinalCalls
+    ordinalCalls = 0
+    expect(dayjs('5', 'Do', 'f45-watched').date()).toBe(5)
+    const hitCost = ordinalCalls
+    // A rebuild must be distinguishable from a hit, or this test proves nothing.
+    expect(buildCost).toBeGreaterThan(hitCost)
+
+    // 300 stores over one other key, each forced by giving the churn locale's months arrays a
+    // new identity so the cached deps mismatch. More stores than the cap: a counter that counts
+    // stores crosses it and clears everything; one that counts entries stays at 2.
+    for (let i = 0; i < 300; i += 1) {
+      dayjs.updateLocale('f45-churn', { months: months.slice(), monthsShort: months.slice() })
