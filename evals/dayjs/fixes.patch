diff --git a/build/rollup.config.js b/build/rollup.config.js
index b3a6610..db7640a 100644
--- a/build/rollup.config.js
+++ b/build/rollup.config.js
@@ -23,6 +23,13 @@ module.exports = (config) => {
       globals: {
         dayjs: 'dayjs'
       },
+      // Every entry here - core, all 37 plugins, all 143 locales - has exactly one default
+      // export, and the published contract is that the bundle *is* that value: `require(
+      // 'dayjs/locale/de')` returns the locale object. Rollup otherwise auto-detects this per
+      // entry, so a single stray named export silently turns that bundle into a namespace
+      // object instead, which is what shipped for `ku`. Forcing it makes rollup fail the build
+      // on the next stray export rather than change the artifact's shape in silence.
+      exports: 'default',
       compact: true
     }
   }
