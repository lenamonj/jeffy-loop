+        const d = dayjs(date).locale(name).format(tok)
+        const m = moment(date).locale(name).format(tok)
+        if (d === m) return
+        if (startsUpper(d) && !startsUpper(m)) dayjsSide.push(`${name}.${tok}`)
+        if (!startsUpper(d) && startsUpper(m)) momentSide.push(`${name}.${tok}`)
+      })
+    })
+  })
