+    using Catch::parseTestSpec;
+    using Catch::TestSpec;
+
+    // Config builds the run's spec by feeding every <test-spec> argument to
+    // one parser, so separate arguments combine like concatenation rather
+    // than like the comma form. Two full names as separate arguments
+    // therefore select nothing, which is loud but surprising.
+    Catch::TagAliasRegistry registry;
