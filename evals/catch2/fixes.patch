index 8e6009dd..2037e6ae 100644
--- a/tests/SelfTest/IntrospectiveTests/Sharding.tests.cpp
+++ b/tests/SelfTest/IntrospectiveTests/Sharding.tests.cpp
@@ -12,6 +12,7 @@
 #include <catch2/internal/catch_sharding.hpp>
 
 #include <unordered_map>
+#include <algorithm>
 #include <vector>
 
 TEST_CASE("Sharding Function", "[approvals]") {
@@ -43,3 +44,36 @@ TEST_CASE("Sharding Function", "[approvals]") {
         CHECK(result[i] == testContainer[i + startIndex]);
     }
 }
+
+// The test above pins one container size against a hand-tabulated table of
+// expected shard sizes. The invariants below hold for every container size
+// and every shard count, including the sizes that table cannot reach: an
+// empty container, a single element, and more shards than there are elements.
+TEST_CASE("Sharding partitions any container without loss or overlap", "[approvals]") {
+    auto elementCount = GENERATE(range(0, 13));
+    std::vector<int> testContainer;
+    for (int i = 0; i < elementCount; ++i) {
+        testContainer.push_back(i);
+    }
+
+    auto shardCount = GENERATE_COPY(range(1, elementCount + 3));
+
+    std::vector<int> rebuilt;
+    std::size_t largest = 0;
+    std::size_t smallest = static_cast<std::size_t>(-1);
+    for (int shardIndex = 0; shardIndex < shardCount; ++shardIndex) {
+        std::vector<int> shard =
+            Catch::createShard(testContainer, static_cast<std::size_t>(shardCount),
+                               static_cast<std::size_t>(shardIndex));
+        largest = (std::max)(largest, shard.size());
+        smallest = (std::min)(smallest, shard.size());
+        rebuilt.insert(rebuilt.end(), shard.begin(), shard.end());
+    }
+
