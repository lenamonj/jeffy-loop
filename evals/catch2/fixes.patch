+
+# Run every example and pin the summary it prints.
+#
+# Building the examples only proves they still compile against the current API.
+# It cannot see an example whose behaviour drifts from what its own comments and
+# the documentation say it does, and several of these are deliberate failure
+# demonstrations whose whole point is the numbers in that summary.
+#
+# PASS_REGULAR_EXPRESSION is used rather than exit codes because it pins the
+# output rather than just its sign: CMake ignores the exit status when that
+# property is set, which is what lets the deliberately failing examples be
+# checked as precisely as the passing ones.
+set(EXAMPLE_EXPECTATIONS
+  "010-TestCase|test cases: 2 \\| 1 passed \\| 1 failed"
+  "020-MultiFile|test cases: 3 \\| 2 passed \\| 1 failed"
+  "030-Asn-Require-Check|test cases: 6 \\| 1 passed \\| 5 failed"
+  "100-Fix-Section|All tests passed \\(16 assertions in 1 test case\\)"
+  "110-Fix-ClassFixture|All tests passed \\(2 assertions in 2 test cases\\)"
+  "111-Fix-PersistentFixture|All tests passed \\(3 assertions in 1 test case\\)"
+  "120-Bdd-ScenarioGivenWhenThen|All tests passed \\(16 assertions in 1 test case\\)"
+  "210-Evt-EventListeners|test cases: 2 \\| 1 passed \\| 1 failed"
+  "231-Cfg_OutputStreams|All tests passed \\(1 assertion in 1 test case\\)"
+  "232-Cfg-CustomMain|No tests ran"
+  "300-Gen-OwnGenerator|All tests passed \\(400 assertions in 1 test case\\)"
+  "301-Gen-MapTypeConversion|All tests passed \\(4 assertions in 1 test case\\)"
+  "302-Gen-Table|All tests passed \\(4 assertions in 1 test case\\)"
+  "310-Gen-VariablesInGenerators|All tests passed \\(150 assertions in 1 test case\\)"
+  "311-Gen-CustomCapture|All tests passed \\(150 assertions in 1 test case\\)"
+)
+
+foreach(expectation ${EXAMPLE_EXPECTATIONS})
+  string(REPLACE "|" ";" parts "${expectation}")
+  list(GET parts 0 example_name)
+  list(GET parts 1 expected_output)
+  add_test(NAME Examples::${example_name} COMMAND $<TARGET_FILE:${example_name}>)
+  set_tests_properties(Examples::${example_name}
+    PROPERTIES
+      PASS_REGULAR_EXPRESSION "${expected_output}"
+  )
+endforeach()
+
+# 232 binds a custom command line option. A documented option that changes
+# nothing would still let the case above pass, so it is exercised at a value
+# that must change the output.
+add_test(NAME Examples::232-Cfg-CustomMain::CustomOption
+  COMMAND $<TARGET_FILE:232-Cfg-CustomMain> --height 42
+)
+set_tests_properties(Examples::232-Cfg-CustomMain::CustomOption
+  PROPERTIES
