+    // The comma form inside a single argument selects either of them.
+    TestSpec commaJoined = parseTestSpec( "Test 1,Test 2" );
+    CHECK( commaJoined.matches( *fakeTestCase( "Test 1" ) ) );
+    CHECK( commaJoined.matches( *fakeTestCase( "Test 2" ) ) );
+
+    // Each name on its own still matches its own test, so the two failures
+    // above are the combination and not a spec that matches nothing.
+    TestSpec single = parseTestSpec( "Test 1" );
+    CHECK( single.matches( *fakeTestCase( "Test 1" ) ) );
+    CHECK_FALSE( single.matches( *fakeTestCase( "Test 2" ) ) );
