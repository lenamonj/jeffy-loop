diff --git a/tests/SelfTest/IntrospectiveTests/Json.tests.cpp b/tests/SelfTest/IntrospectiveTests/Json.tests.cpp
index d026c76c..24210f62 100644
--- a/tests/SelfTest/IntrospectiveTests/Json.tests.cpp
+++ b/tests/SelfTest/IntrospectiveTests/Json.tests.cpp
@@ -174,6 +174,73 @@ TEST_CASE( "JsonWriter escapes characters in strings properly", "[JsonWriter]" )
         Catch::JsonValueWriter{ sstream }.write( "\\/\t\r\n" );
         REQUIRE( sstream.str() == "\"\\\\/\\t\\r\\n\"" );
     }
+    SECTION( "every C0 control character is escaped" ) {
+        // RFC 8259 requires U+0000..U+001F to be escaped. The eight with a
+        // two-character form keep it; the rest become \u00XX.
+        std::string allControls;
+        for ( int c = 0x00; c <= 0x1F; ++c ) {
+            allControls += static_cast<char>( c );
+        }
+        Catch::JsonValueWriter{ sstream }.write(
+            Catch::StringRef( allControls.data(), allControls.size() ) );
+        REQUIRE( sstream.str() ==
+                 "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007"
+                 "\\b\\t\\n\\u000b\\f\\r\\u000e\\u000f"
+                 "\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017"
+                 "\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"" );
+    }
+    SECTION( "escape sequence embedded in surrounding text" ) {
+        // The realistic case: a test writes ANSI-coloured output and the
+        // JSON reporter has to carry it without breaking the document.
+        Catch::JsonValueWriter{ sstream }.write( "\x1b[31mred\x1b[0m" );
+        REQUIRE( sstream.str() == "\"\\u001b[31mred\\u001b[0m\"" );
+    }
+    SECTION( "DEL is not a C0 control and is not escaped" ) {
+        Catch::JsonValueWriter{ sstream }.write( "\x7f" );
+        REQUIRE( sstream.str() == "\"\x7f\"" );
+    }
+}
+
+TEST_CASE( "JsonWriter: UTF-8", "[JSON][JsonWriter][UTF-8][approvals]" ) {
+    // JSON text has to be valid UTF-8 (RFC 8259 section 8.1), so bytes that
+    // are not part of a valid encoding are hex escaped. The spelling matches
+    // XmlEncode's, so both reporters render the same bytes the same way -
+    // compare the cases here with "XmlEncode: UTF-8" in Xml.tests.cpp.
+    auto encode = []( std::string const& str ) {
+        std::stringstream sstream;
+        Catch::JsonValueWriter{ sstream }.write(
+            Catch::StringRef( str.data(), str.size() ) );
+        return sstream.str();
+    };
+
+    SECTION( "Valid utf-8 strings are passed through" ) {
+        CHECK( encode( "Here be 👾" ) == "\"Here be 👾\"" );
+        CHECK( encode( "šš" ) == "\"šš\"" );
+        CHECK( encode( "\xDF\xBF" ) == "\"\xDF\xBF\"" );                 // 0x7FF
+        CHECK( encode( "\xE0\xA0\x80" ) == "\"\xE0\xA0\x80\"" );         // 0x800
+        CHECK( encode( "\xEF\xBF\xBF" ) == "\"\xEF\xBF\xBF\"" );         // 0xFFFF
+        CHECK( encode( "\xF0\x90\x80\x80" ) == "\"\xF0\x90\x80\x80\"" ); // 0x10000
+        CHECK( encode( "\xF4\x8F\xBF\xBF" ) == "\"\xF4\x8F\xBF\xBF\"" ); // 0x10FFFF
+    }
+    SECTION( "Invalid start bytes are escaped" ) {
+        CHECK( encode( "\xFF" ) == "\"\\\\xFF\"" );
+        CHECK( encode( "\x80" ) == "\"\\\\x80\"" );
+        CHECK( encode( "Here \xFF be \xF0\x9F\x91\xBE" ) ==
+               "\"Here \\\\xFF be \xF0\x9F\x91\xBE\"" );
+    }
+    SECTION( "Truncated sequences are escaped" ) {
+        CHECK( encode( "\xE0\xA0" ) == "\"\\\\xE0\\\\xA0\"" );
+        CHECK( encode( "\xC5\xC5\xA0" ) == "\"\\\\xC5\xC5\xA0\"" );
+    }
+    SECTION( "Overlong encodings are escaped" ) {
+        CHECK( encode( "\xC0\x80" ) == "\"\\\\xC0\\\\x80\"" );
+        CHECK( encode( "\xC1\xBF" ) == "\"\\\\xC1\\\\xBF\"" );
+        CHECK( encode( "\xE0\x9F\xBF" ) == "\"\\\\xE0\\\\x9F\\\\xBF\"" );
+    }
+    SECTION( "Values out of the unicode range are escaped" ) {
+        CHECK( encode( "\xF4\x90\x80\x80" ) ==
+               "\"\\\\xF4\\\\x90\\\\x80\\\\x80\"" );
+    }
 }
 
