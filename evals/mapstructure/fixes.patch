+func TestDecode_definedTypes(t *testing.T) {
+	t.Parallel()
+
+	// Every one of these used to panic on a type assertion that checked the
+	// Kind and then asserted the concrete type, which a defined type fails.
+	type definedString string
+	type definedBytes []byte
+
+	t.Run("defined string into a hook", func(t *testing.T) {
+		var result struct{ D time.Duration }
+		decoder, err := NewDecoder(&DecoderConfig{
+			Result:     &result,
+			DecodeHook: StringToTimeDurationHookFunc(),
+		})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if err := decoder.Decode(map[string]any{"D": definedString("1h")}); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.D != time.Hour {
+			t.Errorf("expected 1h, got %s", result.D)
+		}
+	})
+
+	t.Run("defined string into a basic type hook", func(t *testing.T) {
+		var result struct{ A int8 }
+		decoder, err := NewDecoder(&DecoderConfig{
+			Result:     &result,
+			DecodeHook: StringToBasicTypeHookFunc(),
+		})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if err := decoder.Decode(map[string]any{"A": definedString("42")}); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != 42 {
+			t.Errorf("expected 42, got %d", result.A)
+		}
+	})
+
+	t.Run("defined byte slice into a string", func(t *testing.T) {
+		var result struct{ A string }
+		if err := WeakDecode(map[string]any{"A": definedBytes("hi")}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != "hi" {
+			t.Errorf("expected hi, got %q", result.A)
+		}
+	})
+
+	t.Run("defined byte element slice into a string", func(t *testing.T) {
+		type definedByte byte
+		var result struct{ A string }
+		if err := WeakDecode(map[string]any{"A": []definedByte("hi")}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != "hi" {
+			t.Errorf("expected hi, got %q", result.A)
+		}
+	})
+
+	t.Run("pointer to json.Number", func(t *testing.T) {
+		number := json.Number("42")
+		var result struct {
+			A int
+			B uint
+			C float64
+		}
+		if err := Decode(map[string]any{"A": &number, "B": &number, "C": &number}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != 42 || result.B != 42 || result.C != 42 {
+			t.Errorf("expected 42 in every field, got %+v", result)
+		}
+	})
+
+	t.Run("defined string map key", func(t *testing.T) {
+		var result struct{ Name string }
+		if err := Decode(map[definedString]any{"name": "bob"}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.Name != "bob" {
+			t.Errorf("expected bob, got %q", result.Name)
+		}
+	})
+
+	t.Run("defined string key inside an any map", func(t *testing.T) {
+		var result struct{ Name string }
+		if err := Decode(map[any]any{definedString("NAME"): "bob"}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.Name != "bob" {
+			t.Errorf("expected bob, got %q", result.Name)
+		}
+	})
+}
