+// ParseError holds the cause that made a value unparseable, and every other
+// error type in this package exposes its cause to errors.Is and errors.As.
+func TestParseError_unwrap(t *testing.T) {
+	t.Parallel()
+
+	// The decoder joins its field failures, and errors.Is and errors.As only
+	// walk Unwrap() []error on Go 1.20 and later, while this module builds back
+	// to 1.18. So the joined error is opened with its own method first and the
+	// traversal is asserted on the field failure, which is a single-error chain
+	// every supported version understands. This is the same shape the joined
+	// error tests in mapstructure_test.go use.
+	fieldError := func(t *testing.T, err error) error {
+		t.Helper()
+		if err == nil {
+			t.Fatal("expected an error")
+		}
+		var joined interface{ Unwrap() []error }
+		if !errors.As(err, &joined) {
+			t.Fatalf("the decode error should expose Unwrap() []error, got %#v", err)
+		}
+		errs := joined.Unwrap()
+		if len(errs) != 1 {
+			t.Fatalf("expected one field failure, got %#v", errs)
+		}
+		return errs[0]
+	}
+
+	t.Run("errors.Is reaches the range sentinel", func(t *testing.T) {
+		var result struct{ N int8 }
+		err := fieldError(t, WeakDecode(map[string]any{"n": "99999999999999999999"}, &result))
+		if !errors.Is(err, strconv.ErrRange) {
+			t.Errorf("errors.Is should reach strconv.ErrRange: %v", err)
+		}
+		if errors.Is(err, strconv.ErrSyntax) {
+			t.Errorf("a range failure should not answer to strconv.ErrSyntax: %v", err)
+		}
+	})
+
+	t.Run("errors.Is reaches the syntax sentinel", func(t *testing.T) {
+		var result struct{ N int }
+		err := fieldError(t, WeakDecode(map[string]any{"n": "notanumber"}, &result))
+		if !errors.Is(err, strconv.ErrSyntax) {
+			t.Errorf("errors.Is should reach strconv.ErrSyntax: %v", err)
+		}
+		if errors.Is(err, strconv.ErrRange) {
+			t.Errorf("a syntax failure should not answer to strconv.ErrRange: %v", err)
+		}
+	})
+
+	t.Run("errors.As reaches the standard library error", func(t *testing.T) {
+		var result struct{ N int }
+		err := fieldError(t, WeakDecode(map[string]any{"n": "notanumber"}, &result))
+		var numErr *strconv.NumError
+		if !errors.As(err, &numErr) {
+			t.Fatalf("errors.As should reach *strconv.NumError: %v", err)
+		}
+		if numErr.Func != "ParseInt" {
+			t.Errorf("expected ParseInt: %#v", numErr)
+		}
+	})
+
+	t.Run("the message and the error interfaces are unchanged", func(t *testing.T) {
+		var result struct{ N int8 }
+		joinedErr := WeakDecode(map[string]any{"n": "99999999999999999999"}, &result)
+		err := fieldError(t, joinedErr)
+
+		// The message still scrubs the value that failed to parse: reaching
+		// the cause through errors.As is not the same as printing it.
+		if got := joinedErr.Error(); !strings.Contains(got, "cannot parse value as 'int8': strconv.ParseInt: value out of range") {
+			t.Errorf("unexpected message: %s", got)
+		}
+		if strings.Contains(joinedErr.Error(), "99999999999999999999") {
+			t.Errorf("the message echoes the input: %s", joinedErr.Error())
+		}
+
+		var parseErr *ParseError
+		if !errors.As(err, &parseErr) {
+			t.Fatalf("errors.As should still reach *ParseError: %v", err)
+		}
+		if parseErr.Value != any("99999999999999999999") {
+			t.Errorf("the exported Value field should still hold the input: %#v", parseErr.Value)
+		}
+		var msErr Error
+		if !errors.As(err, &msErr) {
+			t.Errorf("errors.As should still reach the Error interface: %v", err)
+		}
+	})
+}
