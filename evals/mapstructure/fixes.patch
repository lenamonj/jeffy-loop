+func TestDecode_structToNonStringKeyMap(t *testing.T) {
+	t.Parallel()
+
+	type source struct {
+		A string
+		B int
+	}
+	type definedKey string
+
+	// A map that cannot hold a field name is reported, where SetMapIndex used
+	// to panic with "value of type string is not assignable to type int".
+	t.Run("numeric key", func(t *testing.T) {
+		result := map[int]any{}
+		err := Decode(source{A: "x"}, &result)
+		if err == nil {
+			t.Fatalf("expected an error, got %v", result)
+		}
+		if !strings.Contains(err.Error(), `cannot store field names in a map with "int" keys`) {
+			t.Errorf("unexpected error: %s", err)
+		}
+		if !strings.Contains(err.Error(), "map[int]interface {}") {
+			t.Errorf("the error should name the target at the root: %s", err)
+		}
+	})
+
+	t.Run("float key", func(t *testing.T) {
+		result := map[float64]any{}
+		if err := Decode(source{A: "x"}, &result); err == nil {
+			t.Fatalf("expected an error, got %v", result)
+		}
+	})
+
+	// A defined string key type can hold a field name after a conversion, the
+	// same conversion the map-to-struct direction makes.
+	t.Run("defined string key", func(t *testing.T) {
+		result := map[definedKey]any{}
+		if err := Decode(source{A: "x", B: 2}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result["A"] != "x" || result["B"] != 2 {
+			t.Errorf("expected A and B to be set, got %v", result)
+		}
+	})
+
+	t.Run("defined string key with remain and nesting", func(t *testing.T) {
+		type withRemain struct {
+			A     string
+			Inner source
+			Other map[string]any `mapstructure:",remain"`
+		}
+		result := map[definedKey]any{}
+		input := withRemain{A: "x", Inner: source{A: "y"}, Other: map[string]any{"z": 1}}
+		if err := Decode(input, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result["A"] != "x" || result["z"] != 1 {
+			t.Errorf("expected the field and the remaining key, got %v", result)
+		}
+		if _, ok := result["Inner"]; !ok {
+			t.Errorf("expected the nested struct to be mapped, got %v", result)
+		}
+	})
+
+	// The shapes that already worked keep working.
+	t.Run("string and interface keys", func(t *testing.T) {
+		asString := map[string]any{}
+		if err := Decode(source{A: "x"}, &asString); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if asString["A"] != "x" {
+			t.Errorf("expected A to be set, got %v", asString)
+		}
+
+		asAny := map[any]any{}
+		if err := Decode(source{A: "x"}, &asAny); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if asAny["A"] != "x" {
+			t.Errorf("expected A to be set, got %v", asAny)
+		}
+	})
+}
