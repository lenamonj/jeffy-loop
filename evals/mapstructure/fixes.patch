+func TestDecode_arrayOverflow(t *testing.T) {
+	t.Parallel()
+
+	type element struct {
+		N string
+	}
+
+	three := []any{
+		map[string]any{"N": "a"},
+		map[string]any{"N": "b"},
+		map[string]any{"N": "c"},
+	}
+
+	// An array target whose element type is not comparable, or that already
+	// holds values, used to skip the length check entirely and panic inside
+	// reflect with "array index out of range".
+	t.Run("into an array of maps", func(t *testing.T) {
+		var result struct{ A [2]map[string]any }
+		err := Decode(map[string]any{"A": three}, &result)
+		if err == nil {
+			t.Fatalf("expected a length error, got %v", result.A)
+		}
+		if !strings.Contains(err.Error(), "length less or equal to 2, got 3") {
+			t.Errorf("unexpected error: %s", err)
+		}
+	})
+
+	t.Run("into an array of slices", func(t *testing.T) {
+		var result struct{ A [2][]int }
+		err := Decode(map[string]any{"A": []any{[]int{1}, []int{2}, []int{3}}}, &result)
+		if err == nil {
+			t.Fatalf("expected a length error, got %v", result.A)
+		}
+		if !strings.Contains(err.Error(), "length less or equal to 2, got 3") {
+			t.Errorf("unexpected error: %s", err)
+		}
+	})
+
+	t.Run("into an array of structs", func(t *testing.T) {
+		var result struct{ A [2]element }
+		err := Decode(map[string]any{"A": three}, &result)
+		if err == nil {
+			t.Fatalf("expected a length error, got %v", result.A)
+		}
+		if !strings.Contains(err.Error(), "length less or equal to 2, got 3") {
+			t.Errorf("unexpected error: %s", err)
+		}
+	})
+
+	t.Run("into an array that already holds values", func(t *testing.T) {
+		result := struct{ A [2]int }{A: [2]int{9, 9}}
+		err := Decode(map[string]any{"A": []any{1, 2, 3}}, &result)
+		if err == nil {
+			t.Fatalf("expected a length error, got %v", result.A)
+		}
+		if result.A != [2]int{9, 9} {
+			t.Errorf("the target should be untouched on a rejected decode, got %v", result.A)
+		}
+	})
+
+	t.Run("from a value that is not a sequence", func(t *testing.T) {
+		var result struct{ A [2]map[string]any }
+		err := Decode(map[string]any{"A": 5}, &result)
+		if err == nil {
+			t.Fatal("expected an error for a scalar source")
+		}
+		if !strings.Contains(err.Error(), "source data must be an array or slice, got int") {
+			t.Errorf("unexpected error: %s", err)
+		}
+	})
+
+	// The same skipped branch also skipped weak lifting, which then indexed the
+	// string itself and wrote its bytes into the array.
+	t.Run("weak lift into an array that already holds values", func(t *testing.T) {
+		result := struct{ A [2]string }{A: [2]string{"x", "y"}}
+		if err := WeakDecode(map[string]any{"A": "z"}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != [2]string{"z", "y"} {
+			t.Errorf("expected [z y], got %v", result.A)
+		}
+	})
+
+	// Inputs that fit keep decoding, including a merge into a populated array.
+	t.Run("fitting inputs still decode", func(t *testing.T) {
+		var fresh struct{ A [2]int }
+		if err := Decode(map[string]any{"A": []any{1, 2}}, &fresh); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if fresh.A != [2]int{1, 2} {
+			t.Errorf("expected [1 2], got %v", fresh.A)
+		}
+
+		populated := struct{ A [2]int }{A: [2]int{9, 9}}
+		if err := Decode(map[string]any{"A": []any{1}}, &populated); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if populated.A != [2]int{1, 9} {
+			t.Errorf("a short input should merge into the target, got %v", populated.A)
+		}
+
+		var weakEmpty struct{ A [2]int }
+		if err := WeakDecode(map[string]any{"A": map[string]any{}}, &weakEmpty); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if weakEmpty.A != [2]int{} {
+			t.Errorf("an empty map should give the zero array, got %v", weakEmpty.A)
+		}
+	})
+}
