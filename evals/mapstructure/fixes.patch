+func TestOrComposeDecodeHookFunc_traversal(t *testing.T) {
+	t.Parallel()
+
+	// Same defect and same remedy as the joined decode error: the aggregate
+	// exposes Unwrap() []error, which errors.Is and errors.As do not walk
+	// before Go 1.20, so it carries As and Is as well. TestOrComposeDecodeHookFunc_errors
+	// opens the aggregate with its own method; this reaches through it.
+	errFirst := errors.New("first failure")
+	errSecond := errors.New("second failure")
+	failing := func(err error) DecodeHookFunc {
+		return func(f reflect.Type, t reflect.Type, data any) (any, error) {
+			return nil, err
+		}
+	}
+	aggregate := func(t *testing.T) error {
+		t.Helper()
+		_, err := DecodeHookExec(
+			OrComposeDecodeHookFunc(failing(errFirst), failing(fmt.Errorf("wrapped: %w", errSecond))),
+			reflect.ValueOf("in"), reflect.ValueOf(""),
+		)
+		if err == nil {
+			t.Fatal("expected an error")
+		}
+		return err
+	}
+
+	t.Run("errors.Is reaches every failure", func(t *testing.T) {
+		err := aggregate(t)
+		if !errors.Is(err, errFirst) {
+			t.Error("errors.Is should reach the first failure")
+		}
+		if !errors.Is(err, errSecond) {
+			t.Error("errors.Is should reach the second failure through its wrapper")
+		}
+		if errors.Is(err, errors.New("unrelated")) {
+			t.Error("an unrelated error should not be reached")
+		}
+	})
+
+	t.Run("errors.As reaches a failure's type", func(t *testing.T) {
+		_, err := DecodeHookExec(
+			OrComposeDecodeHookFunc(failing(errFirst), failing(&net.AddrError{Err: "bad", Addr: "x"})),
+			reflect.ValueOf("in"), reflect.ValueOf(""),
+		)
+		if err == nil {
+			t.Fatal("expected an error")
+		}
