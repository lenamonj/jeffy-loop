+func TestComposeDecodeHookFunc_nilResult(t *testing.T) {
+	passthrough := func(f reflect.Type, t reflect.Type, data any) (any, error) {
+		return data, nil
+	}
+	toNil := func(f reflect.Type, t reflect.Type, data any) (any, error) {
+		return nil, nil
+	}
+	toInvalidValue := func(f reflect.Type, t reflect.Type, data any) (any, error) {
+		return reflect.Value{}, nil
+	}
+	// Only marks the leaf: the hook runs for every value, the root map
+	// included, and turning that map into a string is not what is under test.
+	appendMark := func(f reflect.Type, t reflect.Type, data any) (any, error) {
+		if t.Kind() != reflect.String {
+			return data, nil
+		}
+		return fmt.Sprintf("%v-marked", data), nil
+	}
+
+	// A hook that returns nil ends the chain. Feeding that nil onward used to
+	// panic in the next hook with "reflect: call of reflect.Value.Type on zero
+	// Value"; the decoder reads a nil result as "write nothing", which is what
+	// a nil from the last hook already did.
+	cases := []struct {
+		name  string
+		hooks []DecodeHookFunc
+	}{
+		{"nil first", []DecodeHookFunc{toNil, passthrough}},
+		{"nil last", []DecodeHookFunc{passthrough, toNil}},
+		{"nil only", []DecodeHookFunc{toNil}},
+		{"nil twice", []DecodeHookFunc{toNil, toNil}},
+		{"invalid value first", []DecodeHookFunc{toInvalidValue, passthrough}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			result := struct{ A string }{A: "untouched"}
+			decoder, err := NewDecoder(&DecoderConfig{
+				Result:     &result,
+				DecodeHook: ComposeDecodeHookFunc(tc.hooks...),
+			})
+			if err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if err := decoder.Decode(map[string]any{"a": "x"}); err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if result.A != "untouched" {
+				t.Errorf("a nil hook result should write nothing, got %q", result.A)
+			}
+		})
+	}
+
+	// Composition still chains when no hook returns nil, and an error still
+	// stops it.
+	t.Run("chaining is unchanged", func(t *testing.T) {
+		var result struct{ A string }
+		decoder, err := NewDecoder(&DecoderConfig{
+			Result:     &result,
+			DecodeHook: ComposeDecodeHookFunc(appendMark, appendMark),
+		})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if err := decoder.Decode(map[string]any{"a": "x"}); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.A != "x-marked-marked" {
+			t.Errorf("expected both hooks to run in order, got %q", result.A)
+		}
+	})
+
+	t.Run("an error still stops the chain", func(t *testing.T) {
+		boom := func(f reflect.Type, t reflect.Type, data any) (any, error) {
+			return nil, errors.New("boom")
+		}
+		var result struct{ A string }
+		decoder, err := NewDecoder(&DecoderConfig{
+			Result:     &result,
+			DecodeHook: ComposeDecodeHookFunc(boom, appendMark),
+		})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		err = decoder.Decode(map[string]any{"a": "x"})
+		if err == nil || !strings.Contains(err.Error(), "boom") {
+			t.Fatalf("expected the hook error, got %v", err)
+		}
+	})
+}
