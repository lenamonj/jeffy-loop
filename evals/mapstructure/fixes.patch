+// OrComposeDecodeHookFunc aggregates the failures when no composed hook
+// succeeds. The concatenated message is what callers have parsed since v2, and
+// the individual errors have to stay reachable through it.
+func TestOrComposeDecodeHookFunc_errors(t *testing.T) {
+	errFirst := errors.New("first failure")
+	errSecond := errors.New("second failure")
+
+	failing := func(err error) DecodeHookFunc {
+		return func(f reflect.Type, t reflect.Type, data any) (any, error) {
+			return nil, err
+		}
+	}
+	succeeding := func(v any) DecodeHookFunc {
+		return func(f reflect.Type, t reflect.Type, data any) (any, error) {
+			return v, nil
+		}
+	}
+	exec := func(hook DecodeHookFunc) (any, error) {
+		return DecodeHookExec(hook, reflect.ValueOf("in"), reflect.ValueOf(""))
+	}
+
+	t.Run("no hooks is a named error", func(t *testing.T) {
+		_, err := exec(OrComposeDecodeHookFunc())
+		if err == nil {
+			t.Fatal("expected an error")
+		}
+		// Asserted on the message rather than on the unexported sentinel, so
+		// this whole test compiles against the tree it was written to fail on.
+		if !strings.Contains(err.Error(), "no decode hooks") {
+			t.Errorf("the error should name the condition, got: %q", err.Error())
+		}
+	})
+
+	t.Run("every failure stays reachable", func(t *testing.T) {
+		_, err := exec(OrComposeDecodeHookFunc(failing(errFirst), failing(errSecond)))
+		if err == nil {
+			t.Fatal("expected an error")
+		}
+
+		// errors.Is only walks Unwrap() []error on Go 1.20 and later, and this
+		// module builds back to 1.18, so the errors are reached through the
+		// method itself - the same shape the joined decode error uses.
+		var joined interface{ Unwrap() []error }
+		if !errors.As(err, &joined) {
+			t.Fatalf("the aggregate should expose Unwrap() []error, got %#v", err)
+		}
+		errs := joined.Unwrap()
+		if len(errs) != 2 {
+			t.Fatalf("expected both failures, got %#v", errs)
+		}
+		if !errors.Is(errs[0], errFirst) || !errors.Is(errs[1], errSecond) {
+			t.Errorf("expected the composed errors in order, got %#v", errs)
+		}
+	})
+
+	t.Run("the aggregate message is unchanged", func(t *testing.T) {
+		_, err := exec(OrComposeDecodeHookFunc(failing(errFirst), failing(errSecond)))
+		if got, want := err.Error(), "first failure\nsecond failure\n"; got != want {
+			t.Errorf("message changed:\n got: %q\nwant: %q", got, want)
+		}
+	})
+
+	t.Run("a success still short-circuits", func(t *testing.T) {
+		out, err := exec(OrComposeDecodeHookFunc(failing(errFirst), succeeding("ok")))
+		if err != nil {
+			t.Fatalf("should not error: %s", err)
+		}
+		if out != "ok" {
+			t.Errorf("expected the first success, got %#v", out)
+		}
+	})
+}
