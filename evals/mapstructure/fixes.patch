+func TestWeakDecode_floatToString(t *testing.T) {
+	t.Parallel()
+
+	// A float32 formatted at float64 width prints the expansion of its binary
+	// value: 1.1 used to arrive as "1.100000023841858".
+	floats := []struct {
+		name  string
+		input any
+		want  string
+	}{
+		{"float32", float32(1.1), "1.1"},
+		{"float32 tenth", float32(0.1), "0.1"},
+		{"float32 negative", float32(-2.5), "-2.5"},
+		{"float64", 1.1, "1.1"},
+		{"float64 precision", 1.100000023841858, "1.100000023841858"},
+	}
+	for _, tc := range floats {
+		t.Run("decoder "+tc.name, func(t *testing.T) {
+			var result struct{ S string }
+			if err := WeakDecode(map[string]any{"s": tc.input}, &result); err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if result.S != tc.want {
+				t.Errorf("expected %q, got %q", tc.want, result.S)
+			}
+		})
+
+		t.Run("hook "+tc.name, func(t *testing.T) {
+			out, err := DecodeHookExec(WeaklyTypedHook, reflect.ValueOf(tc.input), reflect.ValueOf(""))
+			if err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if out != tc.want {
+				t.Errorf("expected %q, got %q", tc.want, out)
+			}
+		})
+	}
+
+	// WeaklyTypedHook switched on the unsized kinds only, so every sized int,
+	// uint and float64 fell through it unconverted.
+	sized := []struct {
+		name  string
+		input any
+		want  string
+	}{
+		{"int8", int8(-7), "-7"},
+		{"int64", int64(7), "7"},
+		{"uint16", uint16(9), "9"},
+		{"uint64", uint64(9), "9"},
+		{"int", 7, "7"},
+		{"uint", uint(9), "9"},
+		{"bool", true, "1"},
+		{"byte slice", []byte("hi"), "hi"},
+	}
+	for _, tc := range sized {
+		t.Run("hook sized "+tc.name, func(t *testing.T) {
+			out, err := DecodeHookExec(WeaklyTypedHook, reflect.ValueOf(tc.input), reflect.ValueOf(""))
+			if err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if out != tc.want {
+				t.Errorf("expected %q, got %v", tc.want, out)
+			}
+		})
+	}
+
+	// A non-string target is still left alone, and so is a kind the hook does
+	// not convert.
+	out, err := DecodeHookExec(WeaklyTypedHook, reflect.ValueOf(42), reflect.ValueOf(0))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if out != 42 {
+		t.Errorf("expected the value to pass through, got %v", out)
+	}
+
+	out, err = DecodeHookExec(WeaklyTypedHook, reflect.ValueOf([]string{"a"}), reflect.ValueOf(""))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(out, []string{"a"}) {
+		t.Errorf("expected the slice to pass through, got %v", out)
+	}
+}
