+func TestDecode_numericOverflow(t *testing.T) {
+	t.Parallel()
+
+	type target struct {
+		Int8    int8
+		Uint8   uint8
+		Int64   int64
+		Uint64  uint64
+		Float32 float32
+		Float64 float64
+	}
+
+	// Values that do not fit the target type must be reported, not truncated.
+	// Before this check they landed silently: 300 became 44 and 1e40 became +Inf.
+	overflows := []struct {
+		name  string
+		input map[string]any
+	}{
+		{"int into int8", map[string]any{"Int8": 300}},
+		{"negative int into int8", map[string]any{"Int8": -300}},
+		{"uint into uint8", map[string]any{"Uint8": uint(300)}},
+		{"uint64 into int8", map[string]any{"Int8": uint64(1) << 63}},
+		{"uint64 into int64", map[string]any{"Int64": uint64(math.MaxInt64) + 1}},
+		{"float into int8", map[string]any{"Int8": 300.9}},
+		{"float into uint8", map[string]any{"Uint8": 300.9}},
+		{"float into int64", map[string]any{"Int64": 1e30}},
+		{"float into uint64", map[string]any{"Uint64": 1e30}},
+		{"float into float32", map[string]any{"Float32": 1e40}},
+		{"json.Number into int8", map[string]any{"Int8": json.Number("300")}},
+		{"json.Number into uint8", map[string]any{"Uint8": json.Number("300")}},
+		{"json.Number into float32", map[string]any{"Float32": json.Number("1e40")}},
+		{"string into int8", map[string]any{"Int8": "300"}},
+		{"string into uint8", map[string]any{"Uint8": "300"}},
+	}
+
+	for _, tc := range overflows {
+		t.Run(tc.name, func(t *testing.T) {
+			var result target
+			// WeaklyTypedInput so the string cases reach the numeric decoders;
+			// it must not turn an out-of-range value into a silent wrap.
+			err := WeakDecode(tc.input, &result)
+			if err == nil {
+				t.Fatalf("expected an error, got result %+v", result)
+			}
+
+			var parseErr *ParseError
+			if !errors.As(err, &parseErr) {
+				t.Errorf("expected a *ParseError, got %#v", err)
+			}
+
+			if result != (target{}) {
+				t.Errorf("target should be left zeroed on overflow, got %+v", result)
+			}
+		})
+	}
+
+	// Values that do fit, including the boundaries and the documented weak
+	// negative-to-uint wrap, must keep decoding exactly as before.
+	fits := []struct {
+		name  string
+		input map[string]any
+		want  target
+		weak  bool
+	}{
+		{"in range int", map[string]any{"Int8": 42}, target{Int8: 42}, false},
+		{"int8 min", map[string]any{"Int8": -128}, target{Int8: -128}, false},
+		{"int8 max", map[string]any{"Int8": 127}, target{Int8: 127}, false},
+		{"uint8 max", map[string]any{"Uint8": 255}, target{Uint8: 255}, false},
+		{"int64 max", map[string]any{"Int64": int64(math.MaxInt64)}, target{Int64: math.MaxInt64}, false},
+		{"uint64 max", map[string]any{"Uint64": uint64(math.MaxUint64)}, target{Uint64: math.MaxUint64}, false},
+		{"truncating float", map[string]any{"Int8": 42.9}, target{Int8: 42}, false},
+		{"float32 max", map[string]any{"Float32": float64(math.MaxFloat32)}, target{Float32: math.MaxFloat32}, false},
+		{"float64 into float64", map[string]any{"Float64": 1e40}, target{Float64: 1e40}, false},
+		{"negative int into uint, weak", map[string]any{"Uint8": -1}, target{Uint8: 255}, true},
+		{"negative float into uint, weak", map[string]any{"Uint8": -1.0}, target{Uint8: 255}, true},
+	}
+
+	for _, tc := range fits {
+		t.Run(tc.name, func(t *testing.T) {
+			var result target
+			var err error
+			if tc.weak {
+				err = WeakDecode(tc.input, &result)
+			} else {
+				err = Decode(tc.input, &result)
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %s", err)
+			}
+			if result != tc.want {
+				t.Errorf("expected %+v, got %+v", tc.want, result)
+			}
+		})
+	}
+
+	// An infinity is not an overflow: it is the value the input already held.
+	var inf target
+	if err := Decode(map[string]any{"Float32": math.Inf(1)}, &inf); err != nil {
+		t.Fatalf("unexpected error decoding +Inf: %s", err)
+	}
+	if !math.IsInf(float64(inf.Float32), 1) {
+		t.Errorf("expected +Inf, got %v", inf.Float32)
+	}
+}
