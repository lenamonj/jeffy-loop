+func TestDecode_nonStringMapKeys(t *testing.T) {
+	t.Parallel()
+
+	type target struct {
+		Name string
+	}
+
+	// map[any]any is a documented input shape, so a numeric key in it has to be
+	// reported rather than asserted: these paths used to panic with
+	// "interface conversion: interface {} is int, not string".
+	t.Run("metadata", func(t *testing.T) {
+		var result target
+		var md Metadata
+		if err := DecodeMetadata(map[any]any{1: "x", "name": "bob"}, &result, &md); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.Name != "bob" {
+			t.Errorf("expected bob, got %q", result.Name)
+		}
+		if !reflect.DeepEqual(md.Unused, []string{"1"}) {
+			t.Errorf("expected unused [1], got %v", md.Unused)
+		}
+	})
+
+	t.Run("error unused", func(t *testing.T) {
+		var result target
+		decoder, err := NewDecoder(&DecoderConfig{Result: &result, ErrorUnused: true})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		err = decoder.Decode(map[any]any{1: "x", "name": "bob"})
+		if err == nil {
+			t.Fatal("expected an error for the unused key")
+		}
+		if !strings.Contains(err.Error(), "has invalid keys: 1") {
+			t.Errorf("error should name the unused key, got: %s", err)
+		}
+	})
+
+	t.Run("error unset with metadata", func(t *testing.T) {
+		var result struct {
+			Name string
+			Age  int
+		}
+		var md Metadata
+		decoder, err := NewDecoder(&DecoderConfig{Result: &result, Metadata: &md, ErrorUnset: true})
+		if err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		err = decoder.Decode(map[any]any{2: "x", "name": "bob"})
+		if err == nil {
+			t.Fatal("expected an error for the unset field")
+		}
+		if !strings.Contains(err.Error(), "has unset fields: Age") {
+			t.Errorf("error should name the unset field, got: %s", err)
+		}
+	})
+
+	t.Run("remain", func(t *testing.T) {
+		var result struct {
+			Name  string
+			Other map[string]any `mapstructure:",remain"`
+		}
+		if err := Decode(map[any]any{"name": "bob", "extra": 3}, &result); err != nil {
+			t.Fatalf("unexpected error: %s", err)
+		}
+		if result.Other["extra"] != 3 {
+			t.Errorf("expected the remaining key to be collected, got %v", result.Other)
+		}
+	})
+}
