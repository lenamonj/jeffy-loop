+func TestDecode_cyclicInput(t *testing.T) {
+	t.Parallel()
+
+	// A value that refers to itself has no bottom. No text format decoder emits
+	// one, but a calling program can build one, and before maxDecodeDepth this
+	// decode recursed until the process died of a fatal out-of-memory abort no
+	// caller could catch.
+	type nested struct {
+		Name string
+		Next *nested
+	}
+
+	m := map[string]any{"name": "a"}
+	m["next"] = m
+
+	var result nested
+	err := Decode(m, &result)
+	if err == nil {
+		t.Fatal("expected an error, got none")
+	}
+	if !strings.Contains(err.Error(), "exceeded max depth") {
+		t.Errorf("the error should name the bound it hit, got: %.160q", err.Error())
+	}
+	var target Error
+	if !errors.As(err, &target) {
+		t.Error("the depth error should reach the package's Error interface")
+	}
+}
