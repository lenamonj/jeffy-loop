+#[cfg(test)]
+mod ignorable_characters {
+    use super::DataUrl;
+    use alloc::string::String;
+    use alloc::vec::Vec;
+
+    /// Everything a caller can observe about a processed data URL.
+    #[derive(PartialEq, Debug)]
+    struct Outcome {
+        mime: Option<String>,
+        body: Option<Vec<u8>>,
+        fragment: Option<Option<String>>,
+    }
+
+    fn observe(input: &str) -> Outcome {
+        match DataUrl::process(input) {
+            Err(_) => Outcome {
+                mime: None,
+                body: None,
+                fragment: None,
+            },
+            Ok(url) => {
+                let mime = Some(alloc::format!("{}", url.mime_type()));
+                match url.decode_to_vec() {
+                    Err(_) => Outcome {
+                        mime,
+                        body: None,
+                        fragment: None,
+                    },
+                    Ok((body, fragment)) => Outcome {
+                        mime,
+                        body: Some(body),
+                        fragment: Some(fragment.map(|f| f.to_percent_encoded())),
+                    },
+                }
+            }
+        }
+    }
+
+    /// The URL parser removes every ASCII tab and newline from its input before
+    /// parsing, so a data URL must decode identically with those characters
+    /// inserted anywhere. The check provokes that at every position of every
+    /// representative URL rather than reasoning about which code reads them:
+    /// scheme matching, the mime type, its parameters, the base64 suffix, a
+    /// percent-escaped body, a malformed escape, and a fragment.
+    #[test]
+    fn tabs_and_newlines_are_ignored_at_every_position() {
+        const INPUTS: &[&str] = &[
+            "data:,plain",
+            "data:,a%20b",
+            "data:,%F0%9F%92%96",
+            "data:,100%",
+            "data:,%zz",
+            "data:text/html,<p>hi</p>",
+            "data:text/plain;charset=utf-8,x",
+            "data:;charset=utf-8,x",
+            "data:text/plain;base64,Zm9vYmFy",
+            "data:;base64,SGVsbG8sIHdvcmxkIQ==",
+            "data:,body#frag",
+            "data:text/html;base64,PHA+aGk8L3A+#tail",
+            "data:application/octet-stream;base64,AAECAwQ=",
+            "data:text/plain;a=\"x;y\",v",
+        ];
+        const IGNORABLE: &[char] = &['\t', '\n', '\r'];
+
+        let mut cases = 0usize;
+        for input in INPUTS {
+            let expected = observe(input);
+            for &ch in IGNORABLE {
+                for position in 0..=input.len() {
+                    if !input.is_char_boundary(position) {
+                        continue;
+                    }
+                    let mut mutated = String::with_capacity(input.len() + 1);
+                    mutated.push_str(&input[..position]);
+                    mutated.push(ch);
+                    mutated.push_str(&input[position..]);
+                    cases += 1;
+                    assert_eq!(
+                        observe(&mutated),
+                        expected,
+                        "inserting {:?} at byte {} of {:?} changed the outcome",
+                        ch,
+                        position,
+                        input
+                    );
+                }
+            }
+        }
+        assert_eq!(cases, 1011, "the enumeration lost cases");
+    }
+}
