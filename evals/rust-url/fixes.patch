+/// URL-17. WHATWG removes every ASCII tab, LF and CR from a URL before parsing
+/// it, so inserting one anywhere must not change the result. The crate's own
+/// answer for the same input without the character is therefore the oracle, and
+/// no spec reading is needed to grade this.
+///
+/// The class this catches is narrow and easy to miss: `push_pending` writes the
+/// pending characters into the serialization at one of those three characters
+/// as well as at a separator, so a mid-segment buffer becomes visible to code
+/// that expects to see only complete segments. A grid built from ordinary URLs
+/// cannot reach it however wide it is, because the trigger is the character
+/// itself. An insertion enumeration is the instrument for that.
+#[test]
+fn test_a_tab_or_newline_never_changes_how_a_url_parses() {
+    const CORPUS: &[&str] = &[
+        "file:///C:x",
+        "file:///C:/x",
+        "file:///C:",
+        "file:///x",
+        "file:///C:a/b",
+        "file://h/C:x",
+        "file:/C:x",
+        "file:C:x",
+        "http://h/C:x",
+        "foo:///C:x",
+        "file:///C|x",
+        "file:///a/C:x",
+        "file:///",
+        "file:///C:/",
+        "file://h/a",
+    ];
+
+    let mut changed = Vec::new();
+    let mut insertions = 0usize;
+    for input in CORPUS {
+        let clean = Url::parse(input).map(|u| u.to_string());
+        for c in ['\t', '\n', '\r'] {
+            for position in 0..=input.len() {
+                if !input.is_char_boundary(position) {
+                    continue;
+                }
+                let mut spelled = input.to_string();
+                spelled.insert(position, c);
+                insertions += 1;
+                let got = Url::parse(&spelled).map(|u| u.to_string());
+                if got != clean {
+                    changed.push(format!(
+                        "{:?} with {:?} at {} parsed as {:?}, without it {:?}",
+                        input, c, position, got, clean
+                    ));
+                }
+            }
+        }
+    }
+    assert_eq!(insertions, 522, "the corpus changed size");
+    assert!(
+        changed.is_empty(),
+        "{} of {} insertions changed the parse:\n{}",
+        changed.len(),
+        insertions,
+        changed.join("\n")
+    );
+
+    // The same class through the setter entrance, which reaches the same loop
+    // with a different context.
+    let mut with_tab = Url::parse("file:///a").unwrap();
+    with_tab.set_path("/C:\tx");
+    let mut without = Url::parse("file:///a").unwrap();
+    without.set_path("/C:x");
+    assert_eq!(with_tab.as_str(), without.as_str());
+    assert_eq!(without.path(), "/C:x");
+
+    // The arm this guards is live, not dead: a path that already ends at a
+    // drive letter still gains its separator when the path continues.
+    let base = Url::parse("fIlE:p:?../").unwrap();
+    assert_eq!(base.join("a").unwrap().as_str(), "file:///p:/a");
+}
