+#[test]
+/// `shorten a URL's path` step 4 protects a Windows drive letter only when it
+/// is `path[0]` and the path has one segment. A drive letter deeper in the
+/// path is an ordinary segment, so `..` must pop it. Popping it used to be
+/// refused, which left the reference resolved against a path that had not been
+/// shortened: a debug build tripped the segment-start assertion in the parser
+/// and a release build returned the unshortened path with the reference
+/// appended.
+fn test_join_pops_a_windows_drive_letter_that_is_not_the_first_segment() {
+    for (base, reference, expected) in [
+        // The drive letter is not path[0]: an ordinary segment, so it pops.
+        ("file:///x/C:", "../y", "file:///y"),
+        ("file:///x/C:", "..", "file:///"),
+        ("file:///x/C:", ".", "file:///x/"),
+        ("file:///x/C:/y", "../z", "file:///x/z"),
+        ("file:///x/y/C:", "../../z", "file:///z"),
+        ("file:///a/b/C:/d", "../../e", "file:///a/e"),
+        // The drive letter is path[0] with one segment: protected, so `..`
+        // shortens to it and no further.
+        ("file:///C:", "../y", "file:///C:/y"),
+        ("file:///C:", "..", "file:///C:/"),
+        ("file:///C:/a", "../y", "file:///C:/y"),
+        ("file:///C:/a/b", "../../y", "file:///C:/y"),
+        ("file:///C:/a", "../../../y", "file:///C:/y"),
+        // A non-file scheme has no drive letters at all.
+        ("foo:///x/C:", "../y", "foo:///y"),
+        ("http://h/x/C:", "../y", "http://h/y"),
+    ] {
+        let joined = Url::parse(base)
+            .unwrap()
+            .join(reference)
+            .unwrap_or_else(|e| panic!("{} join {:?}: {}", base, reference, e));
+        assert_eq!(joined.as_str(), expected, "{} join {:?}", base, reference);
+    }
+
+    // `join` is one of two entrances to the path-shortening helpers. The other
+    // is parsing a whole URL, where a hostless `file:` URL carries an extra
+    // leading slash for as long as it is being built, so the offset at which
+    // `path[0]` begins is not the one `join` establishes.
+    for (input, expected) in [
+        ("file:///C:/..", "file:///C:/"),
+        ("file:///C:/../..", "file:///C:/"),
+        ("file:///C:/a/../../x", "file:///C:/x"),
+        ("file://localhost/C:/..", "file:///C:/"),
+        ("file:///x/C:/..", "file:///x/"),
+        ("file:///x/C:/../..", "file:///"),
+        ("http://h/C:/..", "http://h/"),
+    ] {
+        let parsed = Url::parse(input).unwrap();
+        assert_eq!(parsed.as_str(), expected, "parse {:?}", input);
+    }
+
+    // And the two entrances must agree: for a base ending in `/` and a
+    // reference that is not itself an absolute URL, parsing the concatenation
+    // and joining the reference describe the same operation. References
+    // spelling a drive letter with `|` are left out: the two entrances really
+    // do disagree there, because only `join` reaches the code that rewrites
+    // `C|` as `C:`, and that is a separate defect from this one.
+    for base in [
+        "file:///",
+        "file:///C:/",
+        "file:///x/",
+        "file:///x/C:/",
+        "file://localhost/",
+        "file://localhost/C:/",
+        "http://h/",
+        "http://h/C:/",
+        "http://h/x/",
+    ] {
+        for reference in [
+            "..",
+            "../",
+            "../..",
+            "../../",
+            "../../x",
+            ".",
+            "./",
+            "a/..",
+            "a/../",
+            "a/../..",
+            "a/../../x",
+            "x/C:/..",
+            "x/C:/../..",
+            "a/b/../../..",
+            "%2e%2e",
+            "%2e%2e/",
+            "a/%2e%2e/..",
+        ] {
+            let parsed = Url::parse(&format!("{}{}", base, reference)).unwrap();
+            let joined = Url::parse(base).unwrap().join(reference).unwrap();
+            assert_eq!(
+                parsed.as_str(),
+                joined.as_str(),
+                "parse({:?} + {:?}) disagrees with join",
+                base,
+                reference
+            );
+        }
+    }
+}
