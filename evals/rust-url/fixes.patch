+#[test]
+/// Removing the host must clear the parsed host as well as the serialization,
+/// including when the removed host was an IP address.
+fn test_set_host_none_clears_the_parsed_host() {
+    for (input, expected) in [
+        ("moz://foo:bar@servo/baz", "moz:/baz"),
+        ("foo://example.com:99/p", "foo:/p"),
+        ("foo://[::1]/p", "foo:/p"),
+        ("file://server/share", "file:///share"),
+        ("file://192.168.0.1/p", "file:///p"),
+        ("file://[::1]/p", "file:///p"),
+    ] {
+        let mut url: Url = input.parse().unwrap();
+        url.set_host(None).unwrap();
+        assert_eq!(url.as_str(), expected, "input {:?}", input);
+        assert!(!url.has_host(), "input {:?} still reports a host", input);
+        assert_eq!(url.host_str(), None, "input {:?}", input);
+        assert_eq!(url.host(), None, "input {:?}", input);
+        assert_eq!(url.port(), None, "input {:?}", input);
+        url.check_invariants().unwrap();
+        // The accessors must match a fresh parse of the same serialization.
+        let reparsed = Url::parse(url.as_str()).unwrap();
+        assert_eq!(url, reparsed);
+        assert_eq!(url.has_host(), reparsed.has_host(), "input {:?}", input);
+        assert_eq!(url.host(), reparsed.host(), "input {:?}", input);
+    }
+}
