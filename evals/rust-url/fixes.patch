+    // rather than only covered.
+    let no_authority = Url::parse("foo:/a").unwrap();
+    let empty_authority = Url::parse("foo:///a").unwrap();
+    assert_eq!(no_authority.make_relative(&empty_authority), None);
+    assert_eq!(empty_authority.make_relative(&no_authority), None);
+    assert_eq!(
+        Url::parse("foo:/a/b")
+            .unwrap()
+            .make_relative(&empty_authority),
+        None
+    );
+
+    // A cannot-be-a-base URL has an opaque path rather than a list of
+    // segments, so no relative reference names one and the answer is always
+    // `None`. The round-trip driver above cannot see this on its own: it skips
+    // the pairs that return `None`, so a wrong `Some` is what it catches and
+    // the refusal itself has to be asserted directly.
+    for base in cross(&opaque_path_prefixes()) {
+        for target in cross(&opaque_path_prefixes()) {
+            if target.cannot_be_a_base() {
+                assert_eq!(
+                    base.make_relative(&target),
+                    None,
+                    "base {} target {} has an opaque path and cannot be named by a reference",
+                    base,
+                    target
+                );
+            }
+        }
+    }
+}
+
+/// Hierarchical and opaque-path URLs of the same scheme, so that every ordered
+/// pair crosses the boundary in one direction or the other. `foo:bar` carries
+/// an opaque path with no leading slash, which is the shape every path split
+/// here assumes is present.
+fn opaque_path_prefixes() -> Vec<String> {
+    [
+        "foo:/a/b", "foo:/a/", "foo:/", "foo:bar", "foo:x", "foo:a/b", "foo:",
+    ]
+    .iter()
+    .map(|s| s.to_string())
+    .collect()
+}
+
+/// The fourteen authority-shape prefixes: three families that differ only in
+/// whether the URL carries an authority and what is in it - none at all, an
+/// empty one, and a host - each at every path depth from the floor down. The
+/// first two families are indistinguishable through `host`, `port`, `username`
+/// and `password`, which is what let a reference cross between them.
+fn authority_shape_prefixes() -> Vec<String> {
+    let mut prefixes = Vec::new();
+    for authority in ["", "//", "//h"] {
+        for path in ["", "/", "/a", "/a/", "/a/b"] {
+            if authority.is_empty() && path.is_empty() {
+                // `foo:` has an opaque path, which the opaque grid covers.
+                continue;
+            }
+            prefixes.push(format!("foo:{}{}", authority, path));
+        }
+    }
+    prefixes
+}
+
+/// Every query and fragment shape each grid is crossed with: absent, empty and
+/// non-empty for both. Absent and empty are different URLs and the reference
+/// between them is not the same, so a grid that carries only one of them can
+/// miss a whole direction - which is how the authority floor stayed hidden
+/// until the empty-path dimension arrived carrying queries.
+fn cross(prefixes: &[String]) -> Vec<Url> {
+    const QUERIES: &[Option<&str>] = &[None, Some(""), Some("q"), Some("q=1&r=2")];
+    const FRAGMENTS: &[Option<&str>] = &[None, Some(""), Some("f")];
+
+    let mut urls = Vec::new();
+    for prefix in prefixes {
+        for query in QUERIES {
+            for fragment in FRAGMENTS {
+                let mut text = prefix.clone();
+                if let Some(q) = query {
+                    text.push('?');
+                    text.push_str(q);
+                }
+                if let Some(f) = fragment {
+                    text.push('#');
+                    text.push_str(f);
+                }
+                urls.push(Url::parse(&text).unwrap());
+            }
+        }
+    }
+    urls
+}
+
+/// Paths at and just above the authority floor. A URL with an authority and an
+/// empty path is the floor itself: reference resolution merges a reference onto
+/// `/`, so it can never produce an empty path from a base that has one, and the
+/// empty path has to stay distinct from `/`, which is one empty segment rather
+/// than none.
+fn empty_path_prefixes() -> Vec<String> {
+    ["", "/", "/a", "/a/", "/a/b"]
+        .iter()
+        .map(|path| format!("foo://h{}", path))
+        .collect()
+}
+
+/// The seventeen `file:` prefixes. A Windows drive letter is only `path[0]` of a
+/// `file:` URL, and `..` cannot climb past it, so the grid crosses paths with
+/// and without a leading drive letter, a drive letter appearing deeper in the
+/// path where it is an ordinary segment, and the root, file and directory
+/// shapes at each depth. The four `C|` prefixes are written the way URL-14 was
+/// filed; every one parses to its `C:` spelling, so they enter the grid as
+/// duplicates of their colon twins.
+fn file_prefixes() -> Vec<String> {
+    [
+        "file:///a/b",
+        "file:///a/",
+        "file:///a",
+        "file:///",
+        "file:///C:/a/b",
+        "file:///C:/a/",
+        "file:///C:/a",
+        "file:///C:/",
+        "file:///C:",
+        "file:///x/C:",
+        "file:///x/C:/y",
+        "file:///a/b/c",
+        "file:///C:/a/b/c",
+        "file:///C|/a/b",
+        "file:///C|/",
+        "file:///C|",
+        "file:///x/C|",
+    ]
+    .iter()
+    .map(|s| s.to_string())
+    .collect()
+}
+
+/// The six credentials prefixes: absent, username-only and username-and-password
+/// userinfo, crossed with two paths, so that every ordered pair either keeps the
+/// userinfo or changes it.
+fn credentials_prefixes() -> Vec<String> {
+    let mut prefixes = Vec::new();
+    for userinfo in ["", "u@", "u:p@"] {
+        for path in ["/a/b", "/a/c"] {
+            prefixes.push(format!("https://{}e.com{}", userinfo, path));
+        }
+    }
+    prefixes
+}
+
+/// Drives `base.join(base.make_relative(target)) == target` over every ordered
+/// pair of `urls` and reports every failing pair at once, with the count, so a
+/// grid's result reads as "n of m" rather than as its first failure.
+fn assert_rejoins_over_every_pair(grid: &str, urls: &[Url]) {
+    let mut failures = Vec::new();
+    for base in urls {
+        for target in urls {
+            let relative = match base.make_relative(target) {
+                Some(relative) => relative,
+                None => continue,
+            };
+            match base.join(&relative) {
+                Ok(rejoined) => {
+                    if rejoined != *target {
+                        failures.push(format!(
+                            "base {} target {} went through {:?} to {}",
+                            base, target, relative, rejoined
+                        ));
+                    }
+                }
+                Err(e) => failures.push(format!(
+                    "base {} target {} went through {:?}: {}",
+                    base, target, relative, e
+                )),
+            }
+        }
+    }
+    assert!(
+        failures.is_empty(),
+        "{} grid: {} of {} ordered pairs failed to rejoin:
+{}",
+        grid,
+        failures.len(),
+        urls.len() * urls.len(),
+        failures.join(
+            "
+"
+        )
+    );
+}
