+/// The evidence behind the comment in `url/src/parser.rs` that says parsing a
+/// hostless `file:` URL was the one way in that kept the `|` spelling of a
+/// Windows drive letter at `path[0]`. Twenty-three cases across every entrance
+/// that can reach `path[0]`: `Url::parse` in eight forms, `ParseOptions` in
+/// three, `join`, the four path setters, three `set_host` transitions, and the
+/// three entrances that refuse such input outright rather than normalising it.
+///
+/// A claim that generalises over a set of sites needs the set written down and
+/// driven, which is why this is a table and not a sentence.
+#[test]
+fn test_every_entrance_normalises_a_leading_pipe_drive_letter() {
+    // Url::parse, in every form that reaches a `file:` path.
+    for (input, expected) in [
+        ("file:///C|/a", "file:///C:/a"),
+        ("file:///C|", "file:///C:"),
+        ("file:///C|/", "file:///C:/"),
+        ("file://h/C|/a", "file://h/C:/a"),
+        ("file:C|/a", "file:///C:/a"),
+        ("file:/C|/a", "file:///C:/a"),
+        ("file://C|/a", "file:///C:/a"),
+        ("file:///w|/m", "file:///w:/m"),
+    ] {
+        assert_eq!(
+            Url::parse(input).unwrap().as_str(),
+            expected,
+            "parse {:?}",
+            input
+        );
+    }
+
+    // ParseOptions with a base, and join.
+    let base = Url::parse("file:///base/x").unwrap();
+    for reference in ["/C|/a", "C|/a", "file:///C|/a"] {
+        let parsed = Url::options()
+            .base_url(Some(&base))
+            .parse(reference)
+            .unwrap();
+        assert_eq!(
+            parsed.as_str(),
+            "file:///C:/a",
+            "base_url parse {:?}",
+            reference
+        );
+    }
+    assert_eq!(base.join("C|/a").unwrap().as_str(), "file:///C:/a", "join");
+
+    // The path setters.
+    let mut by_absolute_set_path = Url::parse("file:///a").unwrap();
+    by_absolute_set_path.set_path("/C|/a");
+    assert_eq!(by_absolute_set_path.as_str(), "file:///C:/a");
+
+    let mut by_relative_set_path = Url::parse("file:///a").unwrap();
+    by_relative_set_path.set_path("C|/a");
+    assert_eq!(by_relative_set_path.as_str(), "file:///C:/a");
+
+    let mut by_segments = Url::parse("file:///a").unwrap();
+    by_segments
+        .path_segments_mut()
+        .unwrap()
+        .clear()
+        .push("C|")
+        .push("a");
+    assert_eq!(by_segments.as_str(), "file:///C:/a");
+
+    let mut by_quirks_pathname = Url::parse("file:///a").unwrap();
+    url::quirks::set_pathname(&mut by_quirks_pathname, "/C|/a");
+    assert_eq!(by_quirks_pathname.as_str(), "file:///C:/a");
+
+    let mut by_quirks_href = Url::parse("file:///a").unwrap();
+    url::quirks::set_href(&mut by_quirks_href, "file:///C|/a").unwrap();
+    assert_eq!(by_quirks_href.as_str(), "file:///C:/a");
+
+    // Moving the host in or out does not reintroduce the pipe.
+    let mut host_added = Url::parse("file:///C|/a").unwrap();
+    host_added.set_host(Some("h")).unwrap();
+    assert_eq!(host_added.as_str(), "file://h/C:/a");
+
+    let mut host_removed = Url::parse("file://h/C|/a").unwrap();
+    host_removed.set_host(None).unwrap();
+    assert_eq!(host_removed.as_str(), "file:///C:/a");
+
+    let mut set_then_unhost = Url::parse("file://h/a").unwrap();
+    set_then_unhost.set_path("/C|/a");
+    set_then_unhost.set_host(None).unwrap();
+    assert_eq!(set_then_unhost.as_str(), "file:///C:/a");
+
+    // Three entrances refuse rather than normalise, which is equally a way of
+    // not producing one. `C|` is not a drive on Windows and `C|\a` is not an
+    // absolute path anywhere else, so both constructors reject it on every
+    // platform they exist for; and a non-`file:` URL carrying a pipe cannot be
+    // turned into a `file:` URL, which would otherwise smuggle one in.
+    #[cfg(any(unix, windows, target_os = "redox", target_os = "wasi"))]
+    {
+        assert!(Url::from_file_path(r"C|\a").is_err());
+        assert!(Url::from_directory_path(r"C|\a\").is_err());
+    }
+    let mut foreign = Url::parse("foo:///C|/a").unwrap();
+    assert_eq!(foreign.path(), "/C|/a");
+    assert!(url::quirks::set_protocol(&mut foreign, "file").is_err());
+    assert_eq!(foreign.path(), "/C|/a");
+
+    // And the corrected half of the claim: the rewrite is `path[0]`-only and
+    // `file:`-only, so a serialized path does carry the pipe elsewhere. The doc
+    // comment on `is_normalized_windows_drive_letter` says exactly this.
+    assert_eq!(Url::parse("file:///x/C|").unwrap().path(), "/x/C|");
+    assert_eq!(Url::parse("file:///x/C|/y").unwrap().path(), "/x/C|/y");
+    assert_eq!(Url::parse("file:///C|a").unwrap().path(), "/C|a");
+    assert_eq!(Url::parse("https://e.com/C|").unwrap().path(), "/C|");
+    assert_eq!(Url::parse("foo:///C|/a").unwrap().path(), "/C|/a");
+}
