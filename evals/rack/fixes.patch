diff --git a/test/spec_reloader.rb b/test/spec_reloader.rb
new file mode 100644
index 00000000..e533c836
--- /dev/null
+++ b/test/spec_reloader.rb
@@ -0,0 +1,52 @@
+# frozen_string_literal: true
+
+require_relative 'helper'
+
+separate_testing do
+  require_relative '../lib/rack/reloader'
+  require_relative '../lib/rack/mock_request'
+end
+
+describe Rack::Reloader do
+  # Counts rotations rather than reloading anything, so the cooldown can be
+  # observed without touching the filesystem.
+  module CountingBackend
+    def rotation
+      @rotations = rotations + 1
+    end
+
+    def rotations
+      @rotations || 0
+    end
+  end
+
+  before do
+    @app = lambda { |_env| [200, { 'content-type' => 'text/plain' }, ['ok']] }
+  end
+
+  it "reloads on every request when the cooldown has elapsed" do
+    reloader = Rack::Reloader.new(@app, 0, CountingBackend)
+    3.times { reloader.call(Rack::MockRequest.env_for("/")) }
+
+    reloader.rotations.must_equal 3
+  end
+
+  it "reloads once and then waits out the cooldown" do
+    reloader = Rack::Reloader.new(@app, 100, CountingBackend)
+    3.times { reloader.call(Rack::MockRequest.env_for("/")) }
+
+    # The constructor backdates the clock by one cooldown, so the first
+    # request always reloads and the rest fall inside the window.
+    reloader.rotations.must_equal 1
+  end
+
+  it "treats a nil cooldown as reloading disabled rather than raising" do
+    reloader = Rack::Reloader.new(@app, nil, CountingBackend)
+    status, _headers, body = reloader.call(Rack::MockRequest.env_for("/"))
+
+    status.must_equal 200
+    body.must_equal ['ok']
+    reloader.call(Rack::MockRequest.env_for("/"))
+    reloader.rotations.must_equal 0
+  end
+end
