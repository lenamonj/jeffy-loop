+func TestStructCycleTermination(t *testing.T) {
+	type cycNode struct {
+		Name string   `validate:"required"`
+		Next *cycNode `validate:"omitempty"`
+	}
+	type cycSlice struct {
+		Name string      `validate:"required"`
+		Kids []*cycSlice `validate:"omitempty,dive"`
+	}
+	type cycMap struct {
+		Name string             `validate:"required"`
+		M    map[string]*cycMap `validate:"omitempty,dive"`
+	}
+	// Not statically recursive: the cycle can only close at runtime through the
+	// interface, which is what the depth safety net covers.
+	type cycIface struct {
+		Name string      `validate:"required"`
+		Any  interface{} `validate:"omitempty"`
+	}
+
+	validate := New(WithRequiredStructEnabled())
+
+	t.Run("pointer cycle", func(t *testing.T) {
+		a := &cycNode{Name: "a"}
+		b := &cycNode{Name: "b"}
+		a.Next, b.Next = b, a
+
+		Equal(t, validate.Struct(a), nil)
+	})
+
+	t.Run("self pointer", func(t *testing.T) {
+		a := &cycNode{Name: "a"}
+		a.Next = a
+
+		Equal(t, validate.Struct(a), nil)
+	})
+
+	t.Run("cycle still reports the failing field exactly once", func(t *testing.T) {
+		a := &cycNode{Name: "a"}
+		b := &cycNode{Name: ""}
+		a.Next, b.Next = b, a
+
+		errs := validate.Struct(a)
+		NotEqual(t, errs, nil)
+		Equal(t, len(errs.(ValidationErrors)), 1)
+		AssertError(t, errs, "cycNode.Next.Name", "cycNode.Next.Name", "Name", "Name", "required")
+	})
+
+	t.Run("slice cycle through dive", func(t *testing.T) {
+		a := &cycSlice{Name: "a"}
+		b := &cycSlice{Name: "b"}
+		a.Kids = []*cycSlice{b}
+		b.Kids = []*cycSlice{a}
+
+		Equal(t, validate.Struct(a), nil)
+	})
+
+	t.Run("map cycle through dive", func(t *testing.T) {
+		a := &cycMap{Name: "a"}
+		b := &cycMap{Name: "b"}
+		a.M = map[string]*cycMap{"b": b}
+		b.M = map[string]*cycMap{"a": a}
+
+		Equal(t, validate.Struct(a), nil)
+	})
+
+	t.Run("cycle closed through an interface field", func(t *testing.T) {
+		a := &cycIface{Name: "a"}
+		b := &cycIface{Name: "b"}
+		a.Any, b.Any = b, a
+
+		Equal(t, validate.Struct(a), nil)
+	})
+
+	t.Run("repeated non-cyclic references are not pruned", func(t *testing.T) {
+		// The same node reached twice is not a cycle; both visits must be reported.
+		shared := &cycSlice{Name: ""}
+		root := &cycSlice{Name: "", Kids: []*cycSlice{shared, shared}}
+
+		errs := validate.Struct(root)
+		NotEqual(t, errs, nil)
+		Equal(t, len(errs.(ValidationErrors)), 3)
+	})
+
+	t.Run("deep acyclic graph is validated in full", func(t *testing.T) {
+		// Recursive type, far past cycleGuardDepth, no cycle: every node must still
+		// be validated, so the guard cannot be short-circuiting legitimate work.
+		const n = 2000
+
+		head := &cycNode{Name: ""}
+		cur := head
+		for i := 0; i < n-1; i++ {
+			cur.Next = &cycNode{Name: ""}
+			cur = cur.Next
+		}
+
+		errs := validate.Struct(head)
+		NotEqual(t, errs, nil)
+		Equal(t, len(errs.(ValidationErrors)), n)
+	})
+
+	t.Run("guard state does not leak between validations", func(t *testing.T) {
+		// The validate struct is pooled, so a cycle in one call must not suppress
+		// nodes in the next.
+		a := &cycNode{Name: ""}
+		a.Next = a
+
+		for i := 0; i < 3; i++ {
+			errs := validate.Struct(a)
+			NotEqual(t, errs, nil)
+			Equal(t, len(errs.(ValidationErrors)), 1)
+		}
+	})
+}
