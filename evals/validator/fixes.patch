+		{"ssn", 12345678901, false},
+		{"ssn", true, false},
+		{"ssn", 1.5, false},
+		{"ein", "12-3456789", true},
+		{"ein", "123456789", false},
+		{"ein", 1234567890, false},
+		{"ein", false, false},
+		{"multibyte", "日本語", true},
+		{"multibyte", "abc", false},
+		{"multibyte", "", true},
+		{"multibyte", 123, false},
+		{"multibyte", true, false},
+	}
+
+	for _, tc := range tests {
+		// A panic here is the regression this test exists to catch, so name it.
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("%s on %T panicked: %v", tc.tag, tc.value, r)
+				}
+			}()
+
+			Equal(t, validate.Var(tc.value, tc.tag) == nil, tc.expected)
+		}()
+	}
+}
