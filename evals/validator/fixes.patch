+// The html pattern is unanchored, so it matches the "<int Value>" that
+// reflect.Value.String() renders for a non-string kind: an int field was accepted
+// while the ordinary string "abc" is rejected. The tag checks the kind now.
+func TestHTMLRejectsNonStringKinds(t *testing.T) {
+	validate := New()
+
+	type nonStrings struct {
+		Int    int               `validate:"html"`
+		Uint   uint              `validate:"html"`
+		Bool   bool              `validate:"html"`
+		Float  float64           `validate:"html"`
+		Map    map[string]string `validate:"html"`
+		Struct struct{ A int }   `validate:"html"`
+	}
+
+	errs := validate.Struct(nonStrings{
+		Int: 1, Uint: 1, Bool: true, Float: 1.5,
+		Map:    map[string]string{"a": "b"},
+		Struct: struct{ A int }{1},
+	})
+	NotEqual(t, errs, nil)
+	Equal(t, len(errs.(ValidationErrors)), 6)
+
+	// String verdicts are untouched, including the placeholder-shaped string,
+	// which is ordinary HTML as far as this tag is concerned.
+	type markup struct {
+		S string `validate:"html"`
+	}
+	for _, s := range []string{"<p>", "</p>", "<br/>", "<a href='x'>", "<int Value>"} {
+		Equal(t, validate.Struct(markup{S: s}) == nil, true)
+	}
+	for _, s := range []string{"abc", "", "a < b", "<1>"} {
+		NotEqual(t, validate.Struct(markup{S: s}), nil)
+	}
+}
+
+// Every sibling in the address family rejects a non-string field kind, but each
+// does it by accident: reflect.Value.String() renders "<int Value>" and their
+// parsers reject that. unix_addr asks only for a non-empty string with no NUL,
+// which the rendering satisfies, so it checks the kind itself.
+func TestUnixAddrRejectsNonStringKinds(t *testing.T) {
+	validate := New()
+
+	type nonStrings struct {
+		Int   int               `validate:"unix_addr"`
+		Bool  bool              `validate:"unix_addr"`
+		Float float64           `validate:"unix_addr"`
+		Slice []string          `validate:"unix_addr"`
+		Map   map[string]string `validate:"unix_addr"`
+	}
+
+	errs := validate.Struct(nonStrings{
+		Int:   1,
+		Bool:  true,
+		Float: 1.5,
+		Slice: []string{"a"},
+		Map:   map[string]string{"a": "b"},
+	})
+	NotEqual(t, errs, nil)
+	Equal(t, len(errs.(ValidationErrors)), 5)
+
+	// A string field carrying the same tag keeps the verdicts it had.
+	type path struct {
+		Path string `validate:"unix_addr"`
+	}
+	Equal(t, validate.Struct(path{Path: "/tmp/v.sock"}) == nil, true)
+	Equal(t, validate.Struct(path{Path: "@abstract"}) == nil, true)
+	NotEqual(t, validate.Struct(path{Path: ""}), nil)
+	NotEqual(t, validate.Struct(path{Path: "/tmp/has\x00nul.sock"}), nil)
+}
+
+// isIP4Addr and isIP6Addr parse only the host part - both strip everything after
+// the last colon - so the port used to reach net's resolver unexamined, and net's
+// Windows path panics on a NUL byte there. No network address contains a NUL, so
+// the shape gate rejects it.
+//
+// This pins the verdict, not the mechanism. On a platform whose resolver merely
+// errors on a NUL these tags rejected these values before the gate existed, so
+// the test passes with or without it there; what the gate changed is that the
+// value no longer reaches the resolver, which is only observable by instrumenting
+// that call.
+func TestAddressTagsRejectNulBytes(t *testing.T) {
+	validate := New()
+
+	tags := []string{
+		"tcp4_addr", "tcp6_addr", "tcp_addr",
+		"udp4_addr", "udp6_addr", "udp_addr",
+		"ip4_addr", "ip6_addr", "ip_addr",
+	}
+	hostile := []string{
+		"127.0.0.1:80\x00",
+		"127.0.0.1:\x00",
+		"127.0.0.1:8\x000",
+		"127.0.0.1:\x0080",
+		"[::1]:80\x00",
+		"[::1]:\x00",
+		"127.0.0.1\x00",
+		"::1\x00",
+		"\x00",
+	}
+
+	for _, tag := range tags {
+		for _, val := range hostile {
+			if errs := validate.Var(val, tag); errs == nil {
+				t.Fatalf("%s accepted %q, which carries a NUL byte", tag, val)
+			}
+		}
+	}
+
+	// The gate must reject no more than that: the same addresses without the NUL
+	// keep the verdicts they had.
+	Equal(t, validate.Var("127.0.0.1:80", "tcp4_addr") == nil, true)
+	Equal(t, validate.Var("127.0.0.1:80", "udp4_addr") == nil, true)
+	Equal(t, validate.Var("[::1]:80", "tcp6_addr") == nil, true)
+	Equal(t, validate.Var("[::1]:80", "udp6_addr") == nil, true)
+	Equal(t, validate.Var("127.0.0.1", "ip4_addr") == nil, true)
+	Equal(t, validate.Var("::1", "ip6_addr") == nil, true)
+}
