+func TestRGBAAndHSLAAlphaChannel(t *testing.T) {
+	// The alpha group used to be `(?:0.[1-9]*)|[01]`, whose dot was an unescaped
+	// any-character. That accepted junk in the alpha position and rejected ordinary
+	// CSS alpha values, so the verdict was wrong in both directions.
+	validate := New()
+
+	valid := []string{"0", "1", "0.5", "0.12", "0.05", "0.999", "1.0", "1.00"}
+	invalid := []string{"0X", "0x", "09", "00", "01", "0.", ".5", "1.5", "2", "-0.5", "0.5x", ""}
+
+	for _, a := range valid {
+		Equal(t, validate.Var("rgba(0,31,255,"+a+")", "rgba") == nil, true)
+		Equal(t, validate.Var("hsla(360,100%,100%,"+a+")", "hsla") == nil, true)
+	}
+
+	for _, a := range invalid {
+		Equal(t, validate.Var("rgba(0,31,255,"+a+")", "rgba") == nil, false)
+		Equal(t, validate.Var("hsla(360,100%,100%,"+a+")", "hsla") == nil, false)
+	}
+
+	// Whitespace around the channels stays tolerated; that is not the defect.
+	Equal(t, validate.Var("rgba( 0,  31, 255, 0.5 )", "rgba") == nil, true)
+	Equal(t, validate.Var("hsla( 0, 0%, 0%, 0 )", "hsla") == nil, true)
+}
+
+// The email tag is the conjunction of emailRegex and mail.ParseAddress, both
+// pure, so evaluating either first gives the same answer. isEmail evaluates the
+// regex first because mail.ParseAddress consumes comments and phrases
+// quadratically; this test fails if a change makes the two checks disagree
+// rather than merely reorder them, and it is what makes that reordering safe.
+func TestEmailChecksAgreeInEitherOrder(t *testing.T) {
+	validate := New()
+
+	locals := []string{"a", "test.name", "a+tag", "a_b-c", `"quoted"`, "a..b", "", strings.Repeat("a", 300), "a b"}
+	domains := []string{"b.co", "example.com", "example.co.uk", "b", "", "b .co", "b-c.io"}
+	suffixes := []string{"", " (x)", " (" + strings.Repeat("a", 64) + ")", "\n", "\x00", " <a@b.co>", "."}
+
+	checked := 0
+	for _, local := range locals {
+		for _, domain := range domains {
+			for _, suffix := range suffixes {
+				addr := local + "@" + domain + suffix
+
+				parserFirst := false
+				if _, err := mail.ParseAddress(addr); err == nil {
+					parserFirst = emailRegex().MatchString(addr)
+				}
+				regexFirst := false
+				if emailRegex().MatchString(addr) {
+					_, err := mail.ParseAddress(addr)
+					regexFirst = err == nil
+				}
+				if parserFirst != regexFirst {
+					t.Fatalf("evaluation order changes the verdict for %q: parser-first=%v regex-first=%v", addr, parserFirst, regexFirst)
+				}
+				if tag := validate.Var(addr, "email") == nil; tag != regexFirst {
+					t.Fatalf("the email tag disagrees with its own two checks for %q: tag=%v checks=%v", addr, tag, regexFirst)
+				}
+				checked++
+			}
+		}
+	}
+	Equal(t, checked, len(locals)*len(domains)*len(suffixes))
+}
+
+// The reason for that ordering: mail.ParseAddress accepts a trailing comment and
+// consumes it quadratically, while emailRegex rejects the same value outright, so
+// a value the regex rejects must not reach the parser. The bound is loose by
+// orders of magnitude - this rejection took seconds with the checks in the other
+// order and takes microseconds in this one.
+func TestEmailDoesNotParseWhatTheRegexRejects(t *testing.T) {
+	validate := New()
+	hostile := "a@b.co (" + strings.Repeat("a", 200000) + ")"
+
+	if emailRegex().MatchString(hostile) {
+		t.Fatal("fixture no longer separates the two checks: the regex now accepts the comment-shaped value")
+	}
+
+	start := time.Now()
+	errs := validate.Var(hostile, "email")
+	elapsed := time.Since(start)
+
+	NotEqual(t, errs, nil)
+	AssertError(t, errs, "", "", "", "", "email")
+	if elapsed > time.Second {
+		t.Fatalf("rejecting a %d-byte value took %s, so the parser ran before the regex", len(hostile), elapsed)
+	}
+}
