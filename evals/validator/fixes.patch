+func TestTypeReaches(t *testing.T) {
+	type plain struct {
+		A string
+	}
+	type selfPtr struct {
+		Next *selfPtr
+	}
+	type selfSlice struct {
+		Kids []selfSlice
+	}
+	type selfMapVal struct {
+		M map[string]*selfMapVal
+	}
+	type withIface struct {
+		Any interface{}
+	}
+	type mutualB struct {
+		Back interface{}
+	}
+	type mutualA struct {
+		B *mutualB
+	}
+
+	tests := []struct {
+		name     string
+		typ      reflect.Type
+		expected bool
+	}{
+		{"plain struct", reflect.TypeOf(plain{}), false},
+		{"self pointer", reflect.TypeOf(selfPtr{}), true},
+		{"self slice", reflect.TypeOf(selfSlice{}), true},
+		{"self map value", reflect.TypeOf(selfMapVal{}), true},
+		// An interface is not treated as reaching everything; that case is covered
+		// by the depth safety net instead, so ordinary structs stay off the guard.
+		{"interface field", reflect.TypeOf(withIface{}), false},
+		{"no cycle back to root", reflect.TypeOf(mutualA{}), false},
+		{"time.Time", reflect.TypeOf(time.Time{}), false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := typeReaches(tc.typ, tc.typ, make(map[reflect.Type]struct{}), true)
+			Equal(t, got, tc.expected)
+		})
+	}
+}
