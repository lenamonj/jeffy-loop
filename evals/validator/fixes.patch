+
+// typeReaches reports whether a value of from can hold a value of target. root is true
+// only for the initial call, so a type is not trivially considered to reach itself.
+//
+// Interface fields are deliberately not treated as reaching everything. Doing so marks
+// any struct holding an interface as recursive, which costs those structs the guard on
+// every validation for a cycle they almost never have. A cycle closed through an
+// interface is caught instead by the interface-hop counter in traverseField, which no
+// unbounded interface-mediated cycle can avoid incrementing.
+func typeReaches(from, target reflect.Type, seen map[reflect.Type]struct{}, root bool) bool {
+	if !root && from == target {
+		return true
+	}
+
+	if _, ok := seen[from]; ok {
+		return false
+	}
+	seen[from] = struct{}{}
+
+	switch from.Kind() {
+	case reflect.Ptr, reflect.Slice, reflect.Array:
+		return typeReaches(from.Elem(), target, seen, false)
+
+	case reflect.Map:
+		return typeReaches(from.Key(), target, seen, false) ||
+			typeReaches(from.Elem(), target, seen, false)
+
+	case reflect.Struct:
+		for i := 0; i < from.NumField(); i++ {
+			if typeReaches(from.Field(i).Type, target, seen, false) {
+				return true
+			}
+		}
+	}
+
+	return false
 }
 
