diff --git a/.github/workflows/workflow.yml b/.github/workflows/workflow.yml
index f0c6566..ef34472 100644
--- a/.github/workflows/workflow.yml
+++ b/.github/workflows/workflow.yml
@@ -21,14 +21,54 @@ jobs:
           go-version: ${{ matrix.go-version }}
 
       - name: Test
+        run: go test -race ./...
+
+  # Coverage runs as its own job rather than as a step of one matrix combination.
+  # The step it replaces was gated on a go-version that had to be kept in step with
+  # the matrix by hand, and when the matrix moved to 1.25/1.26 the gate was left on
+  # 1.24 and stopped matching anything, so nothing was uploaded and nothing failed.
+  coverage:
+    name: coverage
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v6
+
+      - name: Install Go
+        uses: actions/setup-go@v6
+        with:
+          go-version: 1.25.x
+
+      - name: Test with coverage
         run: go test -race -covermode=atomic -coverprofile="profile.cov" ./...
 
       - name: Send Coverage
-        if: matrix.os == 'ubuntu-latest' && matrix.go-version == '1.24.x'
         uses: shogo82148/actions-goveralls@v1
         with:
           path-to-profile: profile.cov
 
+  # A reachable advisory is invisible to the test suite: three standard-library
+  # advisories were reachable from this code and no job here would have said so.
+  # go-version is stable rather than a pinned release, because govulncheck's
+  # standard-library findings track the toolchain the runner installs, so pinning
+  # an affected patch release would keep this job red after upstream had fixed it.
+  govulncheck:
+    name: vulncheck
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v6
+
+      - name: Install Go
+        uses: actions/setup-go@v6
+        with:
+          go-version: stable
+
+      - name: govulncheck
+        run: |
+          go install golang.org/x/vuln/cmd/govulncheck@latest
+          govulncheck ./...
+
   golangci:
     name: lint
     runs-on: ubuntu-latest
