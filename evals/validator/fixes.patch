 type cStruct struct {
-	name   string
-	fields []*cField
-	fn     StructLevelFuncCtx
+	name string
+	// recursive reports whether a value of this struct type can reach another value of
+	// the same type, which is the precondition for a cyclic object graph. It is computed
+	// once per type here so the executor pays nothing for the types that cannot cycle.
+	recursive bool
+	fields    []*cField
+	fn        StructLevelFuncCtx
