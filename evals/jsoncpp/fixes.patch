diff --git a/.github/workflows/cmake.yml b/.github/workflows/cmake.yml
index cccf8ed..31f0e6d 100644
--- a/.github/workflows/cmake.yml
+++ b/.github/workflows/cmake.yml
@@ -22,4 +22,25 @@ jobs:
         uses: threeal/cmake-action@v2.0.0
         with:
           options: CMAKE_CXX_STANDARD=${{ matrix.cxx_standard }}
+
+  cmake-secure-memory:
+    # Builds and runs the unit suite with the opt-in secure allocator enabled,
+    # so the JSONCPP_USE_SECURE_MEMORY configuration cannot silently rot.
+    runs-on: ${{ matrix.os }}
+
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+
+    steps:
+      - name: checkout project
+        uses: actions/checkout@v5
+
+      - name: build project with secure memory
+        uses: threeal/cmake-action@v2.0.0
+        with:
+          options: |
+            CMAKE_CXX_STANDARD=17
+            CMAKE_CXX_FLAGS=-DJSONCPP_USE_SECURE_MEMORY=1
         
