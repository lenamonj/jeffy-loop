+require 'test_helper'
+require 'i18n/gettext/po_parser'
+
+class I18nGettextPoParserTest < I18n::TestCase
+  SOURCE = %(  msgid "car"\nmsgstr "Auto"\n  ).freeze
+
+  def test_parse_does_not_mutate_the_source_string
+    source = SOURCE.dup
+    GetText::PoParser.new.parse(source, I18n::Backend::Gettext::PoData.new)
+    assert_equal SOURCE, source
+  end
+
+  def test_parse_accepts_a_frozen_source_string
+    data = GetText::PoParser.new.parse(SOURCE, I18n::Backend::Gettext::PoData.new)
+    assert_equal({ 'car' => 'Auto' }, data)
+  end
+end
