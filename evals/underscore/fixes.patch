+
+// ES3 engines have no `__proto__` accessor at all, so plain assignment already
+// creates an own property there and no guard is needed.
+var needsGuard = (function() {
+  var probe = {};
+  probe[protoKey] = 1;
+  return probe[protoKey] !== 1;
+}());
+
