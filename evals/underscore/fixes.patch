@@ -0,0 +1,15 @@
+import { toString } from './_setup.js';
+
+// Internal helper to convert a value to a string without ever throwing.
+// `'' + value` runs ToPrimitive, which has no result for an object that
+// inherits neither `valueOf` nor `toString` - a prototype-less dictionary, the
+// shape `querystring.parse` hands back and the idiomatic way to build a map
+// that no `__proto__` key can disturb. Such a value still has a meaningful
+// string form, and it is the same one a plain object of that shape produces.
+export default function safeToString(value) {
+  try {
+    return '' + value;
+  } catch (e) {
+    return toString.call(value);
+  }
+}
