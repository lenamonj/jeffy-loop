+    var r = probe('dataview-bug');
+    assert.strictEqual(r.isEqual_equalDataViews, true, 'equal bytes compare equal');
+    assert.strictEqual(r.isEqual_differingDataViews, false, 'differing bytes compare unequal');
+  });
+
+  QUnit.test('IE 11 method fingerprint is exercised when the collection tags lie', function(assert) {
+    var r = probe('ie11');
