+    assert.strictEqual(r.isMap_weakMap, false, 'a WeakMap is not a Map');
+    assert.strictEqual(r.isMap_plainObject, false, 'a plain object is not a Map');
+    assert.strictEqual(r.isSet_set, true, 'a Set is recognised by fingerprint');
+    assert.strictEqual(r.isSet_map, false, 'a Map is not a Set');
+    assert.strictEqual(r.isWeakMap_weakMap, true, 'a WeakMap is recognised by fingerprint');
+    assert.strictEqual(r.isWeakMap_map, false, 'a Map is not a WeakMap');
+  });
+}());
