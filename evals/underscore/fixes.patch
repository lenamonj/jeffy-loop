+  if (typeof Object.defineProperty != 'function') return false;
+  try {
+    var probe = {};
+    Object.defineProperty(probe, protoKey, {
+      value: 1, enumerable: true, writable: true, configurable: true
+    });
+    return probe[protoKey] === 1;
+  } catch (e) {
+    return false;
+  }
+}());
