+    var r = probe('dataview-bug');
+    assert.strictEqual(r.tagOfDataView, '[object Object]', 'the simulated environment really does mistag DataView');
+    assert.strictEqual(r.isDataView_dataView, true, 'a DataView is still recognised through the alternate check');
+    assert.strictEqual(r.isDataView_typedArray, false, 'a typed array is not a DataView');
+    assert.strictEqual(r.isDataView_arrayBuffer, false, 'an ArrayBuffer is not a DataView');
+    assert.strictEqual(r.isDataView_plainObject, false, 'a plain object is not a DataView');
+    assert.strictEqual(r.isDataView_null, false, 'null is not a DataView');
+  });
+
