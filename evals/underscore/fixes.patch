diff --git a/eslint.config.js b/eslint.config.js
new file mode 100644
index 0000000..8d93f18
--- /dev/null
+++ b/eslint.config.js
@@ -0,0 +1,51 @@
+// Flat config, replacing the .eslintrc cascade that ESLint 9 no longer reads.
+// The three groups below are the exact resolved configurations that cascade
+// produced, checked with `eslint --print-config` before the migration.
+
+var globals = require('globals');
+var importPlugin = require('eslint-plugin-import');
+
+// The old cascade set `env: {browser, node, amd}` at the root, so every group
+// inherited those globals.
+var sharedGlobals = Object.assign({}, globals.browser, globals.node, globals.amd);
+
+// Dead imports, variables and trailing parameters are errors. Caught errors are
+// exempt because ES3, the level the bundle and the tests are parsed at, has no
+// optional catch binding: `catch (e)` has to name a variable it never reads.
+var unusedVars = ['error', {caughtErrors: 'none'}];
+
+module.exports = [
+  // Everything the lint scripts reach, including the built UMD bundle. Parsing
+  // at ES3 is the gate that keeps ES5-only syntax out of what we ship: engines
+  // such as ExtendScript reject a file with a trailing comma or an object
+  // getter outright.
+  {
+    languageOptions: {
+      ecmaVersion: 3,
+      sourceType: 'script',
+      globals: sharedGlobals,
+    },
+  },
+  // The sources are ES modules and are checked for broken imports.
+  {
+    files: ['modules/*.js'],
+    plugins: {import: importPlugin},
+    languageOptions: {
+      ecmaVersion: 6,
+      sourceType: 'module',
+    },
+    rules: Object.assign({}, importPlugin.flatConfigs.errors.rules, {
+      // ExtendScript wrongly gives equal precedence to && and ||. #2949
+      'no-mixed-operators': ['error', {groups: [['&&', '||']]}],
+      'no-unused-vars': unusedVars,
+    }),
+  },
+  // The test files run under QUnit and are parsed at ES3 like the bundle.
+  {
+    files: ['test/*.js'],
+    languageOptions: {
+      globals: Object.assign({}, sharedGlobals, {QUnit: 'readonly'}),
+    },
+    rules: {'no-unused-vars': unusedVars},
+  },
+];
