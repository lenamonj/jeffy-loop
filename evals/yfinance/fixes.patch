 import json
 
 
+# The full set of supported options. Reading or writing anything else raises
+# AttributeError, so a typo'd option name fails loudly instead of no-oping.
+_VALID_OPTIONS = {
+    "network": {"proxy", "retries"},
+    "debug": {"hide_exceptions", "logging"},
+    "locale": {"lang", "region"},
+}
+
+
 class NestedConfig:
     def __init__(self, name, data):
         self.__dict__['name'] = name
         self.__dict__['data'] = data
 
+    def _validate(self, key):
+        section = self.__dict__['name']
+        valid = _VALID_OPTIONS[section]
+        if key not in valid:
+            raise AttributeError(
+                f"yfinance config section '{section}' has no option '{key}'. "
+                f"Valid options: {sorted(valid)}")
+
     def __getattr__(self, key):
+        self._validate(key)
         return self.data.get(key)
 
     def __setattr__(self, key, value):
+        self._validate(key)
         self.data[key] = value
 
     def __len__(self):
@@ -41,6 +60,10 @@ class ConfigMgr:
         if not self._initialised:
             self._load_option()
 
+        if key not in _VALID_OPTIONS:
+            raise AttributeError(
+                f"yfinance config has no section '{key}'. "
+                f"Valid sections: {sorted(_VALID_OPTIONS)}")
         if key not in self.options:
             self.options[key] = {}
         return NestedConfig(key, self.options[key])
