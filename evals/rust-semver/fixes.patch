+fn op_str(op: Op) -> &'static str {
+    match op {
+        Op::Exact => "=",
+        Op::Greater => ">",
+        Op::GreaterEq => ">=",
+        Op::Less => "<",
+        Op::LessEq => "<=",
+        Op::Tilde => "~",
+        Op::Caret => "^",
+        Op::Wildcard => "",
+    }
+}
+
+// The printed length of a Comparator, following the same branches as its
+// Display impl above. The two must agree exactly or padding is off by their
+// difference, which is what test_align_comparator pins.
+fn comparator_len(comparator: &Comparator) -> usize {
+    let mut len = op_str(comparator.op).len() + digits(comparator.major);
+    if let Some(minor) = comparator.minor {
+        len += 1 + digits(minor);
+        if let Some(patch) = comparator.patch {
+            len += 1 + digits(patch);
+            if !comparator.pre.is_empty() {
+                len += 1 + comparator.pre.len();
+            }
+        } else if comparator.op == Op::Wildcard {
+            len += 2;
+        }
+    } else if comparator.op == Op::Wildcard {
+        len += 2;
     }
+    len
 }
 
