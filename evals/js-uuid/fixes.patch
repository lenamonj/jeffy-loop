     assert.throws(() => v1({}, buf30, -1), RangeError);
     assert.throws(() => v1({}, buf30, 15), RangeError);
   });
+
+  // Each of these fields is written into a fixed-width slot, so an unchecked
+  // value is silently truncated: `clockseq: 0x4000` used to produce a string
+  // that validate() rejects, and an out-of-range `msecs` a timestamp that
+  // never existed.
+  test('throws RangeError for out-of-range option values', () => {
+    const MSECS_MIN = -12219292800000;
+    const MSECS_MAX = 103072857660683;
+    for (const options of [
+      { msecs: MSECS_MAX + 1 },
+      { msecs: MSECS_MIN - 1 },
+      { msecs: 1.5 },
+      { msecs: Number.NaN },
+      { nsecs: 10000 },
+      { nsecs: -1 },
+      { clockseq: 0x4000 },
+      { clockseq: -1 },
+    ]) {
+      assert.throws(
+        () => v1(options),
+        RangeError,
+        `v1(${JSON.stringify(options)})`,
+      );
+    }
+    assert.throws(() => v1({ node: new Uint8Array(5) }), Error);
+  });
+
+  test('accepts the boundaries of every documented option range', () => {
+    for (const options of [
+      { msecs: -12219292800000 },
+      { msecs: 103072857660683 },
+      { msecs: 0, nsecs: 0 },
+      { msecs: 0, nsecs: 9999 },
+      { msecs: 0, clockseq: 0 },
+      { msecs: 0, clockseq: 0x3fff },
+      { msecs: 0, node: Uint8Array.of(1, 2, 3, 4, 5, 6) },
+    ]) {
+      assert.equal(
+        parse(v1(options) as string).length,
+        16,
+        `v1(${JSON.stringify(options)})`,
+      );
+    }
+  });
 });
