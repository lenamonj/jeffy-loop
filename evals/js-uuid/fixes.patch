diff --git a/src/checkOption.ts b/src/checkOption.ts
new file mode 100644
index 0000000..a18fcb3
--- /dev/null
+++ b/src/checkOption.ts
@@ -0,0 +1,22 @@
+/**
+ * Reject an out-of-domain option value.
+ *
+ * The generators write these numbers into fixed-width fields, so a value
+ * outside the documented domain is silently truncated or wrapped rather than
+ * refused: `v1({ clockseq: 0x4000 })` used to return a string this package's
+ * own `validate()` rejects, and `v7({ msecs: 2 ** 48 })` returned the same
+ * UUID as `msecs: 0`.  Options are hand-authored by the application author, so
+ * a wrong value is worth a message that names it.
+ */
+export default function checkIntegerOption(
+  name: string,
+  value: number,
+  min: number,
+  max: number,
+) {
+  if (!Number.isInteger(value) || value < min || value > max) {
+    throw new RangeError(
+      `options.${name} must be an integer between ${min} and ${max}, but got ${value}`,
+    );
+  }
+}
diff --git a/src/test/uuid-bin.test.ts b/src/test/uuid-bin.test.ts
new file mode 100644
index 0000000..6f8b5a5
--- /dev/null
+++ b/src/test/uuid-bin.test.ts
@@ -0,0 +1,99 @@
+import * as assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { describe, test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/uuid', import.meta.url));
+
+function run(args: string[]) {
+  try {
+    const stdout = execFileSync(process.execPath, [BIN, ...args], {
+      encoding: 'utf8',
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    return { code: 0, stdout, stderr: '' };
+  } catch (err) {
+    const e = err as { status?: number; stdout?: string; stderr?: string };
+    return {
+      code: e.status ?? -1,
+      stdout: e.stdout ?? '',
+      stderr: e.stderr ?? '',
+    };
+  }
+}
+
+describe('uuid-bin', () => {
+  test('--help lists every implemented subcommand on stdout', () => {
+    const { code, stdout } = run(['--help']);
+    assert.equal(code, 0);
+    const commands = stdout
+      .split('\n')
+      .map((l) => l.trim())
+      .filter((l) => l.startsWith('uuid'));
+    assert.deepEqual(commands, [
+      'uuid',
+      'uuid v1',
+      'uuid v3 <name> <namespace uuid>',
+      'uuid v4',
+      'uuid v5 <name> <namespace uuid>',
+      'uuid v6',
+      'uuid v7',
+      'uuid --help',
+    ]);
+  });
+
+  test('deterministic subcommands match the published vectors', () => {
+    assert.equal(
+      run(['v3', 'hello.example.com', 'DNS']).stdout.trim(),
+      '9125a8dc-52ee-365b-a5aa-81b0b3681cf6',
+    );
+    assert.equal(
+      run(['v5', 'hello.example.com', 'DNS']).stdout.trim(),
+      'fdda765f-fc57-5604-a269-52a7df8164ec',
+    );
+    // A literal namespace UUID resolves to the same thing as the DNS alias.
+    assert.equal(
+      run([
+        'v5',
+        'hello.example.com',
+        '6ba7b810-9dad-11d1-80b4-00c04fd430c8',
+      ]).stdout.trim(),
+      run(['v5', 'hello.example.com', 'DNS']).stdout.trim(),
+    );
+  });
+
+  // Every argument error the CLI can produce, enumerated by provoking one at
+  // each step rather than by reading the source.  All of these used to abort
+  // with a Node stack trace.
+  const ARG_ERRORS: [string[], string][] = [
+    [['v3'], 'v3 requires a <name> argument'],
+    [['v3', 'name'], 'v3 requires a <namespace uuid> argument'],
+    [['v5'], 'v5 requires a <name> argument'],
+    [['v5', 'name'], 'v5 requires a <namespace uuid> argument'],
+    [['v3', 'name', 'nope'], 'v3 namespace must be a UUID, "DNS", or "URL"'],
+    [['v5', 'name', 'nope'], 'v5 namespace must be a UUID, "DNS", or "URL"'],
+  ];
+
+  ARG_ERRORS.forEach(([args, message]) => {
+    test(`uuid ${args.join(' ')} explains itself`, () => {
+      const { code, stdout, stderr } = run(args);
+      assert.equal(code, 1);
+      assert.ok(
+        stderr.includes(message),
+        `stderr should name the problem: ${stderr}`,
+      );
+      assert.ok(
+        stderr.includes('Usage:'),
+        'stderr should carry the usage block',
+      );
+      assert.doesNotMatch(stderr, /node:internal|at ModuleJob|ERR_ASSERTION/);
+      assert.equal(stdout, '', 'nothing is written to stdout on failure');
+    });
+  });
+
+  test('an unknown version prints usage and exits 1', () => {
+    const { code, stdout } = run(['v9']);
+    assert.equal(code, 1);
+    assert.ok(stdout.includes('Usage:'));
+  });
+});
