@@ -43,3 +43,14 @@ internal class DateTimeFormatException: IllegalArgumentException {
         private const val serialVersionUID: Long = 4231196759387994100L
     }
 }
+
+/**
+ * A [DateTimeFormatException] that says what [context] failed *and* why, by appending the diagnostic [cause]
+ * carries. Callers commonly log only `message`, so a wrapper that leaves the diagnostic on the cause alone
+ * tells them nothing about where the input was rejected.
+ */
+internal fun parseFailure(context: String, cause: Throwable): DateTimeFormatException =
+    when (val diagnostic = cause.message) {
+        null -> DateTimeFormatException(context, cause)
+        else -> DateTimeFormatException("$context: $diagnostic", cause)
+    }
