diff --git a/spec/formatters/html_table_spec.rb b/spec/formatters/html_table_spec.rb
new file mode 100644
index 00000000..cc639200
--- /dev/null
+++ b/spec/formatters/html_table_spec.rb
@@ -0,0 +1,42 @@
+# -*- coding: utf-8 -*- #
+# frozen_string_literal: true
+
+describe Rouge::Formatters::HTMLTable do
+  let(:subject) { Rouge::Formatters::HTMLTable.new(Rouge::Formatters::HTML.new) }
+
+  def format(source)
+    subject.format(Rouge::Lexers::Ruby.new.lex(source).to_a)
+  end
+
+  def code_cell(output)
+    output[%r{<td class="rouge-code"><pre>(.*?)</pre>}m, 1]
+  end
+
+  def gutter(output)
+    output[%r{<pre class="lineno">(.*?)</pre>}m, 1]
+  end
+
+  it 'starts with the table for newline-terminated input' do
+    assert format("a = 1\n").start_with?('<table')
+  end
+
+  it 'starts with the table when the input has no trailing newline' do
+    assert format('a = 1').start_with?('<table')
+  end
+
+  it 'starts with the table for empty input' do
+    assert subject.format([]).start_with?('<table')
+  end
+
+  it 'puts the made-up last line inside the code cell' do
+    assert code_cell(format('a = 1')).end_with?(%(<span class="w">\n</span>))
+  end
+
+  it 'numbers one line for a single line with no trailing newline' do
+    assert_equal "1\n", gutter(format('a = 1'))
+  end
+
+  it 'numbers every line of newline-terminated input' do
+    assert_equal "1\n2\n3\n", gutter(format("a\nb\nc\n"))
+  end
+end
