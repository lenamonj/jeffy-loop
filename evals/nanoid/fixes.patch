diff --git a/test/alphabet.test.js b/test/alphabet.test.js
new file mode 100644
index 0000000..1c92c6c
--- /dev/null
+++ b/test/alphabet.test.js
@@ -0,0 +1,31 @@
+import { equal, ok } from 'node:assert'
+import { test } from 'node:test'
+
+import * as browser from '../index.browser.js'
+import * as node from '../index.js'
+import * as nonSecure from '../non-secure/index.js'
+
+// An alphabet outside the range an entry point supports used to hang index.js
+// and index.browser.js forever, and made non-secure build IDs out of the
+// string `undefined`. Every entry point must now terminate: either it throws
+// a RangeError, or it returns a real ID of the requested size.
+let entries = Object.entries({ browser, node, 'non-secure': nonSecure })
+
+for (let [name, entry] of entries) {
+  for (let [label, alphabet] of [
+    ['an empty', ''],
+    ['a 300 symbol', 'a'.repeat(300)]
+  ]) {
+    test(`${name} terminates on ${label} alphabet`, () => {
+      let id
+      try {
+        id = entry.customAlphabet(alphabet)(5)
+      } catch (e) {
+        ok(e instanceof RangeError, `${name} threw ${String(e)}`)
+        return
+      }
+      equal(id.length, 5)
+      for (let char of id) ok(alphabet.includes(char))
+    })
+  }
+}
