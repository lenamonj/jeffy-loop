diff --git a/Cargo.toml b/Cargo.toml
index 5459969..ad3b962 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -12,7 +12,25 @@ repository = "https://github.com/BurntSushi/memchr"
 readme = "README.md"
 keywords = ["memchr", "memmem", "substring", "find", "search"]
 license = "Unlicense OR MIT"
-exclude = ["/.github", "/benchmarks", "/fuzz", "/scripts", "/tmp"]
+# An allowlist, not a denylist. With `exclude`, every new top-level path in the
+# repository was published by default, which is how files that have nothing to
+# do with the library reached the crates.io tarball. This list names what the
+# published crate contains; anything else added to the repository stays out
+# until someone puts it here on purpose.
+include = [
+    "/src",
+    "/Cargo.toml",
+    "/README.md",
+    "/COPYING",
+    "/LICENSE-MIT",
+    "/UNLICENSE",
+    "/AI_POLICY.md",
+    "/CONTRIBUTING.md",
+    "/rustfmt.toml",
+    "/.gitignore",
+    "/.ignore",
+    "/.vim",
+]
 edition = "2021"
 rust-version = "1.61"
 
