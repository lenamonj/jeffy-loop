diff --git a/tests/Dotenv/Repository/Adapter/ReplacingWriterTest.php b/tests/Dotenv/Repository/Adapter/ReplacingWriterTest.php
new file mode 100644
index 0000000..421c5a9
--- /dev/null
+++ b/tests/Dotenv/Repository/Adapter/ReplacingWriterTest.php
@@ -0,0 +1,106 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Dotenv\Tests\Repository\Adapter;
+
+use Dotenv\Repository\Adapter\ArrayAdapter;
+use Dotenv\Repository\Adapter\ReplacingWriter;
+use Dotenv\Repository\RepositoryBuilder;
+use PHPUnit\Framework\TestCase;
+
+final class ReplacingWriterTest extends TestCase
+{
+    public function testWriteToUndefinedVariableIsANoop()
+    {
+        $inner = self::createAdapter();
+        $writer = new ReplacingWriter($inner, $inner);
+
+        self::assertTrue($writer->write('CONST_TEST', 'foo'));
+        self::assertFalse($inner->read('CONST_TEST')->isDefined());
+    }
+
+    public function testWriteToDefinedVariableReplaces()
+    {
+        $inner = self::createAdapter();
+        $inner->write('CONST_TEST', 'original');
+        $writer = new ReplacingWriter($inner, $inner);
+
+        self::assertTrue($writer->write('CONST_TEST', 'replaced'));
+        self::assertSame('replaced', $inner->read('CONST_TEST')->get());
+    }
+
+    public function testVariableSeenOnceRemainsWritableAfterExternalDelete()
+    {
+        $inner = self::createAdapter();
+        $inner->write('CONST_TEST', 'original');
+        $writer = new ReplacingWriter($inner, $inner);
+
+        self::assertTrue($writer->write('CONST_TEST', 'replaced'));
+
+        $inner->delete('CONST_TEST');
+
+        self::assertTrue($writer->write('CONST_TEST', 'again'));
+        self::assertSame('again', $inner->read('CONST_TEST')->get());
+    }
+
+    public function testDeleteOfUndefinedVariableIsANoop()
+    {
+        $inner = self::createAdapter();
+        $writer = new ReplacingWriter($inner, $inner);
+
+        self::assertTrue($writer->delete('CONST_TEST'));
+        self::assertFalse($inner->read('CONST_TEST')->isDefined());
+    }
+
+    public function testDeleteOfDefinedVariableRemovesIt()
+    {
+        $inner = self::createAdapter();
+        $inner->write('CONST_TEST', 'original');
+        $writer = new ReplacingWriter($inner, $inner);
+
+        self::assertTrue($writer->delete('CONST_TEST'));
+        self::assertFalse($inner->read('CONST_TEST')->isDefined());
+    }
+
+    public function testReaderAndWriterMayBeDistinct()
+    {
+        $reader = self::createAdapter();
+        $inner = self::createAdapter();
+        $writer = new ReplacingWriter($inner, $reader);
+
+        self::assertTrue($writer->write('CONST_TEST', 'ignored'));
+        self::assertFalse($inner->read('CONST_TEST')->isDefined());
+
+        $reader->write('CONST_TEST', 'now defined');
+
+        self::assertTrue($writer->write('CONST_TEST', 'written'));
+        self::assertSame('written', $inner->read('CONST_TEST')->get());
+        self::assertSame('now defined', $reader->read('CONST_TEST')->get());
+    }
+
+    public function testComposedIntoARepositoryOnlyReplacesExistingVariables()
+    {
+        $adapter = self::createAdapter();
+        $adapter->write('CONST_TEST', 'original');
+
+        $repository = RepositoryBuilder::createWithNoAdapters()
+            ->addReader($adapter)
+            ->addWriter(new ReplacingWriter($adapter, $adapter))
+            ->make();
+
+        self::assertTrue($repository->set('CONST_TEST', 'replaced'));
+        self::assertSame('replaced', $repository->get('CONST_TEST'));
+
+        self::assertTrue($repository->set('CONST_OTHER', 'ignored'));
+        self::assertNull($repository->get('CONST_OTHER'));
+    }
+
+    /**
+     * @return \Dotenv\Repository\Adapter\AdapterInterface
+     */
+    private static function createAdapter()
+    {
+        return ArrayAdapter::create()->get();
+    }
+}
