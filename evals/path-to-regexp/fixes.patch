+
+const SKELETONS = [
+  (s: string) => `/*a${s}*b${s}:c`,
+  (s: string) => `/*a${s}:b${s}*c/:d`,
+  (s: string) => `/:a${s}:b${s}:c`,
+  (s: string) => `/x/*a${s}*c/y`,
+];
+
+const OPTION_SETS: [string, PathToRegexpOptions][] = [
+  ["default", {}],
+  ["end:false", { end: false }],
+  ["trailing:false", { trailing: false }],
+  ["sensitive", { sensitive: true }],
+  ["delimiter:.", { delimiter: "." }],
+  ["delimiter:--", { delimiter: "--" }],
+];
