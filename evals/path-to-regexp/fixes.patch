+      const result = await check(regexp.source, regexp.flags, STEP_BOUNDED);
+      const expected = KNOWN_UNSAFE.has(`${path} | ${label}`)
+        ? "vulnerable"
+        : "safe";
+      expect(result.status).toBe(expected);
+    },
+  );
