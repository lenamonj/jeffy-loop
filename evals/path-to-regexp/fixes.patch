     expect(result.status).toBe("safe");
   });
+
+  // The gate has to be able to fail, on both of the paths it uses. An
+  // exponential backtracker is caught by the automaton checker, which never
+  // looks at a clock.
+  it("reports a known vulnerable pattern", { timeout: 60_000 }, async () => {
+    const result = await check("^(?:a+)+$", "", STEP_BOUNDED);
+    expect(result.status).toBe("vulnerable");
