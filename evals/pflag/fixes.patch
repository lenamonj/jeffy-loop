+// A nil default map is the idiomatic zero value for a map flag. Setting such a
+// flag must allocate rather than write into the nil map, and the pointer handed
+// back at definition time must observe the result.
+func TestStringToStringNilDefault(t *testing.T) {
+	t.Run("StringToString", func(t *testing.T) {
+		f := NewFlagSet("nil-default", ContinueOnError)
+		ptr := f.StringToString("m", nil, "map flag with a nil default")
+
+		if err := f.Parse([]string{"--m=a=1"}); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if len(*ptr) != 1 || (*ptr)["a"] != "1" {
+			t.Fatalf("got %v, want map[a:1]", *ptr)
+		}
+
+		got, err := f.GetStringToString("m")
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if len(got) != 1 || got["a"] != "1" {
+			t.Fatalf("GetStringToString got %v, want map[a:1]", got)
+		}
+		if reflect.ValueOf(*ptr).Pointer() != reflect.ValueOf(got).Pointer() {
+			t.Fatal("pointer mismatch")
+		}
+	})
+
+	t.Run("StringToStringVar", func(t *testing.T) {
+		f := NewFlagSet("nil-default", ContinueOnError)
+		var m map[string]string
+		f.StringToStringVar(&m, "m", nil, "map flag with a nil default")
+
+		if err := f.Parse([]string{"--m=a=1", "--m=b=2"}); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if len(m) != 2 || m["a"] != "1" || m["b"] != "2" {
+			t.Fatalf("got %v, want map[a:1 b:2]", m)
+		}
+	})
+}
