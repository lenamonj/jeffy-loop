+// The deprecated ParseErrorsWhitelist is an alias of ParseErrorsAllowlist, so
+// its UnknownFlagsHandling must drive parsing exactly as the current field does
+// for every handling mode, not only for the older UnknownFlags bool.
+func TestParseErrorsWhitelistUnknownFlagsHandling(t *testing.T) {
+	args := []string{"--unknown1", "--known", "kvalue", "--unknown2=uvalue", "-q", "arg0"}
+
+	for _, handling := range []UnknownFlagsHandling{IgnoreUnknownFlag, PassUnknownFlagToArgs} {
+		parse := func(setup func(f *FlagSet)) (string, string, []string) {
+			f := NewFlagSet("test", ContinueOnError)
+			f.SetOutput(ioutil.Discard)
+			setup(f)
+			known := f.String("known", "", "known string flag")
+			err := f.Parse(args)
+			errStr := ""
+			if err != nil {
+				errStr = err.Error()
+			}
+			return errStr, *known, f.Args()
+		}
+
+		wantErr, wantKnown, wantArgs := parse(func(f *FlagSet) {
+			f.ParseErrorsAllowlist.UnknownFlagsHandling = handling
+		})
+		gotErr, gotKnown, gotArgs := parse(func(f *FlagSet) {
+			f.ParseErrorsWhitelist.UnknownFlagsHandling = handling
+		})
+
+		if gotErr != wantErr {
+			t.Errorf("handling %d: deprecated field gave error %q, current field gave %q", handling, gotErr, wantErr)
+		}
+		if gotKnown != wantKnown {
+			t.Errorf("handling %d: deprecated field gave known=%q, current field gave %q", handling, gotKnown, wantKnown)
+		}
+		if !reflect.DeepEqual(gotArgs, wantArgs) {
+			t.Errorf("handling %d: deprecated field gave args %v, current field gave %v", handling, gotArgs, wantArgs)
+		}
+	}
+}
