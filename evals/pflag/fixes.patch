index 3785d37..e613667 100644
--- a/count_test.go
+++ b/count_test.go
@@ -1,6 +1,7 @@
 package pflag
 
 import (
+	"io/ioutil"
 	"os"
 	"testing"
 )
@@ -54,3 +55,34 @@ func TestCount(t *testing.T) {
 		}
 	}
 }
+
+// A rejected value must leave the counter where it was, as every other scalar
+// value type in this package does. Before this was fixed, countValue.Set
+// assigned the zero ParseInt returns on failure and then handed back the error,
+// so a caller that handled the error still read a clobbered count.
+func TestCountInvalidValuePreservesValue(t *testing.T) {
+	f := NewFlagSet("count", ContinueOnError)
+	f.SetOutput(ioutil.Discard)
+	c := f.CountP("verbose", "v", "verbosity")
+
+	if err := f.Parse([]string{"-vv"}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if *c != 2 {
+		t.Fatalf("got %d, want 2", *c)
+	}
+
+	err := f.Set("verbose", "abc")
+	if err == nil {
+		t.Fatal("expected an error setting an invalid count")
+	}
+	if *c != 2 {
+		t.Fatalf("count clobbered to %d by a rejected value, want 2", *c)
+	}
+
+	// The message must match the one every sibling scalar returns.
+	want := `invalid argument "abc" for "-v, --verbose" flag: must be an integer`
+	if err.Error() != want {
+		t.Errorf("got %q, want %q", err.Error(), want)
+	}
+}
