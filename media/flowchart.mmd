%%{init: {"flowchart": {"subGraphTitleMargin": {"top": 12, "bottom": 20}}, "themeVariables": {"edgeLabelBackground": "#F1F5F9", "textColor": "#334155", "nodeTextColor": "#1F2937", "lineColor": "#64748B"}, "themeCSS": ".cluster-label span { font-size: 15px; } .cluster-label b { font-size: 28px; font-weight: 800; letter-spacing: 1.5px; }"}}%%
%% Source for the README flowchart. The GitHub app cannot render mermaid,
%% so the README embeds pre-rendered PNGs (media/flowchart-light.png and
%% media/flowchart-dark.png, via a picture element that follows the theme).
%% To regenerate after editing: python scripts/render-flowchart.py
%% (mermaid v11 via npx renders the SVGs, the script injects marker-mid
%% arrowheads along the long edges - Chromium ignores marker-mid as CSS,
%% so it must be an attribute - and Playwright rasterizes both themes
%% at 3x). Every edge gets the mid arrows; short edges have few or no
%% curve vertices, so density self-regulates with edge length.
flowchart TD
    subgraph LAUNCH ["<b>LAUNCH</b> - the /jeffy skill, runs once"]
        USER(["You run  /jeffy 10<br/>an iteration budget, and optionally a focus"])
        PRE["Pre-flight, then bootstrap<br/>engine installed, no rival loop, tree clean,<br/>the plan's Verify command parses as shell;<br/>PLAN.md, BACKLOG.md, JOURNAL.md<br/>created from templates if missing"]
        WRITE["Write the loop state file<br/>owner session, iteration 1 of N, the promise<br/>phrase - then start iteration 1 directly"]
        USER --> PRE --> WRITE
    end

    subgraph WORK ["<b>THE ITERATION</b> - one unit of verified work per turn"]
        LOAD["Load context fresh<br/>PLAN.md and BACKLOG.md in full, the last<br/>3 journal entries; salvage any interrupted<br/>work into a commit before touching anything"]
        OPEN{"Open tasks in<br/>the backlog?"}
        AUDIT["Audit the project<br/>sweeps the surface inventory in PLAN.md<br/>breadth-first, unswept rows before swept ones,<br/>judged against the operating envelope; each finding<br/>gets evidence, a severity, a class, an acceptance check"]
        CLEAN{"Zero High, zero Medium,<br/>nothing left open?"}
        EXEC["Execute exactly one task<br/>the top unblocked item, never a batch;<br/>run its acceptance check,<br/>3 fix attempts, then mark it blocked"]
        GATE{"Repo verify command<br/>still green?"}
        REVERT["Revert to the last checkpoint<br/>an iteration that breaks the project<br/>does not survive; task marked blocked"]
        RECORD["Record and checkpoint<br/>journal entry, lessons promoted into PLAN.md,<br/>ledger updated, then commit<br/>jeffy: iter i/N - local only, never pushed"]
        EVAL{"Adversarial evaluator PASS?<br/>one fresh-context sub-agent assumes the<br/>work is broken, re-runs every check itself"}
        PROMISE["Declare convergence<br/>run report, then the promise phrase<br/>JEFFY CONVERGED"]

        LOAD --> OPEN
        OPEN -->|"backlog empty"| AUDIT --> CLEAN
        CLEAN -->|"findings filed, most severe first"| RECORD
        CLEAN -->|"yes - done means done"| EVAL
        OPEN -->|"ledger just emptied, a clean audit<br/>already on record, 3 or more left -<br/>gate now, while a REJECT is answerable"| EVAL
        EVAL -->|"PASS, and this iteration declares"| PROMISE
        EVAL -->|"PASS earlier in the run - recorded;<br/>the declaring iteration re-invokes"| RECORD
        EVAL -->|"REJECT - reasons filed<br/>as new tasks"| RECORD
        OPEN -->|"tasks waiting"| EXEC --> GATE
        GATE -->|"green"| RECORD
        GATE -->|"newly broken"| REVERT --> RECORD
    end
    WRITE --> WORK

    subgraph ENGINE ["<b>THE ENGINE</b> - a Stop hook at every turn end, plain shell"]
        PROM{"Promise phrase in the<br/>last assistant message?"}
        CHECKS{"The stop is machine-checked<br/>no open task left in the ledger, the Converged<br/>line certifies this tree, no surface inventory row<br/>is unswept, the closing journal entry records an<br/>evaluator verdict, and the project's own verify<br/>command exits 0 when the hook re-runs it"}
        BUDGET{"Iterations left?"}
        EXTEND{"Nothing left but the<br/>convergence sequence?<br/>ledger empty, every row swept,<br/>no extension granted yet"}
        STALL{"Second flat iteration?<br/>no commit and no ledger change,<br/>twice in a row"}
        REFEED["Block the stop and re-feed<br/>the iteration prompt, with any focus, the<br/>evidence of a rejected convergence, hygiene<br/>notes when the finished iteration skipped its<br/>journal entry or its checkpoint, and the RUN STATE<br/>line - iterations left, open tasks, unswept rows"]
        REFILL{"Ledger refilled by<br/>non-evaluator work?"}
        PROM -->|"no"| BUDGET
        PROM -->|"yes"| CHECKS
        CHECKS -->|"a check failed - the violation<br/>rides the budget test"| BUDGET
        BUDGET -->|"yes"| STALL
        BUDGET -->|"no - budget spent"| EXTEND
        EXTEND -->|"yes - one-time +2, once per run"| REFEED
        REFILL -->|"no"| REFEED
        STALL -->|"no"| REFILL
    end

    RECORD -->|"turn ends"| ENGINE
    PROMISE --> ENGINE
    REFEED -->|"iteration i+1, context intact"| LOAD

    REPORT["Run report<br/>iterations spent, tasks closed with severities,<br/>the diffstat, blocked items, decisions waiting on you;<br/>JOURNAL.md and git log hold the full record"]
    OOB["Run ends - out of budget<br/>tasks kept"]

    CHECKS -->|"every check holds -<br/>converged"| REPORT
    EXTEND -->|"no - the run is over"| REPORT
    REFILL -->|"yes - inside the granted window"| OOB
    STALL -->|"yes - ended as stalled"| REPORT
    RECORD -->|"needs your decision"| REPORT

    subgraph FILES ["<b>THE CONTROL PLANE</b> - files, not vibes"]
        SF[("jeffy-loop.local.md<br/>transient loop state, written at launch:<br/>owner session, iteration i of N;<br/>deleted when the run ends")]
        MEM[("PLAN.md, BACKLOG.md, JOURNAL.md<br/>persistent memory between runs:<br/>envelope, surface inventory and lessons,<br/>task ledger, append-only record;<br/>.jeffy/probes holds the kept known-answer batteries")]
        GIT[("git checkpoints<br/>one jeffy: commit per iteration,<br/>the revert and recovery unit")]
    end

    REFEED -. "iteration + 1, and the +2 when granted" .-> SF
    RECORD -. "writes" .-> MEM
    RECORD -. "commits" .-> GIT
    REVERT -. "restores" .-> GIT

    %% The four state-plane edges above are dashed AND amber - the same amber
    %% as the control-plane panel they land in - so they read as file writes
    %% at a glance instead of hiding among the slate control-flow edges.
    %% linkStyle is INDEX-based over edge declaration order: these are edges
    %% 33-36. Adding any edge earlier in the file shifts them - recount.
    linkStyle 33,34,35,36 stroke:#CA8A04,stroke-width:2.5px,stroke-dasharray:7 5

    classDef entry fill:#BAE6FD,stroke:#0EA5E9,color:#0C4A6E
    classDef launch fill:#E0F2FE,stroke:#0EA5E9,color:#0C4A6E
    classDef work fill:#FBE9E0,stroke:#D97757,color:#7C2D12
    classDef engine fill:#EDE9FE,stroke:#8B5CF6,color:#4C1D95
    classDef file fill:#FEF9C3,stroke:#CA8A04,color:#713F12
    classDef good fill:#DCFCE7,stroke:#22C55E,color:#14532D

    class USER entry
    class PRE,WRITE launch
    class LOAD,OPEN,AUDIT,CLEAN,EXEC,GATE,REVERT,RECORD,EVAL work
    class PROM,CHECKS,BUDGET,EXTEND,STALL,REFEED,REFILL engine
    class SF,MEM,GIT file
    class REPORT,PROMISE,OOB good

    style LAUNCH fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0C4A6E
    style WORK fill:#FFF8F4,stroke:#D97757,stroke-width:2px,color:#7C2D12
    style ENGINE fill:#F5F3FF,stroke:#8B5CF6,stroke-width:2px,color:#4C1D95
    style FILES fill:#FEFCE8,stroke:#CA8A04,stroke-width:2px,stroke-dasharray:4 4,color:#713F12
